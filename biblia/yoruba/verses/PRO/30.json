  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PRO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Àwọn ọ̀rọ̀ tí Aguri sọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀rọ̀ Aguri ọmọ Jake, ọ̀rọ̀ ìsọtẹ́lẹ̀ tí ọkùnrin yìí sọ fún Itieli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:1"
      },
      "items": [
        {
          "text": "Sí Itieli àti sí Ukali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi ni aláìmòye ju nínú àwọn ènìyàn;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:2"
      },
      "items": [
        {
          "text": "n kò ní òye ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò tilẹ̀ kọ́ ọgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:3"
      },
      "items": [
        {
          "text": "tàbí ní ìmọ̀ ẹni mímọ́ nì.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó ti gòkè lọ sí ọ̀run tí ó sì padà sọ̀kalẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ta ni ó ti kó afẹ́fẹ́ jọ sí ihò àtẹ́lẹwọ́ rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ta ni ó ti ta kókó omi sétí aṣọ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ta ni ó fi gbogbo ìpìlẹ̀ ayé lélẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Kí ni orúkọ rẹ̀, àti orúkọ ọmọ rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Sọ fún mi bí o bá mọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gbogbo ọ̀rọ̀ Ọlọ́run jẹ́ aláìlábùkù;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:5"
      },
      "items": [
        {
          "text": "òun ni ààbò fún gbogbo ẹni fi í ṣe ibi ìpamọ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe fi kún ọ̀rọ̀ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:6"
      },
      "items": [
        {
          "text": "àìṣe bẹ́ẹ̀ yóò bá ọ wí yóò sì sọ ọ́ di òpùrọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ohun méjì ni mo ń béèrè lọ́wọ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.7",
                "verseOrgIds": [
                  "PRO.30.7"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:7"
      },
      "items": [
        {
          "text": "má ṣe fi wọ́n dù mí kí ń tó kú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú èké ṣíṣe àti irọ́ jìnnà sí mi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "má ṣe fún mi ní òsì tàbí ọrọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "ṣùgbọ́n fún mi ní oúnjẹ òòjọ́ mi nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àìṣe bẹ́ẹ̀, mo lè ní àníjù kí n sì gbàgbé rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "kí ń sì wí pé, 'Ta ni",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.9",
                "verseOrgIds": [
                  "PRO.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "?'",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "Tàbí kí ń di òtòṣì kí ń sì jalè",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "kí ń sì ṣe àìbọ̀wọ̀ fún orúkọ Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Má ṣe ba ìránṣẹ́ lórúkọ jẹ́ lọ́dọ̀ ọ̀gá rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:10"
      },
      "items": [
        {
          "text": "kí ó má ba fi ọ́ bú, kí ìwọ má ba jẹ̀bi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn kan wá ṣépè fún àwọn baba wọn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:11"
      },
      "items": [
        {
          "text": "tí wọn kò sì súre fún àwọn ìyá wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó mọ́ ní ojú ara wọn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:12"
      },
      "items": [
        {
          "text": "síbẹ̀ tí wọn kò sì mọ́ kúrò nínú èérí wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ẹni tí ojú wọn gbéga nígbà gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:13"
      },
      "items": [
        {
          "text": "tí ìwolẹ̀ wọn sì kún fún ìgbéraga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹni tí eyín wọn jẹ́ idà",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "àwọn tí èrìgì wọn kún fún ọ̀bẹ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "láti jẹ àwọn tálákà run kúrò ní ilẹ̀ ayé",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "àwọn aláìní kúrò láàrín àwọn ọmọ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eṣúṣú ni ọmọbìnrin méjì.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "'Mú wá! Mú wá!' ní wọn ń ké.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PRO 30:15"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "\"Àwọn nǹkan mẹ́ta kan wà tí kò ní ìtẹ́lọ́rùn láéláé,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "mẹ́rin tí kò jẹ́ wí láéláé pé, 'Ó tó!':",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibojì, inú tí ó yàgàn,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:16"
      },
      "items": [
        {
          "text": "ilẹ̀ tí omi kì í tẹ́lọ́rùn láéláé,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:16"
      },
      "items": [
        {
          "text": "àti iná, tí kì í wí láéláé pé, 'Ó tó!'",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ojú tí ń fi baba ṣẹ̀fẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "tí ó kẹ́gàn ìgbọ́ràn sí ìyá,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "ẹyẹ ìwò ẹ̀bá odò ni yóò yọ ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:17"
      },
      "items": [
        {
          "text": "igún yóò mú un jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.17",
            "verseOrgIds": [
              "PRO.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn nǹkan mẹ́ta wà tí ó jẹ́ ìyàlẹ́nu fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.18",
            "verseOrgIds": [
              "PRO.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 30:18"
      },
      "items": [
        {
          "text": "mẹ́rin tí kò yé mi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.18",
            "verseOrgIds": [
              "PRO.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipa ẹyẹ idì ní òfúrufú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "ipa ejò lórí àpáta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "ipa ọkọ̀ ojú omi lójú agbami Òkun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:19"
      },
      "items": [
        {
          "text": "àti ipa ọ̀nà ọkùnrin tí ó mú wúńdíá lọ́wọ́.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ọ̀nà alágbèrè obìnrin",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:20"
      },
      "items": [
        {
          "text": "ó jẹun ó sì nu ẹnu rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:20"
      },
      "items": [
        {
          "text": "ó sì wí pé, 'N kò ṣe ohunkóhun tí kò tọ́.'",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.20",
            "verseOrgIds": [
              "PRO.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lábẹ́ nǹkan mẹ́ta ni ilé ayé ti ń wárìrì",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.21",
            "verseOrgIds": [
              "PRO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 30:21"
      },
      "items": [
        {
          "text": "lábẹ́ ohun mẹ́rin ni kò ti lè mí fín ín.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.21",
            "verseOrgIds": [
              "PRO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ tí ó di ọba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:22"
      },
      "items": [
        {
          "text": "aláìgbọ́n tí ó ní ọ̀pọ̀lọpọ̀ oúnjẹ,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "obìnrin tí gbogbo ènìyàn kórìíra tí ó sì wá lọ́kọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:23"
      },
      "items": [
        {
          "text": "ìránṣẹ́bìnrin tí ó gbọkọ mọ́ ọ̀gá rẹ̀ lọ́wọ́.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn ohun mẹ́rin ló kéré láyé",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.24",
            "verseOrgIds": [
              "PRO.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "PRO 30:24"
      },
      "items": [
        {
          "text": "síbẹ̀ wọ́n gbọ́n gidigidi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.24",
            "verseOrgIds": [
              "PRO.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn èèrà jẹ́ aláìlágbára ẹ̀dá,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.25",
            "verseOrgIds": [
              "PRO.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:25"
      },
      "items": [
        {
          "text": "síbẹ̀ wọ́n kó oúnjẹ wọn pamọ́ ní àsìkò òjò.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehoro jẹ́ aláìlágbára ẹ̀dá;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.26",
            "verseOrgIds": [
              "PRO.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:26"
      },
      "items": [
        {
          "text": "síbẹ̀ wọ́n ń ṣe ihò wọn sí ibi pálapàla àpáta;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn eṣú kò ní ọba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.27",
            "verseOrgIds": [
              "PRO.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:27"
      },
      "items": [
        {
          "text": "síbẹ̀ gbogbo wọ́n ń jáde lọ ní ọ̀wọ̀ọ̀wọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọnílé fi ọwọ́ rẹ̀ dì mú,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.28",
            "verseOrgIds": [
              "PRO.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:28"
      },
      "items": [
        {
          "text": "síbẹ̀ a ń rí i ní ààfin ọba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn ohun mẹ́ta ní ń bẹ tí ń rìn rere,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.29",
            "verseOrgIds": [
              "PRO.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
