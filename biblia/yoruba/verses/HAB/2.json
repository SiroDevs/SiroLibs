      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ègbé ni fún ẹni tí ó fi ohun mímu fún aládùúgbò rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "tí ó sì fi ọtí-lílé rẹ̀ fún un, tí o sì jẹ́ kó mu àmupara,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "kí ìwọ kí ó ba lè wo ìhòhò wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
