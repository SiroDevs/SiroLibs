        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ègbé ni fún ẹni tí ó fi ẹ̀jẹ̀ kọ́ ìlú,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:12"
      },
      "items": [
        {
          "text": "tí o sì fi àìṣedéédéé tẹ ìlú ńlá dó?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
