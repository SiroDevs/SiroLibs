      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ayé yóò kún fún ìmọ̀ ògo",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.14",
                "verseOrgIds": [
                  "HAB.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:14"
      },
      "items": [
        {
          "text": "bí omi ti bo Òkun.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
