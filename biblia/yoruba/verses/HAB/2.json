      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "làálàá àwọn ènìyàn jẹ́ epo fún iná",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "kí àwọn orílẹ̀-èdè náà sì máa ṣe wàhálà fún asán?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
