      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "kí a ba le gbà á sílẹ̀ kúrò lọ́wọ́ ibi!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
