          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìtìjú yóò bò ọ́ dípò ògo, ìwọ náà mu pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "kí ìhòhò rẹ kí ó lè hàn,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "ago ọwọ́ ọ̀tún",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.16",
                "verseOrgIds": [
                  "HAB.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", yóò yípadà sí ọ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "ìtìjú yóò sì bo ògo rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwà ipá tí ó tí hù sí Lebanoni yóò bò ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "àti ìparun àwọn ẹranko yóò dẹ́rùbà ọ́ mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "Nítorí ìwọ tí ta ẹ̀jẹ̀ ènìyàn sílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "ìwọ tí pa ilẹ̀ náà àti ìlú ńlá run àti gbogbo àwọn tí ń gbé inú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èrè kí ni òrìṣà ni, tí oníṣọ̀nà rẹ̀ fi gbẹ́ ẹ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "ère dídá ti ń kọ ni èké?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "Nítorí ti ẹni ti ó dá a gbẹ́kẹ̀ rẹ̀ lé ohun tí ó fúnra rẹ̀ dá;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "ó sì mọ ère tí kò le fọhùn.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAB 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ni fún ẹni ti ń sọ fún igi pé, 'Di alààyè?'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Fún òkúta tí kò lè fọhùn pé, 'Dìde.'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Ǹjẹ́ òun lè tọ́ ni sí ọ̀nà?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Wúrà àti fàdákà ni a fi bò ó yíká;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "kò sì sí èémí kan nínú rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAB 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.20",
                "verseOrgIds": [
                  "HAB.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "wà nínú tẹmpili mímọ́ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:20"
      },
      "items": [
        {
          "text": "ẹ jẹ́ kí gbogbo ayé parọ́rọ́ níwájú rẹ.",
