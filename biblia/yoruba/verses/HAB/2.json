      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:10"
      },
      "items": [
        {
          "text": "ìwọ sì ti pàdánù ẹ̀mí rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
