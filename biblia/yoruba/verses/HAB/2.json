              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.13",
                "verseOrgIds": [
                  "HAB.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun kò ha ti ṣètò rẹ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
