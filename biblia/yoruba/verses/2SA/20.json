  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2SA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ṣeba ṣọ̀tẹ̀ sí Dafidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin Beliali kan sì ń bẹ níbẹ̀ orúkọ rẹ̀ sì ń jẹ́ Ṣeba ọmọ Bikri ará Benjamini; ó sì fún ìpè ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 20:1"
      },
      "items": [
        {
          "text": "\"Àwa kò ní ipa nínú Dafidi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 20:1"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwa kò ni ìní nínú ọmọ Jese!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 20:1"
      },
      "items": [
        {
          "text": "Kí olúkúlùkù ọkùnrin lọ sí àgọ́ rẹ̀, ẹ̀yin Israẹli!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọkùnrin Israẹli sì lọ kúrò lẹ́yìn Dafidi, wọ́n sì ń tọ́ Ṣeba ọmọ Bikri lẹ́yìn, ṣùgbọ́n àwọn ọkùnrin Juda sì fi ara mọ́ ọba wọn láti odò Jordani wá títí ó fi dé Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wà ní ilé rẹ̀ ní Jerusalẹmu; ọba sì mú àwọn obìnrin mẹ́wàá tí í ṣe àlè rẹ̀, àwọn tí ó ti fi sílẹ̀ láti máa ṣọ́ ilé, Ó sì há wọn mọ́ ilé, ó sì ń bọ́ wọn, ṣùgbọ́n kò sì tún wọlé tọ̀ wọ́n mọ́. A sì sé wọn mọ́ títí di ọjọ́ ikú wọn, wọ́n sì wà bí opó.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joabu fi idà gún Amasa, ó sì kú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún Amasa pé, \"Pe àwọn ọkùnrin Juda fún mi ní ìwọ̀n ọjọ́ mẹ́ta òní, kí ìwọ náà kí o sì wà níhìn-ín yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa sì lọ láti pe àwọn ọkùnrin Juda; ṣùgbọ́n ó sì dúró pẹ́ ju àkókò tí a fi fún un.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dafidi sì wí fún Abiṣai pé, \"Nísinsin yìí Ṣeba ọmọ Bikri yóò ṣe wá ní ibi ju ti Absalomu lọ; ìwọ mú àwọn ìránṣẹ́ olúwa rẹ, kí o sì lépa rẹ̀, kí ó má ba à rí ìlú olódi wọ̀, kí ó sì bọ́ lọ́wọ́ wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọkùnrin Joabu sì jáde tọ̀ ọ́ lọ, àti àwọn Kereti, àti àwọn Peleti, àti gbogbo àwọn ọkùnrin alágbára, wọ́n sì ti Jerusalẹmu jáde lọ, láti lépa Ṣeba ọmọ Bikri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n dé ibi òkúta ńlá tí ó wà ní Gibeoni, Amasa sì ṣáájú wọn, Joabu sì di àmùrè sí agbádá rẹ̀ tí ó wọ̀, ó sì sán idà rẹ̀ mọ́ ìdí, nínú àkọ̀ rẹ̀, bí ó sì ti ń lọ, ó yọ́ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì bi Amasa léèrè pé, \"Àlàáfíà ha kọ́ ni bí, ìwọ arákùnrin mi?\" Joabu sì na ọwọ́ ọ̀tún rẹ̀, di Amasa ní irùngbọ̀n mú láti fi ẹnu kò ó lẹ́nu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Amasa kò sì kíyèsi idà tí ń bẹ lọ́wọ́ Joabu, bẹ́ẹ̀ ni òun sì fi gún un ní ikùn, ìfun rẹ̀ sì tú dà sílẹ̀, òun kò sì tún gún un mọ́, Amasa sì kú. Joabu àti Abiṣai arákùnrin rẹ̀ sì lépa Ṣeba ọmọ Bikri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joabu lépa Seba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kan nínú àwọn ọ̀dọ́mọdékùnrin tí ó wà lọ́dọ̀ Joabu sì dúró tì Amasa, ó sì wí pé, \"Ta ni ẹni tí ó fẹ́ràn Joabu? Ta ni ó sì ń ṣe ti Dafidi, kí ó máa tọ Joabu lẹ́yìn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa sì ń yíràá nínú ẹ̀jẹ̀ láàrín ọ̀nà. Ọkùnrin náà sì rí i pé gbogbo ènìyàn sì dúró tì í, ó sì gbé Amasa kúrò lójú ọ̀nà lọ sínú igbó, ó sì fi aṣọ bò ó, nígbà tí ó rí i pé ẹnikẹ́ni tí ó bá dé ọ̀dọ̀ rẹ̀, á dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì gbé Amasa kúrò lójú ọ̀nà gbogbo ènìyàn sì tọ Joabu lẹ́yìn láti lépa Ṣeba ọmọ Bikri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n gé Ṣeba lórí",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣeba kọjá nínú gbogbo ẹ̀yà Israẹli sí Abeli-Beti-Maaka, àti gbogbo àwọn ará Beri; wọ́n sì kó ara wọn jọ, wọ́n sì tọ̀ ọ́ lẹ́yìn pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wá, wọ́n sì dó tì Ṣeba ní Abeli-Beti-Maaka, wọ́n sì mọ odi ti ìlú náà, odi náà sì dúró ti odi ìlú náà, gbogbo ènìyàn tí ń bẹ lọ́dọ̀ Joabu sì ń gbìyànjú láti wó ògiri náà lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin ọlọ́gbọ́n kan sì kígbe sókè láti ìlú náà wá pé, \"Fetísílẹ̀! Fetísílẹ̀! Èmi bẹ̀ yín, ẹ sọ fún Joabu pé, 'Súnmọ́ ìhín yìí èmi ó sì bá a sọ̀rọ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí òun sì súnmọ́ ọ̀dọ̀ rẹ̀, obìnrin náà sì wí pé, \"Ìwọ ni Joabu bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:17"
      },
      "items": [
        {
          "text": "Òun sì dáhùn wí pé, \"Èmi náà ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:17"
      },
      "items": [
        {
          "text": "Obìnrin náà sì wí fún un pé, \"Gbọ́ ọ̀rọ̀ ìránṣẹ́bìnrin rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:17"
      },
      "items": [
        {
          "text": "Òun sì dáhùn wí pé, \"Èmi ń gbọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sọ̀rọ̀ wí pé, \"Wọ́n ti ń wí ṣáájú pé, 'Gba ìdáhùn rẹ ní Abeli,' bẹ́ẹ̀ ni wọ́n sì parí ọ̀ràn náà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ni ọ̀kan nínú àwọn ẹni àlàáfíà àti olóòtítọ́ ní Israẹli, ìwọ ń wá ọ̀nà láti pa ìlú kan run tí ó jẹ́ ìyá ní Israẹli, èéṣe tí ìwọ ó fi gbé ìní",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2SA.20.19",
                "verseOrgIds": [
                  "2SA.20.19"
                ]
              }
            }
          ]
        },
        {
          "text": "mì.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì dáhùn wí pé, \"Kí a má rí i, kí a má rí i lọ́dọ̀ mi pé èmi gbé mì tàbí èmi sì parun.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀ràn náà kò sì rí bẹ́ẹ̀; ṣùgbọ́n ọkùnrin kan láti òkè Efraimu, tí orúkọ rẹ̀ ń jẹ́ Ṣeba, ọmọ Bikri, ni ó gbé ọwọ́ rẹ̀ sókè sí ọba, àní sí Dafidi: fi òun nìkan ṣoṣo lé wa lọ́wọ́, èmi ó sì fi ìlú sílẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:21"
      },
      "items": [
        {
          "text": "Obìnrin náà sì wí fún Joabu pé, \"Wò ó, orí rẹ̀ ni a ó sì sọ láti inú odi wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà sì mú ìmọ́ràn rẹ̀ tọ gbogbo àwọn ènìyàn náà, wọ́n sì bẹ Ṣeba ọmọ Bikri lórí, wọ́n sì sọ ọ́ sí Joabu. Òun sì fún ìpè, wọ́n sì túká ní ìlú náà, olúkúlùkù sí àgọ́ rẹ̀. Joabu sí padà lọ sí Jerusalẹmu àti sọ́dọ̀ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ìránṣẹ́ Dafidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu sì ni olórí gbogbo ogun Israẹli;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 20:23"
      },
      "items": [
        {
          "text": "Benaiah ọmọ Jehoiada sì jẹ́ olórí àwọn Kereti, àti ti àwọn Peleti.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniramu sì jẹ́ olórí àwọn agbowó òde;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 20:24"
      },
      "items": [
        {
          "text": "Jehoṣafati ọmọ Ahiludi sì jẹ́ olùkọsílẹ̀ ohun tí ó ń ṣẹlẹ̀ ní ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.24",
            "verseOrgIds": [
              "2SA.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣefa sì jẹ́ akọ̀wé;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 20:25"
      },
      "items": [
        {
          "text": "Sadoku àti Abiatari sì ni àwọn àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.25",
            "verseOrgIds": [
              "2SA.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira pẹ̀lú, ará Jairi ni ń ṣe àlùfáà lọ́dọ̀ Dafidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.26",
            "verseOrgIds": [
              "2SA.20.26"
            ]
          }
        }
      ]
    }
