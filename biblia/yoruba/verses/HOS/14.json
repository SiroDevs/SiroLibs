  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "HOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwòsàn ń bẹ fún àwọn tó ronúpìwàdà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yípadà ìwọ Israẹli sí",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.14.1",
                "verseOrgIds": [
                  "HOS.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:1"
      },
      "items": [
        {
          "text": "Ẹ̀ṣẹ̀ rẹ ló fa ìparun rẹ!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gba ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.14.2",
                "verseOrgIds": [
                  "HOS.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kí ẹ sì yípadà sí",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.14.2",
                "verseOrgIds": [
                  "HOS.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "Ẹ sọ fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "\"Darí gbogbo ẹ̀ṣẹ̀ wa jì wá",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kí o sì fi oore-ọ̀fẹ́ gbà wá,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kí àwa kí ó lè fi ètè wa sán an fún ọ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiria kò le gbà wá là;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "a kò ní í gorí ẹṣin ogun.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "A kò sì ní tún sọ ọ́ mọ́ láé, 'Àwọn ni òrìṣà wa'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "sí àwọn ohun tí ó fi ọwọ́ wa ṣe;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "nítorí pé lọ́dọ̀ rẹ ni àwọn aláìní baba tí ń rí àánú.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi wo àgàbàgebè wọn sàn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "Èmi ó sì fẹ́ràn wọn, lọ́fẹ̀ẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "nítorí ìbínú mi ti yípadà kúrò lọ́dọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi o dàbí ìrì sí Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "wọn o sì yọ ìtànná bi ewéko lílì.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "Bi kedari ti Lebanoni yóò si ta gbòǹgbò.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àṣẹ̀ṣẹ̀yọ ẹ̀ka rẹ̀ yóò dàgbà,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "dídán ẹwà yóò rẹ̀ dànù bí igi olifi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "Òórùn rẹ yóò sì dàbí igi kedari ti Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yóò tún padà gbé lábẹ́ òjijì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Yóò rúwé bi ọkà.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Yóò sì yọ ìtànná bi àjàrà,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "òórùn rẹ yóò dàbí ti wáìnì Lebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ Efraimu, kín ló tún kù tí mo ní ṣe pẹ̀lú ère òrìṣà?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Èmi ó dá a lóhùn, èmi ó sì ṣe ìtọ́jú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Mo dàbí igi junifa tó ń fi gbogbo ìgbà tutù,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "èso tí ìwọ ń so si ń wá láti ọ̀dọ̀ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ọlọ́gbọ́n? Òun yóò mòye àwọn nǹkan wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Ta a ní ó mọ̀? Òun yóò ní ìmọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Títọ́ ni ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.14.9",
                "verseOrgIds": [
                  "HOS.14.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "àwọn olódodo si ń rìn nínú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn ọlọ́tẹ̀ ni yóò kọsẹ̀ nínú wọn.",
