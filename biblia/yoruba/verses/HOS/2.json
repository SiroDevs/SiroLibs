{
  "id": "HOS.2",
  "number": "2",
  "bookId": "HOS",
  "reference": "Hosea 2",
  "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún àwọn arákùnrin rẹ, 'Ènìyàn mi,' kí o sì wí fún àwọn arábìnrin rẹ 'Àyànfẹ́ mi.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀sùn tí a fi kan ìyàwó aláìṣòótọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ bá ìyá yín wí, ẹ bá a wí,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "nítorí pé kì í ṣe ìyàwó mi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "Èmi náà kì í sì í ṣe ọkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "Jẹ́ kí ó yọ àgbèrè rẹ̀ kúrò lójú rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "àti àìṣòótọ́ kúrò ní àyà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àìṣe bẹ́ẹ̀ èmi yóò tú u sí ìhòhò,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "Èmi yóò sì gbé e kalẹ̀ bí ọjọ́ tí a bí i.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "Èmi yóò ṣe ọ́ bí i aṣálẹ̀ ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "Èmi yóò sì sọ ọ́ di ìyàngbẹ ilẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "Èmi yóò sì fi òǹgbẹ gbẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò ní fi àánú mi hàn sí àwọn ọmọ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:4"
      },
      "items": [
        {
          "text": "nítorí ọmọ àgbèrè ni wọ́n jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìyá wọn ti hùwà àgbèrè,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "ó sì lóyún wọn nínú ìtìjú.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "Ó wí pé, 'Èmi ó tún tọ́ àwọn àyànfẹ́ mi lẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "tó ń fún mi ní oúnjẹ àti omi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "ní irun àgùntàn mi àti ọ̀gbọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "òróró mi àti ohun mímu mi.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, èmi ó fi ẹ̀gún dì í lọ́nà,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:6"
      },
      "items": [
        {
          "text": "Èmi ó mọ odi yí i ká kí ó má ba à rọ́nà lọ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sáré lé àwọn olólùfẹ́ rẹ̀ ṣùgbọ́n kò ní bá wọn;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "yóò wá wọn ṣùgbọ́n kò ní rí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "Nígbà náà ni yóò sọ pé,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "'Èmi ó padà sí ọ̀dọ̀ ọkọ mi àkọ́kọ́",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "nítorí pé ó dára fún mi nígbà náà ju ìsinsin yìí lọ.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé kò tí ì mọ̀ pé èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "àti ẹni tó fún un ní ọkà,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "ọtí wáìnì tuntun àti òróró",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "ẹni tí ó fún un ní fàdákà àti wúrà lọ́pọ̀lọ́pọ̀, èyí tí wọ́n lò fún Baali.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, èmi yóò mú ọkà mi kúrò nígbà tó bá pọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "èmi yóò sì mú wáìnì mi kúrò ní àsìkò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "Èmi yóò sì gba irun àgùntàn àti ọ̀gbọ̀ mi padà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "ti mo ti fi fún un láti bo ìhòhò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fi ìwà ìtìjú rẹ̀ hàn",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "lójú àwọn olólùfẹ́ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "kò sí ẹni tí yóò gbà á sílẹ̀ lọ́wọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú gbogbo ayọ̀ rẹ̀ wá sí òpin:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:11"
      },
      "items": [
        {
          "text": "àjọ̀dún ọdọọdún rẹ̀, oṣù tuntun rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:11"
      },
      "items": [
        {
          "text": "ọjọ́ ìsinmi, àti gbogbo àwọn àjọ̀dún tí a yàn.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò pa àjàrà àti igi ọ̀pọ̀tọ́ rẹ̀ run,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "èyí tí ó pè ní èrè rẹ̀ láti ọ̀dọ̀ àwọn olólùfẹ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "Èmi yóò sọ wọ́n di igbó,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "àwọn ẹranko búburú yóò sì jẹ́ wọn run.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò bẹ̀ ọjọ́ Baalimu wò ní ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:13"
      },
      "items": [
        {
          "text": "nínú èyí tó ń fi tùràrí jóná fún Baali;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:13"
      },
      "items": [
        {
          "text": "tí ó fi òrùka etí àti ohun ọ̀ṣọ́ rẹ̀, ṣe ara rẹ̀ lọ́ṣọ̀ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:13"
      },
      "items": [
        {
          "text": "tó sì tẹ̀lé àwọn olólùfẹ́ rẹ̀ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:13"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n èmi ni òun gbàgbé,\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:13"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.2.13",
                "verseOrgIds": [
                  "HOS.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, èmi yóò tàn án,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:14"
      },
      "items": [
        {
          "text": "Èmi ó sì mú u lọ sí ilẹ̀ aṣálẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:14"
      },
      "items": [
        {
          "text": "Èmi ó fi pẹ̀lẹ́pẹ̀lẹ́ bá a sọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni èmi yóò ti dá ọgbà àjàrà rẹ̀ padà fún un,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:15"
      },
      "items": [
        {
          "text": "Èmi yóò fi àfonífojì Akori ṣe ìlẹ̀kùn ìrètí fún un.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:15"
      },
      "items": [
        {
          "text": "Yóò sì kọrin níbẹ̀ gẹ́gẹ́ bí ìgbà èwe rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:15"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ìgbà tó kúrò ní Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yóò sì ṣe ní ọjọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:16"
      },
      "items": [
        {
          "text": "ìwọ yóò pè mí ní 'ọkọ mi';",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:16"
      },
      "items": [
        {
          "text": "ìwọ kò sì ní pè mí ní 'olúwa à mi mọ́,'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:16"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.2.16",
                "verseOrgIds": [
                  "HOS.2.18"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú orúkọ, àwọn òrìṣà Baali kúrò lẹ́nu rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:17"
      },
      "items": [
        {
          "text": "ìwọ kò sì ní rí orúkọ òrìṣà Baali pè mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà, èmi yóò ṣe májẹ̀mú",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:18"
      },
      "items": [
        {
          "text": "fún wọn àti àwọn ẹranko igbó àti ẹyẹ ojú ọ̀run àti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:18"
      },
      "items": [
        {
          "text": "àwọn ẹ̀dá tí ń rìn lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:18"
      },
      "items": [
        {
          "text": "Kí wọn má bà á bẹ̀rù ara wọn mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:18"
      },
      "items": [
        {
          "text": "Ọfà, idà àti ogun jíjà ni èmi ó parun ní ilẹ̀ náà",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:18"
      },
      "items": [
        {
          "text": "kí gbogbo ènìyàn bá a lè wà ní àìléwu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fẹ́ ọ fún ara mi títí láé;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:19"
      },
      "items": [
        {
          "text": "Èmi ó fẹ́ ọ ní ìwà òdodo àti òtítọ́,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:19"
      },
      "items": [
        {
          "text": "ní ìfẹ́ àti àánú.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fẹ́ ọ fún ara mi ní òtítọ́",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:20"
      },
      "items": [
        {
          "text": "ìwọ yóò sì mọ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "HOS.2.20",
                "verseOrgIds": [
                  "HOS.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi yóò sì dáhùn ní ọjọ́ náà,\"",
