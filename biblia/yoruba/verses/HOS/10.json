      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:15"
      },
      "items": [
        {
          "text": "Ní àfẹ̀mọ́júmọ́ ọjọ́ náà,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
      ]
    },
