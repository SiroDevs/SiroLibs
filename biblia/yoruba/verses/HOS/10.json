      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "Jakọbu yóò sì fọ́ ògúlùtu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
