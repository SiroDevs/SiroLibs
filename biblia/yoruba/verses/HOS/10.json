          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
