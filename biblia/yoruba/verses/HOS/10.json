      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:15"
      },
      "items": [
        {
          "text": "nítorí pé ìwà búburú yín ti pọ̀jù.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
      ]
    },
