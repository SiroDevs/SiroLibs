      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:14"
      },
      "items": [
        {
          "text": "kí gbogbo odi agbára yín ba le parun.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.14",
            "verseOrgIds": [
              "HOS.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:14"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí Ṣalmani ṣe pa Beti-Arbeli run lọ́jọ́ ogun,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.14",
            "verseOrgIds": [
              "HOS.10.14"
            ]
          }
        }
      ]
    },
