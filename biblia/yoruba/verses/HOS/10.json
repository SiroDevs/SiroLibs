      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:15"
      },
      "items": [
        {
          "text": "a o pa ọba Israẹli run pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.15",
            "verseOrgIds": [
              "HOS.10.15"
            ]
          }
        }
