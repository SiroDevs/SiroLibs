      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:13"
      },
      "items": [
        {
          "text": "nítorí ẹ tí gbẹ́kẹ̀lé agbára yín",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
