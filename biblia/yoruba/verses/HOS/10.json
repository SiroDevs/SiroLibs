            "sid": "HOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ tí gbin búburú ẹ si ka ibi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:13"
      },
      "items": [
        {
          "text": "ẹ ti jẹ èso èké",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.13",
            "verseOrgIds": [
              "HOS.10.13"
            ]
          }
        }
      ]
    },
    {
