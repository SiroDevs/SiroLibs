          "text": "Ẹ gbin òdòdó fún ara yín,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "kí ẹ sì ká èso ìfẹ́ àìlópin.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:12"
      },
      "items": [
        {
          "text": "Ẹ tu ilẹ̀ yín tí a kò ro,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.12",
            "verseOrgIds": [
              "HOS.10.12"
            ]
          }
        }
      ]
