      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "èmi ó dí ẹrù wúwo lé.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "Èmi yóò mú kí a gun Efraimu bí ẹṣin",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "Juda yóò tú ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
