      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "to si fẹ́ràn láti máa pa ọkà;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 10:11"
      },
      "items": [
        {
          "text": "lórí ọrun rẹ̀ tó lẹ́wà ni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.10.11",
            "verseOrgIds": [
              "HOS.10.11"
            ]
          }
        }
      ]
    },
    {
