              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí nínú ìbínú mi ni mo fún un yín ní ọba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.11",
            "verseOrgIds": [
