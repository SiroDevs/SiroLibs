              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ọkàn rẹ rọ̀, tí ìwọ sì ti rẹ ara rẹ sílẹ̀ níwájú",
          "type": "text",
          "attrs": {
