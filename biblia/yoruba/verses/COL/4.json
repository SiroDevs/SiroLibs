  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "COL 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹyin ọ̀gá, ẹ máa fi èyí tí ó tọ́ tí ó sì dọ́gba fún àwọn ọmọ ọ̀dọ̀ yín; kí ẹ sì mọ̀ pé ẹ̀yin pẹ̀lú ní Olúwa kan ní ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.1",
            "verseOrgIds": [
              "COL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ìlànà fún ìjọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ fi ara yín jì fún àdúrà gbígbà, kí ẹ ṣọ́ra kí ẹ sì máa dúpẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.2",
            "verseOrgIds": [
              "COL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹ máa gbàdúrà fún wa pẹ̀lú, kí Ọlọ́run lè ṣí ìlẹ̀kùn fún wa fún ọ̀rọ̀ náà, láti máa sọ ohun ìjìnlẹ̀ Kristi, nítorí èyí tí mo ṣe wà nínú ìdè pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.3",
            "verseOrgIds": [
              "COL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbàdúrà pé kí èmi le è máa kéde rẹ̀ kedere gẹ́gẹ́ bí ó ti tọ́ fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.4",
            "verseOrgIds": [
              "COL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ ọlọ́gbọ́n ní ti bí ẹ ti ń ṣe pẹ̀lú àwọn tí ń bẹ lóde, kí ẹ sì máa ṣe ṣí àǹfààní tí ẹ bá nílò.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí ọ̀rọ̀ yín kí ó dàpọ̀ mọ́ oore-ọ̀fẹ́ nígbà gbogbo, èyí tí a fi iyọ̀ dùn, kí ẹ̀yin kí ó le mọ́ bí ẹ̀yin ó tí máa dá olúkúlùkù ènìyàn lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ìkíni ìkẹyìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo bí nǹkan ti rí fún mi ní Tikiku yóò jẹ́ kí ẹ mọ̀. Òun jẹ́ arákùnrin olùfẹ́ àti olóòtítọ́ ìránṣẹ́ àti ẹlẹgbẹ́ nínú Olúwa,",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹni tí èmí ń rán sí yín nítorí èyí kan náà, kí ẹ̀yin lè mọ́ bí a ti wà, kí òun kí ó lè tu ọkàn yín nínú.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì ń bọ̀ pẹ̀lú Onesimu, arákùnrin olóòtítọ́ àti olùfẹ́, ẹni tí í ṣe ọ̀kan nínú yín. Àwọn ní yóò sọ ohun gbogbo tí à ń ṣe níhìn-ín yìí fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aristarku, ẹlẹgbẹ́ mí nínú túbú kí i yín, àti Marku, ọmọ arábìnrin Barnaba. (Nípasẹ̀ ẹni tí ẹ̀yin ti gba àṣẹ; bí ó bá sì wá sí ọ̀dọ̀ yín, ẹ gbà á.)",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.10",
            "verseOrgIds": [
              "COL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti Jesu, ẹni tí à ń pè ní Justu, ẹni tí ń ṣe ti àwọn onílà. Àwọn wọ̀nyí nìkan ni olùbáṣiṣẹ́ mí fún ìjọba Ọlọ́run, àwọn ẹni tí ó tí jásí ìtùnú fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.11",
            "verseOrgIds": [
              "COL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epafira, ẹni tí ń ṣe ọ̀kan nínú yín àti ìránṣẹ́ Kristi Jesu kí i yín. Òun fi ìwàyáàjà gbàdúrà nígbà gbogbo fún un yín, kí ẹ̀yin kí ó lè dúró ní pípé nínú ohun gbogbo nínú ìfẹ́ Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.12",
            "verseOrgIds": [
              "COL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí mo jẹ́rìí rẹ̀ pé ó ń ṣiṣẹ́ kárakára fún yín, àti fún àwọn tí ó wà ní Laodikea, àti àwọn tí ó wà ní Hirapoli.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.13",
            "verseOrgIds": [
              "COL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luku, arákùnrin wa ọ̀wọ́n, oníṣègùn, àti Dema ki í yín.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.14",
            "verseOrgIds": [
              "COL.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kí àwọn ará tí ó wà ní Laodikea, àti Nimpa, àti ìjọ tí ó wà ní ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.15",
            "verseOrgIds": [
              "COL.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a bá sì ka ìwé yìí ní àárín yín tan, kí ẹ mú kí a kà á pẹ̀lú nínú ìjọ Laodikea; ẹ̀yin pẹ̀lú sì ka èyí tí ó ti Laodikea wá.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.16",
            "verseOrgIds": [
              "COL.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ sì wí fún Arkippu pe, \"Kíyèsi iṣẹ́ ìránṣẹ́ tí ìwọ ti gbà nínú Olúwa kí o sì ṣe é ní kíkún.\"",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.17",
            "verseOrgIds": [
              "COL.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìkíni láti ọwọ́ èmi Paulu. Ẹ máa rántí ìdè mi. Kí oore-ọ̀fẹ́ kí ó wà pẹ̀lú yín.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.18",
            "verseOrgIds": [
              "COL.4.18"
            ]
          }
        }
      ]
    }
  ],
