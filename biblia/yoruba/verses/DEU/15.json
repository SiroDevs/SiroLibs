  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "DEU 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọdún ìyọ̀ǹda àti ìdáríjì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òpin ọdún méje méje, ẹ̀yin gbọdọ̀ máa yọ̀ǹda àwọn gbèsè.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni kí ẹ máa ṣe é. Gbogbo ẹni tí wọ́n jẹ ní gbèsè gbọdọ̀ fojú fo gbèsè tí ó ti yá ará Israẹli ènìyàn rẹ̀. Kò gbọdọ̀ béèrè ohun náà, lọ́dọ̀ ará Israẹli ènìyàn rẹ̀ tàbí lọ́dọ̀ arákùnrin rẹ̀: nítorí pé a ti kéde àkókò",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.2",
                "verseOrgIds": [
                  "DEU.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "láti fojú fo gbèsè.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ lè béèrè ìsanpadà lọ́dọ̀ àjèjì. Ṣùgbọ́n ẹ fa igi lé gbèsè yówù kó jẹ́ tí arákùnrin yín jẹ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kò sí ẹni tí yóò tọ́ sí nínú yín, nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.4",
                "verseOrgIds": [
                  "DEU.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò bùkún un yín lọ́pọ̀lọ́pọ̀ nínú ilẹ̀ náà tí ó ń mú un yín lọ láti gbà bí ìní yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.4",
            "verseOrgIds": [
              "DEU.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kìkì bí ẹ bá gbọ́rọ̀ sí àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.5",
                "verseOrgIds": [
                  "DEU.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí ẹ sì kíyèsára láti máa rìn nínú gbogbo àṣẹ wọ̀nyí, tí èmi ń pa fún un yín lónìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.6",
                "verseOrgIds": [
                  "DEU.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò bùkún un yín bí ó ti ṣèlérí, ẹ̀yin yóò sì máa yá ọ̀pọ̀lọpọ̀ orílẹ̀-èdè ẹ kì yóò sì tọrọ. Ẹ ó ṣàkóso ọ̀pọ̀lọpọ̀ orílẹ̀-èdè, ṣùgbọ́n kò sí orílẹ̀-èdè tí yóò lè jẹ ọba lé e yín lórí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí tálákà kan bá wà láàrín àwọn arákùnrin yín ní èyíkéyìí àwọn ìlú, ilẹ̀ náà tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.7",
                "verseOrgIds": [
                  "DEU.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "yín yóò fún un yín. Ẹ má ṣe ṣe àìláàánú, bẹ́ẹ̀ ni kí ẹ má ṣe háwọ́ sí arákùnrin yín tí ó jẹ́ tálákà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ lawọ́ kí ẹ sì fi tọkàntọkàn yá wọn ní ohun tí wọ́n nílò.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.8",
            "verseOrgIds": [
              "DEU.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣọ́ra kí èrò búburú kan má ṣe sí nínú àyà rẹ wí pé, \"Ọdún keje tí í ṣe ọdún ìyọ̀ǹda gbèsè ti súnmọ́,\" nípa bẹ́ẹ̀, ojú rẹ a sì burú sí arákùnrin rẹ tálákà, tí ìwọ kò sì fun ní nǹkan, o kò sì fun ní nǹkan kan. Òun a si kígbe pe Olúwa nítorí rẹ, a si di ẹ̀ṣẹ̀ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún un tọkàntọkàn, láìsí ìkùnsínú, nítorí èyí,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.10",
                "verseOrgIds": [
                  "DEU.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò bùkún fún ọ nínú iṣẹ́ ọwọ́ rẹ, àti gbogbo ìdáwọ́lé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kò lè fẹ́ tálákà kù ní ilẹ̀ náà ní ìgbà gbogbo, mo pàṣẹ fún un yín láti lawọ́ sí àwọn arákùnrin yín, sí àwọn tálákà àti sí àwọn aláìní, ní ilẹ̀ ẹ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdásílẹ̀ àwọn ẹrú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Heberu ara yín kan, yálà ọkùnrin tàbí obìnrin bá ta ara rẹ̀ fún ọ, tí ó sì sìn ọ́ fún ọdún mẹ́fà. Ní ọdún keje, jẹ́ kí ó di òmìnira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
              "DEU.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó bá dá a sílẹ̀ má ṣe jẹ́ kí ó lọ lọ́wọ́ òfo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.13",
            "verseOrgIds": [
              "DEU.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi tọkàntọkàn fún un láti inú agbo ewúrẹ́ rẹ, ilẹ̀ ìpakà rẹ, àti ibi ìfúntí rẹ. Fún un gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.14",
                "verseOrgIds": [
                  "DEU.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ ti bùkún fún ọ tó.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rántí pé ẹ ti fi ìgbà kan jẹ́ ẹrú ní Ejibiti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.15",
                "verseOrgIds": [
                  "DEU.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín sì rà yín padà, ìdí nìyí tí mo fi pa àṣẹ yìí fún un yín lónìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ìránṣẹ́ rẹ bá sọ fún ọ pé, \"Èmi kò fẹ́ fi ọ́ sílẹ̀,\" nítorí pé ó fẹ́ràn ìwọ àti ìdílé rẹ, tí ó sì tẹ́ ọ lọ́rùn,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.16",
            "verseOrgIds": [
              "DEU.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí ìwọ kí ó mú ìlu kan lu etí rẹ̀ mọ́ ara ìlẹ̀kùn, yóò sì di ẹrú rẹ láéláé. Bẹ́ẹ̀ náà ni kí o ṣe sí ìránṣẹ́ ẹrúbìnrin rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.17",
            "verseOrgIds": [
              "DEU.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe kà á sí ohun ìnira láti dá ẹrú rẹ sílẹ̀, nítorí ìsìnrú rẹ̀ fún ọ, ní ọdún mẹ́fà náà tó ìlọ́po méjì iṣẹ́ alágbàṣe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.18",
                "verseOrgIds": [
                  "DEU.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ yóò bùkún fún ọ nínú gbogbo ìdáwọ́lé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àkọ́bí àwọn ẹran ọ̀sìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àkọ́bí tí o jẹ́ akọ nínú agbo màlúù rẹ ni kí o yà sọ́tọ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.19",
                "verseOrgIds": [
                  "DEU.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", àti nínú agbo ewúrẹ́ bákan náà. Ẹ má ṣe fi àkọ́bí màlúù yín ṣiṣẹ́ rárá. Má ṣe rẹ́ irun àkọ́bí àgùntàn rẹ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdọọdún ni kí ìwọ àti ìdílé rẹ máa jẹ ẹ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.20",
                "verseOrgIds": [
                  "DEU.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín níbi tí Òun yóò yàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹran ọ̀sìn kan bá ní àbùkù: bóyá ó yarọ, tàbí fọ́jú, tàbí tí ó ní èyíkéyìí àbùkù tó burú. Ẹ kò gbọdọ̀ fi rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.15.21",
                "verseOrgIds": [
                  "DEU.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ ẹ́ ní ìlú u yín. Àti ẹni tí a kà sí mímọ́ àti aláìmọ́ ni ó lè jẹ ẹ́ bí ìgbà tí a ń jẹ èsúró tàbí àgbọ̀nrín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ̀yin kò gbọdọ̀ jẹ ẹ̀jẹ̀, ẹ dà á síta bí omi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.23",
            "verseOrgIds": [
              "DEU.15.23"
            ]
          }
        }
      ]
    }
