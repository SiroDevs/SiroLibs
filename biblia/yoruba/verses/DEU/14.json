            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi owó náà ra ohunkóhun tí o bá fẹ́, màlúù, àgùntàn, wáìnì, tàbí ọtí líle, tàbí ohunkóhun tí o bá fẹ́. Kí ìwọ àti ìdílé rẹ sì jẹ ẹ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
