                "verseOrgIds": [
                  "DEU.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yàn láti fi orúkọ rẹ̀ sí jìnnà jù).",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ pààrọ̀ àwọn ìdámẹ́wàá yín sí owó, ẹ mú owó náà lọ sí ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
