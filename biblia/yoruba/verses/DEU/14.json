              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òpin ọdún mẹ́ta mẹ́ta, ẹ̀yin yóò mú gbogbo ìdámẹ́wàá ìre oko àwọn ọdún náà, kí ẹ kó wọn jọ ní ìlú yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
