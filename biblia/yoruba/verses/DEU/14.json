                  "DEU.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ sì ti bùkún fún ọ, tí o kò sì le ru àwọn ìdámẹ́wàá rẹ (nítorí pé ibi tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "char",
