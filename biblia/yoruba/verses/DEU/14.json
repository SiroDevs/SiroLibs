          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.14.25",
                "verseOrgIds": [
                  "DEU.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò yàn.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
