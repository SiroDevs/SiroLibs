                "verseId": "DEU.14.26",
                "verseOrgIds": [
                  "DEU.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "níbẹ̀ kí ẹ sì máa yọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        },
        {
          "name": "verse",
