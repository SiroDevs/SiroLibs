                "verseOrgIds": [
                  "DEU.3.23"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.3.24",
                "verseOrgIds": [
                  "DEU.3.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè, ìwọ tí bẹ̀rẹ̀ sí fi títóbi rẹ àti ọwọ́ agbára rẹ han ìránṣẹ́ rẹ. Ọlọ́run wo ló tó bẹ́ẹ̀ láyé àti lọ́run tí ó lè ṣe àwọn iṣẹ́ agbára ńlá tí o ti ṣe?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí n kọjá lọ wo ilẹ̀ rere ti ìkọjá Jordani, ilẹ̀ òkè dídára nì àti Lebanoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n torí i tiyín,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.3.26",
                "verseOrgIds": [
                  "DEU.3.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run bínú sí mi kò sì gbọ́ tèmi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.3.26",
                "verseOrgIds": [
                  "DEU.3.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ wí pé, \"Ó tó gẹ́ẹ́, ìwọ kò gbọdọ̀ sọ ohunkóhun lórí ọ̀rọ̀ yìí sí mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gòkè lọ sí orí òkè Pisga, sì wò yíká ìwọ̀-oòrùn, ìlà-oòrùn, àríwá àti gúúsù. Fi ojú ara rẹ wo ilẹ̀ náà níwọ̀n bí ìwọ kò tí ní kọjá Jordani yìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n yan Joṣua, kí o sì gbà á níyànjú, mú un lọ́kàn le, torí pé òun ni yóò síwájú àwọn ènìyàn wọ̀nyí kọjá, yóò sì jẹ́ kí wọn jogún ilẹ̀ náà tí ìwọ yóò rí.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
            "verseOrgIds": [
              "DEU.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni a dúró ní àfonífojì ní ẹ̀bá Beti-Peori.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.29",
            "verseOrgIds": [
              "DEU.3.29"
            ]
          }
        }
      ]
    }
