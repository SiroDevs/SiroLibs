                  "DEU.3.21"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ṣe sí àwọn ilẹ̀ ọba tí ẹ̀yin n lọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
