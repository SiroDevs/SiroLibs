                "verseOrgIds": [
                  "DEU.3.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tìkára rẹ̀ ni yóò jà fún un yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
        }
