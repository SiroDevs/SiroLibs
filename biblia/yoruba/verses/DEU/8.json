  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "DEU 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Má ṣe gbàgbé",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kíyèsi i láti máa tẹ̀lé gbogbo àṣẹ tí mo fún un yín lónìí, kí ẹ bá à le yè, kí ẹ sì pọ̀ sí i wọ ilẹ̀ náà, kí ẹ sì le gba ilẹ̀ náà, tí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.1",
                "verseOrgIds": [
                  "DEU.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "fì búra ṣèlérí fún àwọn baba ńlá a yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rántí bí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.2",
                "verseOrgIds": [
                  "DEU.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ti tọ́ ọ yín ṣọ́nà ní gbogbo ọ̀nà ní aginjù fún ogójì ọdún wọ̀nyí láti tẹ orí yín ba àti láti dán an yín wò kí ó ba à le mọ bí ọkàn yín ti rí, bóyá ẹ ó pa òfin rẹ̀ mọ́ tàbí bẹ́ẹ̀ kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rẹ̀ yín sílẹ̀ nípa fífi ebi pa yín, Ó sì fi manna bọ́ ọ yín, èyí tí ẹ kò mọ̀, tí àwọn baba yín kò mọ̀, kí ó ba à lè kọ́ ọ yín pé, ènìyàn kò ti ipa oúnjẹ nìkan wà láààyè, bí kò ṣe ohun gbogbo tí ó jáde láti ẹnu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.3",
                "verseOrgIds": [
                  "DEU.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṣọ yín kò gbó mọ́ ọn yín lọ́rùn bẹ́ẹ̀ ní ẹsẹ̀ yín kò sì wú, ní ogójì ọdún náà.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ mọ̀ ní ọkàn an yín pé, bí baba ti ń kọ́ ọmọ rẹ̀, bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.5",
                "verseOrgIds": [
                  "DEU.8.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ń kọ́ ọ yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí, ẹ gbọdọ̀ pa òfin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.6",
                "verseOrgIds": [
                  "DEU.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín mọ́, nípa rínrìn ní ọ̀nà rẹ̀, àti bíbẹ̀rù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.7",
                "verseOrgIds": [
                  "DEU.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ń mú un yín bọ̀ wá sí ilẹ̀ rere ilẹ̀ tí ó kún fún odò àti ibú omi, pẹ̀lú àwọn ìsun tí ń sàn jáde láti orí òkè àti pẹ̀tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ tí ó kún fún jéró àti ọkà barle, tí ó sì kún fún àjàrà àti igi ọ̀pọ̀tọ́, igi pomegiranate, òróró olifi àti oyin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ tí oúnjẹ kò ti wọ́n, kò sí ohun tí ẹ̀yin yóò ṣe aláìní, ilẹ̀ tí irin ti pọ̀ bí òkúta, ẹ̀yin sì lè wa idẹ jáde láti inú òkè rẹ̀ wá.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ bá ti jẹ tí ẹ sì yó tán ẹ yin",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.10",
                "verseOrgIds": [
                  "DEU.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín fún pípèsè ilẹ̀ rere fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ṣọ́ra kí ẹ má gbàgbé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.11",
                "verseOrgIds": [
                  "DEU.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, nípa kíkùnà láti pa àṣẹ rẹ̀, àwọn òfin rẹ̀, àti àwọn ìlànà rẹ̀ tí mo ń fún un yín lónìí mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó má ba à jẹ́ pé, nígbà tí ẹ bá jẹun yó tán, tí ẹ bá kọ́ ilé tí ó dára tán, tí ẹ sí ń gbé inú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà tí àwọn agbo màlúù yín àti tí ewúrẹ́ ẹ yín bá pọ̀ sí i tán, tí fàdákà àti wúrà yín sì ń peléke sí i, tí ohun gbogbo tí ẹ ní sì ń pọ̀ sí i,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni ọkàn yín yóò gbéga, tí ẹ̀yin yóò sì gbàgbé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.14",
                "verseOrgIds": [
                  "DEU.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, tí ó mú un yín jáde láti Ejibiti wá, nínú oko ẹrú.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun ni ó mú un yín la aginjù ẹlẹ́rù ńlá já, ilẹ̀ tí kò sí omi tí ó sì kún fún òǹgbẹ, pẹ̀lú àwọn ejò olóró ńlá ńlá àti àkéekèe. Ó mú omi jáde fún un yín láti inú àpáta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fún yín ní manna láti jẹ nínú aginjù, ohun tí àwọn baba yín kò mọ̀ rí, kí Òun bá à le tẹ orí yín ba kí ó sì lè dán an yín wò, kí ó bá à lè dára fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ lè rò nínú ara yín pé, \"Agbára mi àti iṣẹ́ ọwọ́ mi ni ó mú ọ̀rọ̀ wọ̀nyí wá fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.17",
            "verseOrgIds": [
              "DEU.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ rántí",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.18",
                "verseOrgIds": [
                  "DEU.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí ó fún un yín ní agbára àti lè ní àwọn ọrọ̀ wọ̀nyí, tí ó sì fi mú májẹ̀mú rẹ̀ ṣẹ tí ó ti búra fún àwọn baba ńlá a yín bí ó ti rí lónìí.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ bá wá gbàgbé",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
