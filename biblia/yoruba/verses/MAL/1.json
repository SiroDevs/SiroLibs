  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀-ìjìnlẹ̀: ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.1",
                "verseOrgIds": [
                  "MAL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sí Israẹli láti ẹnu Malaki.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlọ́run fẹ́ràn Jakọbu, o sì kórìíra Esau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmí ti fẹ́ ẹ yín,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.2",
                "verseOrgIds": [
                  "MAL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:2"
      },
      "items": [
        {
          "text": "\"Ṣùgbọ́n ẹ̀yin béèrè pé, 'Báwo ni ìwọ ṣe fẹ́ wa?'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:2"
      },
      "items": [
        {
          "text": "\"Esau kì í ha ṣe arákùnrin Jakọbu bí?\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.2",
                "verseOrgIds": [
                  "MAL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. \"Síbẹ̀ èmi fẹ́ràn Jakọbu,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n Esau ni mo kórìíra, mo ti sọ àwọn òkè ńlá rẹ̀ di aṣálẹ̀, mo sì fi ìní rẹ̀ fún àwọn akátá aginjù.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.3",
            "verseOrgIds": [
              "MAL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu lè wí pé, \"Bí ó tilẹ̀ jẹ́ pé a run wá, àwa yóò padà wá, a ó sì tún ibùgbé náà kọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:4"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.4",
                "verseOrgIds": [
                  "MAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí pé: \"Àwọn lè kọ́, ṣùgbọ́n èmi yóò wó palẹ̀. Wọn yóò sì pè wọ́n ní ilẹ̀ búburú, àwọn ènìyàn tí wọ́n máa ń wà ní ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.4",
                "verseOrgIds": [
                  "MAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin yóò sì fi ojú yín rí i, ẹ̀yin yóò sì wí pé, 'Títóbi ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.5",
                "verseOrgIds": [
                  "MAL.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", títóbi rẹ̀ tayọ kọjá agbègbè Israẹli.'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹbọ àìmọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ a máa bu ọ̀wọ̀ fún baba rẹ̀, ọmọ ọ̀dọ̀ a sì máa bu ọlá fún olúwa rẹ̀. Ǹjẹ́ bí èmí bá jẹ́ baba, ọlá tí ó tọ́ sí mi ha dà? Bí èmi bá sì jẹ́ olúwa, ẹ̀rù tí ó tọ́ sí mi dà?\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.6",
                "verseOrgIds": [
                  "MAL.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:6"
      },
      "items": [
        {
          "text": "\"Ẹ̀yin ni, ẹ̀yin àlùfáà, ni ẹ ń gan orúkọ mi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:6"
      },
      "items": [
        {
          "text": "\"Ṣùgbọ́n ẹ̀yin béèrè pé, 'Báwo ni àwa ṣe gan orúkọ rẹ?'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ̀yin gbé oúnjẹ àìmọ́ sí orí pẹpẹ mi.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:7"
      },
      "items": [
        {
          "text": "\"Ẹ̀yin sì tún béèrè pé, 'Báwo ni àwa ṣe ṣe àìmọ́ sí ọ?'",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:7"
      },
      "items": [
        {
          "text": "\"Nípa sísọ pé tábìlì",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.7",
                "verseOrgIds": [
                  "MAL.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "di ẹ̀gàn.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ̀yin mú afọ́jú ẹran wá fún ìrúbọ, ṣé èyí kò ha burú bí? Nígbà tí ẹ̀yin fi amúnkùn ún àti aláìsàn ẹran rú ẹbọ, ṣé èyí kò ha burú gidigidi bí? Ẹ dán an wò, ẹ fi wọ́n rú ẹbọ sí àwọn baálẹ̀ yín! Ṣé inú rẹ̀ yóò dùn sí yín? Ṣé yóò gbà yín?\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.8",
                "verseOrgIds": [
                  "MAL.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ìsinsin yìí, ẹ bẹ Ọlọ́run kí ó ṣàánú fún wa. Ṣùgbọ́n pẹ̀lú irú àwọn ẹbọ wọ̀nyí láti ọwọ́ yín wá, ṣé yóò gbà yín?\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.9",
                "verseOrgIds": [
                  "MAL.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hó ò! Ẹnìkan ìbá jẹ́ wà láàrín yín ti yóò sé ìlẹ̀kùn tẹmpili, pé kí ẹ má ba à ṣe dá iná asán lórí pẹpẹ mi mọ́! Èmi kò ní inú dídùn sí i yín,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.10",
                "verseOrgIds": [
                  "MAL.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, \"bẹ́ẹ̀ ni èmi kì yóò gba ọrẹ kan lọ́wọ́ yín.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ mi yóò tóbi láàrín àwọn orílẹ̀-èdè, láti ìlà-oòrùn títí ó sì fi dé ìwọ̀-oòrùn. Ní ibi gbogbo ni a ó ti mú tùràrí àti ọrẹ mímọ́ wá fún orúkọ mi, nítorí orúkọ mi tóbi láàrín àwọn orílẹ̀-èdè,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.11",
                "verseOrgIds": [
                  "MAL.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí ẹ̀yin ti sọ ọ́ di àìmọ́, nínú èyí tí ẹ wí pé, 'Tábìlì Olúwa di àìmọ́ àti èso rẹ̀,' àní oúnjẹ rẹ̀ ni ohun ẹ̀gàn.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin wí pẹ̀lú pé, 'Wò ó, irú àjàgà kín ni èyí!' Ẹ̀yin sì yínmú sí i,\" ní",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.13",
                "verseOrgIds": [
                  "MAL.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:13"
      },
      "items": [
        {
          "text": "\"Nígbà tí ẹ̀yin sì mú èyí tí ó fi ara pa, arọ àti ọlọkùnrùn ẹran tí ẹ sì fi rú ẹbọ, Èmi o ha gba èyí lọ́wọ́ yín?\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.13",
                "verseOrgIds": [
                  "MAL.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ègún ni fún ẹlẹ́tàn náà, tí ó ni akọ nínú ọ̀wọ́ ẹran rẹ̀, tí ó sì ṣe ìlérí láti fi lélẹ̀ tí ó sì fi ẹran tó lábùkù rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.14",
            "verseOrgIds": [
              "MAL.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.14",
                "verseOrgIds": [
                  "MAL.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "; nítorí ọba ńlá ni Èmi,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.14",
            "verseOrgIds": [
              "MAL.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
