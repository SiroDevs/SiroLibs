              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n gbọn eruku ẹsẹ̀ wọn sí wọn, wọn sì wá sí Ikoniomu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
