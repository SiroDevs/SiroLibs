      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.8",
                "verseOrgIds": [
                  "ISA.56.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè sọ wí pé—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "ẹni tí ó kó àwọn àtìpó Israẹli jọ:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "\"Èmi yóò kó àwọn mìíràn jọ pẹ̀lú wọn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "yàtọ̀ sí àwọn tí a ti kójọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀sùn tí Ọlọ́run fi kan àwọn ìkà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wá, gbogbo ẹ̀yin ẹranko inú pápá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:9"
      },
      "items": [
        {
          "text": "ẹ wá jẹ àwọn ẹranko inú igbó run!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn olùṣọ́ Israẹli fọ́jú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "gbogbo wọn ṣe aláìní ìmọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "gbogbo wọn jẹ́ adití ajá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "wọn kò lè gbó;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "wọ́n sùn sílẹ̀ wọ́n ń lálàá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "wọ́n fẹ́ràn láti máa sùn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n jẹ́ àwọn ajá tí ó kúndùn púpọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "wọn kì í ní ànító.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "Wọ́n jẹ́ olùṣọ́-àgùntàn tí kò ní òye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "olúkúlùkù ń yà ṣọ́nà ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "ẹnìkọ̀ọ̀kan wọn sì wá ère tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igbe ẹnìkọ̀ọ̀kan wọn ni wí pé, \"Wá, fún mi ní ọtí wáìnì!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:12"
      },
      "items": [
        {
          "text": "Jẹ́ kí a mu ọtí líle wa lámu yó",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:12"
      },
      "items": [
        {
          "text": "ọ̀la yóò sì dàbí òní,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:12"
      },
      "items": [
        {
          "text": "tàbí kí ó dára jù bẹ́ẹ̀ lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
    }
