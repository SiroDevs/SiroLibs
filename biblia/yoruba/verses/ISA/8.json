              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.18",
                "verseOrgIds": [
                  "ISA.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fún mi. Àwa jẹ́ àmì àti àpẹẹrẹ ní Israẹli láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
