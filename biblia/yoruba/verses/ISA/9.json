  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ISA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A bí ọmọ kan fún wa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀, kò ní sí ìpòrúru kankan mọ́ fún àwọn tí ó wà nínú ìbànújẹ́. Nígbà kan rí ó rẹ ilẹ̀ Sebuluni sílẹ̀ àti ilẹ̀ Naftali pẹ̀lú, ṣùgbọ́n ní ọjọ́ iwájú, yóò bu ọ̀wọ̀ fún Galili ti àwọn aláìkọlà, ní ọ̀nà Òkun, ní ẹ̀gbẹ̀ẹ̀gbẹ́ Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn tí ń rìn nínú òkùnkùn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "ti rí ìmọ́lẹ̀ ńlá;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "lórí àwọn tí ń gbé nínú ilẹ̀ òjìji ikú,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "ní ara wọn ni ìmọ́lẹ̀ mọ́ sí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti sọ orílẹ̀-èdè di ńlá;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "wọ́n sì yọ̀ níwájú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí àwọn ènìyàn ti í yọ ayọ̀ ìkórè,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ènìyàn ti í yọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "nígbà tí à ń pín ìkógun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí gẹ́gẹ́ bí ọjọ́ tí a ṣẹ́gun Midiani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "ìwọ ti fọ́ ọ túútúú",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "àjàgà ti ń pa wọ́n lẹ́rù,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "ọ̀pá tí ó dábùú èjìká wọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "ọ̀gọ aninilára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo bàtà jagunjagun tí a ti lò lójú ogun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "àti gbogbo ẹ̀wù tí a yí nínú ẹ̀jẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "ni yóò wà fún ìjóná,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "àti ohun èlò iná dídá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí a bí ọmọ kan fún wa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "a fi ọmọkùnrin kan fún wa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "ìjọba yóò sì wà ní èjìká rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "A ó sì máa pè é ní",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "Ìyanu Olùdámọ̀ràn, Ọlọ́run Alágbára,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "Baba ayérayé, Ọmọ ọba aládé Àlàáfíà.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti gbígbòòrò Ìjọba rẹ̀ àti àlàáfíà rẹ̀ ni kì yóò ní ìpẹ̀kun.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "Yóò jẹ ọba lórí ìtẹ́ Dafidi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "àti lórí ẹ̀kún un rẹ̀ gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "nípa ìfìdímúlẹ̀ àti ìgbéró rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "pẹ̀lú òtítọ́ àti òdodo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "láti ìgbà náà lọ àti títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "Ìtara",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.9.7",
                "verseOrgIds": [
                  "ISA.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "ni yóò mú èyí ṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbínú",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sí Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúwa ti dojú iṣẹ́ kan kọ Jakọbu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:8"
      },
      "items": [
        {
          "text": "yóò sì wá sórí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ènìyàn ni yóò sì mọ̀ ọ́n—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "Efraimu àti gbogbo olùgbé Samaria—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "tí ó sọ pẹ̀lú ìgbéraga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
