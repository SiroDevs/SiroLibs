  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "ISA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìparun",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "lórí ilẹ̀ ayé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.24.1",
                "verseOrgIds": [
                  "ISA.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sọ ohun",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "gbogbo dòfo ní ilẹ̀ ayé",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "yóò sì pa á run",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "òun yóò pa ojú u rẹ̀ rẹ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:1"
      },
      "items": [
        {
          "text": "yóò sì fọ́n àwọn olùgbé ibẹ̀ káàkiri—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bákan náà ni yóò sì rí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "fún àlùfáà àti àwọn ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "fún ọ̀gá àti ọmọ ọ̀dọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "fún ìyá-ilé àti ọmọbìnrin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "fún olùtà àti olùrà,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "fún ayáni àti atọrọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:2"
      },
      "items": [
        {
          "text": "fún ayánilówó àti onígbèsè.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilé ayé ni a ó sọ di ahoro pátápátá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:3"
      },
      "items": [
        {
          "text": "a ó sì jẹ gbogbo rẹ̀ run.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.24.3",
                "verseOrgIds": [
                  "ISA.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó ti sọ ọ̀rọ̀ yìí.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ ayé ti gbẹ ó sì sá,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "ayé ń ṣòjòjò, àárẹ̀ mú un,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "àwọn ẹni gíga ilẹ̀ ayé wà nínú ìpọ́njú",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ènìyàn ayé ti bà á jẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "wọ́n ti pa àwọn òfin run",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "wọ́n ṣe lòdì sí àwọn ìlànà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:5"
      },
      "items": [
        {
          "text": "wọ́n sì ti ba májẹ̀mú ayérayé jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ègún kan ti jẹ ayé run;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "àwọn ènìyàn rẹ̀ ní láti ru ẹ̀bi wọn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "Nítorí náà, àwọn olùgbé ayé ti gbiná dànù,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:6"
      },
      "items": [
        {
          "text": "àwọn ẹ̀tàhóró ló sì kù.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wáìnì tuntun ti gbẹ, àjàrà sì ti rọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:7"
      },
      "items": [
        {
          "text": "gbogbo àwọn aláríyá sì kérora.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àríyá ti ṣaworo ti dákẹ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "ariwo àwọn tí ń ṣàjọyọ̀ ti dáwọ́ dúró",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "ayọ̀ dùùrù ti dákẹ́ jẹ́ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò ṣe é ṣe fún wọn láti máa mu wáìnì pẹ̀lú orin kíkọ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:9"
      },
      "items": [
        {
          "text": "ọtí líle ti di ìkorò fún àwọn ọ̀mu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú tí a run ti dahoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:10"
      },
      "items": [
        {
          "text": "ẹnu-ọ̀nà àbáwọlé kọ̀ọ̀kan ni a dí pa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òpópónà ni wọ́n ti ń kígbe fún wáìnì",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "gbogbo ayọ̀ ọ wọn ti di ìbànújẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
