      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "'Èmi ni, kò sí ẹlòmíràn lẹ́yìn mi.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
