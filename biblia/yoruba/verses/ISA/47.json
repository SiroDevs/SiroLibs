  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "ISA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìṣubú Babeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ̀kalẹ̀, jókòó nínú eruku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "wúńdíá ọmọbìnrin Babeli;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "jókòó ní ilẹ̀ láìsí ìtẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "ọmọbìnrin àwọn ará Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:1"
      },
      "items": [
        {
          "text": "A kì yóò pè ọ́ ní aláìlókun àti ẹlẹgẹ́ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mú òkúta-ọlọ kí o sì lọ ìyẹ̀fun;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "mú ìbòjú rẹ kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "Ká aṣọ ẹsẹ̀ rẹ sókè, ká aṣọ itan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:2"
      },
      "items": [
        {
          "text": "kí o sì la odò wọ̀n-ọn-nì kọjá.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìhòhò rẹ ni a ó sí síta",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "àti ìtìjú rẹ ni a ó ṣí sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "Èmi yóò sì gba ẹ̀san,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:3"
      },
      "items": [
        {
          "text": "Èmi kì yóò sì dá ẹnìkan sí.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùràpadà wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun ni orúkọ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:4"
      },
      "items": [
        {
          "text": "òun ni Ẹni Mímọ́ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jókòó ní ìdákẹ́ jẹ́ẹ́, lọ sínú òkùnkùn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "ọmọbìnrin àwọn ará Babeli;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "a kì yóò pè ọ́ ní ọbabìnrin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:5"
      },
      "items": [
        {
          "text": "àwọn ilẹ̀ ọba mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú bí mi sí àwọn ènìyàn mi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "tí mo sì ba ogún mi jẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "mo fi wọ́n lé ọ lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "Ìwọ kò sì síjú àánú wò wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "Lórí àwọn arúgbó pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:6"
      },
      "items": [
        {
          "text": "ní o gbé àjàgà tí ó wúwo lé.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ wí pé, 'Èmi yóò tẹ̀síwájú títí láé—",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "ọbabìnrin ayérayé!'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n ìwọ kò kíyèsi nǹkan wọ̀nyí",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:7"
      },
      "items": [
        {
          "text": "tàbí kí o ronú nípa ohun tí ó lè ṣẹlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí, tẹ́tí sílẹ̀, ìwọ oníwọ̀ra ẹ̀dá",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "tí o kẹ̀tẹ̀ǹfẹ̀ nínú ààbò rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "tí o sì ń sọ fún ara rẹ pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "'Èmi ni, kò sì ṣí ẹlòmíràn lẹ́yìn mi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "Èmi kì yóò di opó",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:8"
      },
      "items": [
        {
          "text": "tàbí kí n pàdánù àwọn ọmọ.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Méjèèjì yìí ni yóò wá sórí rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "láìpẹ́ jọjọ, ní ọjọ́ kan náà:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "pípàdánù ọmọ àti dídi opó.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:9"
      },
      "items": [
        {
          "text": "Wọn yóò wá sórí rẹ ní ẹ̀kúnrẹ́rẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
