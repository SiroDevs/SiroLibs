      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "nígbà tí o wí fún ara rẹ pé,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
