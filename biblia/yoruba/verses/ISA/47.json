      "attrs": {
        "style": "q2",
        "vid": "ISA 47:11"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ìwọ kì yóò mọ ọ̀nà láti ré e kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        }
      ]
    },
    {
