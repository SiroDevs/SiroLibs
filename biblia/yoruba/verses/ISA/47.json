    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 47:10"
      },
      "items": [
        {
          "text": "Ọgbọ́n àti òye rẹ ti ṣì ọ́ lọ́nà",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
