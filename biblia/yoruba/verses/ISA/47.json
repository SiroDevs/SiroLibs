      "attrs": {
        "style": "q2",
        "vid": "ISA 47:15"
      },
      "items": [
        {
          "text": "gbogbo èyí ní o tí ṣíṣẹ́ pẹ̀lú u rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
