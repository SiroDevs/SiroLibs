          ]
        },
        {
          "text": "Ìwọ ti ní ìgbẹ́kẹ̀lé nínú ìwà ìkà rẹ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
