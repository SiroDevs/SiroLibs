  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JDG 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta ará Gileadi jẹ́ akọni jagunjagun. Gileadi ni baba rẹ̀; ṣùgbọ́n ìyá rẹ̀ jẹ́ panṣágà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.1",
            "verseOrgIds": [
              "JDG.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyàwó Gileadi sì bí àwọn ọmọkùnrin fún un, nígbà tí àwọn ọmọkùnrin wọ̀nyí dàgbà, wọ́n rán Jefta jáde kúrò nílé, wọ́n wí pé, \"Ìwọ kì yóò ní ogún kankan ní ìdílé wa, nítorí pé ìwọ jẹ́ ọmọ obìnrin mìíràn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.2",
            "verseOrgIds": [
              "JDG.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì sá kúrò lọ́dọ̀ àwọn arákùnrin rẹ̀, ó sì pàgọ́ sí ilẹ̀ Tobu, ó sì ń gbé níbẹ̀, níbẹ̀ ni àwọn ènìyàn kan ti ń tẹ òfin lójú parapọ̀ láti máa tẹ̀lé e kiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.3",
            "verseOrgIds": [
              "JDG.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àsìkò kan, nígbà tí àwọn ará Ammoni dìde ogun sí àwọn Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.4",
            "verseOrgIds": [
              "JDG.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe nígbà tí àwọn Ammoni bá Israẹli jagun, àwọn àgbàgbà Gileadi tọ Jefta lọ láti pè é wá láti ilẹ̀ Tobu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.5",
            "verseOrgIds": [
              "JDG.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wí fún Jefta wí pé, \"Wá kí o sì jẹ́ olórí ogun wa kí a lè kọjú ogun sí àwọn ará Ammoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.6",
            "verseOrgIds": [
              "JDG.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì wí fún àwọn àgbàgbà Gileadi pé, \"Ṣé kì í ṣe pé ẹ kórìíra mi tí ẹ sì lé mi kúrò ní ilé baba mi? Kí ló dé tí ẹ fi tọ̀ mí wá báyìí nígbà tí ẹ wà nínú wàhálà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.7",
            "verseOrgIds": [
              "JDG.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àgbà Gileadi sì wí fún Jefta pé, \"Nítorí rẹ̀ ni àwa fi yípadà sí ọ báyìí: tẹ̀lé wa, kí a lè dojú ìjà kọ àwọn ará Ammoni, ìwọ yóò sì jẹ olórí wa àti gbogbo àwa tí ń gbé ní Gileadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.8",
            "verseOrgIds": [
              "JDG.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì wí fún àwọn àgbàgbà Gileadi pé, \"Bí ẹ̀yin bá mú mi padà láti bá àwọn ará Ammoni jà àti tí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.9",
                "verseOrgIds": [
                  "JDG.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bá fi wọ́n lé mi lọ́wọ́: ṣe èmi yóò jẹ́ olórí yín nítòótọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àgbàgbà Gileadi sì wí fún Jefta pé, \"Àwa fi",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.10",
                "verseOrgIds": [
                  "JDG.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣe ẹlẹ́rìí: àwa yóò ṣe ohunkóhun tí o bá wí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì tẹ̀lé àwọn àgbàgbà Gileadi lọ, àwọn ènìyàn náà sì fi ṣe olórí àti ọ̀gágun wọn. Jefta sì tún sọ gbogbo àwọn ọ̀rọ̀ tí ó ti sọtẹ́lẹ̀ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.11",
                "verseOrgIds": [
                  "JDG.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ní Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì rán àwọn oníṣẹ́ sí ọba àwọn ará Ammoni pé, \"Kí ni ẹ̀sùn tí o ní sí wa láti fi kàn wá tí ìwọ fi dojú ìjà kọ ilẹ̀ wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba àwọn Ammoni dá àwọn oníṣẹ́ Jefta lóhùn pé, \"Nígbà tí àwọn ọmọ Israẹli jáde ti Ejibiti wá. Wọ́n gba ilẹ̀ mi láti Arnoni dé Jabbok, àní dé Jordani, nítorí náà dá wọn padà lọ ní àlàáfíà àti ní pẹ̀lẹ́ kùtù.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.13",
            "verseOrgIds": [
              "JDG.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì tún ránṣẹ́ padà sí ọba àwọn ará Ammoni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.14",
            "verseOrgIds": [
              "JDG.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JDG 11:15"
      },
      "items": [
        {
          "text": "\"Báyìí ni Jefta wí: àwọn ọmọ Israẹli kò gba ilẹ̀ Moabu tàbí ilẹ̀ àwọn ará Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí wọ́n jáde kúrò ní Ejibiti àwọn ọmọ Israẹli la aginjù kọjá lọ sí ọ̀nà Òkun Pupa wọ́n sì lọ sí Kadeṣi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.16",
            "verseOrgIds": [
              "JDG.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Israẹli rán àwọn oníṣẹ́ sí ọba Edomu pé, 'Gbà fún wa láti gba ilẹ̀ rẹ̀ kọjá,' ṣùgbọ́n ọba Edomu kò fetí sí wọn. Wọ́n tún ránṣẹ́ sí ọba Moabu bákan náà òun náà kọ̀. Nítorí náà Israẹli dúró sí Kadeṣi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.17",
            "verseOrgIds": [
              "JDG.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wọ́n rin aginjù kọjá, wọ́n pẹ́ àwọn ilẹ̀ Edomu àti ti Moabu sílẹ̀, nígbà tí wọ́n gba apá ìlà-oòrùn Moabu, wọ́n sì tẹ̀dó sí apá kejì Arnoni. Wọn kò wọ ilẹ̀ Moabu, nítorí pé ààlà rẹ̀ ni Arnoni wà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.18",
            "verseOrgIds": [
              "JDG.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà náà ni Israẹli rán àwọn oníṣẹ́ sí Sihoni ọba àwọn ará Amori, ẹni tí ń ṣe àkóso ní Heṣboni, wọ́n sì wí fún un pé, 'Jẹ́ kí a la ilẹ̀ rẹ kọjá lọ sí ibùgbé wa.'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.19",
            "verseOrgIds": [
              "JDG.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Sihoni kò gba Israẹli gbọ́ (kò fọkàn tán an) láti jẹ́ kí ó kọjá. Ó kó gbogbo àwọn ènìyàn rẹ̀ jọ, ó sì tẹ̀dó sí Jahisa láti bá Israẹli jagun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.20",
            "verseOrgIds": [
              "JDG.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.21",
            "verseOrgIds": [
              "JDG.11.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.21",
                "verseOrgIds": [
                  "JDG.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli sì fi Sihoni àti àwọn ọmọ-ogun rẹ̀ lé Israẹli lọ́wọ́, wọ́n sì ṣẹ́gun wọn. Israẹli sì gba gbogbo ilẹ̀ àwọn ará Amori tí wọ́n ń gbé ní agbègbè náà,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.21",
            "verseOrgIds": [
              "JDG.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n gbà gbogbo agbègbè àwọn ará Amori, láti Arnoni tí ó fi dé Jabbok, àti láti aginjù dé Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.22",
            "verseOrgIds": [
              "JDG.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wàyí o, nígbà tí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.23",
            "verseOrgIds": [
              "JDG.11.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.23",
                "verseOrgIds": [
                  "JDG.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, ti lé àwọn ará Amori kúrò níwájú àwọn ènìyàn rẹ̀; Israẹli, ẹ̀tọ́ wo ni ẹ ní láti gba ilẹ̀ náà?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.23",
            "verseOrgIds": [
              "JDG.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ìwọ kì yóò ha gba èyí tí Kemoṣi òrìṣà rẹ fi fún ọ? Bákan náà àwa yóò gba èyíkéyìí tí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.24",
            "verseOrgIds": [
              "JDG.11.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.24",
                "verseOrgIds": [
                  "JDG.11.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa fi fún wa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.24",
            "verseOrgIds": [
              "JDG.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ìwọ ha sàn ju Balaki ọmọ Sippori, ọba Moabu lọ? Ǹjẹ́ òun ha ṣe gbólóhùn asọ̀ pẹ̀lú Israẹli bí? Tàbí òun dojú ìjà kọ wọ́n rí bí?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.25",
            "verseOrgIds": [
              "JDG.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ọ̀ọ́dúnrún (300) ọdún ni Israẹli fi ṣe àtìpó ní Heṣboni, Aroeri àti àwọn ìgbèríko àti àwọn ìlú tí ó yí Arnoni ká. Èéṣe tí ìwọ kò fi gbà wọ́n padà ní àsìkò náà?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.26",
            "verseOrgIds": [
              "JDG.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kọ́ ni ó ṣẹ̀ ọ́, ṣùgbọ́n ìwọ ni ó ṣẹ̀ mí nípa kíkógun tọ̀ mí wá. Jẹ́ kí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.27",
                "verseOrgIds": [
                  "JDG.11.27"
                ]
              }
            }
          ]
        },
        {
          "text": "olùdájọ́, ṣe ìdájọ́ lónìí láàrín àwọn ọmọ Israẹli àti àwọn ará Ammoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọba àwọn Ammoni kò fetí sí iṣẹ́ tí Jefta rán sí i.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.29",
            "verseOrgIds": [
              "JDG.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.29",
                "verseOrgIds": [
                  "JDG.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bà lé Jefta òun sì la Gileadi àti Manase kọjá. Ó la Mispa àti Gileadi kọjá láti ibẹ̀, ó tẹ̀síwájú láti bá àwọn ará Ammoni jà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.29",
            "verseOrgIds": [
              "JDG.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.30",
            "verseOrgIds": [
              "JDG.11.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.30",
                "verseOrgIds": [
                  "JDG.11.30"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Bí ìwọ bá fi àwọn ará Ammoni lé mi lọ́wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.30",
            "verseOrgIds": [
              "JDG.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "yóò sì ṣe, ohunkóhun tí ó bá jáde láti ẹnu-ọ̀nà ilé mi láti wá pàdé mi, nígbà tí èmi bá ń padà bọ̀ láti ọ̀dọ̀ àwọn ọmọ Ammoni ní àlàáfíà, yóò jẹ́ ti",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.31",
                "verseOrgIds": [
                  "JDG.11.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmi yóò sì fi rú ẹbọ bí ọrẹ ẹbọ sísun.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta sì jáde lọ láti bá àwọn ará Ammoni jagun,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.32",
                "verseOrgIds": [
                  "JDG.11.32"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi wọ́n lé e lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì ṣẹ́gun wọn, ó sì pa wọ́n ní à pa tán láti Aroeri títí dé agbègbè Minniti, ó jẹ́ ogún ìlú, títí dé Abeli-Keramimu. Báyìí ni Israẹli ti ṣẹ́gun àwọn ará Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jefta padà sí ilé rẹ̀ ní Mispa, wò ó, ọmọ rẹ̀ obìnrin ń jáde bọ̀ wá pàdé rẹ̀ pẹ̀lú timbrili àti ijó. Òun ni ọmọ kan ṣoṣo tí ó ní: kò ní ọmọkùnrin àti ọmọbìnrin mìíràn yàtọ̀ sí òun nìkan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.34",
            "verseOrgIds": [
              "JDG.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà tí ó rí i ó fa aṣọ rẹ̀ ya ní ìbànújẹ́, ó sì ké wí pé, \"Háà! Ọ̀dọ́mọbìnrin mi, ìwọ fún mi ní ìbànújẹ́ ọkàn ìwọ sì rẹ̀ mí sílẹ̀ gidigidi, nítorí pé èmi ti ya ẹnu mi sí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.35",
                "verseOrgIds": [
                  "JDG.11.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ẹ̀jẹ́, èmi kò sì le sẹ́ ẹ̀jẹ́ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ náà sì dáhùn pé, \"Baba mi bí ìwọ bá ti jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.36",
                "verseOrgIds": [
                  "JDG.11.36"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣe sí mi gẹ́gẹ́ bí ìlérí rẹ, ní báyìí tí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.11.36",
                "verseOrgIds": [
                  "JDG.11.36"
                ]
              }
            }
          ]
        },
        {
          "text": "ti gba ẹ̀san fún ọ lára àwọn ọ̀tá rẹ, àwọn ará Ammoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n yọ̀ǹda ìbéèrè kan yìí fún mi, gbà mí láààyè oṣù méjì láti rìn ká orí àwọn òkè, kí n sọkún pẹ̀lú àwọn ẹlẹgbẹ́ mi torí mo jẹ́ wúńdíá tí n kò sì ní lè ṣe ìgbéyàwó.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.37",
            "verseOrgIds": [
              "JDG.11.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jefta dá lóhùn pé, \"Ìwọ lè lọ.\" Ó sì gbà á láààyè láti lọ fún oṣù méjì. Òun àti àwọn ọmọbìnrin yòókù lọ sí orí àwọn òkè, wọ́n sọkún nítorí pé kì yóò lè ṣe ìgbéyàwó.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.38",
            "verseOrgIds": [
              "JDG.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn oṣù méjì náà, ó padà tọ baba rẹ̀ wá òun sì ṣe sí i bí ẹ̀jẹ́ tí ó ti jẹ́. Ọmọ náà sì jẹ́ wúńdíá tí kò mọ ọkùnrin rí.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 11:39"
      },
      "items": [
        {
          "text": "Èyí sì bẹ̀rẹ̀ àṣà kan ní Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "wí pé ní ọjọ́ mẹ́rin láàrín ọdún àwọn obìnrin Israẹli a máa lọ láti ṣọ̀fọ̀ àti ṣe ìrántí ọmọbìnrin Jefta ti Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.40",
            "verseOrgIds": [
              "JDG.11.40"
            ]
          }
        }
      ]
    }
  ],
