          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gideoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì túnṣe ohun tí ó burú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.1",
                "verseOrgIds": [
                  "JDG.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ó sì fi wọ́n lé àwọn ará Midiani lọ́wọ́ fún ọdún méje.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agbára àwọn ará Midiani sì pọ̀ púpọ̀ lórí àwọn Israẹli, wọ́n sì hùwà ipá sí wọn, nítorí ìdí èyí, àwọn Israẹli sálọ sí àwọn orí òkè, wọ́n sì kọ́ àgọ́ fún ara wọn nínú ihò àpáta, àti nínú ọ̀gbun àti ní ibi agbára nínú àpáta.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.2",
            "verseOrgIds": [
              "JDG.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbàkúgbà tí àwọn ọmọ Israẹli bá ti gbin ọ̀gbìn wọn, àwọn ará Midiani, àwọn ará Amaleki àti àwọn ará ìlà-oòrùn mìíràn yóò wá láti bá wọn jà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.3",
            "verseOrgIds": [
              "JDG.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò tẹ̀dó sí orí ilẹ̀ náà, wọn a sì bá irúgbìn wọ̀nyí jẹ́ títí dé Gasa, wọn kì í sì í fi ohun alààyè kankan sílẹ̀ fún àwọn ọmọ Israẹli, kì bá à ṣe àgùntàn, màlúù tàbí kẹ́tẹ́kẹ́tẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.4",
            "verseOrgIds": [
              "JDG.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn a máa wá pẹ̀lú ohun ọ̀sìn wọn àti àwọn àgọ́ wọn, wọn a sì dàbí eṣú nítorí i púpọ̀ wọn. Ènìyàn kò sì lè ka iye àwọn ènìyàn náà bẹ́ẹ̀ ni àwọn ìbákasẹ, wọ́n pọ̀ dé bi pé wọn kò ṣe é kà ní iye, wọn a bo ilẹ̀ náà wọn a sì jẹ ẹ́ run.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.5",
            "verseOrgIds": [
              "JDG.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Midiani sì pọ́n àwọn ọmọ Israẹli lójú, wọ́n sọ wọ́n di òtòṣì àti aláìní, fún ìdí èyí wọ́n ké pe",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.6",
                "verseOrgIds": [
                  "JDG.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nínú àdúrà fún ìrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ Israẹli ké pe",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.7",
                "verseOrgIds": [
                  "JDG.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nítorí àwọn ará Midiani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.8",
                "verseOrgIds": [
                  "JDG.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "fi etí sí igbe wọn, ó sì rán wòlíì kan sí wọn, ẹni tí ó wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.8",
                "verseOrgIds": [
                  "JDG.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli wí: mo mú yín gòkè ti Ejibiti wá, láti oko ẹrú.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo gbà yín kúrò nínú agbára Ejibiti àti kúrò ní ọwọ́ gbogbo àwọn aninilára yín. Mo lé wọn kúrò ní iwájú yín, mo sì fi ilẹ̀ wọn fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.9",
            "verseOrgIds": [
              "JDG.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo wí fún un yín pé, 'Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.10",
                "verseOrgIds": [
                  "JDG.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín; ẹ má ṣe sin àwọn òrìṣà àwọn ará Amori, ní ilẹ̀ ẹni tí ẹ̀yin ń gbé.' Ṣùgbọ́n ẹ̀yin kò gbọ́rọ̀ sí ohun tí mo sọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kan angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.11",
                "verseOrgIds": [
                  "JDG.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wá, ó sì jókòó ní abẹ́ igi óákù Ofira èyí ti ṣe ti Joaṣi ará Abieseri, níbi tí Gideoni ọmọ rẹ̀ ti ń lu ọkà jéró, níbi ìpọntí wáìnì láti fi pamọ́ kúrò níwájú àwọn ará Midiani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.12",
                "verseOrgIds": [
                  "JDG.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "fi ara han Gideoni, ó wí fún un pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.12",
                "verseOrgIds": [
                  "JDG.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú rẹ, akọni ológun.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni dáhùn pé, \"Alàgbà, bí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.13",
                "verseOrgIds": [
                  "JDG.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bá wà pẹ̀lú wa, kí ló dé tí gbogbo ìwọ̀nyí fi ń ṣẹlẹ̀ sí wa? Níbi gbogbo àwọn iṣẹ́ ìyanu rẹ tí àwọn baba wa ròyìn rẹ̀ fún wa nígbà tí wọ́n wí pé, '",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.13",
                "verseOrgIds": [
                  "JDG.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kò ha mú wa gòkè láti ilẹ̀ Ejibiti wá?' Ṣùgbọ́n nísinsin yìí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.13",
                "verseOrgIds": [
                  "JDG.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kọ̀ wá sílẹ̀, ó sì ti fi wá lé àwọn ará Midiani lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.14",
                "verseOrgIds": [
                  "JDG.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sì yípadà sí i, ó sì wí fún un pé, \"Lọ nínú agbára tí o ní yìí, kí o sì gba àwọn ará Israẹli sílẹ̀ kúrò lọ́wọ́ àwọn ará Midiani. Èmi ni ó ń rán ọ lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni sì dáhùn pé, \"Yéè olúwa mi, ọ̀nà wo ni èmi yóò fi gba Israẹli là? Ìdílé mi ni ó jẹ́ aláìlera jù ní Manase, àti pé èmi ni ó sì kéré jù ní ìdílé baba mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.16",
                "verseOrgIds": [
                  "JDG.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dáhùn pé, \"Èmi yóò wà pẹ̀lú rẹ, ìwọ yóò sì pa gbogbo àwọn ará Midiani láì ku ẹnìkankan.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni sì dáhùn pé, nísinsin yìí tí mo bá bá ojúrere rẹ pàdé, fún mi ní àmì pé ìwọ ni ń bá mi sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jọ̀wọ́ má ṣe kúrò níbí títí èmi yóò fi mú ọrẹ wá fún ọ kí n sì gbé e sí iwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 6:18"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.18",
                "verseOrgIds": [
                  "JDG.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, \"Èmi yóò dúró títí ìwọ yóò fi dé.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni sì yára wọ ilé lọ, ó sì pa ọ̀dọ́ ewúrẹ́ kan, wọ́n sì sè é, ó sì mú ìyẹ̀fun efa kan, ó fi ṣe àkàrà aláìwú. Ó gbé ẹran náà sínú agbọ̀n, ṣùgbọ́n ó fi ọbẹ̀ rẹ̀ sínú ìkòkò, ó gbé wọn jáde tọ angẹli náà wá bí ọrẹ lábẹ́ igi óákù.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli Ọlọ́run náà sì wí fún un pé, \"Gbé ẹran náà àti àkàrà àìwú náà, sí orí àpáta yìí, kí o sì da omi ọbẹ̀ rẹ̀ sí orí rẹ̀.\" Gideoni sì ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.20",
            "verseOrgIds": [
              "JDG.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.21",
                "verseOrgIds": [
                  "JDG.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi orí ọ̀pá tí ó wà ní ọwọ́ rẹ̀ kan ẹran àti àkàrà àìwú náà. Iná sì jáde láti inú àpáta, ó sì jó ẹran àti àkàrà náà, kò sì rí angẹli náà mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Gideoni sì ti mọ̀ dájúdájú pé angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.22",
                "verseOrgIds": [
                  "JDG.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ni, ó ké wí pé, \"Háà!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.22",
                "verseOrgIds": [
                  "JDG.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè! Mo ti rí angẹli",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.22",
                "verseOrgIds": [
                  "JDG.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ojúkorojú!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.23",
                "verseOrgIds": [
                  "JDG.6.23"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún un pé, \"Àlàáfíà! Má ṣe bẹ̀rù, ìwọ kì yóò kùú.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Gideoni mọ pẹpẹ kan fún",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.24",
                "verseOrgIds": [
                  "JDG.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "níbẹ̀, ó sì pe orúkọ rẹ̀ ní \"Àlàáfíà ni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.24",
                "verseOrgIds": [
                  "JDG.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Ó sì wà ní Ofira ti Abieseri títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òru ọjọ́ náà",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.25",
                "verseOrgIds": [
                  "JDG.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún un pé, mú akọ màlúù baba rẹ, àní akọ màlúù kejì ọlọ́dún méje. Wó pẹpẹ Baali baba rẹ lulẹ̀, kí o sì bẹ́ igi ère òrìṣà Aṣerah tí ó wà ní ẹ̀gbẹ́ rẹ̀ lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí kí o wá mọ pẹpẹ èyí tí ó yẹ fún",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.26",
                "verseOrgIds": [
                  "JDG.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ lórí òkè yìí. Kí o sì mú akọ màlúù kejì, kí o sì mú igi ère òrìṣà Aṣerah tí ìwọ bẹ́ lulẹ̀ rú ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.26",
                "verseOrgIds": [
                  "JDG.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni mú mẹ́wàá nínú àwọn ìránṣẹ́ rẹ̀, ó sì ṣe bí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.27",
                "verseOrgIds": [
                  "JDG.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún un ṣùgbọ́n, nítorí ó bẹ̀rù àwọn ará ilé baba rẹ̀ àti àwọn ènìyàn ìlú náà kò ṣe é ní ọ̀sán, òru ni ó ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ilẹ̀ ọjọ́ kejì mọ́, tí àwọn ènìyàn ìlú náà jí, wọ́n rí i pé àti fọ́ pẹpẹ Baali àti pé a ti bẹ́ igi ère òrìṣà Aṣerah tí ó wà ní ẹ̀gbẹ́ rẹ̀, a sì ti fi akọ màlúù kejì rú ẹbọ lórí pẹpẹ tí a ṣẹ̀ṣẹ̀ mọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.28",
            "verseOrgIds": [
              "JDG.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn ìlú náà bi ara wọn wí pé, \"Ta ni ó ṣe èyí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 6:29"
      },
      "items": [
        {
          "text": "Lẹ́yìn tí wọn fi ara balẹ̀ ṣe ìwádìí, wọ́n gbọ́ wí pé, \"Gideoni ọmọ Joaṣi ni ó ṣe é.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin ìlú náà sì wí fún Joaṣi wí pé, \"Mú ọmọ rẹ jáde wá. Ó ní láti kú nítorí pé ó ti wó pẹpẹ Baali lulẹ̀ ó sì ti ké ère òrìṣà Aṣerah tí ó wà ní ẹ̀bá rẹ̀ lulẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Joaṣi bi àwọn èrò tí wọ́n fi ìbínú dúró tì í wí pé, \"Ẹ̀yin yóò ha gbìjà Baali bí? Ẹ̀yin yóò ha gbà á sílẹ̀ bí? Ẹnikẹ́ni tí ó bá gbìjà rẹ̀ kíkú ni olúwa rẹ̀ yóò kú ní òwúrọ̀. Bí Baali bá ṣe Ọlọ́run nítòótọ́ yóò jà fún ara rẹ̀ bí ẹnikẹ́ni bá wó pẹpẹ rẹ̀ lulẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ìdí èyí ní ọjọ́ náà wọ́n pe Gideoni ní \"Jerubbaali\" wí pé, \"Jẹ́ kí Baali bá a jà,\" nítorí pé ó ti wó pẹpẹ Baali.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láìpẹ́ jọjọ, àwọn ogun àwọn Midiani, ti àwọn Amaleki àti ti àwọn ènìyàn ìhà ìlà-oòrùn yòókù kó ara wọn jọ pọ̀ ní ìṣọ̀kan, wọ́n sì kọjá Jordani wọ́n sì tẹ̀dó sí àfonífojì Jesreeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.6.34",
                "verseOrgIds": [
                  "JDG.6.34"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bà lé Gideoni, ó sì fun fèrè ìpè, láti pe àwọn ará Abieseri láti tẹ̀lé òun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rán àwọn oníṣẹ́ la ilẹ̀ Manase já pé kí wọ́n dira ogun, àti sí Aṣeri, Sebuluni àti Naftali gbogbo pẹ̀lú sì lọ láti pàdé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni wí fún Ọlọ́run pé, \"Bí ìwọ yóò bá gba Israẹli là nípasẹ̀ mi bí ìwọ ti ṣe ìlérí—",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kíyèsi, èmi yóò fi awọ irun àgùntàn lé ilẹ̀ ìpakà ní alẹ́ òní. Bí ìrì bá sẹ̀ sí orí awọ yìí nìkan tí gbogbo ilẹ̀ yòókù sì gbẹ, nígbà náà ni èmi yóò mọ̀ lóòótọ́ pé ìwọ yóò gba Israẹli là nípasẹ̀ mi bí ìwọ ti sọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ó sì ṣẹlẹ̀. Nígbà tí Gideoni jí ní òwúrọ̀ ọjọ́ kejì, ó sì fún irun àgùntàn náà, ọpọ́n omi kan sì kún.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gideoni sì tún wí fún Ọlọ́run pé, \"Jọ̀wọ́ má ṣe bínú sí mi, ṣùgbọ́n jẹ́ kí n tún wá ìdánilójú kan sí i, èmi bẹ̀ ọ́ jẹ́ kí n fi awọ irun yìí ṣe ìdánwò kan sí i. Ní àsìkò yìí, jẹ́ kí awọ irun yìí gbẹ kí gbogbo ilẹ̀ sì tutù pẹ̀lú ìrì.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òru náà Ọlọ́run ṣe bẹ́ẹ̀, awọ irun àgùntàn nìkan ni ó gbẹ; gbogbo ilẹ̀ yòókù sì tutù nítorí ìrì.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
    }
