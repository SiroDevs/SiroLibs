  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JDG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orílẹ̀-èdè Israẹli bá àwọn ará Kenaani tókù jagun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ikú Joṣua, ni orílẹ̀-èdè Israẹli béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.1",
                "verseOrgIds": [
                  "JDG.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Èwo nínú ẹ̀yà wa ni yóò kọ́kọ́ gòkè lọ bá àwọn ará Kenaani jagun fún wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.2",
                "verseOrgIds": [
                  "JDG.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dáhùn pé, \"Juda ni yóò lọ; nítorí pé èmi ti fi ilẹ̀ náà lé e lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.2",
            "verseOrgIds": [
              "JDG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn olórí ẹ̀yà Juda béèrè ìrànlọ́wọ́ láti ọ̀dọ̀ àwọn ọmọ Simeoni arákùnrin wọn pé, \"Ẹ wá bá wa gòkè lọ sí ilẹ̀ tí a ti fi fún wa, láti bá àwọn ará Kenaani jà kí a sì lé wọn kúrò, àwa pẹ̀lú yóò sì bá a yín lọ sí ilẹ̀ tiyín bákan náà láti ràn yín lọ́wọ́.\" Àwọn ọmọ-ogun Simeoni sì bá àwọn ọmọ-ogun Juda lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ-ogun Juda sì kọlu wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.4",
                "verseOrgIds": [
                  "JDG.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi àwọn ará Kenaani àti àwọn ará Peresi lé wọn lọ́wọ́, wọ́n sì pa ẹgbẹ̀rún mẹ́wàá (10,000) ọkùnrin ní Beseki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Beseki ni wọ́n ti rí Adoni-Beseki, wọ́n sì bá a jagun, wọ́n sì ṣẹ́gun àwọn ará Kenaani àti Peresi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.5",
            "verseOrgIds": [
              "JDG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Adoni-Beseki sá àsálà, ṣùgbọ́n ogun Israẹli lépa rẹ̀ wọ́n sì bá a, wọ́n sì gé àwọn àtàǹpàkò ọwọ́ àti ẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.6",
            "verseOrgIds": [
              "JDG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Adoni-Beseki wí pé, \"Àádọ́rin ọba ni èmi ti gé àtàǹpàkò wọn tí wọ́n sì ń ṣa èérún oúnjẹ jẹ lábẹ́ tábìlì mi. Báyìí Ọlọ́run ti san án fún mi gẹ́gẹ́ bí ohun tí mo ṣe sí wọn.\" Wọ́n sì mú un wá sí Jerusalẹmu, ó sì kú síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ológun Juda sì ṣẹ́gun Jerusalẹmu, wọ́n sì kó o, wọ́n sì fi ojú idà kọlù ú, wọ́n sì dáná sun ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.8",
            "verseOrgIds": [
              "JDG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn nǹkan wọ̀nyí ni àwọn ogun Juda sọ̀kalẹ̀ lọ láti bá àwọn ará Kenaani tí ń gbé ní àwọn ìlú orí òkè ní gúúsù àti ní pẹ̀tẹ́lẹ̀ òkè lápá ìwọ̀-oòrùn Juda jagun.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.9",
            "verseOrgIds": [
              "JDG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogun Juda sì tún ṣígun tọ ará Kenaani tí ń gbé Hebroni (tí orúkọ rẹ̀ ń jẹ́ Kiriati-Arba) ó sì ṣẹ́gun Ṣeṣai, Ahimani àti Talmai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.10",
            "verseOrgIds": [
              "JDG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibẹ̀, wọ́n sì wọ́de ogun láti ibẹ̀ lọ bá àwọn ènìyàn tí ń gbé ní Debiri (tí à ń pè ní Kiriati-Seferi nígbà kan rí).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.11",
            "verseOrgIds": [
              "JDG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu sì wí pé, \"Èmi yóò fi ọmọbìnrin mi Aksa fún ọkùnrin tí ó bá kọlu Kiriati-Seferi, tí ó sì gbà á ní ìgbéyàwó.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.12",
            "verseOrgIds": [
              "JDG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otnieli ọmọ Kenasi, àbúrò Kalebu sì gbà á, báyìí ni Kalebu sì fi ọmọbìnrin rẹ̀ Aksa fún un ní ìyàwó.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.13",
            "verseOrgIds": [
              "JDG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kan, nígbà tí Aksa lọ sí ọ̀dọ̀ Otnieli, ó rọ̀ ọ́ kí ó béèrè ilẹ̀ oko lọ́wọ́ baba rẹ̀. Nígbà náà ni Aksa sọ̀kalẹ̀ ní orí kẹ́tẹ́kẹ́tẹ́ rẹ̀, Kalebu sì béèrè pé, \"Kí ni kí èmi ṣe fún ọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.14",
            "verseOrgIds": [
              "JDG.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aksa sì dáhùn pé, \"Mo ń fẹ́ kí o ṣe ojúrere kan fún mi, nígbà ti o ti fún mi ní ilẹ̀ ní gúúsù, fún mi ní ìsun omi náà pẹ̀lú.\" Kalebu sì fún un ní ìsun òkè àti ìsun ìsàlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìran Keni tí wọ́n jẹ́ àna Mose bá àwọn ọmọ Juda gòkè láti ìlú ọ̀pẹ lọ sí aginjù Juda ní gúúsù Aradi; wọ́n sì lọ, orílẹ̀-èdè méjèèjì sì jùmọ̀ ń gbé pọ̀ láti ìgbà náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.16",
            "verseOrgIds": [
              "JDG.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, àwọn ológun Juda tẹ̀lé àwọn ológun Simeoni arákùnrin wọn, wọ́n sì lọ bá àwọn ará Kenaani tí ń gbé Sefati jagun, wọ́n sì run ìlú náà pátápátá, ní báyìí àwa yóò pe ìlú náà ní Horma (Horma èyí tí ń jẹ́ ìparun).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.17",
            "verseOrgIds": [
              "JDG.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ogun Juda sì ṣẹ́gun Gasa àti àwọn agbègbè rẹ̀, Aṣkeloni àti Ekroni pẹ̀lú àwọn ìlú tí ó yí ọ̀kọ̀ọ̀kan wọn ká.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.18",
            "verseOrgIds": [
              "JDG.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.19",
                "verseOrgIds": [
                  "JDG.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wà pẹ̀lú ẹ̀yà Juda, wọ́n gba ilẹ̀ òkè, ṣùgbọ́n wọn kò le lé àwọn ènìyàn tí ó wà ní pẹ̀tẹ́lẹ̀, nítorí wọ́n ní kẹ̀kẹ́ ogun onírin.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí Mose ti ṣèlérí, wọ́n fún Kalebu ní Hebroni, ó sì lé àwọn tí ń gbé ibẹ̀ kúrò; àwọn náà ni ìran àwọn ọmọ Anaki mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀yà Benjamini ni wọn kò le lé àwọn Jebusi tí wọ́n ń gbé Jerusalẹmu, nítorí náà wọ́n ń gbé àárín àwọn Israẹli títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀yà Josẹfu sì bá Beteli jagun,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.1.22",
                "verseOrgIds": [
                  "JDG.1.22"
                ]
              }
            }
          ]
        },
        {
          "text": "síwájú pẹ̀lú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ̀yà Josẹfu rán àwọn ènìyàn láti lọ yọ́ Beteli wò (orúkọ ìlú náà tẹ́lẹ̀ rí ni Lusi).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
              "JDG.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ayọ́lẹ̀wò náà rí ọkùnrin kan tí ń jáde láti inú ìlú náà wá, wọ́n sì wí fún un pé, \"Fi ọ̀nà àtiwọ ìlú yìí hàn wá, àwa ó sì dá ẹ̀mí rẹ sí, a ó sì ṣe àánú fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.24",
            "verseOrgIds": [
              "JDG.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi ọ̀nà ìlú náà hàn wọ́n, wọ́n sì fi ojú idà kọlu ìlú náà, ṣùgbọ́n wọ́n dá ọkùnrin náà àti gbogbo ìdílé rẹ̀ si.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà sí lọ sí ilẹ̀ àwọn ará Hiti, ó sì tẹ ìlú kan dó, ó sì pe orúkọ rẹ̀ ní Lusi, èyí sì ni orúkọ rẹ̀ títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Manase kò lé àwọn ará Beti-Ṣeani àti ìlú rẹ̀ wọ̀n-ọn-nì jáde, tàbí àwọn ará Taanaki àti àwọn ìgbèríko rẹ̀, tàbí àwọn ará Dori àti àwọn ìgbèríko rẹ̀, tàbí àwọn ará Ibleamu àti àwọn ìgbèríko rẹ̀, tàbí àwọn ará Megido àti àwọn ìgbèríko tí ó yí i ká, torí pé àwọn ará Kenaani ti pinnu láti máa gbé ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ Israẹli di alágbára, wọ́n mú àwọn ará Kenaani sìn bí i ẹrú, ṣùgbọ́n wọn kò fi agbára lé wọn jáde kúrò ní ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraimu náà kò lé àwọn ará Kenaani tí ó ń gbé Geseri jáde, ṣùgbọ́n àwọn ará Kenaani sì ń gbé láàrín àwọn ẹ̀yà Efraimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn Sebuluni kò lé àwọn ará Kenaani tí ń gbé Kitironi jáde tàbí àwọn ará Nahalali, ṣùgbọ́n wọ́n sọ wọ́n di ẹrú. Wọ́n sì ń sin àwọn ará Sebuluni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Aṣeri kò lé àwọn tí ń gbé ní Akko tàbí ní Sidoni tàbí ní Ahlabu tàbí ní Aksibu tàbí ní Helba tàbí ní Afiki tàbí ní Rehobu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nítorí àwọn ará Aṣeri ń gbé láàrín àwọn ará Kenaani tí wọ́n ni ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀yà Naftali pẹ̀lú kò lé àwọn ará Beti-Ṣemeṣi àti Beti-Anati jáde; ṣùgbọ́n àwọn ẹ̀yà Naftali náà ń gbé àárín àwọn ará Kenaani tí ó ti ní ilẹ̀ náà rí, ṣùgbọ́n àwọn tí ń gbé Beti-Ṣemeṣi àti Beti-Anati ń sìn ìsìn tipátipá.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Amori fi agbára dá àwọn ẹ̀yà Dani dúró sí àwọn ìlú orí òkè, wọn kò sì jẹ́ kí wọn sọ̀kalẹ̀ wá sí pẹ̀tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Amori ti pinnu láti dúró lórí òkè Heresi àti òkè Aijaloni àti ti Ṣaalbimu, ṣùgbọ́n nígbà tí ẹ̀yà Josẹfu di alágbára wọ́n borí Amori wọ́n sì mú wọn sìn.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ààlà àwọn ará Amori sì bẹ̀rẹ̀ láti ìgòkè Akrabbimu kọjá lọ sí Sela àti síwájú sí i.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        }
      ]
    }
  ],
