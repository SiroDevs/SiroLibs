  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JDG 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbéyàwó Samsoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà kan Samsoni gòkè lọ sí Timna níbẹ̀ ni ó ti rí ọmọbìnrin Filistini kan.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó darí dé, ó sọ fún àwọn òbí rẹ̀ pé, \"Mo rí obìnrin Filistini kan ní Timna: báyìí ẹ fẹ́ ẹ fún mi bí aya mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba àti ìyá rẹ̀ dáhùn pé, \"Ṣé kò sí obìnrin tí ó dára tí ó sì tẹ́ ọ lọ́rùn ní àárín àwọn ìbátan rẹ, tàbí láàrín gbogbo àwọn ènìyàn wa? Ṣé ó di dandan fún ọ láti lọ sí àárín àwọn Filistini aláìkọlà kí o tó fẹ́ ìyàwó?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:3"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n Samsoni wí fún baba rẹ̀ pé, \"Fẹ́ ẹ fún mi torí pé inú mi yọ́ sí i púpọ̀púpọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Àwọn òbí rẹ̀ kò mọ̀ pé ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.14.4",
                "verseOrgIds": [
                  "JDG.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ni nǹkan yìí ti wá, ẹni tí ń wá ọ̀nà àti bá Filistini jà; nítorí àwọn ni ń ṣe àkóso Israẹli ní àkókò náà.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni sọ̀kalẹ̀ lọ sí Timna òun àti baba àti ìyá rẹ̀. Bí wọ́n ṣe ń súnmọ́ àwọn ọgbà àjàrà tí ó wà ní Timna, láìròtẹ́lẹ̀, ọ̀dọ́ kìnnìún kan jáde síta tí ń ké ramúramù bọ̀ wá sí ọ̀dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.14.6",
                "verseOrgIds": [
                  "JDG.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sì bà lé e pẹ̀lú agbára tó bẹ́ẹ̀ tí ó fi fa kìnnìún náà ya pẹ̀lú ọwọ́ rẹ̀ lásán bí ẹní ya ọmọ ewúrẹ́, ṣùgbọ́n òun kò sọ ohun tí ó ṣe fún baba tàbí ìyá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lọ bá obìnrin náà sọ̀rọ̀, inú Samsoni sì yọ́ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.7",
            "verseOrgIds": [
              "JDG.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà díẹ̀, nígbà tí ó padà lọ láti gbé e níyàwó, ó yà lọ láti wo òkú kìnnìún náà. Inú rẹ̀ ni ó ti bá ọ̀pọ̀ ìṣù oyin àti oyin,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.8",
            "verseOrgIds": [
              "JDG.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó fi ọwọ́ ha jáde, ó sì ń jẹ ẹ́ bí ó ti ń lọ. Nígbà tí ó dé ọ̀dọ̀ àwọn òbí rẹ̀, ó fún wọn ní díẹ̀, àwọn náà sì jẹ, ṣùgbọ́n kò sọ fún wọn pé ara òkú kìnnìún ni òun ti rí oyin náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba rẹ̀ sì sọ̀kalẹ̀ lọ láti kí obìnrin náà. Samsoni sì ṣe àsè gẹ́gẹ́ bí àṣà ọkọ ìyàwó ní àkókò náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.10",
            "verseOrgIds": [
              "JDG.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó fi ara hàn, tí àwọn ènìyàn náà rí i wọ́n fún un ní ọgbọ̀n àwọn ẹlẹgbẹ́ rẹ̀ láti wá bá a kẹ́gbẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.11",
            "verseOrgIds": [
              "JDG.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsoni sọ fún wọn pé, \"Ẹ jẹ́ kí n pa àlọ́ kan fún un yín, bí ẹ̀yin bá lè fún mi ní ìtumọ̀ rẹ̀ láàrín ọjọ́ méje àsè yìí, tàbí ṣe àwárí àlọ́ náà èmi yóò fún un yín ní ọgbọ̀n aṣọ tí a fi òwú ọ̀gbọ̀ hun, àti ọgbọ̀n ìpààrọ̀ aṣọ ìyàwó.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ẹ̀yin kò bá le sọ ìtumọ̀ rẹ̀ fún mi, ẹ̀yin yóò fún mi ní ọgbọ̀n aṣọ tí a fi òwú ọ̀gbọ̀ hun àti ọgbọ̀n ìpààrọ̀ aṣọ ìgbéyàwó.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:13"
      },
      "items": [
        {
          "text": "Wọ́n dáhùn pé, \"Sọ àlọ́ rẹ fún wa jẹ́ kí a gbọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dáhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "\"Láti inú ọ̀jẹun ni ohun jíjẹ ti jáde wá;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "láti inú alágbára ni ohun dídùn ti jáde wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n fún odidi ọjọ́ mẹ́ta ni wọn kò fi rí ìtumọ̀ sí àlọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹrin, wọ́n wí fún ìyàwó Samsoni, pé, \"Tan ọkọ rẹ kí ó lè ṣe àlàyé àlọ́ náà fún wa, bí bẹ́ẹ̀ kọ́ àwa yóò sun ìwọ àti ìdílé baba rẹ̀ ní iná. Tàbí ṣe o pè wá sí ibi àsè yìí láti sọ wá di òtòṣì tàbí kó wa lẹ́rú ni?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.15",
            "verseOrgIds": [
              "JDG.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìyàwó Samsoni ṣubú lé e láyà, ó sì sọkún ní iwájú rẹ̀ pé, \"O kórìíra mi! O kò sì ní ìfẹ́ mi nítòótọ́, o pàlọ́ fún àwọn ènìyàn mi, ìwọ kò sì sọ ìtumọ̀ rẹ̀ fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:16"
      },
      "items": [
        {
          "text": "\"Èmi kò tí ì ṣe àlàyé rẹ̀ fún baba àti ìyá mi, báwo ni èmi ó ṣe sọ ìtumọ̀ rẹ̀ fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún gbogbo ọjọ́ méje tí wọ́n fi ṣe àsè náà ni ó fi sọkún, nítorí náà ní ọjọ́ keje ó sọ ìtumọ̀ àlọ́ fún un nítorí pé ó yọ ọ́ lẹ́nu ní ojoojúmọ́. Òun náà sì sọ ìtumọ̀ àlọ́ náà fún àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.17",
            "verseOrgIds": [
              "JDG.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó tó di àṣálẹ́ ọjọ́ keje àwọn ọkùnrin ìlú náà sọ fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "\"Kí ni ó dùn ju oyin lọ?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "Kí ni ó sì lágbára ju kìnnìún lọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
