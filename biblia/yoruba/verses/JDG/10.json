  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JDG 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ikú Abimeleki, ọkùnrin kan láti ẹ̀yà Isakari tí orúkọ rẹ̀ ń jẹ́ Tola ọmọ Pua, ọmọ Dodo, dìde láti gba Israẹli sílẹ̀. Ní Ṣamiri tí ó wà ní òkè Efraimu ni ó gbé.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.1",
            "verseOrgIds": [
              "JDG.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe àkóso Israẹli ní ọdún mẹ́tàlélógún. Nígbà tí ó kú wọ́n sìn ín sí Ṣamiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.2",
            "verseOrgIds": [
              "JDG.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jairi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jairi ti ẹ̀yà Gileadi ni ó dìde lẹ́yìn rẹ̀, ó ṣàkóso Israẹli ní ọdún méjìlélógún.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.3",
            "verseOrgIds": [
              "JDG.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọgbọ̀n ọmọ tí ó n gun ọgbọ̀n kẹ́tẹ́kẹ́tẹ́. Wọ́n ṣe àkóso ọgbọ̀n ìlú ní Gileadi, tí a pe orúkọ wọn ní Hafoti-Jairi títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.4",
            "verseOrgIds": [
              "JDG.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jairi kú wọ́n sin ín sí Kamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.5",
            "verseOrgIds": [
              "JDG.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jefta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì túnṣe ohun tí ó burú lójú",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.10.6",
                "verseOrgIds": [
                  "JDG.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Wọ́n sin Baali àti Aṣtoreti àti àwọn òrìṣà Aramu, òrìṣà Sidoni, òrìṣà Moabu, òrìṣà àwọn ará Ammoni àti òrìṣà àwọn ará Filistini. Nítorí àwọn ará Israẹli kọ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.10.6",
                "verseOrgIds": [
                  "JDG.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sílẹ̀ tí wọn kò sì sìn ín mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.6",
            "verseOrgIds": [
              "JDG.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó bínú sí wọn, ó fi wọ́n sílẹ̀ fún àwọn ará Filistini àti Ammoni láti jẹ ẹ́ ní ìyà.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.7",
            "verseOrgIds": [
              "JDG.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún náà, wọ́n tú wọn ká wọ́n sì pọ́n wọn lójú. Fún ọdún méjìdínlógún ni wọ́n fi ni gbogbo àwọn ọmọ Israẹli tí ó wà ní ìlà-oòrùn odò Jordani ní ilẹ̀ àwọn ará Amori lára (èyí nì ní Gileadi).",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.8",
            "verseOrgIds": [
              "JDG.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Ammoni sì la odò Jordani kọjá láti bá Juda, Benjamini àti àwọn ará ilé Efraimu jagun: Israẹli sì dojúkọ ìpọ́njú tó lágbára.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.9",
            "verseOrgIds": [
              "JDG.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí èyí ti ṣẹlẹ̀ àwọn ọmọ Israẹli ké pe",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.10.10",
                "verseOrgIds": [
                  "JDG.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Àwa ti ṣẹ̀ sí ọ, nítorí pé àwa ti kọ Ọlọ́run wa sílẹ̀, àwa sì ń sin Baali.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.10",
            "verseOrgIds": [
              "JDG.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.10.11",
                "verseOrgIds": [
                  "JDG.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dáhùn pé, \"Ǹjẹ́ nígbà tí àwọn ará Ejibiti, Amori, Ammoni, Filistini,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.11",
            "verseOrgIds": [
              "JDG.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ará Sidoni, Amaleki pẹ̀lú Maoni ni yín lára, tí ẹ sì ké pè mí fún ìrànlọ́wọ́, ǹjẹ́ èmi kò gbà yín sílẹ̀ kúrò ní ọwọ́ wọn?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.12",
            "verseOrgIds": [
              "JDG.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀ ẹ̀yin kọ̀ mí sílẹ̀ láti sin àwọn ọlọ́run mìíràn, torí ìdí èyí, èmi kì yóò sì tún gbà yín mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.13",
            "verseOrgIds": [
              "JDG.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ lọ kí ẹ sì ké pe àwọn òrìṣà tí ẹ̀yin ti yàn fún ara yín. Jẹ́ kí wọn gbà yín sílẹ̀ ní àsìkò ìpọ́njú yín!\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.14",
            "verseOrgIds": [
              "JDG.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì dá",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.10.15",
                "verseOrgIds": [
                  "JDG.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "lóhùn pé, \"Àwa ti ṣẹ̀, ṣe ohun tí ó bá fẹ́ pẹ̀lú wa, ṣùgbọ́n, jọ̀wọ́ gbà wá sílẹ̀ náání àsìkò yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.15",
            "verseOrgIds": [
              "JDG.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n kó gbogbo ọlọ́run àjèjì tí ó wà láàrín wọn kúrò wọ́n sì sin",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JDG.10.16",
                "verseOrgIds": [
                  "JDG.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nìkan, ọkàn rẹ̀ kò sì le gbàgbé ìrora Israẹli mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.16",
            "verseOrgIds": [
              "JDG.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ará Ammoni kógun jọ ní Gileadi láti bá Israẹli jà, àwọn ọmọ Israẹli gbárajọpọ̀, wọ́n sì tẹ̀dó ogun ní Mispa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.17",
            "verseOrgIds": [
              "JDG.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìjòyè: aṣíwájú àwọn ará Gileadi wí fún ará wọn pé, \"Ẹnikẹ́ni tí yóò kọ́ ṣígun si àwọn ará Ammoni ni yóò jẹ́ orí fún gbogbo àwọn tí ń gbé ní Gileadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.10.18",
            "verseOrgIds": [
              "JDG.10.18"
            ]
          }
        }
      ]
    }
  ],
