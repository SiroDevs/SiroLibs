          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, ikùn mi dàbí ọtí wáìnì, tí kò ní ojú-ìhò;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.19",
