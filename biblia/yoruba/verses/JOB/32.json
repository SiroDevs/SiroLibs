  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "JOB 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀ Elihu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ọkùnrin mẹ́tẹ̀ẹ̀ta wọ̀nyí dákẹ́ láti dá Jobu lóhùn, nítorí ó ṣe olódodo lójú ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni inú bí Elihu ọmọ Barakeli ará Busi, láti ìbátan ìdílé Ramu; ó bínú si Jobu nítorí ti ó dá ara rẹ̀ láre kàkà ki ó dá Ọlọ́run láre.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inú sì bí i sí àwọn ọ̀rẹ́ rẹ̀ mẹ́tẹ̀ẹ̀ta, nítorí tí wọn kò rí ọ̀nà láti dá Jobu lóhùn bẹ́ẹ̀ ni wọ́n dá Jobu lẹ́bi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ Elihu ti dúró títí tí Jobu fi sọ̀rọ̀ tán nítorí tí àwọn wọ̀nyí dàgbà ju òun lọ ní ọjọ́ orí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Elihu rí i pé ìdáhùn ọ̀rọ̀ kò sí ní ẹnu àwọn ọkùnrin mẹ́tẹ̀ẹ̀ta wọ̀nyí nígbà náà ni ó bínú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu, ọmọ Barakeli, ará Busi, dáhùn ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "\"Ọmọdé ni èmi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "àgbà sì ní ẹ̀yin;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "ǹjẹ́ nítorí náà ní mo dúró,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "mo sì ń bẹ̀rù láti fi ìmọ̀ mi hàn yin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi wí pé ọjọ́ orí ni ìbá sọ̀rọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:7"
      },
      "items": [
        {
          "text": "àti ọ̀pọ̀lọpọ̀ ọdún ní ìbá kọ́ ni ní ọgbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ̀mí kan ní ó wà nínú ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:8"
      },
      "items": [
        {
          "text": "àti ìmísí Olódùmarè ní ì sì máa fún wọn ní òye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn ńlá ńlá kì í ṣe ọlọ́gbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:9"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni àwọn àgbà ní òye ẹ̀tọ́ kò yé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà ní èmí ṣe wí pé, ẹ dẹtí sílẹ̀ sí mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:10"
      },
      "items": [
        {
          "text": "èmí pẹ̀lú yóò fi ìmọ̀ mi hàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, èmí ti dúró de ọ̀rọ̀ yín;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:11"
      },
      "items": [
        {
          "text": "èmi fetísí àròyé yín,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:11"
      },
      "items": [
        {
          "text": "nígbà tí ẹ̀yin ń wá ọ̀rọ̀ ti ẹ̀yin yóò sọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "àní, mo fiyèsí yín tinútinú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:12"
      },
      "items": [
        {
          "text": "Sì kíyèsi i, kò sí ẹnìkan nínú yín tí ó le já Jobu ní irọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:12"
      },
      "items": [
        {
          "text": "tàbí tí ó lè dá a lóhùn àríyànjiyàn rẹ̀!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ̀yin kí ó má ṣe wí pé, 'Àwa wá ọgbọ́n ní àwárí;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:13"
      },
      "items": [
        {
          "text": "Ọlọ́run ni ó lè bì í ṣubú kì í ṣe ènìyàn.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òun kò ti sọ̀rọ̀ sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:14"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni èmi kì yóò fi ọ̀rọ̀ yín dá a lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnu sì yà wọ́n, wọn kò sì dáhùn mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:15"
      },
      "items": [
        {
          "text": "wọ́n ṣíwọ́ ọ̀rọ̀ í sọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì retí, nítorí wọn kò sì fọhùn, wọ́n dákẹ́ jẹ́ẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:16"
      },
      "items": [
        {
          "text": "wọn kò sì dáhùn mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni èmí ó sì dáhùn nípa ti èmi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:17"
      },
      "items": [
        {
          "text": "èmí pẹ̀lú yóò sì fi ìmọ̀ mi hàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        }
