      "attrs": {
        "style": "q2",
        "vid": "JOB 32:20"
      },
      "items": [
        {
          "text": "èmí ó sí ètè mi, èmí ó sì dáhùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.20",
            "verseOrgIds": [
              "JOB.32.20"
