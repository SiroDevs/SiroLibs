              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé èmi kún fún ọ̀rọ̀ sísọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
              "JOB.32.18"
