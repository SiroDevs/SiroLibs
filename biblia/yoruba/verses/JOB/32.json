        "vid": "JOB 32:21"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni èmí kì yóò sì ṣe ìpọ́nni fún ẹnìkan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.21",
            "verseOrgIds": [
