      "attrs": {
        "style": "q2",
        "vid": "JOB 32:18"
      },
      "items": [
        {
          "text": "ẹ̀mí ń rọ̀ mi ni inú mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
              "JOB.32.18"
