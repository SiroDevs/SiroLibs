              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòtítọ́ èmi kì yóò ṣe ojúsàájú sí ẹnìkankan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.21",
            "verseOrgIds": [
