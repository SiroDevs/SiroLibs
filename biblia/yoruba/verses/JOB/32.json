          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmí ó sọ, kí ara kí ó le rọ̀ mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.20",
            "verseOrgIds": [
