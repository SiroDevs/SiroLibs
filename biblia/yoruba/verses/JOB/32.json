      "attrs": {
        "style": "q2",
        "vid": "JOB 32:19"
      },
      "items": [
        {
          "text": "ó múra tán láti bẹ́ bí ìgò-awọ tuntun.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.19",
            "verseOrgIds": [
