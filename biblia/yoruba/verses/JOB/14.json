        "style": "q2",
        "vid": "JOB 14:19"
      },
      "items": [
        {
          "text": "mú omi sàn bo ohun tí ó hù jáde lórí ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
