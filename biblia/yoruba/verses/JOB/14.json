  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOB 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jobu tẹ̀síwájú nínú àròyé rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ènìyàn tí a bí nínú obìnrin,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:1"
      },
      "items": [
        {
          "text": "ọlọ́jọ́ díẹ̀ ni, ó sì kún fún ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó jáde wá bí ìtànná ewéko, a sì ké e lulẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:2"
      },
      "items": [
        {
          "text": "ó sì ń fò lọ bí òjìji, kò sì dúró pẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sì ń síjú rẹ wò irú èyí ni?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:3"
      },
      "items": [
        {
          "text": "Ìwọ sì mú mi wá sínú ìdájọ́ pẹ̀lú rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó lè mú ohun mímọ́ láti inú àìmọ́ jáde wá?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:4"
      },
      "items": [
        {
          "text": "Kò sí ẹnìkan!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ a ti pinnu ọjọ́ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "iye oṣù rẹ̀ ń bẹ ní ọwọ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:5"
      },
      "items": [
        {
          "text": "ìwọ ti pààlà rẹ̀, bẹ́ẹ̀ ní òun kò le kọjá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yípadà kúrò lọ́dọ̀ rẹ̀, kí ó lè sinmi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:6"
      },
      "items": [
        {
          "text": "títí yóò fi pé ọjọ́ rẹ̀ bí alágbàṣe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí pé ìrètí wà fún igi, bí a bá",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "ké e lulẹ̀, pé yóò sì tún sọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:7"
      },
      "items": [
        {
          "text": "àti pé ẹ̀ka rẹ̀ tuntun kì yóò gbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí gbòǹgbò rẹ̀ tilẹ̀ di ogbó nínú ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:8"
      },
      "items": [
        {
          "text": "tí kùkùté rẹ̀ si kú ni ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "síbẹ̀ nígbà tí ó bá gbóòórùn omi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:9"
      },
      "items": [
        {
          "text": "yóò sọ, yóò sì yọ ẹ̀ka jáde bí irúgbìn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ènìyàn kú, a sì dàánù,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:10"
      },
      "items": [
        {
          "text": "àní ènìyàn jọ̀wọ́ ẹ̀mí rẹ̀ lọ́wọ́: Òun kò sì sí mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àgékúrú ọjọ́ ọmọ ènìyàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí omi ti í tán nínú ipa odò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:11"
      },
      "items": [
        {
          "text": "àti bí odò ṣì tí í fà tí sì gbẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bẹ́ẹ̀ ni ènìyàn dùbúlẹ̀ tí kò sì dìde mọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "títí ọ̀run kì yóò fi sí mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:12"
      },
      "items": [
        {
          "text": "wọ́n kì yóò jí, a kì yóò jí wọn kúrò lójú oorun wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Háà! ìwọ ìbá fi mí pamọ́ ní ipò òkú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "kí ìwọ kí ó fi mí pamọ́ ní ìkọ̀kọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "títí ìbínú rẹ yóò fi rékọjá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:13"
      },
      "items": [
        {
          "text": "ìwọ ìbá lànà ìgbà kan sílẹ̀ fún mi, kí ó si rántí mi!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ènìyàn bá kú yóò sì tún yè bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "Gbogbo ọjọ́ ìgbà tí a là sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 14:14"
      },
      "items": [
        {
          "text": "fún mi ni èmi dúró dè, títí àmúdọ̀tún mi yóò fi dé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ìbá pè, èmi ìbá sì dá ọ lóhùn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
