              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ rẹ̀ bọ́ sí ipò ọlá, òun kò sì mọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
