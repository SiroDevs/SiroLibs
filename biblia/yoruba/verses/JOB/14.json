        "vid": "JOB 14:21"
      },
      "items": [
        {
          "text": "wọ́n sì rẹ̀ sílẹ̀, òun kò sì kíyèsi i lára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
