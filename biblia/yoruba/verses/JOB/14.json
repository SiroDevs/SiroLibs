        "style": "q2",
        "vid": "JOB 14:20"
      },
      "items": [
        {
          "text": "Ìwọ pa awọ ojú rẹ̀ dà, o sì rán an lọ kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.20",
            "verseOrgIds": [
