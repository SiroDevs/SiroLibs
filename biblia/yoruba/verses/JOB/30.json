      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àti nísinsin yìí, ayé mi n yòrò lọ díẹ̀díẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:16"
      },
      "items": [
        {
          "text": "ọjọ́ ìpọ́njú mi dì mímú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.16",
            "verseOrgIds": [
              "JOB.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òru gún mi nínú egungun mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:17"
      },
      "items": [
        {
          "text": "èyí tí ó bù mí jẹ kò sì sinmi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.17",
            "verseOrgIds": [
              "JOB.30.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa agbára ńlá rẹ̀ Ọlọ́run wà bí aṣọ ìbora fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:18"
      },
      "items": [
        {
          "text": "ó sì lẹ̀ mọ́ mi ní ara yíká bí aṣọ ìlekè mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.18",
            "verseOrgIds": [
              "JOB.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run ti mú mi lọ sínú ẹrẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:19"
      },
      "items": [
        {
          "text": "èmi sì dàbí eruku àti eérú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.19",
            "verseOrgIds": [
              "JOB.30.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi ké pè ọ́ ìwọ Ọlọ́run, ṣùgbọ́n ìwọ kò dá mi lóhùn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:20"
      },
      "items": [
        {
          "text": "èmi dìde dúró ìwọ sì wò mí lásán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.20",
            "verseOrgIds": [
              "JOB.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ padà di ẹni ìkà sí mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:21"
      },
      "items": [
        {
          "text": "ọwọ́ agbára rẹ ni ìwọ fi dè mí ní ọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.21",
            "verseOrgIds": [
              "JOB.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ gbé mi sókè sí inú ẹ̀fúùfù, ìwọ mú mi fò lọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:22"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ìwọ sì sọ mí di asán pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.22",
            "verseOrgIds": [
              "JOB.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sá à mọ̀ pé ìwọ yóò mú mi lọ sínú ikú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.23",
            "verseOrgIds": [
              "JOB.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:23"
      },
      "items": [
        {
          "text": "sí ilé ìpéjọ tí a yàn fún gbogbo alààyè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.23",
            "verseOrgIds": [
              "JOB.30.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí ó ti wù kí ó rí, ẹnìkan kí yóò ha nawọ́ rẹ̀ nígbà ìṣubú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:24"
      },
      "items": [
        {
          "text": "tàbí kì yóò ké nínú ìparun rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò ha sọkún bí fún ẹni tí ó wà nínú ìṣòro?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:25"
      },
      "items": [
        {
          "text": "Ọkàn mi kò ha bàjẹ́ fún tálákà bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo fojú ṣọ́nà fún àlàáfíà, ibi sì dé;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:26"
      },
      "items": [
        {
          "text": "nígbà tí mo dúró de ìmọ́lẹ̀, òkùnkùn sì dé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikùn mí n ru kò sì sinmi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:27"
      },
      "items": [
        {
          "text": "ọjọ́ ìpọ́njú ti dé bá mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmí ń rìn kiri nínú ọ̀fọ̀, ṣùgbọ́n kì í ṣe nínú oòrùn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.28",
            "verseOrgIds": [
              "JOB.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:28"
      },
      "items": [
        {
          "text": "èmi dìde dúró ní àwùjọ mo sì kígbe fún ìrànlọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.28",
            "verseOrgIds": [
              "JOB.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti di arákùnrin ìkookò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:29"
      },
      "items": [
        {
          "text": "èmi di ẹgbẹ́ àwọn ògòǹgò.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọ̀ mi di dúdú ní ara mi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:30"
      },
      "items": [
        {
          "text": "egungun mi sì jórun fún ooru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun èlò orin mi pẹ̀lú sì di ti ọ̀fọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.31",
            "verseOrgIds": [
              "JOB.30.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:31"
      },
      "items": [
        {
          "text": "àti ìpè orin mi sì di ohùn àwọn tí ń sọkún.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.31",
            "verseOrgIds": [
              "JOB.30.31"
            ]
          }
        }
      ]
    }
