  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JOB 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jobu dá Sofari lóhùn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobu wá dáhùn, ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.1",
            "verseOrgIds": [
              "JOB.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ tẹ́tí sílẹ̀ dáradára sì àwọn ọ̀rọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:2"
      },
      "items": [
        {
          "text": "kí èyí kí ó jásí ìtùnú fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.2",
            "verseOrgIds": [
              "JOB.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jọ̀wọ́ mi ki èmi sọ̀rọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:3"
      },
      "items": [
        {
          "text": "lẹ́yìn ìgbà ìwọ le máa fi mi ṣẹ̀sín ń ṣo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.3",
            "verseOrgIds": [
              "JOB.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àròyé mi ha ṣe sí ènìyàn bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:4"
      },
      "items": [
        {
          "text": "Èétise tí ọkàn mi kì yóò fi ṣe àìbalẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.4",
            "verseOrgIds": [
              "JOB.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ wò mí fín, kí ẹnu kí ó sì yà yín,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:5"
      },
      "items": [
        {
          "text": "kí ẹ sì fi ọwọ́ lé ẹnu yín.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.5",
            "verseOrgIds": [
              "JOB.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní nígbà tí mo rántí, ẹ̀rù bà mí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:6"
      },
      "items": [
        {
          "text": "ìwárìrì sì mú mi lára.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.6",
            "verseOrgIds": [
              "JOB.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kí ní ènìyàn búburú fi wà ní ayé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:7"
      },
      "items": [
        {
          "text": "tí wọ́n gbó, àní tí wọ́n di alágbára ní ipa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.7",
            "verseOrgIds": [
              "JOB.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irú-ọmọ wọn fi ìdí kalẹ̀ ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:8"
      },
      "items": [
        {
          "text": "wọn pẹ̀lú wọn, àti ọmọ ọmọ wọn ní ojú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.8",
            "verseOrgIds": [
              "JOB.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilé wọn wà láìní ewu àti ẹ̀rù,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:9"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ọ̀pá ìbínú Ọlọ́run kò sí lára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.9",
            "verseOrgIds": [
              "JOB.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akọ màlúù wọn a máa gùn, kì í sì tàsé;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:10"
      },
      "items": [
        {
          "text": "abo màlúù wọn a máa bí, kì í sì í ṣẹ́yun.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.10",
            "verseOrgIds": [
              "JOB.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn a máa rán àwọn ọmọ wọn",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:11"
      },
      "items": [
        {
          "text": "wẹ́wẹ́ jáde bí agbo ẹran, àwọn ọmọ wọn a sì máa jo kiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.11",
            "verseOrgIds": [
              "JOB.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n mú ohun ọ̀nà orin, ìlù àti haapu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:12"
      },
      "items": [
        {
          "text": "wọ́n sì ń yọ̀ sí ohùn fèrè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.12",
            "verseOrgIds": [
              "JOB.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n n lo ọjọ́ wọn nínú ọrọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:13"
      },
      "items": [
        {
          "text": "wọn sì lọ sí ipò òkú ní àlàáfíà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.13",
            "verseOrgIds": [
              "JOB.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni wọ́n ṣe wí fún Ọlọ́run pé, 'Lọ kúrò lọ́dọ̀ wa!'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:14"
      },
      "items": [
        {
          "text": "Nítorí pé wọn kò fẹ́ ìmọ̀ ipa ọ̀nà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.14",
            "verseOrgIds": [
              "JOB.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ni Olódùmarè tí àwa ó fi máa sìn in?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:15"
      },
      "items": [
        {
          "text": "Èrè kí ni a ó sì jẹ bí àwa ba gbàdúrà sí i?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.15",
            "verseOrgIds": [
              "JOB.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, àlàáfíà wọn kò sí nípa ọwọ́ wọn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:16"
      },
      "items": [
        {
          "text": "ìmọ̀ ènìyàn búburú jìnnà sí mi réré.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.16",
            "verseOrgIds": [
              "JOB.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìgbà mélòó mélòó ní a ń pa fìtílà ènìyàn búburú kú?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "Ìgbà mélòó mélòó ní ìparun wọn dé bá wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:17"
      },
      "items": [
        {
          "text": "tí Ọlọ́run sì í máa pín ìbìnújẹ́ nínú ìbínú rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.17",
            "verseOrgIds": [
              "JOB.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dàbí àgékù koríko níwájú afẹ́fẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:18"
      },
      "items": [
        {
          "text": "àti bí ìyàngbò, tí ẹ̀fúùfù ńlá fẹ́ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.18",
            "verseOrgIds": [
              "JOB.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin wí pé, 'Ọlọ́run to ìyà ẹ̀ṣẹ̀ rẹ̀ jọ fún àwọn ọmọ rẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:19"
      },
      "items": [
        {
          "text": "Jẹ́ kí ó san án fún un, yóò sì mọ̀ ọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.19",
            "verseOrgIds": [
              "JOB.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojú rẹ̀ yóò rí ìparun ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:20"
      },
      "items": [
        {
          "text": "yóò sì máa mu nínú ríru ìbínú Olódùmarè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.20",
            "verseOrgIds": [
              "JOB.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé àlàáfíà kí ni ó ní nínú ilé rẹ̀ lẹ́yìn rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:21"
      },
      "items": [
        {
          "text": "nígbà tí a bá ké iye oṣù rẹ̀ kúrò ní agbede-méjì?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.21",
            "verseOrgIds": [
              "JOB.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ ẹnikẹ́ni le kọ Ọlọ́run ní ìmọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:22"
      },
      "items": [
        {
          "text": "Òun ní í sá à ń ṣe ìdájọ́ ẹni ibi gíga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnìkan a kú nínú pípé agbára rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.23",
            "verseOrgIds": [
              "JOB.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:23"
      },
      "items": [
        {
          "text": "ó wà nínú ìrora àti ìdákẹ́ pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.23",
            "verseOrgIds": [
              "JOB.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọpọ́n rẹ̀ kún fún omi ọmú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.24",
            "verseOrgIds": [
              "JOB.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:24"
      },
      "items": [
        {
          "text": "egungun rẹ̀ sì tutù fún ọ̀rá.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.24",
            "verseOrgIds": [
              "JOB.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹlòmíràn a sì kú nínú kíkorò ọkàn rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.25",
            "verseOrgIds": [
              "JOB.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:25"
      },
      "items": [
        {
          "text": "tí kò sì fi inú dídùn jẹun.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.25",
            "verseOrgIds": [
              "JOB.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n o dùbúlẹ̀ bákan náà nínú erùpẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:26"
      },
      "items": [
        {
          "text": "kòkòrò yóò sì ṣùbò wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.26",
            "verseOrgIds": [
              "JOB.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi i, èmi mọ̀ èrò inú yín àti",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.27",
            "verseOrgIds": [
              "JOB.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:27"
      },
      "items": [
        {
          "text": "àrékérekè ọkàn yín láti ṣe ìlòdì sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.27",
            "verseOrgIds": [
              "JOB.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ẹ̀yin wí pé, 'Níbo ní ilé ọmọ-aládé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:28"
      },
      "items": [
        {
          "text": "àti níbo ní àgọ́ àwọn ènìyàn búburú nì gbé wà?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.28",
            "verseOrgIds": [
              "JOB.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin kò béèrè lọ́wọ́ àwọn tí ń kọjá lọ ní ọ̀nà?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.29",
            "verseOrgIds": [
              "JOB.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:29"
      },
      "items": [
        {
          "text": "Ẹ̀yin kò mọ̀ àmì wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.29",
            "verseOrgIds": [
              "JOB.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "pé ènìyàn búburú ní a fi pamọ́ fún ọjọ́ ìparun.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.30",
            "verseOrgIds": [
              "JOB.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:30"
      },
      "items": [
        {
          "text": "A ó sì mú wọn jáde ní ọjọ́ ríru ìbínú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.30",
            "verseOrgIds": [
              "JOB.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni yóò tako ipa ọ̀nà rẹ̀ lójúkojú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.31",
            "verseOrgIds": [
              "JOB.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:31"
      },
      "items": [
        {
          "text": "ta ni yóò sì san án padà fún un ní èyí tí ó ti ṣe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.31",
            "verseOrgIds": [
              "JOB.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ a ó sì sin ín ní ọ̀nà ipò òkú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.32",
            "verseOrgIds": [
              "JOB.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:32"
      },
      "items": [
        {
          "text": "a ó sì máa ṣọ́ ibojì òkú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.32",
            "verseOrgIds": [
              "JOB.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ògúlùtu àfonífojì yóò dùn mọ́ ọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:33"
      },
      "items": [
        {
          "text": "Gbogbo ènìyàn yóò sì máa tọ̀ ọ́ lẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:33"
      },
      "items": [
        {
          "text": "bí ènìyàn àìníye ti lọ síwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.33",
            "verseOrgIds": [
              "JOB.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èéha ti ṣe tí ẹ̀yin fi ń tù mí nínú lásán,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.34",
            "verseOrgIds": [
              "JOB.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 21:34"
      },
      "items": [
        {
          "text": "bí ò ṣe pé ní ìdáhùn yín, àrékérekè wa níbẹ̀!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.34",
            "verseOrgIds": [
              "JOB.21.34"
            ]
          }
        }
      ]
    }
