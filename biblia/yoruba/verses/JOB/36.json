  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JOB 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu sì tún sọ̀rọ̀ wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.1",
            "verseOrgIds": [
              "JOB.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fún mi láyè díẹ̀ èmi ó sì fihàn ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:2"
      },
      "items": [
        {
          "text": "nítorí ọ̀rọ̀ sísọ ní ó kún fún Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó mú ìmọ̀ mi ti ọ̀nà jíjìn wá,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:3"
      },
      "items": [
        {
          "text": "èmi ó sì fi òdodo fún Ẹlẹ́dàá mi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rí i dájú pé ọ̀rọ̀ mi kì yóò ṣèké nítòótọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:4"
      },
      "items": [
        {
          "text": "ẹni tí ó pé ní ìmọ̀ wà pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi i, Ọlọ́run ni alágbára, òun kò i sì gàn ènìyàn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:5"
      },
      "items": [
        {
          "text": "ó ní agbára ní ipá àti òye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kì í dá ẹ̀mí ènìyàn búburú sí,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ó fi òtítọ́ fún àwọn tálákà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun kì í mú ojú rẹ̀ kúrò lára olódodo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn ọba ni wọ́n wà lórí ìtẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:7"
      },
      "items": [
        {
          "text": "àní ó fi ìdí wọn múlẹ̀ láéláé, a sì gbé wọn lékè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá sì dè wọ́n nínú àbà,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:8"
      },
      "items": [
        {
          "text": "tí a sì fi okùn ìpọ́njú dè wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni ó ń sọ àwọn ohun tí wọn ti ṣe fún wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:9"
      },
      "items": [
        {
          "text": "wí pé wọ́n ti ṣẹ̀ pẹ̀lú ìgbéraga wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sí wọn létí pẹ̀lú sí ọ̀nà ẹ̀kọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:10"
      },
      "items": [
        {
          "text": "ó sì pàṣẹ kí wọn kí ó padà kúrò nínú àìṣedédé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n bá gbàgbọ́ tí wọ́n sì sìn ín,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "wọn ó lo ọjọ́ wọn ní ìrọ̀rùn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:11"
      },
      "items": [
        {
          "text": "àti ọdún wọn nínú afẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, bí wọn kò bá gbàgbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "wọ́n ó ti ọwọ́ idà ṣègbé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:12"
      },
      "items": [
        {
          "text": "wọ́n á sì kú láìní òye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n àwọn àgàbàgebè ní ayé kó ìbínú jọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:13"
      },
      "items": [
        {
          "text": "wọn kò kígbe fún ìrànlọ́wọ́ nígbà tí ó bá wọ́n wí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọkàn wọn yóò kú ní èwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:14"
      },
      "items": [
        {
          "text": "ní àárín àwọn ọkùnrin alágbèrè ojúbọ òrìṣà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun gba òtòṣì nínú ìpọ́njú wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:15"
      },
      "items": [
        {
          "text": "a sì sọ̀rọ̀ sí wọn ní etí nínú ìnira wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bẹ́ẹ̀ ni pẹ̀lúpẹ̀lú ó fa wọn yọ láti inú ìhágágá sí ibi gbòòrò,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "sí ibi tí ó ní ààyè tí kò ní wàhálà nínú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:16"
      },
      "items": [
        {
          "text": "ohun tí a sì gbé kalẹ̀ ní tábìlì rẹ̀ jẹ́ kìkì ọ̀rá oúnjẹ tí ó fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ kún fún ìdájọ́ àwọn búburú;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:17"
      },
      "items": [
        {
          "text": "ìdájọ́ àti òtítọ́ dì ọ́ mú.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìbínú ń bẹ, ṣọ́ra kí òtítọ́ rẹ máa bá a tàn ọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:18"
      },
      "items": [
        {
          "text": "láti jẹ́ kí títóbi rẹ mú ọ ṣìnà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrọ̀ rẹ pọ̀ tó, tí wàhálà kì yóò fi dé bá ọ bí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:19"
      },
      "items": [
        {
          "text": "Tàbí ipa agbára rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe ìfẹ́ òru, nígbà tí a ń ké",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.20",
            "verseOrgIds": [
              "JOB.36.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:20"
      },
      "items": [
        {
          "text": "àwọn orílẹ̀-èdè kúrò ní ipò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.20",
            "verseOrgIds": [
              "JOB.36.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Máa ṣọ́ra kí ìwọ ki ó má yí ara rẹ̀ padà sí búburú,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:21"
      },
      "items": [
        {
          "text": "nítorí èyí tí ìwọ rò pé ó dára jù ìpọ́njú lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kíyèsi i, Ọlọ́run ni gbéga nípa agbára rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:22"
      },
      "items": [
        {
          "text": "ta ni jẹ́ olùkọ́ni bí rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó là ọ̀nà iṣẹ́ rẹ̀ sílẹ̀ fún un,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:23"
      },
      "items": [
        {
          "text": "tàbí ta ni ó lè wí pé ìwọ ti ń ṣe àìṣedéédéé?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rántí kí ìwọ kí ó gbé iṣẹ́ rẹ̀ ga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.24",
            "verseOrgIds": [
              "JOB.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:24"
      },
      "items": [
        {
          "text": "ti ènìyàn ni yín nínú orin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.24",
            "verseOrgIds": [
              "JOB.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúkúlùkù ènìyàn a máa rí i;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:25"
      },
      "items": [
        {
          "text": "ẹni ikú a máa wò ó ní òkèrè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, Ọlọ́run tóbi, àwa kò sì mọ̀ bí ó ti ní òye tó,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:26"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni a kò lè wádìí iye ọdún rẹ̀ rí.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí pé òun ni ó fa ìkán omi òjò sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.27",
            "verseOrgIds": [
              "JOB.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:27"
      },
      "items": [
        {
          "text": "kí wọn kí ó kán bí òjò ní ìkùùkuu rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.27",
            "verseOrgIds": [
              "JOB.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí àwọsánmọ̀ ń rọ̀ ìrì rẹ̀ sílẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:28"
      },
      "items": [
        {
          "text": "tí ó sì fi ń sẹ̀ lọ́pọ̀lọ́pọ̀ lórí ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lúpẹ̀lú ǹjẹ́ ẹnikẹ́ni lè ní ìmọ̀ ìtànká àwọsánmọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.29",
            "verseOrgIds": [
              "JOB.36.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:29"
      },
      "items": [
        {
          "text": "tàbí ariwo àrá láti àgọ́ rẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.29",
            "verseOrgIds": [
              "JOB.36.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, ó tan ìmọ́lẹ̀ yí ara rẹ̀ ká",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.30",
            "verseOrgIds": [
              "JOB.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:30"
      },
      "items": [
        {
          "text": "ó sì bo ìsàlẹ̀ òkun mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.30",
            "verseOrgIds": [
              "JOB.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé nípa wọn ní ń ṣe dájọ́ àwọn orílẹ̀-èdè ènìyàn;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.31",
            "verseOrgIds": [
              "JOB.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:31"
      },
      "items": [
        {
          "text": "ó sí ń pèsè oúnjẹ ní ọ̀pọ̀lọpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.31",
            "verseOrgIds": [
              "JOB.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó fi ìmọ́lẹ̀ bo ọwọ́ rẹ̀ méjèèjì",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:32"
      },
      "items": [
        {
          "text": "ó sì rán an sí ẹni olódì.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariwo àrá rẹ̀ fi ìjì hàn ní;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.33",
            "verseOrgIds": [
              "JOB.36.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:33"
      },
      "items": [
        {
          "text": "ọ̀wọ́ ẹran pẹ̀lú wí pé, ó súnmọ́ etílé!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.33",
            "verseOrgIds": [
              "JOB.36.33"
            ]
          }
        }
      ]
    }
  ],
