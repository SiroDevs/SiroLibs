{
  "id": "JOB.4",
  "number": "4",
  "bookId": "JOB",
  "reference": "Jobu 4",
  "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOB 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀rọ̀ Elifasi: Ọlọ́run kì í fi ìyà jẹ olódodo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìgbà náà ni Elifasi, ará Temani dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.1",
            "verseOrgIds": [
              "JOB.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí àwa bá fi ẹnu lé e, láti bá ọ sọ̀rọ̀, ìwọ o ha banújẹ́?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:2"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n ta ni ó lè pa ọ̀rọ̀ mọ́ ẹnu láìsọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi i, ìwọ sá ti kọ́ ọ̀pọ̀ ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:3"
      },
      "items": [
        {
          "text": "ìwọ ṣá ti mú ọwọ́ aláìlera le.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ rẹ ti gbé àwọn tí ń ṣubú lọ dúró,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:4"
      },
      "items": [
        {
          "text": "ìwọ sì ti mú eékún àwọn tí ń wárìrì lera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí ó dé bá ọ, ó sì rẹ̀ ọ́, ó kọlù ọ́;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:5"
      },
      "items": [
        {
          "text": "ara rẹ kò lélẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbẹ̀rù Ọlọ́run rẹ kò ha jẹ́ ìgbẹ́kẹ̀lé rẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:6"
      },
      "items": [
        {
          "text": "àti ìdúró ọ̀nà rẹ kò ha sì jẹ́ ìrètí rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi bẹ̀ ọ́ rántí, ta ni ó ṣègbé rí láìṣẹ̀?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:7"
      },
      "items": [
        {
          "text": "Tàbí níbo ni a gbé gé olódodo kúrò rí?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní bí èmi ti rí i pé, àwọn tí ń ṣe ìtulẹ̀ ẹ̀ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:8"
      },
      "items": [
        {
          "text": "tí wọ́n sì fún irúgbìn ìwà búburú, wọn a sì ká èso rẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ìfẹ́ sí Ọlọ́run wọn a ṣègbé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:9"
      },
      "items": [
        {
          "text": "nípa èémí ìbínú rẹ̀ wọn a parun.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bíbú ramúramù kìnnìún àti ohùn òǹrorò kìnnìún",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:10"
      },
      "items": [
        {
          "text": "àti eyín àwọn ẹgbọrọ kìnnìún ní a ká.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kìnnìún kígbe, nítorí àìrí ohun ọdẹ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:11"
      },
      "items": [
        {
          "text": "àwọn ẹgbọrọ kìnnìún sísanra ni a túká kiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nísinsin yìí a fi ohun àṣírí kan hàn fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:12"
      },
      "items": [
        {
          "text": "etí mi sì gbà díẹ̀ nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìrò inú lójú ìran òru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:13"
      },
      "items": [
        {
          "text": "nígbà tí oorun èjìká kùn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀rù bà mí àti ìwárìrì",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:14"
      },
      "items": [
        {
          "text": "tí ó mú gbogbo egungun mi jí pépé.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ẹ̀mí kan kọjá lọ ní iwájú mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:15"
      },
      "items": [
        {
          "text": "irun ara mi dìde dúró ṣánṣán.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dúró jẹ́ẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "ṣùgbọ́n èmi kò le wo àpẹẹrẹ ìrí rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "àwòrán kan hàn níwájú mi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "ìdákẹ́rọ́rọ́ wà, mo sì gbóhùn kan wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ẹni kíkú le jẹ́ olódodo ju Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
