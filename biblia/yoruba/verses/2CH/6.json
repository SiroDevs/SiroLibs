  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Solomoni wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.1",
                "verseOrgIds": [
                  "2CH.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ wí pé òun yóò máa gbé nínú òkùnkùn tí ó ṣú biribiri;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n èmi ti kọ́ tẹmpili dáradára fún ọ ibi tí ìwọ yóò máa gbé títí láé.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà tí gbogbo ìjọ Israẹli dúró níbẹ̀, ọba yíjú padà ó sì fi ìbùkún fún gbogbo wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó sì wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "\"Ògo ni fún",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.4",
                "verseOrgIds": [
                  "2CH.6.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, tí ó fi ọwọ́ rẹ̀ mú ohun tí ó fi ẹnu rẹ̀ sọ fún Dafidi baba mi ṣẹ. Nítorí tí ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Láti ọjọ́ tí èmi ti mú àwọn ènìyàn mi jáde kúrò ní ilẹ̀ Ejibiti, èmi kò yan ìlú kan nínú gbogbo ẹ̀yà Israẹli, láti kọ́ ilé, kí orúkọ mi kí ó lè wà níbẹ̀, bẹ́ẹ̀ ni èmi kò yan ẹnikẹ́ni láti jẹ́ olórí lórí Israẹli ènìyàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nísinsin yìí èmi ti yan Jerusalẹmu, kí orúkọ mi le è wà níbẹ̀, èmi sì ti yan Dafidi láti jẹ ọba lórí Israẹli ènìyàn mi.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba mi Dafidi ti ní-in lọ́kàn láti kọ́ tẹmpili fún orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.7",
                "verseOrgIds": [
                  "2CH.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", àní Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.8",
                "verseOrgIds": [
                  "2CH.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Dafidi baba mi pé, 'Nítorí tí ó wà ní ọkàn rẹ láti kọ́ tẹmpili yìí fún orúkọ mi, ìwọ ṣe ohun dáradára láti ní èyí ní ọkàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n síbẹ̀, ìwọ kọ́ ni yóò kọ́ tẹmpili náà, bí kò ṣe ọmọ rẹ, ẹni tí o jẹ́ ẹran-ara àti ẹ̀jẹ̀ rẹ: òun ni yóò kọ́ tẹmpili fún orúkọ mi.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ti mú ìlérí rẹ̀ ṣẹ. Èmi ti dìde ní ipò Dafidi baba mi, a sì gbé mi ka ìtẹ́ Israẹli, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ṣe ìlérí, èmi sì ti kọ́ tẹmpili fún orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni èmi sì gbé àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.11",
                "verseOrgIds": [
                  "2CH.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sí, nínú èyí ti májẹ̀mú ti",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.11",
                "verseOrgIds": [
                  "2CH.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bá àwọn Israẹli ènìyàn mi dá wà.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni gba àdúrà ìyàsímímọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Solomoni dúró níwájú pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.12",
                "verseOrgIds": [
                  "2CH.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", ní iwájú gbogbo ìjọ ènìyàn Israẹli, ó sì tẹ́ ọwọ́ rẹ̀ méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ṣe àga idẹ kan tí ó jẹ́ ìgbọ̀nwọ́ márùn-ún ní gígùn àti ìgbọ̀nwọ́ márùn-ún fífẹ̀ àti ìgbọ̀nwọ́ mẹ́ta ní gíga, a gbé e sí àárín àgbàlá ti òde. Ó sì dúró ní orí rẹ̀, àti pé ó kúnlẹ̀ lórí eékún rẹ̀ níwájú gbogbo ìjọ ènìyàn Israẹli, ó sì tẹ́ ọwọ́ rẹ̀ méjèèjì sí òkè ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:14"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.14",
                "verseOrgIds": [
                  "2CH.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, kò sí Ọlọ́run tí ó dàbí rẹ ní ọ̀run àti ní ayé: ìwọ tí o pa májẹ̀mú ìfẹ́ rẹ mọ́ pẹ̀lú àwọn ìránṣẹ́ rẹ tí ń fi tọkàntọkàn wọn rìn ní ọ̀nà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ tí o pa ìlérí tí o ṣe pẹ̀lú ìránṣẹ́ rẹ Dafidi baba mi mọ́; nítorí ìwọ ti fi ẹnu rẹ ṣe ìlérí àti pé ìwọ ti fi ọwọ́ rẹ mú un ṣẹ; bí ó ti rí lónìí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.16",
                "verseOrgIds": [
                  "2CH.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli, pa ìlérí tí ó ti ṣe mọ́ fún ìránṣẹ́ rẹ Dafidi baba mi nígbà tí o wí pé, 'Ìwọ kò gbọdọ̀ fẹ́ kù láti ní ọkùnrin láti jókòó níwájú mi lórí ìtẹ́ Israẹli, kìkì bí àwọn ọmọ rẹ tí wọ́n bá kíyèsi ara nínú gbogbo ohun tí wọ́n ṣe láti rìn níwájú mi gẹ́gẹ́ bí òfin mi gẹ́gẹ́ bí o sì ti ṣe.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.17",
                "verseOrgIds": [
                  "2CH.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, jẹ́ kí ọ̀rọ̀ rẹ tí o ti ṣèlérí fún ìránṣẹ́ rẹ Dafidi kí ó wá sí ìmúṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ṣé Ọlọ́run nítòótọ́ yóò máa bá àwọn ènìyàn gbé lórí ilẹ̀ ayé bí? Ọ̀run àti ọ̀run gíga kò le gbà ọ́. Báwo ni ó ṣe kéré tó, ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.18",
                "verseOrgIds": [
                  "2CH.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "tí mo ti kọ́!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ ṣe àfiyèsí àdúrà ìránṣẹ́ rẹ àti ẹ̀bẹ̀ rẹ̀ fún àánú,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.19",
                "verseOrgIds": [
                  "2CH.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, gbọ́ ẹkún àti àdúrà tí ìránṣẹ́ rẹ̀ ń gbà níwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ojú rẹ kí ó lè ṣí sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.20",
                "verseOrgIds": [
                  "2CH.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ọ̀sán àti lóru, ní ibí yìí tí ìwọ ti wí pé ìwọ yóò fi orúkọ rẹ síbẹ̀. Kí ìwọ kí ó gbọ́ àdúrà tí ìránṣẹ́ rẹ ń gbà lórí ibí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ ẹ̀bẹ̀ ìránṣẹ́ rẹ àti ti àwọn ènìyàn Israẹli nígbà tí wọ́n bá ń gbàdúrà lórí ibí yìí. Gbọ́ láti ọ̀run, ibùgbé rẹ, nígbà tí ìwọ bá sì gbọ́, dáríjì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ọkùnrin kan bá dẹ́ṣẹ̀ sí ẹnìkejì rẹ̀, tí a sì mú búra, tí ó sì búra níwájú pẹpẹ rẹ nínú ilé yìí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà, gbọ́ láti ọ̀run kí o sì dáhùn. Ṣe ìdájọ́ láàrín àwọn ìránṣẹ́ rẹ, san padà fún ẹni tí ó jẹ̀bi nípa mímú padà wá sí orí òun tìkára rẹ̀ ohun tí ó ti ṣe. Ṣe ìdáláre fún olódodo, bẹ́ẹ̀ sì ni, fi fún un gẹ́gẹ́ bí òdodo rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí àwọn ènìyàn rẹ Israẹli bá ní ìjákulẹ̀ níwájú àwọn ọ̀tá nítorí wọ́n ti dẹ́ṣẹ̀ sí ọ àti nígbà tí wọ́n bá sì yípadà, tí wọ́n sì jẹ́wọ́ orúkọ rẹ, tí wọ́n gbàdúrà, tí wọ́n sì bẹ̀bẹ̀ níwájú rẹ nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.24",
                "verseOrgIds": [
                  "2CH.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "yìí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà, ni kí o gbọ́ láti ọ̀run kí o sì dárí ẹ̀ṣẹ̀ àwọn ènìyàn Israẹli jì wọ́n kí o sì mú wọn padà wá sílé tí o ti fi fún wọn àti àwọn baba wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí a bá ti ọ̀run, tí kò sì sí òjò nítorí àwọn ènìyàn rẹ ti dẹ́ṣẹ̀ sí ọ, nígbà tí wọ́n bá sì gbàdúrà sí ibí yìí tí wọ́n sì jẹ́wọ́ orúkọ rẹ tí wọ́n sì yípadà kúrò nínú ẹ̀ṣẹ̀ wọn nítorí ìwọ ti pọ́n wọn lójú,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà gbọ́ láti ọ̀run kí o sì dárí ẹ̀ṣẹ̀ jì àwọn ìránṣẹ́ rẹ, àwọn ènìyàn Israẹli kọ́ wọn ní ọ̀nà tí ó tọ́ nínú èyí tí wọn ó máa rìn, kí o sì rọ òjò sórí ilẹ̀ tí o ti fi fún àwọn ènìyàn rẹ fún ìní.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ìyàn tàbí àjàkálẹ̀-ààrùn bá wá sí ilẹ̀ náà, ìrẹ̀dànù tàbí ìmúwòdù, eṣú tàbí ẹlẹ́ǹgà, tàbí nígbà tí àwọn ọ̀tá wọn bá yọ wọ́n lẹ́nu nínú ọ̀kan lára àwọn ìlú wọn, ohunkóhun, ìpọ́njú tàbí ààrùn lè wá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àdúrà tàbí ẹ̀bẹ̀ bá sì wá láti ọ̀dọ̀ ẹnikẹ́ni àwọn ènìyàn rẹ Israẹli olúkúlùkù mọ̀ nípa ìpọ́njú rẹ̀ àti ìbànújẹ́, tí ó sì tẹ́ ọwọ́ rẹ̀ méjèèjì sí ìhà ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.29",
                "verseOrgIds": [
                  "2CH.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà gbọ́ láti ọ̀run ibùgbé rẹ dáríjì, kí o sì pín fún olúkúlùkù ènìyàn gẹ́gẹ́ bí i gbogbo ohun tí ó ṣe, nígbà tí ìwọ ti mọ ọkàn rẹ̀ (nítorí ìwọ nìkan ni ó mọ ọkàn ènìyàn.)",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni kí wọn kí ó lè bẹ̀rù rẹ kí wọn kí ó sì rìn ní ọ̀nà rẹ ní gbogbo ìgbà tí wọ́n ń gbé nínú ilé tí o ti fi fún àwọn baba wa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti àwọn àlejò tí wọn kò sí lára àwọn ènìyàn rẹ Israẹli ṣùgbọ́n tí wọ́n wá láti ọ̀nà jíjìn nítorí orúkọ ńlá rẹ àti ọwọ́ agbára rẹ àti nínà apá rẹ, nígbà tí ó bá wá tí ó sì gbàdúrà pẹ̀lú kíkojú si ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.32",
                "verseOrgIds": [
                  "2CH.6.32"
                ]
              }
            }
          ]
        },
        {
          "text": "yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, gbọ́ láti ọ̀run àní láti ibi ibùgbé rẹ, kí o sì ṣe ohun tí àwọn àlejò béèrè lọ́wọ́ rẹ. Bẹ́ẹ̀ ni kí gbogbo àwọn ènìyàn ayé kí wọn lè mọ orúkọ rẹ kí wọn sì bẹ̀rù rẹ, gẹ́gẹ́ bí Israẹli ènìyàn rẹ ti ṣe, kí wọn kí ó sì lè mọ̀ wí pé ilé yìí tí èmi ti kọ, orúkọ rẹ ni ó ń jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí àwọn ènìyàn rẹ bá lọ sójú ogun lórí àwọn ọ̀tá wọn, nígbàkígbà tí o bá rán wọn, tí wọ́n sì gbàdúrà sí ọ si ìhà ìlú yìí tí ìwọ ti yàn àti ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.34",
                "verseOrgIds": [
                  "2CH.6.34"
                ]
              }
            }
          ]
        },
        {
          "text": "tí èmi ti kọ́ fún orúkọ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà gbọ́ àdúrà wọn àti ẹ̀bẹ̀ wọn láti ọ̀run, kí o sì mú ọ̀rọ̀ wọn dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí wọ́n bá sì dẹ́ṣẹ̀ sí ọ—nítorí kò sí ènìyàn kan tí kì í dẹ́ṣẹ̀—bí o bá sì bínú sí wọn tí o bá sì fi wọ́n fún àwọn ọ̀tá, tí wọ́n kó wọn ní ìgbèkùn sí ilẹ̀ tí ó jìnnà réré tàbí nítòsí,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n, nígbà tí wọ́n bá sì yí ọkàn wọn padà ní ilẹ̀ tí wọ́n ti mú wọn ní ìgbèkùn, tí wọ́n sì ronúpìwàdà tí wọ́n sì bẹ̀bẹ̀ pẹ̀lú rẹ ní ilẹ̀ ìgbèkùn, wọn ó sì wí pé, 'Àwa ti dẹ́ṣẹ̀, àwa sì ti ṣe ohun tí kò dára, a sì ti ṣe búburú';",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí wọn bá sì yípadà sí ọ pẹ̀lú gbogbo ọkàn àti ẹ̀mí ní ilẹ̀ ìgbèkùn wọn níbi tí wọ́n ti mú wọn, tí wọ́n sì gbàdúrà wọn, kojú si ìlú tí ìwọ ti yàn àti lórí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.38",
                "verseOrgIds": [
                  "2CH.6.38"
                ]
              }
            }
          ]
        },
        {
          "text": "tí mo ti kọ́ fún orúkọ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà, láti ọ̀run, ibi ibùgbé rẹ, gbọ́ àdúrà wọn àti ẹ̀bẹ̀ wọn, kí o sì mú ọ̀ràn wọn dúró, kí o sì dárí ẹ̀ṣẹ̀ àwọn ènìyàn jì wọn, tí wọn ti dẹ́ṣẹ̀ sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nísinsin yìí, Ọlọ́run mi, jẹ́ kí ojú rẹ kí ó ṣí kí o sì tẹ́ etí rẹ sílẹ̀ fún àdúrà sí ibí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ nísinsin yìí dìde,",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, sí ibi ìsinmi rẹ,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "ìwọ àti àpótí ẹ̀rí agbára rẹ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Jẹ́ kí àwọn àlùfáà,",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, kí o wọ̀ wọ́n láṣọ pẹ̀lú ìgbàlà,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "jẹ́ kí àwọn àyànfẹ́ kí inú wọn kí ó dùn nínú ilé rẹ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run mi, má ṣe kọ̀ ẹni àmì òróró rẹ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:42"
      },
      "items": [
        {
          "text": "Rántí ìfẹ́ ńlá tí ó ṣe ìlérí fún Dafidi ìránṣẹ́ rẹ.\"",
          "type": "text"
        }
      ]
    }
  ],
