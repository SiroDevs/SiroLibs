          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìyàsímímọ́ ilé",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Solomoni sì ti parí àdúrà, iná sọ̀kalẹ̀ láti ọ̀run ó sì jó ẹbọ sísun àti ẹbọ, ògo Ọlọ́run sì kún ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.1",
                "verseOrgIds": [
                  "2CH.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà kò sì le wo ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.2",
                "verseOrgIds": [
                  "2CH.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "náà nítorí pé ògo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.2",
                "verseOrgIds": [
                  "2CH.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kún un.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí gbogbo àwọn ọmọ Israẹli rí iná tí ó ń sọ̀kalẹ̀ àti ògo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "lórí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "náà, wọ́n sì kúnlẹ̀ lórí eékún wọn pẹ̀lú ojú ni dídàbolẹ̀, wọ́n sì sin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n sì fi ìyìn fún",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "\"Nítorí tí ó dára;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "àánú rẹ̀ sì dúró títí láéláé.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ọba àti gbogbo àwọn ènìyàn sì rú ẹbọ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.4",
                "verseOrgIds": [
                  "2CH.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Solomoni sì rú ẹbọ ti ẹgbẹ̀rún méjìlélógún (22,000), orí màlúù àti àgùntàn àti ọ̀kẹ́ mẹ́fà (120,000) àgùntàn àti ẹranko. Bẹ́ẹ̀ ni ọba àti gbogbo àwọn ènìyàn ya ilé Ọlọ́run sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà dúró ní ààyè wọn, gẹ́gẹ́ bí àwọn ọmọ Lefi ti ṣe pẹ̀lú ohun èlò orin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.6",
                "verseOrgIds": [
                  "2CH.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", tí ọba Dafidi ti ṣe fún ìyìn",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.6",
                "verseOrgIds": [
                  "2CH.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "àti tí á lò nígbà tí ó dúpẹ́, wí pé, \"Àánú rẹ̀ sì dúró láéláé,\" níwájú àwọn ọmọ Lefi, àwọn àlùfáà sì fọn ìpè, gbogbo àwọn ọmọ Israẹli sì dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni sì yà àgbàlá níwájú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.7",
                "verseOrgIds": [
                  "2CH.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ́tọ̀, níbẹ̀ sì ni ó ti ṣe ìrúbọ ẹbọ sísun àti ọ̀rá ẹbọ àlàáfíà, nítorí pẹpẹ idẹ tí ó ti ṣe kò lè gba ẹbọ sísun, àti ọrẹ oúnjẹ, àti ọ̀rá náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Solomoni ṣe àsè ní àkókò náà fún ọjọ́ méje àti gbogbo àwọn ọmọ Israẹli pẹ̀lú rẹ̀ àti ìjọ ènìyàn ńlá, àwọn ènìyàn láti Lebo-Hamati títí dé odò Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹjọ, wọ́n sì pe ìjọ ènìyàn jọ nítorí tí wọ́n pe àpèjẹ ìyàsímímọ́ ti orí pẹpẹ fún ọjọ́ méje àti àsè náà fún ọjọ́ méje sí i.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹtàlélógún tí oṣù keje, ó sì rán àwọn ènìyàn padà sí ilé wọn, pẹ̀lú ayọ̀ àti ìdùnnú nínú wọn fún ohun rere tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.10",
                "verseOrgIds": [
                  "2CH.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ṣe fún Dafidi àti Solomoni, àti fún àwọn ènìyàn Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "fi ara han Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Solomoni ti parí ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ibi ilé ọba, nígbà tí ó sì ti ṣe àṣeyọrí láti gbé jáde gbogbo ohun tí ó ní lọ́kàn láti ṣe nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àti nínú ilé òun tìkára rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.12",
                "verseOrgIds": [
                  "2CH.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sì farahàn Solomoni ní òru ó sì wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 7:12"
      },
      "items": [
        {
          "text": "\"Èmi ti gbọ́ àdúrà rẹ mo sì ti yàn ibí yìí fún ara mi gẹ́gẹ́ bí ilé fún ẹbọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí mo bá sé ọ̀run kí ó ma bá à sí òjò, tàbí láti pàṣẹ fún eṣú láti jẹ ilẹ̀ náà run tàbí rán àjàkálẹ̀-ààrùn sí àárín àwọn ènìyàn mi,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí àwọn ènìyàn, tí a fi orúkọ mi pè, tí wọ́n bá rẹ ara wọn sílẹ̀, tí wọ́n sì gbàdúrà, tí wọ́n sì rí ojú mi, tí wọ́n sì yí kúrò nínú ọ̀nà búburú wọn, nígbà náà, èmi yóò gbọ́ láti ọ̀run, èmi yóò sì dárí ẹ̀ṣẹ̀ wọn jì wọ́n èmi yóò sì wo ilẹ̀ wọn sàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, ojú mi yóò sì là etí mi yóò sì là, sí àdúrà ọrẹ níbí yìí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sì ti yàn, èmi sì ti ya ilé yìí sí mímọ́ bẹ́ẹ̀ ni kí orúkọ mi kí ó le wà níbẹ̀ títí láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ti bí ìwọ bá rìn níwájú mi gẹ́gẹ́ bí Dafidi baba rẹ ti ṣe, tí o sì ṣe gbogbo ohun tí mo paláṣẹ, tí ìwọ sì ṣe àkíyèsí àṣẹ mi láti ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fi ìdí ìtẹ́ ìjọba rẹ múlẹ̀, gẹ́gẹ́ bí mo ti ṣe pẹ̀lú Dafidi baba rẹ nígbà tí mo bá a dá májẹ̀mú wí pé, ìwọ kò ní fẹ́ ẹnìkan kù láti ṣe alákòóso lórí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n tí ìwọ bá yípadà tí o sì kọ òfin mi sílẹ̀ àti àṣẹ tí mo ti fi fún yín tí ẹ sì lọ sókè láti lọ sin ọlọ́run mìíràn tí ẹ sì bọ wọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà náà ni èmi yóò fa Israẹli tu kúrò láti ilẹ̀ mi, èyí tí èmi ti fi fún wọn, èmi yóò sì kọ̀ ilé náà sílẹ̀ èyí tí èmi ti yà sọ́tọ̀ fún orúkọ mi, èmi yóò sì fi ṣe ọ̀rọ̀ òwe, n ó fi ṣe ẹlẹ́yà láàrín gbogbo ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti ní gbogbo àyíká ilé yìí nísinsin yìí, bẹ́ẹ̀ ni yóò di ohun ìtànjẹ; gbogbo àwọn tí ó bá sì kọjá níbẹ̀ ni yóò jáláyà, wọn yóò sì wí pé, 'Kí ni ó dé tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.21",
                "verseOrgIds": [
                  "2CH.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "fì ṣe irú èyí sí ilẹ̀ yí àti sí ilé yìí?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn yóò sì dáhùn wí pé, 'Nítorí tí wọ́n ti kọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.22",
                "verseOrgIds": [
                  "2CH.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sílẹ̀, Ọlọ́run baba wọn ẹni tí ó mú wọn jáde láti Ejibiti wá, wọ́n sì ti fi ọwọ́ gba ọlọ́run mìíràn mọ́ra, wọ́n bọ wọ́n, bẹ́ẹ̀ ni wọ́n sì ń sìn wọ́n, ìdí nìyí tí ó fi mú gbogbo ìjàǹbá náà wá sórí wọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        }
      ]
    }
  ],
