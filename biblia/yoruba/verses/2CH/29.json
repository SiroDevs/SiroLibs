      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sì ti kó ara wọn jọ pọ̀ pẹ̀lú àwọn arákùnrin wọn, wọ́n sì ya ara wọn sí mímọ́, wọ́n sì lọ láti gbá ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.15",
                "verseOrgIds": [
                  "2CH.29.15"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́, gẹ́gẹ́ bí ọba ti pa á láṣẹ, ẹ tẹ̀lé ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.15",
                "verseOrgIds": [
                  "2CH.29.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà sì wọ inú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.16",
                "verseOrgIds": [
                  "2CH.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ́hùn ún lọ láti gbá a mọ́. Wọ́n sì gbé e jáde sí inú àgbàlá ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.16",
                "verseOrgIds": [
                  "2CH.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "gbogbo ohun àìmọ́ tí wọ́n rí nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.16",
                "verseOrgIds": [
                  "2CH.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": ". Àwọn ọmọ Lefi sì mú u wọ́n sì gbangba odò Kidironi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì bẹ̀rẹ̀ ìyàsímímọ́ ní ọjọ́ kìn-ín-ní oṣù kìn-ín-ní, àti ní ọjọ́ kẹjọ oṣù náà wọ́n sì dé ìloro",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.17",
                "verseOrgIds": [
                  "2CH.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": ". Fún ọjọ́ mẹ́jọ mìíràn sí i, wọ́n sì ya ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.17",
                "verseOrgIds": [
                  "2CH.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sí mímọ́ fúnra rẹ̀. Wọ́n sì parí ní ọjọ́ kẹrìndínlógún oṣù kìn-ín-ní.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà wọn sì lọ sí ọ̀dọ̀ ọba Hesekiah láti lọ jábọ̀ fún un: \"Àwa ti gbá ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.18",
                "verseOrgIds": [
                  "2CH.29.18"
                ]
              }
            }
          ]
        },
        {
          "text": "mọ́, pẹpẹ ẹbọ sísun pẹ̀lú gbogbo ohun ẹbọ rẹ̀, àti tábìlì àkàrà ìfihàn, pẹ̀lú gbogbo ohun èlò.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ti pèsè a sì ti yà sí mímọ́ gbogbo ohun èlò tí ọba Ahasi ti sọ di aláìmọ́ nínú àìṣòótọ́ rẹ̀ nígbà tí ó jẹ́ ọba; nísinsin yìí, wọ́n wà níwájú pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.19",
                "verseOrgIds": [
                  "2CH.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní kùtùkùtù òwúrọ̀ ọjọ́ kejì, ọba Hesekiah sì kó olórí àwọn ìjòyè jọ, ó sì lọ sókè ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.20",
                "verseOrgIds": [
                  "2CH.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì mú akọ màlúù méje wá, àti àgbò méje, àti ọ̀dọ́-àgùntàn méje àti òbúkọ méje gẹ́gẹ́ bí ẹbọ ẹ̀ṣẹ̀ fún ìjọba, fún ibi mímọ́ àti fún Juda. Ọba pàṣẹ fun àwọn àlùfáà, àwọn ọmọ Aaroni, láti ṣe èyí lórí pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.21",
                "verseOrgIds": [
                  "2CH.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n sì pa akọ màlúù, àwọn àlùfáà mú ẹ̀jẹ̀ náà, wọ́n sì fi wọ́n ara pẹpẹ. Bẹ́ẹ̀ gẹ́gẹ́ ni nígbà tí wọ́n pa àgbò, wọ́n sì fi ẹ̀jẹ̀ wọ́n orí pẹpẹ. Nígbà náà wọ́n sì pa ọ̀dọ́-àgùntàn, wọ́n sì fi ẹ̀jẹ̀ wọn ara pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.22",
            "verseOrgIds": [
              "2CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òbúkọ fún ẹbọ ẹ̀ṣẹ̀ ni wọ́n gbé wá síwájú ọba àti ìjọ ènìyàn, wọ́n sì gbé ọwọ́ lé wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.23",
            "verseOrgIds": [
              "2CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn àlùfáà wọn sì pa òbúkọ, wọ́n sì gbé ẹ̀jẹ̀ kalẹ̀ lórí pẹpẹ fún ẹbọ ẹ̀ṣẹ̀ láti ṣe ètùtù fún gbogbo Israẹli, nítorí ọba ti pàṣẹ kí a ṣe ẹbọ sísun àti ẹbọ ẹ̀ṣẹ̀ fún gbogbo Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú àwọn Lefi dúró nínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.25",
                "verseOrgIds": [
                  "2CH.29.25"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú Kimbali, ohun èlò orin olókùn àti dùùrù ní ọ̀nà tí a ti paláṣẹ fún wọn láti ọ̀dọ̀ Dafidi àti Gadi aríran ọba àti Natani wòlíì. Èyí ni a pàṣẹ láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.25",
                "verseOrgIds": [
                  "2CH.29.25"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ọwọ́ àwọn wòlíì rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ọmọ Lefi sì dúró pẹ̀lú ohun èlò orin Dafidi, àti àwọn àlùfáà pẹ̀lú ìpè wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah sì pa á láṣẹ láti rú ẹbọ sísun lórí pẹpẹ, bí ẹbọ sísun náà ti bẹ̀rẹ̀, orin sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.27",
                "verseOrgIds": [
                  "2CH.29.27"
                ]
              }
            }
          ]
        },
        {
          "text": "bẹ̀rẹ̀ pẹ̀lú ìpè àti pẹ̀lú ohun èlò orin Dafidi ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìjọ ènìyàn náà sì wólẹ̀ sìn, àwọn akọrin kọrin, àwọn afùnpè sì fọn ìpè, gbogbo wọ̀nyí sì wà bẹ́ẹ̀ títí ẹbọ sísun náà fi parí tán.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n sì ṣe ìparí ẹbọ rírú, ọba àti gbogbo àwọn tí ó wà pẹ̀lú rẹ̀ tẹ ara wọn ba, wọ́n sì sìn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lúpẹ̀lú Hesekiah ọba, àti àwọn ìjòyè pàṣẹ fún àwọn ọmọ Lefi, láti fi ọ̀rọ̀ Dafidi àti ti Asafu aríran, kọrin ìyìn sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.30",
                "verseOrgIds": [
                  "2CH.29.30"
                ]
              }
            }
          ]
        },
        {
          "text": ": wọ́n sì fi inú dídùn kọrin ìyìn, wọ́n sì tẹrí wọn ba, wọ́n sì sìn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìrúbọ nínú tẹmpili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Hesekiah dáhùn, ó sì wí pé, nísinsin yìí, ọwọ́ yín kún fún ẹ̀bùn fún",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.31",
                "verseOrgIds": [
                  "2CH.29.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ súnmọ́ ìhín, kí ẹ sì mú ẹbọ àti ọrẹ-ọpẹ́ wá sínú ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.31",
                "verseOrgIds": [
                  "2CH.29.31"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ìjọ ènìyàn sì mú ẹbọ àti ọrẹ-ọpẹ́ wá; àti olúkúlùkù tí ọkàn rẹ̀ fẹ́, mú ẹbọ sísun wá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ẹbọ sísun, tí ìjọ ènìyàn mú wá, sì jẹ́ àádọ́rin akọ màlúù, àti ọgọ́rùn-ún àgbò, àti igba ọ̀dọ́-àgùntàn, gbogbo wọ̀nyí sì ni fún ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.32",
                "verseOrgIds": [
                  "2CH.29.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ohun ìyàsímímọ́ sì jẹ́ ẹgbẹ̀ta (600) màlúù, àti ẹgbẹ̀rún mẹ́ta (3,000) àgùntàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn àlùfáà kò pọ̀ tó, wọn kò sì le bó gbogbo àwọn ẹran ẹbọ sísun náà: nítorí náà àwọn arákùnrin wọn, àwọn Lefi ràn wọ́n lọ́wọ́, títí iṣẹ́ náà fi parí, àti títí àwọn àlùfáà ìyókù fi yà wọ́n sí mímọ́: nítorí àwọn ọmọ Lefi ṣe olóòtítọ́ ní ọkàn ju àwọn àlùfáà lọ láti ya ara wọn sí mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pẹ̀lú, àwọn ẹbọ sísun pàpọ̀jù, pẹ̀lú ọ̀rá ẹbọ àlàáfíà, pẹ̀lú ẹbọ ohun mímu fún ẹbọ sísun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 29:35"
      },
      "items": [
        {
          "text": "Bẹ́ẹ̀ ni a sì tún bẹ̀rẹ̀ iṣẹ́ ìsìn ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.29.35",
                "verseOrgIds": [
                  "2CH.29.35"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiah sì yọ̀, àti gbogbo ènìyàn pé, Ọlọ́run ti múra àwọn ènìyàn náà sílẹ̀, nítorí lójijì ni a ṣe nǹkan náà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
  ],
