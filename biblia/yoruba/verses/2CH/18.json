  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2CH 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mikaiah sọtẹ́lẹ̀ lórí Ahabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí Jehoṣafati sì ní ọrọ̀ àti ọlá púpọ̀, ó sì dá àna pẹ̀lú Ahabu nípa fífẹ́ ọmọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.1",
            "verseOrgIds": [
              "2CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ọjọ́ díẹ̀, ó sọ̀kalẹ̀ láti lọ bá Ahabu lálejò ní Samaria. Ahabu sì pa àgùntàn àti màlúù púpọ̀ fún àti àwọn ènìyàn tí ó wà pẹ̀lú rẹ̀ ó sì rọ̀ ọ́ láti dojú ìjà kọ Ramoti Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.2",
            "verseOrgIds": [
              "2CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu ọba Israẹli sì béèrè lọ́wọ́ ọba Jehoṣafati, ọba Juda pé, \"Ṣé ìwọ yóò lọ pẹ̀lú mi sí Ramoti Gileadi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:3"
      },
      "items": [
        {
          "text": "Jehoṣafati sì dá a lóhùn pé, \"Èmi wà gẹ́gẹ́ bí ìwọ ti ṣe wà, àti àwọn ènìyàn mi gẹ́gẹ́ bí ènìyàn rẹ àwa yóò pẹ̀lú rẹ nínú ogun náà\".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoṣafati náà sì tún wí fún ọba Israẹli pé, \"Kọ́kọ́ béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.4",
            "verseOrgIds": [
              "2CH.18.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.4",
                "verseOrgIds": [
                  "2CH.18.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.4",
            "verseOrgIds": [
              "2CH.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ọba Israẹli kó àwọn wòlíì papọ̀, irinwó (400) ọkùnrin ó sì bi wọ́n pé, \"Kí àwa kí lọ sí ogun Ramoti Gileadi tàbí kí èmi kí ó jọ̀wọ́ rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:5"
      },
      "items": [
        {
          "text": "Wọ́n dáhùn pé, \"Lọ, nítorí tí Ọlọ́run yóò fi lé ọba lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoṣafati béèrè pé, \"Ṣé kò ha sí wòlíì",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.6",
                "verseOrgIds": [
                  "2CH.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "níbí ẹni tí àwa ìbá béèrè lọ́wọ́ rẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Israẹli dá Jehoṣafati lóhùn pé, \"Ọkùnrin kan wà síbẹ̀ lọ́dọ̀ ẹni tí àwa ìbá tún béèrè lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.7",
                "verseOrgIds": [
                  "2CH.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣùgbọ́n èmi kórìíra rẹ̀ nítorí kò jẹ́ sọ àsọtẹ́lẹ̀ ohun rere kan nípa mi ṣùgbọ́n bí kò ṣe ohun búburú, ní gbogbo ìgbà òun náà ni Mikaiah ọmọ Imla.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:7"
      },
      "items": [
        {
          "text": "Jehoṣafati sì dá lóhùn pé, \"Ọba kò gbọdọ̀ sọ bẹ́ẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ọba Israẹli pe ọ̀kan lára àwọn ìjòyè ó sì wí pé, \"Ẹ mú Mikaiah ọmọ Imla kí ó yára wá.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.8",
            "verseOrgIds": [
              "2CH.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wọ aṣọ ìgúnwà wọn, ọba Israẹli àti Jehoṣafati ọba Juda wọ́n jókòó sórí ìtẹ́ wọ́n ní ìta ẹnu-bodè Samaria, pẹ̀lú gbogbo àwọn wòlíì tí ń sọtẹ́lẹ̀ níwájú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.9",
            "verseOrgIds": [
              "2CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí Sedekiah ọmọ Kenaana sì ti ṣe ìwo irin, ó sì wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.10",
            "verseOrgIds": [
              "2CH.18.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.10",
                "verseOrgIds": [
                  "2CH.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: 'Pẹ̀lú èyí ìwọ yóò kan àwọn ará Siria títí ìwọ ó fi pa wọ́n run.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.10",
            "verseOrgIds": [
              "2CH.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn wòlíì tí ó kù ni wọn ń sọtẹ́lẹ̀ ní àkókò kan náà. Wọ́n sì wí pé, \"Dojúkọ Ramoti Gileadi ìwọ yóò sì ṣẹ́gun, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.11",
                "verseOrgIds": [
                  "2CH.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò fi lé ọba lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìránṣẹ́ tí ó ti lọ pe Mikaiah sì wí fún un pé, \"Ẹ wò ó, gẹ́gẹ́ bí ọkùnrin kan àti òmíràn wòlíì fi ẹnu kan sọ rere fún ọba. Jẹ́ kí ọ̀rọ̀ rẹ kí ó dàbí ọ̀kan nínú tiwọn, kí o sì sọ rere.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.12",
            "verseOrgIds": [
              "2CH.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Mikaiah wí pe, \"Gẹ́gẹ́ bí ó ti dájú pé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.13",
                "verseOrgIds": [
                  "2CH.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ń bẹ láààyè, èmi yóò sọ ohun tí Ọlọ́run mi sọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó dé, ọba béèrè lọ́wọ́ rẹ̀, \"Mikaiah, ṣe kí àwa ki ó lọ sí ogun ti Ramoti Gileadi, tàbí kí àwa kí ó fàsẹ́yìn?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:14"
      },
      "items": [
        {
          "text": "Ó sì dáhùn pé, \"Ẹ dojúkọ wọ́n kí ẹ sì ṣẹ́gun, nítorí a ó fi wọ́n lé yín lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì wí fún un pé, \"Ìgbà mélòó ni èmi ó fi ọ́ búra láti sọ ohun kan fún mi bí kò ṣe ọ̀rọ̀ òtítọ́ ní orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.15",
                "verseOrgIds": [
                  "2CH.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaiah sì dáhùn pé, \"Mo rí gbogbo Israẹli túká kiri lórí àwọn òkè bí àgùntàn tí kò ní olùṣọ́,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.16",
                "verseOrgIds": [
                  "2CH.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, 'Àwọn wọ̀nyí kò ní olúwa. Jẹ́ kí olúkúlùkù padà sí ilé rẹ̀ ní àlàáfíà.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Israẹli wí fún Jehoṣafati pé, \"Ṣe èmi kò sọ fún ọ wí pé òun kò sọ àsọtẹ́lẹ̀ rere kankan nípa mi rí, ṣùgbọ́n búburú nìkan?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
              "2CH.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaiah tẹ̀síwájú pé, \"Nítorí náà, gbọ́ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.18",
                "verseOrgIds": [
                  "2CH.18.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", mo rí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.18",
                "verseOrgIds": [
                  "2CH.18.18"
                ]
              }
            }
          ]
        },
        {
          "text": "jókòó lórí ìtẹ́ rẹ̀ gbogbo ogun ọ̀run sì dúró lápá ọ̀tún àti lápá òsì.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.19",
                "verseOrgIds": [
                  "2CH.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí pé, 'Ta ni yóò tan Ahabu ọba Israẹli lọ sí Ramoti Gileadi kí ó sì lọ kú ikú rẹ̀ níbẹ̀?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:19"
      },
      "items": [
        {
          "text": "\"Èkínní sì sọ tìhín, òmíràn sì sọ tọ̀hún.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìparí, ni ẹ̀mí kan wá síwájú, ó dúró níwájú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.20",
                "verseOrgIds": [
                  "2CH.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ó sì wí pé, 'Èmi yóò tàn án.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:20"
      },
      "items": [
        {
          "text": "\" 'Nípa ọ̀nà wo?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.20",
                "verseOrgIds": [
                  "2CH.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "béèrè.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èmi yóò lọ láti lọ di ẹ̀mí èké ní ẹnu gbogbo àwọn wòlíì.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 18:21"
      },
      "items": [
        {
          "text": "\" 'Ìwọ yóò sì borí nínú ìtànjẹ rẹ̀ báyìí,' ni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.21",
                "verseOrgIds": [
                  "2CH.18.21"
                ]
              }
            }
          ]
        },
        {
          "text": "wí. 'Lọ kí ó sì ṣe bẹ́ẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bẹ́ẹ̀ ni nísinsin yìí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.22",
                "verseOrgIds": [
                  "2CH.18.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi ẹ̀mí èké sí ẹnu àwọn wòlíì rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.22",
                "verseOrgIds": [
                  "2CH.18.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ti sọ ibi sí ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà Sedekiah ọmọ Kenaana lọ sókè ó sì gbá Mikaiah ní ojú. Ó sì béèrè pé, \"Ní ọ̀nà wo ni ẹ̀mí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.23",
                "verseOrgIds": [
                  "2CH.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "gbà kọjá lọ kúrò lọ́dọ̀ mi láti bá ọ sọ̀rọ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaiah sì dáhùn pé, \"Ìwọ yóò ṣe ìwádìí ní ọjọ́ tí ìwọ yóò sá pamọ́ sínú ìyẹ̀wù.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Israẹli pa á láṣẹ pé, \"Mú Mikaiah kí o sì ran padà sí Amoni olórí ìlú àti sí Joaṣi ọmọ ọba,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, 'Èyí ni ohun tí ọba sọ, ẹ fi ènìyàn yìí sínú túbú kí ẹ má sì ṣe fún un ní ohunkóhun ṣùgbọ́n àkàrà àti omi títí tí èmi yóò fi dé ní àlàáfíà.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.26",
            "verseOrgIds": [
              "2CH.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaiah sì wí pe, \"Tí ìwọ bá padà ní àlàáfíà,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.27",
                "verseOrgIds": [
                  "2CH.18.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kò sọ̀rọ̀ láti ọ̀dọ̀ mi.\" Nígbà náà, ó sì fi kún un pé, \"Ẹ gbọ́ ọ̀rọ̀ mi, gbogbo ẹ̀yin ènìyàn!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A pa Ahabu ní Ramoti Gileadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ọba Israẹli àti Jehoṣafati ọba Juda lọ sókè ní Ramoti Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Israẹli sọ fún Jehoṣafati pé, \"Èmi yóò lọ sí ojú ìjà, ṣùgbọ́n ìwọ wọ aṣọ ìgúnwà rẹ.\" Bẹ́ẹ̀ ni ọba Israẹli pa aṣọ rẹ̀ dà, ó sì lọ sí ojú ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí ọba Siria ti pàṣẹ fún àwọn olórí kẹ̀kẹ́ tí ó wà ní ọ̀dọ̀ rẹ̀ pé, \"Ẹ má ṣe jà pẹ̀lú ẹnìkankan, èwe tàbí àgbà àyàfi ọba Israẹli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn olórí kẹ̀kẹ́ rí Jehoṣafati, wọ́n rò wí pé, \"Èyí ní ọba Israẹli.\" Bẹ́ẹ̀ ni wọ́n sì yípadà láti bá a jà. Ṣùgbọ́n Jehoṣafati kégbe sókè,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.18.31",
                "verseOrgIds": [
                  "2CH.18.31"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ràn án lọ́wọ́. Ọlọ́run sì lé wọn kúrò lọ́dọ̀ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, nígbà tí olórí kẹ̀kẹ́ rí i wí pé kì í ṣe ọba Israẹli, wọ́n sì dáwọ́ lílé rẹ̀ dúró.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
