  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amasiah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiah jẹ́ ẹni ọdún mẹ́ẹ̀ẹ́dọ́gbọ̀n nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mọ́kàndínlọ́gbọ̀n orúkọ ìyá rẹ̀ a máa jẹ́ Jehoadani, ó wá láti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ṣe ohun tí ó dára lójú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.2",
                "verseOrgIds": [
                  "2CH.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣùgbọ́n kì í ṣe tọkàntọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí ìjọba ti wà ní ìdarí rẹ̀, ó pa àwọn oníṣẹ́ tí ó pa baba rẹ̀ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ kò pa àwọn ọmọ wọn, ṣùgbọ́n ó ṣe ní ìbámu pẹ̀lú ohun tí a kọ nínú òfin nínú ìwé Mose, níbi tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.4",
                "verseOrgIds": [
                  "2CH.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti paláṣẹ pé, \"A kò gbọdọ̀ pa àwọn baba fún àwọn ọmọ wọn tàbí àwọn ọmọ fún baba wọn, olúkúlùkù ni kí ó kú fún ẹ̀ṣẹ̀ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiah, pe gbogbo àwọn ènìyàn Juda pọ̀, ó sì fi iṣẹ́ lé wọn lọ́wọ́ gẹ́gẹ́ bí ìdílé wọn sí àwọn alákòóso ẹgbẹẹgbẹ̀rún àti àwọn alákòóso ọ̀rọ̀ọ̀rún fún gbogbo Juda àti Benjamini, ó sì gbá iye wọn láti ẹni ogún ọdún àti jù bẹ́ẹ̀ lọ jọ, ó sì rí i pé ọ̀kẹ́ mẹ́ẹ̀ẹ́dógún (300,000) àwọn ọkùnrin ni ó ti múra fún ìsìn ogun, tí ó lè gbá ọ̀kọ̀ àti àpáta mú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì yá ọ̀kẹ́ márùn-ún (100,000) àwọn ọkùnrin oníjà láti Israẹli fún ọgọ́rùn-ún àwọn tálẹ́ǹtì fàdákà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ènìyàn Ọlọ́run kan tọ̀ ọ́ wá ó sì wí pé, \"Ọba, àwọn ọ̀wọ́ ogun láti Israẹli kò gbọdọ̀ yan pẹ̀lú rẹ, nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.7",
                "verseOrgIds": [
                  "2CH.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kò wà pẹ̀lú Israẹli kì í ṣe pẹ̀lú ẹnìkankan láti Efraimu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àní, tí ẹ bá lọ jà pẹ̀lú ìmúláyàle ní ojú ogun, Ọlọ́run yóò bì ọ́ ṣubú níwájú àwọn ọ̀tá, nítorí Ọlọ́run ní agbára láti ràn ọ́ lọ́wọ́ àti láti bì ọ́ ṣubú.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiah sì bi ènìyàn Ọlọ́run pé, \"Ọgọ́rùn-ún tálẹ́ǹtì tí mo ti san fún àwọn ọ̀wọ́ ogun àwọn ọmọ Israẹli ń kọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Ènìyàn Ọlọ́run dáhùn pé \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.9",
                "verseOrgIds": [
                  "2CH.25.9"
                ]
              }
            }
          ]
        },
        {
          "text": "lè fún ọ ní èyí tí ó ju ìyẹn lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Amasiah, tú àwọn ọwọ́ ogun tí ó ti wá sí ọ̀dọ̀ rẹ̀ láti Efraimu ká. Ó sì rán wọn lọ ilé. Wọ́n kún fún ìbínú pẹ̀lú Juda, wọ́n sì padà lọ ilé pẹ̀lú ìbínú ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Amasiah ko ogun rẹ jọ àti àwọn ọmọ-ogun rẹ̀ lọ sí àfonífojì iyọ̀, níbi tí ó ti pa ẹgbẹ̀rún mẹ́wàá (10,000) àwọn ọkùnrin Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Juda pẹ̀lú fi agbára mú àwọn ọkùnrin ẹgbẹ̀rún mẹ́wàá (10,000) láààyè. Wọ́n mú wọn lọ sí orí òkè bèbè òkúta, wọ́n jù wọ́n sílẹ̀, kí gbogbo wọn sì fọ́ sí wẹ́wẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní báyìí àwọn ọ̀wọ́ ogun tí Amasiah ti rán lọ padà, tí wọn kò nípa nínú ogun gbógun sí àwọn ìlú Juda láti Samaria sí Beti-Horoni. Wọ́n pa ẹgbẹ̀rún mẹ́ta (3,000) nínú wọn, wọ́n sì kó ọ̀pọ̀ ìkógun ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Amasiah padà láti ibi pípa àwọn ará Edomu, ó mú àwọn ọlọ́run àwọn ènìyàn Seiri padà wá. Ó gbé wọn kalẹ̀ gẹ́gẹ́ bi àwọn ọlọ́run tirẹ̀. Ó tẹríba fún wọn, ó sì rú ẹbọ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.15",
                "verseOrgIds": [
                  "2CH.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ru sí Amasiah, ó sì rán wòlíì kan sí i, tí ó wí pé, \"Kí ni ó dé tí ìwọ fi ń béèrè lọ́wọ́ àwọn ọlọ́run àwọn ènìyàn yìí, tí wọn kò le gba àwọn ènìyàn tiwọn kúrò lọ́wọ́ rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti n sọ̀rọ̀, ọba wí fún un pé, \"Ṣé a yàn ọ́ ní olùgba ọba lámọ̀ràn ni? Dúró! Èéṣe tí a ó fi lù ọ́ bolẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Bẹ́ẹ̀ ni, wòlíì náà dúró ṣùgbọ́n ó wí pé, \"Èmi mọ̀ pé Ọlọ́run ti pinnu láti pa ọ́ run nítorí ìwọ ti ṣe èyí, ìwọ kò sì tẹ́tí sí ìmọ̀ràn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí Amasiah ọba Juda ti béèrè lọ́wọ́ àwọn olùdámọ̀ràn, ó rán ìpèníjà yìí sí Jehoaṣi ọmọ Jehoahasi ọmọ Jehu, ọba Israẹli pé, \"Wá bá mi lójúkojú.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jehoaṣi ọba Israẹli fèsì padà sí Amasiah ọba Juda pé, \"Koríko kékeré kan ní Lebanoni rán iṣẹ́ sí igi kedari ní Lebanoni, fi ọmọbìnrin rẹ fún ọmọkùnrin mi ní ìgbéyàwó. Nígbà náà, ẹhànnà ẹranko ènìyàn ni Lebanoni wá, ó sì tẹ òṣùṣú náà lábẹ́ ẹsẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ wí fún ara à rẹ wí pé, ìwọ ti ṣẹ́gun Edomu àti nísinsin yìí ìwọ ní ìhàlẹ̀ àti ìgbéraga. Ṣùgbọ́n dúró ní ilé! Kí ni ó dé tí ìwọ fi ń wá wàhálà tí o sì fi ń fa ìṣubú rẹ àti ti Juda pẹ̀lú?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiah, bí ó tì wù kí ó rí kò tẹ́tí nítorí Ọlọ́run ṣe é kí ó lè gbé wọn lé Jehoaṣi lọ́wọ́: nítorí wọ́n wá àwọn ọlọ́run Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Jehoaṣi, ọba Israẹli: òun àti Amasiah ọba Juda dojúkọ ara wọn ní Beti-Ṣemeṣi ní Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli da Juda rú, gbogbo olúkúlùkù ènìyàn sì sálọ sí ìlú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoaṣi ọba Israẹli fi agbára mú Amasiah ọba Juda, ọmọ Joaṣi ọmọ Ahasiah ní Beti-Ṣemeṣi. Nígbà náà Joaṣi mú u wá sí Jerusalẹmu. Ó sì wó ògiri Jerusalẹmu lulẹ̀ láti ẹnu-ọ̀nà Efraimu sí igun ẹnu-ọ̀nà apá kan títí ń lọ sí irinwó (400) ìgbọ̀nwọ́ ní gígùn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba kó gbogbo wúrà àti fàdákà àti gbogbo ohun èlò tí wọ́n rí ni ilé Ọlọ́run tí ọ́ wà ní àbojútó Obedi-Edomu, lápapọ̀ pẹ̀lú àwọn ìṣúra ààfin àti àwọn ògo pẹ̀lú, ó sì padà lọ sí Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiah ọmọ Joaṣi ọba Juda gbé fún ọdún mẹ́ẹ̀ẹ́dógún lẹ́yìn ikú Jehoaṣi ọmọ Jehoahasi ọba Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ti iṣẹ́ mìíràn ti ìjọba Amasiah láti ìbẹ̀rẹ̀ dé ìparí, ṣé a kò kọ wọ́n sínú ìwé àwọn ọba Juda àti Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ìgbà tí Amasiah ti yípadà kúrò láti máa tẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.25.27",
                "verseOrgIds": [
                  "2CH.25.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọ́n dìtẹ̀ sí i ní Jerusalẹmu, ó sì sálọ sí Lakiṣi ṣùgbọ́n, wọ́n rán àwọn ọkùnrin tẹ̀lé e lọ sí Lakiṣi, wọ́n sì pa á síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbé e padà pẹ̀lú ẹṣin. A sì sin ín pẹ̀lú àwọn baba rẹ̀ ní ìlú ńlá ti Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
    }
