  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "2CH 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn ilẹ̀ náà mú Jehoahasi ọmọ Josiah wọn sì fi jẹ ọba ní Jerusalẹmu ni ipò baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahasi ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahasi sì jẹ́ ẹni ọdún mẹ́tàlélógún nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún oṣù mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Ejibiti yọ kúrò lórí ìtẹ́ ní Jerusalẹmu, ó sì bù fún un lórí Juda, ọgọ́rùn-ún tálẹ́ǹtì fàdákà àti tálẹ́ǹtì wúrà kan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba Ejibiti sì mú Eliakimu, arákùnrin Joahasi, jẹ ọba lórí Juda àti Jerusalẹmu, ó sì yí orúkọ Eliakimu padà sí Jehoiakimu, ṣùgbọ́n Neko mú Joahasi arákùnrin Eliakimu lọ sí Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakimu ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakimu sì jẹ́ ẹni ọdún mẹ́ẹ̀ẹ́dọ́gbọ̀n nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún méjìlá. Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.5",
                "verseOrgIds": [
                  "2CH.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnessari ọba Babeli sì mú un, ó sì dè é pẹ̀lú ẹ̀wọ̀n láti mú un lọ sí Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnessari kó nínú ohun èlò ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.7",
                "verseOrgIds": [
                  "2CH.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": "lọ si Babeli pẹ̀lú, ó sì fi wọn sí ààfin rẹ̀ ní Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù iṣẹ́ ìjọba Jehoiakimu, àwọn ohun ìríra tí ó ṣe àti gbogbo ohun tí a rí nípa rẹ̀, ni a kọ sínú ìwé àwọn ọba Israẹli àti Juda. Jehoiakini ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakini ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakini sì jẹ́ ẹni ọdún méjìdínlógún nígbà tí ó di ọba, ó sì jẹ́ ọba ní Jerusalẹmu fún oṣù mẹ́ta àti ọjọ́ mẹ́wàá ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.9",
                "verseOrgIds": [
                  "2CH.36.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò òjò, ọba Nebukadnessari ránṣẹ́ sí i ó sì mú un wá sí Babeli, pẹ̀lú ohun èlò dáradára láti ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.10",
                "verseOrgIds": [
                  "2CH.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì mú arákùnrin Jehoiakini, Sedekiah, jẹ ọba lórí Juda àti Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sedekiah ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekiah jẹ́ ẹni ọdún mọ́kànlélógún nígbà tí ó di ọba, ó sì jẹ ọba ní Jerusalẹmu fún ọdún mọ́kànlá.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀, kò sì rẹ ara rẹ̀ sílẹ̀ níwájú Jeremiah wòlíì ẹni tí ó sọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tún ṣọ̀tẹ̀ sí ọba Nebukadnessari pẹ̀lú, ẹni tí ó mú kí ó fi orúkọ Ọlọ́run búra. Ó sì di ọlọ́run líle, ó sì mú ọkàn rẹ̀ le láti má lè yípadà sí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.13",
                "verseOrgIds": [
                  "2CH.36.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síwájú sí i gbogbo àwọn olórí àlùfáà àti àwọn ènìyàn sì di ẹni tí ń dẹ́ṣẹ̀ gidigidi, pẹ̀lú gbogbo ìríra àwọn orílẹ̀-èdè wọ́n sì sọ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.14",
                "verseOrgIds": [
                  "2CH.36.14"
                ]
              }
            }
          ]
        },
        {
          "text": "di èérí, tí ó ti yà sí mímọ́ ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìṣubú Jerusalẹmu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.15",
                "verseOrgIds": [
                  "2CH.36.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run àwọn baba wọn ránṣẹ́ sí wọn láti ọwọ́ àwọn ìránṣẹ́ rẹ̀ síwájú àti síwájú sí i, nítorí tí ó ní ìyọ́nú sí àwọn ènìyàn rẹ̀ àti sí ibùgbé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n ń kùn sí àwọn ìránṣẹ́ Ọlọ́run, wọ́n kẹ́gàn ọ̀rọ̀ rẹ̀, wọ́n fi àwọn wòlíì rẹ̀ ṣẹ̀sín títí tí ìbínú",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.16",
                "verseOrgIds": [
                  "2CH.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "fi ru sórí wọn, sí àwọn ènìyàn rẹ̀ kò sì ṣí àtúnṣe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú wá sórí wọn ọba àwọn ará Babeli tí wọ́n bá àwọn ọ̀dọ́mọkùnrin wọn jà pẹ̀lú idà ní ilẹ̀ ibi mímọ́, kò sì ní ìyọ́nú sí àgbà ọkùnrin tàbí ọ̀dọ́mọdébìnrin, wúńdíá, tàbí arúgbó. Ọlọ́run sì fi gbogbo wọn lé Nebukadnessari lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú gbogbo ohun èlò láti ilé Ọlọ́run lọ sí Babeli, ńlá àti kékeré àti ìṣúra ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.18",
                "verseOrgIds": [
                  "2CH.36.18"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ìṣúra ọba àti ìjòyè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì fi iná sun ilé Ọlọ́run, wọ́n sì wó gbogbo ògiri ilé Jerusalẹmu, wọ́n sì jó gbogbo ààfin wọn, wọ́n sì ba gbogbo ohun èlò ibẹ̀ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kó èyí tí ó kù lọ sí Babeli àwọn tí ó rí ibi sá kúrò lẹ́nu idà wọ́n sì di ìránṣẹ́ fún un àti àwọn ọmọ rẹ̀ títí tí ìjọba Persia fi gba agbára.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ náà sì gbádùn ìsinmi rẹ̀, ní gbogbo ìgbà ìdahoro, òun sì ń sinmi títí àádọ́rin ọdún fi pé ní ìmúṣẹ ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.21",
                "verseOrgIds": [
                  "2CH.36.21"
                ]
              }
            }
          ]
        },
        {
          "text": "tí a sọ láti ẹnu Jeremiah.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kìn-ín-ní Kirusi ọba Persia, kí ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.22",
                "verseOrgIds": [
                  "2CH.36.22"
                ]
              }
            }
          ]
        },
        {
          "text": "tí a tẹnu Jeremiah sọ bá à le ṣẹ pé,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.22",
                "verseOrgIds": [
                  "2CH.36.22"
                ]
              }
            }
          ]
        },
        {
          "text": "run ẹ̀mí Kirusi ọba Persia láti ṣe ìkéde ní gbogbo ìjọba rẹ̀, ó sì kọ ọ́ sínú ìwé pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí Kirusi ọba Persia sọ wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 36:23"
      },
      "items": [
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.23",
                "verseOrgIds": [
                  "2CH.36.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run ọ̀run, ti fún mí ní gbogbo ìjọba ayé yìí, ó sì ti yàn mí láti kọ́ ilé",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.23",
                "verseOrgIds": [
                  "2CH.36.23"
                ]
              }
            }
          ]
        },
        {
          "text": "fún òun ní Jerusalẹmu ti Juda. Ẹnikẹ́ni nínú àwọn ènìyàn rẹ̀ láàrín yín le gòkè lọ pẹ̀lú rẹ̀; kí",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.23",
                "verseOrgIds": [
                  "2CH.36.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ̀ kí ó wà pẹ̀lú rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
    }
