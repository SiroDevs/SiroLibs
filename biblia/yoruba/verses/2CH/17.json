  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2CH 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoṣafati ọba Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoṣafati ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀ ó sì mú ara rẹ̀ lágbára sí lórí Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi ogun sínú gbogbo ìlú olódi Juda ó sì kó ẹgbẹ́ ológun ní Juda àti nínú ìlú Efraimu tí Asa baba rẹ̀ ti gbà.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.17.3",
                "verseOrgIds": [
                  "2CH.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wà pẹ̀lú Jehoṣafati nítorí, ní ọdún àkọ́kọ́ rẹ̀, ó rìn ní ọ̀nà ti baba rẹ̀ Dafidi ti rìn, kò sì fi ọ̀ràn lọ Baali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó wá Ọlọ́run baba rẹ̀ kiri ó sì tẹ̀lé àṣẹ rẹ̀ ju iṣẹ́ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.17.5",
                "verseOrgIds": [
                  "2CH.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi ìjọba rẹ̀ múlẹ̀ lábẹ́ àkóso rẹ̀, gbogbo Juda sì mú ẹ̀bùn wá fún Jehoṣafati, bẹ́ẹ̀ ni ó sì ní ọrọ̀ àti ọlá lọ́pọ̀lọ́pọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn rẹ̀ sì gbé sókè si ọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.17.6",
                "verseOrgIds": [
                  "2CH.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", pẹ̀lúpẹ̀lú, ó sì mú ibi gíga wọn àti ère òrìṣà Aṣerah kúrò ní Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹta ìjọba rẹ̀, ó rán àwọn ìjòyè rẹ̀ Bene-Haili, Obadiah, Sekariah, Netaneli, Mikaiah láti máa kọ́ ni nínú ìlú Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ní díẹ̀ lára àwọn ọmọ Lefi, àní Ṣemaiah, Netaniah, Sebadiah, Asaheli, Ṣemiramotu, Jehonatani, Adonijah, Tobijah àti Tobu-Adonijah àti àwọn àlùfáà Eliṣama àti Jehoramu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ń kọ́ ni ní agbègbè Juda, wọ́n mú ìwé òfin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.17.9",
                "verseOrgIds": [
                  "2CH.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wọ́n sì rìn yíká gbogbo àwọn ìlú Juda wọ́n sì ń kọ́ àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.17.10",
                "verseOrgIds": [
                  "2CH.17.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bà lórí gbogbo ìjọba ilẹ̀ tí ó yí Juda ká, dé bi pé wọn kò bá Jehoṣafati jagun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára àwọn ará Filistini, mú ẹ̀bùn fàdákà gẹ́gẹ́ bí owó ọba wá fún Jehoṣafati, àwọn ará Arabia sì mú ọ̀wọ́ ẹran wá fún un, ẹgbàarindín ní ọ̀ọ́dúnrún (7,700) àgbò àti ẹgbàarindín ní ọ̀ọ́dúnrún (7,700) òbúkọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoṣafati sì ń di alágbára nínú agbára sí i, ó sì kọ́ ilé olódi àti ilé ìṣúra púpọ̀ ní Juda",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ní ìṣúra ní ìlú Juda. Ó sì tún ní àwọn alágbára jagunjagun akọni ọkùnrin ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye wọn gẹ́gẹ́ bí ilé baba wọn nìwọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 17:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 17:14"
      },
      "items": [
        {
          "text": "Láti Juda, àwọn olórí ìpín kan ti ẹgbẹ̀rún (1,000):",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 17:14"
      },
      "items": [
        {
          "text": "Adina olórí, pẹ̀lú ọ̀kẹ́ mẹ́ẹ̀ẹ́dógún (300,000) alágbára akọni ọkùnrin.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èkejì, Jehohanani olórí, pẹ̀lú ọ̀kẹ́ mẹ́rìnlá (280,000) ọkùnrin;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.15",
            "verseOrgIds": [
              "2CH.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "àtẹ̀lé Amasiah ọmọ Sikri, ẹni tí ó fi ara rẹ̀ fún iṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "2CH.17.16",
                "verseOrgIds": [
                  "2CH.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "pẹ̀lú ọ̀kẹ́ mẹ́wàá (200,000).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ọ̀dọ̀ Benjamini:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 17:17"
      },
      "items": [
        {
          "text": "Eliada, alágbára akọni ọkùnrin pẹ̀lú ọ̀kẹ́ mẹ́wàá (200,000) àwọn jagunjagun ọkùnrin pẹ̀lú ọrun àti àpáta ìhámọ́ra;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "àtẹ̀lé Jehosabadi, pẹ̀lú ọ̀kẹ́ mẹ́sàn-án (180,000) jagunjagun ọkùnrin múra sílẹ̀ fún ogun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
            "verseOrgIds": [
              "2CH.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni àwọn ọkùnrin tí ń dúró níwájú ọba, ní àyíká àwọn ẹni tí ó fi sínú ìlú olódi ní àyíká gbogbo Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
            "verseOrgIds": [
              "2CH.17.19"
            ]
          }
        }
      ]
    }
  ],
