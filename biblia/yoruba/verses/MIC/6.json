      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:13"
      },
      "items": [
        {
          "text": "láti sọ ọ́ dahoro nítorí ẹ̀ṣẹ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.13",
            "verseOrgIds": [
              "MIC.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò jẹun ṣùgbọ́n kì yóò yó;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:14"
      },
      "items": [
        {
          "text": "ìyàn yóò wà láàrín rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:14"
      },
      "items": [
        {
          "text": "Ìwọ yóò kó pamọ́, ṣùgbọ́n ìwọ kì yóò lò láìléwu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:14"
      },
      "items": [
        {
          "text": "nítorí ohun tí ìwọ kò pamọ́ ni èmi yóò fi fún idà.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
