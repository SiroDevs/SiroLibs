      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:11"
      },
      "items": [
        {
          "text": "pẹ̀lú òsùwọ̀n búburú,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
