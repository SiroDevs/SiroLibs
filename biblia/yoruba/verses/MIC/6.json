      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:11"
      },
      "items": [
        {
          "text": "pẹ̀lú àpò òsùwọ̀n ẹ̀tàn?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
