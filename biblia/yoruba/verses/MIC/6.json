          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọlọ́rọ̀ inú rẹ̀ kún fún ìwà ipá;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "àwọn tí ń gbé inú rẹ̀ ti ọ̀rọ̀ èké",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "àti ahọ́n wọn ń sọ ẹ̀tàn?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
