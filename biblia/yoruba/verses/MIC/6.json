          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò gbìn ṣùgbọ́n ìwọ kì yóò kórè",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:15"
      },
      "items": [
        {
          "text": "ìwọ yóò tẹ olifi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:15"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìwọ kì yóò fi òróró rẹ̀ kún ara rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:15"
      },
      "items": [
        {
          "text": "ìwọ yóò tẹ èso àjàrà, ṣùgbọ́n ìwọ kì yóò mu wáìnì.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ìwọ ti pa òfin Omri mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "àti gbogbo iṣẹ́ ilé Ahabu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "tí ó sì ti tẹ̀lé ìmọ̀ràn wọn,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "nítorí náà ni èmi yóò ṣe mú ọ fún ìparun",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "àti àwọn ènìyàn rẹ fún ìfiṣe ẹlẹ́yà;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
