      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "ìwọ yóò sì ru ẹ̀gàn àwọn ènìyàn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
