          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni èmi yóò ṣe mú ọ ṣàìsàn ní lílù ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.13",
            "verseOrgIds": [
              "MIC.6.13"
            ]
          }
        }
      ]
