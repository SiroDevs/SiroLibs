  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjíǹde Kristi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ ará, èmi ń sọ ìyìnrere náà dí mí mọ̀ fún un yín, tí mo ti wàásù fún un yín, èyí tí ẹ̀yin pẹ̀lú ti gbá, nínú èyí tí ẹ̀yin sì dúró.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.1",
            "verseOrgIds": [
              "1CO.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípasẹ̀ ìyìnrere yìí ni a fi ń gbà yín là pẹ̀lú, bí ẹ̀yin bá di ọ̀rọ̀ ti mo ti wàásù fún yín mú ṣinṣin. Bí bẹ́ẹ̀ kọ̀, ẹ̀yin kàn gbàgbọ́ lásán.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.2",
            "verseOrgIds": [
              "1CO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èyí tí mo rí gbà ṣáájú ohun gbogbo ní èmi pẹ̀lú ti fi lé e yín lọ́wọ́, bí Kristi ti kú nítorí ẹ̀ṣẹ̀ wá gẹ́gẹ́ bí ìwé mímọ́ tí wí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti pé a sìnkú rẹ̀, àti pé ó jíǹde ní ọjọ́ kẹta gẹ́gẹ́ bí Ìwé Mímọ́ tí wí;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti pé ó farahàn Peteru, lẹ́yìn èyí, àwọn méjìlá.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.5",
            "verseOrgIds": [
              "1CO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí, ó farahàn àwọn ará tí o jú ẹ̀ẹ́dẹ́gbẹ̀ta (500) lọ lẹ́ẹ̀kan náà; ọ̀pọ̀ nínú wọn wà títí fi di ìsinsin yìí, ṣùgbọ́n àwọn díẹ̀ ti sùn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.6",
            "verseOrgIds": [
              "1CO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí ni ó farahan Jakọbu; lẹ́yìn náà fún gbogbo àwọn aposteli.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.7",
            "verseOrgIds": [
              "1CO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti níkẹyìn gbogbo wọn ó farahàn mí pẹ̀lú, bí ẹni tí a bí ṣáájú àkókò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi ni ẹni tí ó kéré jùlọ nínú àwọn aposteli, èmi ẹni tí kò yẹ láti pè ní aposteli, nítorí tí mo ṣe inúnibíni sí ìjọ ènìyàn Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nípa oore-ọ̀fẹ́ Ọlọ́run mo rí bí mo ti rí: oore-ọ̀fẹ́ rẹ̀ tí a fi fún mi kò sì jẹ́ asán; ṣùgbọ́n mó ṣiṣẹ́ lọ́pọ̀lọ́pọ̀ jú gbogbo wọn lọ, ṣùgbọ́n kì í ṣe èmi, bí kò ṣe oore-ọ̀fẹ́ Ọlọ́run tí ó wà pẹ̀lú mi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.10",
            "verseOrgIds": [
              "1CO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ìbá à ṣe èmí tàbí àwọn ni, èyí ní àwa wàásù, èyí ní ẹ̀yin sì gbàgbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjíǹde òkú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ bí a bá wàásù Kristi pé ó tí jíǹde kúrò nínú òkú, èéha tí ṣe tí àwọn mìíràn nínú yín fi wí pé, àjíǹde òkú kò sí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.12",
            "verseOrgIds": [
              "1CO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí àjíǹde òkú kò sí, ǹjẹ́ Kristi kò jíǹde.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.13",
            "verseOrgIds": [
              "1CO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Kristi kò bá sì jíǹde, ǹjẹ́ asán ni ìwàásù wà, asán sì ni ìgbàgbọ́ yín pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.14",
            "verseOrgIds": [
              "1CO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n jù bẹ́ẹ̀ lọ, a mú wa ni ẹlẹ́rìí èké fún Ọlọ́run; nítorí ti àwa jẹ́rìí Ọlọ́run pé ó jí Kristi dìde kúrò nínú òkú: ẹni tí òun kò jí dìde bí ó bá ṣe pé àwọn òkú kò jíǹde?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.15",
            "verseOrgIds": [
              "1CO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé bi á kò bá jí àwọn òkú dìde, ǹjẹ́ a kò jí Kristi dìde,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.16",
            "verseOrgIds": [
              "1CO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí a kò bá sì jí Kristi dìde, asán ní ìgbàgbọ́ yín; ẹ̀yin wà nínú ẹ̀ṣẹ̀ yín síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.17",
            "verseOrgIds": [
              "1CO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ àwọn pẹ̀lú tí ó sùn nínú Kristi ṣègbé.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.18",
            "verseOrgIds": [
              "1CO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá ṣe pé kìkì ayé yìí nìkan ní àwa ní ìrètí nínú Kristi, àwa jásí òtòṣì jùlọ nínú gbogbo ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ nísinsin yìí Kristi tí jíǹde kúrò nínú òkú, ó sì dí àkọ́bí nínú àwọn tí ó sùn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.20",
            "verseOrgIds": [
              "1CO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìgbà tí ó jẹ́ pé nípa ènìyàn ní ikú ti wá, nípa ènìyàn ní àjíǹde òkú sì ti wá pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.21",
            "verseOrgIds": [
              "1CO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí gbogbo ènìyàn ti kú nínú Adamu, bẹ́ẹ̀ ní a ó sì sọ gbogbo ènìyàn dí alààyè nínú Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.22",
            "verseOrgIds": [
              "1CO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n olúkúlùkù ènìyàn ní ipá tirẹ̀: Kristi àkọ́bí; lẹ́yìn èyí àwọn tí ó jẹ́ tí Kristi ni wíwá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.23",
            "verseOrgIds": [
              "1CO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni òpin yóò dé, nígbà tí ó bá ti fi ìjọba fún Ọlọ́run Baba, nígbà tí ó bá pa gbogbo àṣẹ àti gbogbo ọlá àti agbára run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.24",
            "verseOrgIds": [
              "1CO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ti òun gbọdọ̀ ti jẹ ọba kí òun to fi gbogbo àwọn ọ̀tá rẹ̀ sí abẹ́ ẹsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.25",
            "verseOrgIds": [
              "1CO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikú ní ọ̀tá ìkẹyìn tí a ó parun.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.26",
            "verseOrgIds": [
              "1CO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí ó ti fi ohun gbogbo sábẹ́ ẹsẹ̀ rẹ̀.\" Ṣùgbọ́n nígbà tí ó wí pé, \"Ohun gbogbo ni á fi sí abẹ́ rẹ̀,\" o dájú pé Ọlọ́run nìkan ṣoṣo ní kò sí ní abẹ́ rẹ̀, Òun ní ó fi ohun gbogbo sí abẹ́ àkóso Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.27",
            "verseOrgIds": [
              "1CO.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí a bá sì fi ohun gbogbo sí abẹ́ rẹ̀ tán, nígbà náà ni á ó fi ọmọ tìkára rẹ̀ pẹ̀lú sábẹ́ ẹni tí ó fi ohun gbogbo sí abẹ́ rẹ̀, kí Ọlọ́run lè jásí ohun gbogbo nínú ohun gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní báyìí, bí kò bá sí àjíǹde, kín ní ète àwọn ènìyàn tí wọn ń tẹ bọ omi nítorí òkú? Bí àwọn òkú kò bá jíǹde rárá, nítorí kín ni a ṣe ń bamitiisi wọn nítorí wọn?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.29",
            "verseOrgIds": [
              "1CO.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kín ní àwa sì ṣe ń bẹ nínú ewu ni wákàtí gbogbo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.30",
            "verseOrgIds": [
              "1CO.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sọ nípa ayọ̀ tí mo ní lórí yín nínú Kristi Jesu Olúwa wá pé, èmi ń kú lójoojúmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.31",
            "verseOrgIds": [
              "1CO.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a wí bí ènìyàn, bí mo bá ẹranko jà ní Efesu, àǹfààní kín ni ó jẹ́ fún mi? Bí àwọn òkú kò bá jíǹde,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 15:32"
      },
      "items": [
        {
          "text": "\"Ẹ jẹ́ kí a máa jẹ, kí á máa mú;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 15:32"
      },
      "items": [
        {
          "text": "nítorí ní ọlá ni àwa ó kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a má tàn yín jẹ́, \"Ẹgbẹ́ búburú bá ìwà rere jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.33",
            "verseOrgIds": [
              "1CO.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jí ìjí òdodo, kí ẹ má sì dẹ́ṣẹ̀; nítorí àwọn ẹlòmíràn kò ni imọ̀ Ọlọ́run, mo sọ èyí kí ojú ba à lè tiyín.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjíǹde ara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹnìkan yóò wí pé, \"Báwo ni àwọn òkú yóò ṣe jíǹde? Irú ara wó ni wọn ó padà sí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.35",
            "verseOrgIds": [
              "1CO.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ aláìmòye, ohun tí ìwọ fúnrúgbìn kì í yè bí kò ṣe pé ó ba kú,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.36",
            "verseOrgIds": [
              "1CO.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti èyí tí ìwọ fúnrúgbìn, kì í ṣe ara tí ń bọ̀ ni ìwọ fúnrúgbìn, ṣùgbọ́n èso lásán ni, ìbá à ṣe alikama, tàbí irú mìíràn.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.37",
            "verseOrgIds": [
              "1CO.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run fún ún ni ara bí o tí wù ú, àti fún olúkúlùkù irúgbìn ara tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.38",
            "verseOrgIds": [
              "1CO.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ẹran-ara kì í ṣe ẹran-ara kan náà, ṣùgbọ́n ọ̀tọ̀ ni ẹran-ara ti ènìyàn, ọ̀tọ̀ ni ẹran-ara ti ẹranko, ọ̀tọ̀ ní ti ẹja, ọ̀tọ̀ sì ní tí ẹyẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.39",
            "verseOrgIds": [
              "1CO.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará ti òkè ọ̀run ń bẹ, ara ti ayé pẹ̀lú sì ń bẹ, ṣùgbọ́n ògo ti òkè ọ̀run ọ̀tọ̀, àti ògo ti ayé ọ̀tọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.40",
            "verseOrgIds": [
              "1CO.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CO 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀tọ̀ ni ògo ti oòrùn, ọ̀tọ̀ ni ògo ti òṣùpá, ọ̀tọ̀ sì ni ògo ti ìràwọ̀; ìràwọ̀ ṣá yàtọ̀ sí ìràwọ̀ ni ògo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.41",
            "verseOrgIds": [
              "1CO.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CO 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bẹ́ẹ̀ sí ni àjíǹde òkú. A gbìn ín ní ìdíbàjẹ́; a sí jì í dìde ni àìdíbàjẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.42",
            "verseOrgIds": [
              "1CO.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CO 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbìn ín ni àìní ọlá, a sí jí i dìde ni ògo; a gbìn ín ni àìlera, a sì jí í dìde ní agbára.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.43",
            "verseOrgIds": [
              "1CO.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CO 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbìn ín ni, ara ẹran a sì jí i dìde ni ara ti ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 15:44"
      },
      "items": [
        {
          "text": "Bí ara ẹran bá ń bẹ, ara ẹ̀mí náà sì ń bẹ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CO 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ní a si kọ ọ́ pé, \"Adamu ọkùnrin ìṣáájú, alààyè ọkàn ni a dá a\"; Adamu ìkẹyìn ẹ̀mí ìsọnidààyè.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.45",
            "verseOrgIds": [
              "1CO.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CO 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èyí tí í ṣe tí ẹ̀mí kọ ní ó kọ́kọ́ ṣáájú, bí kò ṣe èyí tí í ṣe tí ara ọkàn, lẹ́yìn náà èyí ti í ṣe ti ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.46",
            "verseOrgIds": [
              "1CO.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CO 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin ìṣáájú ti inú erùpẹ̀ wá gẹ́gẹ́ bí ẹni erùpẹ̀: ọkùnrin èkejì láti ọ̀run wá ni.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.47",
            "verseOrgIds": [
              "1CO.15.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CO 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹni erùpẹ̀ ti rí, irú bẹ́ẹ̀ sì ni àwọn tí í ṣe erùpẹ̀: bí ẹni tí ọ̀run ti rí, irú bẹ́ẹ̀ sì ni àwọn tí í ṣe tí ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.48",
            "verseOrgIds": [
              "1CO.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa ti rú àwòrán ẹni erùpẹ̀, bẹ́ẹ̀ ni àwa ó sì rú àwòrán ẹni ti ọ̀run.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CO 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará, ǹjẹ́ èyí ní mo wí pé, ara àti ẹ̀jẹ̀ kò lè jogún ìjọba Ọlọ́run, bẹ́ẹ̀ ni ìdíbàjẹ́ kò lé jogún àìdíbàjẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.50",
            "verseOrgIds": [
              "1CO.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CO 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kíyèsi í, ohun ìjìnlẹ̀ ni mo sọ fún un yín, gbogbo wá kì yóò sùn, ṣùgbọ́n gbogbo wá ní a ó paláradà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.51",
            "verseOrgIds": [
              "1CO.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CO 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọ́gán, ni ìṣẹ́jú kan, nígbà ìpè ìkẹyìn: nítorí ìpè yóò dún, a ó sì jí àwọn òkú dìde ní àìdíbàjẹ́, a ó sì pa wá láradà.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.52",
            "verseOrgIds": [
              "1CO.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CO 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ara ìdíbàjẹ́ yìí kò lè ṣàìgbé ìdíbàjẹ́ wọ̀, àti ara kíkú yìí kò lè ṣàìgbé ara àìkú wọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.53",
            "verseOrgIds": [
              "1CO.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CO 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ará ìdíbàjẹ́ yìí bá ti gbé àìdíbàjẹ́ wọ̀, ti ara kíkú yìí bá sí ti gbé àìkú wọ̀ bẹ́ẹ̀ tan, nígbà náà ni ọ̀rọ̀ ti a kọ yóò ṣẹ pé, \"A gbé ikú mí ní ìṣẹ́gun.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.54",
            "verseOrgIds": [
              "1CO.15.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CO 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ikú, oró rẹ dà?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 15:55"
      },
      "items": [
        {
          "text": "Ikú, ìṣẹ́gun rẹ́ dà?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1CO 15:56"
          },
          "items": [
            {
