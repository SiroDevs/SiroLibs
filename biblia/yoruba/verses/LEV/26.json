  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "LEV 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Èrè ìgbọ́ràn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "text": "'Ẹ̀yin kò gbọdọ̀ mọ ère òrìṣà, tàbí kí ẹ̀yin gbe ère kalẹ̀ tàbí kí ẹ̀yin gbẹ́ ère òkúta: kí ẹ̀yin má sì gbẹ́ òkúta tí ẹ̀yin yóò gbé kalẹ̀ láti sìn. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.1",
                "verseOrgIds": [
                  "LEV.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ẹ pa ọjọ́ ìsinmi mi mọ́ kí ẹ̀yin sì bọ̀wọ̀ fún ibi mímọ́ mi. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.2",
                "verseOrgIds": [
                  "LEV.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹ̀yin bá tẹ̀lé àṣẹ mi, tí ẹ̀yin sì ṣọ́ra láti pa òfin mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rọ̀jò fún yín ní àkókò rẹ̀, kí ilẹ̀ yín le mú èso rẹ̀ jáde bí ó tí yẹ kí àwọn igi eléso yín so èso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èrè oko yín yóò pọ̀ dé bi pé ẹ ó máa pa ọkà títí di àsìkò ìkórè igi eléso, ẹ̀yin yóò sì máa gbé ní ilẹ̀ yín láìléwu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èmi yóò fún yín ní àlàáfíà ní ilẹ̀ yín, ẹ̀yin yóò sì sùn láìsí ìbẹ̀rù ẹnikẹ́ni. Èmi yóò mú kí gbogbo ẹranko búburú kúrò ní ilẹ̀ náà, bẹ́ẹ̀ ni idà kì yóò la ilẹ̀ yín já.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin yóò lé àwọn ọ̀tá yín, wọn yóò sì tipa idà kú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn márùn-ún péré nínú yín yóò máa ṣẹ́gun ọgọ́rùn-ún ènìyàn, àwọn ọgọ́rùn-ún yóò sì máa ṣẹ́gun ẹgbẹ̀rún mẹ́wàá (10,000), àwọn ọ̀tá yín yóò tipa idà kú níwájú yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èmi yóò fi ojúrere wò yín, Èmi yóò mú kí ẹ bí sí i, Èmi yóò jẹ́ kí ẹ pọ̀ sí i, Èmi yóò sì pa májẹ̀mú mi mọ́ pẹ̀lú yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn èrè oko yín yóò pọ̀ tó bẹ́ẹ̀ tí ẹ̀yin ó máa jẹ èrè ọdún tí ó kọjá, ẹ̀yin ó sì kó wọn jáde, kí ẹ̀yin lè rí ààyè kó tuntun sí.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò kọ́ àgọ́ mímọ́ mi sí àárín yín. Èmi kò sì ní kórìíra yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò wà pẹ̀lú yín, Èmi yóò máa jẹ́ Ọlọ́run yín, ẹ̀yin yóò sì máa jẹ́ ènìyàn mi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.13",
                "verseOrgIds": [
                  "LEV.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín tí ó mú yín jáde kúrò ní ilẹ̀ Ejibiti, kí ẹ̀yin má ba à jẹ́ ẹrú fún wọn mọ́. Mo sì já ìdè àjàgà yín, mo sì mú kí ẹ̀yin máa rìn gẹ́gẹ́ bí ẹni tí a gbé lórí sókè.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìjìyà fún àìgbọ́ràn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹ̀yin kò bá fetí sí mi tí ẹ̀yin kò sì ṣe gbogbo òfin wọ̀nyí.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ẹ̀yin bá kọ àṣẹ mi tí ẹ̀yin sì kórìíra òfin mi, tí ẹ̀yin sì kùnà láti pa ìlànà mi mọ́, nípa èyí tí ẹ̀yin ti ṣẹ̀ sí májẹ̀mú mi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ṣe àwọn nǹkan wọ̀nyí sí yín, Èmi yóò mú ìpayà òjijì bá yín: àwọn ààrùn afiniṣòfò, àti ibà afọ́nilójú, tí í pa ni díẹ̀díẹ̀. Ẹ̀yin yóò gbin èso ilẹ̀ yín lásán, nítorí pé àwọn ọ̀tá yín ni yóò jẹ gbogbo ohun tí ẹ̀yin ti gbìn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò dojúkọ yín títí tí ẹ̀yin ó fi di ẹni ìkọlù; àwọn tí ó kórìíra yín ni yóò sì ṣe àkóso lórí yín. Ìbẹ̀rù yóò mú yín dé bi pé ẹ̀yin yóò máa sá káàkiri nígbà tí ẹnikẹ́ni kò lé yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹ̀yin kò bá wá gbọ́ tèmi lẹ́yìn gbogbo èyí, Èmi yóò fi kún ìyà yín ní ìlọ́po méje nítorí ẹ̀ṣẹ̀ yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò fọ́ agbára ìgbéraga yín, ojú ọ̀run yóò le koko bí irin, ilẹ̀ yóò sì le bí idẹ (òjò kò ní rọ̀: ilẹ̀ yín yóò sì le).",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ ó máa lo agbára yín lásán torí pé ilẹ̀ yín kì yóò so èso, bẹ́ẹ̀ ni àwọn igi yín kì yóò so èso pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹ bá tẹ̀síwájú láì gbọ́ tèmi, Èmi yóò tún fa ìjayà yín le ní ìgbà méje gẹ́gẹ́ bí ẹ̀ṣẹ̀ yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán àwọn ẹranko búburú sí àárín yín, wọn yóò sì pa àwọn ọmọ yín, wọn yóò run agbo ẹran yín, díẹ̀ nínú yín ni wọn yóò ṣẹ́kù kí àwọn ọ̀nà yín lè di ahoro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹ kò bá tún yípadà lẹ́yìn gbogbo ìjìyà wọ̀nyí, tí ẹ sì tẹ̀síwájú láti lòdì sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi náà yóò lòdì sí yín. Èmi yóò tún fa ìjìyà yín le ní ìlọ́po méje ju ti ìṣáájú.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò mú idà wá bá yín nítorí ẹ̀ṣẹ̀ yín láti fi gbẹ̀san májẹ̀mú mi tí ẹ kò pamọ́. Bí ẹ ba sálọ sí ìlú yín fún ààbò, Èmi yóò rán àjàkálẹ̀-ààrùn sí àárín yín, àwọn ọ̀tá yín, yóò sì ṣẹ́gun yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò dá ìpèsè oúnjẹ yín dúró, dé bi pé: inú ààrò kan ni obìnrin mẹ́wàá yóò ti máa se oúnjẹ yín. Òsùwọ̀n ni wọn yóò fi máa yọ oúnjẹ yín, ẹ ó jẹ ṣùgbọ́n, ẹ kò ní yó.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lẹ́yìn gbogbo èyí, bí ẹ kò bá gbọ́ tèmi, tí ẹ sì lòdì sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ìbínú mi, èmi yóò korò sí yín, èmi tìkára mi yóò fìyà jẹ yín ní ìgbà méje nítorí ẹ̀ṣẹ̀ yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi náà yóò pa yín dé bi pé ẹ ó máa jẹ ẹran-ara àwọn ọmọ yín ọkùnrin, àti àwọn ọmọ yín obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò wó àwọn pẹpẹ òrìṣà yín, lórí òkè níbi tí ẹ ti ń sìn, Èmi yóò sì kó òkú yín jọ, sórí àwọn òkú òrìṣà yín. Èmi ó sì kórìíra yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sọ àwọn ìlú yín di ahoro, èmi yóò sì ba àwọn ilé mímọ́ yín jẹ́. Èmi kì yóò sì gbọ́ òórùn dídùn yín mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò pa ilẹ̀ yín run dé bi pé ẹnu yóò ya àwọn ọ̀tá yín tí ó bá gbé ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì tú yín ká sínú àwọn orílẹ̀-èdè, Èmi yóò sì yọ idà tì yín lẹ́yìn, ilẹ̀ yín yóò sì di ahoro, àwọn ìlú yín ni a ó sì parun.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ náà yóò ní ìsinmi fún gbogbo ìgbà tí ẹ fi wà ní ilẹ̀ àjèjì tí ẹ kò fi lò ó. Ilẹ̀ náà yóò sinmi láti fi dípò ọdún tí ẹ kọ̀ láti fún un.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níwọ́n ìgbà tí ẹ kò lò ó, ilẹ̀ náà yóò ní ìsinmi tí kò ní lákòókò ìsinmi rẹ̀ lákokò tí ẹ fi ń gbé orí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èmi yóò jẹ́ kí ó burú fún àwọn tí ó wà ní ilẹ̀ ìgbèkùn dé bi pé ìró ewé tí ń mì lásán yóò máa lé wọn sá. Ẹ ó máa sá bí ẹni tí ń sá fún idà. Ẹ ó sì ṣubú láìsí ọ̀tá láyìíká yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò máa ṣubú lu ara wọn, bí ẹni tí ń sá fún idà nígbà tí kò sí ẹni tí ń lé yín. Ẹ̀yin kì yóò sì ní agbára láti dúró níwájú ọ̀tá yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin yóò ṣègbé láàrín àwọn orílẹ̀-èdè abọ̀rìṣà. Ilẹ̀ ọ̀tá yín yóò sì jẹ yín run.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó ṣẹ́kù nínú yín ni yóò ṣòfò dànù ní ilẹ̀ ọ̀tá yín torí ẹ̀ṣẹ̀ yín àti ti àwọn baba ńlá yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí wọ́n bá jẹ́wọ́ ẹ̀ṣẹ̀ wọn àti ti baba ńlá wọn, ìwà ìṣọ̀tẹ̀ wọn àti bí wọ́n ti ṣe lòdì sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí tó mú mi lòdì sí wọn tí mo fi kó wọn lọ sí ilẹ̀ àwọn ọ̀tá wọn. Nígbà tí wọ́n bá rẹ àìkọlà àyà wọn sílẹ̀ tí wọ́n bá sì gba ìbáwí ẹ̀ṣẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Èmi yóò rántí májẹ̀mú mi pẹ̀lú Jakọbu àti pẹ̀lú Isaaki àti pẹ̀lú Abrahamu, Èmi yóò sì rántí ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn náà yóò sì fi ilẹ̀ náà sílẹ̀, yóò sì ní ìsinmi rẹ̀ nígbà tí ó bá wà lófo láìsí wọn níbẹ̀. Wọn yóò sì jìyà ẹ̀ṣẹ̀ wọn torí pé wọ́n kọ àwọn òfin mi. Wọ́n sì kórìíra àwọn àṣẹ mi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú gbogbo nǹkan wọ̀nyí, nígbà tí wọ́n bá wà nílé àwọn ọ̀tá wọn, èmi kì yóò ta wọ́n nù, bẹ́ẹ̀ ni èmi kì yóò kórìíra wọn pátápátá, èyí tí ó lè mú mi dá májẹ̀mú mi pẹ̀lú wọn. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.44",
                "verseOrgIds": [
                  "LEV.26.44"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí wọn, èmi ó rántí májẹ̀mú mi tí mo ti ṣe pẹ̀lú baba ńlá wọn. Àwọn tí mo mú jáde kúrò ní ilẹ̀ Ejibiti lójú gbogbo àwọn orílẹ̀-èdè láti jẹ́ Ọlọ́run wọn. Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.45",
                "verseOrgIds": [
                  "LEV.26.45"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ̀nyí ni òfin àti ìlànà tí",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.46",
                "verseOrgIds": [
                  "LEV.26.46"
                ]
              }
            }
          ]
        },
        {
          "text": "fún Mose ní orí òkè Sinai láàrín òun àti àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
      ]
    }
  ],
