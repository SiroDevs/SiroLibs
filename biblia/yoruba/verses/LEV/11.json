  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "LEV 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oúnjẹ tó mọ́ àti èyí tí kò mọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.11.1",
                "verseOrgIds": [
                  "LEV.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose àti Aaroni pé,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹ sọ fún àwọn ara Israẹli pé, 'Nínú gbogbo ẹranko tí ń gbé lórí ilẹ̀, àwọn wọ̀nyí ni ẹ le jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.2",
            "verseOrgIds": [
              "LEV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ẹranko tí pátákò ẹsẹ̀ rẹ̀ bá là tí ó sì ń jẹ àpọ̀jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.3",
            "verseOrgIds": [
              "LEV.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn mìíràn wà tó ń jẹ àpọ̀jẹ nìkan. Àwọn mìíràn wà tó jẹ́ pé pátákò ẹsẹ̀ wọn nìkan ni ó là, ìwọ̀nyí ni ẹ kò gbọdọ̀ jẹ fún àpẹẹrẹ bí ó tilẹ̀ jẹ́ pé ìbákasẹ ń jẹ àpọ̀jẹ kò ya pátákò ẹsẹ̀, àìmọ́ ni èyí jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.4",
            "verseOrgIds": [
              "LEV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé gara (ẹranko tí ó dàbí ehoro tí ń gbé inú àpáta) ń jẹ àpọ̀jẹ; aláìmọ́ ni èyí jẹ́ fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.5",
            "verseOrgIds": [
              "LEV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé ehoro ń jẹ àpọ̀jẹ, ṣùgbọ́n kò ya pátákò ẹsẹ̀; aláìmọ́ ni èyí jẹ́ fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.6",
            "verseOrgIds": [
              "LEV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé ẹlẹ́dẹ̀ ya pátákò ẹsẹ̀ ṣùgbọ́n kì í jẹ àpọ̀jẹ; aláìmọ́ ni èyí jẹ́ fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.7",
            "verseOrgIds": [
              "LEV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe jẹ ẹran wọn, ẹ kò sì gbọdọ̀ fọwọ́ kan òkú wọn. Àìmọ́ ni wọ́n jẹ́ fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nínú gbogbo ohun tí Ọlọ́run dá tí ń gbé inú omi Òkun, àti nínú odò: èyíkéyìí tí ó bá ní lẹbẹ àti ìpẹ́ ni ẹ lè jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.9",
            "verseOrgIds": [
              "LEV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nínú gbogbo ẹ̀dá tí ń gbé inú òkun àti nínú odò tí kò ní lẹbẹ àti ìpẹ́, yálà nínú gbogbo àwọn tí ń rákò tàbí láàrín gbogbo àwọn ẹ̀dá alààyè yòókù tí ń gbé inú omi àwọn ni kí ẹ kórìíra.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.10",
            "verseOrgIds": [
              "LEV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ ti kórìíra wọn ẹ kò gbọdọ̀ jẹ ẹran wọn: ẹ gbọdọ̀ kórìíra òkú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.11",
            "verseOrgIds": [
              "LEV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohunkóhun tí ń gbé inú omi tí kò ní lẹbẹ àti ìpẹ́ gbọdọ̀ jásí ìríra fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn ẹyẹ wọ̀nyí ni ẹ gbọdọ̀ kórìíra tí ẹ kò gbọdọ̀ jẹ wọ́n torí pé ohun ìríra ni wọ́n: idì, oríṣìíríṣìí igún,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13",
            "verseOrgIds": [
              "LEV.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwòdì àti onírúurú àṣá,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.14",
            "verseOrgIds": [
              "LEV.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "onírúurú ẹyẹ ìwò,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.15",
            "verseOrgIds": [
              "LEV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òwìwí, onírúurú ògòǹgò, onírúurú ẹ̀lúùlú, onírúurú àwòdì,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.16",
            "verseOrgIds": [
              "LEV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òwìwí kéékèèké, onírúurú òwìwí,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.17",
            "verseOrgIds": [
              "LEV.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òwìwí funfun àti òwìwí ilẹ̀ pápá, àti àkàlà,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.18",
            "verseOrgIds": [
              "LEV.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "àkọ̀, onírúurú òòdẹ̀, atọ́ka àti àdán.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.19",
            "verseOrgIds": [
              "LEV.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gbogbo kòkòrò tí ń fò tí ó sì ń fi ẹsẹ̀ mẹ́rẹ̀ẹ̀rin rìn ni wọ́n jẹ́ ìríra fún yín,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.20",
            "verseOrgIds": [
              "LEV.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "irú àwọn kòkòrò oniyẹ̀ẹ́ tí wọn sì ń fi ẹsẹ̀ mẹ́rẹ̀ẹ̀rin rìn tí ẹ le jẹ nìyí, àwọn kòkòrò tí wọ́n ní ìṣẹ́po ẹsẹ̀ láti máa fi fò lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.21",
            "verseOrgIds": [
              "LEV.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú àwọn wọ̀nyí ni ẹ lè jẹ onírúurú eṣú, onírúurú ìrẹ̀ àti onírúurú tata.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.22",
            "verseOrgIds": [
              "LEV.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n gbogbo ohun ìyókù tí ń fò, tí ń rákò, tí ó ní ẹsẹ̀ mẹ́rin, òun ni kí ẹ̀yin kí ó kà sí ìríra fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nípa àwọn wọ̀nyí ni ẹ le fi sọ ara yín di àìmọ́. Ẹnikẹ́ni tí ó bá fọwọ́ kan òkú wọn yóò di aláìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24",
            "verseOrgIds": [
              "LEV.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá gbé òkú wọn gbọdọ̀ fọ aṣọ rẹ̀, yóò sì jẹ́ aláìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.25",
            "verseOrgIds": [
              "LEV.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn ẹranko tí pátákò wọn kò là tan tàbí tí wọn kò jẹ àpọ̀jẹ jẹ́ àìmọ́ fún yín. Ẹni tí ó bá fọwọ́ kan òkú èyíkéyìí nínú wọn yóò jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.26",
            "verseOrgIds": [
              "LEV.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú gbogbo ẹranko tí ń fi ẹsẹ̀ mẹ́rẹ̀ẹ̀rin rìn, àwọn tí ń fi èékánná wọn rìn jẹ́ aláìmọ́ fún yín, ẹni tí ó bá fọwọ́ kan òkú wọn yóò jẹ́ aláìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.27",
            "verseOrgIds": [
              "LEV.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó bá gbé òkú wọn gbọdọ̀ fọ aṣọ rẹ̀, yóò sì jẹ́ aláìmọ́ títí di ìrọ̀lẹ́. Wọ̀nyí jẹ́ àìmọ́ fún yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nínú gbogbo ẹranko tí ń rìn lórí ilẹ̀ ìwọ̀nyí ni ó jẹ́ àìmọ́ fún yín: Asé, eku àti oríṣìíríṣìí aláǹgbá,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọnílé, alágẹmọ, aláǹgbá, ìgbín àti ọ̀gà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú gbogbo ohun tí ń rìn lórí ilẹ̀, ìwọ̀nyí jẹ́ àìmọ́ fún yín. Ẹnikẹ́ni tí ó bá fọwọ́ kan òkú wọn yóò di aláìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọ̀kan nínú wọn bá kú tí wọ́n sì bọ́ sórí nǹkan kan, bí ó ti wù kí irú ohun náà wúlò tó, yóò di aláìmọ́ yálà aṣọ ni a fi ṣe é ni tàbí igi, irun aṣọ tàbí àpò, ẹ sọ ọ́ sínú omi yóò jẹ́ aláìmọ́ títí ìrọ̀lẹ́ lẹ́yìn náà ni yóò tó di mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí èyíkéyìí nínú wọn bá bọ́ sínú ìkòkò amọ̀, gbogbo ohun tí ó wà nínú rẹ̀ ti di àìmọ́. Ẹ gbọdọ̀ fọ ìkòkò náà.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí omi inú ìkòkò náà bá dà sórí èyíkéyìí nínú oúnjẹ tí ẹ̀ ń jẹ oúnjẹ náà di aláìmọ́. Gbogbo ohun mímu tí a lè mú jáde láti inú rẹ̀ di àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ohun tí èyíkéyìí nínú òkú wọn bá já lé lórí di àìmọ́. Yálà ààrò ni tàbí ìkòkò ìdáná wọn gbọdọ̀ di fífọ́. Wọ́n jẹ́ àìmọ́. Ẹ sì gbọdọ̀ kà wọ́n sí àìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òkú wọn bá bọ́ sínú omi tàbí kànga tó ní omi nínú, omi náà kò di aláìmọ́ ṣùgbọ́n ẹnikẹ́ni tí ó bá yọ òkú wọn jáde tí ó fi ọwọ́ kàn án yóò di aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òkú ẹranko wọ̀nyí bá bọ́ sórí ohun ọ̀gbìn tí ẹ fẹ́ gbìn wọ́n sì jẹ́ mímọ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹ bá ti da omi sí ohun ọ̀gbìn náà tí òkú wọn sì bọ́ sí orí rẹ̀ àìmọ́ ni èyí fún un yín.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bí ẹran kan bá kú nínú àwọn tí ẹ lè jẹ, ẹnikẹ́ni tí ó bá fọwọ́ kan òkú rẹ̀ yóò di aláìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá jẹ èyíkéyìí nínú òkú ẹranko náà gbọdọ̀ fọ aṣọ rẹ̀, yóò sì di aláìmọ́ títí ìrọ̀lẹ́. Ẹnikẹ́ni tí ó bá gbé òkú ẹranko yóò fọ aṣọ rẹ̀ yóò sì wà ní àìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ìríra ni gbogbo ohun tí ń rìn káàkiri lórí ilẹ̀ jẹ́, ẹ kò gbọdọ̀ jẹ wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.41",
            "verseOrgIds": [
              "LEV.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò gbọdọ̀ jẹ ohunkóhun tí ń rìn ká orí ilẹ̀ yálà ó ń fàyàfà tàbí ó ń fi ẹsẹ̀ mẹ́rẹ̀ẹ̀rin rìn, tàbí ó ń fi ọ̀pọ̀lọpọ̀ ẹsẹ̀ rìn ìríra ni èyí.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
              "LEV.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀yin kò gbọdọ̀ fi ohun kan tí ń rákò, sọ ara yín di ìríra, bẹ́ẹ̀ ni ẹ̀yin kò gbọdọ̀ fi wọ́n sọ ara yín di aláìmọ́, tí ẹ̀yin yóò fi ti ipa wọn di eléèérí.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
              "LEV.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.11.44",
                "verseOrgIds": [
                  "LEV.11.44"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, ẹ ya ara yín sọ́tọ̀ kí ẹ sì jẹ́ mímọ́ torí pé mo jẹ́ mímọ́. Ẹ má ṣe sọ ara yín di àìmọ́ nípasẹ̀ ohunkóhun tí ń rìn káàkiri lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "LEV.11.45",
                "verseOrgIds": [
                  "LEV.11.45"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó mú yín jáde láti ilẹ̀ Ejibiti wá láti jẹ́ Ọlọ́run yín torí náà, ẹ jẹ́ mímọ́ torí pé mímọ́ ni èmi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Àwọn wọ̀nyí ni ìlànà fún ẹranko, ẹyẹ, gbogbo ẹ̀dá alààyè tí ń gbé inú omi àti àwọn ẹ̀dá tí ó ń rìn lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọdọ̀ mọ ìyàtọ̀ láàrín àìmọ́ àti mímọ́ láàrín ẹ̀dá alààyè, tí ẹ le jẹ àti èyí tí ẹ kò le jẹ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
            "verseOrgIds": [
              "LEV.11.47"
            ]
          }
        }
      ]
    }
  ],
