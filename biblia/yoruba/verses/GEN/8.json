{
  "id": "GEN.8",
  "number": "8",
  "bookId": "GEN",
  "reference": "Gẹnẹsisi 8",
  "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "GEN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìkún omi gbẹ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì rántí Noa àti ohun alààyè gbogbo tí ó wà pẹ̀lú rẹ̀, bí àwọn ẹranko igbó àti ohun ọ̀sìn, ó sì mú kí afẹ́fẹ́ fẹ́ sórí ilẹ̀, omi náà sì fà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìsun ibú àti fèrèsé ìṣàn ọ̀run tì, òjò pẹ̀lú sì dáwọ́ rírọ̀ dúró.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi sì bẹ̀rẹ̀ sí ní gbẹ kúrò lórí ilẹ̀, lẹ́yìn àádọ́jọ ọjọ́, ó sì ti ń fà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹtàdínlógún oṣù kejì ni ọkọ̀ náà gúnlẹ̀ sórí òkè Ararati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.4",
            "verseOrgIds": [
              "GEN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi náà sì ń gbẹ si títí di oṣù kẹwàá. Ní ọjọ́ kìn-ín-ní oṣù kẹwàá, orí àwọn òkè sì farahàn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ogójì ọjọ́, Noa sí fèrèsé tí ó ṣe sára ọkọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.6",
            "verseOrgIds": [
              "GEN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rán ẹyẹ ìwò kan jáde, tí ó ń fò káàkiri síwá àti sẹ́yìn títí omi fi gbẹ kúrò ní orí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.7",
            "verseOrgIds": [
              "GEN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rán àdàbà kan jáde láti wò ó bóyá omi ti gbẹ kúrò lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.8",
            "verseOrgIds": [
              "GEN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àdàbà náà kò rí ìyàngbẹ ilẹ̀ bà lé nítorí omi kò tí ì tan lórí ilẹ̀, ó sì padà sọ́dọ̀ Noa. Noa na ọwọ́ rẹ̀ jáde ó sì mú ẹyẹ náà wọlé sọ́dọ̀ ara rẹ̀ nínú ọkọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dúró fún ọjọ́ méje sí i; ó sì tún rán àdàbà náà jáde láti inú ọkọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.10",
            "verseOrgIds": [
              "GEN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àdàbà náà padà sọ́dọ̀ rẹ̀ ní àṣálẹ́, ó já ewé igi olifi tútù há ẹnu! Nígbà náà ni Noa mọ̀ pé omi ti ń gbẹ kúrò lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.11",
            "verseOrgIds": [
              "GEN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa tún mú sùúrù fún ọjọ́ méje, ó sì tún rán àdàbà náà jáde, ṣùgbọ́n àdàbà náà kò padà sọ́dọ̀ rẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kìn-ín-ní oṣù kìn-ín-ní, ní ọdún kọ́kànlélẹ́gbẹ̀ta (601) ni omi náà gbẹ kúrò lórí ilẹ̀; Noa sì ṣí ọkọ̀, ó sì ri pé ilẹ̀ ti gbẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹtàdínlọ́gbọ̀n oṣù kejì, ilẹ̀ ti gbẹ pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Ọlọ́run wí fún Noa pé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.15",
            "verseOrgIds": [
              "GEN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jáde kúrò nínú ọkọ̀, ìwọ àti aya rẹ, pẹ̀lú àwọn ọmọ rẹ àti àwọn aya wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kó gbogbo àwọn ẹ̀dá alààyè tí ó wà pẹ̀lú rẹ jáde: àwọn ẹyẹ, ẹranko àti gbogbo àwọn ẹ̀dá tí ń rìn nílẹ̀, kí wọn lè bí sí i, kí wọn sì pọ̀ sí i, kí wọn sì máa gbá yìn lórí ilẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa, àwọn ọmọ rẹ̀, aya rẹ̀ àti àwọn aya ọmọ rẹ̀ sì jáde.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.18",
            "verseOrgIds": [
              "GEN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ẹranko àti àwọn ẹ̀dá tí ń rìn nílẹ̀ àti gbogbo ẹyẹ pátápátá ni ó jáde kúrò nínú ọkọ̀, ní ọ̀wọ̀ọ̀wọ́ ní irú tiwọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa sì mọ pẹpẹ fún",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.20",
            "verseOrgIds": [
              "GEN.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.8.20",
                "verseOrgIds": [
                  "GEN.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", ó sì mú lára àwọn ẹran tí ó mọ́ àti ẹyẹ tí ó mọ́, ó sì fi rú ẹbọ sísun lórí pẹpẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.20",
            "verseOrgIds": [
              "GEN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.8.21",
                "verseOrgIds": [
                  "GEN.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sì gbọ́ òórùn dídùn; ó sì wí ní ọkàn rẹ̀ pé, \"Èmi kì yóò tún fi ilẹ̀ ré nítorí ènìyàn mọ, bí ó tilẹ̀ jẹ́ pé gbogbo èrò inú rẹ̀ jẹ́ ibi láti ìgbà èwe rẹ̀ wá, èmi kì yóò pa gbogbo ohun alààyè run mọ́ láé, bí mo ti ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.21",
            "verseOrgIds": [
              "GEN.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Níwọ́n ìgbà tí ayé bá sì wà,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "ìgbà ọ̀gbìn àti ìgbà ìkórè",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "ìgbà òtútù àti ìgbà ooru,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "ìgbà ẹ̀ẹ̀rùn àti ìgbà òjò,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "ìgbà ọ̀sán àti ìgbà òru,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "yóò wà títí láé.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    }
  ],
