              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni ọgọ́sàn-án ọdún ni Isaaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.28",
            "verseOrgIds": [
              "GEN.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaki sì kú láìpẹ́ lẹ́yìn ìpadàbọ̀ Jakọbu, a sì sin ín pẹ̀lú àwọn ènìyàn rẹ̀ ní ọjọ́ ogbó rẹ̀. Esau àti Jakọbu ọmọ rẹ̀ sì sin ín.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
            "verseOrgIds": [
              "GEN.35.29"
            ]
          }
        }
