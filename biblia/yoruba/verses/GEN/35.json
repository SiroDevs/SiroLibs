  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "GEN 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakọbu padà sí Beteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Ọlọ́run wí fún Jakọbu pé, \"Gòkè lọ sí Beteli kí o sì tẹ̀dó síbẹ̀, kí ó mọ pẹpẹ níbẹ̀ fún Ọlọ́run tó farahàn ọ́ nígbà tí o ń sálọ kúrò níwájú Esau arákùnrin rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, Jakọbu wí fún gbogbo ará ilé rẹ̀ pé, \"Ẹ mú gbogbo àjèjì òrìṣà tí ó wà lọ́dọ̀ yín kúrò, kí ẹ ya ara yín sí mímọ́, kí ẹ sì pààrọ̀ aṣọ yín.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.2",
            "verseOrgIds": [
              "GEN.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni kí ẹ wá, kí ẹ jẹ́ kí a lọ sí Beteli, níbi tí n ó ti mọ pẹpẹ fún Ọlọ́run, tí ó dá mi lóhùn ní ọjọ́ ìpọ́njú mi tí ó sì ti ń pẹ̀lú mi níbi gbogbo tí mo ń lọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.3",
            "verseOrgIds": [
              "GEN.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni wọ́n fún Jakọbu ní gbogbo àjèjì òrìṣà tí ó wà lọ́wọ́ wọn, àti yẹtí etí wọn, Jakọbu sì bo gbogbo wọn mọ́lẹ̀ sábẹ́ igi óákù ní Ṣekemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì bẹ̀rẹ̀ ìrìnàjò wọn. Ìbẹ̀rù Ọlọ́run sì ń bẹ lára gbogbo ìlú tí ó yí wọn ká, wọ́n kò sì lépa àwọn ọmọ Jakọbu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.5",
            "verseOrgIds": [
              "GEN.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu àti gbogbo àwọn tí ó wà pẹ̀lú rẹ̀ sì dé sí Lusi (ti o túmọ̀ sí Beteli) tí ó wà ní ilẹ̀ Kenaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni ó sì mọ pẹpẹ kan tí ó pè ní El-Beteli,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        },
        {
          "text": "nítorí níbẹ̀ ni Ọlọ́run ti gbé fi ara hàn án nígbà tí ó ń sálọ fún arákùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò pẹ́ lẹ́yìn èyí ni Debora, olùtọ́jú Rebeka kú, a sì sin ín sábẹ́ igi óákù ní ìsàlẹ̀ Beteli. Nítorí náà a sọ ọ́ ní Aloni-Bakuti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí Jakọbu padà dé láti Padani-Aramu, Ọlọ́run tún fi ara hàn án, ó sì súre fún un.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì wí fun un pé, \"Jakọbu ni orúkọ rẹ, a kì yóò pè ọ́ ní Jakọbu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        },
        {
          "text": "mọ́; bí kò ṣe Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        },
        {
          "text": "\" Nítorí náà, ó sọ orúkọ rẹ̀ ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì wí fún un pé, \"Èmi ni Ọlọ́run alágbára, El-Ṣaddai; máa bí sí i, kí o sì máa pọ̀ sí i. Orílẹ̀-èdè àti ọ̀pọ̀lọpọ̀ orílẹ̀-èdè ni yóò ti ọ̀dọ̀ rẹ̀ wá, àwọn ọba yóò sì jáde wá láti ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ilẹ̀ tí mo fi fún Abrahamu àti Isaaki ni èmi yóò fún ọ pẹ̀lú, àti fún àwọn ìran rẹ tí ó ń bọ̀ lẹ́yìn.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Ọlọ́run gòkè lọ kúrò ní ibi tí ó ti ń bá a sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
              "GEN.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì fi òkúta ṣe ọ̀wọ̀n kan sí ibi tí Ọlọ́run ti bá a sọ̀rọ̀, ó sì ta ọrẹ ohun mímu sí orí rẹ̀, ó sì da òróró olifi sí orí rẹ̀ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì pe orúkọ ibi tí Ọlọ́run ti bá a sọ̀rọ̀ ní Beteli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Rakeli àti Isaaki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n ń tẹ̀síwájú nínú ìrìnàjò wọn láti Beteli. Nígbà tí ó sì ku díẹ̀ kí wọn dé Efrata, Rakeli bẹ̀rẹ̀ sí ní rọbí, ó sì ní ìdààmú púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ti ń rọbí pẹ̀lú ìrora yìí, agbẹ̀bí wí fún un pé, \"Má bẹ̀rù nítorí ọmọkùnrin mìíràn ni ó ń bọ̀ yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí o sì ti fẹ́ gbé ẹ̀mí mi, torí pé ó ń kú lọ, ó pe ọmọ rẹ̀ náà ní Bene-Oni, ọmọ ìpọ́njú. Ṣùgbọ́n Jakọbu sọ ọmọ náà ní Benjamini, ọmọ oókan àyà mi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Rakeli kú, a sì sin ín sí ọ̀nà Efrata (ti o túmọ̀ sí, Bẹtilẹhẹmu).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì mọ ọ̀wọ́n kan sí ibojì rẹ̀, ọ̀wọ̀n náà sì tọ́ka sí ojú ibojì Rakeli títí di òní.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli sì ń bá ìrìnàjò rẹ̀ lọ, ó sì pa àgọ́ rẹ̀ sí Migida-Ederi, ilé ìṣọ́ Ederi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.21",
            "verseOrgIds": [
              "GEN.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Israẹli sì ń gbé ní ibẹ̀, Reubeni wọlé tọ Biliha, àlè baba rẹ̀ lọ, ó sì bá a lòpọ̀, Israẹli sì gbọ́ ọ̀rọ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 35:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 35:22"
      },
      "items": [
        {
          "text": "Jakọbu sì bí ọmọkùnrin méjìlá.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Lea,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:23"
      },
      "items": [
        {
          "text": "Reubeni tí í ṣe àkọ́bí Jakọbu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:23"
      },
      "items": [
        {
          "text": "Simeoni, Lefi, Juda, Isakari àti Sebuluni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
