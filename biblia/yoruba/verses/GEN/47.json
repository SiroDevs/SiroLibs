  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "GEN 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu lọ sọ fún Farao pé, \"Baba mi àti àwọn arákùnrin mi, pẹ̀lú agbo ẹran, agbo màlúù àti ohun gbogbo tí wọ́n ní, ti dé láti ilẹ̀ Kenaani, wọ́n sì ti wà ní ilẹ̀ Goṣeni báyìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó yan márùn-ún àwọn arákùnrin rẹ́, ó sì fi wọ́n han Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao béèrè lọ́wọ́ àwọn arákùnrin rẹ̀ pé, \"Kí ni iṣẹ́ yín?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 47:3"
      },
      "items": [
        {
          "text": "Wọ́n sì fèsì pé, \"Darandaran ni àwọn ìránṣẹ́ rẹ, gẹ́gẹ́ bí àwọn baba wa ti jẹ́ darandaran.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún sọ fun un síwájú sí i pé, \"A wá láti gbé ìhín yìí fún ìgbà díẹ̀ nítorí ìyàn náà mú púpọ̀ ní ilẹ̀ Kenaani, àwọn ohun ọ̀sìn àwa ìránṣẹ́ rẹ kò sì rí ewéko jẹ. Nítorí náà jọ̀wọ́ má ṣàì jẹ́ kí àwọn ìránṣẹ́ rẹ tẹ̀dó sí ilẹ̀ Goṣeni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.4",
            "verseOrgIds": [
              "GEN.47.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao wí fún Josẹfu pé, \"Baba rẹ àti àwọn arákùnrin rẹ tọ̀ ọ́ wá,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.5",
            "verseOrgIds": [
              "GEN.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilẹ̀ Ejibiti sì nìyí níwájú rẹ, mú àwọn arákùnrin rẹ tẹ̀dó sí ibi tí ó dára jù nínú ilẹ̀ náà. Jẹ́ kí wọn máa gbé ní Goṣeni. Bí o bá sì mọ ẹnikẹ́ni nínú wọn tí ó ní ẹ̀bùn ìtọ́jú ẹran, fi wọ́n ṣe olùtọ́jú ẹran ọ̀sìn mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Josẹfu mú Jakọbu baba rẹ̀ wọlé wá sí iwájú Farao. Lẹ́yìn ìgbà tí Jakọbu súre fún Farao tán.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.7",
            "verseOrgIds": [
              "GEN.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao béèrè lọ́wọ́ Jakọbu pé, \"Ọmọ ọdún mélòó ni ọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.8",
            "verseOrgIds": [
              "GEN.47.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì dá Farao lóhùn, \"Ọdún ìrìnàjò ayé mi jẹ́ àádóje, ọjọ́ mi kò pọ̀, ó sì kún fún wàhálà, síbẹ̀ kò ì tí ì tó ti àwọn baba mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.9",
            "verseOrgIds": [
              "GEN.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Jakọbu tún súre fún Farao, ó sì jáde lọ kúrò níwájú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.10",
            "verseOrgIds": [
              "GEN.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì fi baba rẹ̀ àti àwọn arákùnrin rẹ̀ sí ilẹ̀ Ejibiti, ó sì fún wọn ní ohun ìní ní ibi tí ó dára jù ní ilẹ̀ náà, ní agbègbè Ramesesi bí Farao ti pàṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.11",
            "verseOrgIds": [
              "GEN.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì pèsè oúnjẹ fún baba rẹ̀ àti àwọn arákùnrin rẹ̀ àti gbogbo ìdílé baba rẹ̀ gẹ́gẹ́ bi iye àwọn ọmọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.12",
            "verseOrgIds": [
              "GEN.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josẹfu àti ìyàn ní ilẹ̀ Ejibiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kò sí oúnjẹ ní gbogbo ilẹ̀ náà nítorí tí ìyàn náà mú púpọ̀ tó bẹ́ẹ̀ tí ilẹ̀ Ejibiti àti ilẹ̀ Kenaani gbẹ nítorí ìyàn náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.13",
            "verseOrgIds": [
              "GEN.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu gba gbogbo owó tí ó wà ní ilẹ̀ Ejibiti àti Kenaani ní ìpààrọ̀ fún ti ọkà tí wọn ń rà, ó sì mú owó náà wá sí ààfin Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.14",
            "verseOrgIds": [
              "GEN.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí owó wọn tán pátápátá ní Ejibiti àti Kenaani, gbogbo Ejibiti wá bá Josẹfu, wọ́n wí pé, \"Fún wa ní oúnjẹ, èéṣe tí a ó fi kú ní ojú rẹ? Gbogbo owó wa ni a ti ná tán.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.15",
            "verseOrgIds": [
              "GEN.47.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 47:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu wí pé, \"Ẹ mú àwọn ẹran ọ̀sìn yín wá, èmi yóò fún un yín ní oúnjẹ ní ìpààrọ̀ fún ẹran ọ̀sìn yín, níwọ̀n bí owó yín ti tan.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.16",
            "verseOrgIds": [
              "GEN.47.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 47:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà wọ́n mú àwọn ẹran ọ̀sìn wọn tọ Josẹfu wá, ó sì fún wọn ní oúnjẹ ní ìpààrọ̀ fún ẹṣin, àgùntàn, ewúrẹ́, màlúù àti kẹ́tẹ́kẹ́tẹ́ wọn. Ó sì mú wọn la ọdún náà já, tí ó ń fún wọn ní oúnjẹ ní ìpààrọ̀ fún ẹran ọ̀sìn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.17",
            "verseOrgIds": [
              "GEN.47.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 47:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọdún náà parí, wọn padà tọ̀ ọ́ wá ní ọdún tí ó tẹ̀lé, wọn wí pé, \"A kò le fi pamọ́ fun olúwa wa pé níwọ̀n bí owó wa ti tan tí gbogbo ẹran ọ̀sìn wa sì ti di tirẹ̀ pé, kò sí ohunkóhun tókù fún olúwa wa bí kò ṣe ara wa àti ilẹ̀ wa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.18",
            "verseOrgIds": [
              "GEN.47.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 47:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí àwa yóò fi parun lójú rẹ, ra àwa tìkára wa àti ilẹ̀ wa ní ìpààrọ̀ fún oúnjẹ, àwa àti ilẹ̀ wa yóò sì wà nínú ìgbèkùn Farao. Fún wa ni oúnjẹ kí àwa kí ó má ba à kú, kí ilẹ̀ wa má ba à di ahoro.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.19",
            "verseOrgIds": [
              "GEN.47.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 47:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Josẹfu ra gbogbo ilẹ̀ tí ó wà ní Ejibiti fún Farao, kò sí ẹnìkan tí ó ṣẹ́kù ní Ejibiti tí kò ta ilẹ̀ tirẹ̀ nítorí ìyàn náà mú jù fún wọn. Gbogbo ilẹ̀ náà sì di ti Farao,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.20",
            "verseOrgIds": [
              "GEN.47.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 47:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì sọ gbogbo ará Ejibiti di ẹrú láti igun kan dé èkejì.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.21",
            "verseOrgIds": [
              "GEN.47.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 47:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ṣá, kò ra ilẹ̀ àwọn àlùfáà, nítorí wọ́n ń gba ìpín oúnjẹ lọ́wọ́ Farao, wọn sì ní oúnjẹ tí ó tó láti inú ìpín tí Farao ń fún wọn. Ìdí nìyí tí wọn kò fi ta ilẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.22",
            "verseOrgIds": [
              "GEN.47.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 47:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu wí fún àwọn ènìyàn náà pé, \"Níwọ́n ìgbà tí mo ti ra ẹ̀yin àti ilẹ̀ yín tan lónìí fún Farao, irúgbìn rèé, ẹ lọ gbìn ín sí ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.23",
            "verseOrgIds": [
              "GEN.47.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 47:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí ìre oko náà bá jáde, ẹ ó mú ìdákan nínú ìdámárùn-ún rẹ̀ fún Farao. Ẹ le pa ìdámẹ́rin tókù mọ́ fún ara yín àti ìdílé yín àti àwọn ọmọ yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.24",
            "verseOrgIds": [
              "GEN.47.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 47:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dá á lóhùn pé, \"O ti gbà wá là, ǹjẹ́ kí a rí ojúrere níwájú olúwa wa, àwa yóò di ẹrú Farao.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Josẹfu sọ ọ́ di òfin nípa ọ̀rọ̀ ilẹ̀ ni Ejibiti, ó sì wà bẹ́ẹ̀ di òní olónìí pé, ìdákan nínú ìdámárùn-ún ìre oko jẹ́ ti Farao, ilẹ̀ àwọn àlùfáà nìkan ni kò di ti Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 47:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Israẹli sì tẹ̀dó sí Ejibiti ní agbègbè Goṣeni. Wọ́n ní ohun ìní fún ara wọn, wọ́n sì bí sí i tó bẹ́ẹ̀ tí wọ́n pọ̀ si gidigidi ní iye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 47:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu gbé ní Ejibiti fún ọdún mẹ́tàdínlógún iye ọdún ọjọ́ ayé rẹ̀ sì jẹ́ ẹẹ́tàdínlàádọ́jọ (147).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.28",
            "verseOrgIds": [
              "GEN.47.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 47:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àkókò ń súnmọ́ etílé fún Israẹli láti kú, ó pe Josẹfu, ọmọ rẹ̀, ó sì wí fún un pé, \"Bí mo bá rí ojúrere ni ojú rẹ̀ fi ọwọ́ rẹ sí abẹ́ itan mi, kí o sì ṣe ìlérí pé ìwọ yóò fi àánú àti òtítọ́ hàn sí mi. Má ṣe sin òkú mi sí ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, nígbà tí mo bá sinmi pẹ̀lú àwọn baba mi, gbé mí jáde kúrò ní Ejibiti kí o sì sin mí sí ibi tí wọ́n sin àwọn baba mi sí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 47:30"
      },
      "items": [
        {
          "text": "Josẹfu sì dáhùn wí pé, \"Èmi ó ṣe bí ìwọ ti wí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 47:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu wí pé, \"Búra fún mi,\" Josẹfu sì búra fún un. Israẹli sì tẹ orí rẹ̀ ba, bí ó ti sinmi lé orí ibùsùn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.31",
            "verseOrgIds": [
              "GEN.47.31"
            ]
          }
        }
      ]
    }
