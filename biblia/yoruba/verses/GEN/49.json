        },
        {
          "text": "Ìbùkún baba rẹ pọ̀ púpọ̀",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "ju ìbùkún àwọn òkè ńlá ìgbàanì,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "ju ẹ̀bùn ńlá àwọn òkè láéláé.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "Jẹ́ kí gbogbo èyí sọ̀kalẹ̀ sí orí Josẹfu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "lé ìpéǹpéjú ọmọ-aládé láàrín arákùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Benjamini jẹ́ ìkookò tí ó burú;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:27"
      },
      "items": [
        {
          "text": "ní òwúrọ̀ ni ó jẹ ẹran ọdẹ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:27"
      },
      "items": [
        {
          "text": "ní àṣálẹ́, ó pín ìkógun.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìwọ̀nyí ni àwọn ẹ̀yà Israẹli méjìlá, èyí sì ni ohun tí baba wọn sọ fún wọn nígbà tí ó súre fún wọn, tí ó sì fún ẹnìkọ̀ọ̀kan ní ìbùkún tí ó tọ́ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Jakọbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó fún wọn ní àwọn ìlànà yìí, \"Ọjọ́ ikú mi kù fẹ́ẹ́rẹ́. Kí ẹ sin mí sí ibojì pẹ̀lú àwọn baba mi ní inú àpáta ní ilẹ̀ Hiti ará Efroni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihò àpáta tí ó wà ní ilẹ̀ Makpela, nítòsí Mamre ní Kenaani, èyí tí Abrahamu rà gẹ́gẹ́ bí ilẹ̀ ìsìnkú lọ́wọ́ Efroni ará Hiti pẹ̀lú ilẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni a sin Abrahamu àti aya rẹ̀ Sara sí, níbẹ̀ ni a sin Isaaki àti Rebeka aya rẹ̀ sí, níbẹ̀ sì ni mo sìnkú Lea sí.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ náà àti ihò àpáta tí ó wà nínú rẹ̀ ni a rà lọ́wọ́ ará Hiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jakọbu ti pàṣẹ yìí fún àwọn ọmọ rẹ̀, ó gbé ẹsẹ̀ rẹ̀ sókè sórí ibùsùn, ó sì kú, a sì ko jọ pọ̀ mọ́ àwọn ènìyàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
          }
        }
      ]
    }
