  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "GEN 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hagari àti Iṣmaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarai, aya Abramu kò bímọ fún un, ṣùgbọ́n ó ní ọmọ ọ̀dọ̀ obìnrin ará Ejibiti kan tí ń jẹ́ Hagari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.1",
            "verseOrgIds": [
              "GEN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, Sarai wí fún Abramu pé, \"Kíyèsi i",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.2",
                "verseOrgIds": [
                  "GEN.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sé mi ní inú, èmi kò sì bímọ, wọlé tọ ọmọ ọ̀dọ̀ mi lọ, bóyá èmi yóò le ti ipasẹ̀ rẹ̀ ní ọmọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 16:2"
      },
      "items": [
        {
          "text": "Abramu sì gba ohun tí Sarai sọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ọdún mẹ́wàá tí Abramu ti ń gbé ni Kenaani ni Sarai mú ọmọbìnrin, ọmọ ọ̀dọ̀ rẹ Hagari, tí í ṣe ará Ejibiti fún Abramu ọkọ rẹ̀ láti fi ṣe aya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.3",
            "verseOrgIds": [
              "GEN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu sì bá Hagari lòpọ̀, ó sì lóyún.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 16:4"
      },
      "items": [
        {
          "text": "Nígbà tí ó sì ti mọ̀ pé òun lóyún, ó bẹ̀rẹ̀ sì ní kẹ́gàn ọ̀gá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Sarai wí fún Abramu pé, \"Ìwọ ni ó jẹ́ kí ẹ̀gbin yìí máa jẹ mí, mo fa ọmọ ọ̀dọ̀ mi lé ọ lọ́wọ́, nígbà tí ó sì rí i pé òun lóyún, mo di ẹni ẹ̀gàn ní ojú rẹ̀. Kí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.5",
                "verseOrgIds": [
                  "GEN.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó ṣe ìdájọ́ láàrín tèmi tìrẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramu dáhùn pé, \"Ìwọ ló ni ọmọ ọ̀dọ̀ rẹ, ṣe ohunkóhun tí ó bá tọ́ ní ojú rẹ sí i.\" Nígbà náà ni Sarai fi ìyà jẹ Hagari, ó sì sálọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.7",
                "verseOrgIds": [
                  "GEN.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì rí Hagari ní ẹ̀gbẹ́ ìsun omi ní ijù, ìsun omi tí ó wà ní ẹ̀gbẹ́ ọ̀nà tí ó lọ sí Ṣuri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Hagari, ìránṣẹ́ Sarai, níbo ni o ti ń bọ̀, níbo sì ni ìwọ ń lọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 16:8"
      },
      "items": [
        {
          "text": "Ó sì dáhùn pé, \"Mo ń sálọ kúrò lọ́dọ̀ ọ̀gá mi Sarai ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.9",
                "verseOrgIds": [
                  "GEN.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún un pé, \"Padà lọ sí ọ̀dọ̀ ọ̀gá rẹ kí o sì tẹríba fún un.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.10",
                "verseOrgIds": [
                  "GEN.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "náà sì fi kún fún un pé, \"Èmi yóò sọ ọ́ di orílẹ̀-èdè ńlá, ìran rẹ kì yóò sì lóǹkà.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.11",
                "verseOrgIds": [
                  "GEN.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "náà sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "\"Ìwọ ti lóyún,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "ìwọ yóò sì bí ọmọkùnrin kan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "Ìwọ yóò sì pe orúkọ rẹ̀ ní Iṣmaeli,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.11",
                "verseOrgIds": [
                  "GEN.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ti rí ìpọ́njú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò jẹ́ oníjàgídíjàgan ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "ọwọ́ rẹ̀ yóò wà lára ènìyàn gbogbo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "ọwọ́ ènìyàn gbogbo yóò sì wà lára rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "yóò sì máa gbé ní ìkanra",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "pẹ̀lú àwọn arákùnrin rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì pe orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.13",
                "verseOrgIds": [
                  "GEN.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "tí o bá sọ̀rọ̀ ní, \"Ìwọ ni Ọlọ́run tí ó rí mi,\" nítorí tí ó wí pé, \"Mo ti ri ẹni tí ó rí mi báyìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni a ṣe ń pe kànga náà ní Beeri-Lahai-Roi; kànga ẹni alààyè tí ó rí mi. Ó wà ní agbede-méjì Kadeṣi àti Beredi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hagari sì bí ọmọkùnrin kan fún Abramu, Abramu sì pe orúkọ rẹ̀ ní Iṣmaeli.",
          "type": "text",
          "attrs": {
