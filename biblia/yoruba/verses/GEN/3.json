  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "GEN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìṣubú ènìyàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejò sá à ṣe alárékérekè ju àwọn ẹranko igbó yòókù tí",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.1",
                "verseOrgIds": [
                  "GEN.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run dá lọ. Ó sọ fún obìnrin náà pé, \"Ǹjẹ́ òtítọ́ ha ni Ọlọ́run wí pé, 'Ẹ̀yin kò gbọdọ̀ jẹ èso èyíkéyìí lára àwọn igi tí ó wà nínú ọgbà'?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obìnrin náà dá ejò lóhùn pé, \"Àwa lè jẹ lára àwọn èso igi tí ó wà nínú ọgbà,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n Ọlọ́run sọ pé, 'Ẹ̀yin kò gbọdọ̀ jẹ lára èso igi tí ó wà láàrín ọgbà, ẹ kò sì gbọdọ̀ fi ọwọ́ kàn án, bí ẹ̀yin bá ṣe bẹ́ẹ̀, ẹ̀yin yóò kùú.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejò wí fún obìnrin náà pé, \"Ẹ̀yin kì yóò kú ikúkíkú kan.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí Ọlọ́run mọ̀ wí pé, bí ẹ̀yin bá jẹ nínú rẹ̀, ojú yín yóò là, ẹ̀yin yóò sì dàbí Ọlọ́run, ẹ̀yin yóò sì mọ rere yàtọ̀ sí búburú.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí obìnrin náà rí i wí pé èso igi náà dára fún oúnjẹ àti pé, ó sì dùn ún wò, àti pé ó ń mú ni ní ọgbọ́n, ó mú díẹ̀ níbẹ̀, ó sì jẹ ẹ́. Ó sì mú díẹ̀ fún ọkọ rẹ̀, ẹni tí ó wà pẹ̀lú rẹ̀, òun náà sì jẹ ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ojú àwọn méjèèjì sì là, wọ́n sì mọ̀ pé àwọn wà ní ìhòhò; wọ́n sì rán ewé ọ̀pọ̀tọ́ pọ̀, wọ́n sì fi bo ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọkùnrin náà àti aya rẹ̀ gbọ́ ìró",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.8",
                "verseOrgIds": [
                  "GEN.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run bí ó ti ń rìn nínú ọgbà, nígbà tí ojú ọjọ́ tura, wọ́n sì fi ara pamọ́ kúrò níwájú",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.8",
                "verseOrgIds": [
                  "GEN.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run sí àárín àwọn igi inú ọgbà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.9",
                "verseOrgIds": [
                  "GEN.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run ké pe ọkùnrin náà pé, \"Níbo ni ìwọ wà?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dáhùn pé, \"Mo gbúròó rẹ̀ nínú ọgbà, ẹ̀rù sì bà mí, nítorí pé, mo wà ní ìhòhò, mo sì fi ara pamọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run wí pé, \"Ta ni ó wí fún ọ pé ìhòhò ni ìwọ wà? Ṣé ìwọ ti jẹ nínú èso igi tí mo pàṣẹ fún ọ pé ìwọ kò gbọdọ̀ jẹ nínú rẹ̀ ni?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà wí pé, \"Obìnrin tí ìwọ fi fún mi, ni ó fún mi nínú èso igi náà, mo sì jẹ ẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
              "GEN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.13",
                "verseOrgIds": [
                  "GEN.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wí pé, \"Èwo ni èyí tí ìwọ ṣe yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 3:13"
      },
      "items": [
        {
          "text": "Obìnrin náà dáhùn pé, \"Ejò ni ó tàn mí jẹ, mo sì jẹ ẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.14",
                "verseOrgIds": [
                  "GEN.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wí fún ejò náà pé, \"Nítorí tí ìwọ ti ṣe èyí,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "\"Ègún ni fún ọ ju gbogbo ohun ọ̀sìn",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "àti gbogbo ẹranko igbó tókù lọ!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "Àyà rẹ ni ìwọ yóò fi máa wọ́,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "ìwọ yóò sì máa jẹ erùpẹ̀ ilẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:14"
      },
      "items": [
        {
          "text": "ní gbogbo ọjọ́ ayé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì fi ọ̀tá",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "sí àárín ìwọ àti obìnrin náà,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "àti sí àárín irú-ọmọ rẹ àti irú-ọmọ obìnrin náà;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "òun yóò fọ́ orí rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:15"
      },
      "items": [
        {
          "text": "ìwọ yóò sì bù ú jẹ ní gìgísẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run wí fún obìnrin náà pé,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "\"Èmi yóò fi kún ìrora rẹ ní àkókò ìbímọ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "ni ìrora ni ìwọ yóò máa bí ọmọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "Ọ̀dọ̀ ọkọ rẹ ni ìfẹ́ rẹ yóò máa fà sí,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:16"
      },
      "items": [
        {
          "text": "òun ni yóò sì máa ṣe àkóso rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run sì wí fún Adamu pé, \"Nítorí pé ìwọ fetí sí aya rẹ, ìwọ sì jẹ nínú èso igi tí mo pàṣẹ fún ọ pé, 'Ìwọ kò gbọdọ̀ jẹ nínú rẹ̀,'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:17"
      },
      "items": [
        {
          "text": "\"Ègún ni fún ilẹ̀ nítorí rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:17"
      },
      "items": [
        {
          "text": "nínú ọ̀pọ̀ làálàá ni ìwọ yóò jẹ nínú rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:17"
      },
      "items": [
        {
          "text": "ní gbogbo ọjọ́ ayé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ yóò sì hu ẹ̀gún àti èṣùṣú fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.18",
            "verseOrgIds": [
              "GEN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:18"
      },
      "items": [
        {
          "text": "ewéko igbó ni ìwọ yóò sì máa jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.18",
            "verseOrgIds": [
              "GEN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú òógùn ojú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:19"
      },
      "items": [
        {
          "text": "ni ìwọ yóò máa jẹun",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:19"
      },
      "items": [
        {
          "text": "títí tí ìwọ yóò fi padà sí ilẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:19"
      },
      "items": [
        {
          "text": "nítorí inú ilẹ̀ ni a ti mú ọ jáde wá;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 3:19"
      },
      "items": [
        {
          "text": "erùpẹ̀ ilẹ̀ sá à ni ìwọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 3:19"
      },
      "items": [
        {
          "text": "ìwọ yóò sì padà di erùpẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu sì sọ aya rẹ̀ ní Efa nítorí òun ni yóò di ìyá gbogbo alààyè.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.21",
                "verseOrgIds": [
                  "GEN.3.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run, sì dá ẹ̀wù awọ fún Adamu àti aya rẹ̀, ó sì fi wọ̀ wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.22",
                "verseOrgIds": [
                  "GEN.3.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run sì wí pé, \"Ọkùnrin náà ti dàbí ọ̀kan lára wa, ó mọ rere àti búburú. A kò gbọdọ̀ jẹ́ kí ó na ọwọ́ rẹ̀ kí ó mú lára èso igi ìyè kí ó sì jẹ, kí ó sì wà láààyè títí láéláé.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "GEN.3.23",
                "verseOrgIds": [
                  "GEN.3.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run lé e kúrò nínú ọgbà Edeni láti lọ máa ro ilẹ̀ nínú èyí tí a ti mú un jáde wá.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí ó ti lé ènìyàn jáde tán, ó fi àwọn kérúbù àti idà iná tí ó ń kọ mọ̀nàmọ́ná síwájú àti sẹ́yìn láti ṣọ́ ọ̀nà tí ó lọ sí ibi igi ìyè, ní ìhà ìlà-oòrùn ọgbà Edeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        }
      ]
    }
