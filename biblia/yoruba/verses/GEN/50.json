  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "GEN 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì ṣubú lé baba rẹ̀, ó sọkún, ó sì fẹnukò ó ní ẹnu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Josẹfu pàṣẹ fún àwọn oníṣègùn tí ó wà ní ìkáwọ́ rẹ̀ pé kí wọn kí ó ṣe òkú Israẹli baba rẹ̀ lọ́jọ̀, àwọn oníṣègùn náà sì ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fún ogójì ọjọ́ ni wọ́n fi ṣe èyí, nítorí èyí ni àsìkò tí a máa ń fi ṣe ẹ̀ǹbáàmù òkú. Àwọn ará Ejibiti sì ṣọ̀fọ̀ rẹ̀ fún àádọ́rin ọjọ́.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọjọ́ ìṣọ̀fọ̀ náà kọjá. Josẹfu wí fún àwọn ará ilé Farao pé, \"Bí mo bá bá ojúrere yín pàdé, ẹ bá mi sọ fún Farao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Baba mi mú mi búra ó sì wí fún mi pé, \"Mo ti fẹ́rẹ kú: sinmi sínú ibojì tí mo gbẹ́ fún ara mi ní ilẹ̀ Kenaani.\" Nísinsin yìí, jẹ́ kí n lọ kí n sì sìnkú baba mi, lẹ́yìn náà èmi yóò padà wa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao wí pé, \"Gòkè lọ, kí o sì sin baba rẹ, bí ó tí mú ọ búra.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni Josẹfu gòkè lọ láti sìnkú baba rẹ̀. Gbogbo àwọn ìjòyè Farao ni ó sìn ín lọ—àwọn àgbàgbà ilé rẹ̀, àti gbogbo àwọn àgbàgbà ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yàtọ̀ fún gbogbo àwọn ará ilé Josẹfu àti ti àwọn arákùnrin rẹ̀ àti àwọn tí ó jẹ́ ilé baba rẹ̀, àwọn ọmọ wọn nìkan àti agbo ẹran pẹ̀lú agbo màlúù ni ó sẹ́ kù ní Goṣeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kẹ̀kẹ́-ẹṣin àti àwọn ẹlẹ́ṣin pẹ̀lú gòkè lọ. Àìmoye ènìyàn ni ó lọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n dé ilẹ̀ ìpakà Atadi, ní ẹ̀bá Jordani, wọn pohùnréré ẹkún, níbẹ̀ ni Josẹfu sì tún dúró ṣọ̀fọ̀ baba rẹ̀ fún ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ará Kenaani tí ń gbé níbẹ̀ rí i bí wọ́n ti ń ṣọ̀fọ̀ náà ni ilẹ̀ ìpakà Atadi, wọ́n wí pé, \"Ọ̀fọ̀ ńlá ni àwọn ará Ejibiti ń ṣe yìí.\" Ìdí èyí ni a fi ń pe ibẹ̀ ní Abeli-Misraimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "text": "Kò sì jìnnà sí Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni àwọn ọmọ Jakọbu ṣe ohun tí baba wọn pàṣẹ fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gbé e lọ sí ilẹ̀ Kenaani, wọ́n sì sin ín sínú ihò àpáta tí ó wà ní oko Makpela, ní tòsí i Mamre tí Abrahamu rà gẹ́gẹ́ bí ilẹ̀ ìsìnkú lọ́wọ́ Efroni ará Hiti, pẹ̀lú ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí ó ti sìnkú baba rẹ̀ tan, Josẹfu padà sí Ejibiti pẹ̀lú àwọn arákùnrin rẹ̀ àti àwọn mìíràn tí ó tẹ̀lé e lọ láti sin baba rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josẹfu fi ọkàn àwọn arákùnrin rẹ̀ balẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn arákùnrin Josẹfu rí i pé baba wọn kú, wọ́n wí fún ara wọn pé, \"Ǹjẹ́ bí ó bá ṣe pé Josẹfu ṣì fi wá sínú ń kọ́, tí ó sì fẹ́ gbẹ̀san gbogbo aburú tí a ti ṣe sí i?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.15",
            "verseOrgIds": [
              "GEN.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà wọ́n ránṣẹ́ sí Josẹfu wí pé, \"Baba rẹ fi àṣẹ yìí sílẹ̀ kí ó tó lọ wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.16",
            "verseOrgIds": [
              "GEN.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Èyí ni kí ẹ̀yin kí ó sọ fún Josẹfu, mo bẹ̀ ọ́ kí o dáríjì àwọn arákùnrin rẹ, gbogbo ẹ̀ṣẹ̀ àti aburú tí wọ́n ṣe sí ọ, èyí tí ó mú ibi bá ọ'. Nísinsin yìí, jọ̀wọ́ dárí ẹ̀ṣẹ̀ àwọn ìránṣẹ́ Ọlọ́run baba rẹ jì wọ́n.\" Nígbà tí iṣẹ́ ti wọ́n rán dé ọ̀dọ̀ rẹ̀, Josẹfu sọkún.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn arákùnrin rẹ̀ wá, wọ́n sì wólẹ̀ níwájú rẹ̀, wọ́n wí pé, \"Ẹrú rẹ ni a jẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Josẹfu wí fún wọn pé, \"Ẹ má ṣe bẹ̀rù, èmi ha wà ní ipò Ọlọ́run bí?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.19",
            "verseOrgIds": [
              "GEN.50.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó tilẹ̀ jẹ́ pé ẹ gbèrò láti ṣe mi ní ibi, ṣùgbọ́n Ọlọ́run gbèrò láti fi ṣe rere tí ń ṣe lọ́wọ́ yìí; ni gbígba ẹ̀mí ọ̀pọ̀lọpọ̀ ènìyàn là.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.20",
            "verseOrgIds": [
              "GEN.50.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, ẹ má ṣe bẹ̀rù. Èmi yóò pèsè fún ẹ̀yin àti àwọn ọmọ yín.\" Ó tún fi wọ́n lọ́kàn balẹ̀, ó sì sọ ọ̀rọ̀ rere fun wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikú Josẹfu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì ń gbé ní Ejibiti pẹ̀lú gbogbo ìdílé baba rẹ̀. Ó sì wà láààyè fún àádọ́fà ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.22",
            "verseOrgIds": [
              "GEN.50.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì rí ìran kẹta ọmọ Efraimu-Àwọn ọmọ Makiri, ọmọkùnrin Manase ni a sì gbé le eékún Josẹfu nígbà tí ó bí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.23",
            "verseOrgIds": [
              "GEN.50.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 50:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Josẹfu wí fún àwọn arákùnrin rẹ̀ pé, \"Mo ti fẹ́rẹ kú, ṣùgbọ́n dájúdájú Ọlọ́run yóò wá sí ìrànlọ́wọ́ yín, yóò sì mú un yín jáde kúrò ní ilẹ̀ yìí lọ sí ilẹ̀ tí ó ti ṣèlérí ní ìbúra fún Abrahamu, Isaaki àti Jakọbu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 50:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josẹfu sì mú kí àwọn ọmọ Israẹli búra májẹ̀mú kan wí pé, \"Dájúdájú Ọlọ́run yóò wá sí ìrànlọ́wọ́ yín, nígbà náà ni ẹ gbọdọ̀ kó egungun mi lọ́wọ́ kúrò ní ìhín.\"",
