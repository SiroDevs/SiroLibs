  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "GEN 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakọbu àti Esau pàdé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì gbójú sókè, ó sì rí Esau àti irinwó (400) ọkùnrin tí wọ́n ń bọ̀, ó sì pín àwọn ọmọ fún Lea, Rakeli àti àwọn ìránṣẹ́bìnrin méjèèjì.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ti àwọn ìránṣẹ́bìnrin àti àwọn ọmọ wọn síwájú, Lea àti àwọn ọmọ rẹ̀ sì jẹ ọ̀wọ́ kejì tí ó tẹ̀lé wọn, Rakeli àti Josẹfu sì wà lẹ́yìn pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu fúnra rẹ̀ wa lọ síwájú pátápátá, ó sì tẹríba ní ìgbà méje bí ó ti ń súnmọ́ Esau, arákùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Esau sáré pàdé Jakọbu, ó sì dì mọ́ ọn, ó rọ̀ mọ́ ọn lọ́rùn, ó sì fẹnukò ó lẹ́nu. Àwọn méjèèjì sì sọkún.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Esau sì ṣe àkíyèsí àwọn ìyàwó àti ọmọ Jakọbu, ó béèrè lọ́wọ́ Jakọbu pé, \"Ti ta ni àwọn wọ̀nyí?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:5"
      },
      "items": [
        {
          "text": "Jakọbu sì fèsì wí pé, \"Èyí ni àwọn ọmọ tí Ọlọ́run nínú àánú rẹ̀ ti fi fún ìránṣẹ́ rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ìránṣẹ́bìnrin àti àwọn ọmọ wọn súnmọ́ tòsí, wọ́n sì tẹríba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà ni Lea àti àwọn ọmọ rẹ̀ pẹ̀lú dé, wọ́n sì tún tẹríba. Ní ìkẹyìn ni Josẹfu àti Rakeli dé, wọ́n sì tún tẹríba pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau sì béèrè pé, \"Kí ni èrò rẹ tí o fi to àwọn ọ̀wọ̀ọ̀wọ́ tí mo pàdé wọ̀nyí?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:8"
      },
      "items": [
        {
          "text": "Jakọbu dáhùn pé, \"Kí n ba le rí ojúrere rẹ ni olúwa mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Esau wí pé, \"Tèmi ti tó mi, pa èyí tí o ní mọ́ fún ara rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu bẹ̀ ẹ́ wí pé, \"Rárá bẹ́ẹ̀ kọ́, bí ó bá ṣe pé, mo rí ojúrere rẹ, jọ̀wọ́ gba ọrẹ lọ́wọ́ mi. Bí mo ṣe rí ojú rẹ̀ yìí, ó dàbí wí pé mo rí ojú Ọlọ́run ni báyìí, tí inú rẹ̀ ti dùn sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.10",
            "verseOrgIds": [
              "GEN.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jọ̀wọ́ gba àwọn ohun tí mo mú wá wọ̀nyí lọ́wọ́ mi. Nítorí Ọlọ́run ti fi oore-ọ̀fẹ́ rẹ̀ hàn sí mi, gbogbo ohun tí mo fẹ́ sì ni mo ní.\" Nígbà tí Jakọbu sì rọ̀ ọ́ pé Esau gbọdọ̀ gbà wọ́n, Esau sì gbà á.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Esau wí pé, \"Jẹ́ kí a máa lọ, n ó sìn ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jakọbu wí fún un pé, \"Ṣe ìwọ náà ṣe àkíyèsí pé ọ̀pọ̀ nínú àwọn ọmọ wọ̀nyí kéré, àwọn màlúù àti àgùntàn pẹ̀lú sì ní àwọn ọmọ kéékèèké. Bí a bá dà wọ́n rìn jìnnà ju bí agbára wọn ṣe mọ lọ, wọ́n lè kú.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi bẹ̀ ọ́, máa lọ síwájú ìránṣẹ́ rẹ, àwọn ó sì máa rọra bọ̀, títí èmi àti àwọn ọmọ yóò fi dé ọ̀dọ̀ olúwa mi ní Seiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau wí pé, \"Jẹ́ kí n fi díẹ̀ sílẹ̀ fún ọ nínú àwọn ọkùnrin mi nígbà náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 33:15"
      },
      "items": [
        {
          "text": "Jakọbu wí pé, \"Èéṣe, àní kí n sá à rí ojúrere olúwa mi?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà gan an ni Esau padà lọ sí Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakọbu sì lọ sí Sukkoti, ó sì kọ́ ilé fún ara rẹ̀, ó sì ṣe ọgbà fún àwọn ẹran. Ìdí èyí ní a fi ń pe ibẹ̀ ní Sukkoti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí Jakọbu tí Padani-Aramu dé, àlàáfíà ni Jakọbu dé ìlú Ṣekemu ní ilẹ̀ Kenaani, ó sì pàgọ́ sí itòsí ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.18",
            "verseOrgIds": [
              "GEN.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ra ilẹ̀ kan tí ó pàgọ́ sí ni ọgọ́rùn-ún owó fàdákà lọ́wọ́ àwọn ọmọ Hamori tí í ṣe baba Ṣekemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.19",
            "verseOrgIds": [
              "GEN.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni ó gbé tẹ́ pẹpẹ kan tí ó pè ní El Elohe Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.20",
            "verseOrgIds": [
              "GEN.33.20"
            ]
          }
        }
      ]
    }
  ],
