  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EST 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn Júù yọ ayọ̀ ìṣẹ́gun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹtàlá oṣù kejìlá, oṣù Addari, tí ó yẹ kí a mú àṣẹ tí ọba pa wá sí ìmúṣẹ. Ní ọjọ́ yìí ni ọ̀tá àwọn Júù rò pé àwọn yóò borí i wọn, ṣùgbọ́n nísinsin yìí a ti yìí padà, àwọn Júù sì na ọwọ́ agbára tó ga lórí àwọn tí ó kórìíra wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Júù péjọ ní àwọn ìlú u wọn ní gbogbo agbègbè ọba Ahaswerusi láti kọlu àwọn tó ń wá ìparun wọn. Kò sí ẹnikẹ́ni tí ó lè dojúkọ wọ́n, nítorí gbogbo àwọn ènìyàn ìlú tókù ń bẹ̀rù u wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọlọ́lá ìgbèríko, àwọn alákòóso, àwọn baálẹ̀ àti àwọn onídàájọ́ ọba ran àwọn Júù lọ́wọ́, nítorí wọ́n bẹ̀rù u Mordekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekai sì jẹ́ ẹni pàtàkì ní ààfin ọba, òkìkí rẹ̀ sì tàn jákèjádò àwọn ìgbèríko, ó sì ní agbára kún agbára.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Júù sì gé gbogbo àwọn ọ̀tá a wọn lulẹ̀ pẹ̀lú idà, wọ́n pa wọ́n, wọ́n sì run wọ́n, wọ́n sì ṣe ohun tí ó wù wọ́n sí àwọn tí ó kórìíra wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ilé ìṣọ́ ti Susa, àwọn Júù pa ẹ̀ẹ́dẹ́gbẹ̀ta (500) ọkùnrin run.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tún pa Parṣandata, Dalfoni, Aspata,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7",
            "verseOrgIds": [
              "EST.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porata, Adalia, Aridata,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.8",
            "verseOrgIds": [
              "EST.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parmaṣta, Arisai, Aridai àti Faisata.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.9",
            "verseOrgIds": [
              "EST.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọkùnrin mẹ́wẹ̀ẹ̀wá tí wọ́n jẹ́ ọmọ Hamani, ọmọ Hammedata, ọ̀tá àwọn Júù. Ṣùgbọ́n wọn kò fi ọwọ́ wọn lé ìkógun un wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ náà gan an ni a mú iye àwọn tí a pa ní ilé ìṣọ́ ti Susa wá fún ọba.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọba sì sọ fún Esteri ayaba pé, \"Àwọn Júù ti pa ẹ̀ẹ́dẹ́gbẹ̀ta (500) ọkùnrin àti àwọn ọmọkùnrin mẹ́wẹ̀ẹ̀wá tí i ṣe ọmọ Hamani ní ilé ìṣọ́ Susa run. Kí ni wọ́n ṣe ní gbogbo ìgbèríko ọba tókù? Báyìí kí ni ẹ̀bẹ̀ rẹ? A ó fi fún ọ. Kí ni ìbéèrè rẹ? A ó sì tún fi fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esteri sì dáhùn pé, \"Bí ó bá tẹ́ ọba lọ́rùn, fún àwọn Júù tí ó wà ní Susa ní àṣẹ láti ṣe gẹ́gẹ́ bí wọ́n ti ṣe ní òní kí wọn ṣe bákan náà ní ọ̀la, kí a sì so àwọn ọmọkùnrin Hamani mẹ́wẹ̀ẹ̀wá náà rọ̀ sórí igi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ọba pàṣẹ pé kí a ṣe bẹ́ẹ̀. A sì gbé àṣẹ kan jáde ní Susa, wọ́n sì so àwọn ọmọkùnrin mẹ́wẹ̀ẹ̀wá Hamani kọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Júù tí ó wà ní Susa sì péjọ ní ọjọ́ kẹrìnlá oṣù Addari, wọ́n sì pa ọ̀ọ́dúnrún (300) ọkùnrin ní Susa, ṣùgbọ́n wọn kò fi ọwọ́ wọn lé ìkógun un wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lákokò yìí, àwọn tókù nínú àwọn Júù tí wọ́n wà ní agbègbè ọba náà tún kó ara wọn jọ láti dáàbò bo ara wọn kí wọn sì sinmi lọ́wọ́ àwọn ọ̀tá a wọn. Wọ́n sì pa ẹgbàá mẹ́tàdínlógójì ó lé ẹgbẹ̀rin (75,000) àwọn tí ó kórìíra wọn ṣùgbọ́n wọn kò fi ọwọ́ wọn lé ìkógun un wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ṣẹlẹ̀ ní ọjọ́ kẹtàlá oṣù Addari, wọ́n sì sinmi ní ọjọ́ kẹrìnlá, wọ́n sì ṣe ọjọ́ náà ní ọjọ́ àsè àti ayọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjọyọ̀ Purimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn Júù tí ó wà ní Susa, kó ara wọn jọ ní ọjọ́ kẹtàlá àti ọjọ́ kẹrìnlá, nígbà tí ó sì di ọjọ́ kẹ́ẹ̀dógún wọ́n sinmi wọ́n sì ṣe ọjọ́ náà ní ọjọ́ àsè àti ayọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni àwọn Júù tí wọ́n ń gbé ní ìletò ṣe pa ọjọ́ kẹrìnlá oṣù Addari mọ́ gẹ́gẹ́ bí ọjọ́ ayọ̀ àti ọjọ́ àsè, ọjọ́ tí wọ́n ń fún ara wọn ní ẹ̀bùn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekai ṣe àkọsílẹ̀ àwọn ìṣẹ̀lẹ̀ wọ̀nyí, ó sì kọ ìwé ránṣẹ́ sí gbogbo àwọn Júù jákèjádò àgbáyé ọba Ahaswerusi, tí ó wà ní tòsí àti àwọn tí ó wà ní jìnnà réré,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti lè máa ṣe àjọyọ̀ ní ọjọ́ kẹrìnlá àti ọjọ́ kẹ́ẹ̀dógún oṣù Addari ní ọdọọdún.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí àkókò tí àwọn Júù gba ìsinmi kúrò lọ́wọ́ àwọn ọ̀tá a wọn, àti bí oṣù tí ìbànújẹ́ ẹ wọn yí padà di ayọ̀ àti tí ọjọ́ ọ̀fọ̀ wọn di ọjọ́ àjọyọ̀. Ó kọ ọ́ sí wọn láti máa pa ọjọ́ náà mọ́ gẹ́gẹ́ bí ọjọ́ àsè àti ọjọ́ ayọ̀ kí wọn sì máa fi oúnjẹ fún ara wọn, kí wọn sì máa fi ẹ̀bùn fún àwọn aláìní.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn Júù gbà láti máa ṣe àjọyọ̀ tí wọ́n ti bẹ̀rẹ̀, wọ́n ń ṣe bí Mordekai ti kọ̀wé sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Hamani ọmọ Hammedata, ará Agagi, ọ̀tá gbogbo àwọn Júù, ti gbèrò sí àwọn Júù láti pa wọ́n run, ó sì ti di",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "puri",
              "type": "text",
              "attrs": {
                "verseId": "EST.9.24",
                "verseOrgIds": [
                  "EST.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "(èyí tí í ṣe ìbò) fún ìsọdahoro àti ìparun wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí Esteri sọ nípa ìṣọ̀tẹ̀ náà fún ọba, ó kọ̀wé àṣẹ kan jáde pé kí ète búburú tí Hamani ti pa sí àwọn Júù kí ó padà sí orí òun fúnra rẹ̀, àti pé kí a gbé òun àti àwọn ọmọkùnrin rẹ̀ kọ́ sórí igi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nítorí náà a pe àwọn ọjọ́ wọ̀nyí ní Purimu, láti ara ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "puri",
              "type": "text",
              "attrs": {
                "verseId": "EST.9.26",
                "verseOrgIds": [
                  "EST.9.26"
                ]
              }
            }
          ]
        },
        {
          "text": "). Nítorí ohun gbogbo tí a kọ sínú ìwé yìí àti nítorí ohun tí wọ́n ti rí àti ohun tí ó ti ṣẹlẹ̀ sí wọn,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn Júù fi lélẹ̀, wọ́n sì gbà á gẹ́gẹ́ bí ìlànà fún ara wọn àti fún irú àwọn ọmọ wọn àti gbogbo àwọn tí ó darapọ̀ mọ́ wọn, kò sì ní kúrò, wọn yóò sì máa pa àwọn ọjọ́ méjèèjì yìí mọ́ ní gbogbo ọdún, gẹ́gẹ́ bí a ti kọ ọ́ àti àkókò tí a yàn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbọdọ̀ máa ṣe ìrántí àwọn ọjọ́ wọ̀nyí kí a sì máa pa wọ́n mọ́ ní ìrandíran ní gbogbo ìdílé, àti ní gbogbo ìgbèríko àti ní gbogbo ìlú. A gbọdọ̀ máa ṣe àwọn ọjọ́ Purimu wọ̀nyí ní àárín àwọn Júù, bẹ́ẹ̀ ni kò gbọdọ̀ di ohun ìgbàgbé láàrín irú àwọn ọmọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Esteri ayaba, ọmọbìnrin Abihaili, pẹ̀lú Mordekai ará a Júù, kọ̀wé pẹ̀lú àṣẹ láti fi ìdí ìwé kejì nípa Purimu yìí múlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekai sì kọ ìwé ránṣẹ́ sí gbogbo àwọn Júù, sí ìgbèríko mẹ́tàdínláàádóje (127) ní ilẹ̀ ọba Ahaswerusi ní ọ̀rọ̀ àlàáfíà àti òtítọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti fi ìdí àwọn ọjọ́ ọ Purimu yìí múlẹ̀ ní àkókò tí wọ́n yàn, gẹ́gẹ́ bí Mordekai ará Juda, àti Esteri ayaba ti pa á láṣẹ fún wọn, àti bí wọ́n ṣe fi lélẹ̀ fún ara wọn àti irú àwọn ọmọ wọn ní ìbámu pẹ̀lú àkókò àwẹ̀ àti ẹkún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àṣẹ Esteri sì fi ìdí ìlànà Purimu wọ̀nyí múlẹ̀, a sì kọ ọ́ sínú ìwé àkọsílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
        }
      ]
    }
