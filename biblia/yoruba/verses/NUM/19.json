        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omi Ìwẹ̀nùmọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.1",
                "verseOrgIds": [
                  "NUM.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose àti Aaroni pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.1",
            "verseOrgIds": [
              "NUM.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí òfin",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.2",
                "verseOrgIds": [
                  "NUM.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ béèrè lọ́wọ́ yín. Sọ fún àwọn ọmọ Israẹli, kí wọn mú ẹgbọrọ ọ̀dọ́ màlúù pupa tí kò lábùkù tàbí àbàwọ́n, lára èyí tí a kò tí ì di àjàgà mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ mú fún Eleasari àlùfáà, yóò sì mu jáde lọ sí ẹ̀yìn ibùdó kí ó sì pa á ní ojú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Eleasari àlùfáà yóò mú lára ẹ̀jẹ̀ rẹ̀ sórí ìka ọwọ́ rẹ̀ yóò sì wọn lẹ́ẹ̀méje ní ọ̀kánkán iwájú àgọ́ ìpàdé.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ojú rẹ̀ ni àlùfáà yóò ti sun ọ̀dọ́ abo màlúù yìí: awọ ara rẹ̀, ẹ̀jẹ̀ rẹ̀, ẹran-ara àti ìgbẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àlùfáà yóò mú igi kedari, hísópù àti òwú òdòdó yóò sì jù wọ́n sí àárín ọ̀dọ́ abo màlúù tí a ń sun.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà, àlùfáà gbọdọ̀ fọ aṣọ rẹ̀, kí ó sì wẹ ara rẹ̀ pẹ̀lú omi lẹ́yìn náà ó lè wá sínú àgọ́. Ṣùgbọ́n yóò jẹ́ aláìmọ́ títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó sun ún náà gbọdọ̀ fọ aṣọ rẹ̀ kí ó sì wẹ̀ pẹ̀lú omi, òun náà yóò jẹ́ aláìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹni tó wà ní mímọ́ ni yóò kó eérú ọ̀dọ́ màlúù náà lọ sí ibi tí a yà sí mímọ́ lẹ́yìn ibùdó. Kí gbogbo ìjọ ènìyàn Israẹli kó o pamọ́ fún lílò fún omi ìwẹ̀nùmọ́. Ó jẹ́ ìwẹ̀nùmọ́ kúrò nínú ẹ̀ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin tí ó kó eérú ọ̀dọ́ abo màlúù náà gbọdọ̀ fọ aṣọ rẹ̀, òun náà yóò sì jẹ́ aláìmọ́ títí ìrọ̀lẹ́. Èyí ni yóò jẹ́ ìlànà láéláé fún àwọn ọmọ Israẹli àti fún àwọn àjèjì tí ó ń gbé láàrín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni tí ó bá fi ọwọ́ kan òkú ẹnikẹ́ni, yóò jẹ́ aláìmọ́ fún ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó gbọdọ̀ wẹ ara rẹ̀ pẹ̀lú omi ní ọjọ́ kẹta àti ní ọjọ́ keje; nígbà náà ni yóò jẹ́ mímọ́. Ṣùgbọ́n tí ó bá jẹ́ pé kò wẹ ara rẹ̀ mọ́ ní ọjọ́ kẹta àti ní ọjọ́ keje yóò jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá fi ọwọ́ kan òkú ẹnìkan tí kò sì wẹ ara rẹ̀ mọ́, ó ba àgọ́",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.13",
                "verseOrgIds": [
                  "NUM.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́. A ó ké irú ẹni bẹ́ẹ̀ kúrò lára àwọn ọmọ Israẹli. Nítorí pé a kò tí ì wọ́n omi ìwẹ̀nùmọ́ lé e lórí, ó jẹ́ aláìmọ́, àìmọ́ rẹ̀ sì wà lára rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni òfin tí ó jẹ mọ́ bí ènìyàn bá kú nínú àgọ́, ẹnikẹ́ni tí ó bá wọ inú àgọ́ àti ẹni tí ó wà nínú àgọ́ yóò di aláìmọ́ fún ọjọ́ méje,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo ohun èlò tí a kò bá fi omọrí dé ni yóò jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni tí ó bá wà ní ìta tí ó sì fi ọwọ́ kan ẹni tí a fi idà pa tàbí ẹni tí ó kú ikú àtọ̀runwá, tàbí bí ẹnìkan bá fi ọwọ́ kan egungun òkú ènìyàn tàbí isà òkú, yóò jẹ́ aláìmọ́ fún ọjọ́ méje.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fún aláìmọ́ ènìyàn, mú eérú díẹ̀ lára eérú ọrẹ ìwẹ̀nùmọ́ sínú ìgò, kí o sì da omi tó ń sàn lé e lórí.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, ọkùnrin tí a yà sí mímọ́ yóò mú hísópù díẹ̀ yóò rì í sínú omi yóò sì fi wọ́n àgọ́ àti gbogbo ohun èlò tí a ṣe lọ́ṣọ̀ọ́ àti àwọn ènìyàn tí ó wà níbẹ̀. O gbọdọ̀ tún fi wọ́n ẹnikẹ́ni tí ó fi ọwọ́ kan egungun òkú ènìyàn tàbí isà òkú, tàbí ẹni tí ó kú ikú ara rẹ̀, tàbí ẹni tí ó kú ikú àti ọ̀run wá.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.18",
            "verseOrgIds": [
              "NUM.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin tí ó mọ́ ni kí ó bu omi wọ́n àwọn ènìyàn aláìmọ́ ní ọjọ́ kẹta àti ọjọ́ keje, ní ọjọ́ keje ó gbọdọ̀ wẹ ara rẹ̀ mọ́. Ẹni tí a wẹ̀mọ́ gbọdọ̀ fọ aṣọ rẹ̀ kí ó sì wẹ̀ pẹ̀lú omi, ní ìrọ̀lẹ́ ọjọ́ náà yóò mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.19",
            "verseOrgIds": [
              "NUM.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹni tí ó bá jẹ́ aláìmọ́ kò bá wẹ ara rẹ̀ mọ́, a gbọdọ̀ gé e kúrò nínú ìjọ ènìyàn, nítorí wí pé ó ti ba àgọ́",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.19.20",
                "verseOrgIds": [
                  "NUM.19.20"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́. A kò tí ì fi omi ìwẹ̀nùmọ́ sí ara rẹ̀, ó sì jẹ́ aláìmọ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí jẹ́ ìlànà láéláé fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 19:21"
      },
      "items": [
        {
          "text": "\"Ọkùnrin tí ó wọ́n omi ìwẹ̀nùmọ́ náà gbọdọ̀ fọ aṣọ rẹ̀ àti ẹnikẹ́ni tí ó fi ọwọ́ kan omi ìwẹ̀nùmọ́ yóò di aláìmọ́ títí di ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
