  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "NUM 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A pa ìlú Aradi run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọba Aradi ará Kenaani, tí ń gbé ní gúúsù gbọ́ wí pé Israẹli ń bọ̀ wá ní ojú ọ̀nà Atarimu, ó bá Israẹli jà ó sì fi agbára mú díẹ̀ lára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Israẹli jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.2",
                "verseOrgIds": [
                  "NUM.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pé, \"Bí o bá lè fi àwọn ènìyàn yìí lé wa lọ́wọ́, gbogbo ìlú wọn ni a ó parun.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.3",
                "verseOrgIds": [
                  "NUM.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "gbọ́ ẹ̀bẹ̀ àwọn ọmọ Israẹli, ó sì fi àwọn ará Kenaani lé wọn lọ́wọ́. Wọ́n pa wọ́n run pátápátá; torí náà ni a ṣe ń pe ibẹ̀ ní Horma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ejò idẹ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n rin ìrìnàjò láti òkè Hori lọ sí ọ̀nà tó lọ sí Òkun Pupa, láti kọjá yípo Edomu. Ṣùgbọ́n àwọn ènìyàn bínú ní ojú ọ̀nà;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n sì sọ̀rọ̀ lòdì sí Ọlọ́run àti Mose, wọ́n wí pé, \"Èéṣe tí ìwọ fi mú wa jáde láti Ejibiti kí a ba le wá kú sí aginjù yìí? Kò sí oúnjẹ! Kò sì sí omi! Àwa sì kórìíra oúnjẹ tí kò dára yìí!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.6",
                "verseOrgIds": [
                  "NUM.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "rán ejò olóró sí àárín wọn; wọ́n gé àwọn ènìyàn jẹ, ọ̀pọ̀ àwọn ọmọ Israẹli sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.6",
            "verseOrgIds": [
              "NUM.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sì wá sí ọ̀dọ̀ Mose wọn wí pé, \"A ti dá ẹ̀ṣẹ̀ nígbà tí asọ̀rọ̀-òdì sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.7",
                "verseOrgIds": [
                  "NUM.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "àti sí ìwọ pẹ̀lú. Gba àdúrà pé kí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.7",
                "verseOrgIds": [
                  "NUM.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mú ejò náà kúrò lọ́dọ̀ wa.\" Nígbà náà ni Mose gbàdúrà fún àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.7",
            "verseOrgIds": [
              "NUM.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.8",
                "verseOrgIds": [
                  "NUM.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Rọ ejò, a ó sì gbé e kọ́ sókè lórí igi, ẹni tí ejò bá ti gé jẹ lè wò ó yóò sì yè.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.8",
            "verseOrgIds": [
              "NUM.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose sì rọ ejò onírin ó sì gbé e kọ́ sórí igi, bí ejò bá sì bu ẹnikẹ́ni jẹ bí ó bá ti wò ó yóò sì yè.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.9",
            "verseOrgIds": [
              "NUM.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìrìnàjò sí Moabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli tẹ̀síwájú wọ́n sì péjọ sí Obotu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.10",
            "verseOrgIds": [
              "NUM.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n gbéra ní Obotu wọ́n sì pa ibùdó sí Iye-Abarimu, ní aginjù tí ó kọjú sí Moabu ní ìdojúkọ ìlà-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.11",
            "verseOrgIds": [
              "NUM.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibẹ̀ ni wọ́n ti gbéra wọ́n sì pa ibùdó ní àfonífojì Seredi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.12",
            "verseOrgIds": [
              "NUM.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibẹ̀ lọ, wọn ṣí, wọ́n sì dó sí ìhà kejì Arnoni, tí ó wà ní aginjù tí ó wà ní agbègbè ilẹ̀ àwọn ọmọ Amori. Arnoni jẹ́ ààlà fún ilẹ̀ Moabu, láàrín Moabu àti Amori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.13",
            "verseOrgIds": [
              "NUM.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdí nìyìí tí ìwé ogun",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.14",
                "verseOrgIds": [
                  "NUM.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "se wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:14"
      },
      "items": [
        {
          "text": "\"…Wahebu ní Sufa, Òkun Pupa àti",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:14"
      },
      "items": [
        {
          "text": "ní odò Arnoni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.14",
            "verseOrgIds": [
              "NUM.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti ní ìṣàn odò",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:15"
      },
      "items": [
        {
          "text": "tí ó darí sí ibùjókòó Ari",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:15"
      },
      "items": [
        {
          "text": "tí ó sì fi ara ti ìpínlẹ̀ Moabu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibẹ̀ ni wọ́n ti bẹ̀rẹ̀ rìn dé Beeri, èyí ni kànga tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.16",
                "verseOrgIds": [
                  "NUM.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose, \"Kó àwọn ènìyàn jọ èmi ó sì fún wọn ní omi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Israẹli kọ orin yìí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:17"
      },
      "items": [
        {
          "text": "\"Sun jáde, ìwọ kànga!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:17"
      },
      "items": [
        {
          "text": "Ẹ máa kọrin nípa rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nípa kànga tí àwọn ọmọ-aládé gbẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "nítorí àwọn ọlọ́lá ènìyàn ni ó gbẹ́ ẹ;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "tí àwọn ọlọ́lá àwọn ènìyàn sì fi ọ̀pá aládé àti ọ̀pá oyè wọn gbẹ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "NUM 21:18"
      },
      "items": [
        {
          "text": "Nígbà náà wọ́n kúrò láti aginjù lọ sí Mattana,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti Mattana lọ sí Nahalieli, láti Nahalieli lọ sí Bamoti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.19",
            "verseOrgIds": [
              "NUM.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti láti Bamoti lọ sí àfonífojì ní Moabu níbi tí òkè Pisga, tí ó wà ní òkè ilé omi ti kọjú sí aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.20",
            "verseOrgIds": [
              "NUM.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìṣẹ́gun Sihoni àti Ogu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli rán oníṣẹ́ láti sọ fún Sihoni ọba àwọn ará Amori wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.21",
            "verseOrgIds": [
              "NUM.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jẹ́ kí a kọjá ní orílẹ̀-èdè rẹ. A kò ní kọjá sí inú oko pápá tàbí ọgbà àjàrà àbí mu omi láti inú kànga. A máa gba òpópónà náà ti ọba títí tí a ó fi la ilẹ̀ rẹ kọjá.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Sihoni kò ní jẹ́ kí àwọn Israẹli kọjá ní ilẹ̀ wọn. Ó pe àwọn ọmọ-ogun rẹ̀ jọ wọ́n sì wọ́de ogun lọ sí aginjù nítorí àwọn ọmọ Israẹli. Nígbà tí ó dé Jahasi, ó bá àwọn ọmọ Israẹli jà.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àmọ́, Israẹli ṣẹ́gun, wọn fi ojú idà pa wọ́n, wọ́n sì gba ilẹ̀ láti ọwọ́ Arnoni lọ dé Jabbok, títí tí ó fi dé ilẹ̀ àwọn ará Ammoni, nítorí pé ààlà wọn jẹ́ olódi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israẹli sì gba gbogbo ìlú Amori wọ́n sì ń gbé ibẹ̀ pẹ̀lú Heṣboni, àti gbogbo ibùgbé ìlú tó yí i ká.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heṣboni ni ìlú Sihoni ọba àwọn ará Amori, ẹni tí ó bá ọba Moabu ti tẹ́lẹ̀ jà tí ó sì gba gbogbo ilẹ̀ rẹ̀ ní ọwọ́ rẹ̀ títí dé Arnoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdí nìyìí tí akọrin sọ wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:27"
      },
      "items": [
        {
          "text": "\"Wá sí Heṣboni kí ẹ jẹ́ kí a tún un kọ́;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:27"
      },
      "items": [
        {
          "text": "jẹ́ kí ìlú Sihoni padà bọ̀ sípò.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iná jáde láti Heṣboni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "ọ̀wọ́-iná láti Sihoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "Ó jó Ari àti Moabu run,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "àti ìlú àwọn olùgbé ibi gíga Arnoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ègbé ní fún ọ, ìwọ Moabu!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Ẹ ti parun, ẹ̀yin ènìyàn Kemoṣi!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Ó ti fi ọmọ rẹ̀ ọkùnrin sílẹ̀ gẹ́gẹ́ bí ìsáǹsá",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "àti ọmọ rẹ̀ obìnrin gẹ́gẹ́ bí ìgbèkùn",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "fún Sihoni ọba àwọn Amori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n àti bì wọ́n ṣubú;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "a ti pa ìjẹgàba Heṣboni run, a pa wọ́n run títí dé Diboni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "A sì ti bì wọ́n lulẹ̀ títí dé Nofa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:30"
      },
      "items": [
        {
          "text": "tí ó sì fi dé Medeba.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.30",
            "verseOrgIds": [
              "NUM.21.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ọmọ Israẹli sì ń gbé ní ilẹ̀ Amori.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí Mose rán ayọ́lẹ̀wò lọ sí Jaseri, àwọn ọmọ Israẹli sì gba àwọn agbègbè tó yí wọn ká wọ́n sì lé àwọn Amori tó wà níbẹ̀ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà wọ́n pẹ̀yìndà wọ́n sì gòkè lọ sí Baṣani, Ogu ọba ti Baṣani àti gbogbo àwọn ọmọ-ogun tí ó wọ́de ogun jáde láti pàdé wọn ní ojú ogun ní Edrei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.33",
            "verseOrgIds": [
              "NUM.21.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.21.34",
                "verseOrgIds": [
                  "NUM.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Má ṣe bẹ̀rù rẹ̀, nítorí tí mó tí fi òun lé ọ lọ́wọ́, àti àwọn ọmọ-ogun rẹ̀, àti ilẹ̀ rẹ̀, kí ìwọ kí ó ṣe sí i gẹ́gẹ́ bí ìwọ ti ṣe sí Sihoni ọba Amori ẹni tí ó ń jẹ ọba ní Heṣboni.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.34",
            "verseOrgIds": [
              "NUM.21.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì pa á, pẹ̀lú àwọn ọmọ rẹ̀ àti gbogbo àwọn ọmọ-ogun rẹ̀, wọn kò fi ku ẹnìkan fún un láàyè. Wọ́n sì gba ìní ilẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.35",
            "verseOrgIds": [
              "NUM.21.35"
            ]
          }
        }
      ]
    }
  ],
