        "number": "30",
        "style": "c",
        "sid": "NUM 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀jẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì sọ fún olórí àwọn ẹ̀yà ọmọ Israẹli pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.1",
                "verseOrgIds": [
                  "NUM.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà tí ọkùnrin kan bá jẹ́ ẹ̀jẹ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.2",
                "verseOrgIds": [
                  "NUM.30.3"
                ]
              }
            }
          ]
        },
        {
          "text": "tàbí búra láti fi de ara rẹ̀ ní ìdè kí òun má bà ba ọ̀rọ̀ rẹ̀ jẹ́ kí ó ṣe gẹ́gẹ́ bí ó ti ṣe sọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nígbà tí ọmọbìnrin kan bá sì wà ní ilé baba rẹ̀ tó bá jẹ́ ẹ̀jẹ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.3",
                "verseOrgIds": [
                  "NUM.30.4"
                ]
              }
            }
          ]
        },
        {
          "text": "tàbí búra láti fi de ara rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí baba rẹ̀ bá sì gbọ́ ẹ̀jẹ́ rẹ̀ tàbí ìdè rẹ̀ tí kò sì sọ nǹkan kan sí i, kí gbogbo ẹ̀jẹ́ rẹ̀ kí ó dúró àti gbogbo ìdè tí ó fi de ara rẹ̀ yóò sì dúró.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.4",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí baba rẹ̀ bá kọ̀ fun un ní ọjọ́ tí ó gbọ́, kò sí ọ̀kan nínú ẹ̀jẹ́ rẹ̀ tàbí nínú ìdè tí ó fi de ara rẹ̀ tí yóò dúró;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.5",
                "verseOrgIds": [
                  "NUM.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì tú u sílẹ̀ nítorí baba rẹ̀ kọ̀ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tí ó bá sì ní ọkọ lẹ́yìn ìgbà tí ó jẹ́ ẹ̀jẹ́ tàbí lẹ́yìn ìgbà tí ó sọ ọ̀rọ̀ kan láti ẹnu rẹ̀ jáde nínú èyí tí ó fi de ara rẹ̀ ní ìdè,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ọkọ rẹ̀ sì gbọ́ nípa èyí ṣùgbọ́n tí kò sọ nǹkan kan, nígbà náà ni ẹ̀jẹ́ tàbí ìdè tí ó fi de ara rẹ̀ tó dúró.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ọkọ rẹ̀ bá kọ̀ nígbà tí ó gbọ́, ǹjẹ́ òun yóò mú ẹ̀jẹ́ rẹ̀ tí ó jẹ́ àti ohun tí ó ti ti ẹnu rẹ̀ jáde, èyí tí ó fi de ara rẹ̀ dasán,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.8",
                "verseOrgIds": [
                  "NUM.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì dáríjì í.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n ẹ̀jẹ́ kí ẹ̀jẹ́ tàbí ìdè kí ìdè tí opó tàbí obìnrin tí a kọ̀sílẹ̀ bá ṣe yóò wà lórí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bí obìnrin tí ó ń gbé pẹ̀lú ọkọ rẹ̀ bá jẹ́ ẹ̀jẹ́ tàbí de ara rẹ̀ ní ìdè lábẹ́ ìbúra,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "tí ọkọ rẹ̀ bá sì gbọ́, ṣùgbọ́n tí kò sọ̀rọ̀, tí kò sì kọ̀, nígbà náà ni ẹ̀jẹ́ rẹ̀ yóò dúró.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ọkọ rẹ̀ bá sọ wọ́n dasán, nígbà tí ó gbọ́, nígbà náà kò sí ẹ̀jẹ́ tàbí ìdè tí ó ti ẹnu rẹ̀ jáde tí yóò dúró, ọkọ rẹ̀ ti sọ wọ́n dasán,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.12",
                "verseOrgIds": [
                  "NUM.30.13"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò tú u sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkọ rẹ̀ lè ṣe ìwádìí tàbí sọ ọ́ dasán ẹ̀jẹ́ tàbí ìbúra ìdè tí ó ti ṣe láti fi de ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n tí ọkọ rẹ̀ kò bá sọ nǹkan kan sí í nípa rẹ̀ ní ọjọ́ dé ọjọ́, nígbà náà ni ó ṣe ìwádìí nípa ẹ̀jẹ́ àti ìbúra ìdè tí ó dè é. Kí ọkùnrin náà ṣe ìwádìí lórí rẹ̀ láìsọ nípa rẹ̀ si nígbà tí ó gbọ́ nípa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti wù kí ó rí, bí ọkùnrin náà bá sọ ọ́ dasán, ní àkókò kan lẹ́yìn tí ó ti gbọ́ wọn, nígbà náà ó jẹ̀bi ọ̀rọ̀ náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ìlànà tí",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "NUM.30.16",
                "verseOrgIds": [
                  "NUM.30.17"
                ]
              }
            }
          ]
        },
        {
          "text": "fún Mose nípa ìbátan láàrín ọkùnrin àti obìnrin àti láàrín baba àti ọ̀dọ́mọbìnrin rẹ̀ tí ó sì ń gbé ní ilé rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "NUM.31",
