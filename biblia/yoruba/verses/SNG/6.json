  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "SNG 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbo ni olùfẹ́ rẹ lọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "ìwọ arẹwà jùlọ láàrín àwọn obìnrin?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "Níbo ni olùfẹ́ rẹ yà sí,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:1"
      },
      "items": [
        {
          "text": "kí a lè bá ọ wá a?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.1",
            "verseOrgIds": [
              "SNG.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olólùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùfẹ́ mi ti sọ̀kalẹ̀ lọ sínú ọgbà rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "sí ibi ibùsùn tùràrí,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "láti máa jẹ nínú ọgbà",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:2"
      },
      "items": [
        {
          "text": "láti kó ìtànná lílì jọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.2",
            "verseOrgIds": [
              "SNG.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ni ti olùfẹ́ mi, olùfẹ́ mi sì ni tèmi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:3"
      },
      "items": [
        {
          "text": "Ó ń jẹ láàrín ìtànná lílì.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.3",
            "verseOrgIds": [
              "SNG.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ lẹ́wà olùfẹ́ mi, bí i Tirsa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "ìwọ lẹ́wà bí i Jerusalẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:4"
      },
      "items": [
        {
          "text": "ìwọ ògo bí ogun pẹ̀lú ọ̀págun.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.4",
            "verseOrgIds": [
              "SNG.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yí ojú rẹ kúrò lára mi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "nítorí ojú rẹ borí mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "Irun rẹ rí bí i ọ̀wọ́ ewúrẹ́",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:5"
      },
      "items": [
        {
          "text": "tí ó sọ̀kalẹ̀ wá láti Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.5",
            "verseOrgIds": [
              "SNG.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyín rẹ rí bí ọ̀wọ́ àgùntàn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "tí ó gòkè láti ibi ìwẹ̀ rẹ̀ wá,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "gbogbo wọn bí ìbejì,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:6"
      },
      "items": [
        {
          "text": "kò sì ṣí ọ̀kankan tí ó yàgàn nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.6",
            "verseOrgIds": [
              "SNG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀rẹ̀kẹ́ rẹ lẹ́bàá ìbòjú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:7"
      },
      "items": [
        {
          "text": "rí bí ẹ̀là èso pomegiranate.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.7",
            "verseOrgIds": [
              "SNG.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgọ́ta ayaba ní ń bẹ níbẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "àti ọgọ́rin àlè,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:8"
      },
      "items": [
        {
          "text": "àti àwọn wúńdíá láìníye.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.8",
            "verseOrgIds": [
              "SNG.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àdàbà mi, aláìlábàwọ́n mi, ọ̀kan ni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "ọ̀kan ṣoṣo ọmọbìnrin ìyá rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "ààyò ẹyọ kan ṣoṣo ẹni tí ó bí i.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "Àwọn obìnrin rí i wọ́n pè é ní alábùkún fún",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:9"
      },
      "items": [
        {
          "text": "àwọn ayaba àti àwọn àlè gbé oríyìn fún un.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.9",
            "verseOrgIds": [
              "SNG.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni èyí tí ó tàn jáde bí i ìràwọ̀ òwúrọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "tí ó dára bí òṣùpá, tí ó mọ́lẹ̀ bí oòrùn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:10"
      },
      "items": [
        {
          "text": "tí ó ní ẹ̀rù bí i jagunjagun pẹ̀lú ọ̀págun?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.10",
            "verseOrgIds": [
              "SNG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sọ̀kalẹ̀ lọ sí ibi ọgbà èso igi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "láti wo àwọn ẹ̀ka igi tuntun ní àfonífojì,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 6:11"
      },
      "items": [
        {
          "text": "láti rí i bí àjàrà rúwé,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.6.11",
            "verseOrgIds": [
              "SNG.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
