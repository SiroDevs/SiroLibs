  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "SNG 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni ẹsẹ̀ rẹ ti ní ẹwà tó nínú bàtà.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Ìwọ ọmọbìnrin ọba!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "Oríkèé itan rẹ rí bí ohun ọ̀ṣọ́",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:1"
      },
      "items": [
        {
          "text": "iṣẹ́ ọlọ́gbọ́n oníṣọ̀nà",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdodo rẹ rí bí àwo",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "tí kì í ṣe aláìní ọtí,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "ìbàdí rẹ bí òkìtì alikama",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:2"
      },
      "items": [
        {
          "text": "tí a fi lílì yíká.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmú rẹ rí bí abo egbin méjì",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:3"
      },
      "items": [
        {
          "text": "tí wọ́n jẹ́ ìbejì àgbọ̀nrín.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.3",
            "verseOrgIds": [
              "SNG.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrùn rẹ rí bí ilé ìṣọ́ eyín erin.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Ojú rẹ rí bí adágún ní Heṣboni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "ní ẹ̀bá ẹnu ibodè Bati-Rabbimu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "Imú rẹ rí bí ilé ìṣọ́ Lebanoni",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:4"
      },
      "items": [
        {
          "text": "tí ó kọ ojú sí Damasku.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.4",
            "verseOrgIds": [
              "SNG.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òkè Karmeli ṣe ṣe adé yí àwọn òkè ká,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni irun orí rẹ ṣe adé yí orí rẹ ká",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:5"
      },
      "items": [
        {
          "text": "a fi àìdi irun rẹ mú ọba ní ìgbèkùn.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.5",
            "verseOrgIds": [
              "SNG.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni ẹwà rẹ ti pọ̀ tó",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:6"
      },
      "items": [
        {
          "text": "báwo ni o sì ti dára tó ìwọ olùfẹ́ mi nínú ìfẹ́?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.6",
            "verseOrgIds": [
              "SNG.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìdúró rẹ rí bí igi ọ̀pẹ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:7"
      },
      "items": [
        {
          "text": "àti ọmú rẹ bí ìdì èso àjàrà.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.7",
            "verseOrgIds": [
              "SNG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ní, \"Èmi yóò gun igi ọ̀pẹ lọ,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "èmi yóò di ẹ̀ka rẹ̀ mú.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "Kí ọmú rẹ rí bí ìdì èso àjàrà,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:8"
      },
      "items": [
        {
          "text": "àti èémí imú rẹ bí i ápù.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.8",
            "verseOrgIds": [
              "SNG.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ìfẹnukonu rẹ rí bí ọtí wáìnì tí ó dára jùlọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Olólùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "Tí ó kúnná tí ó sì dùn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:9"
      },
      "items": [
        {
          "text": "tí ń mú kí ètè àwọn tí ó sùn kí ó sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.9",
            "verseOrgIds": [
              "SNG.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti olùfẹ́ mi ni èmi í ṣe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:10"
      },
      "items": [
        {
          "text": "èmi sì ni ẹni tí ó wù ú.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.10",
            "verseOrgIds": [
              "SNG.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wá, olùfẹ́ mi, jẹ́ kí a lọ sí ibi pápá,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:11"
      },
      "items": [
        {
          "text": "jẹ́ kí a lo àṣálẹ́ ní àwọn ìletò.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.11",
            "verseOrgIds": [
              "SNG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí a lọ sínú ọgbà àjàrà ní kùtùkùtù",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "láti wo bí àjàrà rúwé",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "bí ìtànná àjàrà bá là.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "Àti bí pomegiranate bá ti rudi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 7:12"
      },
      "items": [
        {
          "text": "níbẹ̀ ni èmi yóò ti fi ìfẹ́ mi fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.12",
            "verseOrgIds": [
              "SNG.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
