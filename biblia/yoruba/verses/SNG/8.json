  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "SNG 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ìbá rí bí arákùnrin mi si mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "èyí tí ó mú ọmú ìyá mi dàgbà!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "Èmi ìbá rí ọ ní òde,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "èmi ìbá fi ẹnu kò ọ́ ní ẹnu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:1"
      },
      "items": [
        {
          "text": "wọn kì bá fi mí ṣe ẹlẹ́yà.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.1",
            "verseOrgIds": [
              "SNG.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ìbá fi ọ̀nà hàn ọ́",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "èmi ìbá mú ọ wá sínú ilé ìyá mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "ìwọ ìbá kọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "Èmi ìbá fi ọtí wáìnì olóòórùn dídùn fún ọ mu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:2"
      },
      "items": [
        {
          "text": "àti oje èso pomegiranate mi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.2",
            "verseOrgIds": [
              "SNG.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọwọ́ òsì rẹ ìbá wà ní abẹ́ orí mi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:3"
      },
      "items": [
        {
          "text": "ọwọ́ ọ̀tún rẹ ìbá sì gbà mí mọ́ra.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.3",
            "verseOrgIds": [
              "SNG.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọbìnrin Jerusalẹmu, èmi pè yín ní ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "Ẹ má ṣe rú olùfẹ́ mi sókè.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:4"
      },
      "items": [
        {
          "text": "Ẹ má ṣe jí i títí tí yóò fi wù ú.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.4",
            "verseOrgIds": [
              "SNG.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ẹni tí ń gòkè bọ̀ wá láti aginjù,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "tí ó fi ara ti olùfẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Olólùfẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "Ní abẹ́ igi ápù ni mo ti jí ọ dìde; níbẹ̀ ni ìyá rẹ ti lóyún rẹ",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:5"
      },
      "items": [
        {
          "text": "níbẹ̀ ni ẹni tí ń rọbí bí ọ sí.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.5",
            "verseOrgIds": [
              "SNG.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbé mi sí àyà rẹ bí èdìdì",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "bí èdìdì lé apá rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "nítorí ìfẹ́ lágbára bí ikú,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "ìjowú sì le bí isà òkú",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "jíjò rẹ̀ rí bí jíjò iná,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:6"
      },
      "items": [
        {
          "text": "gẹ́gẹ́ bí ọ̀wọ́-iná",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "SNG.8.6",
                "verseOrgIds": [
                  "SNG.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.6",
            "verseOrgIds": [
              "SNG.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omi púpọ̀ kò le paná ìfẹ́;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni gbígbá omi kò le gbá a lọ.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "Bí ènìyàn bá fún ìfẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "ní gbogbo ọrọ̀ ilé rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:7"
      },
      "items": [
        {
          "text": "a ó kẹ́gàn rẹ̀ pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.7",
            "verseOrgIds": [
              "SNG.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Ọ̀rẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwa ní arábìnrin kékeré kan,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "òun kò sì ní ọmú,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "kí ni àwa yóò fún arábìnrin wa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:8"
      },
      "items": [
        {
          "text": "ní ọjọ́ tí a ó bá fẹ́ ẹ?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.8",
            "verseOrgIds": [
              "SNG.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí òun bá jẹ́ ògiri,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "àwa yóò kọ́ ilé odi fàdákà lé e lórí.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "Bí òun bá jẹ́ ìlẹ̀kùn,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 8:9"
      },
      "items": [
        {
          "text": "àwa yóò fi pákó kedari dí i.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.8.9",
            "verseOrgIds": [
              "SNG.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Olólùfẹ́",
          "type": "text"
        }
