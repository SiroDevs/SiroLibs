              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àti pé, ẹni tí ó bá sì fi ọ̀run búra, ó fi ìtẹ́ Ọlọ́run àti ẹni tí ó jókòó lórí rẹ̀ búra.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.22",
                "verseOrgIds": [
                  "MAT.23.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ègbé ni fún yín ẹ̀yin olùkọ́ òfin àti Farisi, ẹ̀yin àgàbàgebè! Nítorí ẹ̀yin ń gba ìdámẹ́wàá minti, dili àti kumini, ẹ̀yin sì ti fi ohun tí ó ṣe pàtàkì jùlọ nínú òfin sílẹ̀ láìṣe, ìdájọ́, àánú àti ìgbàgbọ́. Wọ̀nyí ni ó tọ́ tí ẹ̀yin ìbá ṣe, ẹ̀yin kò bá fi wọ̀n-ọn-nì sílẹ̀ láìṣe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.23",
                "verseOrgIds": [
                  "MAT.23.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin afọ́jú tó ń fi afọ́jú mọ̀nà! Ẹ tu kòkòrò-kantíkantí tó bọ́ sì yín lẹ́nu nù, ẹ gbé ìbákasẹ mì.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.24",
                "verseOrgIds": [
                  "MAT.23.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ègbé ni fún yín ẹ̀yin Farisi àti ẹ̀yin olùkọ́ òfin, ẹ̀yin àgàbàgebè. Ẹ̀yin ń fọ òde ago àti àwo ṣùgbọ́n inú rẹ̀ kún fún ìrẹ́jẹ àti ẹ̀gbin gbogbo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.25",
                "verseOrgIds": [
                  "MAT.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìwọ afọ́jú Farisi, tètè kọ́ fọ inú ago àti àwo, gbogbo ago náà yóò sì di mímọ́.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.26",
                "verseOrgIds": [
                  "MAT.23.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ègbé ni fún yín ẹ̀yin Farisi àti ẹ̀yin olùkọ́ òfin, ẹ̀yin àgàbàgebè. Ẹ dàbí ibojì funfun tí ó dára ní wíwò, ṣùgbọ́n tí ó kún fún egungun ènìyàn àti fún ẹ̀gbin àti ìbàjẹ́.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
                  "MAT.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin gbìyànjú láti farahàn bí ènìyàn mímọ́, olódodo, lábẹ́ aṣọ mímọ́ yín ni ọkàn tí ó kún fún ìbàjẹ́ pẹ̀lú oríṣìíríṣìí àgàbàgebè àti ẹ̀ṣẹ̀ wà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.28",
                "verseOrgIds": [
                  "MAT.23.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ègbé ni fún yín ẹ̀yin olùkọ́ òfin àti Farisi, ẹ̀yin àgàbàgebè, nítorí ẹ̀yin kọ́ ibojì àwọn wòlíì tí í ṣe ibojì àwọn olódodo ní ọ̀ṣọ́.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.29",
                "verseOrgIds": [
                  "MAT.23.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
              "MAT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin sì wí pé, 'Àwa ìbá wà ní àsìkò àwọn baba wa, àwa kì bá ní ọwọ́ nínú ẹ̀jẹ̀ àwọn wòlíì'.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.30",
                "verseOrgIds": [
                  "MAT.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ǹjẹ́ ẹ̀yin ni ẹlẹ́rìí fún ara yín pé, ẹ̀yin ni ọmọ àwọn tí ó pa àwọn wòlíì.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.31",
                "verseOrgIds": [
                  "MAT.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.31",
            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àti pé, ẹ̀yin ń tẹ̀lé ìṣísẹ̀ àwọn baba yín. Ẹ̀yin ń kún òsùwọ̀n ìwà búburú wọn dé òkè.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.32",
                "verseOrgIds": [
                  "MAT.23.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin ejò! Ẹ̀yin paramọ́lẹ̀! Ẹ̀yin yóò ti ṣe yọ nínú ẹ̀bi ọ̀run àpáàdì?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.33",
                "verseOrgIds": [
                  "MAT.23.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà èmi yóò rán àwọn wòlíì àti àwọn ọlọ́gbọ́n ọkùnrin tí ó kún fún ẹ̀mí mímọ́, àti àwọn akọ̀wé sí yín. Ẹ̀yin yóò pa àwọn kan nínú wọn nípa kíkàn wọ́n mọ́ àgbélébùú. Ẹ̀yin yóò fi pàṣán na àwọn ẹlòmíràn nínú Sinagọgu yín, tí ẹ̀yin yóò sì ṣe inúnibíni sí wọn láti ìlú dé ìlú.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.34",
                "verseOrgIds": [
                  "MAT.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kí ẹ̀yin lè jẹ̀bi gbogbo ẹ̀jẹ̀ àwọn olódodo tí ẹ ta sílẹ̀ ní ayé, láti ẹ̀jẹ̀ Abeli títí dé ẹ̀jẹ̀ Sekariah ọmọ Berekiah ẹni tí ẹ pa nínú tẹmpili láàrín ibi pẹpẹ àti ibi ti ẹ yà sí mímọ́ fún Ọlọ́run.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.35",
                "verseOrgIds": [
                  "MAT.23.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lóòótọ́ ni mo wí fún yín, gbogbo nǹkan wọ̀nyí yóò wà sórí ìran yìí.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.36",
                "verseOrgIds": [
                  "MAT.23.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Jerusalẹmu, Jerusalẹmu, ìlú tí ó pa àwọn wòlíì, tí ó sì sọ òkúta lu àwọn tí a rán sí i. Ọ̀pọ̀ ìgbà ni èmi tí ń fẹ́ kó àwọn ọmọ rẹ jọ pọ̀ gẹ́gẹ́ bí àgbébọ̀ adìyẹ ti í dáàbò bo àwọn ọmọ rẹ̀ lábẹ́ ìyẹ́ rẹ, ṣùgbọ́n ẹ̀yin kọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.37",
                "verseOrgIds": [
                  "MAT.23.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wò ó, a fi ilé yín sílẹ̀ fún yín ní ahoro.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.38",
                "verseOrgIds": [
                  "MAT.23.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí èmi sọ èyí fún yín, ẹ̀yin kì yóò rí mi mọ́, títí ẹ̀yin yóò fi sọ pé, 'Olùbùkún ni ẹni tó ń bọ̀ ní orúkọ Olúwa.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.39",
                "verseOrgIds": [
                  "MAT.23.39"
                ]
              }
            }
          ]
        }
      ]
    }
