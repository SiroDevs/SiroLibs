  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "MAT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe àsè ìgbéyàwó",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu tún fi òwe sọ̀rọ̀ fún wọn wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ìjọba ọ̀run dàbí ọba kan ti ó múra àsè ìgbéyàwó ńlá fún ọmọ rẹ̀ ọkùnrin.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.2",
                "verseOrgIds": [
                  "MAT.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó rán àwọn ọmọ ọ̀dọ̀ rẹ̀ lọ pe àwọn tí a ti pè tẹ́lẹ̀ sí ibi àsè ìgbéyàwó. Ṣùgbọ́n wọn kò fẹ́ wá.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.3",
                "verseOrgIds": [
                  "MAT.22.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lẹ́yìn náà ó tún rán àwọn ọmọ ọ̀dọ̀ mìíràn pé, 'Ẹ sọ fún àwọn tí mo ti pè wí pé, mo ti ṣe àsè náà tán. A pa màlúù àti ẹran àbọ́pa mi, a ti ṣe ohun gbogbo tán, ẹ wa sí ibi àsè ìgbéyàwó.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.4",
                "verseOrgIds": [
                  "MAT.22.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n àwọn wọ̀n-ọn-nì tí ó ránṣẹ́ lọ pè kò kà á si. Wọ́n ń bá iṣẹ́ wọn lọ, ọ̀kan sí ọ̀nà oko rẹ̀, òmíràn sí ibi òwò rẹ̀.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.5",
                "verseOrgIds": [
                  "MAT.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àwọn ìyókù sì mú àwọn ọmọ ọ̀dọ̀ rẹ̀, wọ́n ṣe àbùkù sí wọn, wọ́n lù wọ́n pa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.6",
                "verseOrgIds": [
                  "MAT.22.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọba yìí bínú gidigidi, ó sì rán àwọn ọmọ-ogun rẹ̀, ó sì pa àwọn apànìyàn náà run, ó sì jó ìlú wọn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.7",
                "verseOrgIds": [
                  "MAT.22.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni ó wí fún àwọn ọmọ ọ̀dọ̀ rẹ̀ pé, 'Àsè ìgbéyàwó ti ṣe tàn, ṣùgbọ́n àwọn tí a pè kò yẹ fún ọlá náà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.8",
                "verseOrgIds": [
                  "MAT.22.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ lọ sí ìgboro àti òpópónà kí ẹ sì pe ẹnikẹ́ni tí ẹ bá lè rí wá àsè ìgbéyàwó náà.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.9",
                "verseOrgIds": [
                  "MAT.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà, àwọn ọmọ ọ̀dọ̀ náà sì jáde lọ sí òpópónà. Wọ́n sì mú oríṣìíríṣìí ènìyàn tí wọ́n lè rí wá, àwọn tí ò dára àti àwọn tí kò dára, ilé àsè ìyàwó sì kún fún àlejò.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.10",
                "verseOrgIds": [
                  "MAT.22.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n nígbà tí ọba sì wọlé wá láti wo àwọn àlejò tí a pè, ó sì rí ọkùnrin kan nínú wọn tí kò wọ aṣọ ìgbéyàwó.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.11",
                "verseOrgIds": [
                  "MAT.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọba sì bi í pé, 'Ọ̀rẹ́, báwo ni ìwọ ṣe wà níhìn-ín yìí láìní aṣọ ìgbéyàwó?' Ṣùgbọ́n ọkùnrin náà kò ní ìdáhùn kankan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.12",
                "verseOrgIds": [
                  "MAT.22.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni ọba wí fún àwọn ìránṣẹ́ rẹ̀ pé, 'Ẹ dì í tọwọ́ tẹsẹ̀, kí ẹ sì sọ ọ́ sínú òkùnkùn lóde níbi tí ẹkún àti ìpayínkeke wà.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.13",
                "verseOrgIds": [
                  "MAT.22.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nítorí ọ̀pọ̀ ni a pè ṣùgbọ́n díẹ̀ ni a yàn.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.14",
                "verseOrgIds": [
                  "MAT.22.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sísan owó orí fún Kesari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn Farisi péjọpọ̀ láti ronú ọ̀nà tì wọn yóò gbà fi ọ̀rọ̀ ẹnu mú un.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì rán àwọn ọmọ-ẹ̀yìn wọn pẹ̀lú àwọn ọmọ-ẹ̀yìn Herodu lọ sọ́dọ̀ rẹ̀ pé, \"Olùkọ́, àwa mọ̀ pé olóòtítọ́ ni ìwọ, ìwọ sì ń kọ́ni ní ọ̀nà Ọlọ́run ní òtítọ́. Bẹ́ẹ̀ ni ìwọ kì í wo ojú ẹnikẹ́ni; nítorí tí ìwọ kì í ṣe ojúsàájú ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.16",
            "verseOrgIds": [
              "MAT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí sọ fún wa, kí ni èrò rẹ? Ǹjẹ́ ó tọ́ láti san owó orí fún Kesari tàbí kò tọ́?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.17",
            "verseOrgIds": [
              "MAT.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jesu ti mọ èrò búburú inú wọn, ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin àgàbàgebè, èéṣe ti ẹ̀yin fi ń dán mi wò?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.18",
                "verseOrgIds": [
                  "MAT.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ fi owó ẹyọ tí a fi ń san owó orí kan hàn mi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.19",
                "verseOrgIds": [
                  "MAT.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Wọn mú dínárì kan wá fún un,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.19",
            "verseOrgIds": [
              "MAT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì bi wọ́n pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.20",
            "verseOrgIds": [
              "MAT.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àwòrán ta ni èyí? Àkọlé tà sì ní?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.20",
                "verseOrgIds": [
                  "MAT.22.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dáhùn pé, \"Ti Kesari ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni ó wí fún wọn pé,\" \"Ẹ fi èyí tí í ṣe ti Kesari fún Kesari, ẹ sì fi èyí ti ṣe ti Ọlọ́run fún Ọlọ́run.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.21",
                "verseOrgIds": [
                  "MAT.22.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n gbọ́ èyí, ẹnu yà wọ́n. Wọ́n fi í sílẹ̀, wọ́n sì bá tiwọn lọ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìgbéyàwó nígbà àjíǹde",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní ọjọ́ kan náà, àwọn Sadusi tí wọ́n sọ pé kò si àjíǹde lẹ́yìn ikú tọ Jesu wá láti bi í ní ìbéèrè,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n wí pé, \"Olùkọ́, Mose wí fún wa pé, bí ọkùnrin kan bá kú ní àìlọ́mọ, kí arákùnrin rẹ̀ ṣú aya rẹ̀ lópó, kí ó sì bí ọmọ fún un.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó bá jẹ́ bẹ́ẹ̀, láàrín wa níhìn-ín yìí, ìdílé kan wà tí ó ní arákùnrin méje. Èyí èkínní nínú wọn gbéyàwó, lẹ́yìn náà ó kú ní àìlọ́mọ. Nítorí náà ìyàwó rẹ̀ di ìyàwó arákùnrin kejì.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ gẹ́gẹ́ arákùnrin èkejì náà sì tún kú láìlọ́mọ. A sì fi ìyàwó rẹ̀ fún arákùnrin tí ó tún tẹ̀lé e. Bẹ́ẹ̀ sì ni títí tí òun fi di ìyàwó ẹni keje.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níkẹyìn obìnrin náà pàápàá sì kú.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí ó ti ṣe ìyàwó àwọn arákùnrin méjèèje, ìyàwó ta ni yóò jẹ́ ní àjíǹde òkú?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jesu dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àìmọ̀kan yín ni ó fa irú ìbéèrè báyìí. Nítorí ẹ̀yin kò mọ Ìwé Mímọ́ àti agbára Ọlọ́run.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.29",
                "verseOrgIds": [
                  "MAT.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ní àjíǹde kò ní sí ìgbéyàwó, a kò sì ní fi í fún ni ní ìyàwó. Gbogbo ènìyàn yóò sì dàbí àwọn angẹli ní ọ̀run.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.30",
                "verseOrgIds": [
                  "MAT.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nísinsin yìí, nípa ti àjíǹde òkú, tàbí ẹ̀yin kò mọ̀ pé Ọlọ́run ń bá yín sọ̀rọ̀ nígbà ti ó wí pé:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.31",
                "verseOrgIds": [
                  "MAT.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Èmi ni Ọlọ́run Abrahamu, Ọlọ́run Isaaki, àti Ọlọ́run Jakọbu.' Ọlọ́run kì í ṣe Ọlọ́run òkú, ṣùgbọ́n tí àwọn alààyè.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.32",
                "verseOrgIds": [
                  "MAT.22.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti àwọn ènìyàn gbọ́ èyí ẹnu yà wọ́n sí ẹ̀kọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òfin tí ó ga jùlọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti wọ́n sì gbọ́ pé ó ti pa àwọn Sadusi lẹ́nu mọ́, àwọn Farisi pé ara wọn jọ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kan nínú wọn tí ṣe amòfin dán an wò pẹ̀lú ìbéèrè yìí.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Olùkọ́ èwo ni ó ga jùlọ nínú àwọn òfin?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dáhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Fẹ́ Olúwa Ọlọ́run rẹ pẹ̀lú gbogbo ọkàn rẹ, gbogbo ẹ̀mí rẹ àti gbogbo inú rẹ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.37",
                "verseOrgIds": [
                  "MAT.22.37"
                ]
              }
            }
          ]
        },
        {
          "text": "'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èyí ni òfin àkọ́kọ́ àti èyí tí ó tóbi jùlọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.38",
                "verseOrgIds": [
                  "MAT.22.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èkejì tí ó tún dàbí rẹ̀ ní pé, 'Fẹ́ràn ọmọnìkejì rẹ gẹ́gẹ́ bí ara rẹ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.39",
                "verseOrgIds": [
                  "MAT.22.39"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lórí àwọn òfin méjèèjì yìí ni gbogbo òfin àti àwọn wòlíì rọ̀ mọ́.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.40",
                "verseOrgIds": [
                  "MAT.22.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọmọ ta ni Kristi?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn Farisi ti kó ara wọn jọ, Jesu béèrè lọ́wọ́ wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kí ni ẹ rò nípa Kristi? Ọmọ ta ni òun ń ṣe?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.42",
                "verseOrgIds": [
                  "MAT.22.42"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:42"
      },
      "items": [
        {
          "text": "Wọ́n dáhùn pé, \"Ọmọ Dafidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kí lo dé tí Dafidi, tí ẹ̀mí ń darí, pè é ní 'Olúwa'? Nítorí ó wí pé,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.43",
                "verseOrgIds": [
                  "MAT.22.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Olúwa sọ fún Olúwa mi pé,",
              "type": "text",
