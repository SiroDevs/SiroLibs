  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MAT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu rán àwọn méjìlá jáde",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì pe àwọn ọmọ-ẹ̀yìn rẹ̀ méjìlá sí ọ̀dọ̀; ó fún wọn ní àṣẹ láti lé ẹ̀mí àìmọ́ jáde àti láti ṣe ìwòsàn ààrùn àti àìsàn gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.1",
            "verseOrgIds": [
              "MAT.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ àwọn aposteli méjèèjìlá náà ni wọ̀nyí:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 10:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "ẹni àkọ́kọ́ ni Simoni ẹni ti a ń pè ni Peteru àti arákùnrin rẹ̀ Anderu;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "Jakọbu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        },
        {
          "text": "ọmọ Sebede àti arákùnrin rẹ̀ Johanu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipi àti Bartolomeu;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "Tomasi àti Matiu agbowó òde;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "Jakọbu ọmọ Alfeu àti Taddeu;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni ọmọ ẹgbẹ́ Sealoti, Judasi Iskariotu, ẹni tí ó da Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn méjèèjìlá wọ̀nyí ni Jesu ran, ó sì pàṣẹ fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ má ṣe lọ sì ọ̀nà àwọn kèfèrí, ẹ má ṣe wọ̀ ìlú àwọn ará Samaria.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.5",
                "verseOrgIds": [
                  "MAT.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ kúkú tọ̀ àwọn àgùntàn ilé Israẹli tí ó nù lọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.6",
                "verseOrgIds": [
                  "MAT.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.6",
            "verseOrgIds": [
              "MAT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ẹ̀yin ti ń lọ, ẹ máa wàásù yìí wí pé, 'Ìjọba ọ̀run kù sí dẹ̀dẹ̀.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.7",
                "verseOrgIds": [
                  "MAT.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.7",
            "verseOrgIds": [
              "MAT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ máa ṣe ìwòsàn fún àwọn aláìsàn, ẹ si jí àwọn òkú dìde, ẹ sọ àwọn adẹ́tẹ̀ di mímọ́, kí ẹ sì máa lé àwọn ẹ̀mí èṣù jáde. Ọ̀fẹ́ ni ẹ̀yin gbà á, ọ̀fẹ́ ni kí ẹ fi fún ni.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.8",
                "verseOrgIds": [
                  "MAT.10.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ má ṣe mú wúrà tàbí fàdákà tàbí idẹ sínú àpò ìgbànú yín,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.9",
                "verseOrgIds": [
                  "MAT.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.9",
            "verseOrgIds": [
              "MAT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ẹ má ṣe mú àpò fún ìrìnàjò yín, kí ẹ má ṣe mú ẹ̀wù méjì, tàbí bàtà, tàbí ọ̀pá; oúnjẹ oníṣẹ́ yẹ fún un.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.10",
                "verseOrgIds": [
                  "MAT.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.10",
            "verseOrgIds": [
              "MAT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìlúkílùú tàbí ìletòkíletò tí ẹ̀yin bá wọ̀, ẹ wá ẹni ti ó bá yẹ níbẹ̀ rí, níbẹ̀ ni kí ẹ sì gbé nínú ilé rẹ̀ títí tí ẹ̀yin yóò fi kúrò níbẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.11",
                "verseOrgIds": [
                  "MAT.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.11",
            "verseOrgIds": [
              "MAT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ẹ̀yin bá sì wọ ilé kan, ẹ kí i wọn",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.12",
                "verseOrgIds": [
                  "MAT.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.12",
            "verseOrgIds": [
              "MAT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ilé náà bá sì yẹ, kí àlàáfíà yín kí ó bà sórí rẹ̀; ṣùgbọ́n bí kò bá yẹ, kí àlàáfíà yín kí ó padà sọ́dọ̀ yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.13",
                "verseOrgIds": [
                  "MAT.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.13",
            "verseOrgIds": [
              "MAT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ẹnikẹ́ni tí kò bá sì gbà yín, tàbí tí kò gba ọ̀rọ̀ yín, ẹ gbọn eruku ẹ̀ṣẹ̀ yín sílẹ̀ tí ẹ bá ń kúrò ní ilé tàbí ìlú náà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.14",
                "verseOrgIds": [
                  "MAT.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.14",
            "verseOrgIds": [
              "MAT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lóòótọ́ ni mo wí fún yín, yóò sàn fún ìlú Sodomu àti Gomorra ní ọjọ́ ìdájọ́ ju àwọn ìlú náà lọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.15",
                "verseOrgIds": [
                  "MAT.10.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mò ń rán yín lọ gẹ́gẹ́ bí àgùntàn sáàrín ìkookò. Nítorí náà, kí ẹ ní ìṣọ́ra bí ejò, kí ẹ sì ṣe onírẹ̀lẹ̀ bí àdàbà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.16",
                "verseOrgIds": [
                  "MAT.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ ṣọ́ra lọ́dọ̀ àwọn ènìyàn nítorí wọn yóò fi yín le àwọn ìgbìmọ̀ ìgbèríko lọ́wọ́ wọn yóò sì nà yín nínú Sinagọgu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.17",
                "verseOrgIds": [
                  "MAT.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.17",
            "verseOrgIds": [
              "MAT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí orúkọ mi, a ó mú yín lọ síwájú àwọn baálẹ̀ àti àwọn ọba, bí ẹlẹ́rìí sí wọn àti àwọn aláìkọlà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.18",
                "verseOrgIds": [
                  "MAT.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.18",
            "verseOrgIds": [
              "MAT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí wọ́n bá mú yín, ẹ má ṣe ṣàníyàn ohun tí ẹ ó sọ tàbí bí ẹ ó ṣe sọ ọ́. Ní ojú kan náà ni a ó fi ohun tí ẹ̀yin yóò sọ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.19",
                "verseOrgIds": [
                  "MAT.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.19",
            "verseOrgIds": [
              "MAT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí pé kì í ṣe ẹ̀yin ni ó sọ ọ́, bí kò ṣe Ẹ̀mí Baba yín tí ń sọ̀rọ̀ nípasẹ̀ yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.20",
                "verseOrgIds": [
                  "MAT.10.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Arákùnrin yóò sì fi arákùnrin fún pípa. Baba yóò fi àwọn ọmọ rẹ̀ fún ikú pa. Àwọn ọmọ yóò ṣọ̀tẹ̀ sí òbí wọn, wọn yóò sì mú kí a pa wọ́n.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.21",
                "verseOrgIds": [
                  "MAT.10.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.21",
            "verseOrgIds": [
              "MAT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gbogbo ènìyàn yóò sì kórìíra yín nítorí mi, ṣùgbọ́n gbogbo ẹni tí ó bá dúró ṣinṣin dé òpin ni a ó gbàlà",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.22",
                "verseOrgIds": [
                  "MAT.10.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí wọn bá ṣe inúnibíni sì i yín ní ìlú kan, ẹ sálọ sì ìlú kejì. Lóòótọ́ ni mo wí fún yín, ẹ̀yin kò tì í le la gbogbo ìlú Israẹli já tán kí Ọmọ Ènìyàn tó dé.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.23",
                "verseOrgIds": [
                  "MAT.10.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akẹ́kọ̀ọ́ kì í ju olùkọ́ rẹ̀ lọ, bẹ́ẹ̀ ni ọmọ ọ̀dọ̀ kì í ju ọ̀gá rẹ̀ lọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.24",
                "verseOrgIds": [
                  "MAT.10.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.24",
            "verseOrgIds": [
              "MAT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó tọ́ fún akẹ́kọ̀ọ́ láti dàbí olùkọ́ rẹ̀ àti fún ọmọ ọ̀dọ̀ láti rí bí ọ̀gá rẹ̀. Nígbà tí wọ́n bá pe baálé ilé ní Beelsebulu, mélòó mélòó ni ti àwọn ènìyàn ilé rẹ̀!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.25",
                "verseOrgIds": [
                  "MAT.10.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nítorí náà, ẹ má ṣe bẹ̀rù wọn, nítorí kò sí ohun tó ń bọ̀ tí kò ní í fi ara hàn, tàbí ohun tó wà ní ìkọ̀kọ̀ tí a kò ní mọ̀ ni gbangba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.26",
                "verseOrgIds": [
                  "MAT.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.26",
            "verseOrgIds": [
              "MAT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ohun tí mo bá wí fún yín ní òkùnkùn, òun ni kí ẹ sọ ní ìmọ́lẹ̀. Èyí tí mo sọ kẹ́lẹ́kẹ́lẹ́ sì etí yín ni kí ẹ kéde rẹ́ lórí òrùlé.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.27",
                "verseOrgIds": [
                  "MAT.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.27",
            "verseOrgIds": [
              "MAT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ má ṣe bẹ̀rù àwọn tí ó le pa ara nìkan; ṣùgbọ́n tí wọn kò lè pa ẹ̀mí. Ẹ bẹ̀rù Ẹni tí ó le pa ẹ̀mí àti ara run ní ọ̀run àpáàdì.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.28",
                "verseOrgIds": [
                  "MAT.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ológoṣẹ́ méjì kọ́ ni à ń tà ní owó idẹ wẹ́wẹ́ kan? Síbẹ̀ kò sí ọ̀kan nínú wọn tí yóò ṣubú lu ilẹ̀ lẹ́yìn Baba yin.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.29",
                "verseOrgIds": [
                  "MAT.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.29",
            "verseOrgIds": [
              "MAT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àti pé gbogbo irun orí yín ni a ti kà pé.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.30",
                "verseOrgIds": [
                  "MAT.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.30",
            "verseOrgIds": [
              "MAT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà, ẹ má ṣe fòyà; ẹ̀yin ní iye lórí ju ọ̀pọ̀ ológoṣẹ́ lọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.31",
                "verseOrgIds": [
                  "MAT.10.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹnikẹ́ni tí ó bá jẹ́wọ́ mi níwájú ènìyàn, òun náà ni èmi yóò jẹ́wọ́ rẹ̀ níwájú Baba mi ní ọ̀run.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.32",
                "verseOrgIds": [
                  "MAT.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ẹni tí ó bá sẹ́ mí níwájú àwọn ènìyàn, òun náà ni èmi náà yóò sọ wí pé n kò mọ̀ níwájú Baba mi ní ọ̀run.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.33",
                "verseOrgIds": [
                  "MAT.10.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ má ṣe rò pé mo mú àlàáfíà wá sí ayé, Èmi kò mú àlàáfíà wá bí kò ṣe idà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.34",
                "verseOrgIds": [
                  "MAT.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí èmi wá láti ya",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'ọmọkùnrin ní ipa sí baba rẹ̀,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ọmọbìnrin ní ipa sí ìyá rẹ̀,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "àti aya ọmọ sí ìyakọ rẹ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ará ilé ènìyàn ni yóò sì máa ṣe ọ̀tá rẹ̀.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.36",
                "verseOrgIds": [
                  "MAT.10.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹni tí ó bá fẹ́ baba rẹ̀ tàbí ìyá rẹ̀ jù mí lọ, kò yẹ ní tèmi, ẹni tí ó ba fẹ́ ọmọkùnrin tàbí ọmọbìnrin rẹ̀ jù mí lọ, kò yẹ ní tèmi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.37",
                "verseOrgIds": [
                  "MAT.10.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí kò bá gbé àgbélébùú rẹ̀ kí ó tẹ̀lé mi kò yẹ ní tèmi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.38",
                "verseOrgIds": [
                  "MAT.10.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
