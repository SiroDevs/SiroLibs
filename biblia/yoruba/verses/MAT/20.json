  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe àwọn òṣìṣẹ́ nínú ọgbà àjàrà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nítorí ìjọba ọ̀run dàbí ọkùnrin tí ó jẹ́ baálé kan, tí ó jíjáde lọ ní kùtùkùtù òwúrọ̀, tí ó gba àwọn alágbàṣe sínú ọgbà àjàrà rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.1",
                "verseOrgIds": [
                  "MAT.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Òun pinnu láti san dínárì kan fún iṣẹ́ òòjọ́ kan. Lẹ́yìn èyí ó sì rán wọn lọ sínú ọgbà àjàrà rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.2",
                "verseOrgIds": [
                  "MAT.20.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ní wákàtí kẹta ọjọ́ bí ó ti ń kọjá níwájú ilé ìgbanisíṣẹ́, ó rí díẹ̀ nínú àwọn aláìríṣẹ́ tí wọ́n dúró ní ọjà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.3",
                "verseOrgIds": [
                  "MAT.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó wí fún wọn pé, 'Ẹ̀yin pàápàá, ẹ lọ ṣiṣẹ́ nínú ọgbà àjàrà mi, bí ó bá sì di òpin ọjọ́, èmi yóò san iye ti ó bá yẹ fún yín.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.4",
                "verseOrgIds": [
                  "MAT.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wọ́n sì lọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó tún jáde lọ́sàn án ní nǹkan bí wákàtí kẹfà àti wákàtí kẹsànán, ó túnṣe bákan náà.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lọ́jọ́ kan náà ní wákàtí kọkànlá ọjọ́, ó tún jáde sí àárín ìlú, ó sì rí àwọn aláìríṣẹ́ mìíràn tí wọ́n dúró. Ó bi wọ́n pé, 'Èéṣe tí ẹ̀yin kì í ṣiṣẹ́ ní gbogbo ọjọ́?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.6",
                "verseOrgIds": [
                  "MAT.20.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wọ́n sì dáhùn pé, 'Nítorí pé kò sí ẹni tí yóò fún wa ní iṣẹ́ ṣe.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ó tún sọ fún wọn pé, 'Ẹ̀yin náà ẹ jáde lọ ṣiṣẹ́ pẹ̀lú nínú ọgbà àjàrà mi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà tí ó di àṣálẹ́, ẹni tó ni ọgbà àjàrà sọ fún aṣojú rẹ̀ pé, 'Pe àwọn òṣìṣẹ́ náà, kí ó san owó iṣẹ́ wọn fún wọn, bẹ̀rẹ̀ láti ẹni ìkẹyìn lọ sí ti ìṣáájú.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.8",
                "verseOrgIds": [
                  "MAT.20.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà tí àwọn ti a pè ní wákàtí kọkànlá ọjọ́ dé, ẹnìkọ̀ọ̀kan gba owó dínárì kan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.9",
                "verseOrgIds": [
                  "MAT.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí àwọn tí a gbà ṣiṣẹ́ lákọ̀ọ́kọ́ fẹ́ gba owó tiwọn, èrò wọn ni pé àwọn yóò gba jù bẹ́ẹ̀ lọ, ṣùgbọ́n ẹnìkọ̀ọ̀kan wọn gba owó dínárì kan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.10",
                "verseOrgIds": [
                  "MAT.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí wọ́n ti ń gbà á, wọ́n ń kùn sí onílẹ̀ náà,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.11",
                "verseOrgIds": [
                  "MAT.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pé, 'Wákàtí kan péré ni àwọn tí a gbà kẹ́yìn fi ṣiṣẹ́, ìwọ sì san iye kan náà fún wọn àti àwa náà ti a fi gbogbo ọjọ́ ṣiṣẹ́ nínú oòrùn gangan.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.12",
                "verseOrgIds": [
                  "MAT.20.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n ó dá ọ̀kan nínú wọn lóhùn pé, 'Ọ̀rẹ́, kò sí aburú nínú nǹkan tí èmi ṣe sí yín. Kì í ha ṣe pé ẹ̀yin gbà láti ṣiṣẹ́ fún owó dínárì kan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.13",
                "verseOrgIds": [
                  "MAT.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó ní, gba èyí tí í ṣé tìrẹ, ki ó sì máa lọ. Èmi fẹ́ láti fún ẹni ìkẹyìn gẹ́gẹ́ bí mo ti fi fún ọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.14",
                "verseOrgIds": [
                  "MAT.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àbí ó lòdì sí òfin pé kí èmi fún ẹnikẹ́ni ní owó mi bí mo bá yàn láti ṣe bẹ́ẹ̀? Kí ni ìdí tí ìwọ ní láti bínú nítorí èmi ṣe ohun rere?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.15",
                "verseOrgIds": [
                  "MAT.20.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bẹ́ẹ̀ ni àwọn ẹni ìkẹyìn yóò di ẹni ìṣáájú, ẹni ìṣáájú yóò sì di ẹni ìkẹyìn.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.16",
                "verseOrgIds": [
                  "MAT.20.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu tún sọ àsọtẹ́lẹ̀ nípa ikú rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Jesu ti ń gòkè lọ sí Jerusalẹmu, ó pe àwọn ọmọ-ẹ̀yìn rẹ̀ méjìlá sí apá kan ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wò ó, àwa ń gòkè lọ sí Jerusalẹmu. Ó sọ fún wọn pé, a ó fi Ọmọ Ènìyàn lé àwọn olórí àlùfáà àti àwọn olùkọ́ òfin lọ́wọ́, wọn yóò sì dá mi lẹ́bi ikú.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.18",
                "verseOrgIds": [
                  "MAT.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wọn yóò sì fà á lé àwọn kèfèrí lọ́wọ́ láti fi ṣe ẹlẹ́yà àti láti náà án, àti láti kàn mi mọ́ àgbélébùú, ní ọjọ́ kẹta, yóò jí dìde.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.19",
                "verseOrgIds": [
                  "MAT.20.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀bẹ̀ ìyá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ìyá àwọn ọmọ Sebede bá àwọn ọmọ rẹ̀ wá sọ́dọ̀ Jesu, ó wólẹ̀ lórí eékún rẹ̀, o béèrè fún ojúrere rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu béèrè pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kí ni ìwọ ń fẹ́?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.21",
                "verseOrgIds": [
                  "MAT.20.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:21"
      },
      "items": [
        {
          "text": "Ó sì dáhùn pé, \"Jẹ́ kí àwọn ọmọ mi méjèèjì jókòó ní apá ọ̀tún àti apá òsì lórí ìtẹ́ ìjọba rẹ?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jesu dáhùn ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin kò mọ ohun tí ẹ̀yin ń béèrè, ẹ̀yin ha le mu nínú ago tí èmi ó mu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.22",
                "verseOrgIds": [
                  "MAT.20.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:22"
      },
      "items": [
        {
          "text": "Wọ́n dáhùn pé, \"Àwa lè mu ún.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dájúdájú, ẹ̀yin yóò mu nínú ago mi, ṣùgbọ́n èmi kò ní àṣẹ láti sọ irú ènìyàn tí yóò jókòó ní apá ọ̀tún tàbí apá òsì. Baba mi ti pèsè ààyè wọ̀n-ọn-nì sílẹ̀ fún kìkì àwọn tí ó yàn.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.23",
                "verseOrgIds": [
                  "MAT.20.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ-ẹ̀yìn mẹ́wàá ìyókù sì gbọ́ èyí, wọ́n bínú sí àwọn arákùnrin méjì yìí.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Jesu pé wọ́n papọ̀, ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dájúdájú, ẹ̀yin mọ̀ pé àwọn ọba aláìkọlà a máa lo agbára lórí wọn, àwọn ẹni ńlá láàrín wọn a sì máa fi ọlá tẹrí àwọn tí ó wà lábẹ́ wọn ba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.25",
                "verseOrgIds": [
                  "MAT.20.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n èyí yàtọ̀ láàrín yín. Dípò bẹ́ẹ̀, ẹni tí ó bá ń fẹ́ ṣe olórí láàrín yín, ní láti ṣe bí ìránṣẹ́ fún yín ni,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.26",
                "verseOrgIds": [
                  "MAT.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "àti ẹni tí ó bá fẹ́ ṣe olórí nínú yín, ẹ jẹ́ kí ó máa ṣe ọmọ ọ̀dọ̀ yin.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.27",
                "verseOrgIds": [
                  "MAT.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gẹ́gẹ́ bí Ọmọ Ènìyàn kò ṣe wá sí ayé, kí ẹ lè ṣe ìránṣẹ́ fún un, ṣùgbọ́n láti ṣe ìránṣẹ́ fún yín, àti láti fi ẹ̀mí rẹ ṣe ìràpadà ọ̀pọ̀ ènìyàn.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.28",
                "verseOrgIds": [
                  "MAT.20.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afọ́jú méjì ríran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Jesu àti àwọn ọmọ-ẹ̀yìn rẹ̀ ti ń fi ìlú Jeriko sílẹ̀, ọ̀pọ̀ ènìyàn sì wọ́ tẹ̀lé e lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin afọ́jú méjì sì jókòó lẹ́bàá ọ̀nà, nígbà tí wọ́n sí gbọ́ pé Jesu ń kọjá lọ, wọ́n bẹ̀rẹ̀ sí í kígbe pé, \"Olúwa, Ọmọ Dafidi, ṣàánú fún wa!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn sí bá wọn wí pé kí wọn dákẹ́, ṣùgbọ́n wọ́n kígbe sókè sí i. \"Olúwa, ọmọ Dafidi, ṣàánú fún wa!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dúró lójú ọ̀nà, ó sì pè wọ́n, Ó béèrè pé,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kí ni ẹ̀yin fẹ́ kí èmi ṣe fún yín?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.32",
                "verseOrgIds": [
                  "MAT.20.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n dáhùn pé, \"Olúwa, àwa fẹ́ kí a ríran.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àánú wọn sì ṣe Jesu, ó fi ọwọ́ kan ojú wọn. Lójúkan náà, wọ́n sì ríran, wọ́n sì ń tọ̀ ọ́ lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
  ],
