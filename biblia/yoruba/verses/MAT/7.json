  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MAT 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ṣíṣe ìdájọ́ ẹnìkejì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ má ṣe dá ni lẹ́jọ́, kí a má bà dá yín lẹ́jọ́.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.1",
                "verseOrgIds": [
                  "MAT.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.1",
            "verseOrgIds": [
              "MAT.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí irú ìdájọ́ tí ẹ̀yin bá ṣe, òun ni a ó sì ṣe fún yín; irú òsùwọ̀n tí ẹ̀yin bá fi wọ́n, òun ni a ó sì fi wọ́n fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.2",
                "verseOrgIds": [
                  "MAT.7.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èétiṣe tí ìwọ fi ń wo ẹ̀rún igi tí ń bẹ ní ojú arákùnrin rẹ, ṣùgbọ́n ìwọ kò kíyèsi ìtì igi tí ń bẹ ní ojú ara rẹ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.3",
                "verseOrgIds": [
                  "MAT.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.3",
            "verseOrgIds": [
              "MAT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tàbí ìwọ ó ti ṣe wí fún arákùnrin rẹ pé, 'Jẹ́ kí èmi yọ ẹ̀rún igi tí ń bẹ ni ojú rẹ,' sì wò ó ìtì igi ń bẹ ní ojú ìwọ tìkára rẹ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.4",
                "verseOrgIds": [
                  "MAT.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.4",
            "verseOrgIds": [
              "MAT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìwọ àgàbàgebè, tètè kọ́ yọ ìtì igi jáde kúrò ní ojú ara rẹ ná, nígbà náà ni ìwọ yóò sì tó ríran kedere láti yọ ẹ̀rún igi tí ń bẹ ní ojú arákùnrin rẹ kúrò.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.5",
                "verseOrgIds": [
                  "MAT.7.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ má ṣe fi ohun mímọ́ fún ajá jẹ, ẹ má sì ṣe sọ ohun ọ̀ṣọ́ olówó iyebíye yín fún ẹlẹ́dẹ̀, bí ẹ̀yin bá ṣe bẹ́ẹ̀ kí wọ́n má bà fi ẹsẹ̀ tẹ̀ wọ́n mọ́lẹ̀, wọn a sì yí padà sí yín, wọn a sì bù yín jẹ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.6",
                "verseOrgIds": [
                  "MAT.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Béèrè, kànkùn, wá kiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Béèrè, a ó sì fi fún yín; wá kiri, ẹ̀yin yóò sì rí; kànkùn, a ó sì ṣí i sílẹ̀ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.7",
                "verseOrgIds": [
                  "MAT.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ẹnikẹ́ni tí ó béèrè ń rí gbà, ẹni tí ó bá sì wà kiri ń rí, ẹni bá sì kànkùn ni a yóò ṣi sílẹ̀ fún.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.8",
                "verseOrgIds": [
                  "MAT.7.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ta ni ọkùnrin náà tí ń bẹ nínú yín, bí ọmọ rẹ̀ béèrè àkàrà, tí yóò jẹ́ fi òkúta fún un?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.9",
                "verseOrgIds": [
                  "MAT.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tàbí bí ó béèrè ẹja, tí yóò jẹ́ fún un ní ejò?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.10",
                "verseOrgIds": [
                  "MAT.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ǹjẹ́ bí ẹ̀yin tí í ṣe ènìyàn búburú bá mọ̀ bí a ti í fi ẹ̀bùn rere fún àwọn ọmọ yín, mélòó mélòó ni Baba yín tí ń bẹ ní ọ̀run yóò fi ohun rere fún àwọn tí ó béèrè lọ́wọ́ rẹ̀?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.11",
                "verseOrgIds": [
                  "MAT.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.11",
            "verseOrgIds": [
              "MAT.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà, nínú gbogbo ohunkóhun ti ẹ̀yin bá ń fẹ́ kí ènìyàn kí ó ṣe sí yín, bẹ́ẹ̀ ni kí ẹ̀yin kí ó ṣe sí wọn gẹ́gẹ́; nítorí èyí ni òfin àti àwọn wòlíì.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.12",
                "verseOrgIds": [
                  "MAT.7.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ̀nà tóóró àti ọnà gbòòrò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ ba ẹnu-ọ̀nà tóóró wọlé; gbòòrò ni ẹnu-ọ̀nà náà, àti oníbùú ni ojú ọ̀nà náà tí ó lọ sí ibi ìparun, ọ̀pọ̀lọpọ̀ ni àwọn ẹni tí ń bá ibẹ̀ wọlé.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.13",
                "verseOrgIds": [
                  "MAT.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí kékeré ni ẹnu-ọ̀nà náà, tóóró sì ni ojú ọ̀nà náà, ti ó lọ sí ibi ìyè, díẹ̀ ni àwọn ẹni tí ó ń rìn ín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.14",
                "verseOrgIds": [
                  "MAT.7.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igi àti èso rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ máa ṣọ́ra fún àwọn èké wòlíì tí wọ́n ń tọ̀ yín wá ní àwọ̀ àgùntàn, ṣùgbọ́n ní inú wọn apanijẹ ìkookò ni wọ́n.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.15",
                "verseOrgIds": [
                  "MAT.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nípa èso wọn ni ẹ̀yin ó fi mọ̀ wọn. Ǹjẹ́ ènìyàn ha lè ká èso àjàrà lára igi ọ̀gàn tàbí èso ọ̀pọ̀tọ́ lára ẹ̀gún òṣùṣú?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.16",
                "verseOrgIds": [
                  "MAT.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bẹ́ẹ̀ ni gbogbo igi rere a máa so èso rere ṣùgbọ́n igi búburú a máa so èso búburú.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.17",
                "verseOrgIds": [
                  "MAT.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Igi rere kò le so èso búburú, bẹ́ẹ̀ ni igi búburú kò lè so èso rere.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.18",
                "verseOrgIds": [
                  "MAT.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
              "MAT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gbogbo igi tí kò bá so èso rere, a gé e lulẹ̀, à wọ́ ọ jù sínú iná.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.19",
                "verseOrgIds": [
                  "MAT.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
