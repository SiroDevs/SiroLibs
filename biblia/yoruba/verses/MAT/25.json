        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà àwọn pẹ̀lú yóò dáhùn pé, 'Olúwa, nígbà wo ni àwa rí ọ, tí ebi ń pa ọ́ tàbí tí òǹgbẹ ń gbẹ ọ́, tàbí tí o ṣàìsàn, tàbí tí o wà lọ́gbà ẹ̀wọ̀n, tí a kò sí ràn ọ́ lọ́wọ́?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.44",
                "verseOrgIds": [
                  "MAT.25.44"
                ]
              }
            }
          ]
        }
