  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe àwọn wúńdíá mẹ́wàá",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni ó fi ìjọba ọ̀run wé àwọn wúńdíá mẹ́wàá. Ti wọ́n gbé fìtílà wọn láti lọ pàdé ọkọ ìyàwó.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.1",
                "verseOrgIds": [
                  "MAT.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Márùn-ún nínú wọn jẹ́ ọlọ́gbọ́n, márùn-ún nínú wọn ni wọ́n jẹ́ aláìgbọ́n.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.2",
                "verseOrgIds": [
                  "MAT.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àwọn tí wọ́n jẹ́ aláìgbọ́n gbé fìtílà wọn ṣùgbọ́n wọn kò mú epo kankan lọ́wọ́.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.3",
                "verseOrgIds": [
                  "MAT.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àwọn ọlọ́gbọ́n mú epo sínú kólòbó lọ́wọ́ pẹ̀lú fìtílà wọn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.4",
                "verseOrgIds": [
                  "MAT.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà tí ọkọ ìyàwó pẹ́, gbogbo wọn tòògbé wọn sì sùn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.5",
                "verseOrgIds": [
                  "MAT.25.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà tí ó di ọ̀gànjọ́, igbe ta sókè, 'Wò ó, ọkọ ìyàwó ń bọ̀, ẹ jáde sóde láti pàdé rẹ̀.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.6",
                "verseOrgIds": [
                  "MAT.25.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni àwọn wúńdíá sì tají, wọ́n tún fìtílà wọn ṣe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.7",
                "verseOrgIds": [
                  "MAT.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àwọn aláìgbọ́n márùn-ún tí kò ní epo rárá bẹ àwọn ọlọ́gbọ́n pé kí wọn fún àwọn nínú èyí tí wọ́n ní nítorí fìtílà wọn ń kú lọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.8",
                "verseOrgIds": [
                  "MAT.25.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n àwọn ọlọ́gbọ́n márùn-ún dáhùn pé, bẹ́ẹ̀ kọ́; kí ó má ba à ṣe aláìtó fún àwa àti ẹ̀yin, ẹ kúkú tọ àwọn tí ń tà á lọ, kí ẹ sì rà fún ara yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.9",
                "verseOrgIds": [
                  "MAT.25.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ní àsìkò tí wọ́n lọ ra epo tiwọn, ni ọkọ ìyàwó dé. Àwọn wúńdíá tí ó múra tán bá a wọlé sí ibi àsè ìgbéyàwó, lẹ́yìn náà, a sì ti ìlẹ̀kùn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.10",
                "verseOrgIds": [
                  "MAT.25.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ní ìkẹyìn ni àwọn wúńdíá márùn-ún ìyókù dé, wọ́n ń wí pé, 'Olúwa, Olúwa, ṣílẹ̀kùn fún wa.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.11",
                "verseOrgIds": [
                  "MAT.25.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n ọkọ ìyàwó dáhùn pé, 'Lóòótọ́ ni mo wí fún yín èmi kò mọ̀ yín rí.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.12",
                "verseOrgIds": [
                  "MAT.25.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nítorí náà, ẹ máa ṣọ́nà. Nítorí pé ẹ̀yin kò mọ ọjọ́ tàbí wákàtí tí Ọmọ Ènìyàn yóò dé.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.13",
                "verseOrgIds": [
                  "MAT.25.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òwe tálẹ́ǹtì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A sì tún fi ìjọba ọ̀run wé ọkùnrin kan tí ó ń lọ sí ìrìnàjò. Ó pe àwọn ọmọ ọ̀dọ̀ rẹ̀, ó sì kó ohun ìní rẹ̀ fún wọn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.14",
                "verseOrgIds": [
                  "MAT.25.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ó fún ọ̀kan ni tálẹ́ǹtì márùn-ún, ó fún èkejì ni tálẹ́ǹtì méjì, ó sì fún ẹ̀kẹta ni tálẹ́ǹtì kan, ó fún olúkúlùkù gẹ́gẹ́ bí agbára rẹ̀ ti mọ, ó sì lọ ìrìnàjò tirẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.15",
                "verseOrgIds": [
                  "MAT.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọkùnrin tí ó gba tálẹ́ǹtì márùn-ún bẹ̀rẹ̀ lẹ́sẹ̀kẹsẹ̀ láti fi owó náà ṣòwò. Láìpẹ́, ó sì jèrè márùn-ún mìíràn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.16",
                "verseOrgIds": [
                  "MAT.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọkùnrin tí ó gba tálẹ́ǹtì méjì náà fi tirẹ̀ ṣòwò. Láìpẹ́, ó sì jèrè tálẹ́ǹtì méjì mìíràn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.17",
                "verseOrgIds": [
                  "MAT.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ọkùnrin tí ò gba tálẹ́ǹtì kan, ó wa ihò ní ilẹ̀, ó sì bo owó ọ̀gá mọ́ ibẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.18",
                "verseOrgIds": [
                  "MAT.25.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lẹ́yìn ọjọ́ pípẹ́, olúwa àwọn ọmọ ọ̀dọ̀ dé láti àjò rẹ̀. Ó pè wọ́n jọ láti bá wọn ṣírò owó rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.19",
                "verseOrgIds": [
                  "MAT.25.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọkùnrin tí ó gba tálẹ́ǹtì márùn-ún, mú márùn-ún mìíràn padà wá, ó wí pé, 'Olúwa, ìwọ ti fi tálẹ́ǹtì márùn-ún fún mi, mo sì ti jèrè márùn-ún mìíràn pẹ̀lú rẹ̀.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.20",
                "verseOrgIds": [
                  "MAT.25.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Olúwa rẹ̀ wí fún un pé, 'O ṣeun ìwọ ọmọ ọ̀dọ̀ rere àti olóòtítọ́: ìwọ ṣe olóòtítọ́ nínú ohun díẹ̀, èmi yóò fi ọ́ ṣe olórí ohun púpọ̀, bọ́ sínú ayọ̀ olúwa rẹ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.21",
                "verseOrgIds": [
                  "MAT.25.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èyí tí ó gba tálẹ́ǹtì méjì wí pé 'Olúwa, ìwọ fún mi ní tálẹ́ǹtì méjì láti lò, èmi sì ti jèrè tálẹ́ǹtì méjì mìíràn.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.22",
                "verseOrgIds": [
                  "MAT.25.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Olúwa rẹ̀ sì wí fún un pé, 'O ṣeun, ìwọ ọmọ ọ̀dọ̀ rere àti olóòtítọ́. Ìwọ ti jẹ́ olóòtítọ́ nínú ohun díẹ̀, èmi yóò fi ọ ṣe olórí ohun púpọ̀. Ìwọ bọ́ sínú ayọ̀ olúwa rẹ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.23",
                "verseOrgIds": [
                  "MAT.25.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Níkẹyìn, ọkùnrin tí a fún ní tálẹ́ǹtì kan wá, ó wí pé, 'Olúwa, mo mọ̀ pé òǹrorò ènìyàn ni ìwọ ń ṣe ìwọ ń kórè níbi tí ìwọ kò gbìn sí, ìwọ ń kójọ níbi tí ìwọ kò ó ká sí.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.24",
                "verseOrgIds": [
                  "MAT.25.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi bẹ̀rù, mo sì lọ pa tálẹ́ǹtì rẹ mọ́ sínú ilẹ̀. Wò ó, nǹkan rẹ nìyìí.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.25",
                "verseOrgIds": [
                  "MAT.25.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n olúwa rẹ̀ dáhùn pé, 'Ìwọ ọmọ ọ̀dọ̀ búburú, ìwọ mọ̀ pé èmi ń kórè níbi tí èmi kò fúnrúgbìn sì, èmi sì ń kójọ níbi tí èmi kò fọ́nká ká sí.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.26",
                "verseOrgIds": [
                  "MAT.25.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà náà ìwọ ìbá kúkú fi owó mi sí ilé ìfowópamọ́ tí èmi bá dé èmi ìbá le gba owó mi pẹ̀lú èrè.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.27",
                "verseOrgIds": [
                  "MAT.25.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Ó sì pàṣẹ kí a gba tálẹ́ǹtì náà lọ́wọ́ rẹ̀, kí a sì fún ọkùnrin tí ó ní tálẹ́ǹtì mẹ́wàá.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.28",
                "verseOrgIds": [
                  "MAT.25.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ẹnikẹ́ni tí ó bá ní a ó fún sí i, yóò sí tún ní sí lọ́pọ̀lọ́pọ̀. Ṣùgbọ́n láti ọwọ́ ẹni tí kò ní ni a ó ti gbà èyí tí ó ní.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.29",
                "verseOrgIds": [
                  "MAT.25.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ìdí èyí, gbé aláìlérè ọmọ ọ̀dọ̀, jù ú sínú òkùnkùn lóde, ibẹ̀ ni ẹ̀kún òun ìpayínkeke yóò gbé wà.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.30",
                "verseOrgIds": [
                  "MAT.25.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn àgùntàn àti ewúrẹ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ṣùgbọ́n nígbà ti Ọmọ Ènìyàn yóò wá nínú ògo rẹ̀ pẹ̀lú gbogbo àwọn angẹli rẹ̀ nígbà náà ni yóò jókòó lórí ìtẹ́ ògo ní ọ̀run.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.31",
                "verseOrgIds": [
                  "MAT.25.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gbogbo orílẹ̀-èdè ni a ó kójọ níwájú rẹ̀, òun yóò sì ya àwọn ènìyàn ayé sí ọ̀tọ̀ gẹ́gẹ́ bí olùṣọ́-àgùntàn ṣe é ya àgùntàn kúrò lára àwọn ewúrẹ́.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.32",
                "verseOrgIds": [
                  "MAT.25.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Òun yóò sì fi àgùntàn sí ọwọ́ ọ̀tún àti ewúrẹ́ sí ọwọ́ òsì.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.33",
                "verseOrgIds": [
                  "MAT.25.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni ọba yóò wí fún àwọn tí ó wà lọ́wọ́ ọ̀tún pé, 'Ẹ wá, ẹ̀yin tí Baba mi ti bùkún fún, ẹ jogún ìjọba tí a ti pèsè fún yín láti ìpilẹ̀ṣẹ̀ ayé.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.34",
                "verseOrgIds": [
                  "MAT.25.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí ebi pa mi, ẹ̀yin sì fún mi ní oúnjẹ, òǹgbẹ gbẹ mí, ẹ̀yin sì fún mi ní omi. Mo jẹ́ àlejò, ẹ̀yin sì pè mí sínú ilé yín.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.35",
                "verseOrgIds": [
                  "MAT.25.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mo wà ní ìhòhò, ẹ̀yin sì daṣọ bò mí. Nígbà tí mo ṣe àìsàn ẹ ṣe ìtójú mi, àti ìgbà tí mo wà ní ọgbà ẹ̀wọ̀n ẹ̀yin bẹ̀ mí wò.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.36",
                "verseOrgIds": [
                  "MAT.25.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nígbà náà ni àwọn olódodo yóò fèsì pé, 'Olúwa, nígbà wo ni àwa rí ọ tí ebi ń pa ọ́, tí a sì fún ọ ní oúnjẹ? Tàbí tí òǹgbẹ ń gbẹ ọ́ tí a sì fún ọ ní ohun mímu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.37",
                "verseOrgIds": [
                  "MAT.25.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tàbí tí o jẹ́ àlejò tí a gbà ó sínú ilé wa? Tàbí tí o wà ní ìhòhò, tí a sì daṣọ bò ọ́?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.38",
                "verseOrgIds": [
                  "MAT.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà wo ni a tilẹ̀ rí i tí o ṣe àìsàn, tàbí tí o wà ní ọgbà ẹ̀wọ̀n, tí a bẹ̀ ọ́ wò?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.39",
                "verseOrgIds": [
                  "MAT.25.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọba náà yóò sì dáhùn yóò sì wí fún wọn pé, 'Lóòótọ́ ni mo wí fún yín pé níwọ̀n ìgbà tí ẹ̀yin ṣe nǹkan wọ̀nyí fún àwọn arákùnrin mi yìí tí o kéré jú lọ, ẹ̀ ń ṣe wọn fún mi ni.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.40",
                "verseOrgIds": [
                  "MAT.25.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
