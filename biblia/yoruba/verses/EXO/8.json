  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EXO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.1",
                "verseOrgIds": [
                  "EXO.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Padà tọ Farao lọ kí ó sì sọ fún un pé, 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.1",
                "verseOrgIds": [
                  "EXO.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: Jẹ́ kí àwọn ènìyàn mi kí ó lọ, kí wọn ó bá à lè sìn mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.1",
            "verseOrgIds": [
              "EXO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá kọ̀ láti jẹ́ kí wọn ó lọ, èmi yóò fi ọ̀pọ̀lọpọ̀ àwọn ọ̀pọ̀lọ́ kọlu gbogbo orílẹ̀-èdè rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.2",
            "verseOrgIds": [
              "EXO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odò Naili yóò kún fún ọ̀pọ̀lọpọ̀ àwọn ọ̀pọ̀lọ́. Wọn yóò gòkè wá sí ààfin rẹ, àti yàrá rẹ ni orí ibùsùn rẹ. Wọn yóò gòkè wá sí ilé àwọn ìjòyè rẹ àti sí ara àwọn ènìyàn rẹ, àti sí ibi ìdáná rẹ, àti sí inú ìkòkò ìyẹ̀fun rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.3",
            "verseOrgIds": [
              "EXO.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀pọ̀lọ́ yóò gun ara rẹ àti ara àwọn ìjòyè rẹ, àti ara gbogbo àwọn ènìyàn rẹ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.4",
            "verseOrgIds": [
              "EXO.7.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.5",
                "verseOrgIds": [
                  "EXO.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Sọ fún Aaroni, 'Kí ó na ọwọ́ rẹ̀ jáde pẹ̀lú ọ̀pá sí orí àwọn odò kéékèèké àti odò ńlá, àti sí orí àwọn àbàtà kí ó sì mú àwọn ọ̀pọ̀lọ́ gòkè wá sí ilẹ̀ Ejibiti.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni Aaroni sì na ọwọ́ rẹ̀ jáde sí orí àwọn omi Ejibiti, àwọn ọ̀pọ̀lọ́ sì wá, wọ́n sì bo gbogbo ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn onídán ilẹ̀ Ejibiti ṣe bákan náà pẹ̀lú agbára òkùnkùn wọn. Àwọn náà mú kí ọ̀pọ̀lọ́ gún wá sí orí ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao ránṣẹ́ pe Mose àti Aaroni, ó sì sọ fún wọn pé, \"Gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.8",
                "verseOrgIds": [
                  "EXO.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kí ó mú àwọn ọ̀pọ̀lọ́ wọ̀nyí kúrò lọ́dọ̀ mi àti lára àwọn ènìyàn mi, Èmi yóò sì jẹ́ kí àwọn ènìyàn rẹ kí ó lọ láti rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.8",
                "verseOrgIds": [
                  "EXO.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.8",
            "verseOrgIds": [
              "EXO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sọ fún Farao pé, \"Jọ̀wọ́ sọ fún mi ìgbà ti èmi yóò gbàdúrà fún ọ àti àwọn ìjòyè rẹ àti fún àwọn ènìyàn rẹ, kí àwọn ọ̀pọ̀lọ́ wọ̀nyí bá lè lọ lọ́dọ̀ rẹ àti ní àwọn ilé yín tí wọn yóò sì wà nínú odò Naili nìkan.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.9",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao wí pé, \"Ni ọ̀la.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 8:10"
      },
      "items": [
        {
          "text": "Mose sì dáhùn pé, \"Yóò sì rí bí ìwọ ti sọ, kí ìwọ kí ó lè mọ̀ pé kò sí ẹni bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.10",
                "verseOrgIds": [
                  "EXO.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀pọ̀lọ́ yóò fi ìwọ àti àwọn ilé yín àti ìjòyè rẹ, àti àwọn ènìyàn rẹ sílẹ̀, wọn yóò sì wà nínú Naili nìkan.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí Mose àti Aaroni tí kúrò ní iwájú Farao, Mose gbé ohùn ẹ̀bẹ̀ rẹ̀ sókè sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.12",
                "verseOrgIds": [
                  "EXO.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nípa àwọn ọ̀pọ̀lọ́ tí ó ti rán sí Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.12",
            "verseOrgIds": [
              "EXO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.13",
                "verseOrgIds": [
                  "EXO.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ṣe gẹ́gẹ́ bí Mose tí béèrè. Àwọn ọ̀pọ̀lọ́ sì kú nínú ilé àti ní ìta, gbangba àti nínú oko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.13",
            "verseOrgIds": [
              "EXO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì kó wọn jọ ni òkìtì òkìtì gbogbo ilẹ̀ sì ń rùn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.14",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ni ìgbà tí Farao rí pé ìtura dé, ó sé ọkàn rẹ̀ le kò sì fetí sí Mose àti Aaroni gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.15",
                "verseOrgIds": [
                  "EXO.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.15",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kòròrò bo ilẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.16",
                "verseOrgIds": [
                  "EXO.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Sọ fún Aaroni, 'Na ọ̀pá rẹ jáde kí ó sì lu eruku ilẹ̀,' jákèjádò gbogbo ilẹ̀ Ejibiti ni erùpẹ̀ ilẹ̀ yóò ti di kòkòrò-kantíkantí.\" (Kòkòrò kan tí ó ní ìyẹ́ méjì tí ó ṣì ń ta ni.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.16",
            "verseOrgIds": [
              "EXO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì ṣe bẹ́ẹ̀, nígbà tí Aaroni na ọwọ́ rẹ́ jáde pẹ̀lú ọ̀pá ní ọwọ́ rẹ̀, tí ó sì lu eruku ilẹ̀, kòkòrò-kantíkantí sì wà lára àwọn ènìyàn àti àwọn ẹranko wọn. Gbogbo eruku jákèjádò ilẹ̀ Ejibiti ni ó di kòkòrò-kantíkantí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.17",
            "verseOrgIds": [
              "EXO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí àwọn onídán gbìdánwò láti da kòkòrò-kantíkantí pẹ̀lú agbára òkùnkùn wọn, wọn kò le è ṣé.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 8:18"
      },
      "items": [
        {
          "text": "Nígbà tí kòkòrò-kantíkantí sì wà lára àwọn ẹranko wọn,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn onídán sì sọ fún Farao pé, \"Ìka Ọlọ́run ni èyí.\" Ṣùgbọ́n àyà Farao sì yigbì, kò sì fetísílẹ̀, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.19",
                "verseOrgIds": [
                  "EXO.8.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn eṣinṣin bo ilẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.20",
                "verseOrgIds": [
                  "EXO.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Lọ ní òwúrọ̀ kùtùkùtù kí o sì ko Farao lójú bí ó ṣe ń lọ sí odò, kí o sì sọ fún un pé, 'Èyí ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.20",
                "verseOrgIds": [
                  "EXO.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ: Jẹ́ kí àwọn ènìyàn mi kí ó lọ, kí wọn kí ó bá à lè sìn Mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.20",
            "verseOrgIds": [
              "EXO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ kò bá jẹ́ kí àwọn ènìyàn Mi kí ó lọ, èmi yóò rán ọ̀pọ̀lọpọ̀ eṣinṣin sí ara rẹ àti sí ara àwọn ìjòyè rẹ, àti sí ara àwọn ènìyàn rẹ̀, sí àwọn ilẹ̀ rẹ̀. Gbogbo ilé àwọn ará Ejibiti ni yóò kún fún eṣinṣin àti orí ilẹ̀ tí wọ́n wà pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.21",
            "verseOrgIds": [
              "EXO.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n ni ọjọ́ náà, Èmi yóò ya ilẹ̀ Goṣeni sọ́tọ̀, níbi tí àwọn ènìyàn mi ń gbé, ọ̀wọ́ eṣinṣin kankan ki yóò dé ibẹ̀. Kí ìwọ kí ó lè mọ̀ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.22",
                "verseOrgIds": [
                  "EXO.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", mo wà ni ilẹ̀ yìí.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò pààlà sáàárín àwọn ènìyàn mi àti àwọn ènìyàn rẹ. Àwọn iṣẹ́ ìyanu yìí yóò ṣẹlẹ̀ ni ọ̀la.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.23",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.24",
                "verseOrgIds": [
                  "EXO.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ṣe èyí. Ọ̀pọ̀lọpọ̀ eṣinṣin sì ya wọ ààfin Farao àti sí ilé àwọn ìjòyè rẹ̀. Gbogbo ilẹ̀ Ejibiti bàjẹ́ pẹ̀lú ọ̀wọ́ eṣinṣin wọ̀n-ọn-nì.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.24",
            "verseOrgIds": [
              "EXO.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Farao ránṣẹ́ pe Mose àti Aaroni, ó sì wí fún wọn pé, \"Ẹ máa lọ kí ẹ sì rú ẹbọ sí Ọlọ́run yín ní ilẹ̀ yìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Mose sọ pé, \"Èyí ló tọ́, ẹbọ tí a ó rú sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.26",
                "verseOrgIds": [
                  "EXO.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa yóò jẹ́ ohun ìríra sí àwọn ará ilẹ̀ Ejibiti. Bí a bá ṣe ìrúbọ ti yóò jẹ́ ìríra ni ojú wọn ṣé wọn, ó ní sọ òkúta lù wá?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbọdọ̀ lọ ni ìrìn ọjọ́ mẹ́ta sí inú aginjù láti rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.27",
                "verseOrgIds": [
                  "EXO.8.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run gẹ́gẹ́ bí ó ti pàṣẹ fún wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Farao wí pé, \"Èmi yóò jẹ́ ki ẹ lọ rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.28",
                "verseOrgIds": [
                  "EXO.8.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín nínú aginjù, ṣùgbọ́n ẹ kò gbọdọ̀ rìn jìnnà jù. Ẹ gbàdúrà fún mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.28",
            "verseOrgIds": [
              "EXO.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose dáhùn ó wí pé, \"Bí èmi bá ti kúrò ní ọ̀dọ̀ rẹ, èmi yóò gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.29",
                "verseOrgIds": [
                  "EXO.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", àwọn ọ̀wọ́ eṣinṣin yóò fi Farao, àwọn ìjòyè rẹ, àti àwọn ènìyàn rẹ sílẹ̀ ní ọ̀la ṣùgbọ́n ǹjẹ́ ìdánilójú wa pé Farao kò tún ni lo ẹ̀tàn láti má jẹ́ kí àwọn ènìyàn kí ó lọ rú ẹbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.29",
                "verseOrgIds": [
                  "EXO.8.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.29",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose kúrò ni ọ̀dọ̀ Farao, ó sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.30",
                "verseOrgIds": [
                  "EXO.8.26"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.30",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.8.31",
                "verseOrgIds": [
                  "EXO.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sì ṣe gẹ́gẹ́ bí Mose ti béèrè. Àwọn ọ̀wọ́ eṣinṣin kúrò lára Farao àti àwọn ìjòyè rẹ̀ àti lára àwọn ènìyàn rẹ̀ pẹ̀lú, eṣinṣin kan kò sì ṣẹ́kù.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ni àkókò yìí náà, Farao sé ọkàn rẹ le, kò sì jẹ́ kí àwọn ènìyàn ó lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.32",
            "verseOrgIds": [
              "EXO.8.28"
            ]
          }
        }
      ]
    }
