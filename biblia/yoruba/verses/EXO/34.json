  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "EXO 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òkúta wàláà tuntun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.1",
                "verseOrgIds": [
                  "EXO.34.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"E gé òkúta wàláà méjì jáde bí i ti àkọ́kọ́, Èmi yóò sì kọ àwọn ọ̀rọ̀ ìwé tó wà lára tí àkọ́kọ́ tí ìwọ ti fọ́ sára wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.1",
            "verseOrgIds": [
              "EXO.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Múra ní òwúrọ̀, kí o sì wá sórí òkè Sinai. Kí o fi ara rẹ hàn mí lórí òkè náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.2",
            "verseOrgIds": [
              "EXO.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni kò gbọdọ̀ wá pẹ̀lú rẹ tàbí kí a rí wọn lórí òkè náà; bẹ́ẹ̀ ni agbo àgùntàn tàbí ọwọ́ ẹran kó má ṣe jẹ níwájú òkè náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.3",
            "verseOrgIds": [
              "EXO.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ Mose sì gbẹ́ òkúta wàláà méjì bí ti àkọ́kọ́, ó sì gun orí òkè Sinai lọ ní kùtùkùtù òwúrọ̀, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.4",
                "verseOrgIds": [
                  "EXO.34.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pa á láṣẹ fún un; Ó sì gbé òkúta wàláà méjèèjì náà sí ọwọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.4",
            "verseOrgIds": [
              "EXO.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.5",
                "verseOrgIds": [
                  "EXO.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ̀kalẹ̀ nínú àwọsánmọ̀, ó sì dúró níbẹ̀ pẹ̀lú rẹ̀, ó sì pòkìkí orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.5",
                "verseOrgIds": [
                  "EXO.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.5",
            "verseOrgIds": [
              "EXO.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì kọjá níwájú Mose, ó sì ń ké pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.6",
                "verseOrgIds": [
                  "EXO.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.6",
                "verseOrgIds": [
                  "EXO.34.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run aláàánú àti olóore-ọ̀fẹ́, Ẹni tí ó lọ́ra láti bínú, tí ó pọ̀ ní ìfẹ́ àti olóòtítọ́,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.6",
            "verseOrgIds": [
              "EXO.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ń pa ìfẹ́ mọ́ fún ẹgbẹ̀rún (1,000), ó sì ń dáríjì àwọn ẹni búburú, àwọn ti ń ṣọ̀tẹ̀ àti ẹlẹ́ṣẹ̀. Síbẹ̀ kì í fi àwọn ẹlẹ́bi sílẹ̀ láìjìyà; Ó ń fi ìyà jẹ ọmọ àti àwọn ọmọ wọn fún ẹ̀ṣẹ̀ àwọn baba dé ìran kẹta àti ẹ̀kẹrin.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.7",
            "verseOrgIds": [
              "EXO.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose foríbalẹ̀ lẹ́ẹ̀kan náà ó sì sìn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.8",
            "verseOrgIds": [
              "EXO.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Olúwa, bí èmi bá rí ojúrere rẹ, nígbà náà jẹ́ kí Olúwa lọ pẹ̀lú wa. Bí ó tilẹ̀ jẹ́ pé, ènìyàn ọlọ́rùn líle ni wọn, dárí búburú àti ẹ̀ṣẹ̀ wa jì, kí o sì gbà wá gẹ́gẹ́ bí ìní rẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.9",
            "verseOrgIds": [
              "EXO.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.10",
                "verseOrgIds": [
                  "EXO.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, \"Èmi dá májẹ̀mú kan pẹ̀lú yín. Níwájú gbogbo ènìyàn rẹ Èmi yóò ṣe ìyanu, tí a kò tí ì ṣe ní orílẹ̀-èdè ní gbogbo ayé rí. Àwọn ènìyàn tí ìwọ ń gbé láàrín wọn yóò rí i bí iṣẹ́ tí Èmi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.10",
                "verseOrgIds": [
                  "EXO.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò ṣe fún ọ ti ní ẹ̀rù tó.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.10",
            "verseOrgIds": [
              "EXO.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe ohun tí Èmi pàṣẹ fún ọ lónìí. Èmi lé àwọn ará Amori, àwọn ará Kenaani, àwọn ará Peresi, àwọn ará Hiti, àwọn ará Hifi àti àwọn ará Jebusi jáde níwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.11",
            "verseOrgIds": [
              "EXO.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Máa ṣọ́ra kí o má ba à bá àwọn ti ó n gbé ilẹ̀ náà tí ìwọ ń lọ dá májẹ̀mú, nítorí wọn yóò jẹ́ ìdẹwò láàrín rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.12",
            "verseOrgIds": [
              "EXO.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wó pẹpẹ wọn lulẹ̀, fọ́ òkúta mímọ́ wọn, kí o sì gé òpó Aṣerah wọn. (Ère òrìṣà wọn.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.13",
            "verseOrgIds": [
              "EXO.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe sin ọlọ́run mìíràn, nítorí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.14",
                "verseOrgIds": [
                  "EXO.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", orúkọ ẹni ti ń jẹ́ Òjòwú, Ọlọ́run owú ni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.14",
            "verseOrgIds": [
              "EXO.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Máa ṣọ́ra kí ẹ má ṣe bá àwọn ènìyàn tí ń gbé ilẹ̀ náà dá májẹ̀mú; nígbà tí wọ́n bá ń ṣe àgbèrè tọ òrìṣà wọn, tí wọ́n sì rú ẹbọ sí wọn, wọn yóò pè yín, ẹ̀yin yóò sì jẹ ẹbọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.15",
            "verseOrgIds": [
              "EXO.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìwọ bá yàn nínú àwọn ọmọbìnrin wọn fún àwọn ọmọkùnrin rẹ ní ìyàwó, àwọn ọmọbìnrin wọ̀nyí yóò ṣe àgbèrè tọ òrìṣà wọn, wọn yóò sì mú kí àwọn ọmọkùnrin yín náà ṣe bẹ́ẹ̀ gẹ́gẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.16",
            "verseOrgIds": [
              "EXO.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìwọ kò gbọdọ̀ dá ère òrìṣàkórìṣà fún ara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.17",
            "verseOrgIds": [
              "EXO.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àjọ àkàrà àìwú ni kí ìwọ máa pamọ́. Fún ọjọ́ méje ni ìwọ yóò jẹ àkàrà aláìwú, gẹ́gẹ́ bí Èmi ti pa á láṣẹ fún ọ. Ṣe èyí ní ìgbà tí a yàn nínú oṣù Abibu, nítorí ní oṣù náà ni ẹ jáde láti Ejibiti wá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.18",
            "verseOrgIds": [
              "EXO.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gbogbo àkọ́bí inú kọ̀ọ̀kan tèmi ní i ṣe, pẹ̀lú àkọ́bí gbogbo ohun ọ̀sìn rẹ, bóyá ti màlúù tàbí ti àgùntàn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.19",
            "verseOrgIds": [
              "EXO.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àkọ́bí kẹ́tẹ́kẹ́tẹ́ ni kí ìwọ kí ó fi ọ̀dọ́-àgùntàn rà padà, ṣùgbọ́n bí ìwọ kò bá rà á padà, dá ọrùn rẹ̀. Ra gbogbo àkọ́bí ọkùnrin rẹ padà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 34:20"
      },
      "items": [
        {
          "text": "\"Ẹnikẹ́ni kò gbọdọ̀ wá síwájú mi ní ọwọ́ òfo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.20",
            "verseOrgIds": [
              "EXO.34.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọjọ́ mẹ́fà ni ìwọ yóò ṣiṣẹ́, ṣùgbọ́n ní ọjọ́ keje ìwọ yóò sinmi; kódà ní àkókò ìfúnrúgbìn àti ní àkókò ìkórè ìwọ gbọdọ̀ sinmi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.21",
            "verseOrgIds": [
              "EXO.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣe àjọ ọ̀sẹ̀ pẹ̀lú àkọ́so èso alikama àti àjọ ìkórè ní òpin ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.22",
            "verseOrgIds": [
              "EXO.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ẹ̀ẹ̀mẹ́ta lọ́dún, gbogbo àwọn ọkùnrin ni kí ó farahàn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.23",
                "verseOrgIds": [
                  "EXO.34.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè, Ọlọ́run Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.23",
            "verseOrgIds": [
              "EXO.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò lé orílẹ̀-èdè jáde níwájú rẹ, Èmi yóò sì mú kí ìpín rẹ fẹ̀, ẹnikẹ́ni kì yóò gba ilẹ̀ rẹ nígbà tí ìwọ bá gòkè lọ ní ìgbà mẹ́ta lọ́dún kọ̀ọ̀kan láti farahàn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.24",
                "verseOrgIds": [
                  "EXO.34.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.24",
            "verseOrgIds": [
              "EXO.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Má ṣe ta ẹ̀jẹ̀ ẹbọ sí mi pẹ̀lú ohunkóhun tí ó bá ní ìwúkàrà, kí o má sì ṣe jẹ́ kí ẹbọ ìrékọjá kù títí di òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.25",
            "verseOrgIds": [
              "EXO.34.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mú àkọ́ká èso ilẹ̀ rẹ tí ó dára jùlọ wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.26",
                "verseOrgIds": [
                  "EXO.34.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 34:26"
      },
      "items": [
        {
          "text": "\"Ìwọ kò gbọdọ̀ bọ ọmọ ewúrẹ́ nínú omi ọmú ìyá rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.27",
                "verseOrgIds": [
                  "EXO.34.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wí fún Mose pé, \"Kọ àwọn ọ̀rọ̀ wọ̀nyí sílẹ̀, nítorí nípa àwọn ọ̀rọ̀ wọ̀nyí ni Èmi bá ìwọ àti Israẹli dá májẹ̀mú.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wà níbẹ̀ pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.28",
                "verseOrgIds": [
                  "EXO.34.28"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ogójì ọ̀sán àti ogójì òru láìjẹ oúnjẹ tàbí mu omi. Ó sì kọ ọ̀rọ̀ májẹ̀mú náà òfin mẹ́wàá sára wàláà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dídán ojú Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Mose sọ̀kalẹ̀ láti orí òkè Sinai pẹ̀lú wàláà ẹ̀rí méjì ní ọwọ́ rẹ̀, òun kò mọ̀ pé ojú òun ń dán nítorí ó bá",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.29",
                "verseOrgIds": [
                  "EXO.34.29"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.29",
            "verseOrgIds": [
              "EXO.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Aaroni àti gbogbo àwọn ọmọ Israẹli rí Mose, ojú rẹ̀ ń dán, ẹ̀rù sì ń bà wọ́n láti súnmọ́ ọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.30",
            "verseOrgIds": [
              "EXO.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Mose pè wọn; Aaroni àti gbogbo àwọn olórí àjọ padà wá bá a, ó sì bá wọn sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.31",
            "verseOrgIds": [
              "EXO.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí gbogbo àwọn ọmọ Israẹli súnmọ́ ọn, ó sì fún wọn ní gbogbo àṣẹ tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.32",
                "verseOrgIds": [
                  "EXO.34.32"
                ]
              }
            }
          ]
        },
        {
          "text": "fún un lórí òkè Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.32",
            "verseOrgIds": [
              "EXO.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Mose parí ọ̀rọ̀ sísọ fún wọn. Ó fi ìbòjú bo ojú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.33",
            "verseOrgIds": [
              "EXO.34.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 34:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbàkígbà tí Mose bá wà níwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.34",
                "verseOrgIds": [
                  "EXO.34.34"
                ]
              }
            }
          ]
        },
        {
          "text": "láti bá a sọ̀rọ̀, á ṣí ìbòjú náà títí yóò fi jáde. Nígbà tí ó bá sì jáde, á sì sọ fún àwọn ọmọ Israẹli ohun tí a ti pàṣẹ fún un,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.34",
            "verseOrgIds": [
              "EXO.34.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 34:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn ọmọ Israẹli sì rí i pé ojú rẹ̀ ń dán. Mose á sì tún fi ìbòjú bo ojú rẹ̀ títí á fi lọ bá",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.34.35",
                "verseOrgIds": [
                  "EXO.34.35"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
        }
      ]
    }
  ],
