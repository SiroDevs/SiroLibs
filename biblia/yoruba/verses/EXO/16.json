  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "EXO 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oúnjẹ láti ọ̀run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìjọ àwọn ọmọ Israẹli mú ọ̀nà wọn pọ̀n kúrò ni Elimu, wọ́n dé sí ijù Sini tí ó wà láàrín Elimu àti Sinai, ni ọjọ́ kẹ́ẹ̀dógún oṣù kejì tí wọ́n jáde kúrò ni ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.1",
            "verseOrgIds": [
              "EXO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìjọ àwọn ọmọ Israẹli sì ń kùn sí Mose àti Aaroni ní ijù náà.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.2",
            "verseOrgIds": [
              "EXO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli wí fún wọn pé, \"Àwa ìbá ti ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.3",
                "verseOrgIds": [
                  "EXO.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kú ni Ejibiti! Níbi tí àwa ti jókòó ti ìkòkò ẹran ti a sì ń jẹ ohun gbogbo tí a fẹ́ ni àjẹyó, ṣùgbọ́n ẹ̀yin mú wa wá sí inú ijù yìí láti fi ebi pa wá tí a ó fi kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.4",
            "verseOrgIds": [
              "EXO.16.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.4",
                "verseOrgIds": [
                  "EXO.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé, \"Èmi yóò rọ òjò oúnjẹ láti ọ̀run wá fún yín. Àwọn ènìyàn yóò sì máa jáde lọ ni ọjọ́ kọ̀ọ̀kan láti kó ìwọ̀nba oúnjẹ ti ó tó fún oúnjẹ òòjọ́ wọn. Ní ọ̀nà yìí ni, èmi yóò fi dán wọn wò láti mọ bóyá wọn yóò máa tẹ̀lé ìlànà mi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.4",
            "verseOrgIds": [
              "EXO.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹfà, ki wọn kó ìlọ́po méjì èyí tiwọn ń ko ni ojoojúmọ́ tẹ́lẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
            "verseOrgIds": [
              "EXO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose àti Aaroni sọ fún gbogbo àwọn ọmọ Israẹli pé, \"Ní ìrọ̀lẹ́, ẹ̀yin yóò mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.6",
                "verseOrgIds": [
                  "EXO.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó mú un yín jáde láti Ejibiti wá.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òwúrọ̀, ẹ̀yin yóò ri ògo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.7",
                "verseOrgIds": [
                  "EXO.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí òun ti gbọ́ kíkùn tí ẹ kùn sí i. Ta ni àwa ti ẹ̀yin yóò máa kùn sí wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose tún wí pé, \"Ẹ̀yin yóò mọ pé",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.8",
                "verseOrgIds": [
                  "EXO.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni, nígbà ti ó bá fún un yín ni ẹran ni ìrọ̀lẹ́ àti gbogbo oúnjẹ ti ẹ̀yin ń fẹ́ ni òwúrọ̀, nítorí kíkùn ti ẹ̀yin ń kùn sí i. Ta ni àwa? Ẹ̀yin kò kùn sí àwa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.8",
                "verseOrgIds": [
                  "EXO.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ẹ̀yin kùn sí i.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose sọ fún Aaroni pe, \"Sọ fún gbogbo ìjọ àwọn ọmọ Israẹli pe, 'Ẹ wá sí iwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.9",
                "verseOrgIds": [
                  "EXO.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", nítorí òun ti gbọ́ kíkùn yín.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe bí Aaroni ti ń bá gbogbo ìjọ àwọn ọmọ Israẹli sọ̀rọ̀, wọn si bojú wo ìhà ijù, sì kíyèsi ògo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.10",
                "verseOrgIds": [
                  "EXO.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "si farahàn ni àwọsánmọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.11",
                "verseOrgIds": [
                  "EXO.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Mose pé,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.11",
            "verseOrgIds": [
              "EXO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi ti gbọ́ kíkùn àwọn ọmọ Israẹli. Sọ fun wọn, 'Ní àṣálẹ́, ẹ̀yin yóò jẹ ẹran, àti ni òwúrọ̀ ni ẹ̀yin yóò jẹ oúnjẹ. Nígbà náà ni ẹ̀yin yóò mọ̀ pé Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.12",
                "verseOrgIds": [
                  "EXO.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àṣálẹ́ ọjọ́ náà ni àwọn àparò fò dé, wọ́n sì bo àgọ́ mọ́lẹ̀, ní òwúrọ̀ ìrì sì sẹ̀ yí gbogbo àgọ́ náà ká.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
            "verseOrgIds": [
              "EXO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ìrì tí ó sẹ̀ bo ilẹ̀ ti lọ, kíyèsi i, ohun tí ó dì, tí ó sì ń yooru bí i yìnyín wà lórí ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.14",
            "verseOrgIds": [
              "EXO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ Israẹli rí i, wọ́n bi ara wọn léèrè pé, \"Kí ni èyí?\" Nítorí pé wọn kò mọ ohun tí i ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 16:15"
      },
      "items": [
        {
          "text": "Mose sì wí fún wọn pé, \"Èyí ni oúnjẹ tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.15",
                "verseOrgIds": [
                  "EXO.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fún un yín láti jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.16",
                "verseOrgIds": [
                  "EXO.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ, 'Kí olúkúlùkù máa kó èyí ti ó tó fún un láti jẹ. Ẹ mú òsùwọ̀n omeri kan fún ẹnìkọ̀ọ̀kan ti ó wà nínú àgọ́ yín.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli sì ṣe bí a ti sọ fún wọn; àwọn kan kó púpọ̀, àwọn kan kó kékeré.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n fi òsùwọ̀n omeri wọ̀n-ọ́n, ẹni tí ó kó púpọ̀ kò ní púpọ̀ jù, bẹ́ẹ̀ ni ẹni tí ó kó ìwọ̀nba kò ní kéré jù. Ẹnìkọ̀ọ̀kan kó ìwọ̀nba ti ó tó fún un.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì wí fún wọ́n pé, \"Kí ẹnikẹ́ni ó má ṣe kó pamọ́ lára rẹ̀ di òwúrọ̀ ọjọ́ kejì.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n, àwọn kan nínú wọn kò fetí sí Mose, wọ́n kó lára rẹ̀ pamọ́ di òwúrọ̀ ọjọ́ kejì, ohun ti wọ́n kó pamọ́ kún fún ìdin, ó sì ti bẹ̀rẹ̀ sí ní rùn. Nítorí náà Mose bínú sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní òwúrọ̀, ni ojoojúmọ́ ni ẹnìkọ̀ọ̀kan ń lọ kó ìwọ̀nba ti ó tó fún un láti jẹ, bí oòrùn bá sì mú, a sì yọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹfà, wọ́n kó ìlọ́po méjì èyí tiwọn ń kó tẹ́lẹ̀: òsùwọ̀n omeri méjì fún ẹnìkọ̀ọ̀kan; àwọn olórí ìjọ ènìyàn sì wá, wọ́n sì sọ èyí fún Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.22",
            "verseOrgIds": [
              "EXO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún wọn pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.23",
                "verseOrgIds": [
                  "EXO.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ: 'Ọ̀la jẹ́ ọjọ́ ìsinmi, ìsinmi mímọ́ fún",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.23",
                "verseOrgIds": [
                  "EXO.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ẹ yan èyí ti ẹ̀yin ní yan, kí ẹ sì bọ èyí ti ẹ̀yin ní bọ̀. Ẹ tọ́jú èyí ti ó kù sílẹ̀, kí ẹ pa á mọ́ di òwúrọ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì tọ́jú rẹ̀ di òwúrọ̀ bí Mose ti pàṣẹ; kò sì rùn bẹ́ẹ̀ ni kò sì ní ìdin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.24",
            "verseOrgIds": [
              "EXO.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose sì wí fún wọn pé, \"Ẹ jẹ ẹ́ ní òní nítorí òní jẹ́ ọjọ́ ìsinmi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.25",
            "verseOrgIds": [
              "EXO.16.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.25",
                "verseOrgIds": [
                  "EXO.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ẹ̀yin kò ni rí i ni orí ilẹ̀ ní ọjọ́ òní.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.25",
            "verseOrgIds": [
              "EXO.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ mẹ́fà ni kí ẹ fi kó o, ṣùgbọ́n ni ọjọ́ keje ọjọ́ ìsinmi, kò ní sí i fún un yín ni ọjọ́ náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀síbẹ̀ àwọn ènìyàn kan jáde lọ ní ọjọ́ keje láti kó o, ṣùgbọ́n wọn kò ri nǹkan kan kó.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
            "verseOrgIds": [
              "EXO.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.28",
                "verseOrgIds": [
                  "EXO.16.28"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Mose pé, \"Yóò ti pẹ́ tó ti ẹ ó kọ̀ láti pa àṣẹ mi àti ìlànà mi mọ́?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò ó?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.29",
                "verseOrgIds": [
                  "EXO.16.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fún un yín ni ọjọ́ ìsinmi, nítorí náà, ni ọjọ́ kẹfà, ó fún un yín ni oúnjẹ ọjọ́ méjì; kí ẹnìkọ̀ọ̀kan dúró ni ibi tí ó gbé wà; kí ẹ má ṣe kúrò ni ibi tí ẹ wà ni ọjọ́ keje.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, àwọn ènìyàn sinmi ní ọjọ́ keje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ènìyàn Israẹli sì pe oúnjẹ náà ní manna. Ó funfun bí irúgbìn korianderi, ó sì dùn bí àkàrà fẹ́lẹ́fẹ́lẹ́ ti a fi oyin ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wí pé, \"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.32",
                "verseOrgIds": [
                  "EXO.16.32"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ, 'Ẹ mú òsùwọ̀n omeri manna kí ẹ sì pa á mọ́ de àwọn ìran ti ń bọ̀, kí wọn kí ó lè rí oúnjẹ ti èmi fi fún un yín jẹ ní ijù, nígbà tí mo mú un yín jáde ni ilẹ̀ Ejibiti.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Mose sọ fún Aaroni pe, \"Mú ìkòkò kan, kí o sì kó manna tí ó kún òsùwọ̀n omeri kan sí inú rẹ̀, kí o sì gbé e kalẹ̀ ni iwájú",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.33",
                "verseOrgIds": [
                  "EXO.16.33"
                ]
              }
            }
          ]
        },
        {
          "text": "láti tọ́jú rẹ̀ pamọ́ de àwọn ìran ti ń bọ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EXO.16.34",
                "verseOrgIds": [
                  "EXO.16.34"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Mose, Aaroni gbé manna sí iwájú ẹ̀rí láti pa á mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ará Israẹli jẹ manna fún ogójì ọdún títí wọ́n fi dé ilẹ̀ Kenaani ni ibi ti èso ti wà fún wọn láti jẹ, wọ́n jẹ manna títí tí wọ́n fi dé ilẹ̀ agbègbè Kenaani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Òsùwọ̀n omeri kan sì jẹ́ ìdákan nínú ìdámẹ́wàá efa.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.36",
            "verseOrgIds": [
              "EXO.16.36"
            ]
          }
        }
      ]
    }
