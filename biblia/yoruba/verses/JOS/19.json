          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbò kéje jáde fún ẹ̀yà Dani, ní agbo ilé ní agbo ilé.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ ìní wọn nìwọ̀nyí:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:41"
      },
      "items": [
        {
          "text": "Sora, Eṣtaoli, Iri-Ṣemesi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣaalabini, Aijaloni, Itila,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eloni, Timna, Ekroni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elteke, Gibetoni, Baalati,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehudu, Bene-Beraki, Gati-Rimoni,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me Jakoni àti Rakkoni, pẹ̀lú ilẹ̀ tí ó kọjú sí Joppa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ṣùgbọ́n àwọn ará Dani ní ìṣòro láti gba ilẹ̀ ìní wọn, bẹ́ẹ̀ ni wọ́n gòkè lọ, wọ́n sì kọlu Leṣemu, wọ́n sì gbà á, wọ́n sì fi idà kọlù ú, wọ́n sì ń gbé ibẹ̀. Wọ́n sì ń gbé ní Leṣemu, wọ́n sì pe orúkọ rẹ̀ ní Dani orúkọ baba ńlá wọn).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìlú wọ́n yí àti ìletò wọn ní ìní ẹ̀yà Dani, ní agbo ilé agbo ilé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín fún ẹ̀yà Joṣua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n ti parí pínpín ilẹ̀ náà ní ìpín ti olúkúlùkù, àwọn ará Israẹli fún Joṣua ọmọ Nuni ní ìní ní àárín wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.19.50",
                "verseOrgIds": [
                  "JOS.19.50"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ, wọ́n fún un ni ìlú tí ó béèrè fún, Timnati Serah ní ìlú òkè Efraimu. Ó sì kọ́ ìlú náà, ó sì ń gbé ibẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí ni àwọn ilẹ̀ tí Eleasari àlùfáà, Joṣua ọmọ Nuni àti àwọn olórí ẹ̀yà agbo ilé Israẹli fi ìbò pín ní Ṣilo ní iwájú",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ẹnu-ọ̀nà àgọ́ ìpàdé. Báyìí ni wọ́n parí pínpín ilẹ̀ náà.",
          "type": "text"
        }
      ]
    }
