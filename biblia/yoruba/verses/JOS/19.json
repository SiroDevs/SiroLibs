{
  "id": "JOS.19",
  "number": "19",
  "bookId": "JOS",
  "reference": "Joṣua 19",
  "copyright": "Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní™ Ẹ̀tọ́ àdàkọ © 2009, 2017 Biblica, Inc. Biblica® Open Yoruba Contemporary Bible™ Copyright © 2009, 2017 by Biblica, Inc. ‪\"Biblica\" ni àmì ìdámọ̀ tí Biblica, Inc. fi sílẹ̀ ní United States Patent àti ní ilé iṣẹ́ tí wọ́n ti ń fúnni ní àmì ìdámọ̀. Gba àṣẹ kí o tó lòó. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOS 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín ti ẹ̀yà Simeoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kèké kejì jáde fún ẹ̀yà Simeoni, ní agbo ilé, ní agbo ilé. Ìní wọn sì wà ní àárín ilẹ̀ Juda.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára ìpín wọn ní:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:2"
      },
      "items": [
        {
          "text": "Beerṣeba (tàbí Ṣeba), Molada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.2",
            "verseOrgIds": [
              "JOS.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasari-Ṣuali, Bala, Esemu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.3",
            "verseOrgIds": [
              "JOS.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eltoladi, Betuli, Horma,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.4",
            "verseOrgIds": [
              "JOS.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siklagi, Beti-Markaboti, Hasari Susa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.5",
            "verseOrgIds": [
              "JOS.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti-Lebaoti àti Ṣarueli, ìlú wọn jẹ́ mẹ́tàlá àti ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.6",
            "verseOrgIds": [
              "JOS.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aini, Rimoni, Eteri àti Aṣani, ìlú wọn jẹ́ mẹ́rin àti ìletò wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.7",
            "verseOrgIds": [
              "JOS.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti gbogbo àwọn agbègbè ìlú wọ̀nyí títí dé Baalati-Beeri (Rama ní gúúsù).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.8",
            "verseOrgIds": [
              "JOS.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 19:8"
      },
      "items": [
        {
          "text": "Èyí ni ilẹ̀ ìní ẹ̀yà àwọn ọmọ Simeoni, agbo ilé, ní agbo ilé.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mú ogún ìní àwọn ọmọ Simeoni láti ìpín Juda, nítorí ìpín Juda pọ̀ ju èyí tí wọ́n nílò lọ. Báyìí ni àwọn ọmọ Simeoni gba ìní wọn ní àárín ilẹ̀ Juda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín fún ẹ̀yà Sebuluni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kèké kẹta jáde fún Sebuluni, ní agbo ilé ní agbo ilé",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:10"
      },
      "items": [
        {
          "text": "ààlà ìní wọn sì lọ títí dé Saridi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.10",
            "verseOrgIds": [
              "JOS.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lọ sí ìwọ̀-oòrùn ní Marala, ó sì dé Dabbeṣeti, ó sì lọ títí dé odo ní ẹ̀bá Jokneamu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.11",
            "verseOrgIds": [
              "JOS.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì yípadà sí ìlà-oòrùn láti Saridi sí ìhà ìlà-oòrùn dé ilẹ̀ Kisiloti-Tabori, ó sì lọ sí Daberati, ó sì gòkè lọ sí Jafia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.12",
            "verseOrgIds": [
              "JOS.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní o lọ sí ìhà ìlà-oòrùn lọ sí Gati-Heferi àti Eti-Kaṣini, ó sì jáde ní Rimoni, ó sì yí sí ìhà Nea.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.13",
            "verseOrgIds": [
              "JOS.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ibẹ̀, ààlà sì yíká ní ìhà àríwá lọ sí Hnatoni ó sì pín ní àfonífojì Ifita-Eli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.14",
            "verseOrgIds": [
              "JOS.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára wọn ni Katati, Nahalali, Ṣimroni, Idala àti Bẹtilẹhẹmu. Wọ́n sì jẹ́ ìlú méjìlá àti ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú wọ̀nyí àti ìletò wọn jẹ́ ìní Sebuluni, ní agbo ilé agbo ilé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín fún ẹ̀yà Isakari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kèké kẹrin jáde fún Isakari, agbo ilé ní agbo ilé.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára ilẹ̀ wọn ni èyí:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:18"
      },
      "items": [
        {
          "text": "Jesreeli, Kesuloti, Ṣunemu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.18",
            "verseOrgIds": [
              "JOS.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafraimu, Ṣihoni, Anaharati,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.19",
            "verseOrgIds": [
              "JOS.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabiti, Kiṣioni, Ebesi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.20",
            "verseOrgIds": [
              "JOS.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remeti, Eni-Gannimu, Eni-Hada àti Beti-Pasesi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.21",
            "verseOrgIds": [
              "JOS.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ààlà náà sì dé Tabori, Ṣahasuma, àti Beti-Ṣemeṣi, ó sì pin ní Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:22"
      },
      "items": [
        {
          "text": "Wọ́n sì jẹ́ ìlú mẹ́rìndínlógún àti ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìlú wọ̀nyí àti ìletò wọn jẹ́ ìní ẹ̀yà Isakari, ní agbo ilé agbo ilé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín fún ẹ̀yà Aṣeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kèké karùn-ún jáde fún ẹ̀yà Aṣeri, ní agbo ilé agbo ilé.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lára ilẹ̀ wọn ni èyí:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:25"
      },
      "items": [
        {
          "text": "Helikati, Hali, Beteni, Akṣafu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Allameleki, Amadi, àti Miṣali. Ní ìhà ìwọ̀-oòrùn ààlà náà dé Karmeli àti Ṣihori-Libinati.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni o yí sí ìhà ìlà-oòrùn Beti-Dagoni, dé Sebuluni àti àfonífojì Ifita-Eli, ó sì lọ sí àríwá sí Beti-Emeki àti Neieli, ó sì kọjá lọ sí Kabulu ní apá òsì.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì lọ sí Abdoni, Rehobu, Hammoni àti Kana títí dé Sidoni ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ààlà náà sì tẹ̀ sí ìhà Rama, ó sì lọ sí ìlú olódi Tire, ó sì yà sí Hosa, ó sì jáde ní Òkun Ńlá ní ilẹ̀ Aksibu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uma, Afeki àti Rehobu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:30"
      },
      "items": [
        {
          "text": "Wọ́n sì jẹ́ ìlú méjìlélógún àti ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìlú wọ̀nyí àti ìletò wọn ní ìní ẹ̀yà Aṣeri, ní agbo ilé agbo ilé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín fún ẹ̀yà Naftali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìpín kẹfà jáde fún Naftali, agbo ilé ní agbo ilé,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ààlà wọn lọ láti Helefi àti igi ńlá ní Saananimu nímù; kọjá lọ sí Adami Nekebu àti Jabneeli dé Lakkumu, ó sì pín ní Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ààlà náà gba ìhà ìwọ̀-oòrùn lọ sí Asnoti-Tabori ó sì jáde ní Hukoki. Ó sì dé Sebuluni, ní ìhà gúúsù Aṣeri ní ìhà ìwọ̀-oòrùn àti Juda ní Jordani ní ìhà ìlà-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìlú olódi sì Siddimu, Seri, Hamati, Rakàti, Kinnereti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adama, Rama Hasori,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.36",
            "verseOrgIds": [
              "JOS.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedeṣi, Edrei, Eni-Aṣọri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.37",
            "verseOrgIds": [
              "JOS.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ironi, Migdali-Eli, Horemu, Beti-Anati àti Beti-Ṣemeṣi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:38"
      },
      "items": [
        {
          "text": "Wọ́n sì jẹ́ ìlú mọ́kàndínlógún àti ìletò wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìlú wọ̀nyí àti ìletò wọn ní ìní ẹ̀yà Naftali, ní agbo ilé sí agbo ilé.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpín fún ẹ̀yà Dani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
