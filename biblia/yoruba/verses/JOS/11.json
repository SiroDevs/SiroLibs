              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ní Joṣua sì gba gbogbo ilẹ̀ náà, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
