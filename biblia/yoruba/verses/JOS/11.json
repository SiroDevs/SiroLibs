              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ará Anaki kankan tí ó ṣẹ́kù ní ilẹ̀ Israẹli: bí kò ṣe ní Gasa, Gati àti Aṣdodu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
