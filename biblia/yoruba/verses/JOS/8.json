          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìparun Ai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.1",
            "verseOrgIds": [
              "JOS.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.1",
                "verseOrgIds": [
                  "JOS.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Joṣua pé, \"Má ṣe bẹ̀rù, kí àyà kí ó má ṣe fò ọ́. Kó gbogbo àwọn ọmọ-ogun pẹ̀lú rẹ, kí ẹ gòkè lọ gbógun ti Ai. Nítorí mo ti fi ọba Ai, àwọn ènìyàn rẹ̀, ìlú u rẹ̀ àti ilẹ̀ ẹ rẹ̀ lé ọ lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.1",
            "verseOrgIds": [
              "JOS.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì ṣe sí Ai àti ọba rẹ̀ gẹ́gẹ́ bí ìwọ ti ṣe sí Jeriko àti ọba rẹ̀, ohun ìkógun wọn àti ohun ọ̀sìn wọn ni kí ẹ̀yin mú fún ara yín. Rán ènìyàn kí wọ́n ba sí ẹ̀yìn ìlú náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ní Joṣua àti gbogbo àwọn ọmọ-ogun jáde lọ láti dojúkọ Ai. Ó sì yan ẹgbàá mẹ́ẹ̀ẹ́dógún (30,000) àwọn ọkùnrin ogun rẹ̀ ti ó yakin, ó sì rán wọn lọ ní òru.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.3",
            "verseOrgIds": [
              "JOS.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú àwọn àṣẹ wọ̀nyí: \"Ẹ fi etí sílẹ̀ dáradára. Ẹ ba sí ẹ̀yìn ìlú náà. Ẹ má ṣe jìnnà sí i púpọ̀. Kí gbogbo yín wà ní ìmúrasílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.4",
            "verseOrgIds": [
              "JOS.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi àti gbogbo àwọn tí ó wà pẹ̀lú mi yóò súnmọ́ ìlú náà, nígbà tí àwọn ọkùnrin náà bá jáde sí wa, gẹ́gẹ́ bí wọ́n ti ṣe ní ìṣáájú, àwa yóò sì sá kúrò níwájú u wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.5",
            "verseOrgIds": [
              "JOS.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò sì lépa wa títí àwa ó fi tàn wọ́n jáde kúrò ní ìlú náà, nítorí tí wọn yóò wí pé, wọ́n ń sálọ kúrò ní ọ̀dọ̀ wa gẹ́gẹ́ bí wọ́n tí ṣe ní ìṣáájú. Nítorí náà bí a bá sá kúrò fún wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.6",
            "verseOrgIds": [
              "JOS.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹ̀yin yóò dìde kúrò ní ibùba, ẹ ó sì gba ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.7",
            "verseOrgIds": [
              "JOS.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.7",
                "verseOrgIds": [
                  "JOS.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín yóò sì fi lé e yín lọ́wọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.7",
            "verseOrgIds": [
              "JOS.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ bá ti gba ìlú náà, kí ẹ sì ti iná bọ̀ ọ́. Kí ẹ ṣe ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.8",
            "verseOrgIds": [
              "JOS.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.8",
                "verseOrgIds": [
                  "JOS.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ. Mo ti fi àṣẹ fún un yín ná.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.8",
            "verseOrgIds": [
              "JOS.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Joṣua rán wọn lọ. Wọ́n sì lọ sí ibùba, wọ́n sì sùn ní àárín Beteli àti Ai, ní ìwọ̀-oòrùn Ai. Ṣùgbọ́n Joṣua wá dúró pẹ̀lú àwọn ènìyàn ní òru ọjọ́ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní kùtùkùtù òwúrọ̀ ọjọ́ kejì Joṣua kó àwọn ọmọ-ogun rẹ̀, òun àti àwọn olórí Israẹli, wọ́n wọ́de ogun lọ sí Ai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.10",
            "verseOrgIds": [
              "JOS.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn ọmọ-ogun tí ó wà pẹ̀lú u rẹ̀ sì gòkè lọ, wọ́n sì súnmọ́ tòsí ìlú náà, wọ́n sì dé iwájú u rẹ̀. Wọ́n sì pàgọ́ ní ìhà àríwá Ai. Àfonífojì sì wà ní agbede-méjì wọn àti ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.11",
            "verseOrgIds": [
              "JOS.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua sì ti fi bí ẹgbẹ̀rún márùn-ún (5,000) ọmọ-ogun pamọ́ sí àárín Beteli àti Ai, sí ìwọ̀-oòrùn ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.12",
            "verseOrgIds": [
              "JOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì yan àwọn ọmọ-ogun sí ipò wọn, gbogbo àwọn tí ó wà ní ibùdó lọ sí àríwá ìlú náà àti àwọn tí ó sá pamọ́ sí ìwọ̀-oòrùn rẹ̀. Ní òru ọjọ́ náà Joṣua lọ sí àfonífojì.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.13",
            "verseOrgIds": [
              "JOS.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọba Ai rí èyí, òun àti gbogbo ọkùnrin ìlú náà yára jáde ní òwúrọ̀ kùtùkùtù láti pàdé ogun Israẹli ní pẹ̀tẹ́lẹ̀ aginjù. Ṣùgbọ́n kò mọ̀ pé àwọn kan wà ní ibùba ní ẹ̀yìn ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.14",
            "verseOrgIds": [
              "JOS.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua àti gbogbo àwọn Israẹli sì ṣe bí ẹni tí a lé padà níwájú wọn, wọ́n sì sá gba ọ̀nà aginjù.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.15",
            "verseOrgIds": [
              "JOS.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì pe gbogbo àwọn ọkùnrin Ai jọ láti lépa wọn, wọ́n sì lépa Joṣua títí wọ́n fi tàn wọ́n jáde nínú ìlú náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.16",
            "verseOrgIds": [
              "JOS.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sì ku ọkùnrin kan ní Ai tàbí Beteli tí kò tẹ̀lé Israẹli. Wọ́n sì fi ìlẹ̀kùn ibodè ìlú náà sílẹ̀ ní ṣíṣí, wọ́n sì ń lépa àwọn ará Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.18",
                "verseOrgIds": [
                  "JOS.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Joṣua pé, \"Na ọ̀kọ̀ tí ó wà lọ́wọ́ rẹ sí Ai, nítorí tí èmi yóò fi ìlú náà lé ọ ní ọwọ́.\" Bẹ́ẹ̀ ni Joṣua sì na ọ̀kọ̀ ọwọ́ rẹ̀ sí Ai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ti ṣe èyí tán, àwọn ọkùnrin tí ó ba sì dìde kánkán kúrò ní ipò wọn, wọ́n sáré síwájú. Wọn wọ ìlú náà, wọ́n gbà á, wọ́n sì yára ti iná bọ̀ ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.19",
            "verseOrgIds": [
              "JOS.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọkùnrin Ai bojú wo ẹ̀yìn, wọ́n rí èéfín ìlú náà ń gòkè lọ sí ọ̀run, ṣùgbọ́n wọn kò rí, ààyè láti sá àsálà lọ sí ibìkan kan, nítorí tí àwọn ará Israẹli tí wọ́n tí ń sálọ sí aginjù ti yípadà sí àwọn tí ń lépa wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.20",
            "verseOrgIds": [
              "JOS.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Joṣua àti gbogbo àwọn ará Israẹli rí i pé àwọn tí ó bá ti gba ìlú náà, tí èéfín ìlú náà sì ń gòkè, wọ́n yí padà wọ́n sì kọlu àwọn ọkùnrin Ai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.21",
            "verseOrgIds": [
              "JOS.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ogun tí ó ba náà sì yípadà sí wọn láti inú ìlú náà, bẹ́ẹ̀ ni wọ́n wà ní agbede-méjì àwọn ará Israẹli ní ìhà méjèèjì. Israẹli sì pa wọ́n, bẹ́ẹ̀ ni wọn kò sì jẹ́ kí ọ̀kan kí ó yè tàbí kí ó sálọ nínú wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.22",
            "verseOrgIds": [
              "JOS.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n wọ́n mú ọba Ai láààyè, wọ́n sì mu un tọ Joṣua wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.23",
            "verseOrgIds": [
              "JOS.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Israẹli parí pípa gbogbo àwọn ìlú Ai ní pápá àti ní aginjù ní ibi tí wọ́n ti lépa wọn lọ, tí gbogbo wọ́n sì ti ojú idà ṣubú, tí a fi pa gbogbo wọn tan, gbogbo àwọn Israẹli sì padà sí Ai, wọ́n sì fi ojú idà kọlù ú.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.24",
            "verseOrgIds": [
              "JOS.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹgbàá mẹ́fà (12,000) ọkùnrin àti obìnrin ni ó kú ní ọjọ́ náà—gbogbo wọn jẹ́ àwọn ènìyàn Ai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.25",
            "verseOrgIds": [
              "JOS.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí Joṣua kò fa ọwọ́ rẹ̀ tí ó di ọ̀kọ̀ mú sí ẹ̀yìn, títí ó fi pa gbogbo àwọn tí ń gbé ìlú Ai run.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.26",
            "verseOrgIds": [
              "JOS.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Israẹli kó ẹran ọ̀sìn àti ìkógun ti ìlú yìí fún ara wọn, gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.27",
                "verseOrgIds": [
                  "JOS.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún Joṣua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua sì jó Ai, ó sì sọ ọ́ di ààtàn, àní ahoro di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
            "verseOrgIds": [
              "JOS.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì gbé ọba Ai kọ́ orí igi, ó sì fi kalẹ̀ síbẹ̀ títí di ìrọ̀lẹ́. Bí oòrùn sì ti wọ̀ ni Joṣua pàṣẹ fún wọn láti sọ òkú rẹ̀ kalẹ̀ kúrò ní orí igi, kí wọn sì wọ́ ọ jù sí àtiwọ ẹnu ibodè ìlú náà. Wọ́n sì kó òkìtì òkúta ńlá lé e ní orí, èyí tí ó wà títí di òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Májẹ̀mú tí a sọ di ọ̀tun ní orí òkè Ebali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Joṣua mọ pẹpẹ kan fún",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.30",
                "verseOrgIds": [
                  "JOS.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli, ní òkè Ebali,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "gẹ́gẹ́ bí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.31",
                "verseOrgIds": [
                  "JOS.8.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ fún àwọn ọmọ Israẹli. Ó sì kọ́ ọ́ gẹ́gẹ́ bí a ti kọ́ nínú ìwé òfin Mose, pẹpẹ odindi òkúta, èyí tí ẹnìkan kò fi ohun èlò irin kàn rí. Wọ́n sì rú ọrẹ ẹbọ sísun àti ọrẹ àlàáfíà ní orí rẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.31",
                "verseOrgIds": [
                  "JOS.8.31"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀, ní ojú àwọn ará Israẹli, Joṣua sì ṣe àdàkọ òfin Mose èyí tí ó ti kọ sí ara òkúta náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo Israẹli, àjèjì àti ọmọ ìlú, pẹ̀lú àwọn àgbàgbà, olórí àti onídàájọ́ dúró ní ẹ̀gbẹ́ méjèèjì àpótí ẹ̀rí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.33",
                "verseOrgIds": [
                  "JOS.8.33"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó kọjú sí àwọn àlùfáà tí ó rù ú, tí wọ́n jẹ́ ọmọ Lefi. Ìdajì àwọn ènìyàn náà dúró ní òkè Gerisimu, àwọn ìdajì si dúró ni òkè Ebali, gẹ́gẹ́ bí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.8.33",
                "verseOrgIds": [
                  "JOS.8.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ti pàṣẹ rí, pé kí wọn súre fún àwọn ènìyàn Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn èyí, Joṣua sì ka gbogbo ọ̀rọ̀ inú òfin, ìbùkún àti ègún, gẹ́gẹ́ bí a ti kọ ọ́ nínú ìwé òfin.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ọ̀rọ̀ kan nínú gbogbo èyí tí Mose pàṣẹ tí Joṣua kò kà ní iwájú gbogbo àjọ Israẹli, títí fi kan àwọn obìnrin àti àwọn ọmọ wọn, àti àwọn àjèjì tí ń gbé ní àárín wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
      ]
    }
  ],
