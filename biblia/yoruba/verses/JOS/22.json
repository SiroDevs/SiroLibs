  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOS 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn ẹ̀yà ti ìlà-oòrùn padà sí ilẹ̀ ìní wọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joṣua sì pe àwọn ẹ̀yà Reubeni, ẹ̀yà Gadi àti ìdajì ẹ̀yà Manase",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó sì sọ fún wọn pé, \"Ẹ̀yin ti ṣe gbogbo èyí tí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.2",
                "verseOrgIds": [
                  "JOS.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pàṣẹ, ẹ sì ti ṣe ìgbọ́ràn sí ohun gbogbo tí mo pàṣẹ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ kò fi àwọn arákùnrin yín sílẹ̀ láti ìgbà yí títí di òní, ṣùgbọ́n ẹ ti kíyèsára láti pa òfin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.3",
                "verseOrgIds": [
                  "JOS.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí tí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.4",
                "verseOrgIds": [
                  "JOS.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín ti fún àwọn arákùnrin yín ní ìsinmi gẹ́gẹ́ bí ó ti ṣèlérí, ẹ padà sí ilẹ̀ yín níbi tí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.4",
                "verseOrgIds": [
                  "JOS.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fún yin ní òdìkejì Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ ṣọ́ra gidigidi láti pa àṣẹ àti òfin tí Mose ìránṣẹ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.5",
                "verseOrgIds": [
                  "JOS.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "fi fún yin mọ́. Láti fẹ́ràn",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.5",
                "verseOrgIds": [
                  "JOS.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run yín, láti rìn nínú gbogbo ọ̀nà rẹ̀, láti gbọ́rọ̀ sí àṣẹ rẹ̀, láti dìímú ṣinṣin àti láti sìn ín pẹ̀lú gbogbo ọkàn yín àti gbogbo àyà yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Joṣua súre fún wọn, ó sì jẹ́ kí wọn máa lọ sí ilẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Mose ti fi ilẹ̀ fún ìdajì ẹ̀yà Manase ní Baṣani, Joṣua sì ti fún ìdajì ẹ̀yà yòókù ní ilẹ̀ ní ìwọ̀-oòrùn Jordani, pẹ̀lú àwọn arákùnrin wọn). Joṣua súre fún wọn ó sì jẹ́ kí wọn máa lọ sí ilẹ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.7",
            "verseOrgIds": [
              "JOS.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí pé, \"Ẹ padà sí ilẹ̀ ẹ yín pẹ̀lú ọrọ̀ púpọ̀ yín, pẹ̀lú agbo ẹran ọ̀sìn, pẹ̀lú fàdákà, wúrà, idẹ àti irin, àti ọ̀pọ̀lọpọ̀ aṣọ, kí ẹ sì pín ìkógun tí ẹ rí gbà láti ọ̀dọ̀ àwọn ọ̀tá yín pẹ̀lú àwọn arákùnrin yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni àwọn ẹ̀yà Reubeni, ẹ̀yà Gadi àti ìdajì ẹ̀yà Manase fi àwọn ará Israẹli sílẹ̀ ní Ṣilo ní Kenaani láti padà sí Gileadi, ilẹ̀ wọn, èyí tí wọ́n ti gbà gẹ́gẹ́ bí àṣẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.9",
                "verseOrgIds": [
                  "JOS.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "láti ẹnu Mose wá.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n wá dé Geliloti ní ẹ̀bá Jordani ní ilẹ̀ Kenaani, àwọn ẹ̀yà Reubeni, ẹ̀yà Gadi àti ìdajì ẹ̀yà Manase mọ pẹpẹ ńlá tí ó tóbi kan ní ẹ̀bá Jordani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.10",
            "verseOrgIds": [
              "JOS.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ Israẹli gbọ́ pé àwọn ọmọ Reubeni, àti àwọn ọmọ Gadi àti ìlàjì ẹ̀yà Manase mọ pẹpẹ kan dojúkọ ilẹ̀ Kenaani ní Geliloti ní ẹ̀bá Jordani ní ìhà kejì àwọn ọmọ Israẹli,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbogbo àjọ Israẹli péjọ ní Ṣilo láti lọ bá wọn jagun.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ Israẹli rán Finehasi ọmọ Eleasari àlùfáà, sí ilẹ̀ Gileadi, sí Reubeni, sí Gadi àti sí ìdajì ẹ̀yà Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú rẹ̀ wọ́n rán àwọn ọkùnrin olóyè mẹ́wàá, ẹnìkan fún ẹ̀yà Israẹli kọ̀ọ̀kan, olórí ọ̀kọ̀ọ̀kan tiwọn jẹ́ olórí ìdílé láàrín àwọn ọmọ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n lọ sí Gileadi—sí Reubeni, Gadi àti ìdajì ẹ̀yà Manase—wọ́n sì sọ fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gbogbo àjọ ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.16",
                "verseOrgIds": [
                  "JOS.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pe, 'A fẹ́ mọ ìdí tí ẹ fi sẹ̀ sí Ọlọ́run Israẹli nípa yíyí padà kúrò lọ́dọ̀ rẹ̀ tí ẹ sì kọ́ pẹpẹ ìṣọ̀tẹ̀ ní ìlòdì sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.16",
                "verseOrgIds": [
                  "JOS.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀ṣẹ̀ Peori kò ha tó fún wa bí? Títí di òní yìí àwa kò tí ì wẹ ara wa mọ́ kúrò nínú ẹ̀ṣẹ̀ náà, bí ó tilẹ̀ jẹ́ pé àjàkálẹ̀-ààrùn ti jà láàrín ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.17",
                "verseOrgIds": [
                  "JOS.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣé ẹ tún wá ń padà kúrò lẹ́yìn",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.18",
                "verseOrgIds": [
                  "JOS.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ni báyìí?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 22:18"
      },
      "items": [
        {
          "text": "\" 'Tí ẹ̀yin bá ṣọ̀tẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.18",
                "verseOrgIds": [
                  "JOS.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ní òní, ní ọ̀la ní òun o bínú sí gbogbo ìpéjọpọ̀ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ilẹ̀ ìní yín bá di àìmọ́, ẹ wá sí orí ilẹ̀ ìní",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", ní ibi tí àgọ́",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "dúró sí, kí ẹ sì pín ilẹ̀ náà pẹ̀lú wa. Ṣùgbọ́n kí ẹ má ṣe ṣọ̀tẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "tàbí sí wa nípa mímọ pẹpẹ fún ara yín, lẹ́yìn pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Akani ọmọ Sera ṣe àìṣòótọ́ nípa ohun ìyàsọ́tọ̀, ǹjẹ́ ìbínú kò wá sí orí gbogbo àjọ ènìyàn Israẹli nítorí rẹ̀ bí? Òun nìkan kọ́ ni ó kú fún ẹ̀ṣẹ̀ ẹ rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Reubeni, Gadi àti ẹ̀yà Manase sọ nínú ìdáhùn wọn fún àwọn olórí Israẹli pé.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.21",
            "verseOrgIds": [
              "JOS.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn ọlọ́run!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn ọlọ́run, Òun mọ̀, jẹ́ kí Israẹli pẹ̀lú kí ó mọ̀! Bí èyí bá wà ní ìṣọ̀tẹ̀ tàbí àìgbọ́ràn sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹ má ṣe gbà wa ní òní yìí.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá ti mọ pẹpẹ wa láti yí padà kúrò ní ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.23",
                "verseOrgIds": [
                  "JOS.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": "àti láti rú ẹbọ sísun àti ẹbọ oúnjẹ jíjẹ, tàbí ẹbọ àlàáfíà ní orí rẹ, kí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.23",
                "verseOrgIds": [
                  "JOS.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ara rẹ̀ gba ẹ̀san.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bẹ́ẹ̀ kọ́! Àwa ṣe èyí ní ìbẹ̀rù pé ní ọjọ́ tí àwọn ọmọ yín yóò wí fún wa pé, 'Kí ni ẹ̀yin ní ṣe pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.24",
                "verseOrgIds": [
                  "JOS.22.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi Jordani ṣe ààlà láàrín àwa àti ẹ̀yin—àwọn ọmọ Reubeni àti àwọn ọmọ Gadi! Ẹ kò ni ní ìpín nínú",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".' Bẹ́ẹ̀ ni àwọn ọmọ yín lè mú kí àwọn ọmọ wa dẹ́kun láti máa bẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí èyí ni àwa ṣe wí pé, 'Ẹ jẹ́ kí àwa múra láti mọ pẹpẹ kan, ṣùgbọ́n kì í ṣe fún ẹbọ sísun, tàbí fún àwọn ìrúbọ.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.26",
            "verseOrgIds": [
              "JOS.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọ̀nà mìíràn, yóò jẹ́ ẹ̀rí kan láàrín àwa àti ẹ̀yin àti àwọn ìran tí ń bọ̀, pé àwa yóò jọ́sìn fún",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.27",
                "verseOrgIds": [
                  "JOS.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ibi mímọ́ rẹ̀ pẹ̀lú ẹbọ sísun wa, ẹbọ àti ọrẹ àlàáfíà. Nígbà náà ni ẹ̀yìn ọ̀la, àwọn ọmọ yín kò ní lè sọ fún tiwa pé, 'Ẹ kò ní ìpín nínú ti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.27",
                "verseOrgIds": [
                  "JOS.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": ".'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwa sì wí pé, 'Tí wọ́n bá tilẹ̀ sọ èyí fún wa, tàbí sí àwọn ọmọ wa, a ó dáhùn pé, \"Ẹ wo àpẹẹrẹ pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.28",
                "verseOrgIds": [
                  "JOS.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", èyí tí àwọn baba wa mọ, kì í ṣe fún ẹbọ sísun àti ẹbọ ṣùgbọ́n fún ẹ̀rí láàrín àwa àti ẹ̀yin.\" '",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kí Ọlọ́run má jẹ́ kí àwa kí ó ṣọ̀tẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.29",
                "verseOrgIds": [
                  "JOS.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí àwa sì yípadà kúrò ní ọ̀dọ̀ rẹ ní òní nípa mímọ pẹpẹ ẹbọ sísun, ọrẹ oúnjẹ jíjẹ àti ẹbọ lẹ́yìn pẹpẹ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.29",
                "verseOrgIds": [
                  "JOS.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa tí ó dúró níwájú àgọ́ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Finehasi àlùfáà àti àwọn olórí ìjọ ènìyàn, àwọn olórí ìdílé Israẹli gbọ́ ohun tí Reubeni, Gadi àti Manase ti sọ, ó dùn mọ́ wọn.",
          "type": "text",
          "attrs": {
