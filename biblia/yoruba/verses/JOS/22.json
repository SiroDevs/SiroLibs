                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú wa, nítorí tí ẹ̀yin kò hùwà àìṣòótọ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
