          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò náà Joṣua sì búra pé, \"Ègún ni fún ẹni náà níwájú",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.26",
                "verseOrgIds": [
                  "JOS.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "tí yóò dìde, tí yóò sì tún ìlú Jeriko kọ́:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "\"Pẹ̀lú ikú àkọ́bí ọmọ rẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "yóò fi pilẹ̀ rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "ikú àbíkẹ́yìn rẹ̀ ní yóò fi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOS 6:26"
      },
      "items": [
        {
          "text": "gbé ìlẹ̀kùn bodè rẹ̀ ró.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
      ]
    },
    {
