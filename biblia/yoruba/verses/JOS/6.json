                "verseOrgIds": [
                  "JOS.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "wà pẹ̀lú Joṣua; òkìkí rẹ̀ sì kàn ká gbogbo ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
