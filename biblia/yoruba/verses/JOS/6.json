          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
