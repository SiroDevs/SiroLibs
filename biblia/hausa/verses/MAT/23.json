              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, malaman dokoki da Farisiyawa, munafukai! Kukan wanke bayan kwaf da kwano, amma a ciki, cike suke da zalunci da sonkai.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.25",
                "verseOrgIds": [
                  "MAT.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
