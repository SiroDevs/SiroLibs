        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama ina gaya muku, ba za ku sāke ganina ba sai kun ce, 'Mai albarka ne wanda yake zuwa cikin sunan Ubangiji.' \"",
