          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To, sai ku ci gaba ku cikasa ayyukan da kakanninku suka fara!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.32",
                "verseOrgIds": [
