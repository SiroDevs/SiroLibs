          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ta haka alhakin jinin masu adalcin da aka zubar a duniya, tun daga jinin Habila mai adalci, zuwa jinin Zakariya ɗan Berekiya, wanda kuka kashe tsakanin haikali da bagade zai koma kanku.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.35",
                "verseOrgIds": [
                  "MAT.23.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
