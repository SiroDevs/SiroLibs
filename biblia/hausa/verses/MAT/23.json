          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ta haka kuna ba da shaida a kanku cewa ku zuriyar waɗanda suka karkashe annabawa ne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.31",
                "verseOrgIds": [
