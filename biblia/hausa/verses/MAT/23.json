        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku macizai! 'Ya'yan macizai! Ta yaya za ku tsere wa hukuncin jahannama ta wuta?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.33",
                "verseOrgIds": [
                  "MAT.23.33"
                ]
