            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'an nan Yesu ya ce wa taron mutane da kuma almajiransa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Malaman dokoki da Farisiyawa suke zama a kujerar Musa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.2",
                "verseOrgIds": [
                  "MAT.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Saboda haka dole ku yi musu biyayya, ku kuma yi duk abin da suka faɗa muku. Sai dai kada ku yi abin da suke yi, gama ba sa yin abin da suke wa'azi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.3",
                "verseOrgIds": [
                  "MAT.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sukan ɗaura kaya masu nauyi, su sa wa mutane a kafaɗa. Amma su kansu, ba sa ko sa yatsa su taimaka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.4",
                "verseOrgIds": [
                  "MAT.23.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kome suke yi, suna yi ne don mutane su gani. Sukan yi layunsu",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.5",
                "verseOrgIds": [
                  "MAT.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "fantam-fantam bakin rigunarsu kuma sukan kai har ƙasa;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.5",
                "verseOrgIds": [
                  "MAT.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "suna son wurin zaman manya a wurin biki, da kuma wuraren zama gaba-gaba a majami'u;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.6",
                "verseOrgIds": [
                  "MAT.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "suna so a yi ta gaisuwarsu a kasuwa, ana kuma riƙa ce musu, 'Rabbi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.7",
                "verseOrgIds": [
                  "MAT.23.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma kada a kira ku 'Rabbi,' gama kuna da Maigida ɗaya ne, ku duka kuwa, 'yan'uwa ne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.8",
                "verseOrgIds": [
                  "MAT.23.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kada kuma ku kira wani a duniya 'uba,' gama kuna da Uba ɗaya ne, yana kuwa a sama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.9",
                "verseOrgIds": [
                  "MAT.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ba kuwa za a kira ku 'malam' ba, gama kuna da Malami ɗaya ne, Kiristi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.10",
                "verseOrgIds": [
                  "MAT.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mafi girma a cikinku, zai zama bawanku.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.11",
                "verseOrgIds": [
                  "MAT.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama duk wanda ya ɗaukaka kansa, za a ƙasƙantar da shi, duk kuma wanda ya ƙasƙantar da kansa, za a ɗaukaka shi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.12",
                "verseOrgIds": [
                  "MAT.23.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, malaman dokoki da Farisiyawa, ku munafukai! Kun rufe ƙofar mulkin sama a gaban mutane. Ku kanku ba ku shiga ba, ba kuwa bar waɗanda suke ƙoƙarin shiga su shiga ba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.13",
                "verseOrgIds": [
                  "MAT.23.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, malaman dokoki da Farisiyawa, munafukai! Kukan yi tafiye-tafiye zuwa ƙasashe, ku ƙetare teku don ku sami mai tuba ɗaya, sa'ad da ya tuba kuwa, sai ku mai da shi ɗan wuta fiye da ku, har sau biyu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.15",
                "verseOrgIds": [
                  "MAT.23.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, makafi jagora! Kukan ce, 'In wani ya rantse da haikali, ba damuwa; amma in ya rantse da zinariyar haikali, sai rantsuwar ta kama shi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.16",
                "verseOrgIds": [
                  "MAT.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wawaye makafi! Wanne ya fi girma, zinariyar, ko haikalin da yake tsarkake zinariyar?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.17",
                "verseOrgIds": [
                  "MAT.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kukan kuma ce, 'In wani ya rantse da bagade, ba damuwa; amma in ya rantse da bayarwar da take bisansa, sai rantsuwar ta kama shi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.18",
                "verseOrgIds": [
                  "MAT.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Makafi kawai! Wanne ya fi girma, bayarwar, ko kuwa bagaden da yake tsarkake bayarwar?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.19",
                "verseOrgIds": [
                  "MAT.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Saboda haka, duk wanda ya rantse da bagade, ya rantse ne da bagaden tare da abin da yake bisansa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.20",
                "verseOrgIds": [
                  "MAT.23.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kuma duk wanda ya rantse da haikali, ya rantse ne da shi da kuma wanda yake zaune a cikinsa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.21",
                "verseOrgIds": [
                  "MAT.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Duk kuma wanda ya rantse da sama, ya rantse ne da kursiyin Allah da kuma wanda yake zaune a kansa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.22",
