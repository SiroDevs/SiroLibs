        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Saboda haka ina aika muku da annabawa, da masu hikima da malamai. Waɗansunsu za ku kashe ku kuma gicciye; waɗansu kuma za ku yi musu bulala a majami'unku kuna kuma binsu gari-gari.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.34",
                "verseOrgIds": [
                  "MAT.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
