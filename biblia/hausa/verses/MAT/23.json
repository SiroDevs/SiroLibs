          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, malaman dokoki da Farisiyawa, munafukai! Kukan ba da kashi ɗaya bisa goma na kayan yajinku, na'ana'a, anise, da lafsur. Amma kun ƙyale abubuwan da suka fi girma na dokoki, adalci, jinƙai da aminci. Waɗannan ne ya kamata da kun kiyaye ba tare da kun ƙyale sauran ba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.23",
                "verseOrgIds": [
                  "MAT.23.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
