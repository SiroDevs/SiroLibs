              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, malaman dokoki da Farisiyawa, munafukai! Kukan gina kaburbura don annabawa, ku kuma yi wa kaburburan mutane masu adalci ado.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.29",
                "verseOrgIds": [
