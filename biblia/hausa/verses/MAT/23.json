          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kuna cewa, 'Da mun kasance a zamanin kakanninmu, ai, da ba mu haɗa hannu da su muka karkashe annabawa ba.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.30",
                "verseOrgIds": [
                  "MAT.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
