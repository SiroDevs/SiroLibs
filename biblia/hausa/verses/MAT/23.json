              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kaitonku, malaman dokoki da Farisiyawa, munafukai! Kuna kama da kaburburan da aka shafa musu farin fenti, waɗanda suna da kyan gani a waje, amma a ciki, cike suke da ƙasusuwan matattu da kuma kowane irin abu mai ƙazanta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
                  "MAT.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
