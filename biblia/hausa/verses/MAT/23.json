        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Haka ku ma, a waje, a idon mutane, ku masu adalci ne, amma a ciki, cike kuke da munafunci da mugunta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.28",
                "verseOrgIds": [
                  "MAT.23.28"
                ]
              }
            }
          ]
        }
