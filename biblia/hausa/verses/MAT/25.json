              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "da nake bukatar tufafi, kun yi mini sutura, da na yi rashin lafiya, kun lura da ni, da nake kurkuku, kun ziyarce ni.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.36",
                "verseOrgIds": [
                  "MAT.25.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
