        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sa'an nan masu adalci za su amsa masa, su ce, 'Ubangiji, yaushe muka gan ka da yunwa muka ciyar da kai, ko da ƙishirwa muka ba ka abin sha?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.37",
                "verseOrgIds": [
                  "MAT.25.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaushe kuma muka gan ka baƙo muka karɓe ka, ko cikin bukatar tufafi muka yi maka sutura?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.38",
                "verseOrgIds": [
                  "MAT.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yaushe kuma muka gan ka cikin rashin lafiya ko a kurkuku muka ziyarce ka?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.39",
                "verseOrgIds": [
                  "MAT.25.39"
                ]
