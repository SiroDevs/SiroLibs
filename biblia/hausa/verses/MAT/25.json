              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama da nake jin yunwa, ba ku ba ni abinci ba, da nake jin ƙishirwa, ba ku ba ni abin sha ba,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.42",
                "verseOrgIds": [
