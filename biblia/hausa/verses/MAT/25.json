        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sa'an nan zai ce wa waɗanda suke a hagunsa, 'Ku rabu da ni, la'anannu, zuwa cikin madawwamiyar wutar da aka shirya don Iblis da mala'ikunsa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.41",
                "verseOrgIds": [
