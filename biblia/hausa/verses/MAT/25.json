          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ku jefar da banzan bawan nan waje, cikin duhu, inda za a yi kuka da cizon haƙora.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.30",
