          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zai amsa, yă ce, 'Gaskiya nake gaya muku, duk abin da ba ku yi wa ɗaya daga cikin waɗannan mafi ƙanƙanta ba, ba ku yi mini ba ke nan.'",
              "type": "text",
              "attrs": {
