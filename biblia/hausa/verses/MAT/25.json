        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Su ma za su amsa, su ce, 'Ubangiji, yaushe muka gan ka cikin yunwa ko ƙishirwa ko baƙo ko cikin bukatar tufafi ko cikin rashin lafiya ko cikin kurkuku, ba mu taimake ka ba?'",
