        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sa'an nan Sarki zai ce wa waɗanda suke damansa, 'Ku zo, ku da Ubana ya yi wa albarka; ku karɓi gādonku, mulkin da aka shirya muku tun halittar duniya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.34",
                "verseOrgIds": [
                  "MAT.25.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama da nake jin yunwa, kun ciyar da ni, da nake jin ƙishirwa, kun ba ni abin sha, da nake baƙunci, kun karɓe ni,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.35",
                "verseOrgIds": [
                  "MAT.25.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
