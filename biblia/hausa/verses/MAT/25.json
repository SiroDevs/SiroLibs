        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sarkin zai amsa ya ce, 'Gaskiya nake gaya muku, duk abin da kuka yi wa ɗaya daga cikin waɗannan 'yan'uwana mafi ƙanƙanta, ni kuka yi wa.'",
              "type": "text",
