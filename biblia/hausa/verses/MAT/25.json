          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama duk mai abu za a ƙara masa, zai kuma same shi a yawalce. Duk wanda ba shi da shi kuwa, ko ɗan abin da yake da shi ma, sai an karɓe masa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.29",
                "verseOrgIds": [
