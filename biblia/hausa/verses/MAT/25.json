        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Karɓi talentin daga hannunsa ku ba wanda yake da talenti goma.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.28",
                "verseOrgIds": [
                  "MAT.25.28"
                ]
              }
            }
          ]
