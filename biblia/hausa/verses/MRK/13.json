          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zai kuma aiko mala'ikunsa su tattaro zaɓaɓɓunsa daga kusurwoyi huɗun nan, daga iyakar duniya har yă zuwa iyakar sama.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.27",
                "verseOrgIds": [
                  "MRK.13.27"
                ]
              }
            }
          ]
