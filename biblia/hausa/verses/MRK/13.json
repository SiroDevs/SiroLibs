              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Da ba don Ubangiji ya rage kwanakin nan ba, da ba wani da zai tsira. Amma saboda zaɓaɓɓu waɗanda ya zaɓa, sai ya rage kwanakin.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.20",
                "verseOrgIds": [
                  "MRK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A lokacin nan, in wani ya ce muku, 'Duba, ga Kiristi nan!' Ko kuwa, 'Duba, ga shi can!' Kada ku gaskata.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.21",
                "verseOrgIds": [
                  "MRK.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
              "MRK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama Kiristi masu yawa na ƙarya, da annabawan ƙarya za su firfito, su kuma aikata manyan alamu da ayyukan banmamaki don su ruɗi har da zaɓaɓɓu ma in zai yiwu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.22",
                "verseOrgIds": [
                  "MRK.13.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
              "MRK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma ku kula! Na dai gaya muku kome tun da wuri.",
