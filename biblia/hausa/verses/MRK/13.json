          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sa'an nan, mutane za su ga Ɗan Mutum yana zuwa cikin gizagizai da iko, da ɗaukaka mai girma.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.26",
                "verseOrgIds": [
                  "MRK.13.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
