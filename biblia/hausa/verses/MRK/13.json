        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'rana za tă yi duhu,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
