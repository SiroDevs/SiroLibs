        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "wata kuma ba zai ba da haskensa ba;",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
