              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Domin waɗancan kwanakin za su zama kwanaki na baƙin ciki, waɗanda ba a taɓa yin irinsa ba tun farkon halitta, har yă zuwa yanzu, ba kuwa za a sāke yin irinsa ba.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.19",
                "verseOrgIds": [
                  "MRK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
