        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
