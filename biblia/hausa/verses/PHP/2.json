              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku marabce shi cikin Ubangiji da farin ciki mai yawa, ku kuma girmama mutane irinsa,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
