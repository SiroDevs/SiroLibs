          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboda haka na yi niyya ƙwarai in aike shi wurinku, don sa'ad da kuka sāke ganinsa za ku yi murna, ni kuma in rage damuwa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
            "verseOrgIds": [
