              "type": "text"
            }
          ]
        },
        {
          "text": "Gama yana marmarin ganinku duka ya kuma damu domin kun ji cewa ya yi rashin lafiya.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.26",
