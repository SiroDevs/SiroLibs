          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai dukansu suka yi kuka suka rungume shi, suka kuma yi masa sumba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
