          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikin kowane abin da na yi, na nuna muku cewa da irin wannan aiki tuƙuru don mu taimaki marasa ƙarfi, muna tunawa da kalmomin da Ubangiji Yesu kansa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Bayarwa ta fi karɓa albarka.'",
              "type": "text",
              "attrs": {
                "verseId": "ACT.20.35",
                "verseOrgIds": [
                  "ACT.20.35"
                ]
              }
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        }
      ]
    },
