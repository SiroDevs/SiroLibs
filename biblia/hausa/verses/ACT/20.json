              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da ya faɗi haka, ya durƙusa tare da dukansu ya yi addu'a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
