          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tuban Shawulu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "ACT.22.6-ACT.22.16"
          },
          "items": [
            {
              "text": "Ayyukan Manzanni 22.6-16",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "ACT.26.12-ACT.26.18"
          },
          "items": [
            {
              "text": "26.12-18",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana cikin haka, Shawulu ya ɗage yana barazana yin kisa da tsananta wa almajiran Ubangiji. Sai ya je wurin babban firist",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.1",
            "verseOrgIds": [
              "ACT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya roƙe shi ya ba shi wasiƙu zuwa majami'un Damaskus, don in ya sami wani a wurin wanda yake bin wannan Hanya, ko maza ko mata, yă kama su a matsayin 'yan kurkuku yă kai Urushalima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.2",
            "verseOrgIds": [
              "ACT.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da ya yi kusa da Damaskus a kan hanyarsa, ba zato ba tsammani sai wani haske daga sama ya haskaka kewaye da shi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.3",
            "verseOrgIds": [
              "ACT.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai ya fāɗi a ƙasa ya kuma ji wata murya ta ce masa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.4",
            "verseOrgIds": [
              "ACT.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Shawulu, Shawulu, don me kake tsananta mini?\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.4",
                "verseOrgIds": [
                  "ACT.9.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shawulu ya yi tambaya ya ce, \"Wane ne kai, ya Ubangiji?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:5"
      },
      "items": [
        {
          "text": "Ya amsa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ni ne Yesu wanda kake tsananta wa.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.5",
                "verseOrgIds": [
                  "ACT.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yanzu ka tashi ka shiga cikin birnin, za a kuma gaya maka abin da dole za ka yi.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.6",
                "verseOrgIds": [
                  "ACT.9.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutanen da suke tafiya tare da Shawulu suka rasa bakin magana; sun ji muryar amma ba su ga kowa ba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.7",
            "verseOrgIds": [
              "ACT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shawulu ya tashi daga ƙasa, amma sa'ad da ya buɗe idanunsa bai iya ganin wani abu ba. Saboda haka aka kama hannunsa aka yi masa jagora zuwa cikin Damaskus.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.8",
            "verseOrgIds": [
              "ACT.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwana uku yana a makance, bai ci ba bai kuma sha kome ba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Damaskus kuwa akwai wani almajiri mai suna Ananiyas. Ubangiji ya kira shi a cikin wahayi ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ananiyas!\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.10",
                "verseOrgIds": [
                  "ACT.9.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:10"
      },
      "items": [
        {
          "text": "Ananiyas ya amsa, \"Ga ni, ya Ubangiji.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubangiji ya ce masa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je gidan Yahuda da yake a Miƙaƙƙen Titi ka yi tambaya ko akwai wani mutum daga Tarshish mai suna Shawulu, gama ga shi yana addu'a.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.11",
                "verseOrgIds": [
                  "ACT.9.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Cikin wahayi ya ga wani mutum mai suna Ananiyas ya zo ya sa hannuwansa a kansa don yă sāke samun ganin gari.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.12",
                "verseOrgIds": [
                  "ACT.9.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananiyas ya amsa ya ce, \"Ubangiji, na ji labarin mutumin nan sosai da kuma duk lahanin da ya yi wa tsarkakanka a Urushalima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.13",
            "verseOrgIds": [
              "ACT.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ga shi kuma ya zo nan da izinin manyan firistoci, don yă kama duk wanda yake kiran bisa sunanka.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma Ubangiji ya ce wa Ananiyas,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Je ka! Wannan mutum zaɓaɓɓen kayan aikina ne don yă kai sunana a gaban Al'ummai da sarakunansu da kuma a gaban mutanen Isra'ila.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.15",
                "verseOrgIds": [
                  "ACT.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zan nuna masa wahalar da dole zai sha saboda sunana.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.16",
                "verseOrgIds": [
                  "ACT.9.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'an nan Ananiyas ya tafi gidan ya kuma shiga ciki. Da ya sa hannuwansa a kan Shawulu, sai ya ce, \"Ɗan'uwana Shawulu, Ubangiji, Yesu, wanda ya bayyana gare ka a kan hanya yayinda kake zuwa nan, ya aiko ni domin ka sāke gani a kuma cika ka da Ruhu Mai Tsarki.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.17",
            "verseOrgIds": [
              "ACT.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nan da nan, sai wani abu kamar ɓawo ya fāɗo daga idanun Shawulu, ya kuma sāke iya ganin gari. Sai ya tashi aka kuma yi masa baftisma,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.18",
            "verseOrgIds": [
              "ACT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayan ya ci abinci, sai sāke samun ƙarfi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 9:19"
      },
      "items": [
        {
          "text": "Shawulu a Damaskus da Urushalima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:19"
      },
      "items": [
        {
          "text": "Shawulu ya yi kwanaki masu yawa tare da almajiran da suke a Damaskus.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nan take ya fara wa'azi cikin majami'u cewa Yesu Ɗan Allah ne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dukan waɗanda suka ji shi suka yi mamaki suka ce, \"Ba shi ne mutumin da ya tā-da-na-zaune-tsaye a kan masu kira bisa ga wannan sunan a Urushalima ba? Ba ya zo nan ne don yă kai su a matsayin 'yan kurkuku ga manyan firistoci ba?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.21",
            "verseOrgIds": [
              "ACT.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duk da haka Shawulu ya yi ta ƙara ƙarfi, ya kuma rikitar da Yahudawan da suke zaune a Damaskus, ta wurin tabbatar musu cewa, Yesu shi ne Kiristi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.22",
            "verseOrgIds": [
              "ACT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayan kwanaki masu yawa, sai Yahudawa suka haɗa baki su kashe shi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "amma Shawulu ya sami labarin shirinsu. Dare da rana suka yi fakonsa a ƙofofin birnin don su kashe shi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
            "verseOrgIds": [
              "ACT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma almajiransa suka ɗauke shi da dare suka saukar da shi a cikin kwando ta taga a katanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da ya zo Urushalima, ya yi ƙoƙarin shiga cikin almajiran amma dukansu suka ji tsoronsa, ba su gaskata cewa tabbatacce shi almajiri ba ne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
            "verseOrgIds": [
              "ACT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma Barnabas ya ɗauke shi ya kawo shi wurin manzanni. Ya gaya musu yadda Shawulu a kan hanyarsa ya ga Ubangiji kuma cewa Ubangiji ya yi magana da shi, da yadda a Damaskus ya yi wa'azi ba tsoro a cikin sunan Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboda haka Shawulu ya zauna tare da su yana kai da kawowa a sake a cikin Urushalima, yana magana gabagadi a cikin sunan Ubangiji.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya yi magana ya kuma yi muhawwara da Yahudawa masu jin Hellenanci,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "text": "amma suka yi ƙoƙarin kashe shi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'ad da 'yan'uwa suka sami labarin wannan, sai suka ɗauke shi zuwa Kaisariya suka aika da shi Tarshish.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'an nan ikkilisiya ko'ina a Yahudiya, Galili da kuma Samariya ta sami salama. Ta yi ƙarfi; ta kuma ƙarfafa ta wurin Ruhu Mai Tsarki, ta ƙaru sosai tana rayuwa cikin tsoron Ubangiji.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eniyas da Dokas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da Bitrus yake zazzaga ƙasar, sai ya je ya ziyarci tsarkakan da suke a Lidda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.32",
            "verseOrgIds": [
              "ACT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "A can ya tarar da wani mutum mai suna Eniyas, shanyayye wanda yake kwance kan gado shekara takwas.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.33",
            "verseOrgIds": [
              "ACT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai Bitrus ya ce masa, \"Eniyas, Yesu Kiristi ya warkar da kai. Tashi ka naɗe tabarmarka.\" Nan da nan Eniyas ya tashi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.34",
            "verseOrgIds": [
              "ACT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duk waɗanda suke zama a Lidda da Sharon suka gan shi suka kuma juyo ga Ubangiji.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Yoffa akwai wata almajira mai suna Tabita (a harshen Girik sunanta shi ne Dokas",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.36",
            "verseOrgIds": [
              "ACT.9.36"
            ]
          }
        },
        {
          "text": "); ita mai aikin alheri ce kullum, tana kuma taimakon matalauta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.36",
            "verseOrgIds": [
              "ACT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lokacin nan ta yi rashin lafiya ta mutu, aka kuma yi wa gawarta wanka aka ajiye a wani ɗaki a gidan sama.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.37",
            "verseOrgIds": [
              "ACT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidda yana kusa da Yoffa; saboda haka sa'ad da almajirai suka ji cewa Bitrus yana a Lidda, sai suka aiki mutum biyu wurinsa su roƙe shi cewa, \"In ka yarda ka zo nan da nan!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.38",
            "verseOrgIds": [
              "ACT.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai Bitrus ya tafi tare da su, sa'ad da ya iso sai aka kai shi ɗakin saman. Duka gwauraye suka tsaya kewaye da shi, suna kuka suna nunnuna masa riguna da kuma waɗansu tufafin da Dokas ta yi yayinda take tare da su.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.39",
            "verseOrgIds": [
              "ACT.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitrus ya fitar da su duka daga ɗakin; sa'an nan ya durƙusa ya yi addu'a. Da ya juya wajen matacciyar, sai ya ce, \"Tabita, tashi.\" Ta buɗe idanunta, ta ga Bitrus sai ta tashi zaune.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.40",
            "verseOrgIds": [
              "ACT.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya kama ta a hannu ya taimake ta ta tsaya a ƙafafunta. Sa'an nan ya kira masu bi da kuma gwaurayen ya miƙa musu ita da rai.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.41",
            "verseOrgIds": [
              "ACT.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wannan ya zama sananne ko'ina a Yoffa, mutane da yawa kuma suka gaskata da Ubangiji.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.42",
            "verseOrgIds": [
              "ACT.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitrus ya zauna a Yoffa na ɗan lokaci tare da wani mai aikin fatu mai suna Siman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.43",
            "verseOrgIds": [
              "ACT.9.43"
            ]
          }
        }
      ]
    }
  ],
