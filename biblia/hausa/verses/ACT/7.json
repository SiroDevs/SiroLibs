              "type": "text"
            }
          ]
        },
        {
          "text": "Yayinda suke cikin jifansa, sai Istifanus ya yi addu'a ya ce, \"Ubangiji Yesu, ka karɓi ruhuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.59",
