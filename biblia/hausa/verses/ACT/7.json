        },
        {
          "text": "Da jin haka sai suka tattoshe kunnuwansu, suka kuma yi ihu da ƙarfi sosai, suka aukar masa gaba ɗaya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.57",
