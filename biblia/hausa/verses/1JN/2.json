        {
          "text": "Ina rubuta muku, 'ya'yana ƙaunatattu,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
