            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "Ina rubuta muku, ubanni,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "domin kun san shi wanda yake tun farko.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "Ina rubuta muku, samari,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "domin kuna da ƙarfi,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "maganar Allah kuwa tana zaune a cikinku,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1JN 2:14"
      },
      "items": [
        {
          "text": "kun kuma ci nasara a kan mugun nan.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kada ku ƙaunaci duniya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kada ku ƙaunaci duniya, ko wani abin da yake cikinta. In wani yana ƙaunar duniya, ƙaunar Uba ba ta cikinsa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.15",
            "verseOrgIds": [
              "1JN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama duk abin da yake na duniya, kamar sha'awace-sha'awacen mutuntaka, sha'awar idanunsa, da kuma taƙama da abin da yake da shi, yake kuma yi, ba daga wurin Uba suke fitowa ba sai dai daga duniya.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duniya da sha'awace-sha'awacenta suna shuɗewa, amma mutumin da yake aikata nufin Allah, zai rayu har abada.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
            "verseOrgIds": [
              "1JN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gargaɗi a kan magabcin Kiristi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ya'yana ƙaunatattu, waɗannan su ne kwanakin ƙarshe; kuma kamar yadda kuka ji cewa magabcin Kiristi yana zuwa, ko yanzu ma abokan gāban Kiristi da yawa sun zo. Ta haka muka san cewa kwanakin ƙarshe sun iso.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.18",
            "verseOrgIds": [
              "1JN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waɗannan masu gāba da Kiristi suna cikinmu a dā, amma sun bar mu, don tun dā ma su ba namu ba ne. Ai, da su namu ne, da har yanzu suna tare da mu. Amma sun bar mu, wannan ya nuna a fili cewa su ba namu ba ne.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.19",
            "verseOrgIds": [
              "1JN.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma ku kam, kuna da shafewa daga wurin Mai Tsarkin nan, kuma dukanku kun san gaskiya.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
            "verseOrgIds": [
              "1JN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina rubuta muku ba domin ba ku san gaskiya ba ne, a'a, sai dai domin kun santa, kun kuma san cewa babu yadda ƙarya za tă fito daga gaskiya.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
            "verseOrgIds": [
              "1JN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wane ne maƙaryaci? Ai, shi ne mutumin da yake mūsun cewa Yesu shi ne Kiristi. Irin wannan mutum shi ne magabcin Kiristi, ya yi mūsun Uban da kuma Ɗan.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.22",
            "verseOrgIds": [
              "1JN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba wanda yake mūsun Ɗan, sa'an nan yă ce yana da Uban; duk wanda ya yarda da Ɗan, yana da Uban a cikinsa ke nan.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lura fa cewa abin da kuka ji daga farko, bari yă ci gaba da kasance a cikinku. In kuwa ya ci gaba da zama a cikinku, za ku kasance a cikin Ɗan, da kuma a cikin Uban.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wannan shi ne abin da ya yi mana alkawari, wato, rai madawwami.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina rubuta muku waɗannan abubuwa ne game da waɗanda suke ƙoƙari su sa ku kauce.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Game da ku kuwa, shafan nan da kuka karɓa daga gare shi tana nan a cikinku, ba kwa kuma bukata wani yă koyar da ku. Amma kamar yadda shafan nan tasa tana koya muku kome, ita kuwa gaskiya ce ba ƙarya ba, yadda dai ta koya muku, to, sai ku zauna a cikinsa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "'Ya'yan Allah",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanzu fa, ya ku 'ya'yana ƙaunatattu, sai ku ci gaba a cikinsa, domin sa'ad da ya bayyana, mu iya tsaya gabagadi babu kunya a dawowarsa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1JN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "In kun san cewa shi mai adalci ne, to, kun dai san cewa duk mai aikata abin da yake daidai haifaffensa ne.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
            "verseOrgIds": [
              "1JN.2.29"
            ]
          }
        }
      ]
    }
