          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duk da haka sa'ad da Ubangiji ya hukunta mu, ana yin mana horo ne don kada a ƙarshe a hallaka mu tare da duniya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
