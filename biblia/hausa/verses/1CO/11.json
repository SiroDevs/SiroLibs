              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "In wani yana jin yunwa, sai yă ci abinci a gida, saboda in kuka taru kada yă jawo hukunci.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
