              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboda haka 'yan'uwana, sa'ad da kuka taru don ci, ku jira juna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
