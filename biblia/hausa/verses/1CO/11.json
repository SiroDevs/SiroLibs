              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma in da za mu auna kanmu sosai, da ba za mu shiga irin hukuncin nan ba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.31",
            "verseOrgIds": [
              "1CO.11.31"
            ]
          }
