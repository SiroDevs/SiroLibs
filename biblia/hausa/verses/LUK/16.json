          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.5.31"
          },
          "items": [
            {
              "text": "5.31",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.5.32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.11"
          },
          "items": [
            {
              "text": "Markus 10.11",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da Farisiyawa masu son kuɗi suka ji wannan duka, sai suka yi wa Yesu tsaki.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ce musu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku ne masu mai da kanku marasa laifi a gaban mutane, amma Allah ya san zuciyarku. Abu mai daraja a gaban mutane, abin ƙyama ne a gaban Allah.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.15",
                "verseOrgIds": [
                  "LUK.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ƙarin koyarwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"An yi shelar Doka da Annabawa har zuwa lokacin Yohanna. Tun daga lokacin nan, bisharar mulkin Allah ne ake wa'azinta, kowa kuma yana ƙoƙarin kutsa kai ya shiga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.16",
                "verseOrgIds": [
                  "LUK.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama ta fi sauƙi sama da ƙasa su shuɗe, da a ce ɗigo guda ɗaya na rubutun, ya fita ya fāɗi daga cikin Doka.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.17",
                "verseOrgIds": [
                  "LUK.16.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Duk wanda ya saki matarsa ya auri wata mace, zina ne yake yi. Kuma mutumin da ya auri macen da aka sake, zina ne yake yi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.18",
                "verseOrgIds": [
                  "LUK.16.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mai arziki da Lazarus",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"An yi wani mutum mai arziki wanda yakan sa tufafi masu ruwan shunayya, da kuma na lallausan lilin, yana kuma cikin rayuwar jin daɗi kullum.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.19",
                "verseOrgIds": [
                  "LUK.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A ƙofar gidansa kuma akan ajiye wani mai bara, mai suna Lazarus, wanda jikinsa duk gyambuna ne.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.20",
                "verseOrgIds": [
                  "LUK.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Shi kuwa yakan yi marmarin cin abin da yakan fāɗi daga tebur na mai arzikin nan. Har karnuka ma sukan zo su lashe gyambunansa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.21",
                "verseOrgIds": [
                  "LUK.16.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ana nan, sai mai baran ya mutu, kuma mala'iku suka ɗauke shi zuwa gefen Ibrahim. Mai arzikin ma ya mutu, aka kuma binne shi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.22",
                "verseOrgIds": [
                  "LUK.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A cikin jahannama ta wuta, inda yana shan azaba, ya ɗaga kai ya hangi Ibrahim can nesa, da kuma Lazarus a gefensa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.23",
                "verseOrgIds": [
                  "LUK.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
            "verseOrgIds": [
              "LUK.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sai ya yi masa kira ya ce, 'Baba, Ibrahim, ka ji tausayina, ka aiki Lazarus ya sa ɗan yatsarsa a ruwa, ya ɗiga mini a harshe saboda in ji sanyi, domin ina shan azaba cikin wannan wuta.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.24",
                "verseOrgIds": [
                  "LUK.16.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma Ibrahim ya ce, 'Ka tuna fa ɗana, a lokacin da kake duniya, ka sami abubuwa masu kyau naka, Lazarus kuwa ya sami munanan abubuwa. Amma yanzu ya sami ta'aziyya a nan, kai kuwa kana shan azaba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.25",
                "verseOrgIds": [
                  "LUK.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
            "verseOrgIds": [
              "LUK.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ban da wannan duka ma, tsakaninmu da kai, akwai wani babban rami da aka yi, yadda waɗanda suke son ƙetarewa daga nan zuwa wurinku, ba za su iya ba, kuma ba mai iya ƙetarewa daga wurinku zuwa wurinmu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.26",
                "verseOrgIds": [
                  "LUK.16.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya amsa ya ce, 'To, ina roƙonka, ya uba, ka aiki Lazarus zuwa gidan mahaifina,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.27",
                "verseOrgIds": [
                  "LUK.16.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "gama ina da 'yan'uwana biyar maza. Bari yă ba su gargaɗi, don kada su ma su zo wurin nan mai azaba.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.28",
                "verseOrgIds": [
                  "LUK.16.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ibrahim ya amsa ya ce, 'Suna da Musa da Annabawa, ai, sai su saurare su.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.29",
                "verseOrgIds": [
                  "LUK.16.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sai ya ce, 'A'a, ya uba, Ibrahim, in dai wani ya tashi daga matattu ya je wurinsu, za su tuba.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.30",
                "verseOrgIds": [
                  "LUK.16.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma ya ce masa, 'In ba su saurari Musa da Annabawa ba, kai, ko da wani ya tashi daga matattu ma, ba za su saurare shi ba.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.31",
                "verseOrgIds": [
                  "LUK.16.31"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
