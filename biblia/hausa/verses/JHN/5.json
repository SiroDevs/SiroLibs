        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "na fa san ku. Na san cewa ba ku da ƙaunar Allah a cikin zukatanku.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.42",
                "verseOrgIds": [
