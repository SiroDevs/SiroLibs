          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kuna ta nazarin Nassosi da himma don kuna tsammani ta wurinsu ne kuna samun rai madawwami. Nassosin nan ne suke ba da shaida a kaina,",
