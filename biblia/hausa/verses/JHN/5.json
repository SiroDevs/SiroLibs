              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ta yaya za ku gaskata in kuna neman yabon junanku, ba kwa kuwa yin ƙoƙarin neman yabon da yake zuwa daga Allah Makaɗaici?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.44",
                "verseOrgIds": [
                  "JHN.5.44"
                ]
              }
            }
          ]
        }
