        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gaskiya nake gaya muku, lokaci yana zuwa har ma ya riga ya zo sa'ad da matattu za su ji muryar Ɗan Allah waɗanda kuwa suka ji za su rayu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.25",
                "verseOrgIds": [
