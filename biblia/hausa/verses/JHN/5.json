            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "maganarsa kuwa ba ta zama a cikinku, gama ba ku gaskata da wanda ya aiko ni ba.",
