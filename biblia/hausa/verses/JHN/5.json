              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na zo a cikin sunan Ubana, ba ku kuwa karɓe ni ba; amma a ce wani dabam ya zo a cikin sunan kansa, za ku karɓe shi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
