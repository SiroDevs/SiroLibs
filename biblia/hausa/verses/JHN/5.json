        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ni kaɗai dai ba na iya yin kome, ina shari'a ne bisa ga abin da na ji. Shari'ata kuwa mai adalci ce. Gama ba na neman gamsar da kaina, sai dai in gamshi shi wanda ya aiko ni.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.30",
