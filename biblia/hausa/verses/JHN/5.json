        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama kamar yadda Uban yana da rai a cikinsa, haka ya sa Ɗan yă kasance da rai a cikin kansa.",
