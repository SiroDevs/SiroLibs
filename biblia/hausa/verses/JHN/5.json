        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ina da shaidar da ta fi ta Yohanna ƙarfi. Gama aikin nan da Uba ya ba ni in kammala, wanda kuwa nake yi, yana ba da shaida cewa Uba ne ya aiko ni.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.36",
                "verseOrgIds": [
