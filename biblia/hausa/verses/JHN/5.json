        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ni ba na neman yabon mutane,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.41",
