    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kada fa ku yi tsammani zan yi ƙararku wurin Uba. Akwai mai yin ƙararku, shi ne Musa, wanda kuke dogara da shi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.45",
                "verseOrgIds": [
                  "JHN.5.45"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Da a ce kun gaskata da Musa, da kun gaskata ni, domin ya rubuta game da ni.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.46",
                "verseOrgIds": [
                  "JHN.5.46"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma da yake ba ku gaskata abin da ya rubuta ba, yaya za ku gaskata maganata?\"",
