        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Uba da ya aiko ni kuwa kansa ya yi shaida game da ni. Ba ku taɓa jin muryarsa ko ganin siffarsa ba,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.37",
