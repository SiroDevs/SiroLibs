        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akwai wani mai ba da shaida mai kyau a kaina, na kuma san cewa shaidarsa game da ni gaskiya ce.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.32",
                "verseOrgIds": [
