          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wannan kuwa shi ne alkawarina da su",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.27",
            "verseOrgIds": [
              "ROM.11.27"
            ]
          }
        }
      ]
