      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:27"
      },
      "items": [
        {
          "text": "sa'ad da na ɗauke musu zunubansu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.27",
            "verseOrgIds": [
              "ROM.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
