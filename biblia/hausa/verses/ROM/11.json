      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:26"
      },
      "items": [
        {
          "text": "zai kawar da rashin bin Allah daga Yaƙub.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
