          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wa ya taɓa sanin zuciyar Ubangiji?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
