                  "DEU.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
