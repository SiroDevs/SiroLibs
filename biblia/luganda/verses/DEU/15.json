              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibereberye ebyo onoobiryanga buli mwaka, buli mwaka, ggwe n'ab'omu nju yo bonna, nga mubiriiranga mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
