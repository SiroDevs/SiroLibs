          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onookiriiranga mu bibuga byo. Omulongoofu n'atali mulongoofu mwenna munaabiryanga nga bwe munaalyanga empeewo oba enjaza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
