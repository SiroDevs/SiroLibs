  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "DEU 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekyoto Kimu Kyokka eky'Ebiweebwayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ge mateeka n'ebiragiro bye musaana okukwatanga n'obwegendereza, nga muli mu nsi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.1",
                "verseOrgIds": [
                  "DEU.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjaabo gy'akuwadde okubeera obutaka bwo ebbanga lyonna lye mulimala ku nsi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.1",
            "verseOrgIds": [
              "DEU.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzikiririzanga ddala ebifo byonna ebiri ku gasozi ne ku nsozi, ne wansi w'agati aganene,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.2",
            "verseOrgIds": [
              "DEU.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bannaggwanga be mugenda okutwalako ensi yaabwe gye basinziza; n'amayinja gaabwe mugaasaayasanga, n'empagi zaabwe eza Asera mulizimenyaamenya ne muzookya mu muliro; n'ebibajje ebya bakatonda baabwe mubitemaatemanga n'amannya gaabwe mu bifo ebyo ne mugasanguliramu ddala.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.3",
            "verseOrgIds": [
              "DEU.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.4",
                "verseOrgIds": [
                  "DEU.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, ye temumusinzanga mu ngeri eyo nga bali bwe bakola.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.4",
            "verseOrgIds": [
              "DEU.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe munoonyanga mu bika byammwe byonna, ekifo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.5",
                "verseOrgIds": [
                  "DEU.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe ky'alibalondera we munaateekanga Erinnya lye ne mumuzimbira awo ennyumba ye ey'okubeerangamu. Mu kifo ekyo gye munaagendanga okumusinza;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.5",
            "verseOrgIds": [
              "DEU.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "awo we munaaleetanga ebiweebwayo byammwe ebyokebwa ne biweebwayo ebirala, n'ebitundu byammwe eby'ekkumi, n'ebirabo eby'enjawulo, n'obweyamo bwammwe, n'ebiweebwayo ebya kyeyagalire, n'ebibereberye eby'omu bisibo byammwe n'eby'omu biraalo byammwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.6",
            "verseOrgIds": [
              "DEU.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe n'ab'omu nnyumba zammwe munaaliiranga mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, munaasanyukanga ne mwenyumirizanga mu buli kintu kyonna kye munaabanga mukoze n'emikono gyammwe, kubanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.7",
                "verseOrgIds": [
                  "DEU.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo anaabanga akuwadde omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.7",
            "verseOrgIds": [
              "DEU.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temukolanga nga bwe tukola wano leero, nga buli omu akola nga bw'alaba ekisaanidde,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.8",
            "verseOrgIds": [
              "DEU.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga temunnatuuka mu kiwummulo ne mu busika",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.9",
                "verseOrgIds": [
                  "DEU.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe bw'abawa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.9",
            "verseOrgIds": [
              "DEU.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe mulimala okusomoka omugga Yoludaani, ne mubeera mu nsi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.10",
                "verseOrgIds": [
                  "DEU.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe gy'abawa nga bwe busika bwammwe, ng'abawadde n'okuwummula, nga temukyataataaganyizibwa balabe bammwe abanaabanga babeetoolodde n'okutuula ne mutuulanga mu mirembe;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.10",
            "verseOrgIds": [
              "DEU.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale nno, mu kifo ekyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe kyanaabanga yeerondedde okutuuzanga omwo Erinnya lye, omwo mwe munaaleetanga buli kintu kyonna kye mbalagira: ebiweebwayo byammwe ebyokebwa, n'ebiweebwayo ebirala, n'ebitundu byammwe eby'ekkumi, n'ebirabo eby'enjawulo, n'ebirabo ebisinga obulungi mu bintu byammwe bye munaabanga mweyamye okuwaayo eri",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.11",
                "verseOrgIds": [
                  "DEU.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.11",
            "verseOrgIds": [
              "DEU.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaasanyukiranga awo mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.12",
                "verseOrgIds": [
                  "DEU.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, mmwe, ne batabani bammwe, ne bawala bammwe, n'abaweereza bammwe abasajja, n'abaweereza bammwe abakazi, n'Abaleevi ab'omu bibuga byammwe, kubanga bo ku bwabwe tebalifuna mugabo oba obusika okufaanana nga mmwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.12",
            "verseOrgIds": [
              "DEU.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weekuumanga n'otaweerayo biweebwayo by'omu buli kifo kyonna ky'onoolabanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.13",
            "verseOrgIds": [
              "DEU.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiweerengayo mu kifo ekyo ekimu kyokka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.14",
                "verseOrgIds": [
                  "DEU.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'anaakulonderanga okuva mu kimu ku bika byo; era omwo mw'onookoleranga ebyo byonna bye nkulagira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.14",
            "verseOrgIds": [
              "DEU.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebiragiro ku Biweebwayo ebitali bya bulijjo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye onettiranga ku bisolo ebinaabanga mu bibuga byo, oba mpeewo oba njaza, n'olya ennyama nnyingi nga bw'onooyagalanga, ng'omukisa bwe guli",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.15",
                "verseOrgIds": [
                  "DEU.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo gw'anaakuwanga. Abalongoofu mu by'emikolo n'abatali balongoofu, bonna banaalyanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.15",
            "verseOrgIds": [
              "DEU.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula omusaayi temugulyanga; munaaguyiwanga wansi ku ttaka ng'amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.16",
            "verseOrgIds": [
              "DEU.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bibuga byo toliirangamu kitundu ekimu eky'ekkumi eky'emmere yo ey'empeke, oba ekya wayini wo, oba eky'amafuta go; oba ebibereberye eby'omu bisibo byo n'eby'omu biraalo byo, oba n'obweyamo bwo oba n'ebiweebwayo ebya kyeyagalire; wadde n'ebirabo ebitali bya bulijjo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.17",
            "verseOrgIds": [
              "DEU.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoobiriiranga mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, mu kifo ekyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo ky'anaabanga akulondedde; ggwe, ne mutabani wo, ne muwala wo, n'omuweereza wo omusajja n'omuweereza wo omukazi, n'Omuleevi anaabanga mu bibuga byo, era onoosanyukiranga mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.18",
                "verseOrgIds": [
                  "DEU.12.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo mu buli kintu kyonna ky'onoobanga okoze n'emikono gyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.18",
            "verseOrgIds": [
              "DEU.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weekuumanga nnyo obutalagajjaliranga Muleevi ebbanga lyonna ly'olimala ng'oli mulamu ku nsi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.19",
            "verseOrgIds": [
              "DEU.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.20",
                "verseOrgIds": [
                  "DEU.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo bw'aligaziya amatwale go, nga bwe yakusuubiza, n'oyoyanga okulya ku nnyama ng'ogamba nti, \"Nandiyagadde okulya ku nnyama.\" Kale, onoolyanga ennyama ennyingi nga bw'onooyagalanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.20",
            "verseOrgIds": [
              "DEU.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo ky'anaabanga akulondedde okuteekamu Erinnya lye, bwe kinaabanga kiri wala n'ewuwo kale onooyinzanga okutta ku zimu ku nsolo ez'omu bisibo byo ne mu biraalo byo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.21",
                "verseOrgIds": [
                  "DEU.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "by'anaabanga akuwadde, nga bwe nkulagidde; era mu bibuga byo onooyinzanga okulya ennyama ennyingi nga bw'onooyagalanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.21",
            "verseOrgIds": [
              "DEU.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoogiryanga nga bw'onoolyanga empeewo n'enjaza. Abalongoofu n'abatali balongoofu bonna banaalyanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.22",
            "verseOrgIds": [
              "DEU.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye weekuumenga obutalyanga musaayi; kubanga omusaayi bwe bulamu, ate nga tekikugwaniranga kulyanga bulamu ng'olya ennyama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.23",
            "verseOrgIds": [
              "DEU.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togulyanga; oguyiwanga wansi ku ttaka ng'amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.24",
            "verseOrgIds": [
              "DEU.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togulyanga, olyoke obeerenga mu ddembe, ggwe, n'abaana bo, ng'okoze ebituufu mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.25",
                "verseOrgIds": [
                  "DEU.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.25",
            "verseOrgIds": [
              "DEU.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ebintu byo ebitukuvu ne byonna by'oneeyamanga okuwaayo, onoobiddiranga n'obitwalanga mu kifo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.26",
                "verseOrgIds": [
                  "DEU.12.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'anaabanga akulondedde.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.26",
            "verseOrgIds": [
              "DEU.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onooleetanga ebiweebwayo byo ebyokebwa, ennyama n'omusaayi, ku Kyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo. Omusaayi gw'ebiweebwayo byo ebirala gunaafukibwanga ku Kyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.27",
                "verseOrgIds": [
                  "DEU.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, naye ennyama onooyinzanga okugirya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.27",
            "verseOrgIds": [
              "DEU.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weegenderezenga okugoberera ebiragiro bino byonna bye nkuwa, olyoke obeenga bulungi, ggwe, n'abaana bo, oluvannyuma lwo, emirembe gyonna, kubanga onoobanga okoze ekituufu mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.28",
                "verseOrgIds": [
                  "DEU.12.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okulabula ku Kusinza bakatonda abalala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga ago g'ogenda okulumba ogatwaleko ensi yaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.29",
                "verseOrgIds": [
                  "DEU.12.29"
                ]
              }
            }
          ]
        },
        {
          "text": "agenda kugazikiriza nga naawe olaba. Naye bw'obanga omaze okubagoba mu nsi yaabwe, n'okugibeeramu n'ogibeeramu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.29",
            "verseOrgIds": [
              "DEU.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "era ng'amawanga ago gamaze okuzikirizibwa nga naawe olaba, weekuumanga n'otabuuliriza ku bya bakatonda baabwe ng'ogamba nti, \"Ab'omu mawanga ago baasinzanga batya bakatonda baabwe, nange njagala nkole bwe ntyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.30",
            "verseOrgIds": [
              "DEU.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo tomusinzanga mu ngeri efaanana ng'eya bali, kubanga mu kusinza bakatonda baabwe bakoleramu ebikolobero bingi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.12.31",
                "verseOrgIds": [
                  "DEU.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "by'atayagala, by'akyawa. Bayokya ne batabani baabwe ne bawala baabwe mu muliro nga ssaddaaka eri bakatonda baabwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibagwanidde okunyiikiranga okukolanga buli kintu kye mbalagira, tokyongerangako wadde okukikendeezangako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
            "verseOrgIds": [
              "DEU.13.1"
            ]
          }
        }
      ]
    }
  ],
