                "verseId": "DEU.9.22",
                "verseOrgIds": [
                  "DEU.9.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", mwayongera okumusunguwaza bwe mwali e Tabera, n'e Masa, n'e Kiberosu Kataava.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
