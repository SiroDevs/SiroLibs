              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
