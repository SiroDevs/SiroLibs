              "attrs": {
                "verseId": "DEU.9.23",
                "verseOrgIds": [
                  "DEU.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe yabasindika okuva e Kadesubanea, yabagamba nti, \"Mwambuke mwetwalire ensi gye mbawadde.\" Naye ne mujeemera ekiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.23",
                "verseOrgIds": [
                  "DEU.9.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe. Temwamwesiga wadde okumugondera.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasookedde mbamanya, ebbanga eryo lyonna mubadde mujeemera",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.24",
                "verseOrgIds": [
                  "DEU.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa Yeegayirira",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku lwa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ntyo ne nambaala ku ttaka nga neevuunise mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.25",
                "verseOrgIds": [
                  "DEU.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", okumala ennaku amakumi ana emisana n'ekiro; kubanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.25",
                "verseOrgIds": [
                  "DEU.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda yali agambye nti ajja kubazikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nsaba",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.26",
                "verseOrgIds": [
                  "DEU.9.26"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.26",
                "verseOrgIds": [
                  "DEU.9.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, bano be bantu bo, era obusika bwo bwennyini, be wanunula n'obaggya mu nsi ey'e Misiri n'omukono gwo ogw'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkusaba ojjukire abaddu bo, era abaweereza bo, Ibulayimu, ne Isaaka, ne Yakobo osonyiwe obukakanyavu bw'eggwanga lino, n'obunafu bwalyo n'ebibi byalyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'omu nsi mwe watuggya baleme okugamba nti, \"Olwokubanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.9.28",
                "verseOrgIds": [
                  "DEU.9.28"
                ]
              }
            }
          ]
        },
        {
          "text": "yali tasobola kubatuusa mu nsi gye yabasuubiza, era olwokubanga yali abakyaye nnyo, kyeyava abaggyayo mu Misiri alyoke abattire mu ddungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga lino lye ggwanga lyo, be bantu bo ab'obusika bwo, be waggya mu Misiri n'obuyinza bwo obungi, n'omukono gwo ogw'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.29",
            "verseOrgIds": [
              "DEU.9.29"
            ]
          }
        }
      ]
    }
