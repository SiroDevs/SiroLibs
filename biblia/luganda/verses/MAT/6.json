  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MAT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuwa Abaavu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwegendereze, ebikolwa byammwe eby'obutuukirivu obutabikoleranga mu lujjudde lw'abantu nga mwagala babasiime, kubanga bwe munaakolanga bwe mutyo Kitammwe ali mu ggulu talibawa mpeera.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.1",
                "verseOrgIds": [
                  "MAT.6.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bw'obanga ogabira omwavu ekintu teweeraganga nga bannanfuusi bwe bakola ne basooka okufuuwa eŋŋombe mu makuŋŋaaniro ne mu nguudo, nga bagenda okugabira abaavu, abantu babalabe babawe ekitiibwa. Ddala ddala mbagamba nti Abo, eyo y'empeera yaabwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.2",
                "verseOrgIds": [
                  "MAT.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye ggwe bw'obanga ogabira omuntu yenna ekintu omukono gwo ogwa kkono guleme kumanya ogwa ddyo kye gukola.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.3",
                "verseOrgIds": [
                  "MAT.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale Kitaawo amanyi ebyama byonna alikuwa empeera.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.4",
                "verseOrgIds": [
                  "MAT.6.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Era bwe mubanga musaba mwekuume obutaba nga bannanfuusi abaagala okweraga nga bwe bali bannaddiini, ne basabira mu makuŋŋaaniro ne ku nguudo mu lujjudde, abantu babalabe. Abo, eyo y'empeera yokka gye balifuna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.5",
                "verseOrgIds": [
                  "MAT.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye ggwe bw'obanga osaba, oyingiranga mu nnyumba yo, ne weggalira mu kisenge kyo n'osabira eyo mu kyama. Kitaawo ategeera ebyama byo byonna alikuwa by'omusabye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.6",
                "verseOrgIds": [
                  "MAT.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era bwe musabanga temuddiŋŋananga mu bigambo oba okwogera ebigambo enkumu ng'abatamanyi Katonda bwe bakola nga balowooza nti Bwe banaddiŋŋana mu bigambo emirundi n'emirundi okusaba kwabwe lwe kunaddibwamu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.7",
                "verseOrgIds": [
                  "MAT.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale temubafaanananga, kubanga Kitammwe amanyidde ddala byonna bye mwetaaga ne bwe muba nga temunnamusaba.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.8",
                "verseOrgIds": [
                  "MAT.6.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Noolwekyo mumusabenga bwe muti nti,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kitaffe ali mu ggulu,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Erinnya Lyo litukuzibwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.9",
                "verseOrgIds": [
                  "MAT.6.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Obwakabaka bwo bujje.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "By'oyagala bikolebwe mu nsi,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nga bwe bikolebwa mu ggulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.10",
                "verseOrgIds": [
                  "MAT.6.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Otuwenga emmere yaffe eya buli lunaku.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.11",
                "verseOrgIds": [
                  "MAT.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tusonyiwe ebyonoono byaffe",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nga naffe bwe tusonyiwa abatwonoona.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.12",
                "verseOrgIds": [
                  "MAT.6.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Totuganya kukemebwa",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 6:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye tulokole eri omubi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.13",
                "verseOrgIds": [
                  "MAT.6.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kubanga bwe munaasonyiwanga ababasobezza, nammwe Kitammwe ali mu ggulu anaabasonyiwanga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.14",
                "verseOrgIds": [
                  "MAT.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye bwe mutaasonyiwenga bannammwe, nammwe Kitammwe ali mu ggulu taabasonyiwenga.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.15",
                "verseOrgIds": [
                  "MAT.6.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okusiiba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwe musiibanga, temukiraganga nga bannanfuusi bwe bakola. Kubanga batunuza ennaku balyoke balabike mu bantu nti basiiba, mbategeeza ng'abo, eyo y'empeera yokka gye bagenda okufuna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.16",
                "verseOrgIds": [
                  "MAT.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye ggwe bw'osiibanga olongoosanga enviiri zo n'onaaba ne mu maaso,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.17",
                "verseOrgIds": [
                  "MAT.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "abantu baleme kutegeera nti osiiba, okuggyako Kitaawo ali mu ggulu era alaba mu kyama alikuwa empeera.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.18",
                "verseOrgIds": [
                  "MAT.6.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obugagga obw'Amazima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Temweterekeranga byabugagga wano ku nsi kwe biyinza okwonoonebwa ennyenje n'obutalagge, n'ababbi kwe bayinza okubibbira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.19",
                "verseOrgIds": [
                  "MAT.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mweterekerenga obugagga bwammwe mu ggulu gye butayinza kwonoonebwa nnyenje wadde obutalagge, n'ababbi gye batayinza kuyingira kububba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.20",
                "verseOrgIds": [
                  "MAT.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga obugagga bwo gye buli n'omutima gwo gye gunaabeeranga.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.21",
                "verseOrgIds": [
                  "MAT.6.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eriiso y'ettabaaza y'omubiri gwo, noolwekyo eriiso bwe liba eddamu, omubiri gwo gwonna gujjula ekitangaala ng'eky'omusana.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.22",
                "verseOrgIds": [
                  "MAT.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye eriiso lyo bwe liba ebbi, omubiri gwo gwonna gunaabeeranga n'ekizikiza, noolwekyo ekizikiza ekyo kiba kikwafu nnyo!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.23",
                "verseOrgIds": [
                  "MAT.6.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tewali n'omu ayinza kuweereza bakulu babiri, kubanga alikyawako omu n'ayagala omulala oba aliwulirako omu n'anyooma omulala. Toyinza kuweereza Katonda na mamona.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
                "verseOrgIds": [
                  "MAT.6.24"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.24",
                "verseOrgIds": [
                  "MAT.6.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Temweraliikiriranga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Noolwekyo mbagamba nti, Temweraliikiriranga bya bulamu bwammwe, bye munaalya oba bye munaanywa, wadde ebyokwambala. Kubanga obulamu businga ebyokulya, n'omubiri gusinga ebyambalo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.25",
                "verseOrgIds": [
                  "MAT.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulabire ku nnyonyi ez'omu bbanga! Tezisiga so tezikungula so tezikuŋŋaanyiza mmere mu tterekero, naye Kitammwe ali mu ggulu aziriisa. Naye mmwe temusinga nnyo ennyonyi ezo?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.26",
                "verseOrgIds": [
                  "MAT.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani ku mmwe, bwe yeeraliikirira, ayinza okwongerayo obulamu bwe akatundu n'akamu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.27",
                "verseOrgIds": [
                  "MAT.6.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye lwaki mweraliikirira ebyokwambala? Mulabire ku malanga ag'oku ttale! Tegaliiko kye geekolera,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.28",
                "verseOrgIds": [
                  "MAT.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "naye ne Kabaka Sulemaani mu kitiibwa kye kyonna teyagenkana mu kwambala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.29",
                "verseOrgIds": [
                  "MAT.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye obanga Katonda ayambaza obulungi bw'atyo omuddo ogw'omu nsiko ogw'ekiseera obuseera, ogubaawo leero ate enkeera ne gwokebwa mu kyoto, talisingawo nnyo okubambaza? Nga mulina okukkiriza okutono!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.30",
                "verseOrgIds": [
                  "MAT.6.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Noolwekyo temweraliikiririranga nga mugamba nti, 'Tunaalya ki? Oba nti, Tunaanywa ki? Oba nti, Tunaayambala ki?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.31",
                "verseOrgIds": [
                  "MAT.6.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ebyo byonna bannamawanga bye bayaayaanira. Naye Kitammwe ali mu ggulu amanyi ng'ebyo byonna mubyetaaga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.32",
                "verseOrgIds": [
                  "MAT.6.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye musooke munoonye obwakabaka bwa Katonda n'obutuukirivu bwe, ebyo byonna mulibyongerwako.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.33",
                "verseOrgIds": [
                  "MAT.6.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Noolwekyo temweraliikiriranga bya nkya. Kubanga olunaku olw'enkya lulyeraliikirira ebyalwo. Buli lunaku lulina emitawaana gyalwo egimala.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.6.34",
                "verseOrgIds": [
                  "MAT.6.34"
                ]
              }
            }
          ]
        }
      ]
