  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yonasaani Alumba Abafirisuuti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lumu Yonasaani mutabani wa Sawulo n'agamba omuvubuka eyasitulanga ebyokulwanyisa bye nti, \"Jjangu tugende ku ludda luli mu nkambi ey'Abafirisuuti.\" Kyokka n'atabuulira kitaawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.1",
            "verseOrgIds": [
              "1SA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo yali asiisidde ku njegoyego za Gibea wansi w'omukomamawanga mu Migulooni. Yalina abaserikale nga lukaaga;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.2",
            "verseOrgIds": [
              "1SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku bo kwe kwali Akiya eyali ayambadde ekkanzu ey'obwakabona",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        },
        {
          "text": "nga ye mutabani wa Akitubu, muganda wa Ikabodi, mutabani wa Finekaasi, mutabani wa Eri, kabona wa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.3",
                "verseOrgIds": [
                  "1SA.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mu Siiro. Tewali yamanya nti Yonasaani agenze.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku buli ludda lw'ekkubo Yonasaani mwe yali ayagala okuyita okutuuka ku nkambi y'Abafirisuuti waaliyo enkonko empanvu, olumu nga luyitibwa Bozezi, n'olulala nga luyitibwa Sene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.4",
            "verseOrgIds": [
              "1SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olukonko olumu lwali ku luuyi olw'obukiikakkono okwolekera Mikumasi, n'olulala nga luli ku luuyi olw'obukiikaddyo okwolekera Geba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani n'agamba omuvubuka eyasitulanga ebyokulwanyisa bye nti, Jjangu tugende mu nkambi y'abasajja abo abatali bakomole, oboolyawo",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.6",
                "verseOrgIds": [
                  "1SA.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "anaatukolera ekyamagero. Kubanga tewali kiyinza kuziyiza",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.6",
                "verseOrgIds": [
                  "1SA.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kulokola, ng'akozesa abangi oba abatono.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuvubuka n'amuddamu nti, \"Kola nga bw'osiima. Genda mu maaso, nzisa kimu naawe, omutima gwange n'omwoyo gwange biri wamu naawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.7",
            "verseOrgIds": [
              "1SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani n'alyoka ayogera nti, \"Kale, tusomoke tugende eri abasajja, tubeerage.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.8",
            "verseOrgIds": [
              "1SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe banaatugamba nti, 'Mutulindirire okutuusa lwe tunajja,' kale tunaasigala we tuli, ne tutagenda gye bali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.9",
            "verseOrgIds": [
              "1SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe banaatugamba nti, 'Mujje gye tuli,' tunaayambuka, kubanga ako ke kanaaba akabonero gye tuli nti",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.10",
                "verseOrgIds": [
                  "1SA.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "abagabudde mu mukono gwaffe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bombi ne beeraga eri olusiisira lw'Abafirisuuti. Abafirisuuti ne boogera nti, \"Mulabe, Abaebbulaniya batandise okuva mu binnya mwe baali beekwese.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.11",
            "verseOrgIds": [
              "1SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasajja ab'omu nkambi ne bakoowoola Yonasaani n'omuvubuka eyasitulanga ebyokulwanyisa bye nga boogera nti, \"Mwambuke gye tuli, tubalage enkola.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:12"
      },
      "items": [
        {
          "text": "Awo Yonasaani n'agamba omuvubuka eyasitulanga ebyokulwanyisa bye nti, \"Ngoberera twambuke kubanga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.12",
                "verseOrgIds": [
                  "1SA.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "abawaddeyo mu mukono gwa Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani n'alinnyalinnya, ng'ayavula nga n'omuvubuka eyasitulanga ebyokulwanyisa bye bw'amuvaako emabega. Yonasaani n'atta Abafirisuuti, n'omuvubuka eyasitulanga ebyokulwanyisa bye ng'amuvaako emabega naye n'atta abo abaali bawonyeewo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.13",
            "verseOrgIds": [
              "1SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu lulumba olwo olwasooka, Yonasaani n'omuvubuka eyasitulanga ebyokulwanyisa bye, batta abasajja amakumi abiri mu kibangirizi ekyenkana ekitundu kya eka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.14",
            "verseOrgIds": [
              "1SA.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isirayiri Atta Abafirisuuti bangi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne waba okutya kungi nnyo mu ggye lyonna ery'Abafirisuuti abo abaali mu nkambi n'abaali ku ttale; era n'ab'omu bibinja ebirala n'ebibondo ebirumba n'ettaka ne likankana. Okukankana okwo kwava eri Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuumi ba Sawulo abaali e Gibea mu Benyamini ne balaba ng'ekibinja kisaasaana okuddukira mu njuyi zonna.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.16",
            "verseOrgIds": [
              "1SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'alagira abasajja abaali naye nti, \"Mubale abasajja bonna, mulabe ataliiwo.\" Bwe baabala, ne bazuula nga Yonasaani n'eyasitulanga ebyokulyanyisa bye tebaliiwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.17",
            "verseOrgIds": [
              "1SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'agamba Akiya nti, \"Leeta essanduuko ya Katonda,\" kubanga mu biro ebyo yali mu mikono gy'Abayisirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.18",
            "verseOrgIds": [
              "1SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo bwe yali ng'akyayogera ne kabona, akeegugungo ne keeyongera mu nkambi y'Abafirisuuti, n'agamba kabona nti, \"Zaayo omukono gwo, ogira olindako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.19",
            "verseOrgIds": [
              "1SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'abasajja be ne beekuŋŋaanya ne bagenda mu lutalo, ne basanga ng'Abafirisuuti balwanagana bokka ne bokka, nga bafumitagana ebitala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.20",
            "verseOrgIds": [
              "1SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaebbulaniya abaabeeranga n'Abafirisuuti, abaali bagenze nabo mu nkambi, ne beegatta ku Bayisirayiri abaali ne Sawulo ne Yonasaani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.21",
            "verseOrgIds": [
              "1SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayisirayiri bonna abaali beekwese mu nsi ey'ensozi eya Efulayimu bwe baawulira ng'Abafirisuuti badduse, amangwago nabo ne beenyigira mu lutalo ne bannaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.23",
                "verseOrgIds": [
                  "1SA.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "n'alokola Isirayiri ku lunaku olwo, olutalo ne lutuukira ddala e Besaveni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yonasaani Alya Omubisi gw'Enjuki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo abasajja Abayisirayiri baali bajjudde ennaku nnyingi nnyo kubanga Sawulo yali abalayizza ng'agamba nti, \"Akolimirwe oyo yenna anaalya akantu konna ng'obudde tebunnawungeera, nga sinnaba kwesasuza ku balabe bange.\" Awo ne wataba n'omu ku baserikale akomba ku kantu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.24",
            "verseOrgIds": [
              "1SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abantu bonna bwe baatuuka mu kibira ne balaba omubisi gw'enjuki ku ttaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.25",
            "verseOrgIds": [
              "1SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe beeyongerayo munda mu kibira ne basanga nga gutonnya, naye ne wataba n'omu agukombako kubanga baali batya ekirayiro kye baakola.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.26",
            "verseOrgIds": [
              "1SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yonasaani yali tawulidde nga kitaawe alayiza abantu, kyeyava addira omuggo gwe yalina n'annyika omusa gwagwo mu bisenge by'enjuki, n'agukombako, amaaso ge ne ganyirira n'addamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.27",
            "verseOrgIds": [
              "1SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omu ku baserikale n'amugamba nti, \"Kitaawo yatukuutidde n'atulayiza nti, 'Omuntu yenna anaalya ku mmere leero akolimirwe.' Era ekyo kye kireetedde abaserikale okuggwaamu amaanyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.28",
            "verseOrgIds": [
              "1SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani n'ayogera nti, \"Kitange aleetedde ensi yaffe emitawaana. Laba amaaso gange bwe ganyirira n'amaanyi gange bwe gakomyewo bwe nkombyeko ku mubisi guno ogw'enjuki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.29",
            "verseOrgIds": [
              "1SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tekyandisinze nnyo leero singa abasajja baalidde ku munyago gw'abalabe baabwe? Era tebandisse Abafirisuuti abasinga awo obungi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayisirayiri we baamalira okutta Abafirisuuti okuva e Mikumasi okutuuka e Ayalooni nga bakooye nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne badda ku munyago, ne baddira endiga n'ente n'ennyana ne bazisalira wansi ku ttaka ne balya ennyama n'omusaayi gwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omuntu omu n'ategeeza Sawulo nti, \"Abantu basobya ku",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.33",
                "verseOrgIds": [
                  "1SA.14.33"
                ]
              }
            }
          ]
        },
        {
          "text": "kubanga balya ennyama erimu omusaayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:33"
      },
      "items": [
        {
          "text": "N'ayogera nti, \"Musobezza nnyo. Munjiringisirize wano ejjinja eddene kaakano.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'agamba nti, \"Muyiteeyite mu bantu mubategeeze nti, 'Buli omu ku mmwe aleete ente ye n'endiga ye muzittire wano era mu zirye. Temuddangayo okusobya ku",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.34",
                "verseOrgIds": [
                  "1SA.14.34"
                ]
              }
            }
          ]
        },
        {
          "text": "nga mulya ennyama erimu omusaayi.' \" Awo buli omu ku bo n'aleeta ente ye ekiro ekyo n'agisalira awo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'azimbira",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.35",
                "verseOrgIds": [
                  "1SA.14.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ekyoto, era ekyo kye kyoto kye yasooka okuzimbira",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.35",
                "verseOrgIds": [
                  "1SA.14.35"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'ayogera nti, \"Tuserengete tugoberere Abafirisuuti ekiro kino tubanyage okutuusa emmambya lw'eneesala, era tuleme okulekawo wadde omu ku bo nga mulamu.\" Ne bamuddamu nti, \"Kola nga bw'osiima.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 14:36"
      },
      "items": [
        {
          "text": "Naye kabona n'ayogera nti, \"Twebuuze ku Katonda wano.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo ne yeebuuza ku Katonda ng'agamba nti, \"Ŋŋende nnumbe Abafirisuuti? Onoobagabula mu mukono gwa Isirayiri?\" Naye Katonda n'atamuddamu ku olwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.37",
            "verseOrgIds": [
              "1SA.14.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo kyeyava ayogera nti, \"Mujje wano mmwe mwenna abakulembeze b'abantu, tunoonyereze tulabe ekibi ekikoleddwa leero.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.38",
            "verseOrgIds": [
              "1SA.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.39",
                "verseOrgIds": [
                  "1SA.14.39"
                ]
              }
            }
          ]
        },
        {
          "text": "alokola Isirayiri bw'ali omulamu, ne bwe kinaaba ku mutabani wange Yonasaani, ateekwa kufa.\" Naye ne wataba n'omu amwanukula.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'agamba Abayisirayiri bonna nti, \"Muyimirire ku ludda olwo, nze ne mutabani wange Yonasaani tunaayimirira ku ludda luno.\" Abantu ne bamuddamu nti, \"Kola nga bw'onoosiima.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'asaba",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.41",
                "verseOrgIds": [
                  "1SA.14.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri nti, \"Kiki ekikugaanye okuddamu omuweereza wo leero? Omusango bwe guba nga guli ku nze oba ku mutabani wange Yonasaani ddamu ne Wumimu, naye bwe guba nga guli ku bantu bo Isirayiri, onaddamu ne Sumimu.\" Awo akalulu ne kakubibwa era ne kagwa ku Sawulo ne Yonasaani mutabani we.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo n'ayogera nti, \"Mutukubire akalulu nze ne mutabani wange Yonasaani.\" Yonasaani n'alondebwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'abuuza Yonasaani nti, \"Mbulira ky'okoze.\" Yonasaani n'amutegeeza nti, \"Nakombyeko katono ku mubisi gw'enjuki nga nkozesa omusa gw'omuggo gwange. Kaakano ekyo kinsanyiza okufa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawulo n'amuddamu nti, \"Katonda ankole bw'atyo n'okukirawo bw'otoofe, Yonasaani!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abantu ne bagamba Sawulo nti, \"Lwaki, Yonasaani akoze eby'amagero ebyo byonna mu Isirayiri afa? Ddala Yonasaani attibwe? Oyo aleetedde Isirayiri obununuzi obw'ekitalo? Nedda tekisoboka! Nga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "1SA.14.45",
                "verseOrgIds": [
                  "1SA.14.45"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ali omulamu, tewali luviiri na lumu lunaava ku mutwe gwe ne lugwa wansi, kubanga ebyo by'akoze leero Katonda y'amuyambye okubikola.\" Abantu ne banunula Yonasaani bwe batyo, n'atattibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Sawulo n'alekeraawo okugoberera Abafirisuuti, nabo ne beddirayo mu nsi yaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Sawulo bwe yalya obwakabaka bwa Isirayiri n'alwana n'abalabe be ku njuyi zonna: Mowaabu, n'Abamoni, ab'e Edomu, ne bakabaka ba Zoba, n'Abafirisuuti, na buli we yaddanga n'abawangula.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'alwana n'obuzira bungi n'awangula Abamaleki, n'anunula Isirayiri okuva mu mukono gw'abo abaabanyaganga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enju ya Sawulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Sawulo baali Yonasaani, ne Isuvi, ne Malukisuwa. Amannya ga bawala be ababiri gaali Merabu nga ye mukulu, ate omuto nga ye Mikali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukyala we ye yali Akinoamu muwala wa Akimaazi. Omuduumizi w'eggye lye omukulu ye yali Abuneeri mutabani wa Neeri, taata wa Sawulo omuto.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi kitaawe wa Sawulo ne Neeri kitaawe wa Abuneeri baali batabani ba Abiyeeri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro byonna ebya Sawulo, waaliwo okulwanagana okw'amaanyi n'Abafirisuuti, era buli Sawulo bwe yalabanga omusajja ow'amaanyi oba omuzira n'amuyingiza mu magye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.52",
            "verseOrgIds": [
              "1SA.14.52"
            ]
          }
        }
      ]
    }
  ],
