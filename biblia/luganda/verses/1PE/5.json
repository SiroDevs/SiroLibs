  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1PE 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katonda Talemererwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mbulirira abakadde abali mu mmwe nze mukadde munnammwe, omujulirwa w'okubonaabona kwa Kristo, era agabanira awamu ekitiibwa ekigenda okubikkulirwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.1",
            "verseOrgIds": [
              "1PE.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulundenga ekisibo kya Katonda ekiri mu mmwe, mukiriisenga nga mukirabirira n'okwagala so si na kwemulugunya, nga mukolerera amagoba ag'obukuusa wabula olw'okujjumbira Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.2",
            "verseOrgIds": [
              "1PE.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be mukulembera temubakambuwaliranga wabula mubakulemberenga nga mubalaga ekyokulabirako ekirungi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.3",
            "verseOrgIds": [
              "1PE.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Omusumba Omukulu bw'alikomawo, muliweebwa engule ey'ekitiibwa ekitaliggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.4",
            "verseOrgIds": [
              "1PE.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe abavubuka, mugonderenga abakulu. Muweerezeganenga mwekka na mwekka n'obuwombeefu kubanga",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 5:5"
      },
      "items": [
        {
          "text": "\"Katonda akyawa ab'amalala",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 5:5"
      },
      "items": [
        {
          "text": "naye abawombeefu abawa omukisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mwewombeeke wansi w'omukono gwa Katonda ogw'amaanyi, naye alibagulumiza ng'obudde butuuse.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumutwalirenga byonna bye mweraliikirira kubanga abalumirwa era afaayo ku buli ekibatuukako.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutunulenga, mwekuume omulabe wammwe Setaani, atambulatambula ng'empologoma enjala gy'eruma egenda ng'ewuluguma ng'enoonya gw'eneerya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.8",
            "verseOrgIds": [
              "1PE.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaŋŋange ng'abalumbye, nga mwesiga Mukama, era mujjukire nti ebibonoobono ebiri ng'ebyo bituuka ne ku bakkiriza abalala mu nsi yonna.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
              "1PE.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe mulibonaabonera akaseera, Katonda waffe atukwatirwa ekisa ng'ayita mu Kristo, alibawa ekitiibwa kye ekitaliggwaawo. Alibakomyawo, alibazzaamu amaanyi, alibawanirira era alibanyweza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiibwa n'amaanyi bibeerenga gy'ali emirembe n'emirembe. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebbaluwa eno nzija kugikwasa Sirwano",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
          "text": ", gwe mmanyi nga waaluganda mwesigwa ddala, agibaleetere. Nsuubira nga mbazizzaamu amaanyi mu bbaluwa eno, era nga mbalaze engeri Katonda gy'agabamu ekisa kye ekingi. Ebyo bye mbategeezezza bibayambe okunywerera mu kwagala kwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balonde bannammwe mu kkanisa y'e Babulooni, babalamusizza. Ne mutabani wange Makko naye abalamusizza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulamusagane n'okwagala okw'Ekikristaayo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1PE 5:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 5:14"
      },
      "items": [
        {
          "text": "Emirembe gibeerenga mu mmwe mwenna abali mu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
      ]
    }
  ],
