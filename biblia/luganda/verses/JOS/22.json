  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOS 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yoswa n'ayita Abalewubeeni n'Abagaadi n'ekitundu eky'ekika kya Manase,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abagamba nti, \"Mwekuumye ne mukola byonna Musa omuweereza wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.2",
                "verseOrgIds": [
                  "JOS.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda bye yabalagira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebbanga lyonna n'okutuusa leero temulekeredde baganda bammwe, mubadde beegendereza okukuuma ekiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.3",
                "verseOrgIds": [
                  "JOS.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kaakano",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.4",
                "verseOrgIds": [
                  "JOS.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe awadde baganda bammwe emirembe nga bwe yabasuubiza. Noolwekyo muddeeyo mu maka gammwe mu nsi Musa omuweereza wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.4",
                "verseOrgIds": [
                  "JOS.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gye yabawa ku luuyi luli olulala olwa Yoludaani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula mwegendereze okukuumanga ebiragiro era n'amateeka Musa omuweereza wa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.5",
                "verseOrgIds": [
                  "JOS.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yabalagira: okwagalanga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.5",
                "verseOrgIds": [
                  "JOS.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, okutambuliranga mu makubo ge gonna, okukuumanga ebiragiro bye, n'okumunywererangako era n'okumuweerezanga n'omutima gwammwe gwonna era n'emmeeme yammwe yonna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'alyoka abasabira omukisa n'abasiibula ne baddayo mu maka gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekyoto ku Yoludaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitundu ekimu eky'ekika kya Manase, Musa yali akigabidde ettaka mu Basani, n'ekitundu ekirala eky'ekika kya Manase ne baganda baabwe, Yoswa n'akiwa ettaka ku luuyi olw'ebugwanjuba bwa Yoludaani. Yoswa n'abawa omukisa n'abasiibula baddeyo ewaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.7",
            "verseOrgIds": [
              "JOS.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti, \"Ente nnyingi, ne ffeeza, ne zaabu, n'ekikomo, n'ekyuma, era n'engoye nnyingi bye munyaze ku balabe bammwe; mubigabaane ne baganda bammwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abalewubeeni n'abaana ba Gaadi n'ekitundu eky'ekika kya Manase nga bava mu baana ba Isirayiri mu Siiro ekiri mu nsi ya Kanani ne baddayo mu nsi yaabwe, mu Gireyaadi, gye baali bagabanye bo bennyini ng'ekiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.9",
                "verseOrgIds": [
                  "JOS.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda bwe kyali okuyita mu Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe baatuuka mu kitundu ekiriraanye Yoludaani mu nsi ya Kanani, abaana ba Lewubeeni n'abaana ba Gaadi n'ekitundu eky'ekika kya Manase, ne bazimba awo ekyoto, ekinene ddala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.10",
            "verseOrgIds": [
              "JOS.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula abantu ba Isirayiri bwe baawulira nti bazimbye ekyoto ku Yoludaani ku luuyi lwa Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekibiina kyonna ekya Isirayiri ne bakuŋŋaana e Siiro beetegekere olutalo babalumbe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abaana ba Isirayiri ne batuma Finekaasi omwana wa Eriyazaali kabona eri Abalewubeeni, n'Abagaadi, n'ekitundu ky'ekika kya Manase mu nsi ya Gireyaadi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne batumirako abakungu kkumi, omu omu omukulu w'ennyumba mu buli kika kya Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe bajja eri Abalewubeeni, n'Abagaadi, n'ekibiina kyonna ekya Manase mu nsi ya Gireyaadi ne babagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekibiina kyonna ekya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.16",
                "verseOrgIds": [
                  "JOS.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe kiti bwe kigamba, 'Muyinza mutya okukyama bwe muti okuva ku Katonda wa Isirayiri? Muyinza mutya okuva ku",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.16",
                "verseOrgIds": [
                  "JOS.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ne mwezimbira ekyoto ne mumujeemera awo?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibi kya Peoli tekyatumala, ate nga n'okwerongoosa tubadde tetunnaba kwerongoosa kwemalako kibi ekyo, wadde kawumpuli yagwa ku kibiina kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.17",
                "verseOrgIds": [
                  "JOS.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ate mmwe ne mulekeraawo okugoberera",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.18",
                "verseOrgIds": [
                  "JOS.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 22:18"
      },
      "items": [
        {
          "text": "\" 'Bwe munaajeemera",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.18",
                "verseOrgIds": [
                  "JOS.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "leero, enkya ajja kunyiigira eggwanga lyonna erya Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obanga ensi gye mututte sinnongoofu, mujje eno eri ensi ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", weema ya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "gy'eri, tugabane eno gye tuli; kye mutasaana kukola kwe kujeemera",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", oba okutufuula ffe abajeemu nga mwezimbira ekyoto ekitali kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.19",
                "verseOrgIds": [
                  "JOS.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akani mutabani wa Zeera teyajeema bwe yatoola ku bintu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.20",
                "verseOrgIds": [
                  "JOS.22.20"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yali yeerobozza, ekiruyi kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.20",
                "verseOrgIds": [
                  "JOS.22.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira ekibiina kyonna ekya Isirayiri? Si ye yekka eyazikirira olw'ekibi kye.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalewubeeni, n'Abagaadi, n'ekitundu ky'ekika kya Manase ne balyoka baddamu abakulu b'ebika bya Isirayiri nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.21",
            "verseOrgIds": [
              "JOS.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Amaanyi! Ye amanyi, era Isirayiri akimanye! Bwe kiba nga kyabadde mu kwediima oba kujeemera",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.22",
                "verseOrgIds": [
                  "JOS.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", temutusonyiwa leero.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe tuba nga ekyatuzimbya ekyoto kwe kuva ku",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.23",
                "verseOrgIds": [
                  "JOS.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", tukiweereko ekiweebwayo ekyokebwa oba ekiweebwayo ekyobutta oba ssaddaaka ez'ebiweebwayo olw'emirembe,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.23",
                "verseOrgIds": [
                  "JOS.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda yennyini atuvunaane.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nedda, twakikola mu kutya nti mu mirembe egijja abaana baffe balitubuuza nti, '",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.24",
                "verseOrgIds": [
                  "JOS.22.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri mumumanyiiko ki?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "yakola Yoludaani okubeera ensalo wakati wammwe naffe mmwe Abalewubeeni, n'Abagaadi, temulina mugabo eri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.' Noolwekyo abaana bammwe bayinza okugaana abaana baffe okusinza",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.25",
                "verseOrgIds": [
                  "JOS.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kyetwava tugamba nti, 'Leka tuzimbe kaakano ekyoto ekitali kya kukozesa ku biweebwayo ebyokebwa, wadde ssaddaaka,'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.26",
            "verseOrgIds": [
              "JOS.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye kibeere akabonero ak'obujulizi wakati waffe nammwe, era ne wakati we mirembe egirituddirira nti tugenda mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.27",
                "verseOrgIds": [
                  "JOS.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne tumusinza n'ebiweebwayo byaffe ebyokebwa ne ssaddaaka era n'ebiweebwayo olw'emirembe si kulwa nga abaana bammwe bagamba abaana baffe mu biseera ebijja nti, 'Temulina mugabo gwonna eri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.27",
                "verseOrgIds": [
                  "JOS.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyetwava tugamba nti, 'Bwe balitugamba batyo oba okugamba abaana baffe abaliddawo, tulibaddamu nti, \"Mulabe ekifaananyi kye kyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.28",
                "verseOrgIds": [
                  "JOS.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, bakitaffe kye baakola, si lwa biweebwayo ebyokebwa wadde ssaddaaka, naye okubeera omujulirwa wakati waffe nammwe.\" '",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikafuuwe ffe okujeemera",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.29",
                "verseOrgIds": [
                  "JOS.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "era n'okumuvaako leero ne tutamugoberera nga tuzimba ekyoto eky'ebiweebwayo ebyokebwa, oba ebiweebwayo eby'empeke, oba ssaddaaka, ekitali kyoto kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.29",
                "verseOrgIds": [
                  "JOS.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe ekiri mu maaso ga Ssanduuko y'Endagaano ye!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekyoto Kikkirizibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finekaasi kabona, n'abakulu b'ebibiina by'ebika bya Isirayiri abaali naye bwe baawulira ebigambo Abalewubeeni, n'Abagaadi n'aba Manase bye bayogera, ne bibasanyusa nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finekaasi mutabani wa Eriyazaali kabona n'agamba Abalewubeeni n'Abagaadi n'abaana ba Manase nti, \"Leero tutegedde nti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.31",
                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ali wakati mu ffe, kubanga temukoze kivve kino eri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.31",
                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, kaakano abantu ba Isirayiri mubawonyezza omukono gwa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.22.31",
                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Finekaasi mutabani wa Eriyazaali kabona, n'abakulu b'ebika ne bava eri Abalewubeeni, n'Abagaadi mu nsi ye Kanani, ne baddayo eri abantu ba Isirayiri ne bababuulira ebibaddeyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
