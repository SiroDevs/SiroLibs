          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bye baayogera ne bisanyusa abantu ba Isirayiri ne bagulumiza Katonda ne bataddayo kwogera ku bya lutalo kubalumba, bazikirize ensi Abalewubeeni, n'Abagaadi gye baali basenze.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        }
