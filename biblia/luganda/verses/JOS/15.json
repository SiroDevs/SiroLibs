  "verseCount": 63,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOS 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ensalo za Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo gw'abaana ba Yuda ng'enju zaabwe bwe zaali bwe baakuba akalulu, baaweebwa ekitundu okutuuka ku nsalo ya Edomu, ku lukoola lwa Zini, ku nkomerero y'oluuyi olw'obukiikaddyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ensalo yaabwe ey'oluuyi olwo okuva ku Nnyanja ey'Omunnyo w'eva, ku kikono ekitunudde mu bukiikaddyo;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'esala wansi w'ekkubo eririnnya ku Akkulabimu n'eyita okutuuka ku Zini n'erinnya okuyita wansi wa Kadesubanea, n'eyita kumpi ne Kezulooni, n'erinnya ku Addali, n'ekyamira ku Kaluka;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'eyita ku Azumoni n'ekoma ku mugga ogw'e Misiri, n'eryoka esibira ku nnyanja. Eno ye yali ensalo yaabwe ey'obukiikaddyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ensalo yaabwe ey'obuvanjuba yali nnyanja ey'obukiikakkono. Kyali kikono kya Yoludaani we guyiyira ku Nnyanja ey'Omunnyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 15:5"
      },
      "items": [
        {
          "text": "N'ensalo ey'obukiikakkono kyali kikono kya nnyanja Yoludaani we guyiyiramu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'eyambuka n'eyita ku Besukogula n'eyita ku luuyi lw'ebuvanjuba bwa Besualaba n'eyambuka okutuuka ku jjinja lya Bokani omwana wa Lewubeeni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'erinnya ku Debiri okuva mu kiwonvu Akoli, n'egenda ku luuyi olw'obukiikakkono, n'edda e Girugaali emitala w'ekkubo eryambuka ku Adummimu, ekiri emitala w'omugga mu bukiikaddyo, n'etuuka ku nsalo ku mazzi ag'e Ensemesi, n'esala n'ekoma ku Enerogeri. Awo n'eryoka eyita ku kiwonvu kya Kinomu ku luuyi lw'ebugwanjuba ekyali ku nkomerero ey'ekiwonvu kya Lefayimu ku luuyi olw'obukiikakkono.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'eryoka eva ku kiwonvu ky'omwana wa Kinomu n'etuuka ku njegoyego za Yebusi ku luuyi olw'obukiikaddyo ye Yerusaalemi, ne yeeyongera ku ntikko y'olusozi oluli w'okkira mu kiwonvu kya Kinomu ku luuyi olw'ebugwanjuba, ku nkomerero y'ekiwonvu kya Lefayimu mu bukiikakkono;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne yeeyongera okuva ku ntikko y'olusozi n'etuuka ku luzzi olw'amazzi ga Nefutoa, ne yeeyongerayo n'etuuka ku bibuga eby'oku lusozi Efuloni, n'etuuka ku Baala, ye Kiriyasuyalimu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ewetamu okuva e Baala ku luuyi olw'ebugwanjuba n'etuuka ku lusozi Sayiri n'eyita n'etuuka ku mabbali g'olusozi Yealimu ku luuyi olw'omu bukiikakkono, ye Kyesaloni, n'ekka ku Besusemesi, n'eyita ku Timuna,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'egenda ku mabbali ag'e Ekuloni mu bukiikakkono, n'ekka ku Sikkeroni n'etuuka ku lusozi Baala, n'ekoma ku Yabuneeri, ne ku nnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensalo ey'ebugwanjuba yali Ennyanja Ennene n'olubalama lwayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 15:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 15:12"
      },
      "items": [
        {
          "text": "Eyo ye yali ensalo y'abaana ba Yuda ku njuyi zonna ng'enju zaabwe bwe zaali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omugabo gwa Kalebu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa n'awa Kalebu omwana wa Yefune omugabo mu baana ba Yuda Kiriasualuba, ye Kebbulooni, ng'ekiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.15.13",
                "verseOrgIds": [
                  "JOS.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bwe kyali. Aluba ye yali kitaawe wa Anaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu n'agobamu abaana abasatu aba Anaki: Sesayi ne Akimaani, ne Talumaayi, abaana ba Anaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ava eyo n'alumba abaali mu Debiri, edda eyayitibwanga Kiriasuseferi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu n'agamba nti, \"Anaakuba Kiriasuseferi n'akiwamba ndimuwa muwala wange Akusa amuwase.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osunieri omwana wa Kenazi, muganda wa Kalebu, n'akikuba, Kalebu n'amuwa Akusa muwala we amuwase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yajja gy'ali, n'amugamba asabe kitaawe ennimiro. Bwe yava ku ndogoyi ye, Kalebu n'amubuuza nti, \"Kiki kyoyagala nkukolere?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'addamu nti, \"Nsaba onnyambe nga bwe wampa ettaka mu Negebu, ompe n'ensulo z'amazzi.\" Kalebu n'amuwa ensulo ez'engulu n'ez'emmanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omugabo gwa Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guno gwe mugabo gw'ekika ky'abaana ba Yuda ng'enju zaabwe bwe zaali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibuga ebyali bisemberayo ddala mu bukiikaddyo mu Negebu eri ensalo ya Edomu byali,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:21"
      },
      "items": [
        {
          "text": "Kabuzeeri, n'e Ederei n'e Yaguli,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Kina n'e Dimona, n'e Adada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Kedesi, n'e Kazoli, n'e Isunani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Zifu, n'e Teremu n'e Beyaloosi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Kazolukadatta, n'e Keriosukezulooni, ye Kazoli,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Amamu n'e Sema, n'e Molada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'e Kazalugadda n'e Kesuboni, n'e Besupereti",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
