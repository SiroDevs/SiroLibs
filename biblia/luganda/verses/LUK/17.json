          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mbagamba nti ku lunaku olwo abantu babiri baliba ku kitanda kimu, Omu alitwalibwa naye munne n'alekebwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.34",
                "verseOrgIds": [
                  "LUK.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abantu babiri baliba basa ku lubengo, omu alitwalibwa naye munne alirekebwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.35",
                "verseOrgIds": [
                  "LUK.17.35"
                ]
              }
            }
