          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buli anoonya okuwonya obulamu bwe alibufiirwa, naye buli eyeefiiriza obulamu bwe alibuwonya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.33",
                "verseOrgIds": [
                  "LUK.17.33"
                ]
