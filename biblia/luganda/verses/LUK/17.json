        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ku lunaku olwo omuntu yenna aliba waggulu ku nju, takkanga mu nju munda kuggyamu bintu bye. N'abo abaliba mu nnimiro tebaddangayo eka okubaako ne bye banonayo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.31",
                "verseOrgIds": [
