        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mujjukire mukazi wa Lutti!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.32",
                "verseOrgIds": [
