          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abasajja babiri baliba mu nnimiro, omu alitwalibwa naye munne alirekebwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.36",
                "verseOrgIds": [
