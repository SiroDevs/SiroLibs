        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwe bityo bwe biriba ku lunaku, Omwana w'Omuntu lw'alirabikirako.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.30",
                "verseOrgIds": [
                  "LUK.17.30"
                ]
              }
            }
