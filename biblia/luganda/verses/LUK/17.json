  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "LUK 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekibi, Okukkiriza, Omulimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'agamba abayigirizwa be nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ebikemo ebireetera abantu okwonoona tebiyinza butajja, naye zimusanze omuntu oyo abireeta.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.1",
                "verseOrgIds": [
                  "LUK.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ekyandisinze kwe kusiba olubengo mu bulago bwe n'asuulibwa mu nnyanja okusinga okwesittaza omu ku baana bano abato.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.2",
                "verseOrgIds": [
                  "LUK.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.2",
            "verseOrgIds": [
              "LUK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mwekuume.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Muganda wo bw'ayonoonanga, omunenyanga; era singa yeenenya omusonyiwanga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ne bw'akusobyanga emirundi omusanvu mu lunaku olumu, naye buli mulundi n'ajja gy'oli n'akwenenyeza, musonyiwenga.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.4",
                "verseOrgIds": [
                  "LUK.17.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abatume ne bagamba Mukama waffe nti, \"Twongereko okukkiriza.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.5",
            "verseOrgIds": [
              "LUK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama waffe n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Singa okukkiriza kwammwe kuba ng'akaweke ka kaladaali, mwandigambye omukenene guno nti, 'Siguka ogwe mu nnyanja,' era ne gubagondera.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.6",
                "verseOrgIds": [
                  "LUK.17.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Naye ani ku mmwe, ng'omuddu we yaakakomawo okuva okulima oba okulunda endiga, amugamba nti, 'Jjangu mangu otuule ku mmere?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.7",
                "verseOrgIds": [
                  "LUK.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.7",
            "verseOrgIds": [
              "LUK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tamugamba nti, 'Teekateeka emmere yange, weerongoose olabike bulungi, olyoke ompeereze nga ndya era nga nnywa, bwe nnaamala naawe n'onywa era n'olya emmere yo?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.8",
                "verseOrgIds": [
                  "LUK.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.8",
            "verseOrgIds": [
              "LUK.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulowooza nti Mukama w'omuweereza oyo amwebaza olw'okugondera bye yalagirwa okukola?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.9",
                "verseOrgIds": [
                  "LUK.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.9",
            "verseOrgIds": [
              "LUK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nammwe bwe mutyo bwe mumalanga okutuukiriza ebyo ebyabagambibwa okukola, mugambenga nti, 'Ffe abaddu bo abatasaanira tukoze omulimu gwaffe ogutugwanidde.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.10",
                "verseOrgIds": [
                  "LUK.17.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abagenge Kkumi Bawonyezebwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yali yeeyongerayo mu lugendo lwe ng'agenda e Yerusaalemi, n'akwata ekkubo eriyita wakati wa Ggaliraaya ne Samaliya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe yayingira mu kabuga akamu, abasajja kkumi nga bonna bagenge ne bajja okumusisinkana. Ne bayimirira walako",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.12",
            "verseOrgIds": [
              "LUK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakoowoola mu ddoboozi ery'omwanguka nti, \"Yesu, Mukama waffe, tukwatirwe ekisa!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.13",
            "verseOrgIds": [
              "LUK.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yabalaba n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mugende mweyanjule eri bakabona.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.14",
                "verseOrgIds": [
                  "LUK.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Bwe baali nga bagenda ne bawona ne baba balongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu ku bo bwe yalaba ng'awonye n'akomawo eri Yesu nga bw'aleekaanira waggulu ng'atendereza Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.15",
            "verseOrgIds": [
              "LUK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agwa wansi ku bigere bya Yesu ng'amwebaza. Omusajja oyo yali Musamaliya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.16",
            "verseOrgIds": [
              "LUK.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ekkumi bonna tebaawonyezebbwa? Omwenda bo baluwa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.17",
                "verseOrgIds": [
                  "LUK.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tebayinzizza kudda kutendereza Katonda wabula munnaggwanga ono yekka y'akomyewo?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.18",
                "verseOrgIds": [
                  "LUK.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.18",
            "verseOrgIds": [
              "LUK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Situka weetambulire, okukkiriza kwo kukuwonyezza.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.19",
                "verseOrgIds": [
                  "LUK.17.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okujja kw'Obwakabaka bwa Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abafalisaayo ne babuuza Yesu nti, \"Obwakabaka bwa Katonda bulijja ddi?\" Yesu n'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Obwakabaka bwa Katonda tebulabika nga bujja,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.20",
                "verseOrgIds": [
                  "LUK.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "era abantu tebagenda kugamba nti, 'Laba buubuno wano,' oba nti, 'Buubuli wali,' kubanga obwakabaka bwa Katonda buli mu mmwe.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.21",
                "verseOrgIds": [
                  "LUK.17.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma n'agamba abayigirizwa be nti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ekiseera kijja lwe mulyegomba okulaba olumu, ku nnaku z'Omwana w'Omuntu, naye temulirulaba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.22",
                "verseOrgIds": [
                  "LUK.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Balibagamba nti lwe luno era nti lwe luli temugendanga era temubagobereranga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.23",
                "verseOrgIds": [
                  "LUK.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.23",
            "verseOrgIds": [
              "LUK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga ng'eggulu bwe limyansiza ku ludda olumu olw'eggulu ate ne limyansiza ku ludda olulala olw'eggulu, bw'atyo bw'aliba Omwana w'Omuntu ku lunaku lwe,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.24",
                "verseOrgIds": [
                  "LUK.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
            "verseOrgIds": [
              "LUK.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye okusooka kimugwanira okubonaabona mu bintu bingi, n'okugaanibwa, abantu ab'omulembe guno.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.25",
                "verseOrgIds": [
                  "LUK.17.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
