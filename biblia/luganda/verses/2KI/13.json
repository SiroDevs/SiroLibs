  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yekoyakaazi Kabaka wa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'amakumi abiri mu esatu ogwa Yowaasi mutabani wa Akaziya kabaka wa Yuda, Yekoyakaazi n'afuuka kabaka wa Isirayiri mu Samaliya era n'afugira emyaka kkumi na musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.2",
                "verseOrgIds": [
                  "2KI.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'akola ebibi Yerobowaamu mutabani wa Nebati bye yayonoonyesa Isirayiri, ate n'atabirekaayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.3",
                "verseOrgIds": [
                  "2KI.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ne bubuubuukira ku Isirayiri, n'abawaayo okubeera wansi ow'omukono gwa Kazayeeri kabaka w'e Busuuli ne Benikadadi mutabani we.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yekoyakaazi ne yegayirira",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuwulira, era n'alaba okucocca, kabaka w'e Busuuli kwe yacoccanga Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.5",
                "verseOrgIds": [
                  "2KI.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abaddiramu n'abawa omulokozi, ne bawona obufuzi bw'Abasuuli, n'oluvannyuma Abayisirayiri ne babeeranga mirembe mu nnyumba zaabwe nga bwe baali olubereberye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ne batalekaayo kukola ebibi eby'ennyumba ya Yerobowaamu bye yayonoonyesa Isirayiri, wabula beeyongeranga bweyongezi okubikola. N'empagi ey'Asera n'esigalayo mu Samaliya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.7",
                "verseOrgIds": [
                  "2KI.13.7"
                ]
              }
            }
          ]
        },
        {
          "text": "teyalekerawo ggye lya Yekoyakaazi kintu okuggyako abasajja abeebagala embalaasi amakumi ataano, n'amagaali kkumi, n'abaserikale ab'ebigere omutwalo gumu, kubanga kabaka w'e Busuuli yabizikiriza, n'abifuula ng'enfuufu ey'omu gguuliro.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala ebyabaawo mu mirembe gya Yekoyakaazi, ne bye yakola byonna, n'ebyobuzira bwe byonna, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Isirayiri?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoyakaazi n'afa, n'aziikibwa mu Samaliya, Yowaasi mutabani we n'amusikira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yekoyaasi Kabaka wa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'amakumi asatu mu omusanvu ogwa Yowaasi kabaka wa Yuda, Yekoyaasi mutabani wa Yekoyakaazi n'afuuka kabaka wa Isirayiri mu Samaliya, era n'afugira emyaka kkumi na musanvu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'akola ebibi mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.11",
                "verseOrgIds": [
                  "2KI.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'atalekaayo ebibi bya Yerobowaamu mutabani wa Nebati, bye yayonoonyesa Isirayiri, wabula ne yeeyongera bweyongezi okubikola.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyafaayo ebirala ebyabaawo mu mirembe gya Yekoyaasi, bye yakola byonna, n'amaanyi ge, nga kwe kuli n'olutalo lwe yalwana ne Amaziya kabaka wa Yuda, tebyawandiikibwa mu kitabo eky'ebyomumirembe gya bassekabaka ba Isirayiri?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoyaasi n'afa, n'aziikibwa mu Samaliya, Yerobowaamu n'amusikira okuba kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okufa kwa Erisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu biro ebyo Erisa n'alwala nnyo, endwadde eyamutta, Yowaasi n'aserengeta gy'ali okumulaba, n'akaabira amaziga, mu maaso ge ng'agamba nti, \"Kitange, Kitange, amagaali n'abeebagala embalaasi aba Isirayiri!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa n'amuddamu nti, \"Ffuna omutego n'obusaale,\" era n'akola bw'atyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba kabaka wa Isirayiri nti, \"Bikwate mu ngalo.\" Bwe yamala okukola ekyo, Erisa n'ateeka emikono gye ku gya kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa n'amugamba nti, \"Ggulawo eddirisa ery'ebuvanjuba,\" n'aliggulawo. N'amulagira okulasa. Erisa n'ayogera nti, \"Akasaale ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.17",
                "verseOrgIds": [
                  "2KI.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ak'obuwanguzi, akasaale ak'obuwanguzi eri Obusuuli, era ojja kusaanyizaawo ddala Abasuuli mu Afeki.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amugamba nti, \"Kwata obusaale,\" n'abukwata. N'agamba kabaka wa Isirayiri okulasa ettaka. N'alirasa emirundi esatu, n'akoma awo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja wa Katonda n'amunyiigira, n'amugamba nti, \"Wandirasizza emirundi etaano oba mukaaga, olwo n'olyoka owangulira ddala Abasuuli era n'obasaanyaawo. Naye kaakano olibawangula emirundi esatu gyokka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisa n'afa, n'aziikibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 13:20"
      },
      "items": [
        {
          "text": "Ebibinja by'Abamowaabu byateranga okulumba ensi ku ntandikwa ya buli mwaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo olwatuuka, Abayisirayiri abamu baali baziika omusajja, ne balengera ekibinja eky'abasajja nga kijja, ne basuula omulambo gwe mu ntaana ya Erisa ne badduka. Omulambo gwe bwe gw'akoma ku magumba ga Erisa omusajja n'alamuka, era n'ayimirira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera kye kimu Kazayeeri kabaka w'e Busuuli n'ajooga Isirayiri ebbanga lyonna Yekoyakaazi we yabeerera kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
