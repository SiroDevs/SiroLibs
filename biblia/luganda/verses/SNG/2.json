          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukono gwe ogwa kkono guli wansi wa mutwe gwange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:6"
      },
      "items": [
        {
          "text": "n'omukono gwe ogwa ddyo gumpambatira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwe abawala ba Yerusaalemi, mbakuutira,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "ng'empeewo n'enjaza ez'omu ttale,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "temusisimula newaakubadde okuzuukusa okwagala",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:7"
      },
      "items": [
        {
          "text": "okutuusa nga kweyagalidde.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
