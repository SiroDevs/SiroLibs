            "sid": "SNG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwagalwa wange ali ng'empeewo oba ennangaazi ento.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "Laba ayimiridde emabega w'olukomera lwaffe,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "Alingiza mu madirisa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "alabikira mu mulimu ogulukibwa ogw'omu ddirisa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        }
      ]
    },
    {
