            "sid": "SNG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yantwala ku kijjulo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:4"
      },
      "items": [
        {
          "text": "n'okwagala kwe ne ku mmaamira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munzizeemu amaanyi n'ezabbibu enkalu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "mumbuddeebudde n'emicungwa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:5"
      },
      "items": [
        {
          "text": "kubanga okwagala kunzirisizza.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
