      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "n'emizabbibu gimulisizza ne gibunya akawoowo kaagyo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
