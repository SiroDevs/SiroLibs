          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiro kyonna nga ndi ku kitanda kyange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "nalindirira emmeeme yange gw'eyagala,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "ne munoonya naye saamulaba.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaagolokoka ne ntambulatambulako mu kibuga,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "mu nguudo ne mu bifo ebigazi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "nanoonya emmeeme yange gw'eyagala,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "ne nnindirira naye saamulaba.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuumi b'ekibuga",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "abaali balawuna mu kibuga, ne bansisinkana, ne mbabuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:3"
      },
      "items": [
        {
          "text": "\"Mundabidde ku oyo emmeeme yange gw'eyagala?\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.3",
            "verseOrgIds": [
              "SNG.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twali twakayisiŋŋanya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "ne ndaba oyo emmeeme yange gw'eyagala.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "Ne munnywegera ne simuganya kugenda,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "okutuusa lwe namuleeta mu nnyumba ya mmange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:4"
      },
      "items": [
        {
          "text": "ne mutwala mu kisenge ky'oyo eyanzaala.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.4",
            "verseOrgIds": [
              "SNG.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbakuutira mmwe abawala ba Yerusaalemi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "ng'empeewo n'enjaza ez'oku ttale,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "temusisimula newaakubadde okuzuukusa okwagala",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "okutuusa nga kwesiimidde.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
