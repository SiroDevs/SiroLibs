          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embalaasi za Sulemaani zaagulibwanga mu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eggaali zaagulibwanga kilo musanvu eza ffeeza, na buli mbalaasi ng'egulibwa kilo emu n'ekitundu eza ffeeza mu Misiri. Ate era baazitunzanga ne bakabaka ab'Abakiiti ne bakabaka ab'e Busuuli.",
          "type": "text",
