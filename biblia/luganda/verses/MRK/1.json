{
  "id": "MRK.1",
  "number": "1",
  "bookId": "MRK",
  "reference": "Makko 1",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MRK 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yokaana Omubatiza Alongoosa Ekkubo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entandikwa y'Enjiri ya Yesu Kristo, Omwana wa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.1",
            "verseOrgIds": [
              "MRK.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyawandiikibwa mu kitabo kya nnabbi Isaaya nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 1:2"
      },
      "items": [
        {
          "text": "\"Laba ntuma omubaka wange akukulembere,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 1:2"
      },
      "items": [
        {
          "text": "ateeketeeke ekkubo lyo;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "eddoboozi ly'oyo ayogelera waggulu mu ddungu nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.3",
            "verseOrgIds": [
              "MRK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 1:3"
      },
      "items": [
        {
          "text": "'Muteeketeeke ekkubo lya Mukama,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.3",
            "verseOrgIds": [
              "MRK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 1:3"
      },
      "items": [
        {
          "text": "mutereeze amakubo ge.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.3",
            "verseOrgIds": [
              "MRK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana yajja ng'abatiriza mu ddungu, ng'abuulira okubatiza okw'okwenenya olw'okusonyiyibwa ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.4",
            "verseOrgIds": [
              "MRK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yonna ey'e Buyudaaya n'abantu bonna ab'omu Yerusaalemi, ne bagendanga gy'ali, n'ababatiza mu mugga Yoludaani nga baatula ebibi byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.5",
            "verseOrgIds": [
              "MRK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokaana yayambalanga ekyambalo eky'obwoya bw'eŋŋamira, ne yeesibanga olukoba olw'eddiba mu kiwato kye, era yalyanga nzige na mubisi gwa njuki.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.6",
            "verseOrgIds": [
              "MRK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabuuliranga ng'agamba nti, \"Waliwo omuntu omukulu era ansinga amaanyi ajja okujja, gwe sisaanira na kusumulula bukoba bwa ngatto ze.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.7",
            "verseOrgIds": [
              "MRK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze mbabatiza na mazzi, naye ye alibabatiza na Mwoyo Mutukuvu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.8",
            "verseOrgIds": [
              "MRK.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okubatizibwa kwa Yesu n'Okukemebwa kwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo olwatuuka mu nnaku ezo Yesu n'ava e Nazaaleesi mu Ggaliraaya n'ajja, Yokaana n'amubatiza mu mugga Yoludaani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.9",
            "verseOrgIds": [
              "MRK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yali yaakava mu mazzi, n'alaba eggulu nga libikkuse, ne Mwoyo ng'ali ng'ejjiba ng'amukkako.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.10",
            "verseOrgIds": [
              "MRK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eddoboozi ne liva mu ggulu nga ligamba nti, \"Ggwe Mwana wange omwagalwa, ggwe, gwe nsanyukira ennyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.11",
            "verseOrgIds": [
              "MRK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago Mwoyo n'amutwala mu ddungu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.12",
            "verseOrgIds": [
              "MRK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'amalayo ennaku amakumi ana ng'ali n'ensolo ez'omu nsiko, ng'akemebwa Setaani, kyokka nga bamalayika bamuweereza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.13",
            "verseOrgIds": [
              "MRK.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Ayita Abayigirizwa Abaasooka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma nga Yokaana Omubatiza amaze okusibwa mu kkomera, Yesu n'ajja mu Ggaliraaya okubuulira Enjiri ya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.14",
            "verseOrgIds": [
              "MRK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.15",
            "verseOrgIds": [
              "MRK.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ekiseera kituukiridde, n'obwakabaka bwa Katonda busembedde! Mwenenye mukkirize Enjiri.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.15",
                "verseOrgIds": [
                  "MRK.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.15",
            "verseOrgIds": [
              "MRK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu yali ng'ayita ku lubalama lw'ennyanja y'e Ggaliraaya, n'alaba Simooni ne muganda we Andereya nga basuula obutimba bwabwe mu nnyanja; kubanga baali bavubi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.16",
            "verseOrgIds": [
              "MRK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.17",
            "verseOrgIds": [
              "MRK.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mujje mungoberere nange ndibafuula abavubi b'abantu!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.17",
                "verseOrgIds": [
                  "MRK.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.17",
            "verseOrgIds": [
              "MRK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ne baleka obutimba bwabwe ne bamugoberera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.18",
            "verseOrgIds": [
              "MRK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yeeyongerayo katono, n'alaba Yakobo ne Yokaana batabani ba Zebbedaayo, nga bali mu lyato baddaabiriza obutimba bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.19",
            "verseOrgIds": [
              "MRK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago n'abayita ne baleka kitaabwe Zebbedaayo mu lyato n'abapakasi, ne bagoberera Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.20",
            "verseOrgIds": [
              "MRK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Omusajja Eyaliko Dayimooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne bayingira mu Kaperunawumu. Amangwago n'ayingira mu kuŋŋaaniro ku Ssabbiiti, n'abayigiriza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.21",
            "verseOrgIds": [
              "MRK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne beewuunya okuyigiriza kwe, kubanga yabayigiriza nga nannyini buyinza, so si ng'abannyonnyozi b'amateeka bwe baakolanga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.22",
            "verseOrgIds": [
              "MRK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ne walabika omusajja eyaliko omwoyo omubi mu ssinzizo, n'awowoggana,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.23",
            "verseOrgIds": [
              "MRK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'agamba nti, \"Otwagaza ki Yesu Omunnazaaleesi? Ozze okutuzikiriza? Nkumanyi gwe Mutukuvu wa Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.24",
            "verseOrgIds": [
              "MRK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'aguboggolera ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.25",
            "verseOrgIds": [
              "MRK.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sirika era muveeko.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.25",
                "verseOrgIds": [
                  "MRK.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.25",
            "verseOrgIds": [
              "MRK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omwoyo omubi ne gumusikambula nnyo, ne gumuvaako.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.26",
            "verseOrgIds": [
              "MRK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli omu ne yeewuunya, ne beebuuzaganya nti, \"Kuyigiriza kwa ngeri ki kuno okuggya okujjudde obuyinza? So n'emyoyo emibi agiragira ne gimugondera.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.27",
            "verseOrgIds": [
              "MRK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago amawulire agamukwatako ne gasaasaana wonna mu byalo ebyetoolodde Ggaliraaya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.28",
            "verseOrgIds": [
              "MRK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Nnyina wa Muka Simooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ne bava mu kkuŋŋaaniro ne bagenda mu nnyumba ya Simooni ne Andereya nga bali ne Yakobo ne Yokaana.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.29",
            "verseOrgIds": [
              "MRK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne basanga nga nnyina muka Simooni agalamidde mulwadde omusujja. Amangwago ne bakitegeeza Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.30",
            "verseOrgIds": [
              "MRK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yamusemberera, n'amukwata ku mukono n'amuyimusa, omusujja ne gumuwonako, n'abaweereza!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.31",
            "verseOrgIds": [
              "MRK.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Abalwadde Abangi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo obudde bwe bwali buwungeera, ng'enjuba egwa, ne bamuleetera abalwadde bonna, n'abaaliko dayimooni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.32",
            "verseOrgIds": [
              "MRK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibuga kyonna ne kikuŋŋaanira ku luggi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.33",
            "verseOrgIds": [
              "MRK.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Yesu n'awonya abalwadde bangi abaalina endwadde ez'enjawulo era n'abaaliko baddayimooni bangi n'ababagobako, ne baddayimooni teyabaganya kwogera, kubanga baali bamumanyi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.34",
            "verseOrgIds": [
              "MRK.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Asaba Yekka mu Kifo Eteri Bantu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkeera ng'obudde tebunnalaba yesu n'azuukuka n'agenda yekka mu kifo ekyekusifu, okusaba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.35",
            "verseOrgIds": [
              "MRK.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Simooni ne be yali nabo ne bamunoonya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.36",
            "verseOrgIds": [
              "MRK.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwe baamulaba ne bamugamba nti, \"Buli muntu akunoonya.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.37",
            "verseOrgIds": [
              "MRK.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu n'abagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.38",
            "verseOrgIds": [
              "MRK.1.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tugende awalala mu byalo ebituliraanye, n'abeeyo mbabuulire, kubanga ekyo kye najjirira.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.38",
                "verseOrgIds": [
                  "MRK.1.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.38",
            "verseOrgIds": [
              "MRK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'abuulira mu makuŋŋaaniro ag'omu kitundu kyonna eky'e Ggaliraaya, era n'agoba ne baddayimooni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.39",
            "verseOrgIds": [
              "MRK.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Omugenge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omugenge",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.40",
            "verseOrgIds": [
              "MRK.1.40"
            ]
          }
        },
        {
          "text": "n'ajja eri Yesu ne yeegayirira ng'afukamidde mu maaso ge, n'amugamba nti, \"Bwe kuba nga kwe kusiima kwo, oyinza okunnongoosa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.40",
            "verseOrgIds": [
              "MRK.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'amusaasira, n'agolola omukono gwe, n'amukwatako, n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.41",
            "verseOrgIds": [
              "MRK.1.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nsiimye, longooka!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.41",
                "verseOrgIds": [
                  "MRK.1.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.41",
            "verseOrgIds": [
              "MRK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amangwago ebigenge ne bimuwonako, n'aba mulongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.42",
            "verseOrgIds": [
              "MRK.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'amukuutira nnyo n'amusiibula,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.43",
            "verseOrgIds": [
              "MRK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.44",
            "verseOrgIds": [
              "MRK.1.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kino tokibuulirako muntu n'omu, wabula genda weeyanjule eri kabona, oweeyo n'ekirabo Musa kye yalagira okuweebwangayo, okuba obujulirwa gye bali.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.44",
                "verseOrgIds": [
                  "MRK.1.44"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.44",
            "verseOrgIds": [
              "MRK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omusajja n'atandika okwogera ku ebyo ebyamubaako, n'okubibunyisa. Yesu n'atasobola kuyingira mu kibuga mu lwatu, naye n'abeeranga mu bifo ebyekusifu. Abantu ne bajjanga gy'ali okuva mu njuyi zonna.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.45",
            "verseOrgIds": [
              "MRK.1.45"
            ]
          }
        }
      ]
    }
  ],
