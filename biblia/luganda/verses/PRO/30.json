  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PRO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebigambo ba Aguli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bye bigambo bya Aguli mutabani wa Yake; obubaka bwe yawa bwe buno:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:1"
      },
      "items": [
        {
          "text": "Bw'ati omusajja ono bwe yagamba Isiyeri, Isyeri ono ne Ukali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala Ayi Katonda wange nze nsinga obutategeera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:2"
      },
      "items": [
        {
          "text": "sirina kutegeera kwa bantu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyize magezi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:3"
      },
      "items": [
        {
          "text": "so n'oyo Omutukuvu simumanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eyali alinnye mu ggulu n'akka?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ani eyali akuŋŋaanyiza empewo mu kibatu ky'engalo ze?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ani eyali asibye amazzi mu kyambalo kye?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Ani eyatonda enkomerero zonna ez'ensi?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Erinnya lye y'ani, ne mutabani we y'ani?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Mbulira obanga obimanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli kigambo kya Katonda kya mazima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:5"
      },
      "items": [
        {
          "text": "era aba ngabo eri abo abamwesiga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyongeranga ku bigambo bye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:6"
      },
      "items": [
        {
          "text": "alemenga okukunenya naawe olabike ng'omulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu bibiri bye nkusaba; Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.7",
                "verseOrgIds": [
                  "PRO.30.7"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:7"
      },
      "items": [
        {
          "text": "tobinnyimanga nga sinnafa:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo eby'obutaliimu n'eby'obulimba binteeke wala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "ate era tonjavuwazanga wadde okungaggawaza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "naye ndiisanga emmere eya buli lunaku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nneme okukkutanga ne nkwegaana",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "ne njogera nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PRO.30.9",
                "verseOrgIds": [
                  "PRO.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ye y'ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "Era nnemenga okuba omwavu ne nziba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "ne nvumisa erinnya lya Katonda wange.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosekeetereranga muweereza eri mukama we,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:10"
      },
      "items": [
        {
          "text": "alemenga okukukolimira, naawe omusango ne gukusinga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo abo abakolimira bakitaabwe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:11"
      },
      "items": [
        {
          "text": "ne batasabira na bannyaabwe mukisa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo abeeraba ng'abatuukirivu bo mu maaso gaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:12"
      },
      "items": [
        {
          "text": "ate nga tebanaazibwangako bibi byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo abo ab'amalala amayitirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:13"
      },
      "items": [
        {
          "text": "abatunuza okwemanya okw'ekitalo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ebeerayo abo abalina amannyo agali ng'ebitala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "n'emba zaabwe nga zirimu ebiso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "okusaanyaawo abaavu mu nsi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "n'abo abali mu kwetaaga.",
