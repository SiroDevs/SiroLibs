                "verseId": "EXO.10.20",
                "verseOrgIds": [
                  "EXO.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "n'akakanyaza omutima gwa Falaawo, abaana ba Isirayiri n'atabakkiriza kugenda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
