  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EXO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "awa Musa Obuyinza Okukola Ebyamagero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'addamu nti, \"Tebagenda kunzikiriza, wadde okuwuliriza ebyo bye mbagamba: kubanga bagenda kwogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.1",
                "verseOrgIds": [
                  "EXO.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "takulabikiranga.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.2",
                "verseOrgIds": [
                  "EXO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amubuuza nti, \"Ekyo kiki ekiri mu ngalo zo?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:2"
      },
      "items": [
        {
          "text": "N'addamu nti, \"Muggo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.3",
                "verseOrgIds": [
                  "EXO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'amugamba nti, \"Gusuule wansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:3"
      },
      "items": [
        {
          "text": "Musa n'agusuula wansi; ne gufuuka omusota, n'agudduka!",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.4",
                "verseOrgIds": [
                  "EXO.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti, \"Golola omukono gwo ogukwate akawuuwo ogusitule.\" N'agolola omukono gwe n'agukwata, ne gufuuka omuggo mu mukono gwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amugamba nti, \"Bw'olikola bw'otyo bagenda kukukkiriza, era balitegeera nga",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.5",
                "verseOrgIds": [
                  "EXO.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjaabwe, Katonda wa Ibulayimu, era Katonda wa Isaaka, era Katonda wa Yakobo, yakulabikira.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.6",
                "verseOrgIds": [
                  "EXO.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amugamba nate nti, \"Yingiza omukono gwo munda mu kyambalo kyo.\" N'ayingiza omukono gwe munda mu kyambalo kye: bwe yaguggyaayo, laba, nga gujjudde ebigenge nga gutukula ng'omuzira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate n'amugamba nti, \"Zzaayo omukono gwo munda mu kyambalo kyo.\" Musa n'azzaayo omukono gwe mu kyambalo kye. Bwe yaguggyaayo, laba nga gufuuse mulamu ng'omubiri gwe ogwa bulijjo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.8",
                "verseOrgIds": [
                  "EXO.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti, \"Bwe batalikukkiririza ku kabonero akasoose, balikukkiririza ku kabonero akookubiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe bagaananga okukukkiriza nga bamaze okulaba obubonero obwo bwombi, osenanga amazzi mu mugga n'ogayiwa ku lukalu; amazzi ago g'olisena mu mugga, galifuuka omusaayi ng'ogayiye ku lukalu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'agamba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.10",
                "verseOrgIds": [
                  "EXO.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Ayi Mukama wange, siri mwogezi mulungi okuva edda n'edda, wadde ne mu kiseera kino ggwe kaayogerera nange, omuddu wo; njogera nnembeggerera ate nga bwe nnaanaagira.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuddamu nti, \"Ani yakola akamwa k'omuntu? Ani yatonda bakasiru, ne bakiggala, n'abatunula, ne bamuzibe? Si nze,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.11",
                "verseOrgIds": [
                  "EXO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano, genda! Nnaakuyambanga ng'oyogera, era nnaakuyigirizanga by'onooyogeranga.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa n'agamba nti, \"Mukama wange, nkwegayiridde tuma omuntu omulala.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.14",
                "verseOrgIds": [
                  "EXO.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "n'asunguwalira nnyo Musa, n'amugamba nti, \"Muganda wo Alooni Omuleevi, taliiwo? Mmanyi nga mwogezi mulungi; era, laba, ajja gy'oli, era bw'anaakulabako ajja kusanyuka mu mutima gwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe ojja kwogeranga naye, nze nnaakutegeezanga ky'onoomugambanga, nange n'abayambanga mwembi, ne mbayigiriza eky'okukola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Y'anaakwogereranga eri abantu, ng'abategeeza bye wandiyogedde; ggwe n'oba nga Katonda gy'ali, ng'omutegeezanga by'anaayogeranga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oligenda n'omuggo guno, ng'ogukutte mu mukono gwo; gw'onookozesanga ebyamagero.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'addayo eri Yesero, kitaawe wa mukazi we n'amugamba nti, \"Nkusaba onzikirize ŋŋende ndabe obanga baganda bange e Misiri bakyali balamu.\" Yesero n'addamu Musa nti, \"Genda mirembe.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa Addayoko e Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.19",
                "verseOrgIds": [
                  "EXO.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ayogera ne Musa e Midiyaani nti, \"Genda, oddeyo e Misiri kubanga abantu bonna abaali baagala okukutta, baafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'addira mukyala we n'abaana be, n'abassa ku ndogoyi, n'asitula okuddayo mu nsi y'e Misiri, ng'akutte omuggo gwa Katonda mu ngalo ze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.21",
                "verseOrgIds": [
                  "EXO.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti, \"Bw'oddangayo e Misiri, okoleranga ebyamagero ebyo byonna bye nkulaze, awali Falaawo. Nze ndikakanyaza omutima gwe, abantu bange aleme okubakkiriza okugenda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.21",
            "verseOrgIds": [
              "EXO.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Falaawo omugambanga bw'oti nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.22",
                "verseOrgIds": [
                  "EXO.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "agambye nti, 'Isirayiri mutabani wange, ye mwana wange omubereberye;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nkulagira oleke omwana wange agende ampeereze; naye singa ogaana okumuleka okugenda, laba, nditta mutabani wo omubereberye.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.23",
            "verseOrgIds": [
              "EXO.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo bwe baali bagenda nga batuuse ku nnyumba y'abagenyi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.24",
                "verseOrgIds": [
                  "EXO.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amulabikira, n'ayagala okumutta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Zipola n'addira ejjinja eryogi, n'akomola omwana we, ekikuta n'akisuula ku bigere bya Musa, n'amugamba nti, \"Oli baze wa musaayi!\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.4.26",
                "verseOrgIds": [
                  "EXO.4.26"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amuleka. Mu kaseera ako Zipola we yayogerera ku kukomola nti, \"Baze wange ng'osaabye omusaayi!\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
