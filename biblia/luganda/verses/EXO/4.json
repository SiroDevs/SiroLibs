          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakkiriza. Era bwe baawulira nga",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.31",
            "verseOrgIds": [
              "EXO.4.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
