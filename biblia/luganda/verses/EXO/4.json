                "verseOrgIds": [
                  "EXO.4.31"
                ]
              }
            }
          ]
        },
        {
          "text": "yakyalira abaana ba Isirayiri, n'alaba okubonaabona kwabwe, ne bakoteka emitwe gyabwe ne basinza.",
          "type": "text",
          "attrs": {
