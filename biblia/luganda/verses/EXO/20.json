          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyoto kyange temukizimbangako madaala, muleme okukiweebuula nga mulinnya amadaala.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
