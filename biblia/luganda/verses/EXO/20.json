            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe munzimbiranga ekyoto eky'amayinja, temukizimbisanga mayinja mayooyoote, kubanga ekyuma bwe kirigakoonako kirigafuula agatasaanira kyoto kyange.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
