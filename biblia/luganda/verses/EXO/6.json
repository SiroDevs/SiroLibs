  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EXO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.1",
                "verseOrgIds": [
                  "EXO.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'addamu Musa nti, \"Kaakano ojja kulaba kye nnaakola Falaawo. Kubanga alibaleka ne bagenda olw'amaanyi, era olw'amaanyi alibagoba mu nsi ye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'agamba Musa nti, \"Nze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.2",
                "verseOrgIds": [
                  "EXO.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.2",
            "verseOrgIds": [
              "EXO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalabikira Ibulayimu, ne Isaaka ne Yakobo nga Katonda Ayinzabyonna; kyokka saabategeeza linnya lyange nti Nze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.3",
                "verseOrgIds": [
                  "EXO.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.3",
            "verseOrgIds": [
              "EXO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nabasuubiza mu ndagaano yange okubawa ensi ya Kanani, gye baabeerangamu ng'abagwira abatambuze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.4",
            "verseOrgIds": [
              "EXO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano mpulidde okusinda kw'abaana ba Isirayiri abatuntuzibwa Abamisiri mu buddu, ne nzijukira endagaano yange.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.5",
            "verseOrgIds": [
              "EXO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Noolwekyo tegeeza abaana ba Isirayiri nti, 'Nze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.6",
                "verseOrgIds": [
                  "EXO.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ndibatikkulako emigugu gy'Abamisiri, era ndibawonya obuddu, ne mbanunula n'omukono gwange ogw'amaanyi nga nsalira Abamisiri omusango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.6",
            "verseOrgIds": [
              "EXO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibafuula abantu bange, era nnaabeeranga Katonda wammwe, era mulitegeera nga nze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.7",
                "verseOrgIds": [
                  "EXO.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe abawonyezza ebizibu by'Abamisiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.7",
            "verseOrgIds": [
              "EXO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibaleeta mu nsi gye nalayira okuwa Ibulayimu ne Isaaka ne Yakobo; ndigibawa n'efuuka yammwe. Nze",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.8",
                "verseOrgIds": [
                  "EXO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.8",
            "verseOrgIds": [
              "EXO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'ategeeza abaana ba Isirayiri ebigambo ebyo. Naye tebaamuwuliriza, kubanga emitima gyali gibennyise, nga n'okutuntuzibwa kubayitiridde.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.9",
            "verseOrgIds": [
              "EXO.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.10",
            "verseOrgIds": [
              "EXO.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.10",
                "verseOrgIds": [
                  "EXO.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.10",
            "verseOrgIds": [
              "EXO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Genda otegeeze Falaawo kabaka w'e Misiri aleke abaana ba Isirayiri bave mu nsi ye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.11",
            "verseOrgIds": [
              "EXO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa n'addamu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.12",
                "verseOrgIds": [
                  "EXO.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Laba, abaana ba Isirayiri bagaanyi okumpuliriza, kale Falaawo anampuliriza atya nze atayogera bulungi?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.12",
            "verseOrgIds": [
              "EXO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.13",
                "verseOrgIds": [
                  "EXO.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ayogera ne Musa ne Alooni, n'abalagira bategeeze abaana ba Isirayiri ne Falaawo nti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.13",
                "verseOrgIds": [
                  "EXO.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "abalagidde okuggya abaana ba Isirayiri mu nsi y'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.13",
            "verseOrgIds": [
              "EXO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuzaale bwa Musa ne Alooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ge mannya aga bajjajjaabwe ab'omu bika byabwe:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 6:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 6:14"
      },
      "items": [
        {
          "text": "Batabani ba Lewubeeni, mutabani wa Isirayiri omubereberye, be bano:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 6:14"
      },
      "items": [
        {
          "text": "Kanoki ne Palu, Kezulooni ne Kalumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Simyoni:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 6:15"
      },
      "items": [
        {
          "text": "Yamweri ne Yamini, ne Okadi, Yakini ne Zokali, Sawuli (omwana w'omukyala Omukanani).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:15"
      },
      "items": [
        {
          "text": "Abo be b'omu mu bika bya Simyoni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano ge mannya ga batabani ba Leevi ng'emirembe bwe giri:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 6:16"
      },
      "items": [
        {
          "text": "Gerusoni ne Kokasi ne Merali.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:16"
      },
      "items": [
        {
          "text": "Leevi yawangaala emyaka kikumi mu asatu mu musanvu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Gerusoni be bano mu bika byabwe:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
            "verseOrgIds": [
              "EXO.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "EXO 6:17"
      },
      "items": [
        {
          "text": "Libuni ne Simeeyi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano be batabani ba Kokasi:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
