              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be bo abaayogera ne Falaawo, kabaka w'e Misiri, ku by'okuggyayo abaana ba Isirayiri mu Misiri. Ye Musa oyo, ne Alooni oyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
