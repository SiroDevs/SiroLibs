              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitiibwa kyange bwe kinaaba kiyitawo, nnaakuteeka mu mpataanya mu lwazi, ne nkubikkako omukono gwange okutuusa lwe nnaamala okuyitawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
