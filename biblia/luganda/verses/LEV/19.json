      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obutukuvu n'Enneeyisa y'Omuntu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.1",
            "verseOrgIds": [
              "LEV.19.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.1",
                "verseOrgIds": [
                  "LEV.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'agamba Musa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.1",
            "verseOrgIds": [
              "LEV.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ategeeze ekibiina kyonna eky'abaana ba Isirayiri abagambe nti, \"Mubeerenga batukuvu, kubanga nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.2",
                "verseOrgIds": [
                  "LEV.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe ndi mutukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Buli omu mu mmwe assengamu nnyina ne kitaawe ekitiibwa; era mukuumenga Ssabbiiti zange. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.3",
                "verseOrgIds": [
                  "LEV.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Temulaganga mu bitali Katonda, era temwekoleranga bakatonda abaweese mu kyuma ekisaanuuse. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.4",
                "verseOrgIds": [
                  "LEV.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwe munaawangayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.5",
                "verseOrgIds": [
                  "LEV.19.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ekiweebwayo olw'emirembe, mukiwengayo mu butuufu kiryoke kikkirizibwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinaalibwanga ku lunaku olwo lwe kinaaweebwangayo oba enkeera; ekinaabanga kisigaddewo okutuusa ku lunaku olwokusatu kinaazikiribwanga mu muliro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.6",
            "verseOrgIds": [
              "LEV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa kiriibwa ku lunaku olwokusatu tekiibenga kirongoofu, era tekikkirizibwenga,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.7",
            "verseOrgIds": [
              "LEV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne buli anaakiryangako anaabanga azzizza omusango; kubanga anaabeeranga aweebudde ekintu kya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.8",
                "verseOrgIds": [
                  "LEV.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ekitukuvu; omuntu oyo anaagobwanga n'agaanibwa okukolagananga ne banne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'okungulanga ekyengera eky'omu ttaka lyo, tokunguliranga ddala ebibala byonna eby'omu nnimiro yo okutuuka ku nkomerero zaayo, oba okukuŋŋaanya obubala obutonotono obunaabanga bugudde wansi ng'okungula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.9",
            "verseOrgIds": [
              "LEV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennimiro yo ey'emizabbibu togimalirangamu ddala bibala byonna, n'ebyo ebibanga bigudde wansi tobikuŋŋaanyanga. Obirekeranga abaavu ne bannamawanga. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.10",
                "verseOrgIds": [
                  "LEV.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tobbanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:11"
      },
      "items": [
        {
          "text": "\"Tokumpanyanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:11"
      },
      "items": [
        {
          "text": "\"Temulimbagananga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tokozesanga linnya lyange ng'olayira ebitaliimu nsa, n'ovumisa erinnya lya Katonda wo. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.12",
                "verseOrgIds": [
                  "LEV.19.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muliraanwa wo tomujooganga so tomunyagangako bibye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:13"
      },
      "items": [
        {
          "text": "\"Tosulanga na mpeera ya mupakasi wo n'omala nayo ekiro kyonna okutuusa enkya nga tonnagimusasula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuggavu w'amatu tomukolimiranga, so n'omuzibe w'amaaso tomuteganga nkonge w'anaayita, naye otyanga Katonda wo. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.14",
                "verseOrgIds": [
                  "LEV.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tosalirizanga ng'olamula; tobanga na kyekubiira ku ludda lw'omwavu wadde okwekubiira ku ludda lw'ow'ekitiibwa, banno obasalirangawo mu bwenkanya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Togendanga ng'osaasaanya eŋŋambo mu banno.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:16"
      },
      "items": [
        {
          "text": "\"Tokolanga kintu kyonna ku munno ekiyinza okumuleetera okufiirwa obulamu bwe. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.16",
                "verseOrgIds": [
                  "LEV.19.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etteeka ku Kwagala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muganda wo tomukyawanga mu mutima gwo. Naye munno ng'asobezza, omunenyanga, si kulwa nga naawe ogwa mu kibi nga ye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Towalananga ggwanga oba okusiba ekiruyi ku mwoyo eri munno yenna ow'omu nsi yo, naye yagalanga muliraanwa wo nga bwe weeyagala wekka. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.18",
                "verseOrgIds": [
                  "LEV.19.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okwatanga amateeka gange.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\"Tokkirizanga nsolo za ngeri ndala kuzaazisa mu nsolo zo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\"Mu nnimiro yo tosimbangamu nsigo za ngeri bbiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\"Toyambalanga kyambalo eky'olugoye olw'ebiwero eby'engeri ebbiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja bw'aneebakanga n'omuddu omukazi n'amusobyako, naye ng'omukazi oyo tannaweebwa ddembe lye, kyokka ng'aliko omusajja amwogereza, wanaabangawo okuwozesebwa n'ebibonerezo, naye tebattibwenga, kubanga omukazi anaabanga tannaweebwa ddembe lye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.20",
            "verseOrgIds": [
              "LEV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omusajja anaaleetanga endiga ennume ku mulyango gwa Weema ey'Okukuŋŋaanirangamu, nga ky'ekiweebwayo kye eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.21",
                "verseOrgIds": [
                  "LEV.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "eky'omusango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona anaakozesanga endiga ennume ey'ekiweebwayo olw'omusango okutangiririra omusajja oyo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.22",
                "verseOrgIds": [
                  "LEV.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": "; era ekibi kye ky'anaabanga akoze kinaamusonyiyibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwe muyingiranga mu nsi ne musimba emiti egya buli ngeri egy'ebibala ebyokulya, mukitegeere nti ebibala byagyo biriba ng'ebiwereddwa. Biriwerebwa okumala emyaka esatu; tebijjanga kuliibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.23",
            "verseOrgIds": [
              "LEV.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogwokuna ebibala byako byonna binaabanga bitukuvu, nga kye kiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.24",
                "verseOrgIds": [
                  "LEV.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": "eky'okumutendereza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mu mwaka ogwokutaano munaayinzanga okulya ku bibala byako. Mu ngeri eno ebibala byako bigenda kweyongeranga nnyo. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.25",
                "verseOrgIds": [
                  "LEV.19.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tolyanga nnyama yonna nga teweddeemu musaayi;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:26"
      },
      "items": [
        {
          "text": "\"so tokolanga bya ddogo wadde eby'okulagula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enviiri ez'oku mabbali g'omutwe gwo tozisalangako; n'ekirevu kyo tokikomolanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.27",
            "verseOrgIds": [
              "LEV.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Toweesalanga misale ku mubiri gwo olw'okujjukira abaafa oba okwesalako enjola. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.28",
                "verseOrgIds": [
                  "LEV.19.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tofuulanga mwana wo omuwala ekivume ng'omufudde omwenzi, kubanga kirireetera abantu mu nsi yo okufuuka abenzi, n'ensi n'ejjula okwonoona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mukuumanga Ssabbiiti zange era mussangamu ekitiibwa ekifo kyange ekitukuvu. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.30",
                "verseOrgIds": [
                  "LEV.19.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Temwebuuzanga ku basamize oba okukyukiranga abalogo, kubanga bagenda kubaleetera okwonooneka. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.31",
                "verseOrgIds": [
                  "LEV.19.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ositukiranga ow'envi, n'omukadde omussangamu ekitiibwa, era ne Katonda wo omutyanga. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.32",
                "verseOrgIds": [
                  "LEV.19.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omugwira bw'abeeranga omutuuze mu nsi yammwe, temumuyisanga bubi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
              "LEV.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugwira atuula mu mmwe mumuyisenga ng'omuzaaliranwa ow'omu nsi yammwe. Mumwagalenga nga bwe mweyagala, kubanga nammwe mwali bagwira mu nsi y'e Misiri. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.34",
                "verseOrgIds": [
                  "LEV.19.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Temubangamu kyekubiira nga mupima obuwanvu, oba obuzito, oba obungi bw'ebintu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubanga ne minzaani entuufu, n'amayinja agapima obuzito amatuufu, n'ekipima ebikalu (efa) ekituufu, n'ekipima ebiyiikayiika ng'amazzi (ini) ekituufu. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.36",
                "verseOrgIds": [
                  "LEV.19.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, eyabaggya mu nsi y'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munaakwatanga amateeka gange gonna, n'ebiragiro byange byonna, okubitambulirangako. Nze",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.37",
                "verseOrgIds": [
                  "LEV.19.37"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        }
      ]
    }
  ],
