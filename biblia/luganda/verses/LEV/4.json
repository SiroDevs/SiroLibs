                "verseOrgIds": [
                  "LEV.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ebyokeddwa mu muliro. Bw'atyo kabona anaatangiririranga omuntu oyo olw'ekibi kye, era omuntu oyo anaasonyiyibwanga.",
          "type": "text",
          "attrs": {
