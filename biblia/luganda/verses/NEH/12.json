      "items": [
        {
          "text": "ne Eriyasibu nga ye kitaawe wa Yoyaada,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
