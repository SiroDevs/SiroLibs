              "NEH.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya Kirukiya, yali Kasabiya;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:21"
      },
      "items": [
        {
          "text": "n'eya Yedaya, yali Nesaneeri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulu b'ennyumba z'Abaleevi abaakola mu biro bya Eriyasibu, ne Yoyada, ne Yokanaani ne Yadduwa, awamu ne bakabona, baawandiikibwa mu mirembe gya Daliyo Omuperusi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulu b'enju abaava mu bazzukulu ba Leevi okutuuka ku mulembe gwa Yokanaani mutabani wa Eriyasibu, ne bawandiikibwa mu bitabo eby'ebyafaayo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze b'Abaleevi baali: Kasabiya, ne Serebiya, ne Yesuwa mutabani wa Kadumyeri, n'abaabayambangako nga baboolekedde, nga batendereza era nga beebaza, ng'ekibinja ekimu kiddamu ekirala kye biyimba, nga Dawudi omusajja wa Katonda bwe yalagira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mattaniya, ne Bakubukiya, ne Obadiya, ne Mesullamu, ne Talumoni, ne Akkubu be baakuumanga amawanika g'oku miryango.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaweerereza mu biro bya Yoyakimu mutabani wa Yesuwa, mutabani wa Yozadaki, ne mu biro bya Nekkemiya owessaza, ne Ezera kabona era omuwandiisi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okutukuza Bbugwe wa Yerusaalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo okutukuza kwa bbugwe wa Yerusaalemi bwe kwatuuka, ne banoonya Abaleevi okuva gye baabeeranga, ne baleetebwa e Yerusaalemi okujaguza nga bwe bayimba n'okukuba ebitaasa n'entongooli n'ennanga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayimbi nabo ne bajja okuva mu bitundu ebyetoolodde Yerusaalemi, nga bava mu byalo by'Abanetofa,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'okuva mu Besugirugaali, n'okuva mu bitundu by'e Geba n'e Azumavesi; abayimbi baali beefunidde ebyalo okwetooloola Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona n'Abaleevi bwe baamala okwetukuza olw'emikolo egyo, ne balyoka batukuza abantu, n'emiryango ne bbugwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndyoka ntwala abakulembeze ba Yuda waggulu ku bbugwe, ne ndagira n'ebibinja bibiri eby'abayimbi okwebaza. Ekimu kyalaga waggulu wa bbugwe ku mukono ogwa ddyo, n'ekirala ne kiraga ku Mulyango gw'Obusa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosaaya ne kimu kyakubiri eky'abakulembeze ba Yuda ne babagoberera,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga bali wamu ne Azaliya, ne Ezera, ne Mesullamu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Yuda, ne Benyamini, ne Semaaya, ne Yeremiya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakabona abamu nga bakutte amakondeere, ne Zekkaliya mutabani wa Yonasaani, muzzukulu wa Semaaya, muzzukulu wa Mikaaya, muzzukulu wa Zakkuli, muzzukulu wa Asafu;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne banne abaamuyambangako nga be bano: Semaaya, ne Azuleeri, ne Miralayi, ne Giralayi, ne Maayi, ne Nesaneeri, ne Yuda, ne Kanani, nga balina ebivuga ebyalagirwa Dawudi omusajja wa Katonda, era Ezera omuwandiisi, ye yabakulemberangamu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka ku Mulyango gw'Oluzzi, ne bambuka amadaala g'Ekibuga kya Dawudi okutuukira ddala ku bbugwe; ne bayita ku lubiri lwa Dawudi ne batuuka ku Mulyango ogw'Amazzi, oguli ku luuyi olw'ebuvanjuba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibinja ekyokubiri eky'abayimbi, ne kiraga ku luuyi olwolekedde luli bali gye baali balaze. Nze ne kimu kyakubiri eky'abantu ne tubagoberera okutuukira ddala waggulu ku bbugwe, ne tuyita ku Munaala gw'Ebikoomi ne tutuuka ku Bbugwe Omugazi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne ku Mulyango gwa Efulayimu, ne ku Mulyango gwa Yesana, ne ku Mulyango gw'Ebyennyanja, n'okutuuka ku Munaala gwa Kananeri, ne ku Munaala gw'Ekikumi, n'okutuukira ddala ku Mulyango gw'Endiga, ne tuyimirira ku Mulyango gw'Abambowa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibinja byombi eby'abayimbi ne batuula mu bifo byabwe mu nnyumba ya Katonda; nange ne kimu kyakubiri eky'abakulembeze ne tutuula,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "awamu ne bakabona bano: Eriyakimu, ne Maaseya, ne Miniyamini, ne Mikaaya, ne Eriwenayi, ne Zekkaliya, ne Kananiya nga balina amakondeere;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaseya, ne Semaaya, ne Eriyazaali, ne Uzzi, ne Yekokanani, ne Malukiya, ne Eramu, ne Ezera nabo baaliwo. Abayimbi ne bayimba, Yekulakiya nga ye mukulu waabwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo, ne bawaayo ssaddaaka nnyingi nnyo nnyini, nga batendereza kubanga Katonda yali abawadde essanyu lingi nnyo nnyini. Abakazi n'abaana nabo ne basanyukira wamu nabo, era okujaguza okwo mu Yerusaalemi ne kuwulirwa mu bifo eby'ewala.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo, abantu ne balondebwa okulabiriranga amawanika omwaterekebwanga ebyaleetebwanga, nga mwe muli ebibala ebibereberye, ne kimu kya kkumi, nga bireetebwa okuva mu bibanja ebyetoolodde ebibuga, nga bwe kyalagibwa mu Mateeka, ne biweebwa bakabona n'Abaleevi. Yuda baali basanyufu olw'obuweereza bwa bakabona awamu n'obw'Abaleevi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona n'Abaleevi ne bakwata embaga ya Katonda waabwe era ne bagitukuza, n'abayimbi awamu n'abakuumi ba wankaaki nabo ne bakola bwe batyo, ng'ekiragiro kya Dawudi ne Sulemaani mutabani we bwe kyali.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro eby'edda, mu biseera bya Dawudi ne Asafu, waabangawo abakulu b'abayimbi, ate nga waliwo n'ennyimba ezaayimbibwanga okutendereza Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mu biro bya Zerubbaberi ne mu biro bya Nekkemiya, Isirayiri kyeyava ewaayo ebibinja by'abayimbi n'abakuumi ba wankaaki. Ne balonda n'ekibinja ky'Abaleevi abalala, n'Abaleevi nabo ne balondayo ekibinja ekyava mu bazzukulu ba Alooni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
    }
  ],
