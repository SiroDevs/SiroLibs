  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "GEN 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katonda Agezesa Ibulayimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo oluvannyuma lw'ebyo, Katonda n'agezesa Ibulayimu, n'amuyita nti, \"Ibulayimu!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:1"
      },
      "items": [
        {
          "text": "N'addamu nti, \"Nze nzuuno.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.1",
            "verseOrgIds": [
              "GEN.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'amugamba nti, \"Twala mutabani wo, mutabani wo omu yekka, Isaaka, gw'oyagala, ogende mu nsi Moliya ku lumu ku nsozi lwe ndikulaga omuweereyo eyo okuba ekiweebwayo ekyokebwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.2",
            "verseOrgIds": [
              "GEN.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'agolokoka ku makya n'ateeka amatandiiko ku ndogoyi ye, n'atwala babiri ku baweereza be abasajja ne Isaaka mutabani we, n'ayasa enku ez'ekiweebwayo ekyokebwa, n'asituka n'agenda mu kifo Katonda kye yamugamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.3",
            "verseOrgIds": [
              "GEN.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwokusatu Ibulayimu n'ayimusa amaaso ge n'alengera ekifo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.4",
            "verseOrgIds": [
              "GEN.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulayimu n'agamba balenzi be nti, \"Musigale wano n'endogoyi, nze n'omulenzi tugende eri tusinze, tulyoke tukomewo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.5",
            "verseOrgIds": [
              "GEN.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'addira enku ez'ekiweebwayo ekyokebwa n'azitikka Isaaka mutabani we, ye n'akwata omuliro n'akambe, ne bagenda bombi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.6",
            "verseOrgIds": [
              "GEN.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaka n'agamba Ibulayimu nti, \"Taata.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:7"
      },
      "items": [
        {
          "text": "Ibulayimu n'amuddamu nti, \"Nzuuno mwana wange.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:7"
      },
      "items": [
        {
          "text": "Isaaka n'amubuuza nti, \"Laba, omuliro n'enku biibino, naye omwana gw'endiga ogw'ekiweebwayo ekyokebwa guluwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.7",
            "verseOrgIds": [
              "GEN.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'amuddamu nti, \"Mwana wange, Katonda aneefunira omwana gw'endiga ogw'ekiweebwayo ekyokebwa.\" Kale ne bagenda bombi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.8",
            "verseOrgIds": [
              "GEN.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibulayimu Awaayo Isaaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka mu kifo Katonda kye yamugamba, Ibulayimu n'azimba ekyoto, n'atindikira enku, n'asiba omwana we Isaaka, n'amuteeka ku kyoto ku nku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.9",
            "verseOrgIds": [
              "GEN.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulayimu n'akwata ekiso, n'agolola omukono gwe atte omwana we.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.10",
            "verseOrgIds": [
              "GEN.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.11",
                "verseOrgIds": [
                  "GEN.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amukoowoola ng'asinziira mu ggulu, n'agamba nti, \"Ibulayimu! Ibulayimu!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 22:11"
      },
      "items": [
        {
          "text": "Ibulayimu n'addamu nti, \"Nze nzuuno.\" N'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.11",
            "verseOrgIds": [
              "GEN.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Togolola mukono gwo ku mulenzi so tomukola kintu na kimu, kubanga kaakano ntegedde nti otya Katonda, ndabye nti omwana wo tomunnyimye, omwana wo omu yekka bw'ati.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.12",
            "verseOrgIds": [
              "GEN.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ibulayimu n'ayimusa amaaso, n'alaba, era laba, emabega we endiga ennume ng'eri mu kisaka ng'amayembe gaayo mwe galaalidde. Ibulayimu n'agenda n'addira endiga eyo n'agiwaayo okuba ekiweebwayo ekyokebwa, mu kifo ky'omwana we.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.13",
            "verseOrgIds": [
              "GEN.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu kyeyava atuuma ekifo ekyo erinnya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.14",
                "verseOrgIds": [
                  "GEN.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "alitugabirira",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "text": ", era ne kaakano bwe kiyitibwa nti ku lusozi lwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.14",
                "verseOrgIds": [
                  "GEN.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "anaagabiriranga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.14",
            "verseOrgIds": [
              "GEN.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.15",
                "verseOrgIds": [
                  "GEN.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ayita Ibulayimu omulundi ogwokubiri ng'asinziira mu ggulu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.15",
            "verseOrgIds": [
              "GEN.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'amugamba nti, \"Nze",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.22.16",
                "verseOrgIds": [
                  "GEN.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "neerayiridde, nga bw'okoze kino, n'otonnyima mwana wo omu yekka bw'ati,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
              "GEN.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ddala ndikuwa omukisa, era ndyaza ezzadde lyo, ne liba ng'emmunyeenye ez'eggulu era ng'omusenyu oguli ku lubalama lw'ennyanja. Era ezzadde lyo balitwala eby'abalabe baabwe,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.17",
            "verseOrgIds": [
              "GEN.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "era mu zzadde lyo amawanga gonna mwe galiweerwa omukisa, kubanga ogondedde eddoboozi lyange.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.18",
            "verseOrgIds": [
              "GEN.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulayimu n'alyoka addayo eri abavubuka be, ne basitula ne balaga e Beeruseba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.19",
            "verseOrgIds": [
              "GEN.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu biro ebyo ne babuulira Ibulayimu nti, \"Laba Mirika azaalidde Nakoli muganda wo abaana: Uzi ye mubereberye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.20",
            "verseOrgIds": [
              "GEN.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne muto we ye Buzi, ne Kemweri kitaawe wa Alamu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Kesedi, ne Kazo, ne Pirudaasi, ne Yidulaafu ne Besweri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Besweri yazaala Lebbeeka.",
          "type": "text"
        }
      ]
    },
    {
