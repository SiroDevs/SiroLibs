          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lwe baasitulanga okutambula nga bava mu lusiisira, ekire kya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.34",
                "verseOrgIds": [
                  "NUM.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kyabeeranga waggulu waabwe buli budde bwa misana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        }
      ]
