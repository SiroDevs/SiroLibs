          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne basitula okuva ku lusozi lwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.33",
                "verseOrgIds": [
                  "NUM.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne batambulira ennaku ssatu. Essanduuko ya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.10.33",
                "verseOrgIds": [
                  "NUM.10.33"
                ]
              }
            }
          ]
        },
        {
          "text": "ey'Endagaano n'ebakulemberanga okumala ennaku ezo essatu ng'ebanoonyeza ekifo eky'okuwummuliramu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
