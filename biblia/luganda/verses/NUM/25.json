  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "NUM 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isirayiri Asinza Bakatonda Abalala mu Sitimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayiri bwe yali mu Sitimu, abasajja ne batandika okwenda n'abakazi ba Mowaabu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.1",
            "verseOrgIds": [
              "NUM.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaabayitanga ku kuwaayo ebiweebwayo eri bakatonda baabwe. Abaana ba Isirayiri ne balya era ne bavuunamira bakatonda abo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.2",
            "verseOrgIds": [
              "NUM.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Isirayiri n'ayingirira eby'okusinzanga Baali ow'e Peoli. Obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.3",
                "verseOrgIds": [
                  "NUM.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ne bubabuubuukirako.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.3",
            "verseOrgIds": [
              "NUM.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.4",
                "verseOrgIds": [
                  "NUM.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti, \"Kwata abakulembeze b'abantu bano obatte, obaanike mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.4",
                "verseOrgIds": [
                  "NUM.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "abantu bonna we babalabira, obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.4",
                "verseOrgIds": [
                  "NUM.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bulyoke bukkakkane buve ku Isirayiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'agamba abalamuzi ba Isirayiri nti, \"Buli omu ku mmwe atte abo abali mu mmwe abeegasse mu kusinza Baali ow'e Peoli.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.5",
            "verseOrgIds": [
              "NUM.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale, laba, omusajja omu ku baana ba Isirayiri n'aleeta mu maka ge omukazi Omumidiyaani awo mu maaso ga Musa, nga n'ekibiina kyonna ekya Isirayiri bali awo bakaabira mu mulyango gwa Weema ey'Okukuŋŋaanirangamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.6",
            "verseOrgIds": [
              "NUM.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Finekaasi mutabani wa Eriyazaali, mutabani wa Alooni kabona, bwe yakiraba, n'asituka mu kibiina n'akwata effumu mu mukono gwe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.7",
            "verseOrgIds": [
              "NUM.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'agoberera Omuyisirayiri n'amutuusa mu weema. Bombi n'abafumita effumu ne liyita mu Muyisirayiri ne liggukira ne mu mubiri gw'omukazi, ne libayitamu bombi. Awo kawumpuli eyali alumbye abaana ba Isirayiri n'akoma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.8",
            "verseOrgIds": [
              "NUM.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abo abaafa kawumpuli baawera emitwalo ebiri mu enkumi nnya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.10",
                "verseOrgIds": [
                  "NUM.25.10"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Finekaasi mutabani wa Eriyazaali, mutabani wa Alooni kabona, ankyusisizza obusungu bwange ne mbuggya ku baana ba Isirayiri; kubanga obusungu bwe bwabuubuuka nnyo ng'obwange olw'obutafaayo ku kitiibwa kyange, kyenvudde sibazikiriza kubamalawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mutegeeze nti, 'Laba nkola naye endagaano ey'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye, ne bazzukulu be bonna banaabanga mu ndagaano ey'obwakabona obw'emirembe gyonna, kubanga yasunguwalira abaana ba Isirayiri olw'okutyoboola ekitiibwa kya Katonda we, n'abatangiririra.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja Omuyisirayiri eyattirwa awamu n'omukazi Omumidiyaani yali Zimuli mutabani wa Salu eyali omukulembeze mu kika kya Simyoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'erinnya ly'omukazi Omumidiyaani eyattibwa nga ye Kozebi muwala wa Zuuli, eyali omukulembeze mu kimu ku bika bya Midiyaani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.25.16",
                "verseOrgIds": [
                  "NUM.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.16",
            "verseOrgIds": [
              "NUM.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abamidiyaani obayigganyanga n'obatta,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga baayagala okubazikiriza n'enkwe zaabwe bwe baabakyamya e Peoli, n'olwa Kozebi muwala w'omukulembeze w'e Midiyaani, omukazi oyo eyattibwa ku lunaku okwajjira kawumpuli olw'ebyo ebyali e Peoli.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.18",
            "verseOrgIds": [
              "NUM.25.18"
            ]
          }
        }
      ]
    }
  ],
