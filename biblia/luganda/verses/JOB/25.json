        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 25:5"
      },
      "items": [
        {
          "text": "n'emmunyeenye si nnongoofu mu maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.25.5",
            "verseOrgIds": [
              "JOB.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
