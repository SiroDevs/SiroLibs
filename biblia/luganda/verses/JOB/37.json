      "attrs": {
        "style": "q2",
        "vid": "JOB 37:21"
      },
      "items": [
        {
          "text": "olw'engeri gy'eyakamu ku ggulu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
            ]
          }
