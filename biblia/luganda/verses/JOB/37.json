      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:20"
      },
      "items": [
        {
          "text": "Eriyo omuntu yenna ayinza okusaba okumalibwawo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
            ]
          }
        }
