  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOB 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erifaazi Ayogera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Erifaazi Omutemani n'ayanukula ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.1",
            "verseOrgIds": [
              "JOB.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuntu bw'anaayogera naawe onoonyiiga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:2"
      },
      "items": [
        {
          "text": "Naye ani ayinza okusirika obusirisi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.2",
            "verseOrgIds": [
              "JOB.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, wayigiriza bangi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:3"
      },
      "items": [
        {
          "text": "emikono eminafu wagizzaamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.3",
            "verseOrgIds": [
              "JOB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo byo byanyweza abaali bagwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:4"
      },
      "items": [
        {
          "text": "era ng'ozzaamu amaanyi amaviivi agaali gakankana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.4",
            "verseOrgIds": [
              "JOB.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kaakano kikutuuseeko, oweddemu amaanyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:5"
      },
      "items": [
        {
          "text": "kikutte ku ggwe n'oggwaawo!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.5",
            "verseOrgIds": [
              "JOB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okutya Katonda wo si bwe bwesige bwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:6"
      },
      "items": [
        {
          "text": "n'obwesimbu bwo si ly'essuubi lyo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.6",
            "verseOrgIds": [
              "JOB.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kaakano lowooza; ani ataliiko musango eyali azikiridde?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:7"
      },
      "items": [
        {
          "text": "Oba wa abatuukirivu gye baali bamaliddwawo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.7",
            "verseOrgIds": [
              "JOB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okusinziira ku kyendabye; abo abateekateeka okukola ebibi era ne basiga ebitali bya butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:8"
      },
      "items": [
        {
          "text": "bakungula bizibu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.8",
            "verseOrgIds": [
              "JOB.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazikirizibwa omukka Katonda gw'assa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:9"
      },
      "items": [
        {
          "text": "bamalibwawo obusungu bwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.9",
            "verseOrgIds": [
              "JOB.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuwuluguma kw'empologoma, n'eddoboozi ly'empologoma enkambwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:10"
      },
      "items": [
        {
          "text": "n'amannyo g'empologoma ento gamenyeka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.10",
            "verseOrgIds": [
              "JOB.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Empologoma ey'amaanyi ezikirira olw'okubulwa omuyiggo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:11"
      },
      "items": [
        {
          "text": "n'obwana bw'empologoma busaasaana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.11",
            "verseOrgIds": [
              "JOB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nategeezebwa ekigambo eky'ekyama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:12"
      },
      "items": [
        {
          "text": "ne nkitegera okutu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.12",
            "verseOrgIds": [
              "JOB.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati mu birowoozo n'okwolesebwa kw'ekiro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:13"
      },
      "items": [
        {
          "text": "ng'otulo otungi tukutte omuntu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.13",
            "verseOrgIds": [
              "JOB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "okutya n'okukankana byankwata ne bireetera amagumba gange okunyegenya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.14",
            "verseOrgIds": [
              "JOB.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyo gw'ayita mu maaso gange,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:15"
      },
      "items": [
        {
          "text": "obwoya bw'oku mubiri gwange ne buyimirira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.15",
            "verseOrgIds": [
              "JOB.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buyimirira butengerera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "naye saasobola kwetegereza ndabika yaabwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "n'ekifaananyi kyali mu maaso gange, ne wabaawo akasiriikiriro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:16"
      },
      "items": [
        {
          "text": "ne ndyoka mpulira eddoboozi nga ligamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.16",
            "verseOrgIds": [
              "JOB.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Omuntu afa ayinza okuba omutuukirivu okusinga Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:17"
      },
      "items": [
        {
          "text": "Omuntu ayinza okuba omulongoofu okusinga Omutonzi we?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.17",
            "verseOrgIds": [
              "JOB.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obanga abaddu be tabeesiga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.18",
            "verseOrgIds": [
              "JOB.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 4:18"
      },
      "items": [
        {
          "text": "nga bamalayika be abalanga ensobi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.18",
            "verseOrgIds": [
              "JOB.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
