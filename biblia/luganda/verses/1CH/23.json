            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu batabani ba Kebbulooni,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
            "verseOrgIds": [
              "1CH.23.19"
            ]
          }
        }
