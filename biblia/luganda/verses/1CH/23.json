      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:19"
      },
      "items": [
        {
          "text": "Yeriya omukulu, Amaliya nga wakubiri, Yakaziyeri nga wakusatu, ne Yekameyamu nga ye wookuna.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.19",
