      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:3"
      },
      "items": [
        {
          "text": "n'obutuukirivu bwe tebuggwaawo emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
