  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "PSA 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi Dowegi Omwedomu bwe yagenda n'abuulira Sawulo nti, \"Dawudi alaze mu nnyumba ya Akimereki.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki weenyumiririza mu kibi ggwe omusajja ow'amaanyi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:1"
      },
      "items": [
        {
          "text": "Endagaano ya Katonda ey'obwesigwa ebeerera emirembe n'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.1",
            "verseOrgIds": [
              "PSA.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oteekateeka enkwe ez'okuzikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:2"
      },
      "items": [
        {
          "text": "Olulimi lwo lwogi nga kkirita",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:2"
      },
      "items": [
        {
          "text": "era buli kiseera lwogera bya bulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.2",
            "verseOrgIds": [
              "PSA.52.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyagala okukola ebibi okusinga okukola ebirungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:3"
      },
      "items": [
        {
          "text": "n'okulimba okusinga okwogera amazima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.3",
            "verseOrgIds": [
              "PSA.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osanyukira nnyo okwogera ebirumya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:4"
      },
      "items": [
        {
          "text": "Ggwe olulimi kalimbira!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.4",
            "verseOrgIds": [
              "PSA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka Katonda alikuzikiriza emirembe gyonna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "alikusikula, akuggye mu maka go;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:5"
      },
      "items": [
        {
          "text": "alikugoba mu nsi y'abalamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.5",
            "verseOrgIds": [
              "PSA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino abatuukirivu balibiraba, ne babitunuulira nga batidde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:6"
      },
      "items": [
        {
          "text": "Naye balikusekerera, nga bwe bagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.6",
            "verseOrgIds": [
              "PSA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mumulabe omusajja",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "ateesiga Katonda okuba ekiddukiro kye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "naye ne yeesiganga obugagga bwe obungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:7"
      },
      "items": [
        {
          "text": "ne yeeyongera n'amaanyi ng'azikiriza abalala.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.7",
            "verseOrgIds": [
              "PSA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nze nfaanana ng'omuti omuzeyituuni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "ogukulira mu nnyumba ya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "Neesiga okwagala kwa Katonda okutaggwaawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:8"
      },
      "items": [
        {
          "text": "emirembe n'emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.8",
            "verseOrgIds": [
              "PSA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaakwebazanga emirembe gyonna olw'ekyo ky'okoze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "Nneesiganga erinnya lyo kubanga erinnya lyo ddungi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 52:9"
      },
      "items": [
        {
          "text": "era nnaakutendererezanga awali abatuukirivu bo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.52.9",
            "verseOrgIds": [
              "PSA.52.11"
            ]
          }
        }
      ]
    }
  ],
