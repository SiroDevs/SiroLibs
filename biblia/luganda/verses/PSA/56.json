      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.56.10",
                "verseOrgIds": [
                  "PSA.56.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gwe ntendereza olw'ekisuubizo kye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda oyo gwe neesiga, siityenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:11"
      },
      "items": [
        {
          "text": "Abantu bayinza kunkolako ki?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndituukiriza obweyamo bwange gy'oli, Ayi Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:12"
      },
      "items": [
        {
          "text": "ndikuleetera ebirabo eby'okukwebaza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 56:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga emmeeme yange ogiwonyezza okufa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "Ebigere byange tobiwonyezza okwesittala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "ne ndyoka ntambulira mu maaso ga Katonda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "mu musana nga ndi mulamu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    }
