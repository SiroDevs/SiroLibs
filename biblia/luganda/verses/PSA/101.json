            "sid": "PSA 101:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo alyolyoma muliraanwa we mu kyama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "nnaamuzikiririzanga ddala; amaaso ag'amalala n'omutima ogw'amalala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:5"
      },
      "items": [
        {
          "text": "sijja kubigumiikirizanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.5",
            "verseOrgIds": [
              "PSA.101.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
