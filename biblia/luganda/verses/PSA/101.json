      "attrs": {
        "style": "q2",
        "vid": "PSA 101:8"
      },
      "items": [
        {
          "text": "abakola ebibi bonna mu nsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.8",
            "verseOrgIds": [
              "PSA.101.8"
            ]
