      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:7"
      },
      "items": [
        {
          "text": "taabeerenga mu nnyumba yange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.7",
            "verseOrgIds": [
              "PSA.101.7"
            ]
          }
        }
      ]
