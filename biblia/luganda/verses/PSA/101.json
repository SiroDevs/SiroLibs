      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 101:6"
      },
      "items": [
        {
          "text": "y'anamperezanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.101.6",
            "verseOrgIds": [
              "PSA.101.6"
            ]
          }
        }
