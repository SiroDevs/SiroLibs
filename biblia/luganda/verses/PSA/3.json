      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:5"
      },
      "items": [
        {
          "text": "kubanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.5",
                "verseOrgIds": [
                  "PSA.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ye ampanirira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
