      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "okube abalabe bange bonna",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
