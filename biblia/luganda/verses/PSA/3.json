    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "ondokole Ayi Katonda wange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
