  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "PSA 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Oluyimba \"olw'Amalanga.\" Zabbuli ya Batabani ba Koola.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwange gujjudde ebigambo ebirungi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "nga nnyimba oluyimba lwa Kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:1"
      },
      "items": [
        {
          "text": "Olulimi lwange kkalaamu y'omuwandiisi omukugu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.1",
            "verseOrgIds": [
              "PSA.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggw'osinga abaana b'abantu obulungi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "n'akamwa ko nga kafukiddwako amafuta ag'ekisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:2"
      },
      "items": [
        {
          "text": "Kubanga Katonda akuwadde omukisa emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.2",
            "verseOrgIds": [
              "PSA.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weesibe ekitala kyo, Ayi ggwe ow'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:3"
      },
      "items": [
        {
          "text": "yambala ekitiibwa kyo n'obukulu bwo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.3",
            "verseOrgIds": [
              "PSA.45.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weebagale embalaasi yo mu kitiibwa kyo eky'obuwanguzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "ng'olwanirira amazima, obuwombeefu, n'obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:4"
      },
      "items": [
        {
          "text": "Omukono gwo ogwa ddyo gukole ebyewuunyisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.4",
            "verseOrgIds": [
              "PSA.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusaale bwo obwogi bufumite emitima gy'abalabe ba kabaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:5"
      },
      "items": [
        {
          "text": "afuge amawanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.5",
            "verseOrgIds": [
              "PSA.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entebe yo ey'obwakabaka, Ayi Katonda, ya lubeerera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:6"
      },
      "items": [
        {
          "text": "n'omuggo ogw'obwenkanya gwe guliba ogw'obwakabaka bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.6",
            "verseOrgIds": [
              "PSA.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyagala obutuukirivu n'okyawa okukola ebibi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "noolwekyo Katonda, Katonda wo, kyavudde akugulumiza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:7"
      },
      "items": [
        {
          "text": "n'akufukako amafuta ag'essanyu okusinga bakabaka banno bonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.7",
            "verseOrgIds": [
              "PSA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyambalo byo birina akawoowo ka mmooli ne alowe, ne kasiya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "Ebivuga eby'enkoba bikusanyusiza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:8"
      },
      "items": [
        {
          "text": "mu mbiri zo ez'amasanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.8",
            "verseOrgIds": [
              "PSA.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bakyala bo mulimu abambejja;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:9"
      },
      "items": [
        {
          "text": "namasole ali ku mukono gwo ogwa ddyo ng'ayambadde ebya zaabu ya Ofiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.9",
            "verseOrgIds": [
              "PSA.45.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwala, wuliriza bye nkugamba:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:10"
      },
      "items": [
        {
          "text": "\"Weerabire ab'ewammwe n'ab'omu nnyumba ya kitaawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.10",
            "verseOrgIds": [
              "PSA.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka akulowoozaako nnyo, kubanga walungiwa n'oyitirira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:11"
      },
      "items": [
        {
          "text": "nga bw'ali mukama wo, muwenga ekitiibwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.11",
            "verseOrgIds": [
              "PSA.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwala w'e Ttuulo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        },
        {
          "text": "alijja n'ekirabo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:12"
      },
      "items": [
        {
          "text": "abasajja abagagga balikwegayirira obalage ekisa kyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.12",
            "verseOrgIds": [
              "PSA.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuwala wa kabaka ajjudde ekitiibwa mu kisenge kye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:13"
      },
      "items": [
        {
          "text": "ng'ayambadde ekyambalo ekyalukibwa ne zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.13",
            "verseOrgIds": [
              "PSA.45.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aleetebwa mu maaso ga kabaka ng'ayambadde ebyambalo eby'emidalizo emingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "Emperekeze ze zimuwerekerako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:14"
      },
      "items": [
        {
          "text": "bonna ne bajja gy'oli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.14",
            "verseOrgIds": [
              "PSA.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleetebwa nga bajjudde essanyu n'okweyagala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.15",
            "verseOrgIds": [
              "PSA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 45:15"
      },
      "items": [
        {
          "text": "ne bayingira mu lubiri lwa kabaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.45.15",
            "verseOrgIds": [
              "PSA.45.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
