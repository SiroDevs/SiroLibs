      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:1"
      },
      "items": [
        {
          "text": "ngobaako bonna abangigganya era omponye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
