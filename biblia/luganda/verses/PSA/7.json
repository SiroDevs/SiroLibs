            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.7.1",
                "verseOrgIds": [
                  "PSA.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda wange, neesiga ggwe:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.1",
            "verseOrgIds": [
              "PSA.7.2"
