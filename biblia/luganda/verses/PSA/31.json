    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.1",
                "verseOrgIds": [
                  "PSA.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ggwe kiddukiro kyange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:1"
      },
      "items": [
        {
          "text": "leka nneme kuswazibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:1"
      },
      "items": [
        {
          "text": "Ndokola mu butuukirivu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.1",
            "verseOrgIds": [
              "PSA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ontegere okutu kwo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "oyanguwe okunziruukirira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "Beera ekiddukiro kyange eky'olwazi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:2"
      },
      "items": [
        {
          "text": "era ekigo eky'amaanyi eky'okumponya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.2",
            "verseOrgIds": [
              "PSA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bw'oli olwazi lwange era ekigo kyange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:3"
      },
      "items": [
        {
          "text": "olw'erinnya lyo onkulembebere era onnuŋŋamye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.3",
            "verseOrgIds": [
              "PSA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omponye mu mutego gwe banteze;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:4"
      },
      "items": [
        {
          "text": "kubanga ggwe kiddukiro kyange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.4",
            "verseOrgIds": [
              "PSA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nteeka omwoyo gwange mu mikono gyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:5"
      },
      "items": [
        {
          "text": "ondokole, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.5",
                "verseOrgIds": [
                  "PSA.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Katonda ow'amazima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.5",
            "verseOrgIds": [
              "PSA.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkyawa abo abeesiga bakatonda abalala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:6"
      },
      "items": [
        {
          "text": "nze nneesiga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.6",
                "verseOrgIds": [
                  "PSA.31.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.6",
            "verseOrgIds": [
              "PSA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnaajaguzanga ne nsanyukira mu kwagala kwo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "kubanga olabye okubonaabona kwange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:7"
      },
      "items": [
        {
          "text": "era omanyi ennaku endi ku mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.7",
            "verseOrgIds": [
              "PSA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tompaddeeyo mu balabe bange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:8"
      },
      "items": [
        {
          "text": "naye otadde ebigere byange mu kifo ekigazi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.8",
            "verseOrgIds": [
              "PSA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onsaasire, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.31.9",
                "verseOrgIds": [
                  "PSA.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", kubanga ndi mu nnaku nnyingi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "amaaso gange gakooye olw'ennaku;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:9"
      },
      "items": [
        {
          "text": "omwoyo gwange n'omubiri gwange nabyo binafuye olw'obuyinike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.9",
            "verseOrgIds": [
              "PSA.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obulamu bwange buweddewo olw'obunaku n'emyaka gyange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "ne giggwaawo olw'okusinda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "Amaanyi gampweddemu olw'okwonoona kwange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:10"
      },
      "items": [
        {
          "text": "n'amagumba ganafuye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.10",
            "verseOrgIds": [
              "PSA.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalabe bange bonna bansekerera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "banneetamiddwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "Nfuuse ekyenyinyalwa mu mikwano gyange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:11"
      },
      "items": [
        {
          "text": "n'abandaba mu kkubo banziruka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.11",
            "verseOrgIds": [
              "PSA.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nneerabiddwa ng'eyafa edda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:12"
      },
      "items": [
        {
          "text": "nfuuse ng'ekibumbe ekyatifu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.12",
            "verseOrgIds": [
              "PSA.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli ludda mpulirayo obwama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.13",
            "verseOrgIds": [
              "PSA.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:13"
      },
