      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
