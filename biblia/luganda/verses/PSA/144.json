      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "amponya, nze omuddu wo Dawudi, ekitala ekyogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 144:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokola, omponye onzigye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "mu mukono gwa bannamawanga bano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "ab'emimwa egyogera eby'obulimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "era omukono gwabwe ogwa ddyo gwa bulimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 144:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani baffe mu buvubuka bwabwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.12",
                "verseOrgIds": [
                  "PSA.144.12"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "babeere ng'ebisimbe ebikulidde ddala obulungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "ne bawala baffe babe ng'empagi ennungi ez'oku nsonda",
