                "verseId": "PSA.128.5",
                "verseOrgIds": [
                  "PSA.128.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akuwenga omukisa ng'asinziira mu Sayuuni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "era olabe Yerusaalemi nga kijjudde ebirungi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "ennaku zonna ez'obulamu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
