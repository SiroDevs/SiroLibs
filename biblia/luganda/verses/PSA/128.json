      "attrs": {
        "style": "q1",
        "vid": "PSA 128:6"
      },
      "items": [
        {
          "text": "Emirembe gibeere mu Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
