  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "60",
        "style": "c",
        "sid": "PSA 60"
      },
      "items": [
        {
          "text": "60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zabbuli 60",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Ku ddoboozi, \"Eddanga ery'Endagaano.\" Zabbuli ya Dawudi. Yakuyigiriza. Dawudi bwe yalwana n'Abaalamu abaava e Nakalayimu n'abaava e Zoba, Yowaabu n'akomawo n'atta Abayedomu omutwalo gumu mu enkumi bbiri mu Kiwonvu eky'Omunnyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otusudde, Ayi Katonda, otumazeemu amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:1"
      },
      "items": [
        {
          "text": "otunyiigidde. Tukwegayiridde otuzze gy'oli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.1",
            "verseOrgIds": [
              "PSA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi ogiyuuguumizza n'ogyasaayasa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:2"
      },
      "items": [
        {
          "text": "tukwegayirira enjatika ozizibe, kubanga ekankana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.2",
            "verseOrgIds": [
              "PSA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadde mukambwe nnyo eri abantu bo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:3"
      },
      "items": [
        {
          "text": "tuli nga b'owadde omwenge omungi ne gututagaza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.3",
            "verseOrgIds": [
              "PSA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abo abakutya obawanikidde ebbendera okuba akabonero akabakuŋŋaanya awamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:4"
      },
      "items": [
        {
          "text": "era akatiisa abalabe baabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.4",
            "verseOrgIds": [
              "PSA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otulokole era otuyambe n'omukono gwo ogwa ddyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:5"
      },
      "items": [
        {
          "text": "abakwagala baleme kutuukibwako kabi konna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.5",
            "verseOrgIds": [
              "PSA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda ayogedde ng'asinziira mu kifo kye ekitukuvu, n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "\"Mu buwanguzi, ndisala mu Sekemu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:6"
      },
      "items": [
        {
          "text": "era n'ekiwonvu kya Sukkosi ndikigabanyagabanyaamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.6",
            "verseOrgIds": [
              "PSA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi ya Gireyaadi yange, n'eya Manase nayo yange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "Efulayimu ye nkufiira ey'oku mutwe gwange;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:7"
      },
      "items": [
        {
          "text": "ate Yuda gwe muggo gwange ogw'okufuga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.7",
            "verseOrgIds": [
              "PSA.60.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 60:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mowaabu kye kinaabirwamu kyange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "ate Edomu gye nkasuka engatto yange:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:8"
      },
      "items": [
        {
          "text": "ne ku Bafirisuuti ndeekaana mu buwanguzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.8",
            "verseOrgIds": [
              "PSA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani anantuusa ku kibuga ekigumu ekinywevu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:9"
      },
      "items": [
        {
          "text": "Ani anankulembera okunnyingiza mu Edomu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.9",
            "verseOrgIds": [
              "PSA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 60:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si ggwe Ayi Katonda, atusudde,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:10"
      },
      "items": [
        {
          "text": "atakyatabaala na magye gaffe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.10",
            "verseOrgIds": [
              "PSA.60.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tudduukirire, nga tulwanyisa abalabe baffe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:11"
      },
      "items": [
        {
          "text": "kubanga obuyambi bw'abantu temuli nsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.11",
            "verseOrgIds": [
              "PSA.60.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 60:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe tunaabeeranga ne Katonda, tunaabanga bawanguzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 60:12"
      },
      "items": [
        {
          "text": "kubanga ye y'anaalinnyiriranga abalabe baffe wansi w'ebigere bye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.60.12",
            "verseOrgIds": [
              "PSA.60.14"
            ]
          }
        }
      ]
    }
  ],
