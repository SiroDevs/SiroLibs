      "attrs": {
        "style": "q2",
        "vid": "ECC 7:25"
      },
      "items": [
        {
          "text": "nekkanye, era nnoonyereze amagezi ndowooze ne ku bintu nga bwe biri,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        }
