      "attrs": {
        "style": "q2",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "ye mukazi alina omutima ogusendasenda,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
