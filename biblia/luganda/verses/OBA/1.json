      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "OBA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno kwe kwolesebwa kwa Obadiya.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "OBA 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.1",
                "verseOrgIds": [
                  "OBA.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Ayinzabyonna kwe yamuwa ku bikwata ku nsi ya Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "Tuwulidde obubaka obuva eri Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "Katonda yaweereza omubaka eri amawanga n'obubaka buno nti,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:1"
      },
      "items": [
        {
          "text": "\"Mugolokoke tulumbe Edomu tumulwanyise.\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.1",
            "verseOrgIds": [
              "OBA.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "OBA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Laba, ndibafuula aba wansi ennyo mu mawanga,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:2"
      },
      "items": [
        {
          "text": "era olinyoomererwa ddala.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.2",
            "verseOrgIds": [
              "OBA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "OBA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwelimbye n'amalala agali mu mitima gyammwe,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "mmwe abasula mu mpuku ez'omu njazi,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "era ne muzimba amaka gammwe waggulu ku njazi.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "Mmwe aboogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:3"
      },
      "items": [
        {
          "text": "'Ani alituwanulayo n'atussa wansi?'",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.3",
            "verseOrgIds": [
              "OBA.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "OBA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wadde nga mwewanika waggulu ng'empungu",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "era ne muzimba ebisu byammwe wakati w'emmunyeenye,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "ndibawanulayo ne mbasuula wansi,\"",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:4"
      },
      "items": [
        {
          "text": "bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.4",
                "verseOrgIds": [
                  "OBA.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.4",
            "verseOrgIds": [
              "OBA.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "OBA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Singa ababbi babajjira,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "n'abanyazi ne babalumba ekiro,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "akabi nga kaba kabatuuseeko.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "Tebandibabbyeko byonna bye baagala?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "Oba singa abanozi b'emizabbibu bakujjiridde,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:5"
      },
      "items": [
        {
          "text": "tebandireseeko obuzabbibu butono nnyo?",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.5",
            "verseOrgIds": [
              "OBA.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "OBA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu alinyagulurwa,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:6"
      },
      "items": [
        {
          "text": "eby'obugagga bye ebikusike birinyagibwa.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.6",
            "verseOrgIds": [
              "OBA.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "OBA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaalagaana naawe balikusindiikiriza ku nsalo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "Mikwano gyo balikulimbalimba ne bakuwangula;",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "abo abalya emmere yo balikutega omutego,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:7"
      },
      "items": [
        {
          "text": "balikutega omutego kyokka toliguvumbula.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.7",
            "verseOrgIds": [
              "OBA.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "OBA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ku lunaku olwo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "sirizikiriza bagezi b'e Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:8"
      },
      "items": [
        {
          "text": "abantu ab'amagezi ababeera mu nsozi za Esawu?\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "OBA.1.8",
                "verseOrgIds": [
                  "OBA.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.8",
            "verseOrgIds": [
              "OBA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "OBA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abalwanyi bo abazira ggwe, Temani, balitya,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "era na buli muntu mu nsozi za Esawu",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:9"
      },
      "items": [
        {
          "text": "alittibwa.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.9",
            "verseOrgIds": [
              "OBA.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "OBA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'ebikolwa eby'obukambwe ebyo bye wakola muganda wo Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:10"
      },
      "items": [
        {
          "text": "oliswazibwa.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "OBA 1:10"
      },
      "items": [
        {
          "text": "Olizikirizibwa n'otaddayo kuwulirwa.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "OBA 1:11"
          },
          "items": [
            {
