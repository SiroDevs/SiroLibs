          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye baajeema",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
