          "text": "Yagamba nti, \"Ddala bantu bange,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:8"
      },
      "items": [
        {
          "text": "abaana aboobulenzi abatannimbelimbe,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:8"
      },
      "items": [
        {
          "text": "era bw'atyo n'afuuka omulokozi waabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
