          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabonaabonera wamu nabo mu kubonaabona kwabwe kwonna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "era malayika ayimirira mu maaso ge n'abawonya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "Mu kwagala kwe n'ekisa kye yabanunula;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "yabayimusa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 63:9"
      },
      "items": [
        {
          "text": "n'abeetikka mu nnaku zonna ez'edda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        }
      ]
    },
    {
