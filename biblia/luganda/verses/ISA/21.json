    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obunnabbi Obukwata ku Babulooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunnabbi obukwata ku Ddungu eririraanye ennyanja:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "Ng'embuyaga bwe zikunta nga ziyita mu nsi ey'obukiikaddyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "bw'atyo alumba bw'ava mu ddungu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "eririraanye ensi etiisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nfunye okwolesebwa okw'entiisa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "alyamu olukwe akola omulimu gwe, n'omunyazi anyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Eramu, lumba! Obumeedi zingiza!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Ndikomya okusinda kwonna kwe yaleeta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubiri gwange kyeguvudde gulumwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "n'obulumi bunkwata, ng'omukazi alumwa okuzaala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "nnyiize olw'ebyo bye mpulira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "bye ndaba bimazeemu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutima gwange gutya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "Entiisa endetera okukankana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "Akasendabazaana ke nnali njayaanira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "kanfukidde ekikankano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bateekateeka olujjuliro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "bayalirira ebiwempe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "ne balya, ne banywa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "Mugolokoke mmwe abakulembeze,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "musiige engabo amafuta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino Mukama ky'aŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "\"Genda ofune omukuumi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "akuleetere amawulire ku ebyo by'alaba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'alaba amagaali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "n'ebibinja by'embalaasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "n'abeebagazi ku ndogoyi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "oba abeebagazi ku ŋŋamira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "yeekuume,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "era yeegendereze.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omukuumi n'ayogera mu ddoboozi ery'omwanguka ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "\"Mukama wange, buli lunaku nnyimirira ku munaala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "buli kiro mbeera ku mulimu gwange.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba omusajja wuuno ajjira mu ggaali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "ng'alina n'ekibinja ky'embalaasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Era ayanukula bw'ati nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "'Babulooni kigudde, weewaawo kigudde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Ebifaananyi bya bakatonda baakyo byonna",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "bibetenteddwa wansi ku ttaka.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bange, abasesebbuddwa ku gguuliro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:10"
      },
      "items": [
        {
          "text": "mbategeeza kyempulidde okuva eri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.21.10",
                "verseOrgIds": [
                  "ISA.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye, Katonda wa Isirayiri.",
