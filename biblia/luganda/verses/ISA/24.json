          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi ekala n'eggwaamu obulamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "ensi ekala n'ewuubaala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:4"
      },
      "items": [
        {
          "text": "abantu ab'ekitiibwa baggwaamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
