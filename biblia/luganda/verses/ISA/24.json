          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibuga kizikiridde",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        }
      ]
    },
    {
