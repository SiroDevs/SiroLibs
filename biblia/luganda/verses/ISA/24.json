      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "n'oluyoogaano lw'abo ababeera mu masanyu lusirise,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:8"
      },
      "items": [
        {
          "text": "entongooli esanyusa esirise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
