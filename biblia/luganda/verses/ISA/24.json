          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebakyanywa nvinnyo nga bwe bayimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:9"
      },
      "items": [
        {
          "text": "n'omwenge gukaayira abagunywa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibuga ekyazikirizibwa kisigadde nga matongo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:10"
      },
      "items": [
        {
          "text": "na buli mulyango oguyingira mu nnyumba guzibiddwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaabira envinnyo mu nguudo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "n'essanyu lyonna liweddewo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:11"
      },
      "items": [
        {
          "text": "n'okujaguza kwonna tekukyaliwo mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
