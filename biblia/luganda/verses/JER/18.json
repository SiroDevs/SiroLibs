      "attrs": {
        "style": "q2",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "bye bateesa banzite.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "Tobasonyiwa byonoono byabwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "wadde okusangulawo ebibi byabwe mu maaso go.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "Obawangulire ddala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "era obabonereze mu kiseera ky'obusungu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
