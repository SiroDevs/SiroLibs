  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JER 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero lw'Omubumbi n'Ebbumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino ky'ekigambo ekyajjira Yeremiya ekyava eri",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.1",
                "verseOrgIds": [
                  "JER.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Serengeta mu nnyumba y'omubumbi nkuweere eyo obubaka bwange.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne nserengeta eri ennyumba y'omubumbi ne mmulaba ng'akolera emirimu gye ku nnamuziga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ekintu kye yali abumba kyali kyonoonekedde mu ngalo ze, omubumbi kyeyava akibumbamu ekintu ekirala ng'akibumba nga bwe yasiima.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.5",
                "verseOrgIds": [
                  "JER.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kinzijira nga kigamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwe ennyumba ya Isirayiri, siyinza nze kubakola ng'omubumbi ono bw'akoze?\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.6",
                "verseOrgIds": [
                  "JER.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Okufaanana ng'ebbumba mu mukono gw'omubumbi, bwe mutyo bwe muli mu ngalo zange, ggwe ennyumba ya Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiseera kyonna bwe nnangirira nti eggwanga oba obwakabaka bwa kusiguukululwa, okumenyebwa era n'okuzikirizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "era singa eggwanga lye nalabula lyenenya ebibi byalyo, olwo ndyejjusa ne sibatuusaako kabi ke nnali ŋŋambye okubakola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ekiseera kyonna nnangirira ebikwata ku ggwanga oba obwakabaka nti ndizimba era ndisimba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "era bwe likola ebibi mu maaso gange, ne litaŋŋondera, ndyejjusa obulungi bwe nagamba okubakolera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Noolwekyo gamba abantu ba Yuda n'abo ababeera mu Yerusaalemi nti, 'Kino",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.11",
                "verseOrgIds": [
                  "JER.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'ayogera nti, Laba ntekateeka okubatuusaako ekikangabwa era nteesezza okubakola akabi. Kale muve mu makubo gammwe amabi, buli omu ku mmwe, mukyuse enneeyisa yammwe n'ebikolwa byammwe.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ne boogera nti, 'Tekirina kye kigasa. Tujja kugenda mu maaso n'entegeka yaffe; buli omu ku ffe anaakolanga ng'obukakanyavu bw'omutima gwe bwe buli.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bw'ati",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.13",
                "verseOrgIds": [
                  "JER.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "\"Mwebuuzeeko mu mawanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Ani eyali awuliddeko ekintu bwe kiti?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Muwala wange Isirayiri",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "akoze ekintu eky'ekivve.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzira oguli ku Lebanooni",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "gwali guwedde ku njazi zaakwo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "Amazzi gaakwo amannyogovu agava ewala",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "gaali galeseeyoko okukulukuta?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ate abantu bange banneerabidde,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "banyookezza obubaane eri bakatonda abalala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "abaleetera okwesittala mu makubo gaabwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "era ne mu makubo ag'edda",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "era ne balaga mu bukubokubo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yaabwe ya kusigala matongo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "ekintu eky'okusekererwa emirembe gyonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "abo bonna abayise balyewuunya",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "era ne banyeenya emitwe gyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibasaasaanya mu maaso g'abalabe baabwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "ng'empewo eva ebuvanjuba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "ndibalaga mabega",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "so si maaso gange ku lunaku olw'okulabirako ennaku.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne balyoka bagamba nti, \"Mujje tubeeko kye tukola Yeremiya. Kubanga bakabona weebali banaatutegeezanga amateeka, n'amagezi tunaagafunanga ku bagezi, era n'ebyobunnabbi binaavanga mu bannabbi. Kaakano mujje tumulumbe tumuwakanye era tuleme okussaayo omwoyo ku bigambo bye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.18",
            "verseOrgIds": [
              "JER.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ompulirize, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.19",
                "verseOrgIds": [
                  "JER.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:19"
      },
      "items": [
        {
          "text": "owulirize abampakanya kye bagamba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikolwa ebirungi binaasasulwanga na bikolwa ebibi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:20"
      },
      "items": [
        {
          "text": "Bansimidde obunnya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:20"
      },
      "items": [
        {
          "text": "Ojjukire nga nayimirira mu maaso go",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:20"
      },
      "items": [
        {
          "text": "ne nkaaba ku lwabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:20"
      },
      "items": [
        {
          "text": "nga nsaba olekeraawo okubasunguwalira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo abaana baabwe baleke bafe enjala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:21"
      },
      "items": [
        {
          "text": "obaweeyo battibwe n'ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:21"
      },
      "items": [
        {
          "text": "Leka bakazi baabwe bafuuke bagumba era babe bannamwandu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:21"
      },
      "items": [
        {
          "text": "abasajja baabwe battibwe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:21"
      },
      "items": [
        {
          "text": "abavubuka baabwe batirimbulwe n'ekitala mu lutalo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
