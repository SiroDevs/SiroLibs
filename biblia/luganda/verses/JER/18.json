          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leka okukaaba kuwulirwe nga kuva mu nnyumba zaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:22"
      },
      "items": [
        {
          "text": "bwe banaalumbibwa ne bazindibwa embagirawo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:22"
      },
      "items": [
        {
          "text": "kubanga bansimidde ekinnya bankwate",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:22"
      },
      "items": [
        {
          "text": "era bateze ebigere byange emitego.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        }
      ]
    },
    {
