              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.23",
                "verseOrgIds": [
                  "JER.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", gw'omanyi byonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
