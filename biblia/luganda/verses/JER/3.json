        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda Omukazi Atali Mwesigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja bw'agoba mukazi we,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "omukazi oyo n'agenda n'afuuka ow'omusajja omulala,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "omusajja we alimukomyawo nate?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Ensi eba teyonoonekedde ddala nnyo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Naye obadde nga malaaya, ng'olina abasajja bangi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "naye kaakano oyagala okukomawo gye ndi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.1",
                "verseOrgIds": [
                  "JER.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yimusa amaaso go olabe ku ntikko y'obusozi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Waliwo ekifo we bateebakira naawe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Ku mabbali g'ekkubo we watulanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "n'olinda abasajja ng'oli nga Omuwalabu mu ddungu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "n'olyoka oyonoona ensi",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "n'obwenzi bwo n'ekibi kyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo enkuba kyevudde eziyizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "n'enkuba eya ttoggo n'etetonnya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "Naye era otemya nga malaaya",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "tokwatibwa nsonyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewakaŋŋamba nti Kitange ggwe mukwano gwange",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:4"
      },
      "items": [
        {
          "text": "okuva mu buto bwange,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "onoonyiigira ddala emirembe gyonna,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "olisunguwala emirembe gyonna?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Bw'otyo bw'oyogera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "naye okoze ebibi byonna ebisoboka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isirayiri, Atali Mwesigwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nnaku z'obufuzi bwa kabaka Yosiya",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.6",
                "verseOrgIds": [
                  "JER.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "yayogera nange n'aŋŋamba nti, \"Olabye Isirayiri etali neesigwa ky'ekoze? Agenze ku buli kasozi na buli wansi w'omuti oguyimiridde ne yeeyisa ng'omukazi omwenzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalowooza nti, Bw'alimala okukola bino byonna agenda kudda gye ndi naye teyadda, era muganda we atali mwesigwa Yuda n'akiraba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yalaba nti bwe namala okugoba Isirayiri eyanvaako, ne muwa n'ebbaluwa ey'okumugoba olw'obwenzi bwe. Naye ate ne ndaba muganda we atali mwesigwa Yuda nga taliimu kutya, naye n'agenda n'akola obwenzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.8",
            "verseOrgIds": [
              "JER.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo obwenzi bwe bwatuuka ne bumwanguyira nnyo n'ayenda n'asinza amayinja n'ebikonge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.9",
            "verseOrgIds": [
              "JER.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye wadde nga byonna bimaze okubaawo, muganda we Yuda atali mwesigwa, teyakomawo gye ndi na mutima gwe gwonna, naye yali alimbalimba,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.10",
                "verseOrgIds": [
                  "JER.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.11",
                "verseOrgIds": [
                  "JER.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "n'aŋŋamba nti, Isirayiri asudde obwesigwa, mutukuvu okusinga Yuda atali mwesigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Genda obuulire abantu b'omu bukiikakkono obubaka buno, obagambe nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "\" 'Komawo ggwe Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "eyanvaako,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.12",
                "verseOrgIds": [
                  "JER.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'Siribatunuuliza busungu kubanga ndi waakisa,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.3.12",
                "verseOrgIds": [
                  "JER.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
