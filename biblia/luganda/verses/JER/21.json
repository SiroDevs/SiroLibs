    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Katonda Agaana Okusaba kwa Zeddekiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kye kigambo ekyajja eri Yeremiya okuva eri",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.1",
                "verseOrgIds": [
                  "JER.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", kabaka Zeddekiya bwe yamutumira Pasukuli mutabani wa Malukiya ne Zeffaniya kabona mutabani wa Maaseya okumugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tubuulize kaakano ku",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.2",
                "verseOrgIds": [
                  "JER.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kubanga Nebukadduneeza kabaka w'e Babulooni atulumbye. Oboolyawo",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.2",
                "verseOrgIds": [
                  "JER.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "anatukolera ekyamagero ng'edda, Nebukadduneeza n'atuleka.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yeremiya n'abaddamu nti, \"Mugambe Zeddekiya nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.4",
                "verseOrgIds": [
                  "JER.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa Isirayiri nti, Nnaatera okuboolekeza ebyokulwanyisa byammwe ebiri mu mikono gyammwe bye mukozesa okulwanyisa kabaka w'e Babulooni n'Abakaludaaya ababazinze ne beetooloola ebweru wa bbugwe w'ekibuga kyammwe. Nzija kubakuŋŋaanyiza munda mu kibuga kino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nze kennyini nzija kubalwanyisa n'omukono gwange ogw'amaanyi, ogugoloddwa mu busungu, n'ekiruyi n'obukambwe obungi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndittisa kawumpuli omubi, abantu awamu n'ensolo enkambwe, mu kibuga kino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lw'ekyo, nnaawaayo Zeddekiya kabaka wa Yuda, n'abakungu be n'abantu bonna mu kibuga kino abanaaba bawonye kawumpuli, ekitala n'enjala ebya Nebukadduneeza kabaka w'e Babulooni n'abalabe baabwe ababanoonya okubatta. Nebukadduneeza anaabatta n'ekitala, taabalage kisa n'akatono wadde okubasaasira oba okubasonyiwa.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Era abantu bagambe nti, 'Bw'ati",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.8",
                "verseOrgIds": [
                  "JER.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ayogera nti: Laba mbateereddewo ekkubo ery'obulamu era n'ekkubo ery'okufa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli anaasigala mu kibuga kino ajja kufa ekitala, oba enjala oba kawumpuli. Naye buli afuluma ne yeewaayo eri Abakaludaaya ababazingizza, ajja kuba mulamu, era anaawonya obulamu bwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmaliridde okuleetera ekibuga kino akabi so si mirembe, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.10",
                "verseOrgIds": [
                  "JER.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Kijja kuweebwayo mu mikono gya kabaka w'e Babulooni, era ajja kukizikiriza n'omuliro.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"N'ekirala gamba ennyumba ya Yuda ey'obwakabaka nti, 'Wulira ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.11",
                "verseOrgIds": [
                  "JER.21.11"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ggwe ennyumba ya Dawudi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "\" 'kino",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.12",
                "verseOrgIds": [
                  "JER.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'agamba:",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "Musale emisango mu bwenkanya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "mununule ababa banyagiddwa ababanyigiriza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "obusungu bwange buleme kuvaayo",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "bubookye ng'omuliro olw'ekibi kye mukoze,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "nga tewakyali n'omu abuziyiza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba nkugguddeko olutalo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "ggwe Yerusaalemi abeera waggulu w'ekiwonvu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "ku lusozi olwagaagavu olw'ekyaziyazi, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.13",
                "verseOrgIds": [
                  "JER.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "mmwe abagamba nti, \"Ani ayinza okutulumba?",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "Ani ayinza okuyingira mu nnyumba zaffe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzija kubabonereza ng'ebikolwa byammwe bwe biri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "era ndikoleeza omuliro mu kibira kyammwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "gwokye byonna ebikyetoolodde,' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
