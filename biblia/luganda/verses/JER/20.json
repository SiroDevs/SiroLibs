  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JER 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya Ayigganyizibwa ng'Abuulira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Pasukuli eyali kabona mutabani wa Immeri, eyali omukulu mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.1",
                "verseOrgIds": [
                  "JER.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", yawulira nga Yeremiya awa obubaka buno,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'alagira Yeremiya akubibwe. N'asibibwa mu nvuba eyali mu mulyango ogw'ekyengulu ogwa Benyamini ku yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.2",
                "verseOrgIds": [
                  "JER.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwaddirira, nga Pasukuli amusumuludde mu nvuba, Yeremiya n'amugamba nti, \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.3",
                "verseOrgIds": [
                  "JER.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "takyakuyita Pasukuli, naye Magolumissabibu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.4",
                "verseOrgIds": [
                  "JER.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Laba, ndikufuula eky'entiisa, ekikangabwa, eri ggwe n'eri mikwano gyo bonna; era balifa ekitala ky'abalabe baabwe, n'amaaso go galikiraba, era Yuda yonna ndigiwaayo mu mukono gwa kabaka w'e Babulooni, alibatwala e Babulooni oba okubattisa ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndigabula obugagga bw'ekibuga kino bwonna obulimu, n'eby'omuwendo omungi era n'eby'obugagga byonna ebya bakabaka ba Yuda mu mukono gw'abalabe baabwe. Balibutwala babwetikke ng'omunyago mu Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ggwe Pasukuli, era n'abo bonna ab'omu nnyumba yo balitwalibwa mu busibe, e Babulooni. Eyo gy'olifiira era oziikibwe, ggwe ne mikwano gyo bonna b'otegeezezza obunnabbi obw'obulimba.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwemulugunya kwa Yeremiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.7",
                "verseOrgIds": [
                  "JER.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", wannimba era n'ennimbibwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "wansinza amaanyi n'ompangula.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "Nvumibwa okuva ku makya okuzibya obudde,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:7"
      },
      "items": [
        {
          "text": "buli muntu ankudaalira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.7",
            "verseOrgIds": [
              "JER.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli lwe njogera,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "ndeekaana ne nnangirira akatabanguko n'okuzikirira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "Kale ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.8",
                "verseOrgIds": [
                  "JER.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kindeetera",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:8"
      },
      "items": [
        {
          "text": "kuvumwa na kusekererwa buli lunaku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.8",
            "verseOrgIds": [
              "JER.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bwe ŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "\"Sijja kumwogerako oba okweyongera okwogera mu linnya lye,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "ekigambo kye mu mutima gwange kiri ng'omuliro ogwaka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "ogukwekeddwa mu magumba gange.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "Nkooye okukizibiikiriza",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:9"
      },
      "items": [
        {
          "text": "era ddala sisobola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.9",
            "verseOrgIds": [
              "JER.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpulira bangi nga beegeya nti, \"Akabi kali enjuuyi zonna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Mumuloope.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Leka naffe tumuloope.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "Mikwano gyange bonna",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "banninda ngwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "nga bagamba nti, \"Oboolyawo anaasobya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "tumugweko",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:10"
      },
      "items": [
        {
          "text": "tuwoolere eggwanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.10",
            "verseOrgIds": [
              "JER.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.11",
                "verseOrgIds": [
                  "JER.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ali nange ng'omulwanyi ow'amaanyi ow'entiisa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:11"
      },
      "items": [
        {
          "text": "kale abanjigganya kyebaliva bagwa ne bataddayo kuyimirira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:11"
      },
      "items": [
        {
          "text": "Baakulemererwa era baswalire ddala",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.11",
            "verseOrgIds": [
              "JER.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:11"
      },
      "items": [
        {
