  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JER 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kananiya Nnabbi ow'Obulimba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwezi ogwokutaano ogw'omwaka gwe gumu, gwe mwaka ogwokuna, obufuzi bwa Zeddekiya kabaka wa Yuda nga bw'akatandika, nnabbi Kananiya omwana wa Azuri eyali abeera e Gibyoni n'aŋŋambira mu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.1",
                "verseOrgIds": [
                  "JER.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nga bakabona n'abantu bonna we bali nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.2",
                "verseOrgIds": [
                  "JER.28.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda wa Isirayiri nti, 'Nzija kumenya ekikoligo kya kabaka w'e Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka ebiri nga teginnaggwaako, ndikomyawo ebintu by'omu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.3",
                "verseOrgIds": [
                  "JER.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mu kifo kino, Nebukadduneeza kabaka w'e Babulooni bye yaggya wano n'abitwala e Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndikomyawo wano Yekoyakini mutabani wa Yekoyakimu kabaka wa Yuda n'abantu abalala bonna abaava mu Yuda abaatwalibwa e Babulooni,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.4",
                "verseOrgIds": [
                  "JER.28.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'kubanga ndimenya ekikoligo kya kabaka w'e Babulooni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo nnabbi Yeremiya n'addamu mu bunnabbi bwa Kananiya nga ne bakabona n'abantu bonna we bali bayimiridde mu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.5",
                "verseOrgIds": [
                  "JER.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amiina! Bw'atyo",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.6",
                "verseOrgIds": [
                  "JER.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'aba akola!",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.6",
                "verseOrgIds": [
                  "JER.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "atuukirize ebigambo by'oyogedde ng'akomyawo ebintu eby'omu nnyumba ya",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.6",
                "verseOrgIds": [
                  "JER.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "era n'abawambe bonna abakomyewo mu kifo kino okuva mu Babulooni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula, wuliriza kye ŋŋenda okwogera ng'owuliriza n'abantu bano bonna nga bawulira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva edda n'edda bannabbi abaatusooka, ggwe nange baategeezanga kubaawo kwa ntalo, na bikangabwa na kawumpuli okugwa ku mawanga n'obwakabaka obw'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nnabbi eyategeeza obunnabbi obw'emirembe ajja kulabibwa nga ddala atumiddwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.9",
                "verseOrgIds": [
                  "JER.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "era ng'obubaka bw'ategeeza butuukiridde.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo nnabbi Kananiya n'alyoka akwata ekikoligo ekyali ku nsingo ya Yeremiya n'akimenya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
              "JER.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'alyoka ayogera eri abantu bonna nti, \"Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.11",
                "verseOrgIds": [
                  "JER.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Mu ngeri y'emu bw'eti, bwe ndimenya ekikoligo ekya Nebukadduneeza kabaka w'e Babulooni okuva ku mawanga gonna mu myaka ebiri.' \" Naye ye nnabbi Yeremiya n'avaawo ne yeetambulira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe waayitawo ebbanga ttono nga nnabbi Kananiya amenye ekikoligo ku nsingo ya Yeremiya, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.12",
                "verseOrgIds": [
                  "JER.28.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Yeremiya nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Genda ogambe Kananiya nti, 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.13",
                "verseOrgIds": [
                  "JER.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, Omenye ekikoligo kya muti naye mu kifo kyakyo ojja kufunamu kikoligo kya kyuma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.14",
                "verseOrgIds": [
                  "JER.28.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda wa Isirayiri nti, Nditeeka ekikoligo eky'ekyuma mu nsingo z'amawanga gano gonna baweereze Nebukadduneeza kabaka w'e Babulooni era balimuweereza. Ndimuwa obuyinza n'ensolo azifuge.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo nnabbi Yeremiya n'agamba nnabbi Kananiya nti, \"Wuliriza, Kananiya!",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.15",
                "verseOrgIds": [
                  "JER.28.15"
                ]
              }
            }
          ]
        },
        {
          "text": "tannakutuma naye ggwe owalirizza eggwanga lino okwesiga obulimba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo kino",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.16",
                "verseOrgIds": [
                  "JER.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kyagamba nti, 'Ndikumpi okukuggya ku nsi. Omwaka guno gwennyini ogenda kufa, kubanga oyigirizza abantu okujeemera",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.16",
                "verseOrgIds": [
                  "JER.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 28:17"
          },
          "items": [
            {
              "text": "17",
