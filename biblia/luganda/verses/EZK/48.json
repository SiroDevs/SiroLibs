    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okugabana kw'Ettaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gano ge mannya g'ebika:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:1"
      },
      "items": [
        {
          "text": "\"Ku nsalo ey'Obukiikakkono, okuva ku nnyanja n'okuyita mu kkubo Agekusulooni okutuuka awayingirirwa mu Kamasi n'okutuuka Kazalenooni ekiri ku nsalo y'e Ddamasiko ku luuyi olw'Obukiikakkono okuliraana Kamasi, okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba, gwe guliba omugabo gwa Ddaani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana Ddaani okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba mugabo gwa Aseri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana Aseri okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba mugabo gwa Nafutaali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana Nafutaali okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba mugabo gwa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana Manase okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba mugabo gwa Efulayimu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana Efulayimu okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba mugabo gwa Lewubeeni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana Lewubeeni okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba mugabo gwa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okuliraana Yuda okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba gwe guliba omugabo gwe muligaba ng'ekirabo eky'enjawulo. Obugazi guliba mayilo munaana, n'obuwanvu okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba guliba ekipimo kye kimu, ng'ogumu ku migabo gy'ebika. Mu makkati g'ekitundu ekyo we waliba ekifo ky'Awatukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omugabo ogw'enjawulo gwe muligabira",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.9",
                "verseOrgIds": [
                  "EZK.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "guliba obuwanvu mayilo munaana n'obugazi mayilo ssatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omugabo ogwo ogwawuddwako guliba gwa bakabona era guliba mayilo munaana obuwanvu ku luuyi olw'ebuvanjuba, n'obugazi mayilo ssatu ku luuyi olw'Obukiikakkono, n'obugazi mayilo ssatu ku luuyi olw'ebugwanjuba n'obuwanvu mayilo munaana ku luuyi olw'Obukiikaddyo. Mu makkati g'ekitundu ekyo we waliba ekifo ky'Awatukuvu wa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.10",
                "verseOrgIds": [
                  "EZK.48.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo ekyo kiriba kya bakabona abaatukuzibwa bazzukulu ba Zadooki, abaamperezanga n'obwesigwa ne batawaba ng'abaana ba Isirayiri bwe baakola, era ng'Abaleevi abalala bwe banvaako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriba kirabo kyabwe eky'enjawulo ekiggiddwa ku mugabo ogwawuddwa ku nsi, ekifo ekitukuvu ennyo okuliraana ekitundu ky'Abaleevi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Okuliraana ekitundu ekya bakabona, Abaleevi balifuna omugabo, obuwanvu mayilo munaana n'obugazi mayilo ssatu. Obuwanvu bwonna buliba mayilo munaana n'obugazi mayilo ssatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebateekwa kukitunda newaakubadde okukiwaanyisa; wadde okuggyamu ebibala ebisooka eby'omu nsi kubanga kitukuvu eri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.48.14",
                "verseOrgIds": [
                  "EZK.48.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekitundu ekirifikkawo ekiweza obuwanvu mayilo munaana n'obugazi mayilo emu kiriba kifo kya bulijjo eky'ekibuga, okuzimbamu ennyumba. Ekibuga kiriba wakati wakyo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "era ebipimo byakyo biriba ku luuyi olw'Obukiikakkono mayilo emu n'ekitundu ne ku luuyi olw'Obukiikaddyo mayilo emu n'ekitundu, ne ku luuyi olw'ebuvanjuba mayilo emu n'ekitundu, ne ku luuyi olw'ebugwanjuba mayilo emu n'ekitundu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo ekiri ebbali w'ekibuga kiriba n'ebipimo byakyo; ku luuyi olw'Obukiikakkono mita ebikumi bibiri mu nkaaga, ne ku luuyi olw'Obukiikaddyo mita ebikumi bibiri mu nkaaga, ne ku luuyi olw'ebuvanjuba mita ebikumi bibiri mu nkaaga, ne ku luuyi olw'ebugwanjuba mita ebikumi bibiri mu nkaaga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitundu ekirifikkawo okuliraana omugabo omutukuvu, kiriba obuwanvu mayilo ssatu ku luuyi olw'ebuvanjuba ne mayilo ssatu ku luuyi olw'ebugwanjuba, n'ebibala byamu bye biriba emmere y'abakola mu kibuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakola mu kibuga baliva mu bika byonna ebya Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekifo kyonna awamu kiriba kyenkana obuwanvu n'obugazi ze mayilo munaana buli luuyi. Ekyo kye kiriba ekirabo eky'enjawulo eky'omugabo omutukuvu, awamu n'ettaka ly'ekibuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekitundu ekirifikkawo ku njuyi zombi ez'omugabo omutukuvu n'ettaka ly'ekibuga biriba bya mulangira. Okugenda mu Buvanjuba ekimu kiriba mayilo munaana ez'omugabo omutukuvu okutuuka ku nsalo ey'Ebuvanjuba, n'ekirala okudda mu Bugwanjuba kiriba mayilo munaana okutuuka ku nsalo ey'Ebugwanjuba. Ebifo ebyo byombi okuliraana emigabo egy'ebika biriba bya mulangira. Omugabo omutukuvu, awamu n'Awatukuvu wa yeekaalu, biriba wakati wakyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitundu ky'Abaleevi n'ettaka ly'ekibuga biriba wakati mu kitundu ky'omulangira. Ekifo ky'omulangira kiriba wakati w'ensalo ya Yuda n'ensalo ya Benyamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"N'ebika ebirala birigabana bwe biti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 48:23"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZK 48:23"
      },
      "items": [
        {
          "text": "\"Okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba, gwe guliba omugabo gwa Benyamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana ensalo ya Benyamini okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba, guliba mugabo gwa Simyoni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana ensalo ya Simyoni okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba, guliba mugabo gwa Isakaali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'okuliraana ensalo ya Isakaali okuva ku luuyi olw'ebuvanjuba okutuuka ku luuyi olw'ebugwanjuba, guliba mugabo gwa Zebbulooni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        }
      ]
