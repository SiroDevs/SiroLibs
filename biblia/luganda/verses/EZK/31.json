  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "EZK 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olugero olw'Omuvule gwa Lebanooni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogw'ekkumi n'ogumu, mu mwezi ogwokusatu ku lunaku olw'olubereberye, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.1",
                "verseOrgIds": [
                  "EZK.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ne kinzijira n'aŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omwana w'omuntu, tegeeza Falaawo, ye kabaka w'e Misiri n'olufulube lw'abantu be nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:2"
      },
      "items": [
        {
          "text": "\" 'Ani ayinza okwegeraageranya naawe mu kitiibwa?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunuulira Obwasuli, ogwali omuvule mu Lebanooni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "nga gulina amatabi amalungi agaasiikirizanga ekibira;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "ogwali omuwanvu ennyo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "nga guyitamu ne mu kasolya ak'ekibira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazzi gaaguliisanga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "n'enzizi ezikka wansi ennyo ne ziguwanvuya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "n'emigga gyagyo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "ne gigwetooloola wonna,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "ne giweerezanga n'amatabi gaagyo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "eri emiti gyonna egy'omu ttale.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyegwava gukula ne guwanvuwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "okusinga emiti gyonna egy'omu kibira,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "n'amatabi gaagwo amanene",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "ne geeyongera obunene,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "n'amatabi gaagwo amatono ne gawanvuwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "ne gasaasaana olw'obungi bw'amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebinyonyi byonna eby'omu bbanga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "ne bizimba ebisu byazo mu matabi gaagwo amanene,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "n'ensolo enkambwe ez'oku ttale",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "ne zizaaliranga wansi w'amatabi gaagwo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "n'amawanga gonna amakulu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "ne gabeeranga wansi w'ekisiikirize kyagwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwali gwa kitalo mu bulungi bwagwo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "n'amatabi gaagwo amanene,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "kubanga emirandira gyagwo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "gyasima awali amazzi amangi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emivule egyali mu nnimiro ya Katonda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "tegyayinza kuguvuganya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "newaakubadde emiberoosi okwenkana",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "n'amatabi gaagwo amanene;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "n'emyalamooni nga tegifaanana",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "matabi gaagwo amatono,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "so nga tewali muti mu nnimiro ya Katonda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "ogugwenkana mu bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagulungiya n'amatabi amangi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "emiti gyonna egy'omu Adeni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "egyali mu nnimiro ya Katonda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "ne gigukwatirwa obuggya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.10",
                "verseOrgIds": [
                  "EZK.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kyava ayogera bw'ati nti; Kubanga gwegulumiza, ne gwewanika waggulu okuyita mu kasolya ak'ekibira, ate ne guba n'amalala olw'obuwanvu bwagwo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyendiva nguwaayo mu mukono gw'omufuzi ow'amawanga agukole ng'obutali butuukirivu bwagwo bwe buli, era ngugobye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bannaggwanga abasingirayo ddala obukambwe baagutema ne bagusuula. Amatabi gaagwo amanene gaagwa ku nsozi ne mu biwonvu byonna, n'amatabi gaagwo amatono ne gagwa nga gamenyese mu biwonvu byonna eby'ensi. N'amawanga gonna ag'oku nsi gaava wansi w'ekisiikirize kyagwo, ne gagulekawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebinyonyi byonna eby'omu bbanga ne bituula ku matabi agaagwa, era n'ensolo enkambwe ez'oku ttale zonna ne zibeera mu matabi gaagwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyewaliva walema okubaawo emiti okumpi n'amazzi egirikula ne giwanvuwa ne gyegulumiza n'okutuuka okuyita mu kasolya k'ekibira. Era tewalibaawo miti mirala egyafukirirwa obulungi egiriwanvuwa okutuuka awo, kubanga gyonna giweereddwayo eri okufa, okugenda emagombe, mu bantu abaabulijjo, n'abo abakka mu bunnya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.15",
            "verseOrgIds": [
              "EZK.31.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.15",
                "verseOrgIds": [
                  "EZK.31.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti, Ku lunaku lwe gwaleetebwa wansi emagombe, enzizi zaagukaabira, era naziyiza n'emigga gyagwo, n'amazzi gaagwo amangi okukulukuta. Ku lulwe nayambaza Lebanooni obuyinike, n'emiti gyonna egy'oku ttale ne gikala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.15",
            "verseOrgIds": [
              "EZK.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naleetera amawanga okukankana olw'eddoboozi ery'okugwa kwagwo bwe naguserengesa emagombe n'abo abaserengeta wansi mu bunnya. Olwo emiti gyonna egya Adeni, egy'amaanyi era egisingayo obulungi egya Lebanooni emiti gyonna egyali gifukiriddwa obulungi amazzi, ne gizzibwamu amaanyi wansi mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.16",
            "verseOrgIds": [
              "EZK.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bonna ababeera mu kisiikirize kyagwo, n'amawanga agassanga ekimu nabo, bakirira nabo emagombe ne beegatta ku abo abattibwa n'ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Muti ki mu gy'omu Adeni ogw'enkana naawe mu bukulu mu kitiibwa kyo? Era naye, olisuulibwa wamu n'emiti egy'omu Adeni n'oserengeta emagombe, n'ogalamira eyo wamu n'abatali bakomole, n'abo abattibwa n'ekitala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 31:18"
      },
      "items": [
        {
          "text": "\" 'Ono ye Falaawo n'ekibinja kye kyonna, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.31.18",
                "verseOrgIds": [
                  "EZK.31.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    }
  ],
