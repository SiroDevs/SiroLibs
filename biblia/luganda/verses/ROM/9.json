        "style": "q2",
        "vid": "ROM 9:33"
      },
      "items": [
        {
          "text": "n'olwazi olulibasuula.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
              "ROM.9.33"
            ]
          }
        }
      ]
