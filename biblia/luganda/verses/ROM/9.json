      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:33"
      },
      "items": [
        {
          "text": "\"Laba, nteeka mu Sayuuni ejjinja eryesittalwako",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
              "ROM.9.33"
