    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okulabula eri Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwulire ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.4.1",
                "verseOrgIds": [
                  "HOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", mmwe abantu ba Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "kubanga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.4.1",
                "verseOrgIds": [
                  "HOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "abalinako ensonga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "mmwe abatuula mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "\"Obwesigwa n'okwagala Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:1"
      },
      "items": [
        {
          "text": "n'okumumanya bikendedde mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.1",
            "verseOrgIds": [
              "HOS.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo okukolima, n'okulimba, n'okutta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "n'okubba, n'okukola eby'obwenzi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "bawaguza,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:2"
      },
      "items": [
        {
          "text": "era bayiwa omusaayi obutakoma.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.2",
            "verseOrgIds": [
              "HOS.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi kyeneeva ekaaba,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "ne bonna abagibeeramu ne bafuuka ekitagasa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "n'ensolo enkambwe ez'omu nsiko zirifa, n'ennyonyi ez'omu bbanga nazo zirifa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:3"
      },
      "items": [
        {
          "text": "n'ebyennyanja ebiri mu nnyanja ne bifa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.3",
            "verseOrgIds": [
              "HOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye temuloopagana,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "so tewabaawo muntu avunaana munne,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "kubanga ensonga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:4"
      },
      "items": [
        {
          "text": "ngivunaana gwe kabona.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.4",
            "verseOrgIds": [
              "HOS.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakola ebibi emisana n'ekiro,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "ne bannabbi ne babikolera wamu naawe;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:5"
      },
      "items": [
        {
          "text": "kyendiva nzikiriza maama",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        },
        {
          "text": "wo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.5",
            "verseOrgIds": [
              "HOS.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bange bazikiridde olw'obutamanya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "HOS 4:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "\"Kyemunaava mulema",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "okubeera bakabona bange;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "era olw'okulagajjalira etteeka lya Katonda wo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:6"
      },
      "items": [
        {
          "text": "nange kyendiva ndagajjalira abaana bo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.6",
            "verseOrgIds": [
              "HOS.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gye beeyongera okuba abangi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "gye baakoma n'okukola ebibi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:7"
      },
      "items": [
        {
          "text": "baasuula ekitiibwa kyabwe ne banswaza.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.7",
            "verseOrgIds": [
              "HOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagaggawalira ku bibi by'abantu bange,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:8"
      },
      "items": [
        {
          "text": "era basemba okwonoona kwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.8",
            "verseOrgIds": [
              "HOS.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe kityo bwe kiriba eri abantu n'eri bakabona:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "ndibabonereza olw'enneeyisa yaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:9"
      },
      "items": [
        {
          "text": "era ne mbasasula ng'ebikolwa byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.9",
            "verseOrgIds": [
              "HOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Balirya naye tebalikkuta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "balikola ebibi eby'obwenzi kyokka tebalyeyongera bungi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 4:10"
      },
      "items": [
        {
          "text": "kubanga bavudde ku",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.4.10",
                "verseOrgIds": [
                  "HOS.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ne beewaayo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.10",
            "verseOrgIds": [
              "HOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "eri obwenzi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.4.11",
            "verseOrgIds": [
              "HOS.4.11"
