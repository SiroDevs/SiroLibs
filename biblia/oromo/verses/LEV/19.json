        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera Adda Addaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.1",
                "verseOrgIds": [
                  "LEV.19.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.1",
            "verseOrgIds": [
              "LEV.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkana jedhii waldaa saba Israaʼel hundatti himi; 'Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.2",
                "verseOrgIds": [
                  "LEV.19.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan qulqulluudhaatii isinis qulqulloota taʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.2",
            "verseOrgIds": [
              "LEV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Tokkoon tokkoon keessan haadha keessanii fi abbaa keessaniif ulfina kennaa; Sanbatoota koos eegaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.3",
                "verseOrgIds": [
                  "LEV.19.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.3",
            "verseOrgIds": [
              "LEV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gara waaqota tolfamootti hin deebiʼinaa yookaan sibiila baqfame irraa ofii keessaniif waaqota hin tolfatinaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.4",
                "verseOrgIds": [
                  "LEV.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.4",
            "verseOrgIds": [
              "LEV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yommuu aarsaa nagaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.5",
                "verseOrgIds": [
                  "LEV.19.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessitanitti akka aarsaan keessan fudhatama isiniif argatu godhaatii dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.5",
            "verseOrgIds": [
              "LEV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarsaan isin dhiʼeessitanis guyyuma sana yookaan guyyaa itti aanu haa nyaatamu; garuu wanni hafee hamma guyyaa sadaffaatti ture haa gubamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.6",
            "verseOrgIds": [
              "LEV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana keessaa tokko iyyuu yoo guyyaa sadaffaatti nyaatame xuraaʼaa dha; fudhatamas hin argatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.7",
            "verseOrgIds": [
              "LEV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni waan sana nyaatu sababii waan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.8",
                "verseOrgIds": [
                  "LEV.19.8"
                ]
              }
            }
          ]
        },
        {
          "text": "qulqulleeffame xureesseef itti gaafatama; namichi sun saba isaa keessaa haa balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.8",
            "verseOrgIds": [
              "LEV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yommuu oomisha lafa keessanii walitti qabattanitti hamma daariitti hin haaminaa; qarmii isaa illee hin funaannatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.9",
            "verseOrgIds": [
              "LEV.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qarmii iddoo dhaabaa wayinii keetii hin funaanin yookaan ija wayinii keetii kan harcaʼe hin funaanin. Hiyyeeyyii fi alagootaaf dhiisaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.10",
                "verseOrgIds": [
                  "LEV.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.10",
            "verseOrgIds": [
              "LEV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Hin hatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:11"
      },
      "items": [
        {
          "text": "\" 'Hin sobinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:11"
      },
      "items": [
        {
          "text": "\" 'Walis hin gowwoomsinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.11",
            "verseOrgIds": [
              "LEV.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Sobaan maqaa kootiin hin kakatinaa; akkasiinis maqaa Waaqa keessanii hin xureessinaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.12",
                "verseOrgIds": [
                  "LEV.19.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.12",
            "verseOrgIds": [
              "LEV.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ollaa kee gowwoomsitee waa irraa hin fudhatin yookaan hin saamin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:13"
      },
      "items": [
        {
          "text": "\" 'Mindaa nama qaxarame tokkoo hamma bariʼutti of bira hin bulchin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.13",
            "verseOrgIds": [
              "LEV.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nama gurra duudaa hin abaarin yookaan nama jaamaa dura gufuu hin kaaʼin; garuu Waaqa kee sodaadhu. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.14",
                "verseOrgIds": [
                  "LEV.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.14",
            "verseOrgIds": [
              "LEV.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Murtii hin jalʼisinaa; nama wal caalchisuudhaan gara hiyyeessaa hin gorinaa; nama guddaafis hin looginaa; ollaa keetiif garuu murtii qajeelaa kenni.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.15",
            "verseOrgIds": [
              "LEV.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Saba kee gidduutti hamii hin facaasin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:16"
      },
      "items": [
        {
          "text": "\" 'Waan jireenya ollaa keetii balaa irra buusu hin hojjetin. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.16",
                "verseOrgIds": [
                  "LEV.19.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.16",
            "verseOrgIds": [
              "LEV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Garaa keetti obboleessa kee hin jibbin; akka cubbuu isaa keessatti qooda hin qabaanneef ollaa kee ifaan ifatti itti dheekkami.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.17",
            "verseOrgIds": [
              "LEV.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Saba kee keessaa nama tokkotti iyyuu haaloo hin baʼin yookaan haaloo itti hin qabatin; ollaa kee garuu akkuma ofii keetiitti jaalladhu. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.18",
                "verseOrgIds": [
                  "LEV.19.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.18",
            "verseOrgIds": [
              "LEV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Sirna koo eegaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\" 'Horii gosa gosaa walitti hin diqaalomsinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\" 'Midhaan gosa lama lafa qotiisaa keessanitti hin facaasinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:19"
      },
      "items": [
        {
          "text": "\" 'Wayyaa waan lama irraa hojjetame hin uffatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.19",
            "verseOrgIds": [
              "LEV.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni garbittii nama biraaf kaadhimamte kan hin furamin yookaan bilisummaan ishee hin kennaminiif wajjin yoo wal bira gaʼe isaan adabamuu qabu; taʼus waan dubartiin sun hin bilisoominiif isaan hin ajjeefamin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.20",
            "verseOrgIds": [
              "LEV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi sun garuu korbeessa hoolaa tokko aarsaa yakkaatiif gara balbala dunkaana wal gaʼiitti",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.21",
                "verseOrgIds": [
                  "LEV.19.21"
                ]
              }
            }
          ]
        },
        {
          "text": "haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.21",
            "verseOrgIds": [
              "LEV.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubichis korbeessa hoolaa aarsaa yakkaa sanaan cubbuu namichi hojjete sanaaf fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.22",
                "verseOrgIds": [
                  "LEV.19.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti araara haa buusu; cubbuun namichaas ni dhiifamaaf.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.22",
            "verseOrgIds": [
              "LEV.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Isin yommuu biyyattiitti galtanii muka ija kennu kan gosa hundaa dhaabdanitti, akka waan iji isaa dhowwameetti fudhadhaa. Isin akka waan iji sun hamma waggaa sadiitti dhowwameetti ilaalaa; iji sun hin nyaatamin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.23",
            "verseOrgIds": [
              "LEV.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa afuraffaatti immoo iji isaa hundinuu ni qulqullaaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoofis",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.24",
                "verseOrgIds": [
                  "LEV.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": "aarsaa galataa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.24",
            "verseOrgIds": [
              "LEV.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa shanaffaatti garuu ija isaa nyaachuu dandeessu. Haala kanaan oomishni keessan ni guddata. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.25",
                "verseOrgIds": [
                  "LEV.19.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.25",
            "verseOrgIds": [
              "LEV.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Utuu dhiigni keessa jiruu foon kam iyyuu hin nyaatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 19:26"
      },
      "items": [
        {
          "text": "\" 'Tolcha yookaan falfala hin hojjetinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.26",
            "verseOrgIds": [
              "LEV.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Rifeensa mataa keessanii naannessitanii hin haaddatinaa yookaan qarqara areeda keessaniis hin murmuratinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.27",
            "verseOrgIds": [
              "LEV.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nama duʼeef jettanii dhagna keessan hin mammadeessinaa yookaan mallattoo tumaa tokko illee of irratti hin tolfatinaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.28",
                "verseOrgIds": [
                  "LEV.19.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.28",
            "verseOrgIds": [
              "LEV.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Akka lafti halalummaatti deebitee hamminaan hin guutamneef intala kee akka isheen ejjitu gochuudhaan ishee hin salphisin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.29",
            "verseOrgIds": [
              "LEV.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Sanbatoota koo eegaa; iddoo qulqulluu koos kabajaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.30",
                "verseOrgIds": [
                  "LEV.19.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.30",
            "verseOrgIds": [
              "LEV.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Isin akka hin xuroofneef ilaaltota bira hin deeminaa yookaan warra ekeraa dubbisan hin barbaadinaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.31",
                "verseOrgIds": [
                  "LEV.19.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.31",
            "verseOrgIds": [
              "LEV.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Warra dulloomaniif kaʼi; jaarsaaf ulfina kenni; Waaqa kee sodaadhu. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.32",
                "verseOrgIds": [
                  "LEV.19.32"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo alagaan biyya keessan keessa isin wajjin jiraate isa hin cunqursinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.33",
            "verseOrgIds": [
              "LEV.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alagaan isin gidduu jiraatu sun akka dhalataa biyya keessaniitti haa ilaalamu. Akka ofii keessaniitti isa jaalladhaa; isinis biyya Gibxitti alagoota turtaniitii. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.34",
                "verseOrgIds": [
                  "LEV.19.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.34",
            "verseOrgIds": [
              "LEV.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Isin yommuu dheerina, ulfinaa fi baayʼina wayii safartanitti madaalii gowwoomsaatti hin fayyadaminaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Safartuu fi madaalii dhugaatti, iifii",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "text": "fi iinii",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "text": "dhugaatti fayyadamaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.36",
                "verseOrgIds": [
                  "LEV.19.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan kan biyya Gibxii baasee isin fidee dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ajajaa fi seera koo hunda eegaatii duukaa buʼaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.19.37",
                "verseOrgIds": [
                  "LEV.19.37"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        }
      ]
    }
  ],
