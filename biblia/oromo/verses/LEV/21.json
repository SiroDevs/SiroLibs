        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera Lubootaaf Kenname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.1",
                "verseOrgIds": [
                  "LEV.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe; \"Akkana jedhiitii ilmaan Aroon luboota sanatti dubbadhu: 'Lubni tokko nama fira isaa keessaa duʼeef jedhee of hin xureessin;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.1",
            "verseOrgIds": [
              "LEV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu firoota dhiigaatiif jechuunis haadha isaa, abbaa isaa, ilma isaa, intala isaa, obboleessa isaa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.2",
            "verseOrgIds": [
              "LEV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan obboleettii isaa kan sababii hin heeruminiif isa wajjin jiraattuuf jedhee of xureessuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.3",
            "verseOrgIds": [
              "LEV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu namoota karaa fuudhaa fi heerumaatiin firoota isaa taʼaniif jedhee of hin xureessin; akkasiinis xuraaʼaa hin taʼin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Luboonni mataa isaanii yookaan qarqara areeda isaanii hin haadatin yookaan dhagna isaanii hin madeessin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.5",
            "verseOrgIds": [
              "LEV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan Waaqa isaaniitiif qulqulloota haa taʼan; maqaa Waaqa isaaniis hin xureessin. Isaan waan aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.6",
                "verseOrgIds": [
                  "LEV.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamu, nyaata Waaqa isaanii sana dhiʼeessaniif qulqulloota taʼuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Luboonni sababii Waaqa isaaniitiif qulqulloota taʼaniif isaan dubartoota sagaagalummaadhaan xuraaʼan yookaan kanneen dhirsoota isaanii hiikan fuudhuu hin qaban.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati isa qulqulleessi; inni nyaata Waaqa keetii dhiʼeessaatii. Inni siif haa qulqullaaʼu; ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.8",
                "verseOrgIds": [
                  "LEV.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "inni isin qulqulleessu qulqulluudhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.8",
            "verseOrgIds": [
              "LEV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Intalli luba tokkoo yoo sagaagalummaadhaan of xureessite isheen abbaa ishee salphifti; isheen ibiddaan haa gubamtu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.9",
            "verseOrgIds": [
              "LEV.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lubni obboloota isaa keessaa luba ol aanaa taʼee zayitiin ittiin diban mataa isaa irratti naqame kan akka uffata lubummaa uffatuuf muudame tokko mataa isaa filachuu hin dhiisin yookaan uffata ofii hin tarsaasin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.10",
            "verseOrgIds": [
              "LEV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni iddoo reeffi jiru hin seenin. Abbaa isaatiif yookaan haadha isaatiif iyyuu jedhee of hin xureessin;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.11",
            "verseOrgIds": [
              "LEV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan sababii zayitiin ittiin diban kan Waaqa isaa isa irra jiruuf inni iddoo qulqulluu sana keessaa hin baʼin yookaan iddoo qulqulluu Waaqa isaa hin xureessin. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.12",
                "verseOrgIds": [
                  "LEV.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Dubartiin inni fuudhu durba taʼuu qabdi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.13",
            "verseOrgIds": [
              "LEV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni haadha hiyyeessaa, niitii dhirsi hiike yookaan niitii sagaagalummaadhaan xuroofte hin fuudhin; garuu gosa isaa keessaa durba haa fuudhu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.14",
            "verseOrgIds": [
              "LEV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka inni gosa isaa keessatti sanyii isaa hin xureessineef. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.15",
                "verseOrgIds": [
                  "LEV.21.15"
                ]
              }
            }
          ]
        },
        {
          "text": "isa qulqulleessuu dha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
            "verseOrgIds": [
              "LEV.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.16",
                "verseOrgIds": [
                  "LEV.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.16",
            "verseOrgIds": [
              "LEV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Arooniin akkana jedhi: 'Dhaloota itti aanu keessatti sanyii kee keessaa namni hirʼina qabu kam iyyuu nyaata Waaqa isaa dhiʼeessuuf hin dhiʼaatin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.17",
            "verseOrgIds": [
              "LEV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hirʼina kam iyyuu qabu tokko iyyuu jechuunis namni jaamaan yookaan naafni, namni bifaa fi dhagna hin tolle,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "namni miilla yookaan harka cabaa qabu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan namni dugda goophoo yookaan ooluun yookaan namni dhibee ijaa qabu yookaan namni madaa malaʼu qabu, yookaan namni cittoo qabuu fi namni kolaafame hin dhiʼaatin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii Aroon lubichaa keessaa namni hirʼina qabu kam iyyuu aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.21",
                "verseOrgIds": [
                  "LEV.21.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamu dhiʼeessuuf hin dhiʼaatin. Inni waan hirʼina qabuuf nyaata Waaqa isaa dhiʼeessuuf hin dhiʼaatin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis nyaata Waaqa isaa kan nyaata hunda caalaa qulqulluu taʼee fi nyaata qulqulluu nyaachuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
              "LEV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni sababii hirʼina qabuuf akka iddoo qulqulluu koo hin xureessineef golgaa keessa hin seenin yookaan iddoo aarsaatti hin dhiʼaatin. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.21.23",
                "verseOrgIds": [
                  "LEV.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "isa isaan qulqulleessuu dha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen Aroonitti, ilmaan Aroonittii fi Israaʼeloota hundatti waan kana hime.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.24",
            "verseOrgIds": [
              "LEV.21.24"
            ]
          }
        }
      ]
    }
  ],
