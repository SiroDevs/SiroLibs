    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Waggoota sanbataa torba jechuunis waggoota torba yeroo torba lakkaaʼi; waggoonni sanbataa torban waggoota afurtamii sagal taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa kurnaffaa jiʼa torbaffaatti immoo guutummaa biyya keessanii keessatti malakata dhageessisi; Guyyaa Araarri Buʼuttis guutummaa biyyaa keessatti malakata dhageessisaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa shantamaffaa qulqulleessaatii guutummaa biyyattii keessatti jiraattota hundaaf bilisummaa labsaa. Kunis iyyoobeeliyyuu isinii taʼa; tokkoon tokkoon namaa deebiʼee gara qabeenya isaattii fi gara maatii isaatti haa galu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaan shantamaffaan iyyoobeeliyyuu isiniif haa taʼu; hin facaafatinaa; waan ofiin biqile hin haammatinaa; wayinii hin qoramin irraas ija isaa walitti hin qabatinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun sababii iyyoobeeliyyuu taʼeef qulqulluu isiniif haa taʼu; waan lafa qotiisaa irraa galfamu nyaadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Waggaa Iyyoobeeliyyuu kana keessa tokkoon tokkoon namaa gara qabeenya isaatti haa deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo nama saba kee taʼetti lafa gurgurte yookaan waan tokko isa irraa bitte, wal hin gowwoomsinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati waggoota waggaa Iyyoobeeliyyuu booddee jiran irratti hundooftee nama saba keetii irraa bitadhu. Innis baayʼina waggoota galchaa midhaanii lakkaaʼee sitti haa gurguru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo waggaan baayʼee taʼe gatii isaa dabaliif; yoo waggaan isaa gabaabaa taʼe immoo gatii isaa hirʼisi; sababiin isaa wanni inni sitti gurguru baayʼina midhaanii ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wal hin cunqursinaa; garuu Waaqa sodaadhaa. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.17",
                "verseOrgIds": [
                  "LEV.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ajaja koo duukaa buʼaa; seera koo illee eegaa; isinis biyyattii keessa nagaan ni jiraattu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti ija ni kenniti; isinis hamma quuftanitti nyaattu; nagaadhaanis ni jiraattu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis, \"Nu yoo facaafachuu yookaan midhaan keenya walitti qabachuu baanne waggaa torbaffaatti maal nyaanna?\" jettanii gaafattu taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka lafti midhaan waggaa sadiif gaʼu isinii kennituuf ani waggaa jaʼaffaatti eebba koo isiniif nan erga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo waggaa saddeettaffaatti facaafattanittis waanuma duraan galfattan irraa nyaattu; hamma midhaan waggaa saglaffaa walitti qabattanitti midhaanuma kana nyaattu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lafti sababii kanuma koo taateef bara baraan hin gurguramin; isin anaaf alagaa fi keessummoota.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya akka dhaalaatti qabattan guutuu keessatti waan ittiin lafa furtan baasaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Obboleessi kee tokko hiyyoomee lafa isaa yoo gurgure, namni fira isaa kan dhiʼoo taʼe dhufee waan firri isaa gurgure sana haa furuuf.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo namichi sun fira lafa isaa furuuf dhabee inni mataan isaa waan ittiin lafa isaa furatu argate,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "waggoota yeroo inni lafa isaa gurgure sanaa as jiran lakkaaʼee namicha itti gurgure sanaaf maallaqa isaa haa deebisu; innis gara lafa ofiitti haa deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo waan namicha sanaaf deebisu dhabee, wanni inni gurgure sun hamma waggaa iyyoobeeliyyuutti harkuma namicha bite sanaa haa turu. Waggaa Iyyoobeeliyyuu keessa ni deebiʼaaf; innis gara qabeenya isaatti ni deebiʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni yoo magaalaa dallaa qabdu keessatti mana jireenyaa gurgurate, gaafa gurguratee jalqabee waggaa tokko keessatti furachuu dandaʼa. Mirgi furachuu isaas hamma waggaa tokkootti tura.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.29",
            "verseOrgIds": [
              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo utuu waggaan tokko hin guutin furamuu baate manni magaalaa dallaa qabdu keessatti argamu sun qabeenya namicha biteetii fi kan sanyii isaa taʼee hafa. Waggaa Iyyoobeeliyyuuttis hin deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manneen gandoota dallaan itti hin ijaaramin keessa jiran garuu waan akka lafa baadiyyaatti hedamaniif furamuu dandaʼu. Bara Iyyoobeeliyyuuttis ni deebifamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Lewwonni garuu manneen isaanii kanneen magaalaawwan isaanii keessatti argaman furachuuf yeroo kam iyyuu mirga qabu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabeenyi Lewwotaa furamuu ni dandaʼa; manneen magaalaa isaan qabatan keessatti gurguraman bara Iyyoobeeliyyuutti ni deebifamu; manneen magaalaa Lewwotaa keessatti argaman Israaʼeloota gidduutti qabeenya Lewwotaatii.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti dheedaa kan naannoo magaalaa isaaniitti argamu garuu sababii qabeenya isaanii kan bara baraa taʼeef hin gurguramin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo obboleessi kee tokko hiyyoomee isin gidduutti of gargaaruu dadhabe, akka inni isin gidduu jiraachuu dandaʼuuf akkuma alagaa yookaan keessummaa tokko gargaartutti isa gargaar.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka namni sun si wajjin jiraachuu dandaʼuuf Waaqa kee sodaadhu malee dhala tokko iyyuu isa irraa hin fudhatin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maallaqa kee dhalaan hin liqeessiniif yookaan nyaata kee buʼaa itti herregattee hin kenniniif.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.38",
                "verseOrgIds": [
                  "LEV.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan kan biyya Kanaʼaan isiniif kennuu fi Waaqa keessan taʼuuf biyya Gibxii isin baasee dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo obboleessi kee tokko hiyyoomee sitti of gurgure akka garbichaatti isa hin hojjechiifatin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akka hojjetaa qaxaramaa yookaan nama yeroodhaaf isin wajjin jiraatuu haa taʼu; inni hamma Waggaa Iyyoobeeliyyuutti siif haa hojjetu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii inni ijoollee isaa wajjin gad haa lakkifamu; inni gara maatii isaatii fi qabeenya abbootii isaatti haa deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni sababii garboota koo warra ani biyya Gibxiitii baasee fide taʼaniif akka garbootaatti hin gurguramin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa kee sodaadhu malee gara jabinaan isaan hin bulchin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Garboonni kee dhiironnii fi dubartoonni saboota naannoo kee jiraatan gidduudhaa haa dhufan; isin isaan keessaa garboota bitachuu dandeessu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas keessummoota isin gidduu jiraatanii fi maatii isaanii warra biyya keessanitti dhalatan keessaa garboota bitachuu dandeessu; isaanis qabeenya keessan haa taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka qabeenya dhaalamuutti ijoollee keessanitti dabarsuu dandeessu; bara jireenya isaanii guutuus isaan garboomfachuu dandeessu; Israaʼeloota obboloota keessan taʼan garuu gara jabinaan hin bulchinaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 25:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo alagaan yookaan keessummaan si wajjin jiraatu tokko sooromee obboleessi kee immoo hiyyoomee alagaa si wajjin jiraatutti yookaan maatii alagaa sanaatti of gurgure,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.47",
            "verseOrgIds": [
              "LEV.25.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 25:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni erga of gurguree booddee furamuuf mirga qaba. Firoota isaa keessaas namni tokko isa furuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.48",
            "verseOrgIds": [
              "LEV.25.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 25:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboleessi abbaa isaa yookaan ilmi obboleessa abbaa isaa yookaan aantee isaa keessaa firri dhiigaa isa furuu dandaʼa. Yookaan inni iyyuu yoo soorome of furuu dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 25:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innii fi namichi isa bite sun waggaa inni itti of gurguree jalqabee hamma waggaa Iyyoobeeliyyuutti haa lakkaaʼan. Gatiin furii isaas baayʼina waggoota sanaa irratti hundaaʼa; yeroon inni namicha isa bitate sana bira ture immoo akka nama qacaramee hojjete tokkootti herregama.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 25:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo akka herrega isaaniitti waggoonni baayʼeen hafan inni gatii ittiin bitame sana keessaa harka baayʼee namicha sanaaf deebisuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51",
            "verseOrgIds": [
              "LEV.25.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 25:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo waggoonni hamma Waggaa Iyyoobeeliyyuutti hafan muraasa taʼan inni waggoota hafan sana herregatee gatii furama isaa haa kaffalu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.52",
            "verseOrgIds": [
              "LEV.25.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma nama waggaa waggaatti qaxaramu tokkootti isa wajjin haa jiraatu; fuula kee durattis inni gara jabinaan isa hin bulchin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 25:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yoo inni karaa kanneeniin furamuu baates innii fi ijoolleen isaa Waggaa Iyyoobeeliyyuutti furamuu qabu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.54",
            "verseOrgIds": [
              "LEV.25.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 25:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni garboota kootii. Isaan garboota koo kanneen ani biyya Gibxii baasee fidee dha. Ani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.55",
            "verseOrgIds": [
              "LEV.25.55"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.55",
                "verseOrgIds": [
                  "LEV.25.55"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.55",
            "verseOrgIds": [
              "LEV.25.55"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "LEV.26",
    "number": "26",
