    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boqonnaa Waggaa Torbaffaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.1",
                "verseOrgIds": [
                  "LEV.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Gaara Siinaa irratti Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkana jedhii Israaʼelootatti himi: 'Yommuu biyya ani isinii kennutti galtan, biyyattiin mataan ishee sanbata",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.2",
                "verseOrgIds": [
                  "LEV.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": "haa kabajju.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa jaʼa lafa qotiisaa kee facaafadhu; waggaa jaʼa immoo wayinii kee irraa qori; ija isaas walitti qabadhu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa torbaffaatti garuu lafti sanbata boqonnaa haa qabaatu; kunis sanbata",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.4",
                "verseOrgIds": [
                  "LEV.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kabajamuu dha. Lafa qotiisaa kee hin facaafatin yookaan wayinii kee irraa hin qorin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan ofiin biqile hin haammatin yookaan wayinii hin qoramin irraa ija walitti hin qabatin. Lafti boqonnaa waggaa tokkoo haa argattu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni lafti waggaa sanbataatti kennitu nyaata kee haa taʼu jechuunis siʼi mataa keetiif, garboota kee dhiiraa fi dubartiidhaaf, warra qaxaramanii hojjetanii fi alagoota yeroodhaaf si wajjin jiraataniif nyaata haa taʼu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas horii keetii fi bineensa daggalaa kanneen biyya kee keessa jiraataniif nyaata haa taʼu. Wanni lafti baaftu kam iyyuu haa nyaatamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
