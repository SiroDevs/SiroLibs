    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.1",
                "verseOrgIds": [
                  "LEV.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.1",
            "verseOrgIds": [
              "LEV.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka ibsaan ittuma fufee bobaʼuuf akka isaan zayitii ejersaa kan cuunfamee taliila taʼe siif fidaniif ijoollee Israaʼel ajaji.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonis ibsaawwan sana golgaa taabota kakuu seeraa kan dunkaana wal gaʼii keessa jiru sanaan alatti fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.3",
                "verseOrgIds": [
                  "LEV.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti galgalaa hamma ganamaatti ittuma fufee haa qopheessu. Kunis dhaloota keessaniif seera bara baraa haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibsaawwan baattuu ibsaa kan warqee qulqulluu irraa hojjetaman irra fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.4",
                "verseOrgIds": [
                  "LEV.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jiran sun ittuma fufanii qopheeffamuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Daakuu bullaaʼaa fuudhiitii buddeena kudha lama tolchi; tokkoon tokkoon buddeena sanaas daakuu iifii",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "text": "tokkoo irraa harka kudhan keessaa harka lama lamaan haa tolfamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buddeena kanas toora tokko keessa jaʼa jaʼa godhiitii minjaala warqee qulqulluu irraa hojjetamee fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.6",
                "verseOrgIds": [
                  "LEV.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jiru irra toora lamaan kaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni qooda buddeena sanaa kutaa yaadannootii fi aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.7",
                "verseOrgIds": [
                  "LEV.24.7"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamu taʼuuf tokkoo tokkoo toora sanaa irra ixaana qulqulluu kaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buddeenni kunis akka kakuu bara baraa taʼee saba Israaʼel iddoo buʼuuf yeroo hunda Sanbatuma Sanbataan fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.8",
                "verseOrgIds": [
                  "LEV.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": "dura haa kaaʼamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buddeenni kun qooda Arooniitii fi ilmaan isaa ti; isaanis sababii buddeenni kun qooda isaanii kan bara baraa kan aarsaa ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.9",
                "verseOrgIds": [
                  "LEV.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffame keessaa kutaa waan hunda caalaa qulqullaaʼe taʼeef iddoo qulqulluutti isa haa nyaatan.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namni Waaqa Arrabsu Dhagaadhaan Tumama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi haati isaa gosa Israaʼelii fi abbaan isaa immoo nama biyya Gibxii taʼe tokko Israaʼeloota gidduu baʼe; lollis qubata keessatti isaa fi Israaʼelicha tokko gidduutti kaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.10",
            "verseOrgIds": [
              "LEV.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi dubartii Israaʼel sunis Maqaa Waaqaa arrabse; ni abaares; kanaafuu Museetti isa fidan. Maqaan haadha namicha sanaas Sheloomiit jedhama; isheen immoo intala namicha gosa Daanii kan Dibraayi jedhamuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.11",
            "verseOrgIds": [
              "LEV.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis hamma fedhiin",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.12",
                "verseOrgIds": [
                  "LEV.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "isaanii ifutti eegumsa jala isa tursan.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.13",
                "verseOrgIds": [
                  "LEV.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.13",
            "verseOrgIds": [
              "LEV.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Namicha Waaqa arrabse sana qubata keessaa gad baasi. Warri isa dhagaʼan hundinuu harka isaanii mataa isaa irra haa kaaʼan; waldaan hundi immoo dhagaadhaan isa haa tumu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.14",
            "verseOrgIds": [
              "LEV.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼelootaan akkana jedhi; 'Namni kam iyyuu yoo Waaqa isaa abaare inni cubbuu hojjeteef itti gaafatama;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.15",
            "verseOrgIds": [
              "LEV.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "namni Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.24.16",
                "verseOrgIds": [
                  "LEV.24.16"
                ]
              }
            }
          ]
        },
        {
          "text": "arrabsu haa ajjeefamu. Waldaan hundi dhagaadhaan isa haa tumu. Alagaas taʼu dhalataan biyyaa yoo Maqaa Waaqaa arrabse haa ajjeefamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni nama ajjeese kam iyyuu haa ajjeefamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.17",
            "verseOrgIds": [
              "LEV.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni horii namaa ajjeese horii sana iddoo haa buusu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.18",
            "verseOrgIds": [
              "LEV.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo ollaa isaa miidhe, wanni inni nama sana godhe isa irrattis haa godhamu;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.19",
            "verseOrgIds": [
              "LEV.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis qooda cabaa cabaa, qooda ijaa ija, qooda ilkaanii ilkaan jechuu dha. Innis akkuma nama miidhe sana isa irrattis haa godhamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.20",
            "verseOrgIds": [
              "LEV.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni horii ajjeese horii sana iddoo haa buusu; namni nama ajjeese garuu haa ajjeefamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.21",
            "verseOrgIds": [
              "LEV.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
