              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Namni wantoota jibbisiisoo kanneen keessaa tokko illee hojjetu kam iyyuu saba isaa keessaa haa balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
