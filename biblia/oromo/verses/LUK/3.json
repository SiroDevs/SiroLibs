    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xibeeriyoos Qeesaar moʼee waggaa kudha shanaffaatti jechuunis yommuu Phonxoos Phiilaaxoos bulchaa Yihuudaa turetti, Heroodis bulchaa Galiilaa ture; obboleessi isaa Fiiliphoos bulchaa Ixuriyaasii fi Xiraakonitiis, Lisaaniiyaas immoo bulchaa Abileeniis turan;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.1",
            "verseOrgIds": [
              "LUK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo sana Haannaasii fi Qayyaaffaan luboota ol aantota turan. Dubbiin Waaqaa gammoojjii keessatti gara Yohannis ilma Zakkaariyaas dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.2",
            "verseOrgIds": [
              "LUK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis dhiifama cubbuutiif cuuphaa qalbii jijjiirrannaa lallabaa biyya naannoo Yordaanos hunda keessa deeme.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.3",
            "verseOrgIds": [
              "LUK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis isa kitaaba dubbii Isaayyaas raajichaa keessatti akkana jedhamee barreeffamee dha:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "\"Sagalee nama gammoojjii keessaa iyyu tokkoo:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "'Karaa Gooftaa qopheessaa;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:4"
      },
      "items": [
        {
          "text": "daandii isaas qajeelchaa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.4",
            "verseOrgIds": [
              "LUK.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sululli hundi ni guutama;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "tulluu fi gaarri hundinuus gad deebifamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "Karaan jalʼaan ni qajeela;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 3:5"
      },
      "items": [
        {
          "text": "daandiin buʼaa baʼiinis wal qixxeeffama.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.5",
            "verseOrgIds": [
              "LUK.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyiin namaa hundinuus fayyisuu Waaqaa ni arga.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.6",
            "verseOrgIds": [
              "LUK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannisis warra harka isaatti cuuphamuuf dhufaniin akkana jedhe; \"Isin ijoollee buutii nana! Dheekkamsa dhufu jalaa akka baqattaniif eenyutu isinitti hime?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.7",
            "verseOrgIds": [
              "LUK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa ija qalbii jijjiirrannaa mirkaneessu naqadhaa. Isin, 'Abbaan keenya Abrahaamii dha' ofiin jechuu hin jalqabinaa. Waaqni dhagoota kanneen irraa Abrahaamiif ijoollee kaasuu akka dandaʼu ani isinittan himaatii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.8",
            "verseOrgIds": [
              "LUK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qottoon amma iyyuu hidda mukkeenii irra kaaʼameera; mukti ija gaarii hin naqanne hundinuus muramee ibiddatti darbatama.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.9",
            "verseOrgIds": [
              "LUK.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis, \"Yoos maal haa goonuu ree?\" jedhanii isa gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.10",
            "verseOrgIds": [
              "LUK.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannisis deebisee, \"Namni uffata lama qabu isa homaa hin qabneef haa qoodu; kan nyaata qabus akkasuma haa godhu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.11",
            "verseOrgIds": [
              "LUK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaraxxoonni cuuphamuu dhufanii, \"Yaa barsiisaa, nu hoo maal haa goonu?\" jedhanii isa gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Waan ajajamtan caalaa walitti hin qabinaa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonnis akkasuma, \"Nu immoo maal haa goonu ree?\" jedhanii isa gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 3:14"
      },
      "items": [
        {
          "text": "Innis, \"Humnaan nama irraa maallaqa hin fudhatinaa; sobaan nama hin himatinaa; mindaan keessan isin haa gaʼu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sun hawwiidhaan eegaa turan; hundi isaaniis, \"Yohannis kun inni Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "text": "taʼinnaa laata?\" jedhanii garaa isaaniitti yaadaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannis akkana jedhee isaan hundaaf deebii kenne; \"Ani bishaaniin isin cuupha. Garuu kan na caalaa jabaa taʼe tokko ni dhufa; ani hidhaa kophee isaa illee hiikuun naaf hin malu. Inni Hafuura Qulqulluu fi ibiddaan isin cuupha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis oobdii isaa qulqulleessee gombisaa isaatti qamadii galfachuudhaaf afarsaan isaa harka isaa jira; habaqii garuu ibidda hin dhaamneen guba.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohannisis dubbii biraa baayʼeedhaan namoota gorsee wangeelas isaanitti lallabe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heroodis bulchaan garuu yommuu sababii inni niitii obboleessa isaa Heroodiyaas fuudhee fi sababii hammina inni hojjetee ture kaan hundaatiif Yohannis isa ifate,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "hammina isaa hunda irratti dabalee Yohannisin mana hidhaatti galchee itti cufe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
