    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maariyaamii fi Aroon Museedhaan Morman",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miiriyaamii fi Aroon sababii Museen dubartii Itoophiyaa fuudheef isaan mormuudhaan dubbachuu jalqaban; inni dubartii Itoophiyaa fuudhee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.1",
            "verseOrgIds": [
              "NUM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.2",
                "verseOrgIds": [
                  "NUM.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Musee qofaan dubbatee? Inni karaa keenyaanis dubbatee ture mitii?\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.2",
                "verseOrgIds": [
                  "NUM.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbii kana dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen namoota lafa irra jiraatan hunda caalaa nama akka malee gad of qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.4",
                "verseOrgIds": [
                  "NUM.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yommusuma Museen, Aroonii fi Miiriyaamiin, \"Isin sadanuu gara dunkaana wal gaʼiitti gad baʼaa\" jedhe. Isaan sadanuus gad baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.5",
                "verseOrgIds": [
                  "NUM.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "utubaa duumessaa keessaan gad buʼee balbala dunkaanaa irra dhaabatee Aroonii fi Miiriyaamin waame. Jarri lachuu isatti dhiʼaannaan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni akkana jedheen; \"Dubbii koo dhagaʼaa:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "\"Yoo raajiin",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.6",
                "verseOrgIds": [
                  "NUM.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "gidduu keessan jiraate,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "ani mulʼata keessa isatti of nan mulʼisa;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "abjuudhaanis isatti nan dubbadha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu garbichi koo Museen akkana miti;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:7"
      },
      "items": [
        {
          "text": "inni mana koo hunda keessatti amanamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani utuu dhoksaadhaan hin taʼin,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "ifaan ifatti isatti nan dubbadha;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "inni bifa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.8",
                "verseOrgIds": [
                  "NUM.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni arga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "Yoos isin maaliif",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "garbicha koo Museedhaan mormuudhaan dubbachuu hin sodaanne ree?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aariin",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.9",
                "verseOrgIds": [
                  "NUM.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "isaan irratti bobaʼe; innis isaan dhiisee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu duumessi sun dunkaana gubbaadhaa ol kaʼetti kunoo, Miiriyaam lamxooftee akkuma cabbii addaattee turte. Aroonis gara isheetti garagalee akka isheen lamxii qabdu arge;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.10",
            "verseOrgIds": [
              "NUM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis Museedhaan akkana jedhe; \"Maaloo yaa gooftaa ko, cubbuu nu gowwummaadhaan hojjenne sana nutti hin lakkaaʼin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.11",
            "verseOrgIds": [
              "NUM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka gatata foon isaa gariin nyaatamee gadameessa haadha isaa keessaa baʼu tokkoo ishee hin godhin.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.12",
            "verseOrgIds": [
              "NUM.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.13",
                "verseOrgIds": [
                  "NUM.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": "booʼee, \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.13",
                "verseOrgIds": [
                  "NUM.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", maaloo ishee fayyisi!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.12.14",
                "verseOrgIds": [
                  "NUM.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee Museedhaaf deebii kenne; \"Utuu abbaan ishee fuula isheetti tufee silaa isheen bultii torba salphina keessa turti mitii ree? Isheen bultii torba qubataan ala haa turtu; ergasii deebitee dhufuu dandeessi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.14",
            "verseOrgIds": [
              "NUM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miiriyaam bultii torba qubataan ala turte; sabni sunis hamma isheen deebitutti deemsa itti hin fufne.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii sabni sun Haxerootii kaʼee Gammoojjii Phaaraan keessa qubate.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.16",
            "verseOrgIds": [
              "NUM.12.16"
            ]
          }
        }
      ]
    }
  ],
