          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haaluma kanaan nyaata aarsaa ibiddaan dhiʼeeffamuu kan fooliin isaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
