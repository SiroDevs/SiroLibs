    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bultii kudha afuraffaa jiʼa jalqabaatti Faasiikaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.16",
                "verseOrgIds": [
                  "NUM.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ayyaaneffamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii kudha shanaffaa jiʼa kanaatti ayyaanatu jira; isinis guyyaa torba Maxinoo nyaattu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa jalqabaatti wal gaʼii qulqulluu qabaadhaa; hojii idilees hin hojjetinaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiboota loonii lama, korbeessa hoolaa tokko, xobbaallaawwan hoolaa torba kanneen umuriin isaanii waggaa tokko tokko taʼee fi kanneen hundi isaanii hirʼina hin qabne aarsaa gubamu godhaatii ibiddaan",
