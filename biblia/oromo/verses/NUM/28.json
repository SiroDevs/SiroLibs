              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanas aarsaa gubamu kan yeroo hunda ganama ganama dhiʼeeffamutti dabalaatii dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
