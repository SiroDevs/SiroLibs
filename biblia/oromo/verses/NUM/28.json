    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Guyyuma Guyyaan Dhiʼeeffamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.1",
                "verseOrgIds": [
                  "NUM.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.1",
            "verseOrgIds": [
              "NUM.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ajaja kana Israaʼelootaaf kenni; akkanas jedhiin: 'Aarsaa nyaataa kan ibiddaan anaaf dhiʼeeffamu kan fooliin isaa natti tolu sana yeroo murtaaʼetti naa dhiʼeessuu keessan mirkaneeffadhaa.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.2",
            "verseOrgIds": [
              "NUM.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkana isaaniin jedhi; 'Aarsaan isin ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.3",
                "verseOrgIds": [
                  "NUM.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessitan isa kana: xobbaallaawwan hoolaa lama kanneen umuriin isaanii waggaa tokko tokkootii fi kanneen hirʼina hin qabne aarsaa gubamu kan yeroo hunda guyyuma guyyaan dhiʼeeffamu godhaa dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xobbaallaa hoolaa tokko ganama, kaan immoo galgala dhiʼeessi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.4",
            "verseOrgIds": [
              "NUM.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana wajjinis kennaa midhaanii kan daakuu bullaaʼaa iifii",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "text": "tokko irraa harka kudhan keessaa harki tokko zayitii ejersaa kan cuunfamee iinii",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "text": "tokko harka afur keessaa harka tokkoon sukkuumame dhiʼeessi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis aarsaa yeroo hunda gubamu kan fooliin isaa toluu fi kan ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.6",
                "verseOrgIds": [
                  "NUM.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamu kan Tulluu Siinaa irratti ajajamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhibaayyuun tokkoo tokkoo xobbaallaa hoolaa wajjin dhiʼeeffamus dhugaatii cimaa iinii tokko irraa harka afur keessaa harka tokko haa taʼu; dhibaayyuu sanas iddoo qulqulluu keessatti",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.7",
                "verseOrgIds": [
                  "NUM.28.7"
                ]
              }
            }
          ]
        },
        {
          "text": "dhangalaasi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xobbaallaa hoolaa kaan immoo akkuma kennaa midhaaniitii fi kan dhibaayyuu wajjin ganama dhiʼeessite sanaa galgalas dhiʼeessi. Kunis aarsaa ibiddaan dhiʼeeffamu kan fooliin isaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.8",
                "verseOrgIds": [
                  "NUM.28.8"
                ]
              }
            }
          ]
        },
        {
          "text": "toluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Guyyaa Sanbataa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Guyyaa Sanbataa xobbaallaawwan hoolaa lama kanneen umuriin isaanii waggaa tokko taʼee fi hirʼina hin qabne aarsaa dhibaayyuutii fi kennaa midhaanii akkasumas kennaa midhaanii kan daakuu bullaaʼaa iifii tokko irraa harka kudhan keessaa harki lama zayitiidhaan sukkuumame wajjin dhiʼeessi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis aarsaa gubamu kan aarsaa yeroo hunda gubamuu fi dhibaayyuu isaatti dabalamee Sanbata Sanbataan dhiʼeeffamuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Jiʼa Jiʼaan Dhiʼeeffamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Jalqaba jiʼoota keessanii hundatti jiboota loonii lama, korbeessa hoolaa tokko, xobbaallaawwan hoolaa torba kanneen umuriin isaanii waggaa tokko taʼee fi kanneen hirʼina hin qabne aarsaa gubamu godhaatii",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.11",
                "verseOrgIds": [
                  "NUM.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoo tokkoo jiboota loonii wajjin kennaa midhaanii kan daakuu bullaaʼaa iifii tokkoo irraa harka kudhan keessaa harki sadii zayitiidhaan sukkuumame, korbeessa hoolaa sana wajjinis kennaa midhaanii kan daakuu bullaaʼaa iifii tokkoo irraa harka kudhan keessaa harki lama zayitiidhaan sukkuumame dhiʼeeffamuu qaba;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokkoo tokkoo xobbaallaa hoolaa wajjinis kennaan midhaanii kan daakuu bullaaʼaa iifii tokkoo irraa harka kudhan keessaa harki tokko zayitiidhaan sukkuumame dhiʼeeffamuu qaba. Kunis aarsaa gubamu kan ibiddaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.13",
                "verseOrgIds": [
                  "NUM.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffamuu fi fooliin isaa toluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoo tokkoo dibicha loonii wajjin dhibaayyuu daadhii wayinii iinii tokkoo irraa walakkaa isaa, tokkoo tokkoo xobbaallaa hoolaa wajjin iinii tokko irraa harka sadii keessaa harka tokko, korbeessa hoolaa sana wajjinis iinii tokko irraa harka afur keessaa harki tokko haa dhiʼeeffamu. Kunis aarsaa gubamu kan waggaa keessatti baatii haaraatti dhiʼeeffamuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas aarsaa cubbuutiif korbeessa reʼee tokko",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "NUM.28.15",
                "verseOrgIds": [
                  "NUM.28.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessaa; innis aarsaa yeroo hunda gubamuu fi dhibaayyuu isaatti dabalamee dhiʼeeffama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Faasiikaa",
          "type": "text"
        }
      ]
    },
    {
