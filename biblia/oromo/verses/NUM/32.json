  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "NUM 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gosoota Yordaanos Gamaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Ruubeenii fi ilmaan Gaad warri loonii fi bushaayee hedduu qaban akka biyyi Yaʼizeerii fi biyyi Giliʼaad horii isaaniitiif tolu argan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.1",
            "verseOrgIds": [
              "NUM.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan gara Musee, gara Eleʼaazaar lubichaatii fi gara hooggantoota waldaa dhufanii akkana jedhan;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.2",
            "verseOrgIds": [
              "NUM.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Axaaroti, Diiboon, Yaʼizeer, Niimraa, Heshboon, Eleʼaalee, Sebaamaa, Neboo fi Beʼoon,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.3",
            "verseOrgIds": [
              "NUM.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "biyyi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.4",
            "verseOrgIds": [
              "NUM.32.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.4",
                "verseOrgIds": [
                  "NUM.32.4"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula waldaa Israaʼel duratti rukute sun horiif tolaa dha; nu tajaajiltoonni kees horii qabna.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.4",
            "verseOrgIds": [
              "NUM.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo nu fuula kee duratti fudhatama argannee jiraanne biyyi kun nu tajaajiltoota keetiif handhuuraa taʼee haa kennamu. Akka nu Yordaanos gama ceenus hin godhin.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.5",
            "verseOrgIds": [
              "NUM.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis ilmaan Gaadii fi ilmaan Ruubeeniin akkana jedhe; \"Obboloonni keessan duula dhaqanii isin immoo as teessuu?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.6",
            "verseOrgIds": [
              "NUM.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin maaliif akka Israaʼeloonni biyya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.7",
            "verseOrgIds": [
              "NUM.32.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.7",
                "verseOrgIds": [
                  "NUM.32.7"
                ]
              }
            }
          ]
        },
        {
          "text": "isaanii kenne sanatti ceʼanii hin galleef abdii isaan kutachiiftuu?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.7",
            "verseOrgIds": [
              "NUM.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun waanuma abbootiin keessan gaafa ani akka isaan biyyattii ilaalaniif jedhee Qaadesh Barnee irraa isaan erge sana hojjetanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.8",
            "verseOrgIds": [
              "NUM.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis erga gara Sulula Eshkool dhaqanii biyya sana arganii booddee akka Israaʼeloonni biyya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.9",
            "verseOrgIds": [
              "NUM.32.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.9",
                "verseOrgIds": [
                  "NUM.32.9"
                ]
              }
            }
          ]
        },
        {
          "text": "isaaniif kennetti hin galleef abdii isaan kutachiisan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.9",
            "verseOrgIds": [
              "NUM.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.10",
                "verseOrgIds": [
                  "NUM.32.10"
                ]
              }
            }
          ]
        },
        {
          "text": "guyyuma sana bobaʼe; innis akkana jedhee kakate;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.10",
            "verseOrgIds": [
              "NUM.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Waan isaan garaa guutuudhaan na faana deemuu didaniif, namoota waggaa digdamaatii fi hammasii olii kanneen biyya Gibxiitii baʼanii dhufan keessaa namni tokko iyyuu biyya ani Abrahaamiif, Yisihaaqii fi Yaaqoobiif waadaa gale sana hin argu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.11",
            "verseOrgIds": [
              "NUM.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaaleb ilma Yefunee kan gosa Qeneezii fi Iyyaasuu ilma Nuuni malee namni tokko iyyuu hin argu; isaan lamaan garaa guutuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.12",
            "verseOrgIds": [
              "NUM.32.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.12",
                "verseOrgIds": [
                  "NUM.32.12"
                ]
              }
            }
          ]
        },
        {
          "text": "duukaa buʼaniiruutii.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.12",
            "verseOrgIds": [
              "NUM.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.13",
            "verseOrgIds": [
              "NUM.32.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.13",
                "verseOrgIds": [
                  "NUM.32.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼel irratti bobaʼe; innis hamma dhaloonni fuula isaa duratti waan hamaa hojjete sun hundi dhumutti akka isaan waggaa afurtama gammoojjii keessa jooran godhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.13",
            "verseOrgIds": [
              "NUM.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa sanyii cubbamootaa nana, isin kunoo dheekkamsa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.14",
            "verseOrgIds": [
              "NUM.32.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.14",
                "verseOrgIds": [
                  "NUM.32.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Israaʼel irratti bobaʼe sana ittuma caalchisuuf iddoo abbootii keessanii buutaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.14",
            "verseOrgIds": [
              "NUM.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isin isa duukaa buʼuu irraa garagaltan inni ammas gammoojjii kana keessatti saba kana hunda ni dhiisa; isinis uummata kana ni balleessitu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.15",
            "verseOrgIds": [
              "NUM.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan gara isaa dhufanii akkana jedhaniin; \"Nu asitti horii keenyaaf dallaa, dubartootaa fi ijoollee keenyaaf immoo magaalaawwan ijaarra.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.16",
            "verseOrgIds": [
              "NUM.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu garuu hamma lafa isaaniitiin isaan geenyutti hidhannee Israaʼel dura deemuuf qophaaʼoo dha. Yeroo kanatti akka jiraattoonni biyyattii isaan hin tuqneef dubartoonnii fi ijoolleen keenya magaalaawwan dallaa jabaa qaban keessa haa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.17",
            "verseOrgIds": [
              "NUM.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma tokkoon tokkoon Israaʼelootaa dhaala ofii isaanii argatanitti nu mana keenyatti hin deebinu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.18",
            "verseOrgIds": [
              "NUM.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii dhaalli keenya laga Yordaanos irraa gara baʼaatti nuuf kennameef nu Yordaanos irraa gama kaaniin isaan wajjin waan dhaallu hin qabnu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.19",
            "verseOrgIds": [
              "NUM.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis akkana isaaniin jedhe; \"Yoo isin waan kana gootan, yoo isin fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.20",
            "verseOrgIds": [
              "NUM.32.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.20",
                "verseOrgIds": [
                  "NUM.32.20"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti hidhattanii duulaaf kaatan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.20",
            "verseOrgIds": [
              "NUM.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo isin hundinuu hamma inni diinota ofii isaa fuula ofii isaa duraa ariʼee baasutti hidhattanii fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.21",
            "verseOrgIds": [
              "NUM.32.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.21",
                "verseOrgIds": [
                  "NUM.32.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dura Yordaanosin ceetan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.21",
            "verseOrgIds": [
              "NUM.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo biyyattiin fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.22",
                "verseOrgIds": [
                  "NUM.32.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti moʼatamtutti isin itti gaafatama",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.22",
                "verseOrgIds": [
                  "NUM.32.22"
                ]
              }
            }
          ]
        },
        {
          "text": "fi saba Israaʼeliif qabdan irraa ni bilisoomtu. Biyyi sunis fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.22",
                "verseOrgIds": [
                  "NUM.32.22"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti dhaala keessan taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.22",
            "verseOrgIds": [
              "NUM.32.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu isin yoo waan kana gochuu baattan, kunoo",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.23",
                "verseOrgIds": [
                  "NUM.32.23"
                ]
              }
            }
          ]
        },
        {
          "text": "cubbuu hojjechuu keessan; akka cubbuun keessan isin argatu illee beekkadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.23",
            "verseOrgIds": [
              "NUM.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartootaa fi ijoollee keessaniif magaalaawwan, bushaayee keessaniif immoo dallaa ijaaraa; isin garuu waan waadaa galtan sana guutaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.24",
            "verseOrgIds": [
              "NUM.32.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Gaadii fi ilmaan Ruubeen Museedhaan akkana jedhan; \"Nu garboonni kee akkuma gooftaan keenya nu ajaju goona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.25",
            "verseOrgIds": [
              "NUM.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen keenyaa fi niitonni keenya, bushaayeen keenyaa fi loon keenya, asuma magaalaawwan Giliʼaaditti haa hafan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.26",
            "verseOrgIds": [
              "NUM.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu garboonni kee garuu tokkoon tokkoon keenya akkuma gooftaan keenya jedhe sana duulaaf qophoofnee fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.27",
                "verseOrgIds": [
                  "NUM.32.27"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti duuluuf ni ceena.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.27",
            "verseOrgIds": [
              "NUM.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Museen waaʼee isaanii Eleʼaazaar lubichaaf, Iyyaasuu ilma Nuunitii fi abbootii maatii gosoota Israaʼeliif ajaja kenne.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.28",
            "verseOrgIds": [
              "NUM.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana isaaniin jedhe; \"Yoo ilmaan Gaadii fi ilmaan Ruubeen, namni waraanaaf hidhate hundi fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.29",
                "verseOrgIds": [
                  "NUM.32.29"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti isin wajjin Yordaanos ceʼe, yommuu biyyattiin isin harka galtutti biyya Giliʼaad sana kennaafii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.29",
            "verseOrgIds": [
              "NUM.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu isaan yoo duulaaf hidhatanii isin wajjin ceʼuu baatan, Kanaʼaan keessatti isin wajjin lafa haa argatan.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.30",
            "verseOrgIds": [
              "NUM.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Gaadii fi ilmaan Ruubeenis akkana jedhanii deebii kennan; \"Nu garboonni kee waan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.31",
                "verseOrgIds": [
                  "NUM.32.31"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe ni goona.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu miʼa lolaa hidhannee fuula",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.32.32",
                "verseOrgIds": [
                  "NUM.32.32"
                ]
              }
            }
          ]
        },
        {
          "text": "dura ceenee Kanaʼaan seenna; garuu qabeenyi nu dhaallu Yordaanosiin gamatti nuuf haa hafu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis mootummaa Sihoon mootii Amoorotaa fi mootummaa Oogi mootii Baashaan jechuunis biyya sana guutuu magaalaawwan isaaniitii fi bulchiinsa naannoo isaanii jiru sana ilmaan Gaadiitiif, ilmaan Ruubeeniitii fi walakkaa gosa Minaasee ilma Yoosefiif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Gaadis magaalaawwan Diiboon, Axaaroti, Aroʼeer,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atroot Shoofaan, Yaʼizeer, Yogbihaa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beet Niimraa fi Beet haaraan magaalaawwan jajjaboo godhanii ijaaran. Bushaayee isaaniitiifis dallaa ijaarratan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Ruubeenis magaalaawwan Heshboon, Eleʼaaleenii fi Kiriyaataayim,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas Neboo fi Baʼaal Meʼoon jechuunis magaalaawwan maqaan isaanii geeddaramee fi Sibimaa deebisanii ijaaran. Isaanis magaalaawwan deebisanii ijaaran sanaaf maqaa baasan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen Maakiir ilma Minaasees gara Giliʼaad dhaqanii biyyattii qabatanii Amoorota achi turan ariʼanii baasan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis Giliʼaadin ijoollee Maakiir sanyii Minaaseetiif kenne; isaanis achi qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaʼiir ilmi Minaasees dhaqee gandoota isaanii fudhatee gandoota Yaaʼiirootaa jedhee moggaase.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noobaan immoo Qeenaatii fi gandoota naannoo isaa jiran qabatee Noobaa jedhee maqaa ofii isaatiin waame.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
