          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen akkuma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.27",
                "verseOrgIds": [
                  "NUM.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajaje sana godhe: Isaanis utuma waldaan Israaʼel guutuun ilaaluu Tulluu Hooritti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis uffata Aroon irraa baasee ilma isaa Eleʼaazaaritti uffise. Aroonis achuma tulluu sana gubbaatti duʼe. Musee fi Eleʼaazaaris tulluu sana irraa gad buʼan;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.28",
            "verseOrgIds": [
              "NUM.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "yommuu waldaan Israaʼel hundi akka Aroon duʼe dhagaʼetti manni Israaʼel guutuun bultii soddoma booʼeef.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.29",
            "verseOrgIds": [
              "NUM.20.29"
            ]
          }
        }
      ]
