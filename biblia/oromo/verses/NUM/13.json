          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gosa Yisaakor keessaa Yigiʼaal ilma Yoosef;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.7",
            "verseOrgIds": [
              "NUM.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
