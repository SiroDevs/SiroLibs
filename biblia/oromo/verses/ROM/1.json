  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ROM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ergaa Phaawulos Warra Roomaatti Erge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos tajaajilaa Kiristoos Yesuus, kan ergamaa taʼuuf waamamee fi akka wangeela Waaqaa lallabuuf addaan baafame irraa:",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangeelli kunis kan Waaqni duraan dursee karaa raajota isaatiin Katabbiiwwan Qulqulluu keessatti waadaa galee dha.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangeelichis waaʼee ilma isaa kan akka namummaatti sanyii Daawit irraa dhalatee,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka Hafuura qulqullummaatti immoo warra duʼan keessaa kaʼuu isaatiin Ilma Waaqaa humna qabeessa taʼuun isaa labsamee dha; innis Gooftaa keenya Yesuus Kiristoos.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus karaa isaatiin, maqaa isaatiif jecha ormoota hunda keessaa akka gara ajajamuu amantii irraa dhufuutti namoota waamnuuf ayyaanaa fi ergamtummaa arganneerra.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis warra akka kan Yesuus Kiristoos taʼaniif waamaman sana keessa jirtu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra Waaqaan jaallatamtanii qulqulloota taʼuuf waamamtan kanneen Roomaa jirtan hundaaf:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "ROM 1:7"
      },
      "items": [
        {
          "text": "Abbaa keenya Waaqaa fi Yesuus Kiristoos Gooftaa irraa ayyaannii fi nagaan isiniif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Roomaa Daawwachuuf Hawwuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii amantiin keessan guutummaa addunyaa irratti odeeffamaa jiruuf, ani duraan dursee waaʼee hunda keessaniitiif karaa Yesuus Kiristoosiin Waaqa koo nan galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani kadhannaa koo keessatti utuu wal irraa hin kutin isin yaadadhu Waaqni ani wangeela Ilma isaa lallabuudhaan hafuura kootiin isa tajaajilu sun dhuga baatuu koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani akka ammas dhuma irratti gara keessan dhufuuf fedhii Waaqaatiin karaan naa banamu nan kadhadha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isin jabaattaniifis kennaa hafuuraa isinii hiruuf isin arguu baayʼee nan hawwa;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka isinii fi ani amantii keenyaan wal jajjabeessinuuf.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota ko, ani akkuma Namoota Ormaa kaan keessatti ija qabaadhe sana isin keessattis akkasuma akkan qabaadhuuf yeroo baayʼee gara keessan dhufuu yaadaa turuu ko, garuu hamma ammaatti dhowwamuu koo akka isin beekuu dhabdan hin barbaadu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani namoota Giriikii fi warra nama Giriik hin taʼiniif, beektotaa fi wallaaltotaaf gatii of irraa nan qaba.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin ani isin warra Roomaa jirtanittis wangeela lallabuuf akka malee hawwuuf kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani wangeelatti hin qaanaʼu; kunis sababii wangeelli humna Waaqaa kan warra amanan hunda fayyisu taʼeef; innis jalqabatti Yihuudootaaf, itti aansee immoo Giriikotaaf.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangeela keessatti qajeelummaan Waaqaa amantii irraa gara amantiitti mulʼateeraatii; kunis akkuma, \"Namni qajeelaan amantiidhaan jiraata\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "text": "jedhamee barreeffamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dheekkamsa Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheekkamsi Waaqaa, Waaqa malee jiraachuu fi hammina namootaa hunda irratti samii irraa ni mulʼata; namoonni kunneen hammina isaaniitiin dhugaa ukkaamsu;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis sababii wanni waaʼee Waaqaa beekamuu malu isaaniif ifa taʼeef; Waaqni isaaniif ibseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalli Waaqaa kan hin mulʼanne jechuunis humni isaa kan bara baraatii fi waaqummaan isaa uumama addunyaatii jalqabee wantoota uumaman irraa ifaan ifatti mulʼataatii; kanaafuu isaan waan itti qabatan hin qaban.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yoo Waaqa beekan illee akka waaqummaa isaatti ulfina hin kennineef; galatas hin galchineef. Garuu yaadni isaanii waan faayidaa hin qabne taʼe; qalbiin isaanii kan hin hubannes ni dukkanaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yoo ogeeyyii ofiin jedhan iyyuu gowwoota taʼan;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ulfina Waaqa hin duunees nama duʼutti, simbiratti, horii miilla afuriitti akkasumas uumamawwan lafa irra looʼanitti fakkeessuudhaan geeddaran.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Waaqni akka isaan dhagna walii isaanii salphisaniif hawwii garaa isaanii hamaadhaan dabarsee xuraaʼummaatti isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dhugaa Waaqaa sobatti geeddaran; Uumaa dhiisanii uumama waaqeffatan; ni tajaajilanis. Uumaan bara baraan eebbifamaa dha. Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf Waaqni dabarsee hawwii jibbisiisaatti isaan kenne. Dubartoonni isaaniis karaa ittiin fedhii fooniitiif dhiira wajjin wal bira gaʼan isa uumamaan kennameef dhiisanii, gara isa uumamaan isaaniif hin kennaminitti geeddaran.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri dhiiraas akkasuma karaa ittiin fedhii fooniitiif dubartoota wajjin wal bira gaʼan isa uumamaan kennameef dhiisanii kajeellaa walii isaaniitiin gubatan. Warri dhiiraa, dhiira biraa wajjin gocha jibbisiisaa raawwatan; dogoggora isaanii kanaafis adaba isaaniif malu ofuma isaaniitiin fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii isaan Waaqa beekuu akka waan faayidaa hin qabneetti fudhataniif, Waaqni immoo akka isaan waan hojjetamuu hin malle hojjetaniif qalbii faayidaa hin qabnetti dabarsee isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis hammina gosa hundaatiin, jalʼinaan, sassattummaan, amala baduun, hinaaffaan, nama ajjeesuun, wal loluun, gowwoomsuu fi dabaan guutaman. Isaan hamattoota,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
