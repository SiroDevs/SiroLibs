      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:7"
      },
      "items": [
        {
          "text": "warra Israaʼel keessaa bebeekamoo taʼaniin marfamteerti.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
