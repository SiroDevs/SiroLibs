      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:6"
      },
      "items": [
        {
          "text": "akkuma utubaa aaraa",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.6",
            "verseOrgIds": [
              "SNG.3.6"
            ]
          }
        }
      ]
