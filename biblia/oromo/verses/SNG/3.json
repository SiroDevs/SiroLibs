      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:8"
      },
      "items": [
        {
          "text": "luqqeettuutti hidhatanii lola halkaniitiif qophaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.8",
            "verseOrgIds": [
              "SNG.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
