          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo! Siree Solomoon kan loltoota jaatama",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.7",
            "verseOrgIds": [
              "SNG.3.7"
            ]
          }
        }
      ]
    },
