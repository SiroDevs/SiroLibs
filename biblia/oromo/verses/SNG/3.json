            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani halkan guutuu siree koo irra ciisee",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "nama garaan koo jaallatu sana nan barbaade;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:1"
      },
      "items": [
        {
          "text": "ani isa nan barbaade; garuu isa hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.1",
            "verseOrgIds": [
              "SNG.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amma kaʼeen magaalaa keessa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "daandiiwwanii fi oobdiiwwan irra nan deema;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "nama garaan koo jaallatu sana nan barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:2"
      },
      "items": [
        {
          "text": "Kanaafuu ani isa nan barbaade;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.2",
            "verseOrgIds": [
              "SNG.3.2"
            ]
          }
        }
