      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:5"
      },
      "items": [
        {
          "text": "jaalala hin tuttuqinaa yookaan hin dadammaqsinaa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.5",
            "verseOrgIds": [
              "SNG.3.5"
            ]
          }
        }
      ]
    },
