          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon mootichi ofii isaatii gaarii tolfate;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:9"
      },
      "items": [
        {
          "text": "innis muka Libaanoon irraa tolfate.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.9",
            "verseOrgIds": [
              "SNG.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni utubaa isaa meetiidhaan hojjete;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "jala isaa garuu warqeedhaan hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "Teessoon isaa kirrii diimaa dhiilgeedhaan hojjetame;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:10"
      },
      "items": [
        {
          "text": "keessi isaas jaalala intallan Yerusaalemiitiin bareechamee hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.10",
            "verseOrgIds": [
              "SNG.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa intallan Xiyoon gad baʼaatii Solomoon Mooticha ilaalaa;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 3:11"
      },
      "items": [
        {
          "text": "inni gonfoo haati isaa gaafa fuudha isaa,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.3.11",
            "verseOrgIds": [
              "SNG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 3:11"
      },
      "items": [
        {
