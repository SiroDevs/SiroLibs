          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harki isaa bitaa mataa koo jala jira;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        }
