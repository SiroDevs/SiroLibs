    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "foddaa keessaan ilaalaa",
          "type": "text",
          "attrs": {
