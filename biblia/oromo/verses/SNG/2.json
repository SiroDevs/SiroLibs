    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "Ani gaaddisa isaa jala taaʼuu nan jaalladha;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        }
