      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:13"
      },
      "items": [
        {
          "text": "wayiniin daraares urgaa kenneera.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
