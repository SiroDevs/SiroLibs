      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:4"
      },
      "items": [
        {
          "text": "akeekni inni naaf qabu jaalala.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        }
      ]
    },
    {
