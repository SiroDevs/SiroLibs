      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "waqtiin sirbaa gaʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "wacni gugees",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:12"
      },
      "items": [
        {
          "text": "biyya keenya keessatti dhagaʼamaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        }
      ]
    },
    {
