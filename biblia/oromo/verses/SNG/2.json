          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo! Ganni darbeera;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        }
      ]
    },
