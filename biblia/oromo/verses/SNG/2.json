      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:3"
      },
      "items": [
        {
          "text": "akkuma muka hudhaa kan mukkeen bosonaa keessa jiruu ti.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
