      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 2:9"
      },
      "items": [
        {
          "text": "qaawwa keessaanis mimilʼachaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
