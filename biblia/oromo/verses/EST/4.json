        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mordekaayi Gargaarsa Asteer Gaafate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayi yeroo waan hojjetame sana hunda beeketti uffata isaa tarsaasee, wayyaa gaddaa uffatee, daaraa ofitti firfirsee, sagalee guddaadhaan wawwaachaa hiqqifatees booʼaa gara walakkaa magaalaatti gad baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu sababii namni uffata gaddaa uffate tokko iyyuu akka ol seenu hin eeyyamamneef hamma karra mootichaa qofatti deeme.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutaalee biyyaa hunda iddoo ajajnii fi labsiin mootichaa gaʼetti gaddi guddaan, soomni booʼichii fi wawwaannaan Yihuudoota gidduu ture; baayʼeen isaanii uffata gaddaa uffatanii daaraa keessa ciisan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo dubartoonni tajaajiltoonni Asteerii fi xuʼaashiiwwan dhufanii waaʼee Mordekaayi isheetti himanitti Asteer akka malee gaddite. Isheenis qooda uffata gaddaa wayyaa inni uffatu ergiteef; inni garuu isaan harkaa fudhachuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Asteer xuʼaashiiwwan mootichaa keessaa Hataak isa ishee tajaajiluuf ramadame sana waamtee akka inni Mordekaayi bira deemee, rakkoo uumamee fi rakkoon sun maaliif akka uumame beekuuf ajajje.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Hataak gara oobdii magaalattii kan karra mootichaa duraa sanaatti Mordekaayiitti baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mordekaayi waan isa irra gaʼe hunda, maallaqa Haamaan Yihuudoota balleessuudhaaf mankuusa qabeenya mootichaatti galchuuf waadaa gale isatti hima.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Mordekaayi akka inni Asteeritti argisiisee isheedhaaf ibsuuf garagalcha barreeffama labsii kan isaan balleessuudhaaf Suusaa keessatti labsame sana isatti kenne; akka inni akka isheen mooticha bira dhaqxee itti boossee saba isheetiif araara kadhattu itti himuufis isa ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hataak deebiʼee waan Mordekaayi jedhe Asteeritti hime.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asteer immoo akka inni akkana jedhee Mordekaayiitti himu isa ajajje;",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qondaaltonni mootichaa hundii fi sabni kutaalee biyyaa mootichaa akka mootichi yoo namni kam iyyuu dhiiras taʼu dubartiin utuu hin waamamin kutaa manaa isa gara keessaa ol seenee fuula mootichaa duratti dhiʼaate akka mootichi seera tokko qofa qabu jechuunis akka ajjeefamu ni beeku. Namni tokko yoo mootichi bokkuu mootummaa kan warqee sana diriirseef qofa ajjeefamuu oola. Ani mataan koo iyyuu guyyoota soddomman kana keessaa akkan fuula mootichaa duratti dhiʼaadhuuf waamamee hin beeku.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu dubbiin Asteer Mordekaayiitti himametti,",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni akkana jedhee deebii kana erge: \"Ati sababii mana mootichaa keessa jirtuuf Yihuudoota hunda keessaa waan ati qofti baraaramtu hin seʼin.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati yeroo kanatti calʼifte gargaarsaa fi furamni Yihuudootaa iddoo biraatii ni dhufa; atii fi manni abbaa keetii garuu ni baddu. Maaltu beeka? Ati taayitaa mootummaa qabachuun kee yeroo akkanaatiif taʼaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Asteer akkana jettee deebii kana Mordekaayiitti ergite:",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhaqiitii Yihuudoota Suusaa keessa jiran hunda walitti qabiitii naa soomaa. Bultii sadii, guyyaa yookaan halkan illee homaa hin nyaatinaa yookaan homaa hin dhuginaa. Anii fi dubartoonni tajaajiltoonni koo iyyuu akkuma keessan ni soomna. Yoo akkas taʼe wanni kun seeraan ala taʼu illee ani gara mootichaa nan dhaqa. Ani yoon bades nan bada.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Mordekaayi deemee waan Asteer isa ajajje hunda hojii irra oolche.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
    }
  ],
