  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EST 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulfinni Waashtiin Mootittiin Taayitaa Irraa Buute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni bara mootummaa Ahashweroos keessa taʼe kanaa dha: Ahashweroos kun Hindiidhaa jalqabee hamma Itoophiyaatti kutaalee biyyaa 127 bulchaa ture;",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo sanatti Ahashweroos Mootichi, Suusaa magaalaa guddoo sana keessa teessoo mootummaa isaa irra taaʼee bulchaa ture;",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis bara mootummaa isaa keessaa waggaa sadaffaatti namoota isaa bebeekamoo fi qondaaltota isaa hundumaaf cidha guddaa tokko qopheesse. Hooggantoonni waraana Faaresii fi Meedee, ilmaan moototaa fi namoonni bebeekamoon kutaa biyyaa achi turan.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bultii 180 guutuu qabeenya mootummaa isaa guddaa, miidhagummaa fi ulfina jabina isaa gad baasee argisiisaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo guyyoonni kunneen darbanitti mootichi saba gamoo Suusaa keessa jiraatu xinnaa fi guddaa hundaaf oobdii iddoo biqiltuu masaraa mootii keessatti cidha guyyaa torba turu qopheesse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoon biqiltuu sunis golgaa quncee talbaa irraa hojjetame adii fi cuquliisa, kirrii adii fi diimaa dhiilgeedhaan qubeelaa meetii kan utubaawwan dhagaa akka cabbiitti hidhame tokko qaba ture. Sireewwan dinkiin kanneen warqee fi meetii irraa hojjetamanis lafa dhagaa diimaadhaan, dhagaa akka cabbiitiin, lula bifa adda addaa qabuu fi dhagaawwan gati jabeeyyiidhaan miidhagfamee hafame irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugaatiinis xoofoo warqeetiin namaaf dhiʼeeffame. Tokkoon tokkoon xoofoo sanaas gosa adda addaa ture; daadhiin wayiniis akkuma arjummaa mootichaatti akka malee baayʼee ture.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka tokkoon tokkoon keessummaa akkuma fedhetti dhuguuf mootichi eeyyamee ture; akka tokkoo tokkoo namaatiif waan inni barbaade dhiʼeessaniifis mootichi warra daadhii wayinii dhiʼeessan hunda ajajee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waashtiin Mootittiinis masaraa mootummaa Ahashweroos Mootichaa keessatti dubartootaaf cidha qopheessite.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa torbaffaatti Ahashweroos Mootichi yeroo daadhii wayinii dhugee gammadetti xuʼaashiiwwan isa tajaajilan torban jechuunis Mihuumaan, Biztaaʼaa, Harboonaa, Bigtaaʼa, Abaagtaa, Zeetaarinii fi Karkas",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka isaan Waashtiin mootittii akka isheen namootaa fi qondaaltotatti bareedina ishee argisiiftuuf gonfoo mootummaa isheetti kaaʼanii fuula isaa duratti dhiʼeessan ajaje; isheen akka malee bareedduu turteetii.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo ergamoonni sun ergaa mootichaa itti himanitti Waashtiin Mootittiin dhufuu didde. Kana irratti mootichi akka malee dheekkamee aariidhaan gubate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii waan seeraatii fi murtii qajeelaa irratti hayyootaan mariʼachuun bartee mootichaa taʼeef inni namoota ogeeyyii waan baraa beekan",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanneen mootichatti aananiin mariʼate; isaanis Karshenaa, Sheetaar, Adimaataa, Tarshiish, Meres, Marseenaa fi Memuukaa qondaaltota Faaresii fi Meedee torban mootichaan walitti dhiʼeenya qaban kanneen mootummaa sana keessatti iddoo ol aanaa qabanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Akka seeraatti wanti nu Waashtiin mootittii gochuu qabnu maali? Isheen ajaja Ahashweroos Mootichaa kan xuʼaashiiwwan isheetti geessan sanaaf hin ajajamneetii\" jedhee isaan gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memuukaan akkana jedhee fuula mootichaatii fi fuula namoota bebeekamoo duratti deebii kenne; \"Waashtiin mootittiin Mooticha qofatti utuu hin taʼin qondaaltota hundattii fi namoota kutaalee biyyaa Ahashweroos Mootichaa hundatti balleessaa hojjette.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni mootittiin goote kun dubartii hunda biratti beekamee isaan, 'Ahashweroos Mootichi akka Waashtiin Mootittiin fuula isaa duratti dhiʼeeffamtu ajajee ture; isheen garuu dhaquu didde' jedhanii dhirsoota isaanii tuffatuutii.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyuma harʼaa kana iyyuu dubartoonni Faaresii fi Meedee bebeekamoon warri gocha mootittii kana dhagaʼan qondaaltota mootichaa hundaaf waanuma akkasii deebisu. Tuffii fi lola dhuma hin qabnetu uumama.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu yoo wanni kun mooticha gammachiise akka Waashtiin lammata fuula Ahashweroos Mootichaa duratti hin dhiʼeeffamneef inni labsii mootummaa haa labsu; labsiin sunis seera Faaresii fi Meedee kan diigamuu hin dandeenye sana keessatti haa barreeffamu. Mootichi amma illee sadarkaa ulfinaa kan isheen mootummaa keessatti qabdu dubartii biraa kan ishee caaltuuf haa kennu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoos yommuu labsiin mootichaa guutummaa mootummaa isaa keessatti labsamutti dubartoonni hundinuu xinnoo fi guddoon dhirsoota isaaniitiif ulfina kennu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichii fi qondaaltonni isaa gorsa kanatti ni gammadan; kanaafuu mootichi yaada Memuukaan dhiʼeesse sana hojii irra oolche.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis biyyoota mootummaa hundatti, tokkoo tokkoo kutaalee biyyaatiif qubeedhuma isaaniitiin, akkasumas tokkoo tokkoo sabaatiif afaanuma isaaniitiin xalayoota ergee akka dhiirri hundi bulchaa mana ofii isaa taʼu afaan gosa hundaatiin labse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
              "EST.1.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EST.2",
    "number": "2",
