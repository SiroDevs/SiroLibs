            "number": "20",
            "style": "v",
            "sid": "2KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni isaa isatti malatanii karaa Siilaatti gad buʼu irratti Beet Miilootti isa ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni isa ajjeesanis Yozaakaar ilma Shimeʼaatii fi Yehoozaabaad ilma Shoomeer turan. Innis duʼee abbootii isaa biratti Magaalaa Daawit keessatti awwaalame. Amasiyaa ilmi isaa iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.21",
