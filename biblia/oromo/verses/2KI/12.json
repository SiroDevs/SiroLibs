              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Yooʼaash keessa hojjetaman kanneen biraatii fi wanni inni hojjete hundinuu kitaaba seenaa mootota Yihuudaa keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
