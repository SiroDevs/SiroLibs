    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Pheqaa ilma Remaaliyaa keessa waggaa kudha torbaffaatti Aahaaz ilmi Yootaam mooticha Yihuudaa mootii taʼee bulchuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aahaaz yeroo mootii taʼetti nama waggaa digdamaa ture; innis Yerusaalem keessa taaʼee waggaa kudha jaʼa ni bulche. Inni akka abbaa isaa akka Daawit fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.2",
                "verseOrgIds": [
                  "2KI.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa duratti waan qajeelaa hin hojjenne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni karaa mootota Israaʼel duukaa buʼee gochawwan jibbisiisoo saboota",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.3",
                "verseOrgIds": [
                  "2KI.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula Israaʼelootaa duraa ariʼee baase sanaa hojjechuudhaan ilma isaa illee aarsaa godhee ibiddaan gube.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis iddoowwan sagadaa kanneen gaarran irraatti, fiixee gaarranii irrattii fi muka lalisaa hunda jalatti qalma dhiʼeessee, ixaanas aarse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reziin mootichi Sooriyaatii fi Pheqaan ilmi Remaaliyaa mootichi Israaʼel Yerusaalemin loluuf ol baʼanii Aahaazin marsan; garuu isa moʼachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti Reziin mootichi Sooriyaa namoota Yihuudaa ariʼee baasuudhaan Eelaatin warra Sooriyaatiif deebise. Ergasiis Edoomonni Eelaatitti godaananii hamma harʼaatti achuma jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aahaazis akkana jedhee gara Tiiglaat Phileeser mooticha Asooritti nama erge; \"Ani garbichaa fi ilma kee ti. Kottuutii harka mootii Sooriyaatii fi harka mootii Israaʼel kanneen natti duulaniitii na baasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Aahaaz meetii fi warqee mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.8",
                "verseOrgIds": [
                  "2KI.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa jiruu fi kan mankuusaa qabeenya masaraa mootummaa keessatti argamu baasee kennaa godhee mootii Asooritiif ni erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootiin Asoor sunis kadhaa isaa tole jedhee Damaasqoo lolee qabate. Jiraattota ishees boojiʼee Qiiritti geesse; Reziinin immoo ni ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aahaaz mootichi Tiiglaat Phileeser mooticha Asoor arguuf Damaasqoo dhaqe. Innis iddoo aarsaa tokko Damaasqoo keessatti argee fakkeenya isaatii fi karoora ittiin ijaaran hunda barreessee Uuriyaa lubichatti erge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Uuriyaa lubichi akkuma karoora Aahaaz mootichi Damaasqoodhaa ergeef sana hundaatti utuu Aahaaz mootichi Damaasqoodhaa hin deebiʼin dura iddoo aarsaa sana ijaaree fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis yommuu Damaasqoodhaa deebiʼee iddoo aarsaa sana argetti itti dhiʼaatee irratti aarsaa dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis aarsaa gubamuu fi kennaa midhaanii dhiʼeessee dhibaayyuu illee dhibaafatee dhiiga aarsaa nagaa kan ofii isaas iddoo aarsaa sana irratti ni facaase.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo aarsaa naasii irraa hojjetamee fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.14",
                "verseOrgIds": [
                  "2KI.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dura dhaabatee ture sanas mana qulqullummaa duraa iddoo aarsaa haaraa fi mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.14",
                "verseOrgIds": [
                  "2KI.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gidduudhaa fidee gama kaabaatiin iddoo aarsaa haaraa bira kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Aahaaz mootichi akkana jedhee Uuriyaa lubicha ajaje; \"Iddoo aarsaa guddicha irratti aarsaa gubamu kan ganamaatii fi kennaa midhaanii kan galgalaa, aarsaa mootichaa kan gubamuu fi kennaa midhaanii, aarsaa namoota biyyattii hundaa kan gubamu, kennaa isaanii kan midhaaniitii fi dhibaayyuu isaanii dhiʼeessi. Iddoo aarsaa irratti dhiiga aarsaa gubamuutii fi dhiiga qalmaa hunda facaasi. Iddoo aarsaa kan naasii irraa hojjetame garuu anatu ittiin gorsa gaafata.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uuriyaan lubichis akkuma Aahaaz mootichi ajaje sana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aahaaz mootichi baattuuwwan asii fi achi sochoofaman sana irraa marsaawwan buqqisee caabiiwwan dhiqannaa illee irraa baase. Gaanii sana baattuuwwan fakkii jibootaa kanneen naasii irraa hojjetaman irraa fuudhee dhagaa afamaa irra kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mootii Asooriif jedhee oobdii guyyaa Sanbataatiif hojjetame iddoo isaatii fuudhee karra alaa kan mootonni ittiin mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.18",
                "verseOrgIds": [
                  "2KI.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "seenanis ni buqqise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni bara mootummaa Aahaaz keessa hojjetame biraatii fi wanni inni hojjete kitaaba seenaa mootota Yihuudaa keessatti barreeffameera mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aahaazis abbootii isaa wajjin boqotee isaanuma biratti Magaalaa Daawit keessatti ni awwaalame. Ilmi isaa Hisqiyaas iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    }
  ],
