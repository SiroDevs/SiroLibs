      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaakiin mootiin Yihuudaa boojiʼamee waggaa soddomii torbaffaa isaatti, Eewiil Marodaak mootii Baabilon taʼe; innis wagguma sana keessa bultii digdamii torbaffaa jiʼa kudha lammaffaatti Yehooyaakiin mootii Yihuudaa sana mana hidhaatii gad dhiise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afaan tolaadhaanis isatti dubbatee barcuma ulfinaa kan barcuma mootota isa wajjin Baabilon keessa turan kaanii caalu kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Yehooyaakiin uffata isaa kan mana hidhaatti uffachaa ture sana of irraa baasee bara jireenya isaa guutuu yeroo hunda maaddii mootichaa irraa nyaate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis hamma inni lubbuudhaan jiraatetti guyyuma guyyaadhaan waan isaaf barbaachisu Yehooyaakiiniif kennaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.30",
            "verseOrgIds": [
              "2KI.25.30"
            ]
          }
        }
      ]
