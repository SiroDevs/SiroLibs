    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti Meroodak Baladaan ilmi Baladaan mootiin Baabilon sababii akka Hisqiyaas dhukkubsate dhagaʼeef xalayootaa fi kennaa ergeef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis ergamoota sana simatee waan mankuusa isaa keessa ture hunda jechuunis meetii, warqee, urgooftuu fi zayitii qulqulluu akkasumas kuusaa miʼa lolaa isaa fi waan mankuusa isaa keessatti argamu hunda isaanitti argisiise. Wanni Hisqiyaas masaraa mootummaa isaa keessaa yookaan mootummaa isaa hunda keessaa isaanitti hin argisiisin tokko iyyuu hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Isaayyaas raajichi gara Hisqiyaas mootichaa dhaqee, \"Namoonni sun maal jedhan? Isaan eessaa dhufan?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 20:14"
      },
      "items": [
        {
          "text": "Hisqiyaasis, \"Isaan Baabilonii biyya fagoodhaa dhufan\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajichi, \"Jarri masaraa mootummaa keetii keessatti maal argan?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 20:15"
      },
      "items": [
        {
          "text": "Hisqiyaas immoo, \"Isaan waan masaraa mootummaa koo keessa jiru hunda argan. Wanni ani mankuusa koo keessaa isaanitti hin argisiisin tokko iyyuu hin jiru\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaayyaasis kana irratti Hisqiyaasiin akkana jedhe; \"Dubbii",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.16",
                "verseOrgIds": [
                  "2KI.20.16"
                ]
              }
            }
          ]
        },
        {
          "text": "dhagaʼi:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroon itti wanni masaraa mootummaa keetii keessa jiru hundii fi wanni abbootiin kee hamma harʼaatti kuusan hundinuu saamamee gara Baabilonitti geeffamu tokko dhugumaan ni dhufa. Wanni tokko iyyuu hin hafu, jedha",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.17",
                "verseOrgIds": [
                  "2KI.20.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii kee keessaa namoonni tokko tokko, foonii fi dhiigni kee kanneen siif dhalatan boojiʼamanii masaraa mootummaa mooticha Baabilon keessatti xuʼaashiiwwan taʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis, \"Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.19",
                "verseOrgIds": [
                  "2KI.20.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kan ati dubbatte kun gaarii dha\" jedhee deebise. Inni, \"Bara jireenya koo keessa nagaa fi tasgabbiin hin jiraatuu?\" jedhee yaadee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Hisqiyaas keessa hojjetaman kanneen biraa, jabinni isaa hundii fi akki inni itti haroo fi ujummoo ittiin bishaan harkisanii gara magaalaatti fidan hojjetes kitaaba seenaa mootota Yihuudaa keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.20",
            "verseOrgIds": [
              "2KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis abbootii isaa wajjin boqote. Ilmi isaa Minaaseen iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.21",
            "verseOrgIds": [
              "2KI.20.21"
            ]
          }
        }
      ]
