    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa Hisqiyaas dhukkubsatee duʼuu gaʼee ture. Isaayyaas ilmi Amoos raajichi gara isaa dhaqee, \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.1",
                "verseOrgIds": [
                  "2KI.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; 'Mana kee tottolfadhu; ati ni duuta malee hin fayyituutii' \" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis fuula isaa gara keenyan manaatti garagalfatee akkana jedhee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.2",
                "verseOrgIds": [
                  "2KI.20.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kadhate;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.3",
                "verseOrgIds": [
                  "2KI.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", akka ani amanamummaa fi garaa tokkoon fuula kee dura jiraadhee waan fuula kee duratti gaarii taʼes hojjedhe yaadadhu.\" Hisqiyaasis hiqqifatee ni booʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu Isaayyaas oobdii gara gidduu jiru sana keessaa hin baʼin dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
              "2KI.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.4",
                "verseOrgIds": [
                  "2KI.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara isaa dhufe;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
              "2KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Deebiʼii dhaqiitii akkana jedhii Hisqiyaas hoogganaa saba kootiitti himi; '",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.5",
                "verseOrgIds": [
                  "2KI.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbaa kee Daawit akkana jedha: Ani kadhannaa kee dhagaʼeera; imimmaan kees argeera; ani sin fayyisa. Ati ammaa jalqabdee guyyaa sadaffaatti gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.5",
                "verseOrgIds": [
                  "2KI.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ol baata.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani umurii kee irratti waggaa kudha shan siifan dabala. Ani siʼii fi magaalaa kana harka mooticha Asooriitii nan baasa. Ani sababii kootii fi sababii garbicha koo Daawitiif jedhee magaalaa kana nan eega.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Isaayyaas, \"Maxinoo harbuu tolchaa\" jedhe. Isaanis qopheessanii dhullaa isaa irra kaaʼaniif; innis ni fayye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.7",
            "verseOrgIds": [
              "2KI.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis, \"Akka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.8",
                "verseOrgIds": [
                  "2KI.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na fayyisuu fi akka ani guyyaa sadaffaatti gara mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.8",
                "verseOrgIds": [
                  "2KI.20.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ol baʼuuf maaltu mallattoo taʼa?\" jedhee Isaayyaasin gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaayyaasis akkana jedhee deebise; \"Akka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.9",
                "verseOrgIds": [
                  "2KI.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "waan waadaa gale sana hojjetuuf mallattoon",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.9",
                "verseOrgIds": [
                  "2KI.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "siif kennu kunoo kanaa dha; gaaddidduun tokko tarkaanfii kudhan gara fuula duraatti haa deemuu moo yookaan tarkaanfii kudhan gara dugda duubaatti haa deebiʼuu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas immoo, \"Tarkaanfii kudhan gara fuula duraatti deemuun gaaddidduu tokkoof waan salphaa dha; qooda kanaa akka gaaddidduun sun tarkaanfii kudhan gara dugda duubaatti deebiʼu godhi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.10",
            "verseOrgIds": [
              "2KI.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Isaayyaas raajichi iyyee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.11",
                "verseOrgIds": [
                  "2KI.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ni kadhate;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.20.11",
                "verseOrgIds": [
                  "2KI.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akka gaaddidduun sun tarkaanfii kudhan gulantaa Aahaaz irra gara fuula duraatti deemee ture sana irraa tarkaanfii kudhan gara dugda duubaatti deebiʼu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ergamoota Baabilon Dhufan",
          "type": "text"
        }
      ]
    },
