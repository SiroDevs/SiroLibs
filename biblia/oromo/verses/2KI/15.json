          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni bara mootummaa Pheqaa keessa hojjetame biraa fi wanni inni hojjete hundi kitaaba seenaa mootota Israaʼel keessatti barreeffameera mitii?",
          "type": "text",
          "attrs": {
