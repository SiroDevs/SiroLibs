            "number": "23",
            "style": "v",
            "sid": "2KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Azaariyaa mooticha Yihuudaa keessa waggaa shantammaffaatti Pheqaayaan ilmi Menaaheem Samaariyaa keessatti mootii Israaʼel taʼee waggaa lama bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pheqaayaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.15.24",
                "verseOrgIds": [
                  "2KI.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete. Inni cubbuu Yerobiʼaam ilma Nebaat kan inni akka Israaʼel hojjetu godhe sana irraa hin deebine.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjoota isaa ol aantota keessaa Pheqaan ilmi Remaaliyaa isatti malate. Innis namoota Giliʼaad keessaa nama shantama fudhatee fiixee masaraa mootummaa kan Samaariyaa keessaa irratti Pheqaayaa, Argobbii fi Ariyyee ajjeese. Pheqaanis akkasiin Pheqaayaa ajjeesee iddoo isaa mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni bara mootummaa Pheqaayaa keessa hojjetame kan biraatii fi wanni inni hojjete hundi kitaaba seenaa mootota Israaʼel keessatti barreeffameera mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
    },
