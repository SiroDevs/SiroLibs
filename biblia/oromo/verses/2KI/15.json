    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Pheqaa mooticha Israaʼel keessa Tiiglaat Phileeser mootichi Asoor dhufee Iiyoon, Abeel Beet Maʼaakaa, Yaanoʼaa, Qaadeshii fi Haazoor, Giliʼaadii fi Galiilaa, biyya Niftaalem hundas walumatti qabatee namootas guuree Asooritti geesse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Hoosheeʼaa ilmi Eelaa, Pheqaa ilma Remaaliyaatti malate. Innis lolee isa ajjeesee bara mootummaa Yootaam ilma Uziyaan keessaa waggaa digdammaffaatti iddoo isaa mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
