        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haasaa Iyyaasuu Isa Dhumaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga barri dheeraan darbee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.1",
                "verseOrgIds": [
                  "JOS.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "diinota isaan marsan hunda irraa Israaʼeloota boqochiisee booddee Iyyaasuun bara dheeraa jiraatee dulloome;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis Israaʼeloota hunda jechuunis maanguddoota isaanii, hooggantoota isaanii, abbootii murtii isaaniitii fi qondaaltota isaanii ofitti waamee akkana jedheen: \"Kunoo ani bara dheeraa jiraadhee dulloomeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.2",
            "verseOrgIds": [
              "JOS.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin mataan keessanuu waan",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.3",
                "verseOrgIds": [
                  "JOS.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isiniif jedhee saboota kana godhe hundumaa argitaniirtu;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.3",
                "verseOrgIds": [
                  "JOS.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessantu isiniif lole.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani itti biyya saboota hafanii jechuunis biyya saboota ani Yordaanosii jalqabee hamma lixa Galaana Guddichaatti moʼadhe sanaa hunda gosoota keessaniif dhaala godhee kenne mee yaadadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.4",
            "verseOrgIds": [
              "JOS.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.5",
                "verseOrgIds": [
                  "JOS.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan mataan isaa iyyuu fuula keessan duraa ariʼee isaan baasa. Inni fuula keessan duraa dhiibee isaan baasa; isin immoo akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.5",
                "verseOrgIds": [
                  "JOS.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isin abdachiise sanatti biyya isaanii qabattu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jabaadhaa dhaabadhaa; akka waan Kitaaba Seera Musee keessatti barreeffame hunda, utuu gara mirgaatti yookaan bitaatti hin jalʼatin jabeessaa eegaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.6",
            "verseOrgIds": [
              "JOS.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboota gidduu keessanitti hafan kanneenitti hin makaminaa; maqaa waaqota isaanii hin dhaʼinaa yookaan ittiin hin kakatinaa. Waaqota sana hin tajaajilinaa yookaan isaaniif hin sagadinaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.7",
            "verseOrgIds": [
              "JOS.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma hamma harʼaatti gochaa turtan sana jabaadhaa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.8",
                "verseOrgIds": [
                  "JOS.23.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessanitti maxxanaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.9",
                "verseOrgIds": [
                  "JOS.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "saboota gurguddaa fi humna qabeeyyii fuula keessan duraa ariʼee baaseera; hamma ammaatti namni tokko iyyuu isin dura dhaabachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.10",
                "verseOrgIds": [
                  "JOS.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan akkuma waadaa gale sana isinii loluuf namni keessan tokkichi nama kuma tokko ariʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.11",
                "verseOrgIds": [
                  "JOS.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan cimsaa jaalladhaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Garuu yoo isin karaa irraa jalʼattanii hambaa saboota gidduu keessan jiraatan kanneeniitti maxxantan, yoo isin isaaniin walfuutanii isaanitti makamtan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.12",
            "verseOrgIds": [
              "JOS.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.13",
                "verseOrgIds": [
                  "JOS.23.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan siʼachi saboota kanneen isin duraa ariʼee hin baafne beekkadhaa. Qooda kanaa isaan hamma isin biyya gaarii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.13",
                "verseOrgIds": [
                  "JOS.23.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isiniif kenne kana keessaa dhumtanitti iddaa fi kiyyoo isinitti taʼu; dugda keessanitti qaccee, ija keessanittis qoraattii taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunoo ani karaa lafa hundaa deemuufin jira. Akka waadaa gaarii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.14",
                "verseOrgIds": [
                  "JOS.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isiniif gale hunda keessaa tokko iyyuu utuu hin guutamin hafee hin jirre isin garaa keessan guutuu fi lubbuu keessan guutuudhaan ni beektu. Waadaan hundi guutameera; tokko iyyuu hin hirʼanne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu akkuma waadaan gaariin",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.15",
                "verseOrgIds": [
                  "JOS.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessanii hundi guutame sana,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.15",
                "verseOrgIds": [
                  "JOS.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akkasuma waan hamaa ittiin isin sodaachise sana hunda hamma biyya gaarii isinii kenne kana irraa isin fixutti isinitti fida.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isin kakuu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.16",
                "verseOrgIds": [
                  "JOS.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isin ajaje cabsitanii dhaqxanii waaqota biraa tajaajiltanii fi isaaniif sagaddan dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.16",
                "verseOrgIds": [
                  "JOS.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "isinitti bobaʼa; isinis biyya gaarii inni isinii kenne sana irraa daftanii ni baddu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        }
      ]
    }
  ],
