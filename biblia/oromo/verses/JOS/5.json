    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gilgaalitti Dhagna Qabamuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni Amoorotaa kanneen gama dhiʼa Yordaanos jiraatanii fi mootonni Kanaʼaanotaa kanneen qarqara galaanaa jiraatan hundi akka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.1",
                "verseOrgIds": [
                  "JOS.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "hamma nu ceenutti fuula saba Israaʼel duratti Yordaanos gogse yommuu dhagaʼanitti onneen isaanii ni baqxe; deebiʼaniis fuula Israaʼelootaa dura dhaabachuu sodaatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.1",
            "verseOrgIds": [
              "JOS.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.2",
                "verseOrgIds": [
                  "JOS.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yeroo sana Iyyaasuudhaan, \"Haaduu qara qabu tolchiitii ammas Israaʼeloota dhagna qabi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Iyyaasuun haaduu qara qabu tolchee Gibeʼaat Aaralootitti Israaʼeloota dhagna qabe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin Iyyaasuun waan kana hojjeteef kana: Warri biyya Gibxii baʼanii dhufan hundinuu jechuunis dhiironni lolan hundinuu erga Gibxii baʼanii booddee gammoojjii keessatti karaatti dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Gibxii baʼan hundi dhagna qabatanii turan; warri yeroo Gibxii baʼanii gammoojjii keessa deemaa turanitti karaatti dhalatan garuu dhagna hin qabamne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni sababii",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.6",
                "verseOrgIds": [
                  "JOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajamuu didaniif hamma namoonni yeroo Gibxii baʼanitti loluu dandaʼan hundi dhumanitti waggaa afurtama gammoojjii keessa jooran.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.6",
                "verseOrgIds": [
                  "JOS.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "akka isaan biyya inni nuu kennuuf abbootii isaanii abdachiisee ture, biyya aannanii fi damma baaftu sana hin argine isaanitti kakatee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni qooda isaanii ilmaan isaanii kaase; isaanis warra Iyyaasuun dhagna qabee dha. Isaan sababii karaatti dhagna hin qabaminiif hamma harʼaatti utuu dhagna hin qabamin jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis erga sabni guutuun dhagna qabamee booddee hamma fayyanitti lafuma jiran sana qubata keessa turan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.9",
                "verseOrgIds": [
                  "JOS.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Iyyaasuudhaan, \"Ani harʼa arrabsoo Gibxi sana isin irraa gangalcheera\" jedhe. Kanaafuu iddoon sun hamma harʼaatti Gilgaal jedhamee waamama.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galgala bultii kudha afuraffaa jiʼa sanaatti sabni Israaʼel utuma dirree Yerikoo irra Gilgaal keessa qubatee jiruu Faasiikaa ayyaaneffate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.10",
            "verseOrgIds": [
              "JOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis guyyaa Faasiikaatti aanee dhufu, gaafuma sana midhaan biyyattii keessaa waa nyaatan; kunis Maxinoo fi asheetii waadamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.11",
            "verseOrgIds": [
              "JOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mannaanis guyyuma isaan midhaan biyya sanaa nyaatanitti aanu gad buʼuu dhiise; ergasii mannaan tokko iyyuu warra Israaʼeliif gad hin buune; garuu isaan waggaa sana keessa midhaan biyya Kanaʼaan nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.12",
            "verseOrgIds": [
              "JOS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yerikoon Jiguu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun yommuu Yerikootti dhiʼaatetti, ol milʼatee nama goraadee luqqifame harkatti qabatee isa dura dhaabatu tokko arge. Iyyaasuun gara isaa dhaqee, \"Ati gara keenya moo gara diinota keenyaa ti?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.13",
            "verseOrgIds": [
              "JOS.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis deebisee, \"Ani gara eenyuu iyyuu miti; garuu ani amma akka ajajaa loltoota",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.14",
                "verseOrgIds": [
                  "JOS.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dhufeera\" jedhe. Iyyaasuunis addaan lafatti gombifamee sagadee, \"Ergaan Gooftaan koo garbicha isaatiif qabu maali?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajaan loltoota",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "JOS.5.15",
                "verseOrgIds": [
                  "JOS.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Iyyaasuudhaan, \"Sababii iddoon ati dhaabattu kun qulqulluu taʼeef kophee kee of irraa baasi\" jedhe. Iyyaasuunis akkasuma godhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
    }
  ],
