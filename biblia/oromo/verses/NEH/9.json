  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "NEH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israaʼeloonni Cubbuu Isaanii Himatan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii digdamii afuraffaa jiʼa sanaatti Israaʼeloonni wayyaa gaddaa uffatanii, daaraa mataatti firfirfatanii soomaaf walitti qabaman.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.1",
            "verseOrgIds": [
              "NEH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri sanyii Israaʼel taʼanis namoota ormaa hunda irraa kophaa of baasan. Isaanis kaʼanii cubbuu ofii isaaniitii fi hammina abbootii isaanii himatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.2",
            "verseOrgIds": [
              "NEH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis idduma turan sana dhaabatanii kurmaana guyyaatiif Kitaaba Seera",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.3",
                "verseOrgIds": [
                  "NEH.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii keessaa dubbifatan; kurmaana biraa immoo cubbuu isaanii himachaa",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.3",
                "verseOrgIds": [
                  "NEH.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaanii waaqeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni jechuunis Yeeshuuʼaan, Baaniin, Qadmiiʼeel, Shebaniyaan, Buniin, Sheereebiyaan, Baanii fi Kenaan waltajjiiwwan irra dhaabatanii sagalee ol fudhatanii",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.4",
                "verseOrgIds": [
                  "NEH.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "isaanii waammatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni jechuunis Yeeshuuʼaan, Qadmiiʼeel, Baaniin, Hashabniyaan, Sheereebiyaan, Hoodiyaa, Shebaniyaanii fi Phetaayaadhaan, \"Kaʼaatii",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.5",
                "verseOrgIds": [
                  "NEH.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessan isa bara baraa hamma bara baraatti jiraatu sana galateeffadhaa\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 9:5"
      },
      "items": [
        {
          "text": "\"Maqaan kee inni ulfina qabeessi haa eebbifamu; eebbaa fi galata hundaa olittis ol ol haa jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suma qofatu",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.6",
                "verseOrgIds": [
                  "NEH.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ati samiiwwan, samiiwwan oliitii fi tuuta urjiiwwan isaanii hunda, lafaa fi waan lafa irra jiru hunda, galaanaa fi waan isaan keessa jiru hunda uumte. Ati waan hundaaf lubbuu kennita; raayyaawwan samiis si waaqeffatu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.7",
            "verseOrgIds": [
              "NEH.9.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.7",
                "verseOrgIds": [
                  "NEH.9.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Abraamin filattee biyya Kaldootaa Uuri keessa isa baaftee Abrahaam jettee isa moggaaftee dha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.7",
            "verseOrgIds": [
              "NEH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka ati yaadni isaa amanamaa siif taʼe argitee biyya Kanaʼaanotaa, Heetotaa, Amoorotaa, Feerzotaa, Yebuusotaatii fi biyya Girgaashotaa sanyiiwwan isaatiif kennuuf kakuu isaaf galte. Ati waan qajeelaa taateef waadaa kee eegdeef.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.8",
            "verseOrgIds": [
              "NEH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati rakkina abbootiin keenya biyya Gibxi keessatti rakkatan argite; booʼicha isaan Galaana Diimaa biratti booʼan illee ni dhageesse.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.9",
            "verseOrgIds": [
              "NEH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati sababii warri Gibxi of tuulummadhaan hammam akka isaan dhiphisan beekteef Faraʼoonitti, qondaaltota isaa hundattii fi saba biyya isaa hundatti mallattoo fi dinqiiwwan argisiifte. Ati maqaa hamma harʼaatti illee jiru ofii keetiif baafatte.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.10",
            "verseOrgIds": [
              "NEH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka isaan lafa gogaa irra darbaniif fuuluma isaanii duratti galaana gargar qoodde; warra isaan ariʼu garuu akkuma dhagaa bishaan guddaatti gad darbatamuu tokkootti tuujubatti gad isaan darbatte.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.11",
            "verseOrgIds": [
              "NEH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa guyyaa utubaa duumessaatiin isaan qajeelchite; halkan halkan immoo karaa isaan deeman irratti ifa isaaniif kennuuf jettee utubaa ibiddaatiin isaan qajeelchite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.12",
            "verseOrgIds": [
              "NEH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati Tulluu Siinaa irratti gad buute; samii irraas isaanitti dubbate. Ajajawwanii fi seerawwan dhugaa fi qajeelaa, labsiiwwanii fi ajajawwan gaariis isaaniif kennite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.13",
            "verseOrgIds": [
              "NEH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbata kee qulqulluu sana isaan beeksiftee karaa garbicha kee Museetiin ajajawwan, labsiiwwanii fi seerawwan isaaniif kennite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.14",
            "verseOrgIds": [
              "NEH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo isaan beelaʼanitti samiidhaa buddeena kenniteefii yeroo isaan dheebotanitti immoo kattaa keessaa bishaan baafteef; akka isaan biyya ati isaaniif kennuuf kakatte sanatti galanii dhaalanis isaanitti himte.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.15",
            "verseOrgIds": [
              "NEH.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abbootiin keenya garuu of tuulan; mataa jabaataniis ajaja kee eeguu didan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.16",
            "verseOrgIds": [
              "NEH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris ajajamuu didan; dinqii ati isaan gidduutti hojjette hin yaadanne. Garbummaa isaaniitti deebiʼuuf jedhaniis mataa jabaatanii fincila isaaniitiin hoogganaa muuddatan. Ati garuu Waaqa namaaf araaramu, arjaa fi gara laafessa, kan dafee hin aarree fi kan jaalalli isaa dhuma hin qabnee dha. Kanaafuu ati isaan hin ganne;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.17",
            "verseOrgIds": [
              "NEH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo isaan ofii isaaniitiif fakkii jabbii tolfatanii, 'Kun Waaqa keessan kan biyya Gibxii isin baasee dha' jedhanii Waaqa arrabsanitti illee ati isaan hin ganne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.18",
            "verseOrgIds": [
              "NEH.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sababii gara laafina kee guddaa sanaatiif ati gammoojjii keessatti isaan hin ganne. Utubaan duumessaa guyyaa guyyaa karaa isaanii irratti isaan geggeessuu hin dhiifne; utubaan ibiddaa immoo halkan halkan karaa isaanii irratti isaaniif ibsuu hin dhiifne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.19",
            "verseOrgIds": [
              "NEH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan barsiisuuf jettee Hafuura kee gaarii sana kennite. Ati mannaa afaan isaaniitii hin dhabamsiifne; dheebuu isaaniitiifis bishaan kenniteef.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.20",
            "verseOrgIds": [
              "NEH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa afurtama gammoojjii keessatti isaan soorte; isaan waan tokko illee hin dhabne; wayyaan isaanii hin dhumne; miilli isaaniis hin iitofne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.21",
            "verseOrgIds": [
              "NEH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati daangaa hunda qooddeefii mootummootaa fi saboota isaaniif kennite. Isaanis akkasiin biyya Sihoon mooticha Heshboonii fi biyya Oogi mooticha Baashaanii fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.22",
            "verseOrgIds": [
              "NEH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati ilmaan isaanii akkuma urjiiwwan samii baayʼifte; biyya akka isaan seenanii dhaalaniif abbootii isaaniitti himte sanatti isaan galchite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.23",
            "verseOrgIds": [
              "NEH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan isaanii itti galanii biyya sana dhaalan. Atis Kanaʼaanota biyya sana turan isaan jala galchite; akka jarri waanuma fedhan isaan godhaniif Kanaʼaanota mootota isaaniitii fi saba biyya sanaatiin walitti qabdee dabarsitee harka isaaniitti kennite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.24",
            "verseOrgIds": [
              "NEH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis magaalaawwan daʼannoo qabanii fi lafa gabbataa qabatan; manneen miʼa gaggaarii gosa hundaatiin guutaman, boollawwan bishaanii qotaman, iddoo dhaabaa wayinii, lafa qotiisaa mukkeen ejersaatii fi mukkeen ija baasan hedduu dhaalan. Isaan nyaatanii quufanii gabbatan; arjummaa kee guddaa sanaanis ni gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.25",
            "verseOrgIds": [
              "NEH.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaan garuu ajajamuu didanii sitti fincilan; seera kees of duubatti gatan. Raajota kee kanneen gara keetti isaan deebisuuf jedhanii isaan seeran illee ni fixan; Waaqas ni arrabsan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.26",
            "verseOrgIds": [
              "NEH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ati diinota isaanii warra isaan cunqursanitti dabarsitee isaan kennite. Isaan garuu yeroo cunqurfamanitti sitti iyyatan. Atis samiidhaa isaan dhageessee gara laafina kee guddaa sanaan namoota harka diinota isaanii jalaa isaan baasan kenniteef.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.27",
            "verseOrgIds": [
              "NEH.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaan garuu akkuma boqonnaa argataniin amma illee fuula kee duratti waan hamaa hojjetan. Kana irratti ati akka warri sun isaan bulchaniif jettee harka diinota isaaniitti dabarsitee isaan kennite. Yommuu isaan amma illee gara keetti ol iyyatanitti ati samii irraa dhageessee gara laafina keetiin yeroo hedduu isaan furte.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.28",
            "verseOrgIds": [
              "NEH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati akka isaan gara seera keetiitti deebiʼaniif isaan akeekkachiifte; isaan immoo of tuulanii ajaja kee eeguu didan. Ajajawwan kee kanneen 'namni tokko yoo ajajameef ittiin jireenya argachuu dandaʼutti illee' cubbuu hojjetan. Finciluudhaan dugda isaanii sitti garagalchan; mataa jabaataniis si dhagaʼu didan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.29",
            "verseOrgIds": [
              "NEH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati bara hedduu isaaniif obsite. Karaa raajota keetiitiin Hafuura keetiin isaan akeekkachiifte. Taʼus isaan gurra hin kennine; kanaafuu ati dabarsitee saba biyya sanaatti isaan kennite.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.30",
            "verseOrgIds": [
              "NEH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garuu sababii Waaqa arjaa fi araara qabeessa taateef, araara kee guddicha sanaaf jettee isaan hin balleessine yookaan isaan hin ganne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.31",
            "verseOrgIds": [
              "NEH.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu amma yaa Waaqa keenya, Waaqa guddicha, jabaa fi sodaachisaa, kan kakuu jaalala keetii eegdu, ati rakkina nutti dhufe kana hunda jechuunis rakkina bara mootota Asoorii jalqabee hamma harʼaatti nutti, mootota keenyaa fi hooggantoota keenyatti, luboota keenyaa fi raajota keenyatti, abbootii keenyaa fi saba kee hundatti dhufe kana akka waan salphaatti hin ilaalin.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.32",
            "verseOrgIds": [
              "NEH.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan nurra gaʼe hunda keessatti ati qajeelaa dha; nu yoo hamaa hojjenne iyyuu ati waan qajeelaa hojjette.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.33",
            "verseOrgIds": [
              "NEH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni keenya, hooggantoonni keenya, luboonni keenyaa fi abbootiin keenya seera kee duukaa hin buune; isaan ajaja keetiif yookaan akeekkachiisa ati isaaniif kenniteef xiyyeeffannoo hin kennine.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.34",
            "verseOrgIds": [
              "NEH.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yeroo ati biyya balʼaa fi lafa gabbataa keessatti waan gaarii isaaniif kennite sana keessatti gammadaa, mootummaa ofii isaanii keessa turanitti illee si hin tajaajille yookaan karaa isaanii hamaa sana irraa hin deebine.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.35",
            "verseOrgIds": [
              "NEH.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunoo nu harʼa garboota; biyyuma ati akka isaan midhaan isheetii fi waan gaggaarii isheen baaftu nyaataniif jettee abbootii keenyaaf kennite keessatti garboomneerra.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.36",
            "verseOrgIds": [
              "NEH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii cubbuu keenyaatiif midhaan ishee baayʼeen sun gara mootota ati nutti muudde sanaa dhaqa. Isaan nuu fi loon keenya illee akkuma fedhan godhu. Nu rakkina guddaa keessa jirra.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.37",
            "verseOrgIds": [
              "NEH.9.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Walii Galtee Sabaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sababii waan kana hundaatiif nu walii galtee walitti nu hidhu tokko barreeffamaan qopheessine. Hooggantoonni keenya, Lewwonni keenyaa fi luboonni keenya chaappaawwan isaanii itti rukutan.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        }
      ]
    }
  ],
