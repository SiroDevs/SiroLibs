  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "NEH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nahimiyaan Hiyyeeyyii Gargaare",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti namoonnii fi niitonni isaanii obboloota isaanii Yihuudootatti guddisanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaa namoonni tokko tokko, \"Nu, ilmaan keenyaa fi intallan keenya baayʼee hedduu dha; nu akka nyaannee jiraannuuf midhaan argachuu qabna\" jechaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri kaan immoo, \"Nu yeroo beelaatti midhaan argachuudhaaf jennee lafa qotiisaa keenya, iddoo dhaabaa wayinii keenyaa fi manneen keenya qabsiisaa jirra\" jechaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas namoonni biraa akkana jedhan; \"Nu lafa qotiisaa keenyaa fi iddoo dhaabaa wayinii keenyaatiif gibira mootichaa baasuudhaaf maallaqa liqeeffachuu qabna turre.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu namoota biyya keenyaatiin foonii fi dhiiga tokko taanee ilmaan keenyas akkuma ilmaan isaanii gaarii taʼan illee, nu ilmaan keenyaa fi intallan keenya dabarsinee garbummaaf kennineerra. Intallan keenya keessaa tokko tokko amma iyyuu garboomfamanii jiru; garuu lafti qotiisaa keenyaa fi iddoon dhaabaa wayinii keenyaa kan namoota biraa waan taʼaniif nu humna hin qabnu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis yommuun iyya isaaniitii fi dubbii kana dhagaʼetti baayʼee nan aare.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis ofiin mariʼadhee namoota bebeekamoo fi qondaaltota sana nan ifadhe; akkanas nan jedheen; \"Isin hiiqiidhaan liqeessuudhaan namootuma biyya keessanii saamaa jirtu!\" Kanaafuu ani yaaʼii guddaa isaanitti waameen",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana isaaniin jedhe; \"Nu hamma nuu dandaʼametti obboloota keenya Yihuudoota saba ormaatti gurguramanii turan sana deebifnee bitanneerra. Isin amma illee akka isaan deebifamanii nutti gurguramaniif jettanii obboloota keessaan gurguraa jirtu!\" Isaan immoo waan jedhan dhabanii calʼisan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani ittuma fufeen akkana jedheen; \"Wanni isin hojjechuutti jirtan kun sirrii miti. Isin tuffii diinota keenya Namoota Ormaa jalaa baʼuuf, Waaqa keenya sodaachuudhaan jiraachuu hin qabdanii?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani, obboloota koo fi namoonni koos maallaqaa fi midhaan saba kanaaf liqeessaa jirra. Garuu hiiqiidhaan liqeessuudhaan nama saamuu dhiisaa!",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma dafaatii lafa qotiisaa isaanii, iddoo dhaabaa wayinii isaanii, mukkeen ejersaatii fi manneen isaanii akkasumas waan hiiqiidhaan liqeessitanii dhibbantaan saamtan kanneen akka maallaqaa, midhaanii, daadhii wayinii haaraatii fi zayitii sana deebisaafii.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Nu waan sana deebifnee ni kennina; deebinee waan tokko illee isaan irraa hin barbaannu. Akkuma ati jette goona\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 5:12"
      },
      "items": [
        {
          "text": "Kana irratti ani luboota ofitti waamee akka namoonni bebeekamoonii fi qondaaltonni waan waadaa galan sana raawwatan nan kakachiise.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas ani dachaa uffata koo hurgufeen akkana jedhe; \"Waaqayyo nama waadaa kana hin eegne kamiin iyyuu mana isaatii fi qabeenya isaa irraa akkana haa hurgufu. Namni akkanaa kun akkasuma hurgufamee harka duwwaa haa hafu!\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 5:13"
      },
      "items": [
        {
          "text": "Kana irratti waldaan hundi, \"Ameen\" jedhee",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "NEH.5.13",
                "verseOrgIds": [
                  "NEH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "galateeffate. Uummannis akkuma waadaa gale sana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana caalaas yeroo ani bara Arxeksis mootichaa keessa waggaa digdammaffaatti bulchaa biyya Yihuudaa taʼee muudamee jalqabee hamma waggaa soddomii lammaffaa mootummaa isaatti jechuunis waggaa kudha lamaaf, anis obboloonni koos nyaata bulchaaf ramadame hin nyaanne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu bulchitoonni durii kanneen anaan dura turan baʼaa guddaa saba baachisanii nyaataa fi daadhii wayinii malee iyyuu meetii saqilii afurtama isaan irraa fudhachaa turan. Gargaartonni isaaniis akkasuma saba cunqursan. Ani garuu waanan Waaqa sodaadhuuf akkas hin goone.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa ani hojii dallaa ijaaruu kanaaf of nan kenne. Namoonni koo hundinuu achitti hojiidhaaf walitti qabaman; nu lafa tokko illee hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma illee namoota saba naannoo keenya jiraatan keessaa dhufan malee Yihuudoonni dhibba tokkoo shantamnii fi qondaaltonni maaddii koo irraa nyaachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa guyyaadhaan sangaan tokko, hoolonni gagabbatoon jaʼaa fi indaanqoowwan muraasni, guyyaa kudhan kudhaniin immoo daadhiin wayinii kan gosa hundaa baayʼinaan naa qopheeffama ture. Kana hunda malees ani takkumaa nyaata bulchaaf ramadamuu qabu hin gaafanne; gaaffiin kun saboota kanneenitti baʼaa guddaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa koo waan ani saba kanaaf godhe hunda tolaatti naa lakkaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
  ],
