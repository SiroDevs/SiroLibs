  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "TIT 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Gaarii Hojjechuudhaaf Fayyifamuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka namoonni bulchitootaa fi abbootii taayitaatiif bulan, akka ajajamanii fi akka waan gaarii kam iyyuu hojjechuuf qophaaʼoo taʼan yaadachiisi;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.1",
            "verseOrgIds": [
              "TIT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka isaan maqaa nama tokko illee hin balleessine, akka namoota nagaatii fi obsa qabeeyyii taʼan, akka nama hundaaf garraamummaa argisiisanis yaadachiisi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.2",
            "verseOrgIds": [
              "TIT.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu mataan keenyas duraan warra gowwoota, warra hin ajajamne, warra gowwoomfamnee fi warra dharraa hamaa fi gammachuu gosa hundaatiif garboomfamne turre. Namootaan jibbamaa fi walis jibbaa, hamminaa fi hinaaffaan jiraachaa turre.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.3",
            "verseOrgIds": [
              "TIT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu gaarummaa fi jaalalli Fayyisaa keenya Waaqaa mulʼatetti garuu,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.4",
            "verseOrgIds": [
              "TIT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni sababii qajeelummaa nu hojjenneetiif utuu hin taʼin sababii araara isaatiif jedhee nu fayyise. Inni dhiqannaa lammata dhalachuutii fi haaromsuu Hafuura Qulqulluutiin nu fayyise;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.5",
            "verseOrgIds": [
              "TIT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "hafuurri kunis isa Waaqni karaa Fayyisaa keenya Yesuus Kiristoosiin arjummaadhaan nurratti dhangalaase sana;",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.6",
            "verseOrgIds": [
              "TIT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka nu ayyaana isaatiin qajeeltota taasifamnee abdii jireenya bara baraa qabaachuun dhaaltota taanuuf.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
              "TIT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jechi kunis amanamaa dha. Warri Waaqa amanatan akka waan gaarii hojjechuuf of eeggannaan of kennan, akka ati cimsitee waan kana dubbattu nan barbaada. Kunis waan akka malee gaarii fi waan nama hundumaa fayyaduu dha.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garuu falmii faayidaa hin qabnee fi hidda dhalootaa lakkaaʼuu irraa, waaʼee seeraa irratti wal mormuu fi wal loluu irraa fagaadhu; kun waan buʼaa hin qabnee fi waan hin fayyadnee dhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama gargar baʼuu fidu tokko yeroo tokko akeekkachiisi; yeroo lammaffaas akeekkachiisi. Ergasii immoo isa irraa fagaadhu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
              "TIT.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni akkasii akka micciiramaa fi cubbamaa taʼe atuu beekta; inni nama ofuma isaatti muruu dha.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
              "TIT.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gorsa Dhumaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waanan yeroo gannaa Niqoophiliyoonitti dabarsuuf murteesseef akkuma ani Arxemaas yookaan Xikiqoosin sitti ergeen dafii kottu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zenaas abukaattichaa fi Apholoosin imala isaanii irratti gargaaruuf waan dandeessu hunda godhi; waan isaan barbaachisu hunda qabaachuu isaanii illee mirkaneessi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni keenya akka waan guyyaa guyyaatti isaan barbaachisu hojjetanii argatanii fi akka jireenya buʼaa hin qabne hin jiraanneefis waan gaarii hojjechuuf of kennuu barachuu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri na wajjin jiran hundinuu nagaa siif dhaamu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "TIT 3:15"
      },
      "items": [
        {
          "text": "Warra amantiin nu jaallatanitti nagaa nuuf himi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "TIT 3:15"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "TIT 3:15"
      },
      "items": [
        {
          "text": "Ayyaanni hunda keessan wajjin haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    }
  ],
