        {
          "text": "akkana jedhee gara koo dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
