                "verseOrgIds": [
                  "EZK.12.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha: Ani fakkeenya kana nan balleessa; isaan siʼachi Israaʼel keessatti itti hin fayyadaman.' Atis, 'Barri itti mulʼanni hundi fiixaan baʼu dhiʼaateera, isaaniin jedhi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siʼachi mulʼanni sobaa yookaan raajiin sobaa uummata Israaʼel keessa hin jiraatuutii.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
