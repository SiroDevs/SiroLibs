  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nagaa Gaafachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos isa fedhii Waaqaatiin ergamaa Kiristoos Yesuus taʼee fi obboleessa keenya Xiimotewos irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "2CO 1:1"
      },
      "items": [
        {
          "text": "Gara waldaa kiristaanaa Waaqaa ishee Qorontos jirtuutii fi qulqulloota Akaayaa guutuu keessa jiraatan hundumaatti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaa keenya Waaqaa fi Yesuus Kiristoos Gooftaa irraa ayyaannii fi nagaan isiniif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaqa Nama Jajjabeessuuf Galata Galchuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnii fi Abbaan Gooftaa keenya Yesuus Kiristoos, Abbaan araaraatii fi Waaqni jajjabina hundaa haa eebbifamu;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni akka nu jajjabina Waaqa biraa arganne sanaan warra dhiphina adda addaa keessa jiran jajjabeessuu dandeenyuuf dhiphina keenya hunda keessatti nu jajjabeessa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma nu dhiphina Kiristoos keessatti baayʼee hirmaannu, akkasuma immoo karaa Kiristoosiin jajjabinni nuu baayʼata.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu yoo dhiphanne jajjabinaa fi fayyina keessaniif taʼa; nu yoo jajjabaanne jajjabina keessaniif taʼa; jajjabinni kunis kan isin yeroo dhiphina nu dhiphannu kana keessa dabartanitti obsaan dhaabachuudhaan argattanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abdiin nu waaʼee keessaniif qabnu cimaa dha; isin akkuma dhiphina keenya keessatti hirmaattan amma immoo jajjabina keenya keessatti akka hirmaattan beeknaatii.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, isin waaʼee dhiphina biyya Asiyaatti nurra gaʼee akka wallaaltan hin barbaannu. Hamma lubbuudhaan jiraachuuf illee abdii kutannutti dhiphinni baachuudhaaf humna keenyaa ol taʼe nurra gaʼee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhugumaanuu murtiin duʼaa nutti dhagaʼamee turre. Kun garuu akka nu Waaqa warra duʼan kaasutti malee ofii keenyatti hin amananneef taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni balaa duʼa akkasii jalaa nu baaseera; nu baasas. Inni ittuma fufee akka nu baasu abdii keenya isa irra kaaʼanneerra.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma isin kadhannaa keessaniin nu gargaartan, ayyaana kadhannaa namoota baayʼeetiif deebii taʼee nuu kenname sanaaf namoonni baayʼeen nuuf galateeffatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Karoora Geeddarate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa wanti nu ittiin of jajnu kanaa dha: Akka nu qulqullummaa fi amanamummaa Waaqa biraa argameen fooniin keessumattuu hariiroo isin wajjin qabnuun jiraachaa turre yaadni garaa keenyaa dhugaa nuuf baʼa. Kanas akka ayyaana Waaqaatti goone malee akka ogummaa addunyaatti miti.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu waan isin dubbisuu yookaan hubachuu hin dandeenye tokko illee isinii hin barreessinuutii. Ani akka isin hamma dhumaatti hubattan nan abdadha;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis akkuma isin gara tokko nu hubattan kana, akka guyyaa Gooftaa Yesuusitti akkuma nu isiniin of jajnu sana isinis nuun of jajuu dandeessan guutummaatti hubattanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis sababiin waan kana amaneef akka isin ayyaana lammaffaa qabaattaniif jedhee jalqabatti gara keessan dhufuu barbaade.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroon Maqedooniyaa dhaqutti isin ilaaluu fi yeroon Maqedooniyaadhaa deebiʼuttis gara keessan dhufee, akka isin yeroo ani Yihuudaa dhaqutti na ergitan barbaade.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroon waan kana karoorfadhetti akka salphaattin hojjedhee? Yookaan akka yaada fooniitti yeruma tokkotti, \"Eeyyee, eeyyee\" fi \"Waawuu, waawuu\" jechuufan karoora baafadhaa ree?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Waaqni amanamaa taʼe dubbiin nu isinitti dubbannus \"Eeyyee\" fi \"Waawuu\" miti.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus Kiristoos Ilmi Waaqaa inni nu jechuunis ani, Silwaanosii fi Xiimotewos isin gidduutti lallabne sun, \"Eeyyee\" fi \"Waawuu\" hin turreetii; isa keessa \"Eeyyeetu\" jira.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waadaawwan Waaqaa hundinuu Kiristoosiin \"Eeyyeedhaatii\". Kanaafuu nu karaa isaatiin ulfina Waaqaatiif \"Ameen\" jenna.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa kan akka nu isin wajjin Kiristoositti jabaannee dhaabannu godhuu fi kan nu dibe Waaqa;",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis chaappaa nutti chaappessee, qabdii Hafuura Qulqulluu garaa keenya keessa kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu isin qusachuudhaaf jecha Qorontositti hin deebine; anis akka inni dhugaa natti baʼuuf Waaqa ofitti nan waama.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu gammachuu keessaniif isin wajjin hojjenna malee amantii keessan irratti gooftummaa hin qabnu; isin amantiin jabaattanii dhaabattaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.24",
            "verseOrgIds": [
              "2CO.1.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CO.2",
    "number": "2",
