      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:22"
      },
      "items": [
        {
          "text": "dubbii isaa illee garaatti qabadhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.22",
            "verseOrgIds": [
              "JOB.22.22"
            ]
          }
        }
      ]
    },
