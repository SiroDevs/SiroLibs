              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yeroo sanatti Waaqa Waan Hunda Dandaʼutti ni gammadda;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.26",
            "verseOrgIds": [
