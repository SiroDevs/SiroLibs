          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo namoonni gad qabamanitti ati immoo, 'Ol isaan qabi!' jetta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
