      "attrs": {
        "style": "q2",
        "vid": "JOB 22:21"
      },
      "items": [
        {
          "text": "haala kanaanis wanni gaariin siif dhufa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.21",
            "verseOrgIds": [
              "JOB.22.21"
            ]
          }
        }
      ]
    },
