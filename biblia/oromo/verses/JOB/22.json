              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo gara Waaqa Waan Hunda Dandaʼuutti deebite,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "ati ni haaromfamta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
            ]
          }
        }
      ]
