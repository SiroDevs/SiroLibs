      "attrs": {
        "style": "q2",
        "vid": "JOB 22:29"
      },
      "items": [
        {
          "text": "innis warra gad qabaman ni baraara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.29",
            "verseOrgIds": [
              "JOB.22.29"
            ]
