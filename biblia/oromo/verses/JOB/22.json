      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:23"
      },
      "items": [
        {
          "text": "yoo dunkaana kee keessaa hammina balleessitee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.23",
            "verseOrgIds": [
              "JOB.22.23"
