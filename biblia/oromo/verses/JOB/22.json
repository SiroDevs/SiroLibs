      "attrs": {
        "style": "q2",
        "vid": "JOB 22:20"
      },
      "items": [
        {
          "text": "qabeenya isaaniis ibiddi barbadeesseera.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.20",
            "verseOrgIds": [
              "JOB.22.20"
            ]
          }
        }
