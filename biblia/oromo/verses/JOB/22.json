          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Dhugumaan amajaajonni keenya balleeffamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.20",
            "verseOrgIds": [
              "JOB.22.20"
            ]
          }
        }
