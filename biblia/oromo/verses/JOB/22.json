          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaqaan walii gali; isa wajjinis nagaan jiraadhu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.21",
            "verseOrgIds": [
              "JOB.22.21"
            ]
