  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JOB 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati hokkoo qurxummiitiin Lewaataan harkiftee baasuu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:1"
      },
      "items": [
        {
          "text": "yookaan arraba isaa funyoodhaan hidhuu ni dandeessaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funyaan isaa keessa funyoo baasuu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:2"
      },
      "items": [
        {
          "text": "yookaan lafee mangaagaa isaa hokkoodhaan uruu ni dandeessaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akka ati isaaf araaramtuuf guddisee si kadhataa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:3"
      },
      "items": [
        {
          "text": "Afaan nagaatiinis sitti ni dubbataa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ati bara baraan garbicha godhattuuf",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:4"
      },
      "items": [
        {
          "text": "inni si wajjin kakuu ni galaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka simbirroota wajjin taphattu isa wajjin ni taphattaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:5"
      },
      "items": [
        {
          "text": "Yookaan shamarran keetiif isa ni hiitaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daldaltoonni isa irratti gatii wal dubbatuu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:6"
      },
      "items": [
        {
          "text": "Warra bitee gurguruufis isa ni qooduu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati gogaa isaa xiyyaan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:7"
      },
      "items": [
        {
          "text": "yookaan mataa isaa hokkoo ittiin qurxummii qabaniin",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "wawwaraanuu ni dandeessaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo harka keetiin isa tuqxe, walʼaansoo sana ni yaadatta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:8"
      },
      "items": [
        {
          "text": "deebitees waan sana hin gootu!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isa moʼanna jedhanii abdachuun soba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:9"
      },
      "items": [
        {
          "text": "ijumaan isa ilaaluunuu nama hollachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni isa dammaqsuuf garaa qabaatu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:10"
      },
      "items": [
        {
          "text": "Egaa namni na dura dhaabachuu dandaʼu eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni waa natti kennatee ani deebisuufii qabu eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:11"
      },
      "items": [
        {
          "text": "Wanni samii jala jiru hundinuu kanuma koo ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani waaʼee harkaa fi miilla isaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:12"
      },
      "items": [
        {
          "text": "waaʼee jabinaa fi dhaaba toluu isaa dubbachuu hin dhiisu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyutu uffata inni irraan uffatu irraa baasa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:13"
      },
      "items": [
        {
          "text": "Eenyutu luugama qabatee isatti dhiʼaata?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyutu balbala afaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:14"
      },
      "items": [
        {
          "text": "isa ilkaan isaa sodaachisaa sanaan marfame banuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dugdi isaa gaachanawwan tarree galan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:15"
      },
      "items": [
        {
          "text": "kanneen akka malee walitti maxxanfaman qaba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokkoon tokkoon gaachanawwan sanaa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:16"
      },
      "items": [
        {
          "text": "akka qilleensi gidduu isaanii hin baaneef baayʼee walitti maxxanu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan jabeeffamanii walitti qabsiifaman;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:17"
      },
      "items": [
        {
          "text": "waan walitti fayyaniif gargar hin baafaman.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haxxissoon isaa balaqqeessa ifaa baasa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:18"
      },
      "items": [
        {
          "text": "iji isaa immoo akkuma ifa biiftuu reefuu baatuu ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
