  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JOB 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iyyoob",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyoob akkana jedhee deebise:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.1",
            "verseOrgIds": [
              "JOB.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nama jechuun dhugumaan isin;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:2"
      },
      "items": [
        {
          "text": "ogummaanis isin wajjin duuti!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.2",
            "verseOrgIds": [
              "JOB.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu anis akkuma keessan sammuun qaba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "ani isinii gad miti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:3"
      },
      "items": [
        {
          "text": "Namni waan akkanaa hin beekne eenyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.3",
            "verseOrgIds": [
              "JOB.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani nama Waaqa waammatee deebii argate taʼu illee,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "michoota koo biratti nama kolfaa taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:4"
      },
      "items": [
        {
          "text": "Ani utuun nama qajeelaa hirʼina hin qabne taʼee jiruu nama kolfaa taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.4",
            "verseOrgIds": [
              "JOB.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri itti tole rakkinatti qoosu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:5"
      },
      "items": [
        {
          "text": "nama kufuuf miilli isaa mucucaateenis kun hiree isaati jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.5",
            "verseOrgIds": [
              "JOB.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunkaanni saamtotaa hin jeeqamu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "warri Waaqa isaanii harkatti baatanii jooran,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:6"
      },
      "items": [
        {
          "text": "warri Waaqa dheekkamsiisan nagaan jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.6",
            "verseOrgIds": [
              "JOB.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mee horii gaafadhu; isaan si barsiisu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:7"
      },
      "items": [
        {
          "text": "yookaan simbirroota samii gaafadhu; isaan sitti himu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.7",
            "verseOrgIds": [
              "JOB.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan lafatti dubbadhu; inni si barsiisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:8"
      },
      "items": [
        {
          "text": "yookaan qurxummiiwwan galaanaa sitti haa himan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.8",
            "verseOrgIds": [
              "JOB.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka harki",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JOB.12.9",
                "verseOrgIds": [
                  "JOB.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana hojjete,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:9"
      },
      "items": [
        {
          "text": "isaan kanneen hunda keessaa eenyutu hin beekne?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.9",
            "verseOrgIds": [
              "JOB.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbuun uumama hundaa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:10"
      },
      "items": [
        {
          "text": "hafuurri nama hundaas harka isaa keessa jira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.10",
            "verseOrgIds": [
              "JOB.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma arrabni nyaata afaaniin qabu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:11"
      },
      "items": [
        {
          "text": "gurris dubbii dhagaʼee addaan hin baasuu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.11",
            "verseOrgIds": [
              "JOB.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogummaan jaarsolii biratti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:12"
      },
      "items": [
        {
          "text": "hubannaanis warra umuriin dheerate biratti argama mitii?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.12",
            "verseOrgIds": [
              "JOB.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ogummaa fi humni kan Waaqaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:13"
      },
      "items": [
        {
          "text": "gorsii fi hubannaanis kan isaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.13",
            "verseOrgIds": [
              "JOB.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan inni diigu eenyu iyyuu deebisee ijaaruu hin dandaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:14"
      },
      "items": [
        {
          "text": "nama inni hidhe eenyu iyyuu hiikuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.14",
            "verseOrgIds": [
              "JOB.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo inni bishaan dhowwate, hongeetu buʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:15"
      },
      "items": [
        {
          "text": "yoo inni gad dhiise immoo biyya balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.15",
            "verseOrgIds": [
              "JOB.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabinnii fi ogummaan kan isaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:16"
      },
      "items": [
        {
          "text": "namni gowwoomfamuu fi inni gowwoomsus kanuma isaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.16",
            "verseOrgIds": [
              "JOB.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gorsitoota qullaa deemsisa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.12.17",
            "verseOrgIds": [
              "JOB.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 12:17"
      },
      "items": [
        {
          "text": "abbootii murtiis gowwoota godha.",
