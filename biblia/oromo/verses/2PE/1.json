  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nagaa Gaafachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoon Phexros garbichaa fi ergamaa Yesuus Kiristoos irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "2PE 1:1"
      },
      "items": [
        {
          "text": "Gara warra karaa qajeelummaa Waaqa keenyaa fi Fayyisaa keenya Yesuus Kiristoosiin amantii akkuma amantii keenyaa gatii guddaa qabu sana argattaniitti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beekumsa Waaqaatii fi beekumsa Gooftaa keenya Yesuusiin ayyaannii fi nagaan isiniif haa baayʼatu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waamamuu fi Filatamuu Ofii Mirkaneeffachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humni waaqummaa isaa karaa isa ulfina isaatii fi gaarummaa isaatiin nu waame sana beekuu keenyaatiin waan jireenyaa fi Waaqatti buluuf nu barbaachisu hundumaa nuuf kenneera.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kennaa kanaanis isin badiisa sababii hawwii hamaatiin addunyaa keessa jiru jalaa baatanii akka amala waaqummaa isaa sana keessatti hirmaattaniif jedhee karaa kennaa kanaatiin waadaa isaa guddaa fi kan gatii guddaa qabu nuuf galeera.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababuma kanaaf amantii keessan irratti gaarummaa, gaarummaa irrattis beekumsa dabalachuuf waan isinii dandaʼame hunda godhaa;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.5",
            "verseOrgIds": [
              "2PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasuma beekumsa irratti of qabuu, of qabuu irratti obsaan dhaabachuu, obsaan dhaabachuu irratti Waaqatti buluu,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.6",
            "verseOrgIds": [
              "2PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqatti buluu irratti jaalala obbolummaa, jaalala obbolummaa irratti immoo jaalala dhugaa dabaladhaa.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.7",
            "verseOrgIds": [
              "2PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isin waan kana hunda qabaattanii ittuma isinii baayʼachaa deeme, wanni kun akka isin Gooftaa keenya Yesuus Kiristoos beekuu keessatti dadhaboo fi buʼaa dhabeeyyii hin taane isin godha.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.8",
            "verseOrgIds": [
              "2PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu namni waan kana hin qabne kam iyyuu jaamaa dha; fagoottis arguu hin dandaʼu; cubbuu isaa durii sana irraa qulqulleeffamuu isaa irraanfateera.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.9",
            "verseOrgIds": [
              "2PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf yaa obboloota ko, waamamuu fi filatamuu keessan mirkaneeffachuuf caalaatti hinaaffaa qabaadhaa. Yoo waan kana gootan isin hin gufattan;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.10",
            "verseOrgIds": [
              "2PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasiin gara mootummaa bara baraa kan Gooftaa keenyaa fi Fayyisaa keenya Yesuus Kiristoositti galuun guutummaatti isiniif kennama.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raajii Katabbii Qulqulluu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin wantoota kanneen beektanii, dhugaa amma qabdan kanatti jabaatanii dhaabattanii iyyuu ani yeroo hunda wantoota kanneen isin yaadachiisuu nan barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani hamman dunkaana kana keessa jirutti waan kana isin yaadachiisuudhaan isin dammaqsuu koo qajeelaa nan seʼa;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani akka Gooftaan keenya Yesuus Kiristoos naaf ibsetti, dunkaana koo kana akkan dafee of irraa baasu beekaatii.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka isin erguma ani isin biraa godaanee booddee yeroo hunda waan kana yaadachuu dandeessan gochuuf nan carraaqa.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu yommuu waaʼee humnaa fi dhufaatii Gooftaa keenya Yesuus Kiristoos isinitti himnetti, surraa isaa ijuma keenyaan argineeti malee oduu haxxummaadhaan uumame duukaa buunee miti.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yommuu sagaleen, \"Kun Ilma koo isa ani jaalladhuu dha; ani isatti baayʼee nan gammada\"",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "text": "jedhu sun Ulfina Surra qabeessa sana biraa dhufeefitti, Waaqa Abbaa biraa kabajaa fi ulfina argateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu mataan keenya iyyuu yeroo isa wajjin tulluu qulqulluu irra turretti, utuu sagaleen kun samii irraa dhufuu dhageenye.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dubbiin raajonni dubbatan sun ittuma caalee nuuf mirkaneeffame; isinis hamma boruun baqaqee bakkalchi barii garaa keessan keessatti baʼutti yoo akkuma ibsaa dukkana keessatti ibsuutti dubbii kanaaf xiyyeeffannoo kennitan waan gaarii gochuu keessan.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajiin Katabbii Qulqulluu kam iyyuu hiikkaa raajichaa kan mataa isaatiin akka hin dhufin duraan dursitanii beekuu qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajiin takkumaa fedhii namaatiin hin dhufneetii; garuu namoota Waaqaatu Hafuura Qulqulluudhaan geggeeffamee dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
  ],
