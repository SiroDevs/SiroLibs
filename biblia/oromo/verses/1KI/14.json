  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raajii Ahiiyaan Yerobiʼaamiin Mormee Dubbate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana Abiyaan ilmi Yerobiʼaam dhukkubsannaan",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.1",
            "verseOrgIds": [
              "1KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobiʼaam niitii ofii isaatiin akkana jedhe; \"Ati niitii Yerobiʼaam taʼuun kee akka hin beekneef eenyummaa kee dhoksiitii kaʼii Shiiloo dhaqi. Ahiiyaan raajichi akka ani saba kana irratti mootii taʼu natti hime sun achi jiraatii.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.2",
            "verseOrgIds": [
              "1KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buddeena kudhan, maxinoo muraasaa fi damma okkotee tokko harkatti qabadhuu gara isaa dhaqi. Inni waan gurbaan kun taʼu sitti hima.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.3",
            "verseOrgIds": [
              "1KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu niitiin Yerobiʼaam waan inni jedheen sana gootee gara mana Ahiiyaa Shiiloo dhaqxe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 14:4"
      },
      "items": [
        {
          "text": "Yeroo sana Ahiiyaan homaa hin argu ture; inni waan dulloomeef agartuun isaa dadhabee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.4",
            "verseOrgIds": [
              "1KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.5",
                "verseOrgIds": [
                  "1KI.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu Ahiiyaadhaan akkana jedhe; \"Niitiin Yerobiʼaam sababii ilmi ishee dhibameef waaʼee isaa si gaafachuuf dhufuutti jirti; ati akkanaa fi akkana jedhii deebisiif. Isheen yommuu dhuftu nama biraa of fakkeessitee dhufti.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.5",
            "verseOrgIds": [
              "1KI.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiiyaan sagalee faana ishee dhageenyaan balbala irratti akkana jedheen; \"Yaa niitii Yerobiʼaam ol seeni. Dubartii biraa of fakkeessuu yaaluun kee kun maaliif? Ani ergaa hamaa sitti himuuf ergameera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.6",
            "verseOrgIds": [
              "1KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaqiitii",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.7",
                "verseOrgIds": [
                  "1KI.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel akkana jedha jedhiitii Yerobiʼaamitti himi: 'Ani saba keessaa si kaafadheen bulchaa saba koo Israaʼel si godhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.7",
            "verseOrgIds": [
              "1KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani mana Daawit irraa mootummaa tarsaaseen siif kenne; ati garuu akka garbicha koo Daawit kan ajajawwan koo eegee garaa isaa guutuun na duukaa buʼee waan fuula koo duratti qajeelaa taʼe qofa hojjete sanaa hin taane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.8",
            "verseOrgIds": [
              "1KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati warra siin dura jiraatan hunda caalaa waan hamaa hojjetteerta. Ati ofii keetiif waaqota biraa fakkiiwwan baqfamanii hojjetaman tolfattee dheekkamsaaf na kakaafte; dugda kee duubattis na gatte.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.9",
            "verseOrgIds": [
              "1KI.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Sababii kanaaf ani amma mana Yerobiʼaam irratti badiisa nan fida. Ani mana Yerobiʼaamii dhiira hunda, garbicha yookaan birmaduu Israaʼel keessaa nan balleessa. Ani akkuma namni tokko kosii gubee barbadeessutti mana Yerobiʼaam gubeen barbadeessa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.10",
            "verseOrgIds": [
              "1KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama maatii Yerobiʼaam taʼe kam iyyuu kan magaalaa keessatti duʼe sareetu nyaata; kan baadiyyaatti duʼe kam iyyuu immoo allaattii samiitu nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.11",
                "verseOrgIds": [
                  "1KI.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana dubbateeraatii!'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.11",
            "verseOrgIds": [
              "1KI.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati garuu mana keetti gali. Yeroo miilli kee magaalaa seenutti mucaan sun ni duʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.12",
            "verseOrgIds": [
              "1KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Israaʼel hundinuu booʼaniifii isa ni awwaalu. Waan",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.13",
                "verseOrgIds": [
                  "1KI.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel mana Yerobiʼaam keessaa isa qofa irratti waan gaarii argeef, mana Yerobiʼaam keessaa namni awwaala argatu isa qofa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.13",
            "verseOrgIds": [
              "1KI.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.14",
                "verseOrgIds": [
                  "1KI.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼel irratti mootii tokko ofii isaatiif ni kaafata; mootiin sunis maatii Yerobiʼaam kutee balleessa. Guyyaan isaas harʼa! Kunis ammuma taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.14",
            "verseOrgIds": [
              "1KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.15",
                "verseOrgIds": [
                  "1KI.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼelin dhaʼee akkuma shambaqqoo bishaan keessaatti ni raasa. Sababii isaan utubaawwan Aasheeraa dhadhaabanii",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.15",
                "verseOrgIds": [
                  "1KI.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dheekkamsiisaniif inni biyya abbootii isaaniitiif kenne gaarii sana keessaa Israaʼelin buqqisee Laga Efraaxiisiin gamatti isaan ni bittinneessa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.15",
            "verseOrgIds": [
              "1KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis sababii cubbuu Yerobiʼaam hojjetee akka Israaʼelis hojjetu godhe sanaatiif saba Israaʼel ni gata.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.16",
            "verseOrgIds": [
              "1KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin Yerobiʼaam kaatee Tiirzaa dhaqxe. Akkuma isheen gulantaa balbalaa geesseen mucaan sun ni duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.17",
            "verseOrgIds": [
              "1KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris isa awwaalan; Israaʼel hundinuus akkuma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.14.18",
                "verseOrgIds": [
                  "1KI.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa garbicha isaa Ahiiyaa raajichaatiin dubbate sana ni booʼaniif.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.18",
            "verseOrgIds": [
              "1KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni Yerobiʼaam hojjete kan biraa, akki inni itti lolaa turee fi akki inni itti biyya bulchaa ture kitaaba seenaa mootota Israaʼel keessatti barreeffameera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.19",
            "verseOrgIds": [
              "1KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis waggaa digdamii lama bulchee ergasii abbootii isaa wajjin boqote. Ilmi isaa Naadaab mootii taʼee iddoo isaa buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.20",
            "verseOrgIds": [
              "1KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rehooboʼaam Mooticha Yihuudaa",
          "type": "text"
        }
      ]
    },
