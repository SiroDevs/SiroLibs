  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iddoo Dhaaba Wayinii Naabot",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabot namichi Yizriʼeel tokko Yizriʼeel keessaa, masaraa mootummaa Ahaab mooticha Samaariyaa biraa iddoo dhaabaa wayinii qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.1",
            "verseOrgIds": [
              "1KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaabis Naabotiin akkana jedhe; \"Sababii inni masaraa mootummaa kootti dhiʼaatuuf akka ani achi irra biqiltuu dhaabbadhuuf iddoo dhaabaa wayinii keetii naaf kenni. Qooda isaa ani iddoo dhaabaa wayinii kan isa caalu yookaan yoo ati feete gatii isaa maallaqa siifin kennaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.2",
            "verseOrgIds": [
              "1KI.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabot garuu, \"Dhaala abbootii koo siif kennuu irraa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.3",
                "verseOrgIds": [
                  "1KI.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na haa eegu\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu sababii Naabot namichi Yizriʼeel sun \"Ani dhaala abbootii koo siif hin kennu\" jedheef Ahaab akka malee aaree dheekkamaa gara mana isaatti gale. Innis fuula isaa garagalfatee siree isaa irra ciise; waa nyaachuus ni dide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.4",
            "verseOrgIds": [
              "1KI.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iizaabel niitiin isaas ol seentee, \"Ati maaliif akkana aarta? Maaliif waa hin nyaanne?\" jettee isa gaafatte.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.5",
            "verseOrgIds": [
              "1KI.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebiseef; \"Sababii Naabot namichi Yizriʼeel sun, ani, 'Iddoo dhaabaa wayinii keetii natti gurguri, yookaan yoo ati feete qooda isaa iddoo dhaabaa wayinii biraa siifin kenna' jennaaniin inni immoo, 'Ani iddoo dhaabaa wayinii koo siif hin kennu' naan jedheef.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.6",
            "verseOrgIds": [
              "1KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin isaa Iizaabelis, \"Ati amma mootii Israaʼelii? Kaʼii buddeena nyaadhu! Gammadis. Ani iddoo dhaabaa wayinii Naabot namicha Yizriʼeel sanaa siifin kennaa\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.7",
            "verseOrgIds": [
              "1KI.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isheen maqaa Ahaabiin xalayoota barreessitee chaappaa isaatiin chaappeessitee maanguddootaa fi namoota bebeekamoo magaalaa Naabot keessa isa wajjin jiraatanitti ergite.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.8",
            "verseOrgIds": [
              "1KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xalayoota sana keessattis akkana jettee barreessite:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 21:9"
      },
      "items": [
        {
          "text": "\"Guyyaa soomaa tokko labsaatii akka Naabot waldaa keessa iddoo ol aanu taaʼu godhaa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoota kashlabboota lama fuula isaa dura teessisaatii akka isaan akka inni Waaqaa fi mooticha abaare itti rageessan godhaa. Ergasiis gad baasaatii dhagaadhaan tumaa isa ajjeesaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu maanguddoonnii fi namoonni bebbeekamoon magaalaa Naabot keessa jiraatan akkuma Iizaabel xalayoota barreessiteef keessatti isaan ajajje sana godhan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.11",
            "verseOrgIds": [
              "1KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis sooma labsanii akka Naabot waldaa keessa iddoo ol aanu taaʼu godhan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.12",
            "verseOrgIds": [
              "1KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Kashlabboonni lama dhufanii fuula isaa dura tataaʼanii, \"Naabot Waaqaa fi mooticha abaareera\" jedhanii namoota duratti itti rageessan. Kanaafis magaalaa keessaa gad baasanii dhagaadhaan tumanii isa ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.13",
            "verseOrgIds": [
              "1KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii isaan, \"Naabot dhagaan tumamee duʼeera\" jedhanii Iizaabelitti ergaa ergan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iizaabelis akkuma akka Naabot dhagaan tumamee duʼe dhageesseen Ahaabiin, \"Kaʼiitii iddoo dhaabaa wayinii Naabot namichi Yizriʼeel sitti gurguruu dide sana dhaali. Inni lubbuun hin jiru; duʼeeraa\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaabis akka Naabot duʼe dhageenyaan iddoo dhaabaa wayinii Naabot sana dhaaluuf kaʼee gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.17",
                "verseOrgIds": [
                  "1KI.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Eeliyaas namicha Tishbii sanaa dhufe;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ahaab mooticha Israaʼel kan Samaariyaa keessa taaʼee bulchu sana arguuf gad buʼi. Inni amma lafa qotiisaa sana dhaaluuf gad buʼee iddoo dhaabaa wayinii Naabot keessa jira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
            "verseOrgIds": [
              "1KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atis akkana jedhiin: '",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.19",
                "verseOrgIds": [
                  "1KI.21.19"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; ati nama tokko ajjeeftee qabeenya isaa hin dhaallee?' Ergasiis akkana jedhiin; '",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.19",
                "verseOrgIds": [
                  "1KI.21.19"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Iddoo sareen dhiiga Naabot arraabde sanatti sareen dhiiga kees ni arraabdi; eeyyee dhugumaan dhiiga kees ni arraabdi!' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaabis Eeliyaasiin, \"Yaa diina ko, ati na argatteerta!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 21:20"
      },
      "items": [
        {
          "text": "Innis deebisee akkana jedheen; \"Sababii ati fuula",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.20",
                "verseOrgIds": [
                  "1KI.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjechuuf of gurgurteef ani si argadheera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ani badiisa sitti nan fida. Sanyii kee illee nan balleessa; dhiira mana Ahaab, garbas taʼu birmaduu hunda Israaʼel keessaa nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.21",
            "verseOrgIds": [
              "1KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii ati aariif na kakaaftee fi akka Israaʼel cubbuu hojjetu gooteef ani mana kee akkuma mana Yerobiʼaam ilma Nebaat sanaatii fi akkuma mana Baʼishaan ilma Ahiiyaa sanaa nan godha.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.22",
            "verseOrgIds": [
              "1KI.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaʼee Iizaabelis",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.23",
                "verseOrgIds": [
                  "1KI.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'Dallaa dhagaa Yizriʼeel biratti saroonni Iizaabelin ni nyaatu.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nama Ahaab kan magaalaa keessatti duʼu kam iyyuu sareetu nyaata; kan baadiyyaatti duʼu immoo allaattii samiitu nyaata.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni akka Ahaab isa niitii ofii isaa Iizaabeliin kakaafamee fuula",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.25",
                "verseOrgIds": [
                  "1KI.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjechuudhaaf of gurgure sanaa gonkumaa hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma Amoorota kanneen",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.26",
                "verseOrgIds": [
                  "1KI.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "saba Israaʼel duraa ariʼee baase sanaa waaqota tolfamoo duukaa buʼuudhaan waan akka malee jibbisiisaa taʼe hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaab yommuu dubbii kana dhagaʼetti uffata isaa tarsaasee, wayyaa gaddaa uffatee soome. Innis wayyaa gaddaatiin ciisaa, mataa buusees deemaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoos",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.28",
                "verseOrgIds": [
                  "1KI.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Eeliyaas namicha Tishbii sanaa dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati akka Ahaab fuula koo duratti gad of qabe argitee? Sababii inni gad of qabeef ani balaa kana bara isaa keessa hin fidu; garuu bara ilma isaa keessa mana isaatti nan fida.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
    }
