              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon waggaatti yeroo sadii aarsaa gubamuu fi aarsaa nagaa iddoo aarsaa kan",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
