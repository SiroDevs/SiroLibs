                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ijaare sana irratti dhiʼeessa ni ture; sana wajjinis, fuula",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
