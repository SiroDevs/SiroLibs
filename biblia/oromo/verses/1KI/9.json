              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon mootichi amma illee Eziyoon Geber ishee biyya Edoom keessa, Eelooti bira jirtu keessatti qarqara Galaana Diimaatti dooniiwwan hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
