              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis erga intalli Faraʼoon sun Magaalaa Daawit keessaa gara masaraa mootummaa kan Solomoon isheef ijaare sana dhuftee booddee Miiloo ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        }
      ]
    },
    {
