        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni garuu ni dide; qooda kanaa hamma inni gatii isaa kaffalutti mana hidhaatti isa galchisiise.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.30",
                "verseOrgIds": [
                  "MAT.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garboonni kaan yommuu waan taʼe sana arganitti akka malee gaddan; dhaqaniis waan taʼe hundumaa gooftaa isaaniitti himan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.31",
                "verseOrgIds": [
                  "MAT.18.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gooftichis garbicha sana ofitti waamee akkana jedheen; 'Yaa garbicha hamaa! Ani sababii ati na kadhatteef gatii sirra ture hunda siif dhiise.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.32",
                "verseOrgIds": [
                  "MAT.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkuma ani garaa siif laafe sana atis garbicha akka keetiitiif garaa laafuu hin qabduu?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.33",
                "verseOrgIds": [
                  "MAT.18.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gooftaan isaas aariidhaan hamma inni gatii sana hunda kaffalutti warra isa dhiphisanitti dabarsee isa kenne.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.34",
                "verseOrgIds": [
                  "MAT.18.34"
                ]
              }
            }
          ]
        }
