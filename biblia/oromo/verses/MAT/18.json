              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garbichi sunis miilla isaatti kufee, 'Yaa gooftaa, naaf obsi; hunduma isaa iyyuu siif nan kaffalaa' jedhee isa kadhate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.26",
                "verseOrgIds": [
                  "MAT.18.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gooftaan garbicha sanaas garaa laafeef; gatii isa irraa qabus dhiiseefii gad isa lakkise.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.27",
                "verseOrgIds": [
                  "MAT.18.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garbichi sun garuu akkuma achii baʼeen garbicha akka isaa kan gatii diinaarii",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.28",
                "verseOrgIds": [
                  "MAT.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "dhibbaa irraa qabu tokko arge. Innis morma namichaa hudhee qabee, 'Waan ani sirraa qabu naa kaffali' jedheen.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.28",
                "verseOrgIds": [
                  "MAT.18.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
