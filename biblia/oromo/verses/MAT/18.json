          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Garbichi akka isaa sunis miilla isaatti kufee, 'Naaf obsi; waan narra jiru siif nan kaffalaa' jedhee isa kadhate.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.29",
                "verseOrgIds": [
                  "MAT.18.29"
                ]
              }
            }
          ]
        }
