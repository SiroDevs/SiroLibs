                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeruma sana barattoonni gara Yesuus dhufanii, \"Yoos mootummaa samii keessatti kan hundumaa caalu eenyu?\" jedhanii gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mucaa xinnaa tokko ofitti waamee isaan gidduu dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani dhuguman isinitti hima; isin yoo deebitanii akkuma ijoollee taatan malee gonkumaa mootummaa samiitti hin galtan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.3",
                "verseOrgIds": [
                  "MAT.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaaf namni akka daaʼima kanaa gad of qabu kam iyyuu mootummaa samii keessatti nama hunda caala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.4",
                "verseOrgIds": [
                  "MAT.18.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni daaʼima akkanaa tokko maqaa kootiin simatu kam iyyuu na simata.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.5",
                "verseOrgIds": [
                  "MAT.18.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namni kam iyyuu warra natti amanan xixinnaa kanneen keessaa tokko illee yoo gufachiise, dhagaan daakuu guddaan morma isaatti hidhamee tuujuba galaanaa keessa dhidhimuu isaaf wayya ture.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.6",
                "verseOrgIds": [
                  "MAT.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sababii wantoota akka namoonni gufatan godhan sanaatiif addunyaaf wayyoo! Wantoonni akkanaa dhufuu qabu; garuu nama wantoonni kunneen karaa isaatiin dhufan sanaaf wayyoo!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.7",
                "verseOrgIds": [
                  "MAT.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.7",
            "verseOrgIds": [
              "MAT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo harki kee yookaan miilli kee si gufachiise, of irraa kutii gati. Harka lama yookaan miilla lama qabaattee ibidda bara baraatti darbatamuu irra, dooluu taatee yookaan laamshoftee jireenyatti galuu siif wayya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.8",
                "verseOrgIds": [
                  "MAT.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.8",
            "verseOrgIds": [
              "MAT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo iji kee si gufachiise of keessaa baasii gati. Ija lama qabaattee ibidda gahaannamiitti darbatamuu irra ija tokko qabaattee jireenyatti galuu siif wayya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.9",
                "verseOrgIds": [
                  "MAT.18.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Hoolaa Badee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.18.12-MAT.18.14"
          },
          "items": [
            {
              "text": "18:12‑14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.15.4-LUK.15.7"
              },
              "items": [
                {
                  "text": "Luq 15:4‑7",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Warra xixinnaa kanneen keessaa tokko illee akka hin tuffanneef of eeggadhaa. Ani isinitti nan hima; ergamoonni isaanii samii irratti yeroo hunda fuula Abbaa koo isa samii irraa ni arguutii.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.10",
                "verseOrgIds": [
                  "MAT.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.10",
            "verseOrgIds": [
              "MAT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ilmi Namaa isa bade oolchuudhaaf dhufeetii.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.11",
                "verseOrgIds": [
                  "MAT.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": "]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.11",
            "verseOrgIds": [
              "MAT.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin maal seetu? Namni tokko yoo hoolota dhibba qabaatee hoolota sana keessaas tokko bade, namichi sun sagaltamii sagallan hafan kaan tulluuwwan irratti dhiisee tokkicha bade sana barbaaduu hin dhaquu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.12",
                "verseOrgIds": [
                  "MAT.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.12",
            "verseOrgIds": [
              "MAT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani dhuguman isinitti hima; inni yoo hoolaa sana argate, hoolota sagaltamii sagallan hin badin irra hoolaa tokkicha sanatti caalaa ni gammada.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.13",
                "verseOrgIds": [
                  "MAT.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.13",
            "verseOrgIds": [
              "MAT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkasuma immoo isaan xixinnoo kanneen keessaa tokko iyyuu akka badu fedhii Abbaa keessan isa samii irraa miti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.14",
                "verseOrgIds": [
                  "MAT.18.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cubbuu Walitti Hojjechuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yoo obboleessi kee cubbuu sitti hojjete, dhaqiitii iddoo isin lamaan qofti jirtanitti balleessaa isaa itti himi. Yoo inni si dhagaʼe ati obboleessa kee deebifatteerta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.15",
                "verseOrgIds": [
                  "MAT.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo si dhagaʼuu baate garuu 'dubbiin hundinuu dhuga baatota lamaan yookaan sadiin waan mirkaneeffamuuf' nama biraa tokko yookaan nama lama fudhadhuu dhaqi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.16",
                "verseOrgIds": [
                  "MAT.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo inni jara dhagaʼuu dide waldaa kiristaanaatti himi; yoo inni waldaa kiristaanaa iyyuu dhagaʼuu dide akka nama ormaattii fi akka qaraxxuutti isa fudhadhu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.17",
                "verseOrgIds": [
                  "MAT.18.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani dhuguman isinitti hima; wanni isin lafa irratti hiitan kam iyyuu samii irratti ni hidhama; wanni isin lafa irratti hiiktan kam iyyuu samii irrattis ni hiikama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.18",
                "verseOrgIds": [
                  "MAT.18.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ammas ani isinitti nan hima; isin keessaa yoo namoonni lama lafa irratti waaʼee waan kadhatan kamii iyyuu walii galan Abbaan koo inni samii irraa isaaniif taasisa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.19",
                "verseOrgIds": [
                  "MAT.18.19"
                ]
              }
