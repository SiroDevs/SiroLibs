        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iddoo itti namoonni lama yookaan sadii maqaa kootiin walitti qabamanitti ani gidduu isaaniitti nan argamaatii.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.20",
                "verseOrgIds": [
                  "MAT.18.20"
                ]
              }
            }
          ]
