        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isinis yoo garaa keessan guutuudhaan obboleessa keessaniif dhiisuu baattan Abbaan koo inni samii irraa tokkoo tokkoo keessan akkanuma godha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.35",
