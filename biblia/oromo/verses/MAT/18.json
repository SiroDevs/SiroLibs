    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tajaajilaa Dhiifama Hin Goone Tokko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Phexros gara Yesuus dhufee, \"Yaa Gooftaa, yoo obboleessi koo cubbuu natti hojjete ani yeroo hammam dhiisaaf? Hamma yeroo torbaattii?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee deebiseef;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani sitti nan hima; yeroo torbaatamii torba malee yeroo torba miti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.22",
                "verseOrgIds": [
                  "MAT.18.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kanaafuu mootummaan samii mootii herrega garboota isaa harka jiru toʼachuu barbaade tokko fakkaata.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.23",
                "verseOrgIds": [
                  "MAT.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkuma inni herrega isaa toʼachuu jalqabeenis nama mootichi taalaantii kuma kudhan irraa qabu tokko itti fidan.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.24",
                "verseOrgIds": [
                  "MAT.18.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namichi sun waan baasu dhabnaan gooftaan isaa akka inni, niitiin isaa, ijoolleen isaatii fi wanni inni qabu hundinuu gurguramanii gatiin sun kaffalamu ajaje.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.18.25",
                "verseOrgIds": [
                  "MAT.18.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
