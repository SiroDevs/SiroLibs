            "id": "MAT.18.1-MAT.18.5"
          },
          "items": [
            {
              "text": "18:1‑5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.9.33-MRK.9.37"
              },
              "items": [
                {
                  "text": "Mar 9:33‑37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.9.46-LUK.9.48"
