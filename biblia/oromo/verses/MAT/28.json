        "style": "s1"
      },
      "items": [
        {
          "text": "Duʼaa Kaʼuu Yesuus",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
