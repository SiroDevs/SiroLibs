    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbata booddee, guyyaa jalqaba torban sanaa Maariyaam isheen Magdalaatii fi Maariyaam isheen kaan barii barraaqaan awwaala ilaaluu dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.1",
            "verseOrgIds": [
              "MAT.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, sababii ergamaan Gooftaa samii irraa gad buʼee gara awwaalaa dhaqee balbala awwaalaa irraa dhagaa sana garagalchee irra taaʼeef, sochiin lafaa guddaan taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.2",
            "verseOrgIds": [
              "MAT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bifti isaa ifaa akka bakakkaa, uffanni isaa immoo adii akka cabbii ture.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.3",
            "verseOrgIds": [
              "MAT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waardiyyoonni sunis sababii isa sodaataniif hollatanii akkuma nama duʼee taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.4",
            "verseOrgIds": [
              "MAT.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan sunis dubartoota sanaan akkana jedhe; \"Hin sodaatinaa! Akka isin Yesuus isa fannifamee ture sana barbaaddan anuu beeka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.5",
            "verseOrgIds": [
              "MAT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni as hin jiru; akkuma jedhe sana duʼaa kaʼeeraatii. Kottaatii iddoo inni ciisaa ture ilaalaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.6",
            "verseOrgIds": [
              "MAT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa dafaa dhaqaatii akkana jedhaa barattoota isaatti himaa; 'Inni warra duʼan keessaa kaʼeera; kunoo, inni isin dursee Galiilaa ni dhaqa. Achittis isa ni argitu.' Kunoo ani isinitti himeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartoonni sunis sodaatanii, taʼus gammachuu guddaan guutamanii ariitiidhaan awwaala sana biraa deeman; barattoota isaatti himuufis fiigan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.8",
            "verseOrgIds": [
              "MAT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeruma sana kunoo Yesuus isaanitti dhufee, nagaa isaan gaafate. Isaanis isatti dhiʼaatanii miilla isaa qabatanii sagadaniif.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.9",
            "verseOrgIds": [
              "MAT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hin sodaatinaa! Dhaqaatii akka isaan gara Galiilaa deemaniif obboloota kootti himaa; isaanis achitti na argu\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.28.10",
                "verseOrgIds": [
                  "MAT.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gabaasa Waardiyyootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu dubartoonni sun karaa jiranuu waardiyyoota sana keessaa tokko tokko magaalaa seenanii waan taʼe hunda luboota hangafootatti himan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.11",
            "verseOrgIds": [
              "MAT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni hangafoonnis erga maanguddoota wajjin walitti qabamanii mariʼatanii booddee loltootaaf maallaqa hedduu kennan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.12",
            "verseOrgIds": [
              "MAT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas jedhaniin; \" 'Utuu nu rafnuu barattoonni isaa halkaniin dhufanii isa hatan' jedhaatii namootatti himaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.13",
            "verseOrgIds": [
              "MAT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo wanni kun gurra bulchaa seene nu isa amansiifnee rakkina jalaa isin baafnaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonnis maallaqa sana fudhatanii akkuma ajajaman godhan. Oduun kunis hamma harʼaatti Yihuudoota biratti odeeffamaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.15",
            "verseOrgIds": [
              "MAT.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ergama Guddicha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni kudha tokkoon sun gara biyya Galiilaa, gara tulluu Yesuus dhaqaa isaaniin jedhee ture sanaa dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis yommuu isa arganitti ni sagadaniif; isaan keessaa tokko tokko garuu ni maman.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.17",
            "verseOrgIds": [
              "MAT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo isaanitti dhiʼaatee akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Taayitaan hundinuu samii fi lafa irratti naa kennameera.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.28.18",
                "verseOrgIds": [
                  "MAT.28.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaaf dhaqaatii saba hundumaa maqaa Abbaatti, maqaa Ilmaatti, maqaa Hafuura Qulqulluuttis cuuphaatii barattoota taasisaa;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.28.19",
                "verseOrgIds": [
                  "MAT.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.19",
            "verseOrgIds": [
              "MAT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "akka waan ani isin ajaje hunda eeganiifis isaan barsiisaa. Kunoo, ani hamma dhuma addunyaatti guyyaa hunda isin wajjinan jira.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.28.20",
                "verseOrgIds": [
                  "MAT.28.20"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
