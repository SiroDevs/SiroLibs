  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1TI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Garboota",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka maqaan Waaqaatii fi barsiisni keenya hin arrabsamneef warri waanjoo garbummaa jala jiran hundinuu akka ulfinni guutuun gooftota isaaniitiif malutti haa ilaalan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri gooftota amanan qabanis sababii isaan obboloota taʼaniif isaan hin tuffatin. Qooda kanaa warri tajaajila isaaniitiin fayyadaman sun waan isaan amantootaa fi jaallatamtoota taʼaniif ittuma cimsanii isaan haa tajaajilan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1TI 6:2"
      },
      "items": [
        {
          "text": "Barsiistota Sobaa fi Jaalala Maallaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1TI 6:2"
      },
      "items": [
        {
          "text": "Atis waan kana barsiisi; gorsis.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eenyu iyyuu yoo barsiisa addaa barsiise, yoo dubbii dhugaa kan Gooftaa keenya Yesuus Kiristoosii fi barsiisa nama Waaqaa taʼuuf fayyaduun walii hin galle,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni of tuulummaan guutameera; waan tokko iyyuus hin hubatu. Inni waaʼee jechootaa irratti morkii fi lolaaf fedhii hamaa qaba; kunis hinaaffaa, wal dhabuu, arrabsoo fi shakkii hamaa fida;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoota qalbiin isaanii badee dhugaanis irraa fudhatame kanneen Waaqatti buluu karaa ittiin maallaqni argamu seʼan gidduuttis walitti buʼiisa dhuma hin qabnetu uumama.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqatti buluun, \"Wanni ani qabu na gaʼa\" jechuu of keessaa qabaannaan kun dhugumaan faayidaa guddaa qaba.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu waan tokko illee gara addunyaatti waan hin fidiniif, waan tokko illee addunyaa keessaa fudhachuu hin dandeenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
            "verseOrgIds": [
              "1TI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu waan nyaannuu fi waan uffannu qabaannaan nu gaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri sooromuu barbaadan garuu qorumsaa fi kiyyoo, hawwii gowwummaa fi miidhaa baayʼee fidu kan diigamaa fi badiisatti nama dhidhimsu keessatti kufu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maallaqa jaallachuun hidda hammina gosa hundumaatii. Namoonni tokko tokko akka malee maallaqa jaallachuun amantii irraa badanii dhiphina baayʼeen of waraananiiru.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gorsa Xiimotewosiif Kenname Kan Dhumaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati garuu yaa nama Waaqaa, waan kana hunda irraa baqadhu; qajeelummaa, Waaqatti buluu, amantii, jaalala, obsaa fi garraamummaa duukaa buʼi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
              "1TI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walʼaansoo amantii gaarii sana qabi. Jireenya bara baraa kan yeroo fuula dhuga baatota baayʼee duratti akka gaarii beeksiftetti itti waamamte sana jabeessii qabadhu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
            "verseOrgIds": [
              "1TI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani fuula Waaqa waan hundaaf jireenya kennuu duratti, fuula Kiristoos Yesuus kan yommuu Phonxoos Phiilaaxoos duratti dhugaa baʼetti akka gaarii beeksise sanaa durattis,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka ati hamma dhufaatii Gooftaa keenya Yesuus Kiristoositti ajaja kana xurii fi mudaa malee eegdus sin gorsa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
            "verseOrgIds": [
              "1TI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni eebbifamaanii fi Bulchaan tokkichi, Mootiin moototaa fi Gooftaan gooftotaa yeroo isaatti waan kana ni mulʼisa;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.15",
            "verseOrgIds": [
              "1TI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kan hin duune isa qofa; innis ifa namni tokko iyyuu itti dhiʼaachuu hin dandeenye keessa jiraata; eenyu iyyuu isa hin argine; isa arguus hin dandaʼu. Ulfinii fi humni bara baraan isaaf haa taʼu. Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka sooreyyiin addunyaa kanaa of tuuluu yookaan qabeenya badu abdachuu dhiisanii Waaqa akka nu itti gammannuuf jedhee waan hunda baayʼisee nuu kennu sana abdataniif isaan ajaji.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.17",
            "verseOrgIds": [
              "1TI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan waan gaarii hojjetan, akka badhaadhummaan isaanii hojii gaarii taʼu, akka arjooman, akka waan qabanis qooduuf fedhii qabaatan isaan ajaji.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.18",
            "verseOrgIds": [
              "1TI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis karaa kanaan jireenya dhugumaan jireenya taʼe qabaachuuf jedhanii badhaadhummaa hundee jabaa taʼu bara dhufuuf jiruuf ofii isaaniitii kuufatu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.19",
            "verseOrgIds": [
              "1TI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Xiimotewos, waan imaanaa sitti kenname jabeessii eegi. Oduu Waaqni hin jaallannee fi yaada mormii kan sobaan \"Beekumsa\" jedhamu irraa fagaadhu;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.20",
            "verseOrgIds": [
              "1TI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni tokko tokko, \"Nu beekumsa akkasii qabna\" jechuun amantii irraa badaniiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1TI 6:21"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1TI 6:21"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1TI 6:21"
      },
      "items": [
        {
          "text": "Ayyaanni isin wajjin haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    }
  ],
