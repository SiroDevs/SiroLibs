        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fannifamuun Yesuusitti Murame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.19.1-JHN.19.16"
          },
          "items": [
            {
              "text": "19:1‑16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MAT.27.27-MAT.27.31"
              },
              "items": [
                {
                  "text": "Mat 27:27‑31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.15.16-MRK.15.20"
              },
              "items": [
                {
                  "text": "Mar 15:16‑20",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis Yesuusin fuudhee garafsiise.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.1",
            "verseOrgIds": [
              "JHN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonnis gonfoo qoraattii micciiranii dhaʼanii mataa isaa irra kaaʼan. Isaanis uffata dhiilgee isatti uffisanii,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.2",
            "verseOrgIds": [
              "JHN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkam ree, yaa Mootii Yihuudootaa!\" jechaa gara isaatti deddeebiʼaa turan. Isas ni kabalan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.3",
            "verseOrgIds": [
              "JHN.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoos amma illee gad baʼee Yihuudootaan, \"Akka ani balleessaa tokko illee isa irratti hin argatin akka beektaniif kunoo ani isa gad isiniifin baasa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.4",
            "verseOrgIds": [
              "JHN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis gonfoo qoraattii kaaʼatee, wayyaa dhiilgees uffatee gad baʼe; Phiilaaxoosis, \"Namichi kunoo ti!\" isaaniin jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.5",
            "verseOrgIds": [
              "JHN.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni hangafoonnii fi qondaaltonni isaanii yommuu isa arganitti, \"Fannisi! Fannisi!\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 19:6"
      },
      "items": [
        {
          "text": "Phiilaaxoos immoo deebisee, \"Isin ofuma keessanii fuudhaatii isa fannisaa malee ani balleessaa tokko iyyuu isa irratti hin arganne\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonnis deebisanii, \"Nu seera qabna; namichi kun waan Ilma Waaqaa of godheef akka seera keenyaatti duʼuu qaba\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis yommuu dubbii kana dhagaʼetti ittuma caalchisee sodaate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.8",
            "verseOrgIds": [
              "JHN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis masaraatti ol deebiʼee, \"Ati nama eessaati?\" jedhee Yesuusin gaafate. Yesuus garuu deebii tokko iyyuu hin kennineef.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.9",
            "verseOrgIds": [
              "JHN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis, \"Ati na jalaa dubbachuu diddaa? Akka ani gad si dhiisuuf taayitaa qabuu fi akka ani si fannisuuf taayitaa qabu ati hin beektuu?\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.10",
            "verseOrgIds": [
              "JHN.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ati utuu olii siif kennamuu baatee silaa taayitaa tokko illee narratti hin qabdu ture. Kanaaf inni dabarsee sitti na kenne sun cubbuu cubbuu caalu qaba\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.19.11",
                "verseOrgIds": [
                  "JHN.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis yeroo sanaa jalqabee Yesuusin gad dhiisuu barbaada ture; Yihuudoonni garuu, \"Ati yoo namicha kana gad dhiifte michuu Qeesaar miti. Namni mootii of godhu kam iyyuu Qeesaariin morma\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis yommuu dubbii kana dhagaʼetti Yesuusin gad baasee, iddoo \"Dhagaa Afamaa\" kan afaan Ibraayisxiitiin \"Gabataa\" jedhamutti barcuma murtii irra taaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaan sunis guyyaa Qophii Faasiikaa ture; yeroon isaas gara saʼaatii jaʼaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 19:14"
      },
      "items": [
        {
          "text": "Phiilaaxoosis Yihuudootaan, \"Mootiin keessan kunoo ti!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu, \"Isa balleessi! Isa balleessi! Isa fannisi!\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 19:15"
      },
      "items": [
        {
          "text": "Phiilaaxoos immoo, \"Mootii keessan fannisu moo?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 19:15"
      },
      "items": [
        {
          "text": "Luboonni hangafoonnis, \"Nu Qeesaar malee mootii biraa hin qabnu\" jedhanii deebisaniif.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf Phiilaaxoos akka inni fannifamuuf dabarsee isaanitti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "JHN 19:16"
      },
      "items": [
        {
          "text": "Yesuus Fannifame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r",
        "vid": "JHN 19:16"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.19.17-JHN.19.24"
          },
          "items": [
            {
              "text": "19:17‑24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MAT.27.33-MAT.27.44"
              },
              "items": [
                {
                  "text": "Mat 27:33‑44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "MRK.15.22-MRK.15.32"
              },
              "items": [
                {
                  "text": "Mar 15:22‑32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.23.33-LUK.23.43"
              },
              "items": [
                {
                  "text": "Luq 23:33‑43",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 19:16"
      },
      "items": [
        {
          "text": "Isaanis Yesuusin fuudhanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis fannoo ofii isaa baadhatee iddoo Buqqee Mataa kan afaan Ibraayisxiitiin",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.17",
            "verseOrgIds": [
              "JHN.19.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Golgootaa",
              "type": "text",
              "attrs": {
                "verseId": "JHN.19.17",
                "verseOrgIds": [
                  "JHN.19.17"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhamutti ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.17",
            "verseOrgIds": [
              "JHN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis achitti isa fannisan; isa wajjinis namoota biraa lama, isa tokko garanaan, kaan immoo garasiin, Yesuusin immoo gidduu isaaniitti fannisan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.18",
            "verseOrgIds": [
              "JHN.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis Katabbii,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "JHN 19:19"
      },
      "items": [
        {
          "text": "Yesuus Isa Naazreeti, Mooticha Yihuudootaa,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JHN 19:19"
      },
      "items": [
        {
          "text": "jedhu tokko barreessee fannoo sanatti maxxanse.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoon Yesuus itti fannifame waan magaalaatti dhiʼoo tureef Yihuudoonni hedduun katabbii sana dubbisaniiru; katabbiin sunis afaan Ibraayisxiitiin, Laatiinii fi Giriikiin barreeffame.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.20",
            "verseOrgIds": [
              "JHN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonni Yihuudootaa hangafoonni Phiilaaxoosiin, \"Namichi kun, ' \"Ani mootii Yihuudootaa ti\" jedheera' jedhii barreessi malee, 'Inni Mootii Yihuudootaa ti' jettee hin barreessin\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.21",
            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phiilaaxoosis, \"Ani waanan barreesse, barreesseera\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoonni sunis erga Yesuusin fannisanii booddee kittaa isaa hambisanii wayyaa isaa fuudhanii akka tokko tokko isaan gaʼuuf iddoo afuritti hiratan. Kittaan sun hin hodhamne; olii hamma gadiittis dhaʼaa tokko ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan, \"Kottaa hin tarsaasnuu; garuu ixaa buufannee akka inni kan eenyuu taʼu ilaallaa\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        },
        {
          "text": "waliin jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 19:24"
      },
      "items": [
        {
          "text": "Kunis akka Katabbiin Qulqulluun,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JHN 19:24"
      },
      "items": [
        {
          "text": "\"Isaan wayyaa koo hiratan;",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JHN 19:24"
      },
      "items": [
        {
          "text": "uffata koottis ixaa buufatan\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JHN 19:24"
      },
      "items": [
        {
          "text": "jedhu sun raawwatamuuf taʼe. Wanni loltoonni godhanis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fannoo Yesuus biras haati isaa, obboleettiin haadha isaa, Maariyaam niitiin Qilophaatii fi Maariyaam isheen Magdalaa dhaabatanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
            "verseOrgIds": [
              "JHN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yommuu haadha isaatii fi barataa inni jaallatu sana utuu inni ishee cina dhaabatuu argetti haadha isaatiin,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dubartii nana! Kunoo, ilma kee\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.19.26",
                "verseOrgIds": [
                  "JHN.19.26"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barataa sanaan illee,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kunoo haadha kee\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.19.27",
                "verseOrgIds": [
                  "JHN.19.27"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe; barataan sunis saʼaatii sanaa jalqabee gara mana isaatti ishee fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
    },
