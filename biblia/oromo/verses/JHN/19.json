          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Yoosef namni Armaatiyaa kan sababii Yihuudoota sodaateef dhoksaan barataa Yesuus ture sun reeffa Yesuus fudhachuuf Phiilaaxoosin kadhate. Phiilaaxoosis isaaf eeyyame; kanaafuu inni dhaqee reeffa Yesuus fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niqoodemoos inni duraan halkaniin gara Yesuus dhufee tures walmakaa qumbiitii fi argeessa gara kiiloo giraamii soddomii afur ulfaatu qabatee dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis reeffa Yesuus fuudhanii akka duudhaa Yihuudootaatti awwaaluuf urgooftuu wajjin huccuu quncee talbaa irraa hojjetameen kafanan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo Yesuus itti fannifames lafa biqiltuu tokkotu ture; lafa biqiltuu sana keessas iddoo awwaalaa haaraa kan namni tokko iyyuu duraan itti hin awwaalamin tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii guyyaan sun guyyaa Qophii Yihuudootaa turee fi iddoon awwaalaa sunis waan dhiʼoo tureef Yesuusin achi keessa kaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
