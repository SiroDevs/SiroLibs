  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "DEU 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waldaa Irraa Dhowwamuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni kolaafame yookaan dhagni saala isaa irraa murame kam iyyuu waldaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.1",
                "verseOrgIds": [
                  "DEU.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hin seenin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni haraamuudhaan dhalate yookaan sanyiin isaa kam iyyuu hamma dhaloota kurnaffaatti waldaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.2",
                "verseOrgIds": [
                  "DEU.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "hin seenin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni gosa Amoon yookaan gosa Moʼaab yookaan sanyiin isaa kam iyyuu hamma dhaloota kurnaffaatti waldaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.3",
                "verseOrgIds": [
                  "DEU.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "hin seenin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.3",
            "verseOrgIds": [
              "DEU.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yeroo ati Gibxii baatetti karaa irratti buddeenaan yookaan bishaaniin si hin simanne; qooda kanaa akka inni si abaaruuf Balaʼaam ilma Beʼoor namicha biyya Phetoor ishee Phaadaan Arraamitti argamtu sana keessa jiraatu sitti bitan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.4",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.5",
                "verseOrgIds": [
                  "DEU.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee abaarsa sana eebbatti siif geeddare malee Balaʼaamin hin dhageenye;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.5",
                "verseOrgIds": [
                  "DEU.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee si jaallataatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati hamma lubbuudhaan jirtutti akka isaan nageenyaa fi badhaadhummaa qabaatan hin barbaadin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.6",
            "verseOrgIds": [
              "DEU.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan inni obboleessa kee taʼeef nama gosa Edoom hin tuffatin. Ati sababii akka alagaatti biyya isaa keessa jiraatteef nama Gibxi hin tuffatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
            "verseOrgIds": [
              "DEU.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen dhaloota sadaffaa kanneen isaaniif dhalatan waldaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.8",
                "verseOrgIds": [
                  "DEU.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "seenuu ni dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qulqullina Qubataa Eeguu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu diinota kee loluuf baatutti xuraaʼummaa hunda irraa of eegi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.9",
            "verseOrgIds": [
              "DEU.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko yoo halkan afeetaa dhangalaasuudhaan of xureesse inni qubata keessaa gad baʼee ala haa turu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.10",
            "verseOrgIds": [
              "DEU.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara galgalaa garuu dhiqatee yeroo aduun dhiitutti gara qubataatti haa deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.11",
            "verseOrgIds": [
              "DEU.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati qubataan alatti lafa itti gad baatu qopheeffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.12",
            "verseOrgIds": [
              "DEU.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meeshaa kee keessaa waan ittiin lafa qottu qabaadhu; ati yommuu gad teessee kaatutti boolla qotiitii biyyoo itti deebisi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.13",
            "verseOrgIds": [
              "DEU.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.14",
                "verseOrgIds": [
                  "DEU.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee si eeguu fi diinota kee dabarsee sitti kennuudhaaf qubata kee keessa deddeebiʼaatii; akka inni gidduu keetti waan xuraaʼaa argee sirraa hin deebineef qubanni kee qulqulluu taʼuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seerawwan Garaa garaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo garbichi tokko kooluu sitti gale, ati dabarsitee gooftaa isaatti isa hin kennin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.15",
            "verseOrgIds": [
              "DEU.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gidduu kee lafa jaallatee fi magaalaa filate keessa haa jiraatu. Atis isa hin cunqursin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.16",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiirri yookaan dubartiin Israaʼel kam iyyuu sagaagaltuu mana waaqa tolfamaa hin taʼin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartii yookaan dhiira sagaagalu tokko irraa akka galchaatti kennaa fuutee mana",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.18",
                "verseOrgIds": [
                  "DEU.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiitti hin fidin; lachan isaanii iyyuu fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.18",
                "verseOrgIds": [
                  "DEU.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii duratti jibbisiisoo dhaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati maallaqa yookaan nyaata yookaan waan dhala argamsiisu kam iyyuu dhalaan obboleessa keetiif hin liqeessin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati nama ormaa irraa dhala gaafachuu ni dandeessa; garuu akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.20",
                "verseOrgIds": [
                  "DEU.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee biyya ati dhaaluuf itti galtutti waan harki kee tuqe hundaan si eebbisuuf obboleessa kee irraa dhala hin fudhatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yoo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.21",
                "verseOrgIds": [
                  "DEU.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiif wareega tokko wareegde, sababii",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.21",
                "verseOrgIds": [
                  "DEU.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee cimsee waan sana sirraa barbaaduuf akka cubbuu sitti hin taaneef dafiitii of irraa baasi malee lafa irra hin harkisin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo wareeguu baatte garuu ati cubbamaa hin taatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan arrabni kee dubbate gochuuf of eeggadhu; afaanuma keetiin jaallattee",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.23.23",
                "verseOrgIds": [
                  "DEU.23.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiif wareegdeertaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati yoo iddoo dhaabaa wayinii ollaa keetii keessa seente, ija feete hunda nyaadhu; garuu tokko illee guuboo kee keessa hin kaaʼatin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo lafa qotiisaa midhaan ollaa keetii keessa seente, asheetii cirachuu ni dandeessa; garuu midhaan isaa kan dhaabatutti haamtuu kee hin buusin.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.26"
            ]
          }
        }
      ]
    }
