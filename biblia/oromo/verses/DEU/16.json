              "attrs": {
                "verseId": "DEU.16.16",
                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti hin dhiʼaatin:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
