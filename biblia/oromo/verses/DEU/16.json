              "type": "text",
              "attrs": {
                "verseId": "DEU.16.16",
                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii duratti dhiʼaachuu qabu; kunis yeroo Ayyaana Maxinoo, yeroo Ayyaana Torbanootaatii fi yeroo Ayyaana Daasii ti. Namni tokko iyyuu harka duwwaa fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
