                "verseId": "DEU.16.17",
                "verseOrgIds": [
                  "DEU.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keessan isiniif kenneetti kennaa fidaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
