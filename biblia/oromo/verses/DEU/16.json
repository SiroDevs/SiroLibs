              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiirri kee hundi waggaatti yeroo sadii iddoo inni filatutti fuula",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
