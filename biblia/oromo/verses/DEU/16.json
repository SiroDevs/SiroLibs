                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetiif ayyaaneffadhu. Sababii",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
