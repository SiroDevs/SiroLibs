                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee oomisha keetii fi hojii harka keetii hundaan si eebbisuuf gammachuun kee guutuu taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
