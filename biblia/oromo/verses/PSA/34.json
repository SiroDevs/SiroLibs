      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa Daawit. Innis fuula Abiimelek duratti maraatuu of fakkeesseef Abiimelek isa ariinaan yeroo achii deemetti faarfate.",
          "type": "text"
        }
      ]
    },
