          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 71:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.71.5",
                "verseOrgIds": [
                  "PSA.71.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaa, ati abdii kootii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:5"
      },
      "items": [
        {
          "text": "ijoollummaa kootii kaaftees ati Waaqa ani amanadhuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.5",
            "verseOrgIds": [
              "PSA.71.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 71:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani gaafan dhaladhee jalqabee sitti irkadheera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "gadameessa haadha koo keessaas situ na baase.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:6"
      },
      "items": [
        {
          "text": "Ani yeroo hunda sin galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.6",
            "verseOrgIds": [
              "PSA.71.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 71:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani namoota baayʼeedhaaf mallattoo taʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:7"
      },
      "items": [
        {
          "text": "ati garuu daʼoo koo isa jabaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.7",
            "verseOrgIds": [
              "PSA.71.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 71:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afaan koo guyyaa guutuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:8"
      },
      "items": [
        {
          "text": "galataa fi ulfina keetiin guutama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.8",
            "verseOrgIds": [
              "PSA.71.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 71:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani dulloomutti ati na hin gatin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:9"
      },
      "items": [
        {
          "text": "yeroo humni koo dhumuttis na hin dhiisin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.9",
            "verseOrgIds": [
              "PSA.71.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 71:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinonni koo natti mariʼatuutii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:10"
      },
      "items": [
        {
          "text": "warri na ajjeesuuf riphanii eeggatanis walii wajjin natti mariʼatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.10",
            "verseOrgIds": [
              "PSA.71.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 71:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Waaqni isa dhiiseera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "namni isa oolchu tokko iyyuu hin jiruutii",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:11"
      },
      "items": [
        {
          "text": "faana buʼaatii qabaa\" jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.11",
            "verseOrgIds": [
              "PSA.71.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 71:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, narraa hin fagaatin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:12"
      },
      "items": [
        {
          "text": "yaa Waaqa ko, na gargaaruuf dafii kottu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.12",
            "verseOrgIds": [
              "PSA.71.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 71:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri na himatan qaanaʼanii haa badan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "warri na miidhuu barbaadanis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:13"
      },
      "items": [
        {
          "text": "tuffii fi salphina haa uffatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.13",
            "verseOrgIds": [
              "PSA.71.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
