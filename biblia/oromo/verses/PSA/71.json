      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 71:1"
      },
      "items": [
        {
          "text": "ati gonkumaa na hin qaanessin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.1",
            "verseOrgIds": [
              "PSA.71.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
