      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Nama Ariʼatamaa Jiru Tokkoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
