            {
              "text": "Maaskiilii",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
