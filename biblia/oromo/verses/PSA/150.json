              "type": "text"
            }
          ]
        },
        {
          "text": "Haalleluuyaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 150:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "Mana qulqullummaa isaa keessatti Waaqa galateeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "samiiwwan isaa humna qabeeyyii keessattis isa galateeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 150:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojiiwwan isaa jajjaboo sanaaf isa leellisaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:2"
      },
      "items": [
        {
          "text": "guddina isaa hamma hin qabne sanaaf isa leellisaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 150:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malakata afuufuudhaan isa galateeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:3"
      },
      "items": [
        {
          "text": "baganaa fi kiraaraan isa galateeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 150:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "dibbeedhaan shuubbisaatii isa jajadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:4"
      },
      "items": [
        {
          "text": "miʼa ribuutii fi ululleedhaan isa jajadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
