      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:5"
      },
      "items": [
        {
          "text": "kilillee sagalee guddaatiin isa jajadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
