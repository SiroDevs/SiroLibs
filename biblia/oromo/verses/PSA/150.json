            "number": "5",
            "style": "v",
            "sid": "PSA 150:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilillee sagalee qabuun isa jajadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
    {
