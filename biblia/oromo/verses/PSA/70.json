          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri si barbaadan hundinuu garuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
