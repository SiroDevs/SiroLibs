      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "qaanaʼanii duubatti haa deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
