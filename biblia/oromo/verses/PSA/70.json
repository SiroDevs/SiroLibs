            "sid": "PSA 70:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri, \"Baga! Baga!\" anaan jedhan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
