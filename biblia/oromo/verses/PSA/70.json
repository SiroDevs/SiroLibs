    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "qaanaʼanii duubatti haa deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
