            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu hiyyeessaa fi rakkataa dha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
