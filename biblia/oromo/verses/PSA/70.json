      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "sitti gammadanii haa ililchan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
