          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.8",
                "verseOrgIds": [
                  "PSA.85.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni jedhu nan dhaggeeffadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "inni saba isaa qulqullootaaf nagaa abdachiisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:8"
      },
      "items": [
        {
          "text": "isaan garuu gara gowwummaatti hin deebiʼin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.8",
            "verseOrgIds": [
              "PSA.85.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 85:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ulfinni isaa lafa keenya irra jiraatuuf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:9"
      },
      "items": [
        {
          "text": "fayyisuun isaa dhugumaan warra isa sodaatanitti dhiʼoo jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.9",
            "verseOrgIds": [
              "PSA.85.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 85:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaalallii fi amanamummaan wal gaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:10"
      },
      "items": [
        {
          "text": "qajeelummaa fi nagaan wal dhungatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.10",
            "verseOrgIds": [
              "PSA.85.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 85:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanamummaan lafa keessaa burqa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:11"
      },
      "items": [
        {
          "text": "qajeelummaan immoo samii irraa gad ilaala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.11",
            "verseOrgIds": [
              "PSA.85.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 85:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.85.12",
                "verseOrgIds": [
                  "PSA.85.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dhugumaan waan gaarii ni kenna;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:12"
      },
      "items": [
        {
          "text": "lafti keenyas midhaan ishee ni kenniti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.12",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 85:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qajeelummaan fuula isaa dura deema;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:13"
      },
      "items": [
        {
          "text": "miilla isaatiifis karaa qopheessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
    }
