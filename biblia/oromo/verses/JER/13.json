    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sabbata Quncee Talbaa Irraa Hojjetame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.1",
                "verseOrgIds": [
                  "JER.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedhe: \"Dhaqiitii sabbata quncee talbaa irraa hojjetame bitadhuu mudhii keetti hidhadhu; garuu bishaan hin tuqsiisin.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.1",
            "verseOrgIds": [
              "JER.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.2",
                "verseOrgIds": [
                  "JER.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na ajajetti sabbata bitadhee mudhii kootti nan hidhadhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.2",
            "verseOrgIds": [
              "JER.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.3",
                "verseOrgIds": [
                  "JER.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee yeroo lammaffaa gara koo dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.3",
            "verseOrgIds": [
              "JER.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sabbata bitattee mudhiitti hidhatte sana fuudhiitii gara Laga Efraaxiis dhaqi; sabbata sanas baqaqaa kattaa keessa dhoksi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.4",
            "verseOrgIds": [
              "JER.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani akkuma",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.5",
                "verseOrgIds": [
                  "JER.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "na ajajetti dhaqee sabbata sana Laga Efraaxiis bira nan dhokse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.5",
            "verseOrgIds": [
              "JER.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii hedduu booddee",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.6",
                "verseOrgIds": [
                  "JER.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Amma gara Efraaxiis dhaqiitii sabbata ani akka ati achitti dhoksitu si ajaje sana fudhadhu\" naan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani gara Efraaxiis dhaqee sabbata sana iddoon itti dhoksee ture sanaa qotee baasee nan fudhadhe; sabbanni sun garuu yeroo sanatti ciccitee guutumaan guutuutti horoomaa baʼee ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.8",
                "verseOrgIds": [
                  "JER.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara koo dhufe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.8",
            "verseOrgIds": [
              "JER.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.9",
                "verseOrgIds": [
                  "JER.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; 'Ani haaluma wal fakkaatuun of tuulummaa Yihuudaatii fi of tuulummaa Yerusaalem guddaa sana nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.9",
            "verseOrgIds": [
              "JER.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni hamaan dubbii koo dhagaʼuu didee mata jabina garaa isaa duukaa buʼee waaqota biraa tajaajiluu fi waaqeffachuuf isaan faana buʼe kun akkuma sabbata kanaa ni taʼa; guutumaan guutuuttis horoomaa baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.10",
            "verseOrgIds": [
              "JER.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma sabbanni tokko mudhii namaatti hidhamu sana anis akka isaan saba, maqaa, galataa fi ulfina naa taʼaniif guutummaa mana Israaʼelii fi guutummaa mana Yihuudaa ofitti maxxanseen ture. Isaan garuu na hin dhaggeeffanne' jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.11",
                "verseOrgIds": [
                  "JER.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.11",
            "verseOrgIds": [
              "JER.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qalqalloo Daadhii Wayinii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati akkana isaaniin jedhi: '",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.12",
                "verseOrgIds": [
                  "JER.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel akkana jedha: qalqalloon daadhii wayinii hundi daadhii wayiniitiin guutamuu qaba.' Yoo isaan, 'Nu akka qalqalloon daadhii wayinii hundi daadhii wayiniitiin guutamuu qabu hin beeknuu?' siin jedhan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.12",
            "verseOrgIds": [
              "JER.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati akkana jedhiin; '",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.13",
                "verseOrgIds": [
                  "JER.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: Ani namoota biyya kana keessa jiraatan hunda, mootota teessoo Daawit irra taaʼan, luboota, raajotaa fi warra Yerusaalem keessa jiraatan hunda machiidhaan nan guuta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.13",
            "verseOrgIds": [
              "JER.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani tokkoo tokkoo isaanii walittin buusa; abbootii fi ilmaanis akkasuma walitti nan buusa, jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.14",
                "verseOrgIds": [
                  "JER.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ani isaan nan balleessa malee isaaniif hin naʼu yookaan isaaniif hin araaramu yookaan garaa hin laafuuf.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.14",
            "verseOrgIds": [
              "JER.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akeekkachiisa Of tuulummaa Irratti Kenname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhagaʼaa; qalbeeffadhaas;",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "text": "of hin tuulinaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:15"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.15",
                "verseOrgIds": [
                  "JER.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbateeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.15",
            "verseOrgIds": [
              "JER.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu inni dukkana hin fidin,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "utuu miilli keessan",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "text": "tulluu dukkanaaʼaa jiru irratti hin gufatin",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:16"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.16",
                "verseOrgIds": [
                  "JER.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessaniif ulfina kennaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.16",
            "verseOrgIds": [
              "JER.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:16"
      },
      "items": [
