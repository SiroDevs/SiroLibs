      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "akka maqaan isaa siʼachi hin yaadatamneef,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
