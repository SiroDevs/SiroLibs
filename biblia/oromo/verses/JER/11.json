                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee waaʼee namoota Anaatoot warra, 'Ati maqaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
