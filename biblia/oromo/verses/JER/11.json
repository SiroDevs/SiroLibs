      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "\"Kottaa muka sanaa fi ija isaa haa barbadeessinuu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
