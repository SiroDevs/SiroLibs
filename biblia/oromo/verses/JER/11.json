                "verseOrgIds": [
                  "JER.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "mala isaanii naaf ibseef ani waan sana nan beeke; inni yeroo sanatti waan isaan hojjechaa jiran natti argisiiseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
