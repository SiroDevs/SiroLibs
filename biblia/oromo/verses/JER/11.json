              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
