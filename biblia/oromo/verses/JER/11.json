      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "natti malatan ani hin hubannen ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
