      "attrs": {
        "style": "q2",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "kan murtii qajeelaa kennitu, kan garaa fi yaada namaa qortu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
