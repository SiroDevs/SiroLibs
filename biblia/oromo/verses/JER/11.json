                "verseOrgIds": [
                  "JER.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandeessu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
