            "number": "19",
            "style": "v",
            "sid": "JER 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akkuma xobbaallaa hoolaa isa garraamii kan gara qalmaatti oofamu tokkoon ture; ani akka isaan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
