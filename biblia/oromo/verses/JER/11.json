              "attrs": {
                "verseId": "JER.11.21",
                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "raajii hin dubbatin yoo kanaa achii harka keenyatti duuta' jechuudhaan si ajjeesuu barbaadan sanaa dubbata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
