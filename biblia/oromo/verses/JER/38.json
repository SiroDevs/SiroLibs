  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "JER 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ermiyaas Boolla Bishaaniitti Darbatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shefaaxiyaa ilmi Mataan, Gedaaliyaas ilmi Phaashihuur, Yuukaal ilmi Shelemiyaatii fi Phaashihuur ilmi Malkiyaa waan Ermiyaas akkana jedhee saba hundatti hime dhagaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.1",
            "verseOrgIds": [
              "JER.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.2",
            "verseOrgIds": [
              "JER.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.2",
                "verseOrgIds": [
                  "JER.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'Namni magaalaa kana keessatti hafu kam iyyuu goraadeen, beelaan yookaan dhaʼichaan ni duʼa; namni gara Baabilonotaatti baqatu kam iyyuu garuu ni jiraata. Inni lubbuu isaatiin ni baʼa; ni jiraatas.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.2",
            "verseOrgIds": [
              "JER.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.3",
                "verseOrgIds": [
                  "JER.38.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'Magaalaan kun dhugumaan dabarfamtee harka waraana mootii Baabilonitti ni kennamti; innis ishee qabata.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.3",
            "verseOrgIds": [
              "JER.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti qondaaltonni sun mootichaan akkana jedhan; \"Namichi kun ajjeefamuu qaba. Inni waan isaanitti dubbatuun loltoota magaalaa kana keessatti hafanii fi namoota hunda onnee dhabsiisa. Namichi kun saba kanaaf badiisa malee waan gaarii hin hawwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.4",
            "verseOrgIds": [
              "JER.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedeqiyaa Mootichi immoo, \"Inni harkuma keessan keessa jira; mootiin isiniin mormee homaa gochuu hin dandaʼu\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.5",
            "verseOrgIds": [
              "JER.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan Ermiyaasin fuudhanii boolla bishaanii kan Malkiyaa ilma mootichaa keessa buusan; boolli bishaanii sunis oobdii eegumsaa keessa ture. Isaan funyoodhaan Ermiyaasin boolla sana keessa buusan; boolli sun dhoqqee malee bishaan hin qabu ture; Ermiyaasis dhoqqee keessa dhidhime.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.6",
            "verseOrgIds": [
              "JER.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Ebeed-Melek qondaalli Itoophiyaa kan masaraa mootii keessa ture sun akka isaan Ermiyaasin boolla bishaanii keessa buusan dhagaʼe. Utuma mootichi Karra Beniyaam bira taaʼee jiruus,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.7",
            "verseOrgIds": [
              "JER.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebeed-Melek masaraadhaa baʼee dhaqee akkana isaan jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.8",
            "verseOrgIds": [
              "JER.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa gooftaa koo mooticha, jarri kun waan Ermiyaas raajicha godhan hundaan waan hamaa hojjetaniiru. Isaan akka inni beelaan duʼuuf yeroo buddeenni tokko iyyuu magaalaa keessa hin jirretti boolla bishaanii keessa isa buusan.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.9",
            "verseOrgIds": [
              "JER.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis ergasii Ebeed-Melek namicha Itoophiyaa sanaan, \"Nama soddoma asii fudhadhuu dhaqiitii utuu inni hin duʼin Ermiyaas raajicha boolla bishaanii keessaa baasi\" jedhee ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.10",
            "verseOrgIds": [
              "JER.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Ebeed-Melek namoota sana fudhatee gara kutaa mankuusaa masaraa mootichaa keessaatiin jala jiru sanaa dhaqe. Innis darsaa fi wayyaa moofaa achii fudhatee funyoon gara boolla bishaaniitti Ermiyaasiif gad buuse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.11",
            "verseOrgIds": [
              "JER.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebeed-Melek namichi Itoophiyaa sunis Ermiyaasiin, \"Akka funyoon si hin luqqisneef darsaa fi wayyaa moofaa bobaa kee jala kaaʼadhu\" jedhe. Ermiyaasis akkasuma godhe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.12",
            "verseOrgIds": [
              "JER.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaanis funyoo sanaan ol harkisanii boolla bishaanii keessaa isa baasan. Ermiyaasis oobdii eegumsaa keessa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.13",
            "verseOrgIds": [
              "JER.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zedeqiyaa Ammas Ermiyaasin Gaaffii Gaafate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedeqiyaa Mootichi Ermiyaasitti nama ergee gara balbala sadaffaa mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.14",
            "verseOrgIds": [
              "JER.38.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.14",
                "verseOrgIds": [
                  "JER.38.14"
                ]
              }
            }
          ]
        },
        {
          "text": "isa fichisiise. Mootichis Ermiyaasiin, \"Ani waa sin gaafadha; ati waan tokko illee na hin dhoksin\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.14",
            "verseOrgIds": [
              "JER.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaasis Zedeqiyaadhaan, \"Yoo ani deebii siif kenne, ati na hin ajjeeftuu? Yoo ani si gorse iyyuu ati na hin dhageessu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.15",
            "verseOrgIds": [
              "JER.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedeqiyaa Mootichi garuu, \"Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.16",
                "verseOrgIds": [
                  "JER.38.16"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa isa jireenya nuu kenne sanaa ani si hin ajjeesu; warra lubbuu kee balleessuu barbaadanittis dabarsee si hin kennu\" jedhee kakuu kana dhoksaatti Ermiyaasiif kakate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Ermiyaas deebisee Zedeqiyaadhaan akkana jedhe; \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.17",
                "verseOrgIds": [
                  "JER.38.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni, inni Waan Hunda Dandaʼu, Waaqni Israaʼel akkana jedha: 'Yoo ati qondaaltota mootii Baabilonitti harka kennatte lubbuun kee duʼa ni oolfamti; magaalaan kunis hin gubamtu; atii fi maatiin kee ni jiraattu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo ati qondaaltota mootii Baabilonitti harka kennachuu baatte magaalaan kun dabarfamtee Baabilonotatti ni kennamti; isaanis ishee gubu; ati mataan kee iyyuu isaan jalaa hin baatu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedeqiyaa Mootichi Ermiyaasiin, \"Ani Yihuudoota Baabilonotatti galan nan sodaadha; Baabilononni dabarsanii isaanitti na kennanii isaan immoo natti taphatuutii\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaasis akkana jedhee deebise; \"Isaan dabarsanii si hin kennan; ati waan ani sitti himu gochuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.20",
                "verseOrgIds": [
                  "JER.38.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajami. Yoos ati milkooftee lubbuun kees duʼa oolfamti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo ati harka kennachuu didde,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.21",
                "verseOrgIds": [
                  "JER.38.21"
                ]
              }
            }
          ]
        },
        {
          "text": "waan kana naa ibseera:",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartoonni mana mootii Yihuudaa keessatti hafan hundi gara qondaaltota mootii Baabilonitti geeffamu. Dubartoonni sunis akkana jedhu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "\" 'Michoonni kee kanneen ati amanatte sun,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "si gowwoomsanii; si moʼatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "Miilli kee dhoqqee keessa lixe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "michoonni kees si dhiisanii deeman.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Niitonni keetii fi ijoolleen kee hundi Baabilonotatti geeffamu. Ati mataan kee iyyuu mootii Baabiloniin qabamta malee isaan harkaa hin baatu; magaalaan kunis ni gubamti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedeqiyaan Ermiyaasiin akkana jedhe; \"Dubbii nu amma dubbanne kana namni tokko iyyuu hin beekin; yoo kanaa achii ati ni duutaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.24",
            "verseOrgIds": [
              "JER.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo qondaaltonni akka ani si wajjin haasaʼe dhagaʼanii si bira dhufanii, 'Waan ati mootiidhaan jettee fi waan mootiin siin jedhe nutti himi; nu hin dhoksin; yoo kanaa achii nu si ajjeefnaa' siin jedhan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ani akka inni gara mana Yoonaataanitti deebisee na ergee anis achitti hin duuneef mooticha kadhachaa ture' jedhiin.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii qondaaltonni hundi dhufanii Ermiyaasin gaafatan; innis waan mootichi akka inni dubbatu isa ajaje hunda isaanitti hime. Sababii namni waan inni mooticha wajjin dubbate dhagaʼe tokko iyyuu hin turiniif, jarri waan kana caalaa homaa isatti hin dubbanne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaasis hamma gaafa Yerusaalem qabamteetti oobdii eegumsaa sana keessa ture.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        }
      ]
    }
  ],
