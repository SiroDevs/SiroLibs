  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JER 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Deebii Zedeqiyaaf Kenname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Zedeqiyaa Mootichi Phaashihuur ilma Malkiyaatii fi Sefaaniyaa lubicha ilma Maʼaseyaa gara Ermiyaasitti ergetti dubbiin akkana jedhu",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.1",
                "verseOrgIds": [
                  "JER.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa gara Ermiyaas dhufe. Jarri ergamanis akkana jedhan;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sababii Nebukadnezar mootichi Baabilon nu waraanaa jiruuf",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.2",
                "verseOrgIds": [
                  "JER.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nuu gaafadhu. Tarii",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.2",
                "verseOrgIds": [
                  "JER.21.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akkuma duraan godhe sana hojiiwwan dinqii nuuf hojjetee akka mootichi nurraa deebiʼu ni godha taʼaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ermiyaas garuu akkana isaaniin jedhe; \"Zedeqiyaadhaan akkana jedhaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.4",
                "verseOrgIds": [
                  "JER.21.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel akkana jedha: Ani miʼoota waraanaa harka keessan jiran, kanneen isin ittiin mootii Baabilonii fi Baabilonota isin marsanii dallaan ala jiran loluuf itti fayyadamtan kana isinitti nan garagalcha. Anis magaalaa kana keessatti isaan walitti nan qaba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani mataan koo harka diriirfamee fi irree jabaadhaan, aarii bobaʼuu fi dheekkamsa guddaadhaan waraana isinitti nan bana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan magaalaa kana keessa jiraatu jechuunis namaa fi horii nan dhaʼa; isaanis dhaʼicha hamaadhaan dhumu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis ergasii, jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.7",
                "verseOrgIds": [
                  "JER.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Zedeqiyaa mooticha Yihuudaa, qondaaltota isaatii fi jiraattota magaalaa kanaa kanneen dhaʼicha jalaa, goraadee fi beela jalaa baʼan Nebukadnezar mooticha Baabilonii fi diinota isaanii kanneen lubbuu isaanii balleessuu barbaadanitti dabarsee nan kenna. Mootichis goraadeedhaan isaan fixa; inni isaaniif hin hilu yookaan hin naʼuuf yookaan garaa hin laafuuf.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amma illee akkana jedhii saba kanatti himi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.8",
                "verseOrgIds": [
                  "JER.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'kunoo, ani karaa jireenyaatii fi karaa duʼaa fuula keessan dura nan kaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni magaalaa kana keessatti hafu kam iyyuu goraadeedhaan, beelaan yookaan dhaʼichaan duʼa. Namni gad baʼee Baabilonota isin marsanii jiranitti harka kennatu kam iyyuu garuu ni jiraata; lubbuu isaas ni oolfata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani magaalaa kanaaf waan gaarii gochuuf utuu hin taʼin ishee miidhuuf kutadheera, jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.10",
                "verseOrgIds": [
                  "JER.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Isheenis dabarfamtee harka mootii Baabilonitti ni kennamti; inni immoo ibiddaan ishee barbadeessa.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akkasumas mana mootii Yihuudaatiin akkana jedhi; 'Isin dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.11",
                "verseOrgIds": [
                  "JER.21.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dhagaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.11",
            "verseOrgIds": [
              "JER.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa mana Daawit,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.12",
                "verseOrgIds": [
                  "JER.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "\" 'Ganama hunda murtii qajeelaa kennaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "nama saamame tokko",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "harka nama isa cunqursuutii baasaa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "yoo kanaa achii sababii jalʼina isin hojjettaniitiif",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "dheekkamsi koo buʼee akkuma ibiddaa bobaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:12"
      },
      "items": [
        {
          "text": "namni isa dhaamsu tokko iyyuu hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.12",
            "verseOrgIds": [
              "JER.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ishee sulula kanaan ol dirree kattaa qabu irra jiraattu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "ani sitti kaʼeen jira, jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.13",
                "verseOrgIds": [
                  "JER.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "isin warri, \"Eenyuttu nutti dhufuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:13"
      },
      "items": [
        {
          "text": "Eenyutus daʼannoo keenya seenuu dandaʼa?\" jettan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.13",
            "verseOrgIds": [
              "JER.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani akkuma hojii keessaniif malutti isinan adaba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 21:14"
      },
      "items": [
        {
          "text": "jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.21.14",
                "verseOrgIds": [
                  "JER.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.14",
            "verseOrgIds": [
              "JER.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
