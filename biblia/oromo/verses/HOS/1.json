          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.1",
                "verseOrgIds": [
                  "HOS.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kan bara Uziyaan, Yootaam, Aahaaziitii fi Hisqiyaas mootota Yihuudaa keessa, akkasumas bara Yerobiʼaam ilma Yooʼaash mooticha Israaʼel keessa gara Hooseʼaa ilma Biʼeer dhufe kanaa dha:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Niitii fi Ijoollee Hooseʼaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Hooseʼaatiin dubbachuu jalqabetti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana isaan jedhe; \"Sababii biyyattiin",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa gortee yakka sagaagalummaa guddaa isaa hojjetteef ati dhaqiitii niitii sagaagaltuu fi ijoollee hin amanamne ofii keetiif fudhadhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu inni dhaqee Goomer intala Diblaayiim fuudhe; isheenis ulfooftee ilma deesseef.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.4",
                "verseOrgIds": [
                  "HOS.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Hooseʼaatiin akkana jedhe; \"Ani sababii dhiiga Yizriʼeel keessatti dhangalaʼe sanaatiif dafee mana Yehuu waanan adabuuf Yizriʼeel jedhii isa moggaasi; ani mootummaa Israaʼel nan balleessa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas ani Sulula Yizriʼeel keessatti iddaa Israaʼel nan cabsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goomer amma illee ulfooftee intala deesse.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.6",
                "verseOrgIds": [
                  "HOS.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Hooseʼaatiin akkana jedhe; \"Sababii ani isaaniif araaramuu fi siʼachis mana Israaʼeliif garaa hin laafneef Loo-Ruhaamaa jedhii ishee moggaasi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus ani mana Yihuudaatiif garaa nan laafa; ani xiyyaan yookaan goraadeedhaan yookaan waraanaan yookaan fardeeniin yookaan abbootii fardaatiin isaan hin oolchu; garuu ani",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.7",
                "verseOrgIds": [
                  "HOS.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni isaanii isaan nan oolcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goomer erga Loo-Ruhaamaa harma guusiftee booddee ulfooftee ilma deesse.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.9",
                "verseOrgIds": [
                  "HOS.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhe; \"Isin waan saba koo hin taʼinii fi anis Waaqa keessan hin taʼiniif Loo-Amii jedhii isa moggaasi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taʼus Israaʼel akkuma cirracha qarqara galaanaa kan madaalamuu yookaan hedamuu hin dandaʼamnee taʼa. Isaan iddoodhuma itti, 'Isin saba koo miti' isaaniin jedhame sanatti, 'Ilmaan Waaqa jiraataa' jedhamanii ni waamamu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaan Yizriʼeel waan guddaa taʼuuf, sabni Yihuudaatii fi sabni Israaʼel deebiʼanii tokko taʼu; isaan hoogganaa tokko muuddatanii biyya sana keessaa ni baʼu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.2.2"
            ]
          }
        }
      ]
    }
  ],
