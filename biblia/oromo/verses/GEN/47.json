          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼelis, \"Naa kakadhu\" jedheen. Yoosefis ni kakateef. Israaʼel immoo mataa ulee isaatti irkatee sagade.",
          "type": "text",
          "attrs": {
