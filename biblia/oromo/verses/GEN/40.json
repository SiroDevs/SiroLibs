        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoosef Abjuu Hiikuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana booddee namichi mootii Gibxiitiif dhugaatii dhiʼeessuu fi namichi buddeena tolchu gooftaa isaanii mootii Gibxi sana gaddisiisan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraʼoonis qondaaltota isaa lamaanitti jechuunis itti gaafatamaa dhugaatiitii fi itti gaafatamaa tolchaa buddeenaatti aare;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.2",
            "verseOrgIds": [
              "GEN.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis mana ajajaa waardiyyaa keessa mana hidhaa iddoo Yoosef itti hidhamee ture keessa isaan buuse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.3",
            "verseOrgIds": [
              "GEN.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajaan waardiyyaa Yoosefitti isaan kenne; Yoosefis isaan tajaajilaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 40:4"
      },
      "items": [
        {
          "text": "Jarris guyyaa baayʼee mana hidhaa turan;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan lachanuu jechuunis namichi mootii Gibxiitiif dhugaatii dhiʼeessuu fi namichi buddeena tolchu tokkoon tokkoon isaanii halkanuma tokko keessatti abjuu abjootan; tokkoon tokkoon abjuu sanaas hiikkaa mataa isaa qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.5",
            "verseOrgIds": [
              "GEN.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosef guyyaa itti aanu ganama isaan bira dhaqe; kunoo utuu gaddanii jiranuus isaan arge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.6",
            "verseOrgIds": [
              "GEN.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Fuulli keessan harʼa maaliif akkana dukkanaaʼa?\" jedhee qondaaltota Faraʼoon warra isa wajjin mana gooftaa isaa keessa mana hidhaa turan sana gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.7",
            "verseOrgIds": [
              "GEN.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Nu lachuu abjuu abjoonnee nama nuu hiiku dhabne\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 40:8"
      },
      "items": [
        {
          "text": "Kana irratti Yoosef, \"Hiikkaan kan Waaqaa ti mitii? Mee abjuu keessan natti himaa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti gaafatamaan dhugaatii sun akkana jedhee abjuu isaa Yoosefitti himate; \"Abjuu koo keessatti kunoo muka wayinii tokkotu fuula koo dura ture;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.9",
            "verseOrgIds": [
              "GEN.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukti wayinii sunis damee sadii qaba ture. Innis akkuma lateen daraare; hurbuun ija isaas ni bilchaatte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.10",
            "verseOrgIds": [
              "GEN.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xoofoon Faraʼoon na harka ture; anis ija wayinii fuudhee xoofoo Faraʼoonitti cuunfee xoofoo sana harka Faraʼoonitti kenne.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.11",
            "verseOrgIds": [
              "GEN.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis akkana jedheen; \"Hiikkaan isaa kana; dameewwan sadan sun guyyaa sadii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadii keessatti Faraʼoon mataa kee ol qaba; taayitaa keettis si deebisa; akkuma yeroo dhugaatii dhiʼeessaafii turte sana atis xoofoo Faraʼoon harka isaatti ni kennita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo sitti tolutti na yaadadhu; waan gaariis naa godhi. Waaʼee koo Faraʼoonitti himiitii mana hidhaa kanaa na baasi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana biyya Ibrootaatii hatanii na fidaniitii; biyya kana keessattis ani waan boolla kana keessa na buusisu tokko illee hin hojjenne.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti gaafatamaan buddeenaa sunis yommuu akka Yoosef abjuu sanaaf hiikkaa gaarii kenne argetti Yoosefiin akkana jedhe; \"Anis abjuu tokkon abjoodhe; kunoo gundoowwan buddeenaa sadii mataa koo irra turan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.16",
            "verseOrgIds": [
              "GEN.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gundoo ol aanu irra buddeena gosa garaa garaa kan Faraʼooniif qopheeffametu ture; garuu simbirroonni matuma koo irratti gundoo sana keessaa nyaachaa turan.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.17",
            "verseOrgIds": [
              "GEN.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosef immoo akkana jedhe; \"Hiikkaan isaa kana; gundoowwan sadan sun guyyaa sadii.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadii keessatti Faraʼoon mataa kee ol qaba; mukatti si rarraasa. Simbirroonnis foon kee ni nyaatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaan sadaffaan guyyaa itti Faraʼoon dhalate ture; Faraʼoonis qondaaltota isaatiif cidha qopheesse. Innis itti gaafatamaa dhugaatiitii fi itti gaafatamaa buddeenaa sana fuula qondaaltota isaa duratti dhiʼeesse:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.20",
            "verseOrgIds": [
              "GEN.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti gaafatamaa dhugaatii sana hojii isaatti deebise; namichi xoofoo sana ammas harka Faraʼoonitti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.21",
            "verseOrgIds": [
              "GEN.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itti gaafatamaa buddeenaa sana garuu akkuma Yoosef abjuu isaanii hiikeefitti rarraase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.22",
            "verseOrgIds": [
              "GEN.40.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus itti gaafatamaan dhugaatii sun Yoosefin ni irraanfate malee isa hin yaadanne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.23",
            "verseOrgIds": [
              "GEN.40.23"
            ]
          }
        }
      ]
    }
  ],
