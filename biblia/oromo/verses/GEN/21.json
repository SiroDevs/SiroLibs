              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii jarri lamaan sun achitti walii kakataniif iddoon sun Bersheebaa jedhamee waamame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.31",
