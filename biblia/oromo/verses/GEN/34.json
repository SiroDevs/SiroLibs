  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "GEN 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Diinaan Gudeedamte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinaan intalli Liyaan Yaaqoobiif deesse sun dubartoota biyyattii ilaaluudhaaf gad baate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.1",
            "verseOrgIds": [
              "GEN.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheekem ilmi Hamoor namicha gosa Hiiwii kan bulchaa biyya sanaa ture ishee arge; innis qabee humnaan ishee gudeede.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.2",
            "verseOrgIds": [
              "GEN.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qalbiin isaas Diinaa intala Yaaqoobiin fudhatame; innis ishee jaallatee afaan tolaa itti dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.3",
            "verseOrgIds": [
              "GEN.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheekemis abbaa isaa Hamooriin, \"Intala kana na fuusisi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.4",
            "verseOrgIds": [
              "GEN.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob yommuu intalli isaa Diinaan akka gudeedamte dhagaʼetti, ilmaan isaa dirree irra horii tiksu turan; kanaafuu Yaaqoob hamma isaan galanitti ni calʼise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.5",
            "verseOrgIds": [
              "GEN.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoor abbaan Sheekemis Yaaqoob wajjin dubbachuu dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.6",
            "verseOrgIds": [
              "GEN.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Yaaqoobis akkuma waan uumame sana dhagaʼaniin dirreedhaa dhufan. Isaanis sababii Sheekem intala Yaaqoob wajjin ciisuudhaan Israaʼel keessatti waan jibbisiisaa hojjeteef ni gaddan; akka malees aaran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.7",
            "verseOrgIds": [
              "GEN.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoor garuu akkana isaaniin jedhe; \"Qalbiin ilma koo Sheekem intala keessan irra buʼeera. Maaloo isatti ishee heerumsiisaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.8",
            "verseOrgIds": [
              "GEN.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuudhaa fi heerumaan walitti firoomnaa; intallan keessan nuu kennaa; intallan keenyas fuudhaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.9",
            "verseOrgIds": [
              "GEN.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu wajjin jiraadhaa; biyyattiin fuula keessan dura jirti; keessa jiraadhaatii itti daldalaa; qabeenyas itti horadhaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.10",
            "verseOrgIds": [
              "GEN.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheekemis abbaa Diinaatii fi obboloota isheetiin akkana jedhe; \"Ani fuula keessan duratti fudhatama argannaan waanuma isin naan jettan isiniif nan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.11",
            "verseOrgIds": [
              "GEN.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis gabbara misirrittiitii fi kennaa ani fiduu qabu hamma feetan natti muraa; anis waan isin naan jettan nan baasa. Intalattii qofa natti heerumsiisaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.12",
            "verseOrgIds": [
              "GEN.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Yaaqoob immoo waan Sheekem obboleettii isaanii Diinaa gudeedeef yeroo Sheekemii fi abbaa isaa Hamooriif deebii kennanitti haxxummaadhaan dubbatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.13",
            "verseOrgIds": [
              "GEN.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkana isaaniin jedhan; \"Nu waan akkanaa gochuu hin dandeenyu; nu nama dhagna hin qabatiniif intala keenya kennuu hin dandeenyu. Kun nuuf salphina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.14",
            "verseOrgIds": [
              "GEN.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu waan tokko qofaan tole isiniin jenna; kunis yoo isin dhiira keessan hunda dhagna qabdanii akkuma keenya taatanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.15",
            "verseOrgIds": [
              "GEN.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii nu intallan keenya isinii kennina; intallan keessan immoo ni fuuna. Gidduu keessan ni jiraanna; isin wajjinis saba tokko ni taana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.16",
            "verseOrgIds": [
              "GEN.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo isin dhagna qabachuu diddan nu obboleettii keenya fudhannee deemna.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.17",
            "verseOrgIds": [
              "GEN.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin isaanii Hamoorii fi Sheekem ilma Hamoor ni gammachiise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.18",
            "verseOrgIds": [
              "GEN.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheekem namoota mana abbaa isaa jiraatan hunda caalaa kabajamaa ture; inni sababii intala Yaaqoobitti gammadeef waan kana lafa irra hin harkifne;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.19",
            "verseOrgIds": [
              "GEN.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoorii fi ilmi isaa Sheekem gara karra magaalaa isaanii dhufanii namoota magaalaa isaaniitiin akkana jedhan;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.20",
            "verseOrgIds": [
              "GEN.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jarri kun nuuf warra nagaa ti; kanaafuu biyyattii keessa jiraatanii itti haa daldalatan. Biyyattiin isaaniif lafa balʼaa qabdi; nu intallan isaanii haa fuunu; isaanis intallan keenya haa fuudhan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.21",
            "verseOrgIds": [
              "GEN.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu namoonni kunneen akka saba tokkootti nu wajjin jiraachuuf tole kan jedhan yoo dhiironni keenya akkuma isaanii dhagna qabatan qofa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.22",
            "verseOrgIds": [
              "GEN.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loon isaanii, qabeenyi isaaniitii fi horiin isaanii kaan hundinuu kanuma keenya hin taʼanii? Kanaafuu kottaa tole isaaniin jennaa; isaanis nu wajjin ni jiraatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.23",
            "verseOrgIds": [
              "GEN.34.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni karra magaalaa sanaatiin gad baʼan hundinuu Hamoorii fi ilma isaa Sheekemiin walii galan; dhiironni karra magaalaa sanaatiin gad baʼan hundinuus dhagna qabatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.24",
            "verseOrgIds": [
              "GEN.34.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadii booddee utuma isaan dhukkubsachaa jiranuu, ilmaan Yaaqoobii keessaa namni lama Simiʼoonii fi Lewwiin, obboloonni Diinaa, goraadee isaanii fudhatanii magaalaa homaa quba hin qabne sana dhaʼanii dhiira hunda ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis goraadeedhaan Hamoorii fi ilma isaa Sheekemin ajjeesanii Diinaa immoo mana Sheekemiitii fudhatanii qajeelan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Yaaqoobis reeffawwan irra darbanii magaalaa obboleettiin isaanii itti gudeedamte sana saaman.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis bushaayee isaanii, loon isaanii, harroota isaaniitii fi waan isaan magaalaa keessaa fi alaa qaban hunda fudhatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qabeenya isaanii hunda, dubartootaa fi ijoollee isaanii hunda fudhatanii deeman; waan mana keessa jiru hundas ni boojiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoobis Simiʼoonii fi Lewwiidhaan akkana jedhe; \"Isin akka ani Kanaʼaanotaa fi Feerzota biyya kana jiraatanitti xireeffatamu gochuudhaan rakkoo natti fiddan. Nu baayʼinaan xinnoo dha; yoo isaan humna walitti dabalatanii na lolan anii fi warri mana koo hundinuu ni dhumna.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.30",
            "verseOrgIds": [
              "GEN.34.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu, \"Yoos inni akkuma sagaagaltuu tokkootti obboleettii keenyatti haa taphatuu ree?\" jedhanii deebisan.",
