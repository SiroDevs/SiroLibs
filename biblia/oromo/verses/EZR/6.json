          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Labsii Daariyoos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Daariyoos Mootichi ajaja kenne; isaanis galmeewwan mana galmee Baabilon keessatti kuufaman sana ni sakattaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitaabni maramaan tokkos Ahimetaa magaalaa guddaa kutaa biyyaa Meedee keessatti argame; kitaaba sana irrattis akkana jedhamee barreeffamee ture:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 6:2"
      },
      "items": [
        {
          "text": "Yaadachiisa:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa tokkoffaa bara mootummaa Qiiros Mootichaa keessa mootichi waaʼee mana qulqullummaa Waaqaa kan Yerusaalem keessa jiru sanaa akkana jedhee labsii baase:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZR 6:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 6:3"
      },
      "items": [
        {
          "text": "Manni qulqullummaa kun iddoo aarsaan itti dhiʼeeffamu taʼee deebifamee haa ijaaramu; hundeen isaas haa buufamu. Manni kunis ol dheerina dhundhuma jaatamaa fi balʼina dhundhuma jaatama qabaatee",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhagaa gurguddaa toora sadii sadii fi muka toora tokko tokkoon haa ijaaramu. Baasiin hundinuus qabeenya mootummaa keessaa baafamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.4",
            "verseOrgIds": [
              "EZR.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas miʼi warqee fi meetii mana Waaqaa kan Nebukadnezar mana qulqullummaa kan Yerusaalem keessaatii Baabilonitti fide sun iddoo isaanitti jechuunis mana qulqullummaa kan Yerusaalemitti deebifamanii mana Waaqaa keessa kuufamu qabu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa ati Taatenaayi bulchaan Gama Laga Efraaxiis, Satarbuznaayii fi isin michoota isaanii qondaaltonni kutaa biyya sanaa achii fagaadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin hojii mana qulqullummaa Waaqaa kana keessa hin seeninaa. Bulchaan Yihuudootaa fi maanguddoonni Yihuudootaa mana Waaqaa kana iddoo isaatti deebisanii haa ijaaran.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.7",
            "verseOrgIds": [
              "EZR.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti ani waan isin ijaarsa mana Waaqaa kana keessatti maanguddoota Yihuudootaa kanneeniif gochuu qabdan kunoo nan labsa:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.8",
            "verseOrgIds": [
              "EZR.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 6:8"
      },
      "items": [
        {
          "text": "Akka hojiin hin dhaabanneef baasiin namoota kanaa guutumaan guutuutti qabeenya mootummaa irraa jechuunis gibira Gama Laga Efraaxiisii walitti qabamu keessaa haa baafamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.8",
            "verseOrgIds": [
              "EZR.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni barbaachisu kam iyyuu jechuunis jiboonni, korbeeyyiinii fi xobbaallaawwan hoolaa Waaqa samiitiif aarsaa gubamu taʼanii dhiʼeeffaman, akkasumas qamadiin, soogiddi, daadhiin wayinii fi zayitiin akkuma luboonni Yerusaalem keessa jiraatan barbaadanitti utuu gargar hin citin guyyaa guyyaadhaan isaaniif kennamuu qabu;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.9",
            "verseOrgIds": [
              "EZR.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka isaan aarsaa Waaqa samiitti tolu dhiʼeessanii fi akka isaan jireenya mootichaa fi ilmaan isaatiif Waaqa kadhataniifii dha.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
            "verseOrgIds": [
              "EZR.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana caalaa iyyuu yoo namni kam iyyuu ajaja kana dide, ani akka utubaan mana isaa keessaa buqqifamee inni irratti fannifamu labsii kana labseera. Sababii yakka kanaatiif manni isaa tuulaa kosii ni taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.11",
            "verseOrgIds": [
              "EZR.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni inni akka Maqaan isaa achi jiraatu godhe sun mootii yookaan saba labsii kana geeddaruuf yookaan mana qulqullummaa kan Yerusaalem keessaa barbadeessuuf harka ol fudhatu kam iyyuu haa balleessu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "EZR 6:12"
      },
      "items": [
        {
          "text": "Ani Daariyoos labsii kana labseera. Wanni kunis ariitiidhaan hojii irra haa oolu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manni Qulqullummaa Xumuramee Eebbifame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Taatenaayi bulchaan biyya Gama Laga Efraaxiis, Satarbuznaayii fi michoonni isaanii akkuma Daariyoos Mootichi labsetti labsii sana ariitiidhaan hojii irra ni oolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.13",
            "verseOrgIds": [
              "EZR.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu maanguddoonni Yihuudootaa lallaba Haagee raajichaatii fi Zakkaariyaas ilma Iddootiin ijaarsa itti fufan; hojiinis ni milkaaʼeef. Isaanis akkuma ajaja Waaqa Israaʼelii fi akkuma labsiiwwan Qiiros, Daariyoosii fi Arxeksis mootota Faaresitti ijaarsa mana qulqullummaa sana ni xumuran.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manni qulqullummaa sunis waggaa jaʼaffaa bara Daariyoos Mootichaa keessa, bultii sadaffaa jiʼa Adaaritti ijaaramee dhume.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii sabni Israaʼel jechuunis luboonni, Lewwonnii fi boojiʼamtoonni hafan ayyaana eebba mana Waaqaa gammachuudhaan ayyaaneffatan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.16",
            "verseOrgIds": [
              "EZR.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eebba mana Waaqaa kanaafis jiboota dhibba tokko, korbeeyyii hoolaa dhibba lamaa fi xobbaallaa hoolaa dhibba afur kennan; sababii cubbuu Israaʼel hundaaf immoo korbeeyyii reʼee kudha lama jechuunis tokkoo tokkoo gosa Israaʼeliif reʼee tokko tokko dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.17",
            "verseOrgIds": [
              "EZR.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo akkuma Kitaaba Musee keessatti barreeffametti tajaajila mana Waaqaa kan Yerusaalem keessaa sanaaf luboota kutaa kutaa isaanitti, Lewwota immoo garee garee isaaniitti ramadan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Faasiikaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boojiʼamtoonnis guyyaa kudha afuraffaa jiʼa jalqabaatti Faasiikaa ni ayyaaneffatan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.19",
            "verseOrgIds": [
              "EZR.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luboonnii fi Lewwonni of qulqulleessanii hundi isaanii akka seeraatti ni qulqullaaʼan. Lewwonni warra boojiʼaman hundaaf, obboloota isaanii lubootaa fi ofii isaaniif hoolaa Faasiikaa qalan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.20",
            "verseOrgIds": [
              "EZR.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Israaʼeloonni boojuudhaa deebiʼan namoota",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.6.21",
                "verseOrgIds": [
                  "EZR.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼel barbaaduudhaaf hojii xuraaʼummaa kan Namoota Ormaa kanneen ollaa isaanii jiraatan sanaa lagatan hunda wajjin Faasiikaa sana ni nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.22",
            "verseOrgIds": [
              "EZR.6.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.6.22",
                "verseOrgIds": [
                  "EZR.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "akka inni hojii ijaarsa mana Waaqayyo Waaqa Israaʼel keessatti isaan gargaaruudhaaf yaada mootii Asoor geeddaruudhaan gammachuudhaan isaan guuteef isaan bultii torba guutuu Ayyaana Maxinoo Buddeena gammachuudhaan ayyaaneffatan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.22",
            "verseOrgIds": [
              "EZR.6.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EZR.7",
    "number": "7",
