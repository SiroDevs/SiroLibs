          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.24",
                "verseOrgIds": [
                  "2SA.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "loltoota Filisxeem dhaʼuudhaaf si dura baʼeera jechuudhaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
        {
