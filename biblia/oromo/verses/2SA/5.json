          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu Daawit",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
            ]
          }
        },
        {
          "name": "char",
