              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawit gara Baʼaal Pheraaziim dhaqe; achittis isaan moʼate. Innis, \"Akkuma bishaan mana isaa cabsee yaaʼu sana",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.20",
                "verseOrgIds": [
                  "2SA.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula koo duratti diinota koo cabsee baʼeera\" jedhe. Kanaafuu iddoon sun Baʼaal Pheraaziim jedhamee waamame.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni waaqota isaanii tolfamoo achitti dhiisanii baqatan; Daawitii fi namoonni isaa immoo isaan fuudhanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
      ]
    },
