  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amnoonii fi Taamaar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo tokko Amnoon ilmi Daawit Taamaarin jaallate; isheen akka malee bareedduu, obboleettii Abesaaloom ilma Daawit sanaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amnoon sababii jaalala obboleettii isaa Taamaariitiif akka malee dhiphatee dhibame; sababii isheen durba turteef Amnoon waan waanuma tokko illee ishee gochuu dandaʼu hin seene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.2",
            "verseOrgIds": [
              "2SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amnoon michuu akka malee jalʼaa kan Yoonaadaab jedhamu tokko qaba ture; Yoonaadaab ilma Shimeʼaa obboleessa Daawit.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.3",
            "verseOrgIds": [
              "2SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaadaabis Amnooniin, \"Yaa ilma mootii, dhagni kee maaliif guyyuma guyyaan huqqachaa deema? Ati natti hin himtuu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:4"
      },
      "items": [
        {
          "text": "Amnoon immoo, \"Ani Taamaar obboleettii Abesaaloom obboleessa kootii jaalladheera\" isaan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoonaadaabis, \"Sobiitii akka nama dhukkubsateetti siree irra ciisi; yommuu abbaan kee si gaafachuu dhufutti, 'Akka ani harka isheetii nyaadhuuf akka obboleettiin koo Taamaar dhuftee fuula koo duratti nyaata naa qopheessitu nan barbaada' jedhiin\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.5",
            "verseOrgIds": [
              "2SA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Amnoon sobee akka nama dhukkubsate tokkootti ciise. Yommuu mootichi isa gaafachuu dhufettis Amnoon, \"Akka obboleettiin koo Taamaar dhuftee fuula koo duratti nyaata addaa naaf qopheessitee nyaadhu nan barbaada\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.6",
            "verseOrgIds": [
              "2SA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis gara manaatti Taamaaritti nama ergee, \"Gara mana obboleessa kee Amnoon dhaqiitii waan inni nyaatu qopheessiif\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.7",
            "verseOrgIds": [
              "2SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Taamaar kaatee gara mana obboleessa ishee Amnoon kan ciisee ture sanaa dhaqxe. Daakuu xinnoo ishee fuutee bukeessitee fuula isaa duratti tolchite.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.8",
            "verseOrgIds": [
              "2SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis buddeena tolchite sana eelee irraa fuutee dhiʼeessiteef; inni garuu nyaachuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:9"
      },
      "items": [
        {
          "text": "Amnoon, \"Nama hunda narraa baasaa\" jedhe. Kanaafuu namni hundi isa biraa baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Amnoon Taamaariin, \"Akka ani harka kee irraa nyaadhuuf buddeenicha kutaa ani ciisutti naa fidi\" jedhe. Taamaaris buddeena qopheessite sana fuutee Amnoon obboleessa isheetiif lafa inni ciisetti geessite.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.10",
            "verseOrgIds": [
              "2SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu yommuu isheen nyaata dhiʼeessiteefitti humnaan ishee qabatee, \"Yaa obboleettii ko, kottuu na wajjin ciisi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.11",
            "verseOrgIds": [
              "2SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen immoo deebiftee akkana jetteen; \"Yaa obboleessa ko, waan kana hin godhin! Na hin dirqisiisin. Wanni fokkisaan akkasii Israaʼel keessatti hojjetamuu hin qabu! Ati waan hamaa kana hin godhin.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.12",
            "verseOrgIds": [
              "2SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani maalan taʼa? Salphina koos baadhee eessan dhaqa? Ati hoo? Atis Israaʼel keessatti akka gowwaa hamaa tokkootti ilaalamuu kee ti mitii? Maaloo mootichatti himadhu; inni sitti heerumuu na hin dhowwuutii.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.13",
            "verseOrgIds": [
              "2SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu ishee dhagaʼuu dide; waan ishee caalaa jabaa taʼeefis humnaan ishee gudeede.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Amnoon jibba guddaa ishee jibbe; dhugumaan hamma dur ishee jaallate caalaa ishee jibbe. Amnoonis, \"Kaʼiitii baʼii deemi!\" isheen jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.15",
            "verseOrgIds": [
              "2SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen immoo, \"Hin taʼu! Na ariʼuun kee yakka ati duraan natti hojjette caalaa hammaata\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:16"
      },
      "items": [
        {
          "text": "Inni garuu ishee dhagaʼuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajilaa ofii isaas waamee, \"Dubartii kana narraa baasiitii balbala itti cufi\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.17",
            "verseOrgIds": [
              "2SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tajaajilaan isaa sunis gad ishee baasee balbala itti cufe. Isheen uffata faaya adda addaatiin miidhagfame uffattee turte; intallan mootii kanneen dubarran qulqulluu taʼan uffata akkasii uffatu tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.18",
            "verseOrgIds": [
              "2SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taamaaris mataa isheetti daaraa firfirfattee wandaboo ishee dheeraa faayawwaniin miidhagfame sana tarsaafte. Harka ishees mataa irra kaaʼattee sagalee ol fudhattee booʼaa deemte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom obboleessi ishee, \"Amnoon obboleessi kee si wajjin turee? Yaa obboleettii ko, calʼisi; inni obboleessuma kee ti. Waan kana garaatti hin qabatin\" jedheen. Taamaaris kophaa ishee mana obboleessa ishee mana Abesaaloom jiraatte.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit mootichi yommuu waan kana hunda dhagaʼetti baayʼee aare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.21",
            "verseOrgIds": [
              "2SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom dubbii tolaa yookaan hamaa tokko illee Amnoonitti hin dubbanne; Abesaaloom sababii inni obboleettii isaa Taamaarin salphiseef akka malee Amnoonin jibbee ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abesaaloom Amnoonin Ajjeese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa lamaa booddee warri hoolota Abesaaloom irraa rifeensa haadan magaalaa Baʼaal Hasoor kan Efreem biratti argamu sana keessa turan; innis akka isaan achi dhaqaniif ilmaan mootii hunda waame.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.23",
            "verseOrgIds": [
              "2SA.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloomis gara mootichaa dhaqee, \"Namoonni hoolota garbicha keetii irraa rifeensa haadan dhufaniiru. Maaloo mootichii fi qondaaltonni isaa garbicha kee wajjin haa deeman\" jedhee kadhate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi immoo deebisee, \"Lakki yaa ilma ko, nu hundinuu deemuu hin qabnu; nu baʼaa qofa sitti taanaa\" jedheen. Abesaaloom jabeessee isa kadhatu iyyuu inni isa eebbise malee isa faana hin deemne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloomis, \"Yoo taʼuu baate, maaloo obboleessi koo Amnoon nu wajjin haa deemu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:26"
      },
      "items": [
        {
          "text": "Mootichi immoo, \"Inni maaliif si wajjin deema?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom garuu jabeessee isa kadhate; kanaafuu inni Amnoonii fi ilmaan mootichaa kaan isa wajjin erge.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom akkana jedhee namoota isaa ajaje; \"Dhagaʼaa! Yommuu Amnoon daadhii wayinii dhugee machaaʼutti ani, 'Amnoonin dhaʼaa' isiniin jedha; isinis yommuu suma isa ajjeesaa. Hin sodaatinaa. Anatu ajaja kana isinii kenne mitii? Jabaadhaa; jagnoomaas.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.28",
            "verseOrgIds": [
              "2SA.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu namoonni Abesaaloom waanuma Abesaaloom isaan ajaje sana Amnoonitti hojjetan. Ilmaan mootichaa hundinuus kaʼanii gaangolii isaanii yaabbatanii baqatan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu isaan karaa irra jiranuu oduun, \"Abesaaloom ilmaan mootichaa hunda fixeera; tokkoon isaanii iyyuu hin hafne\" jedhu Daawit qaqqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.30",
            "verseOrgIds": [
              "2SA.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis ol kaʼee uffata isaa tarsaasee lafa ciise; tajaajiltoonni isaa kanneen isa bira dhadhaabatanii turan hundinuus uffata isaanii tatarsaasan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaadaab ilmi Shimeʼaa ilmi obboleessa Daawit sun garuu akkana jedhe; \"Gooftaan koo waan isaan ilmaan mootichaa hunda fixan hin seʼin; Amnoon qofatu duʼe. Kunis waan Abesaaloom erga Amnoon obboleettii isaa Taamaarin humnaan gudeedee jalqabee itti yaadaa turee dha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan koo mootichi waaʼee oduu ilmaan mootichaa hundi ajjeefamaniiru jedhu sanaa hin yaaddaʼin; Amnoon qofatu duʼe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Abesaaloom baqateera.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:34"
      },
      "items": [
        {
          "text": "Namichi eegumsaaf dhaabatee tures ol jedhee ilaalee namoota baayʼee daandii Horonaayim kan gaara cina baʼu irra dhufaa jiran arge. Namichi sunis dhaqee, \"Ani karaa Horonaayim, cina gaaraatti namoota nan arga\" jedhee mootichatti hime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaadaabis mootichaan, \"Kunoo, ilmaan mootichaa dhufanii jiru; wanni kun akkuma garbichi kee jedhe taʼe\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma inni dubbatee fixateen ilmaan mootichaa sagalee guddaadhaan booʼaa ol galan. Mootichii fi tajaajiltoonni isaa hundinuus hiqqifatanii booʼan.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom garuu baqatee gara ilma Amiihuud, gara Talmaay mooticha Geshuur sanaa dhaqe. Daawit immoo guyyaa hunda ilma isaatiif ni booʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abesaaloom erga baqatee Geshuur dhaqee booddee waggaa sadii achi ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis duʼa Amnoon irraa jajjabaannaan gara Abesaaloom dhaquuf garaan isaa kakaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
    }
  ],
