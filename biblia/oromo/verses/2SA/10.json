        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Amoonota Moʼachuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
