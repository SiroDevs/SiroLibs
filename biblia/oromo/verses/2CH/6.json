      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Solomoon akkana jedhe; \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.1",
                "verseOrgIds": [
                  "2CH.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akka duumessa dukkanaaʼaa keessa jiraatu dubbateera;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani mana qulqullummaa guddaa, iddoo ati bara baraan jiraattu siif ijaareera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma waldaan Israaʼel guutuun achi dhaabatuu mootichi of irra garagalee isaan eebbise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.4",
                "verseOrgIds": [
                  "2CH.6.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel inni waan afaan ofii isaatiin abbaa koo Daawitiif waadaa gale sana harkuma ofii isaatiin guute sun haa eebbifamu. Innis akkana jedhee tureetii;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ani gaafan saba koo Gibxii baasee jalqabee akka Maqaan koo achi jiraatuuf jedhee mana qulqullummaa itti ijaarsifachuuf gosoota Israaʼel kam iyyuu keessatti magaalaa tokko illee hin filanne, yookaan akka inni bulchaa saba koo Israaʼel taʼuuf nama tokko illee hin filanne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu akka maqaan koo achi jiraatuuf Yerusaalemin filadheera; akka inni saba koo Israaʼelin bulchuufis Daawitin filadheera.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Daawit abbaan koo Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.7",
                "verseOrgIds": [
                  "2CH.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼeliif mana qulqullummaa ijaaruuf garaa isaatii yaada qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.8",
                "verseOrgIds": [
                  "2CH.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu abbaa koo Daawitiin akkana jedhe; 'Waan mana qulqullummaa maqaa kootiif ijaaruun yaada kee keessa jiruuf, ati yaada kana garaadhaa qabaachuun kee gaarii dha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus namni mana qulqullummaa naaf ijaaru siʼi miti; garuu ilma kee, isuma foon keetii fi dhiiga kee taʼetu ijaara; namni mana qulqullummaa Maqaa kootiif ijaaru isa.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "waadaa gale sana eegeera; akkuma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "waadaa gale sana ani amma iddoo abbaa koo Daawit buʼee teessoo Israaʼel irra taaʼeen jira; Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa Israaʼeliifis mana qulqullummaa ijaareera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis achi keessa taabota kaaʼeera; taabota sana keessa immoo kakuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.11",
                "verseOrgIds": [
                  "2CH.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kan inni saba Israaʼel wajjin galetu jira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kadhannaa Solomoon",
          "type": "text"
        }
      ]
