    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Saamtonni Araboota wajjin qubata loltootaa seenan sun ilmaan isaa hangafoota hunda fixaniif namoonni Yerusaalem Ahaaziyaa ilma Yehooraam sana iddoo isaa buusanii mootii godhan. Kanaafuu Ahaaziyaa ilmi Yehooraam mooticha Yihuudaa sun mootii taʼee bulchuu ni jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.1",
            "verseOrgIds": [
              "2CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaaziyaa yeroo mootii taʼetti umuriin isaa waggaa digdamii lama ture; innis Yerusaalem keessa taaʼee waggaa tokko ni bulche. Maqaan haadha isaa Ataaliyaa dha; isheenis intala ilma Omrii turte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.2",
            "verseOrgIds": [
              "2CH.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis sababii haati isaa akka inni dogoggora hojjetu isa jajjabeessaa turteef karaa mana Ahaab duukaa buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.3",
            "verseOrgIds": [
              "2CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii manni Ahaab erga abbaan isaa duʼee booddee gorsitoota isaa taʼuudhaan gara yakka hojjechuutti isa oofaniif, innis akkuma manni Ahaab godhe sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.4",
                "verseOrgIds": [
                  "2CH.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.4",
            "verseOrgIds": [
              "2CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni yeroo Yehooraam ilma Ahaab mooticha Israaʼel wajjin Raamooti Giliʼaaditti Hazaaʼeel mooticha Arraam loluudhaaf duuletti gorsuma isaanii duukaa buʼe. Warri Arraamis Yooraamin ni madeessan;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.5",
            "verseOrgIds": [
              "2CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu inni madaa isaan yeroo inni Raamaat keessatti Hazaaʼeel mooticha Arraam wajjin wal loletti isa madeessan sana fayyuuf jedhee Yizriʼeelitti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 22:6"
      },
      "items": [
        {
          "text": "Kana irratti Ahaaziyaan ilmi Yooraam mootichi Yihuudaa sababii inni madaaʼee tureef Yehooraam ilma Ahaab arguuf gara Yizriʼeelitti gad buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.6",
            "verseOrgIds": [
              "2CH.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii inni Yehooraamin gaafachuu dhaqeef Waaqni Ahaaziyaatti badiisa fide. Ahaaziyaan yommuu achi gaʼetti Yehuu ilma Nimshii sana simachuuf Yooraam wajjin gad baʼe. Yehuun immoo nama",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.7",
                "verseOrgIds": [
                  "2CH.22.7"
                ]
              }
            }
          ]
        },
        {
          "text": "akka inni mana Ahaab balleessuuf dibee dha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehuun utuu mana Ahaabitti muraa jiruu qondaaltota Yihuudaa fi ilmaan firoota Ahaaziyaa kanneen Ahaaziyaa tajaajilaa turan argee isaan ni galaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo inni Ahaaziyaa barbaacha ni deeme; namoonni Yehuus Samaariyaadhaa iddoo inni itti dhokatee turee qabanii Yehuutti fidanii isa ni ajjeesan. Isaanis, \"Inni ilma Yehooshaafaax namicha garaa guutuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "2CH.22.9",
                "verseOrgIds": [
                  "2CH.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "barbaade sanaa ti\" jedhanii isa ni awwaalan. Kanaafuu mana Ahaaziyaa keessaa namni aangoo mootummaa qabachuu dandaʼu tokko illee hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ataaliyaa fi Yooʼaash",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
