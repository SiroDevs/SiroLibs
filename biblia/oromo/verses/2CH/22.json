              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "2KI.11.1-2KI.11.21"
              },
              "items": [
                {
                  "text": "2Mt 11:1‑21",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataaliyaan haati Ahaaziyaa yommuu akka ilmi ishee duʼe argitetti kaatee maatii mana mootii Yihuudaa guutumaan guutuutti balleessite.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshebaati intalli Yehooraam Mootichaa garuu ilmaan moototaa kanneen ajjeefamuuf turan keessaa Yooʼaash ilma Ahaaziyaa hattee fudhachuudhaan guddiftuu isaa wajjin dinqatti ni dhoksite. Yoshabeti intalli Iyyooraam Mootichaa, niitiin Yehooyaadaa lubichaa sun obboleettii Ahaaziyaa turte; isheenis akka Ataaliyaan isa hin ajjeefneef mucaa sana dhoksite.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bara Ataaliyaan biyya bulchaa turte hunda isaan wajjin mana qulqullummaa Waaqaa keessatti dhokfamee waggaa jaʼa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
    }
  ],
