          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziyaan mootichi hamma gaafa duʼuutti lamxaaʼee ture. Innis waan lamxaaʼee tureef mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.21",
                "verseOrgIds": [
                  "2CH.26.21"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa citee mana kophaa keessa ni jiraate. Ilmi isaa Yootaam ilmi isaa itti gaafatama masaraa mootummaa fudhatee saba biyyattii bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        }
