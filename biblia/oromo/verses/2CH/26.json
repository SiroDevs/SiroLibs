              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Uziyaan keessa jalqabaa hamma dhumaatti hojjetaman biraan Isaayyaas raajicha ilma Amoosiin galmeeffamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.22",
            "verseOrgIds": [
              "2CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
