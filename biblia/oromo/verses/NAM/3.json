      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "akka malee sin tuffadha;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:6"
      },
      "items": [
        {
          "text": "waan kolfaa illee sin godha.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
          }
        }
      ]
