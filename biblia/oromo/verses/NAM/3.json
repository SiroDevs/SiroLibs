      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "biyya laga Abbayyaa irraa",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "kan bishaaniin marfamte sana caaltaa?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "Lagni daʼoo ishee ti;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:8"
      },
      "items": [
        {
          "text": "bishaanis dallaa ishee ti.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
    },
    {
