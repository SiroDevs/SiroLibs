      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "biyya ormaatti geeffamte.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "Daaʼimman ishee mataa daandii hundaa irratti",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "miciriqfamanii dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
