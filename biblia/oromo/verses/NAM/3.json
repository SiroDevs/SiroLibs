      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:1"
      },
      "items": [
        {
          "text": "kan sobaan guutamteef,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.1",
            "verseOrgIds": [
              "NAM.3.1"
            ]
          }
        }
      ]
