          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itoophiyaa fi Gibxi jabina ishee kan dhuma hin qabnee dha;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:9"
      },
      "items": [
        {
          "text": "Fuuxii fi Liibiyaan tumsitoota ishee ti.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus isheen boojiʼamtee",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        }
      ]
    },
    {
