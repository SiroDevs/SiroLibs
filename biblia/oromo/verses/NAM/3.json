          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati, Nooʼi Amoon",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        }
      ]
