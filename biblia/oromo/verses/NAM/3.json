          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaan fardaa ni gulufa;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "goraadeen ni balaqqisa;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "eeboon ni calaqqisa!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "Balaan hedduun nama irra gaʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "namni baayʼeen duʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "reeffi lakkoobsa hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "namoonnis reeffa isaaniitti gufatu;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
