                "verseId": "NAM.3.5",
                "verseOrgIds": [
                  "NAM.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "\"Ani sitti kaʼeen jira.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "Ani uffata kee fuula keetti ol soqola.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "Ani sabootatti qullaa kee,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:5"
      },
      "items": [
        {
          "text": "mootummootatti immoo qaanii kee nan mulʼisa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
