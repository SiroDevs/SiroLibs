    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karoora Namaatii fi Karoora Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra daba karoorfatan",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "kanneen siree isaanii irra",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "ciisanii hammina yaadaniif wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "Sababii waan kana hojjechuun humna isaanii jala jiruuf",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:1"
      },
      "items": [
        {
          "text": "isaan ifa bariitiin kaʼanii waan sana hojjetu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.1",
            "verseOrgIds": [
              "MIC.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan lafa qotiisaa kajeelanii qabatu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "manneenis akkasuma kajeelanii fudhatu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "Isaan gowwoomsaadhaan mana namaa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:2"
      },
      "items": [
        {
          "text": "dhaala isaas ni fudhatu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.2",
            "verseOrgIds": [
              "MIC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.3",
                "verseOrgIds": [
                  "MIC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "\"Kunoo ani balaa isin jalaa baʼuu hin dandeenye tokko",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "saba kanatti fiduuf karoorfadheen jira.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "Isin siʼachi of tuulummaadhaan jiraachuu hin dandeessan;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:3"
      },
      "items": [
        {
          "text": "yeroon kun yeroo rakkinaa taʼaatii.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.3",
            "verseOrgIds": [
              "MIC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa namoonni isinitti gaʼisu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "akkana jedhaniis faaruu booʼichaa kanaan isinitti qoosu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "'Nu guutumaan guutuutti barbadoofneerra;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "qabeenyi saba kootiis gargar qooddatameera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "Inni narraa fudhata!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:4"
      },
      "items": [
        {
          "text": "Lafa qotiisaa keenya warra nu moʼataniif kenna.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.4",
            "verseOrgIds": [
              "MIC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ati nama ixaadhaan lafa qoodu tokko illee",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:5"
      },
      "items": [
        {
          "text": "waldaa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.5",
                "verseOrgIds": [
                  "MIC.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "keessaa hin qabaattu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.5",
            "verseOrgIds": [
              "MIC.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raajota Sobaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajonni isaanii, \"Isin raajii hin dubbatinaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:6"
      },
      "items": [
        {
          "text": "waaʼee waan kanaa raajii hin dubbatinaa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:6"
      },
      "items": [
        {
          "text": "salphinni nutti hin dhufu\" jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa mana Yaaqoob, \"Wanni kun akkana jedhamuu qabaa?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "Hafuurri",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MIC.2.7",
                "verseOrgIds": [
                  "MIC.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "obsa hin qabuu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "Inni waan akkasii ni hojjetaa?\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MIC 2:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "\"Nama karaan isaa qajeelaa taʼeef",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:7"
      },
      "items": [
        {
          "text": "dubbiin koo waan gaarii hin hojjetuu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni koo akka diinaatti kaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "Isin namoota yaaddoo malee achiin darban",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:8"
      },
      "items": [
        {
          "text": "kanneen duulaa galaa jiran irraa uffata baafattu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin dubartoota saba kootii",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "manneen isaanii babbareedoo keessaa ariitu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "Eebba koos bara baraan",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:9"
      },
      "items": [
        {
          "text": "ijoollee isaanii irraa fudhattu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaʼaatii asii deemaa!",
          "type": "text",
          "attrs": {
