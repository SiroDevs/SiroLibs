  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "DAN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abjuu Nebukadnezar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar bara mootummaa isaa keessa, waggaa lammaffaatti abjuu abjoote; hafuurri isaa jeeqamee hirribas rafuu dadhabe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.1",
            "verseOrgIds": [
              "DAN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu mootichi akka isaan abjuu inni abjoote sana itti himaniif tolchitoota, mortoota, falfaltootaa fi warra urjii ilaalan waamsise; isaanis ol galanii fuula isaa dura dhadhaabatan;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.2",
            "verseOrgIds": [
              "DAN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mootichis, \"Ani abjuu na dhiphise tokko nan abjoodhe; hiikkaa abjuu sanaa maal akka taʼe beekuu nan barbaada\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.3",
            "verseOrgIds": [
              "DAN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti warri urjii ilaalan sun afaan Araamaayikiitiin mootichaan, \"Yaa mootii, bara baraan jiraadhu! Abjuu kee tajaajiltoota keetti himi; nu siif hiiknaa\" jedhanii mootichaaf deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.4",
            "verseOrgIds": [
              "DAN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis warra urjii ilaalan sanaan akkana jedhe; \"Ani waan kana murteesseera: Yoo isin abjuu koo fi hiikkaa isaa natti himuu baattan ani isinan kukkuta; manneen keessanis tuulaa waan diigamee taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.5",
            "verseOrgIds": [
              "DAN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo abjuu sanaa fi hiikkaa isaa natti himtan isin kennaa, badhaasaa fi ulfina guddaa narraa argattu. Kanaafuu abjuu sanaa fi hiikkaa isaa natti himaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.6",
            "verseOrgIds": [
              "DAN.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan amma illee deebisanii, \"Mootichi abjuu isaa tajaajiltoota isaatti haa himu; nu ni hiiknaaf\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.7",
            "verseOrgIds": [
              "DAN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti mootichi akkana jedhee deebiseef; \"Ani akka isin sababii waan ani cimsee murteesse beektaniif, akka isin yeroo dheeressuu yaalaa jirtan hubadheera:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.8",
            "verseOrgIds": [
              "DAN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isin abjuu sana natti himuu baattan, adabbii tokkotu isin eeggata. Isin waan haalli geeddaramu seetanii dubbii dogoggorsaa fi hamaa natti himuu mariʼattaniirtu. Kanaafuu abjuu sana natti himaa; anis akka isin hiikkaa isaa natti himuu dandeessan kanaan nan beekaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.9",
            "verseOrgIds": [
              "DAN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri urjii ilaalan sunis akkana jedhanii mootichaaf deebise; \"Namni waan mootichi gaafate kana hojjechuu dandaʼu tokko iyyuu lafa irratti hin argamu! Mootiin kam iyyuu hammuma fedhee guddaa fi jabaa taʼu illee tolchituu, moortuu yookaan warra urjii ilaalu kam iyyuu gaaffii akkanaa gaafatee hin beeku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.10",
            "verseOrgIds": [
              "DAN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni mootichi gaafate akka malee rakkisaa dha. Waaqota malee namni tokko iyyuu waan kana mootichaaf ibsuu hin dandaʼu; isaan immoo namoota gidduu hin jiraatan.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.11",
            "verseOrgIds": [
              "DAN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni kunis mooticha akka malee aarse; isa dallansiisees akka inni ogeeyyii Baabilon hundatti murtii duʼaa muru godhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.12",
            "verseOrgIds": [
              "DAN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu akka namoonni ogeeyyiin hundi ajjeefaman labsiin baʼe; namoonnis akka Daaniʼelii fi michoota isaa barbaadanii ajjeesaniif ergaman.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.13",
            "verseOrgIds": [
              "DAN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Ariyook itti gaafatamaan eegumsa mootichaa namoota Baabilon ogeeyyii ajjeesuuf baʼetti, Daaniʼel ogummaa fi malaan isa haasofsiise.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.14",
            "verseOrgIds": [
              "DAN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis qondaala mootichaatiin, \"Mootichi maaliif labsii cimaa akkasii baase?\" jedhee gaafate. Ariyookis waan sana Daaniʼelitti hime.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.15",
            "verseOrgIds": [
              "DAN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Daaniʼel ol seenee akka abjuu sana isaaf hiikuuf akka mootichi yeroo isaa kennu gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.16",
            "verseOrgIds": [
              "DAN.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Daaniʼel gara mana isaatti deebiʼee waan sana michoota isaa Hanaaniyaatti, Miisaaʼelii fi Azariyaatti hime.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.17",
            "verseOrgIds": [
              "DAN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu akka innii fi michoonni isaa ogeeyyiin Baabilon kaan hin ajjeefamneef akka isaan waaʼee icciitii kanaa Waaqa samii araara kadhatan isaan akeekkachiise.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.18",
            "verseOrgIds": [
              "DAN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkan sanas icciitiin sun mulʼataan Daaniʼelitti mulʼifame. Ergasiis Daaniʼel Waaqa samii galateeffatee",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.19",
            "verseOrgIds": [
              "DAN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:20"
      },
      "items": [
        {
          "text": "\"Maqaan Waaqaa bara baraa",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "hamma bara baraatti haa eebbifamu;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:20"
      },
      "items": [
        {
          "text": "ogummaanii fi humni kan isaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni barootaa fi waqtiilee ni geeddara;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "mootota teessoo irra ni teessisa; irraa buusas.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "Inni ogeeyyiif ogummaa,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "beektotaafis hubannaa ni kenna.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan gad fagoo fi waan dhokfame ni mulʼisa;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:22"
      },
      "items": [
        {
          "text": "waan dukkana keessa jiru ni beeka;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:22"
      },
      "items": [
        {
          "text": "ifnis isa wajjin jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa abbootii ko, ani sin galateeffadha; sin jajadhas:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "Ati ogummaa fi humna naa kenniteerta;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "waan nu si kadhanne na beeksifteerta;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "ati abjuu mootichaa nu beeksifteerta.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daaniʼel Abjuu sana Hiike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaniʼelis Ariyook isa mootichi akka inni ogeeyyii Baabilon ajjeesuuf ajaje sana bira deemee, \"Ati ogeeyyii Baabilon hin ajjeesin. Mooticha biratti na geessi; ani abjuu isaa nan hiikaaf\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.24",
            "verseOrgIds": [
              "DAN.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariyookis Daaniʼelin mooticha bira geessee, \"Ani boojiʼamtoota Yihuudaa keessaa nama hiikkaa abjuu mootichaa himuu dandaʼu tokko argeera\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.25",
            "verseOrgIds": [
              "DAN.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Daaniʼel isa Beelxishaazaar jedhame sanaan, \"Ati abjuu ani argee fi hiikkaa isaa natti himuu dandeessaa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaniʼelis deebisee akkana jedhe; \"Namni ogeessi kam iyyuu, mortuun, tolchituun yookaan ilaaltuun icciitii waan mootichi gaafate sanaa ibsuu dandaʼu tokko iyyuu hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.27",
            "verseOrgIds": [
              "DAN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu Waaqni icciitii mulʼisuu tokko samii irra jira. Innis wantoota baroota dhufan keessa taʼan Nebukadnezar mootichatti argisiiseera. Abjuun keetii fi mulʼanni utuu ati siree kee irra ciiftuu yaada keetti dhufe kanaa dha:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa mooticha utuu ati ciiftee jirtuu wanni gara fuula duraatti taʼuuf jiru yaada keetti dhufe; inni icciitii mulʼisus waan fuula duratti taʼu sitti argisiise.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.29",
            "verseOrgIds": [
              "DAN.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa mootii, akka kootti sababiin icciitiin kun natti mulʼateef ani namoota jiraatoo kaan caalaa ogummaa qabaadheef utuu hin taʼin, akka ati hiikkaa isaa beektee waan yaada kee keessa jiru hubattuuf.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa mootii, ati ni ilaalte; fuula kee duras fakkii guddaa jechuunis fakkii akka malee guddaa, bifa calaqqisaa fi sodaachisaa tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.31",
            "verseOrgIds": [
              "DAN.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataan fakkii sanaas warqee qulqulluu irraa, qomaa fi irreen isaa meetii irraa, garaa fi tafni isaa naasii irraa hojjetaman;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.32",
            "verseOrgIds": [
              "DAN.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "miilli isaa sibiila irraa, faanni isaa gartokko sibiila irraa, gartokko immoo suphee irraa hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.33",
            "verseOrgIds": [
              "DAN.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma ati ilaalaa jirtuu dhagaan tokko utuu harki namaa hin tuqin fottoqe. Innis miilla fakkii sanaa kan sibiilaa fi suphee irraa hojjetame dhaʼee caccabse.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.34",
            "verseOrgIds": [
              "DAN.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii sibiilli, supheen, naasiin, meetii fi warqeen sun yeruma tokkotti caccabanii akkuma habaqii yeroo bonaa oobdii irra jiruu taʼan. Bubbeenis utuu waan tokko illee hin hambisin haree deeme. Dhagaan fakkii sana caccabse sun garuu tulluu guddaa taʼee lafa hunda guute.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abjuun sun kana ture; nus mootichaaf ni hiikna.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.36",
            "verseOrgIds": [
              "DAN.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa mootii, ati mootii moototaa ti. Waaqni samii mootummaa fi humna, jabinaa fi ulfina siif kenneera;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.37",
            "verseOrgIds": [
              "DAN.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni sanyii namaa, bineensota bosonaatii fi simbirroota samii dabarsee harka keetti siif kenneera. Lafa isaan jiraatani kamitti iyyuu hunda isaanii irratti bulchaa si godheera. Ati mataa warqee ti.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Siʼiin duuba mootummaan mootummaa keetii gadii biraa tokko ni kaʼa. Itti aansee mootummaan Naasii sadaffaan kan tokko guutummaa lafaa ni bulcha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.39",
            "verseOrgIds": [
              "DAN.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuma irrattis mootummaan afuraffaan akkuma sibiilaa jabaa taʼe tokko ni kaʼa; sibiilli waan hunda caccabsee bulleessaatii; mootummaan kunis akkuma sibiilli waan hunda caccabsee balleessu sana mootummoota isa duraan turan hunda caccabsee ni bulleessa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.40",
            "verseOrgIds": [
              "DAN.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ati akka faannii fi qubni miilla isaa gartokko suphee, gartokko immoo sibiila taʼe argite sana mootummaan kun mootummaa gargar qoodame taʼa; taʼus inni akkuma sibiila gartokkeen isaa supheedhaan makame kan ati argite sanaa jabina sibiilaa of keessaa ni qabaata.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.41",
            "verseOrgIds": [
              "DAN.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma qubni miillaa sun gartokko sibiila, gartokko immoo suphee taʼe sana mootummaan kunis gartokko jabaa, gartokko immoo dadhabaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.42",
            "verseOrgIds": [
              "DAN.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ati sibiila supheedhaan wal make argite sana uummanni kunis walmakaa taʼa; innis siʼachi sibiilaa fi supheen walitti makame sana caalaa tokko taʼee hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.43",
            "verseOrgIds": [
              "DAN.2.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bara mootota sanaa keessa, Waaqni samii mootummaa gonkumaa hin diigamne yookaan saba biraatiif hin kennamne hundeessa. Innis mootummoota duraa sana ni barbadeessa; hamma dhumaattis isaan balleessa; inni mataan isaa garuu bara baraan jabaatee ni dhaabata.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.44",
            "verseOrgIds": [
              "DAN.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiikkaan mulʼata dhagaa utuu harka namaatiin hin taʼin ofuma isaatiin tulluu irraa fottoqee sibiila, naasii, suphee, meetii fi warqee caccabse sanaa kanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 2:45"
      },
      "items": [
        {
          "text": "\"Waaqni guddaan waan gara fuula duraatti taʼu mootichatti argisiiseera. Abjuun sun dhugaa dha; hiikkaan isaas amanamaa dha.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DAN 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar mootichi addaan lafatti gombifamee Daaniʼeliif sagade; ulfinas kenneef; akka aarsaa fi ixaana isaaf dhiʼeessanis ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.46",
            "verseOrgIds": [
              "DAN.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DAN 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Daaniʼeliin, \"Ati dhoksaa kana mulʼisuu dandeesseertaatii dhugumaan Waaqni kee Waaqa waaqotaatii fi Gooftaa moototaa kan dhoksaa mulʼisuu dha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.47",
            "verseOrgIds": [
              "DAN.2.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DAN 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii mootichi Daaniʼeliif taayitaa guddaa kennee, kennaa akka malee baayʼees itti dhangalaase. Bulchaa guutummaa kutaalee biyyaa Baabilon isa godhee namoota Baabilon hunda irratti isa muude.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.48",
            "verseOrgIds": [
              "DAN.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DAN 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaniʼel mooticha kadhannaan mootichi Shaadraak, Meeshakii fi Abdanaagoo bulchitoota biyya Baabilon godhee muude. Daaniʼel garuu mana mootichaa keessatti hafe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.49",
            "verseOrgIds": [
              "DAN.2.49"
            ]
          }
        }
      ]
    }
  ],
