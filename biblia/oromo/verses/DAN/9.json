  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "DAN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kadhannaa Daaniʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Daariyoos ilma Ahashweroos namicha Meedee kan mootummaa Kaldootaa irratti bulchaa taasifame sanaa keessa waggaa tokkoffaatti",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.1",
            "verseOrgIds": [
              "DAN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bara mootummaa isaa keessa waggaa tokkoffaatti ani Daaniʼel dubbii",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.2",
                "verseOrgIds": [
                  "DAN.9.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Ermiyaas raajichaaf kenname irraa akka Yerusaalem waggaa torbaatamaaf ontee turtu kitaabota qulqulluu irraa nan hubadhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani deebii barbaadee kadhannaa fi waammataan, soomaan, wayyaa gaddaa uffachuudhaa fi daaraa keessa taaʼuudhaan gara Waaqayyoo Gooftaatti nan deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.4",
                "verseOrgIds": [
                  "DAN.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kootti kadhannaa dhiʼeessee akkana jedheen cubbuu saba kootii himadhe:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 9:4"
      },
      "items": [
        {
          "text": "\"Yaa Gooftaa, Waaqa guddaa fi akka malee sodaachisaa kan warra si jaallatanii ajaja kee eegan hundaaf kakuu jaalala keetii eegdu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu cubbuu hojjenneerra; balleessineerras. Nu jalʼoota turre; fincilleerras; ajajaa fi seera kee irraa garagalleerra.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
            "verseOrgIds": [
              "DAN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu tajaajiltoota kee raajota warra maqaa keetiin mootota keenyatti, ilmaan mootota keenyaatti, abbootii keenyaa fi saba lafaa hundatti dubbatan sana hin dhaggeeffanne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Gooftaa, ati qajeelaa dha; garuu nu namoonni Yihuudaa, sabni Yerusaalemii fi Israaʼel kanneen ati sababii amanamummaa dhabuu keenyaatiin biyyoota dhiʼoo fi fagoo keessa bittinneessite hundi harʼa qaaniidhaan haguugamneerra.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.8",
                "verseOrgIds": [
                  "DAN.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nuu fi mootonni keenya, ilmaan moototaatii fi abbootiin keenya waan cubbuu sitti hojjenneef qaaniidhaan haguugamneerra.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo nu isatti fincillee jiraanne iyyuu Waaqni keenya Gooftichi araara qabeessa; dhiifamas namaaf godha;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.10",
                "verseOrgIds": [
                  "DAN.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenyaaf hin ajajamne yookaan seera isaa kan inni karaa tajaajiltoota isaa raajotaatiin nuuf kenne sana hin eegne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni hundinuu siif ajajamuu diduudhaan seera kee cabsaniiru; sirraa garagalaniirus.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 9:11"
      },
      "items": [
        {
          "text": "\"Kanaafuu sababii nu cubbuu sitti hojjenneef abaarsaa fi kakuun Seera Musee garbicha Waaqaa sanaa keessatti barreeffame nurratti dhangalaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati balaa guddaa nutti fiduudhaan dubbii nuu fi bulchitoota keenya irratti dubbatame sana raawwatteerta. Wanni akka waan Yerusaalem irratti taʼe sanaa takkumaa guutummaa samiitii gaditti taʼee hin beeku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.12",
            "verseOrgIds": [
              "DAN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Seera Musee keessatti barreeffametti balaan kun hundi nutti dhufeera; taʼu iyyuu nu qalbii jijjiirrannee dhugaa duukaa buʼuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.13",
                "verseOrgIds": [
                  "DAN.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya irraa araara hin barbaanne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.14",
                "verseOrgIds": [
                  "DAN.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": "balaa nutti fiduu irraa duubatti hin deebine;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.14",
                "verseOrgIds": [
                  "DAN.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keenya waan hojjetu hundaan qajeelaadhaatii; nu garuu isaaf hin ajajamne.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Egaa amma yaa Waaqa keenya Gooftaa, kan irree jabaadhaan saba kee biyya Gibxi baaftee akka maqaan kee akkuma harʼa jiru kana beekamu goote, nu cubbuu hojjenneerra; balleessineerras.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.15",
            "verseOrgIds": [
              "DAN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Gooftaa, akkuma hojii kee qajeelaa sana hundaatti Yerusaalem magaalaa keetii fi gaara kee qulqulluu irraa aarii fi dheekkamsa kee deebisi. Cubbuun keenyaa fi balleessaan abbootii keenyaa namoota naannoo keenya jiraatan hunda biratti akka Yerusaalemii fi sabni kee waan kolfaa taʼan godheera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.16",
            "verseOrgIds": [
              "DAN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Egaa yaa Waaqa keenya, kadhannaa fi waammata garbicha keetii dhagaʼi. Yaa Gooftaa, ulfina keetiif jedhiitii fuula kee gara iddoo kee qulqulluu one sanaatti deebisi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.17",
            "verseOrgIds": [
              "DAN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa ko, gurra itti qabii dhagaʼi; ija kee banadhuutii badii keenyaa fi magaalaa Maqaan kee ittiin waamame sana ilaali. Nu utuu waaʼee qajeelummaa keenyaatiif hin taʼin sababii araara kee guddaa sanaatiif si kadhanna.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.18",
            "verseOrgIds": [
              "DAN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Gooftaa dhaggeeffadhu! Yaa Gooftaa dhiifama nuu godhi! Yaa Gooftaa dhagaʼiitii waa hojjedhu! Yaa Waaqa ko, sababii magaalaan keetii fi sabni kee Maqaa keetiin waamamuuf ati hin turin.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Torban \"Torbaatama\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu ani dubbichaa fi kadhachaa, cubbuu kootii fi cubbuu saba koo Israaʼel himachaa, tulluu isaa qulqulluufis",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DAN.9.20",
                "verseOrgIds": [
                  "DAN.9.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa koo gaafachaa jiruu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "utuu ani amma illee kadhannaa irra jiruu, Gabriʼeel namichi ani mulʼata koo duraa keessatti arge sun, yeroo aarsaa galgalaatti ariitiidhaan barrisaa gara koo dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee na barsiise; akkanas naan jedhe; \"Yaa Daaniʼel ani amma ogummaa fi hubannaa siif kennuuf dhufeera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ati Waaqa kadhachuu jalqabdeen deebiin ani sitti himuuf dhufe kun siif kenname; ati akka malee jaalatamaadhaatii. Kanaafuu ergaa kana qalbeeffadhuutii mulʼata sana hubadhu:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dogoggora hambisuuf, cubbuu balleessuuf, araara yakkaa buusuuf, qajeelummaa bara baraa fiduuf, mulʼataa fi raajii chaappaadhaan cufuuf, Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe sana dibuuf saba keetii fi magaalattii qulqulluu keetiif 'torban' torbaatamni labsameera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waan kana beeki; hubadhus: Gaafa labsiin Yerusaalemin haaromsuu fi deebisanii ijaaruuf labsame kun baʼee jalqabee hamma Masiihichi, Bulchaan dhufutti 'torban' torbaatamaa fi torban jaatamii lama taʼa. Isheen daandiiwwanii fi dallaa wajjin ni haaromfamti; garuu wanni kun yeroo rakkinaa keessa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Torban' jaatamii lama booddee Masiihichi ni ajjeefama; wanni tokko iyyuu isaaf hin hafu. Namoonni bulchaa dhufuuf jiru tokkoo magaalaa sanaa fi iddoo qulqulluu ni barbadeessu. Dhumnis akkuma lolaatti dhufa: Waraanni hamma dhumaatti itti fufa; badiisnis labsameera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulchaan kunis 'Torban' tokkoof namoota baayʼee wajjin kakuu godhata; walakkaa 'Torban' sanaatti aarsaa fi kennaan akka hafu godha. Innis hamma wanni labsame sun isa irratti dhangalaʼutti waan xuraaʼaa badiisa fidu mana qulqullummaa gubbaa ni dhaaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.27",
            "verseOrgIds": [
              "DAN.9.27"
            ]
          }
        }
      ]
    }
