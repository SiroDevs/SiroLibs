  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "REV 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubartittii fi Bineensa Jawwee Fakkaatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mallattoon guddaan tokko samii keessatti mulʼate: dubartii biiftuu uffattee miilla ishee jalaa jiʼa qabdu kan mataa ishee irraa gonfoo urjiiwwan kudha lamaa qabdu tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.1",
            "verseOrgIds": [
              "REV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis ulfa turte; yommuu daʼumsi ishee gaʼettis ciniinsuudhaan qabamtee iyyite.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.2",
            "verseOrgIds": [
              "REV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mallattoon biraas samii keessatti mulʼate; kunoo, bineensa jawwee fakkaatu diimaa guddaa, mataa torbaa fi gaanfa kudhan qabu, kan mataa isaa irraa gonfoo torba qabu tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.3",
            "verseOrgIds": [
              "REV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegeen isaas urjiiwwan samii irra jiran harka sadii keessaa harka tokko haxaaʼee lafatti gad darbate. Bineensi jawwee fakkaatu sunis yeroo dubartittiin deessutti mucaa ishee liqimsuuf jedhee fuula dubartii daʼuuf jirtu sanaa dura dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.4",
            "verseOrgIds": [
              "REV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen ilma bokkuu sibiilaatiin saba hundumaa bulchuuf jiru tokko deesse; daaʼimni ishees gara Waaqaatti, gara teessoo isaattis ol butame.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiinis gara lafa gammoojjii iddoo akka isheen guyyaa 1,260 achitti gabbifamtuuf jedhee Waaqni isheef qopheesseetti baqatte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lollis samii keessatti kaʼe. Miikaaʼelii",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "text": "fi ergamoonni isaa bineensa jawwee fakkaatu sana lolan; bineensi jawwee fakkaatu sunii fi ergamoonni isaas of irraa lolan.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu moʼachuu hin dandeenye; ergasiis iddoo isaanii kan samii keessaa sana ni dhaban.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensi guddaan jawwee fakkaatu sunis gad darbatame; innis bofa durii isa diiyaabiloos yookaan Seexana jedhamu, isa addunyaa guutuu karaa irraa jalʼisu sanaa dha. Inni lafatti gad darbatame; ergamoonni isaas isa wajjin darbataman.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis sagalee guddaa tokko samii keessaa nan dhagaʼe; innis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "\"Amma fayyinni, humnii fi",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "mootummaan Waaqa keenyaa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "taayitaan Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        },
        {
          "text": "isaas dhufeera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "Himataan obboloota keenyaa",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "inni halkanii guyyaa fuula Waaqaa duratti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "isaan himatu sun gad darbatameeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dhiiga Hoolichaatiin,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "dubbii dhuga baʼumsa isaaniitiinis, isa moʼatan;",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "isaan hamma duʼaatti illee taanaan",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "lubbuu isaanii hin mararfanne.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yaa samiiwwan,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "isin warri isaan keessa jiraattanis gammadaa!",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "Garuu yaa lafaa fi yaa galaana isiniif wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "Diiyaabiloos gara keessanitti gad buʼeeraatii!",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "Innis akka yeroo gabaabaa qabu",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "waan beekuuf baayʼee aareera.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensi jawwee fakkaatu sunis yommuu akka lafatti gad darbatame argetti, dubartittii daaʼima dhiiraa deesse sana ariʼachuu jalqabe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiin garuu akka gara gammoojjii iddoo isheef qopheeffametti boficha jalaa barriftuuf, achittis baraaf, barootaa fi walakkaa baraatiif akka gabbifamtuuf baalleen risaa guddaan lama isheedhaaf ni kenname.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bofichis akka dubartittiin lolaadhaan fudhatamtuuf jedhee dugda ishee duubaan bishaan akka lagaa afaan isaa keessaa dhangalaase.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti garuu afaan bantee laga bineensi jawwee fakkaatu sun afaan isaa keessaa dhangalaase sana liqimsuudhaan dubartittii gargaarte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensi jawwee fakkaatu sun dubartittiitti aaree sanyii ishee warra hafanitti lola kaasuu dhaqe; isaanis warra ajaja Waaqaa eeganii fi warra dhuga baʼumsa Yesuus jabeessanii qabatanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "REV.13",
