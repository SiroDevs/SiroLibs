  "bookId": "REV",
  "reference": "Mulʼata 18",
  "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "REV 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufaatii Baabiloniitiif Booʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis utuu ergamaan biraa samii irraa gad buʼuu nan arge. Innis taayitaa guddaa qaba ture; ulfina isaatiinis lafti ni ifte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee sagalee guddaadhaan iyye:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "\" 'Kufteerti! Baabilon guddittiin kufteerti!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "Lafa jireenya hafuurota hamoo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "lafa qubata hafuurota xuraaʼoo hundaa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "iddoo jireenya simbirroota xuraaʼoo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:2"
      },
      "items": [
        {
          "text": "iddoo jireenya bineensota xuraaʼoo fi",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "jibbisiisoo hundaa taateerti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboonni hundinuus,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "daadhii wayinii dheekkamsa sagaagala ishee dhuganiiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "Mootonni lafaas ishee wajjin sagaagalaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:3"
      },
      "items": [
        {
          "text": "daldaltoonni addunyaas qananii ishee",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "guddaa sanaan sooromaniiru.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murtii Baabilon Jalaa Miliquu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagalee biraas samii irraa nan dhagaʼe; innis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:4"
      },
      "items": [
        {
          "text": "\" 'Yaa saba ko, isin akka cubbuu ishee keessatti hin hirmaanneef,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:4"
      },
      "items": [
        {
          "text": "balaa ishee irra gaʼus akka hin qoodanneef,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:4"
      },
      "items": [
        {
          "text": "kottaa ishee keessaa baʼaa;'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "cubbuun ishee hamma samiitti ol tuulameeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.5",
            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:5"
      },
      "items": [
        {
          "text": "Waaqnis yakka ishee yaadateera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.5",
            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma isheen kennitetti isinis isheef kennaa;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:6"
      },
      "items": [
        {
          "text": "akkuma hojii isheettis dachaa lama godhaatii isheef deebisaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:6"
      },
      "items": [
        {
          "text": "Xoofoo isheen itti bulbultettis dachaa lama godhaatii isheef bulbulaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hammuma isheen ulfina ofii kennitee qananii guddaadhaan jiraatte sana,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "qixxeedhuma isaa dhiphinaa fi gadda isheef kennaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "Isheenis garaa ishee keessatti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "'Ani akka mootittii tokkootti nan taaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "ani haadha hiyyeessaa miti;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:7"
      },
      "items": [
        {
          "text": "gonkumaas hin gaddu' jettee of jajji.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dhaʼichi garaa garaa jechuunis,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:8"
      },
      "items": [
        {
          "text": "duuti, gaddii fi beelli guyyuma tokkotti ishee irra ni gaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:8"
      },
      "items": [
        {
          "text": "Waaqni Gooftaan isheetti murteessu sun waan jabaa taʼeef,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:8"
      },
      "items": [
        {
          "text": "isheen ibiddaan ni gubamti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaʼee Kufaatii Baabiloniitiif Wayyoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mootonni lafaa warri ishee wajjin sagaagalanii fi warri qananii guddaadhaan ishee wajjin jiraatan yommuu aara gubamuu ishee arganitti isheef ni booʼu; ni wawwaatus.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dhiphina ishee waan sodaataniif fagoo dhaabatanii,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:10"
      },
      "items": [
        {
          "text": "\" 'Wayyoo! Wayyoo! Yaa magaalaa guddittii,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:10"
      },
      "items": [
        {
          "text": "yaa Baabilon magaalattii jabduu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:10"
      },
      "items": [
        {
          "text": "Badiin kee saʼaatuma tokko keessatti dhufeeraatii!' jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Daldaltoonni lafaas siʼachi waan namni tokko iyyuu miʼa daldala isaanii hin binneef isheef ni booʼu; ni wawwaatus.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miʼi daldala isaaniis warqee, meetii, dhagaawwan gatii guddaatii fi lula, uffata haphii quncee talbaa irraa hojjetame, uffata dhiilgee, uffata haarriitii fi bildiimaa, muka urgaaʼaa gosa hundaa, miʼa ilka arbaa irraa hojjetame hunda, miʼa muka gatii guddaa irraa hojjetame hunda, miʼa naasii irraa hojjetame hunda, miʼa sibiilaatii fi miʼa dhagaa adii irraa hojjetame hundaa fi",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "qarafaa fi urgooftuu, ixaana, qumbii, haphee urgaaʼaa, daadhii wayiniitii fi zayitii ejersaa, daakuu bullaaʼaa fi qamadii, loowwanii fi hoolota, fardeenii fi gaariiwwan, akkasumas garbootaa fi lubbuuwwan namootaa faʼa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaanis, 'Iji waan ati hawwite sanaa si duraa badeera. Badhaadhummaa fi bareedinni kee hundinuu sirraa badeera; gonkumaas deebitee hin argattu' isheedhaan jedhu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daldaltoonni miʼa kanneen gurguratanii ishee irraa badhaadhummaa argatanis dhiphina ishee sodaatanii fagoo dhaabatu. Isaanis booʼaa, wawwaachaas,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.15",
            "verseOrgIds": [
              "REV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "sagalee guddaadhaan akkana jedhu:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "\" 'Wayyoo! Wayyoo, yaa magaalaa guddittii;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "yaa ishee uffata haphii quncee talbaa irraa hojjetame,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "uffata dhiilgee fi uffata bildiimaa uffatte,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "yaa ishee warqeedhaan,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:16"
      },
      "items": [
        {
          "text": "dhagaa gatii guddaatii fi lulaan miidhagfamte!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badhaadhummaan guddaan akkanaa saʼaatuma tokko keessatti barbadaaʼe!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 18:17"
      },
      "items": [
        {
          "text": "\"Ajajjuun doonii hundinuu, warri dooniin imala deeman hundinuu, warri doonii irra hojjetanii fi warri galaana irra hojjechuun jiraatan hundinuu fagaatanii ni dhaabatu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yommuu aara gubamuu ishee arganitti, 'Magaalaan akka magaalaa guddittii kanaa jiraattee beektii?' jedhanii iyyu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis awwaara mataatti firfirfatanii booʼaa, wawwaachaas akkana jedhanii iyyu:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "\" 'Wayyoo! Wayyoo, yaa magaalaa guddittii,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "yaa ishee warri galaana irraa dooniiwwan qaban hundinuu",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "qabeenya isheetiin sooroman!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
