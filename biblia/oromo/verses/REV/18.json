      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 18:19"
      },
      "items": [
        {
          "text": "Ishee saʼaatuma tokko keessatti barbadoofte!'",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa samii kufaatii isheetti gammadi!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
