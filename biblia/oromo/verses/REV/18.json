    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 18:20"
      },
      "items": [
        {
          "text": "Waaqni ishee irratti isiniif mureeraatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xumura Badiisa Baabilon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
