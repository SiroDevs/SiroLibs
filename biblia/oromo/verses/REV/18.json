          "text": "gonkumaas deebitee hin argamtu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
