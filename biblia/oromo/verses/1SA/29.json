  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "1SA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aakiish Daawitin Siiqlaagitti Deebisee Erge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni loltoota isaanii hunda Afeeqitti walitti qabatan; Israaʼeloonni immoo burqaa Yizriʼeel keessa jiru bira qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu bulchitoonni Filisxeem dhibba dhibbaa fi kuma kumaan qoodamanii duulanitti Daawitii fi namoonni isaa Aakiish wajjin dugda duuba deemaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjoonni loltoota Filisxeemis, \"Ibroonni kunneen maali asii hojjetu?\" jedhanii gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 29:3"
      },
      "items": [
        {
          "text": "Aakiishis deebisee, \"Kun Daawit qondaalticha Saaʼol mooticha Israaʼel sanaa mitii? Inni waggaa tokko caalaa na wajjin ture; gaafa inni Saaʼolin dhiisee jalqabee hamma ammaatti ani yakka tokko illee isa irratti hin argine\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjoonni loltoota Filisxeem garuu isatti aaranii akkana jedhan; \"Akka inni iddoo ati isa itti ramadde sanatti deebiʼuuf namicha kana deebisii ergi. Inni nu wajjin duuluu hin qabu; yoo kanaa achii inni lola keessatti nutti garagala. Inni yoo mataa namoota keenyaa kukkutuudhaan taʼe malee akkamitti gooftaa isaatti araaramuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit kun namichuma isaan,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "\" 'Saaʼol kumaatama ajjeese;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "Daawit immoo kuma kumaatama ajjeese'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1SA 29:5"
      },
      "items": [
        {
          "text": "jedhanii sirbanii shubbisaniif sana mitii?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Aakiish Daawitin waamee akkana jedheen; \"Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.29.6",
                "verseOrgIds": [
                  "1SA.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa, ati nama amanamaa turte; ani utuu ati na wajjin loltoota keessa tajaajiltee nan gammada. Gaafa ati na bira dhuftee jalqabee hamma harʼaatti ani yakka tokko illee sirratti hin argine; garuu bulchitoonni si hin fudhanne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Deebiʼii nagaan deemi; waan bulchitoota Filisxeemotaa gaddisiisu tokko illee hin hojjetin.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit, \"Garuu ani maalin godhe? Erga ani gara kee dhufee jalqabee hamma ammaatti yakki ati tajaajilaa kee irratti argite maali? Ani maaliifin dhaqee diinota gooftaa koo mootichaa waraanuu hin dandaʼu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakiish akkana jedhee deebiseef; \"Ani akka ati fuula koo duratti akkuma ergamaa Waaqayyoo namatti toltu beeka; taʼus ajajjoonni Filisxeemotaa, 'Inni nu wajjin duuluu hin qabu' jedhaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa amma kaʼiitii tajaajiltoota gooftaa keetii kanneen si wajjin dhufan wajjin ganamaan akkuma lafti ifeen deemaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Daawitii fi namoonni isaa ganama bariin kaʼanii gara biyya Filisxeemotaa dhaquuf qajeelan; Filisxeemonni immoo gara Yizriʼeelitti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.11",
            "verseOrgIds": [
              "1SA.29.11"
            ]
          }
        }
      ]
    }
  ],
