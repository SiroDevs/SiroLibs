  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1SA 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saaʼolii fi Eker Dubbiftuu Tokko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa Filisxeemonni Israaʼeloota loluuf humna isaanii walitti qabatan. Aakiishis Daawitiin, \"Akka atii fi namoonni kee na wajjin duuluu qabdan beeki\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.1",
            "verseOrgIds": [
              "1SA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis, \"Waan garbichi kee hojjechuu dandaʼu ati iyyuu yeroo sana ni argita\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:2"
      },
      "items": [
        {
          "text": "Aakiish deebisee, \"Baayʼee gaarii dha; ani bara jireenya koo guutuu waardiyyaa koo sin godhadha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.2",
            "verseOrgIds": [
              "1SA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana Saamuʼeel duʼee Israaʼeloonni hundi booʼaniifii magaalaa isaa Raamaatti isa awwaalan. Saaʼolis ilaaltotaa fi eker dubbiftoota biyyaa baasee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni wal gaʼanii Suunamin qubatan; Saaʼol immoo Israaʼeloota hunda walitti qabee Gilboʼaa keessa qubate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol yeroo qubata Filisxeemotaa argetti ni naʼe; garaan isaas sodaan raafame.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.6",
                "verseOrgIds": [
                  "1SA.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.6",
                "verseOrgIds": [
                  "1SA.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu abjuudhaan yookaan Uriimiidhaan yookaan raajotaan deebii hin kennineef.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Saaʼol tajaajiltoota isaatiin, \"Akka ani dhaqee ishee gaafadhuuf dubartii eker dubbiftuu naaf barbaadaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:7"
      },
      "items": [
        {
          "text": "Isaanis, \"Kunoo dubartiin ekeraa dubbiftu tokko Eendoor jirti\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Saaʼol wayyaa biraa uffatee bifa geeddarachuudhaan tajaajiltoota isaa lama wajjin halkaniin gara dubartii ekeraa dubbiftuu sanaa dhaqe. Innis, \"Ekeraa naaf dubbisiitii nama ani maqaa isaa sitti himu ol naaf baasi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin sun garuu, \"Ati waan Saaʼol hojjete dhugumaan beekta. Inni ilaaltotaa fi eker dubbiftoota lafa irraa fixeera. Egaa maaliif lubbuu koo kiyyoo duʼaa keessa galchita ree?\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis maqaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.10",
                "verseOrgIds": [
                  "1SA.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "isheef kakatee, \"Dhugaa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.10",
                "verseOrgIds": [
                  "1SA.28.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jiraataa, ati waan kanaaf hin adabamtu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiin sunis, \"Ani eenyun ol siif baasu ree?\" jettee gaafatte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:11"
      },
      "items": [
        {
          "text": "Innis, \"Saamuʼeelin ol naaf baasi\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin sunis yommuu Saamuʼeelin argitetti guddiftee iyyite. Saaʼoliin, \"Maaliif na gowwoomsite? Ati Saaʼolii dha!\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis, \"Hin sodaatin. Ati maal argaa jirta?\" isheen jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:13"
      },
      "items": [
        {
          "text": "Dubartiin sunis, \"Ani hafuura lafa keessaa ol baʼaa jiru tokko nan arga\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis, \"Inni maal fakkaata?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:14"
      },
      "items": [
        {
          "text": "Isheenis, \"Jaarsi wayyaa dheeraa uffate tokko ol baʼaa jira\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:14"
      },
      "items": [
        {
          "text": "Saaʼolis akka namni sun Saamuʼeel taʼe beeke; gad jedhees addaan lafatti gombifamee sagade.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saamuʼeelis Saaʼoliin, \"Ati maaliif ol na baasuudhaan na jeeqxa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:15"
      },
      "items": [
        {
          "text": "Saaʼolis akkana jedheen, \"Ani baayʼee dhiphadheera; Filisxeemonni na lolaa jiru; Waaqnis narraa garagaleera. Inni raajotaan yookaan abjuudhaan deebii naa hin kennu. Kanaafuu akka ati waan ani gochuu qabu natti himtuufan si waammadhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saamuʼeelis akkana jedhe; \"Ati erga",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.16",
                "verseOrgIds": [
                  "1SA.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "sirraa garagalee diina sitti taʼee maaliif na waamta?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.17",
                "verseOrgIds": [
                  "1SA.28.17"
                ]
              }
            }
          ]
        },
        {
          "text": "waanuma duraan dursee karaa kootiin dubbate sana fiixaan baase.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.17",
                "verseOrgIds": [
                  "1SA.28.17"
                ]
              }
            }
          ]
        },
        {
          "text": "mootummaa harka kee keessaa butee ollaa kee keessaa nama tokkoof jechuunis Daawitiif kenneera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii ati",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.18",
                "verseOrgIds": [
                  "1SA.28.18"
                ]
              }
            }
          ]
        },
        {
          "text": "hin ajajaminiif yookaan dheekkamsa isaa sodaachisaa sana Amaaleqoota irratti hin raawwatiniif",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.18",
                "verseOrgIds": [
                  "1SA.28.18"
                ]
              }
            }
          ]
        },
        {
          "text": "harʼa waan kana sitti fideera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼelii fi siʼi illee",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.19",
                "verseOrgIds": [
                  "1SA.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": "dabarsee harka Filisxeemotaatti ni kenna; atii fi ilmaan kee bori gara koo dhuftu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1SA.28.19",
                "verseOrgIds": [
                  "1SA.28.19"
                ]
              }
            }
          ]
        },
        {
          "text": "loltoota Israaʼel dabarsee Filisxeemotatti ni kenna.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol waan dubbii Saamuʼeeliin akka malee sodaateef yeruma sana hojjaa isaa guutuudhaan kufe. Inni waan halkanii fi guyyaa sana guutuu homaa hin nyaatiniif humna dhabee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartittiinis yommuu gara Saaʼol dhuftee akka inni akka malee sodaate argitetti akkana jette; \"Kunoo tajaajiltuun kee siif ajajamteerti. Ani lubbuu kootti murteessee waan ati jette godheera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas maaloo tajaajiltuu kee dhagaʼi; ani nyaata xinnoo siifan kenna; atis nyaattee jabaattee karaa kee qajeelta.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni immoo, \"Hin nyaadhu\" jedhee dide.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 28:23"
      },
      "items": [
        {
          "text": "Taʼus namoonni isaa dubartittii wajjin isa jajjabeessinaan inni isaan dhagaʼe. Lafaa kaʼees siree irra taaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin sunis dibicha gabbifame tokko manaa qabdi turte; isheenis yeroodhuma sana qalte. Daakuu xinnoo fuutee sukkuumtee buddeena raacitii hin qabne tolchite.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.24",
            "verseOrgIds": [
              "1SA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis Saaʼolii fi namoota isaatiif dhiʼeessite; isaanis ni nyaatan. Halkanuma sanas achii kaʼanii deeman.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.25",
            "verseOrgIds": [
              "1SA.28.25"
            ]
          }
        }
      ]
    }
  ],
