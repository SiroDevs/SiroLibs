  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1SA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin Saamuʼeel Israaʼel hunda bira gaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1SA 4:1"
      },
      "items": [
        {
          "text": "Filisxeemonni Taabota Boojiʼan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:1"
      },
      "items": [
        {
          "text": "Israaʼeloonni Filisxeemota waraanuudhaaf baʼan. Israaʼeloonnis Ebeenezer bira, Filisxeemonni immoo Afeeq keessa qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni Israaʼeloota waraanuudhaaf loltoota isaanii hiriirsan; akkuma waraanni hoʼeenis Israaʼeloonni Filisxeemotaan moʼatamanii namoonni kumni afur dirree waraanaa irratti ajjeefaman.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.2",
            "verseOrgIds": [
              "1SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu loltoonni Israaʼel qubatatti deebiʼanitti maanguddoonni Israaʼel, \"Harʼa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.4.3",
                "verseOrgIds": [
                  "1SA.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "maaliif fuula Filisxeemotaa duratti akka nu moʼatamnu godhe? Akka inni nu wajjin deemee harka diinota keenyaa jalaa nu baasuuf taabota kakuu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.4.3",
                "verseOrgIds": [
                  "1SA.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Shiiloodhaa haa fidnu\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu sabni sun gara Shiilootti namoota erguudhaan taabota kakuu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.4.4",
                "verseOrgIds": [
                  "1SA.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu isa kiirubeel gidduu taaʼu sanaa fidan. Ilmaan Eelii lamaan Hofniinii fi Fiinehaasis taabota kakuu Waaqaa wajjin achi turan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu taabonni kakuu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.4.5",
                "verseOrgIds": [
                  "1SA.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "gara qubataatti galetti Israaʼeloonni hundinuu iyya gammachuu guddaa isaa iyyanii lafa sochoosan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonnis yommuu iyya guddaa sana dhagaʼanitti, \"Iyyi guddaan qubata Ibrootaa keessaa dhagaʼamu kun maali?\" jedhanii gaafatan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:6"
      },
      "items": [
        {
          "text": "Yommuu akka taabonni kakuu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1SA.4.6",
                "verseOrgIds": [
                  "1SA.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "achi gale hubatanittis,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni sodaatanii akkana jedhan; \"Waaqni tokko gara qubata Ibrootaa dhufeera; nuuf wayyoo! Wanni akkasii taʼee hin beeku.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.7",
            "verseOrgIds": [
              "1SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuuf wayyoo! Eenyutu waaqota jajjaboo kanneen harkaa nu baasa? Isaan waaqota gammoojjii keessatti dhaʼicha garaa garaatiin warra Gibxi dhaʼanii dha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.8",
            "verseOrgIds": [
              "1SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Filisxeemotaa jabaadhaa! Dhiirummaa keessanis argisiisaa. Yoo kanaa achii akkuma isin jara garboomfattan sana Ibroonni garba isin godhatu. Dhiirummaa keessan argisiisaatii lolaa!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Filisxeemonni ni lolan; Israaʼeloonnis moʼatamanii tokkoon tokkoon namaa gara dunkaana ofii isaatti baqate. Nama baayʼeetu dhume; Israaʼelis loltoota lafoo kuma soddoma dhabde.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.10",
            "verseOrgIds": [
              "1SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabonni Waaqaa ni boojiʼame; ilmaan Eelii lamaanuu Hofniinii fi Fiinehaas ni duʼan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eeliin Duʼuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafuma sana namichi Beniyaam tokko wayyaa isaa tarsaasee, mataa isaatti daaraa firfirsee fiigaa gara Shiiloo dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeliinis yeroo namichi achi gaʼetti sababii waaʼee taabota Waaqaatiif garaan isaa raafameef waa dhagaʼuuf jedhee karaa cina barcuma irra taaʼee eegaa ture. Yeroo namichi sun magaalaa seenee waan taʼe hundumaa odeessetti warri magaalaa sanaa hundi ni iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeliinis yommuu iyya sana dhagaʼetti, \"Kun iyya maaliitii?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:14"
      },
      "items": [
        {
          "text": "Namichi sunis dafee dhufee Eeliitti hime;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo kana Eeliin nama waggaa sagaltamii saddeet waan tureef iji isaa arguu dadhabee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichis, \"Ani ammuma adda waraanaatii dhufuu koo ti; waraana keessaa miliqee baʼuun koos harʼuma\" jedhee Eeliitti hime.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:16"
      },
      "items": [
        {
          "text": "Eeliinis, \"Yaa ilma ko, maaltu taʼe ree?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi oduu fide sun deebisee, \"Israaʼeloonni Filisxeemota duraa baqatan; loltoota irras dhumiisa guddaatu gaʼe; ilmaan kee lamaanis Hofniinii fi Fiinehaas ajjeefamaniiru; taabonni Waaqaas boojiʼameera\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni waaʼee taabota Waaqaa dubbatettis, Eeliin barcuma isaa kan balbala cina ture sana irraa dugda duubatti kufe. Nama dulloomaa dhagni isaa ulfaatu waan tureefis mormi isaa cabee duʼe. Innis waggaa afurtamaaf bulchaa Israaʼel ture.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin ilma isaa Fiinehaas ulfa daʼa geesse turte. Isheenis yommuu akka taabonni Waaqaa boojiʼamee fi akka abbaan dhirsa isheetii fi dhirsi ishee duʼan dhageessetti ciniinsuun itti hammaatee jilbeenfattee deesse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo isheen duʼuu geessettis dubartoonni ishee gargaaraa turan, \"Dhiira deesseertaa jabaadhu\" jedhaniin. Isheen garuu homaa hin deebifne yookaan yaadatti hin qabanne.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
            "verseOrgIds": [
              "1SA.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii taabonni Waaqaa boojiʼamee fi sababii abbaan dhirsa isheetii fi dhirsi ishee duʼaniif, \"Ulfinni Israaʼel irraa fagaateera\" jechuudhaan maqaa mucaa ishee Iikaabood jettee moggaafte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
