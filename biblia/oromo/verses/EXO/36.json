    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezaliʼeel, Oholiiyaabii fi namni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.1",
                "verseOrgIds": [
                  "EXO.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ogummaa fi dandeettii isaan ittiin hojii ijaarsa iddoo qulqulluu sanaa hunda beekan kenneef hundi akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.1",
                "verseOrgIds": [
                  "EXO.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ajajetti hojii kana haa hojjetan.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen Bezaliʼeel, Oholiiyaabii fi ogeessa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.2",
                "verseOrgIds": [
                  "EXO.36.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dandeettii kenneef kan dhufee hojii sana hojjechuuf fedhii qabu hunda waame.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis kennaawwan Israaʼeloonni ijaarsa iddoo qulqulluu sanaatiif jedhanii fidan hunda Musee harkaa fuudhan. Namoonni Israaʼelis fedhii isaaniitiin ganama ganama kennaa isaanii fiduu itti fufan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.3",
            "verseOrgIds": [
              "EXO.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeeyyiin hojii harkaa kanneen iddoo qulqulluu sana hojjetan hundi hojii isaanii dhiisanii dhufanii",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.4",
            "verseOrgIds": [
              "EXO.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museedhaan, \"Sabni kun waan hojii",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.36.5",
                "verseOrgIds": [
                  "EXO.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akka hojjetamuuf ajaje sanaaf barbaachisu caalaa fidaa jira\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis ajaja kenne; isaanis, \"Dhiirri yookaan dubartiin tokko iyyuu waan biraa tokko illee kennaa godhee iddoo qulqulluu sanaaf hin dhiʼeessin\" jedhanii iddoo qubataa sana keessatti labsan. Kanaafuu namoonni itti fufanii waa fiduu dhowwaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.6",
            "verseOrgIds": [
              "EXO.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanti isaan duraanuu qaban hojii hunda hojjechuuf gaʼaa fi irraa hafaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dunkaana Qulqulluu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "EXO.36.8-EXO.36.38"
          },
          "items": [
            {
              "text": "36:8‑38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "EXO.26.1-EXO.26.37"
              },
              "items": [
                {
                  "text": "Bau 26:1‑37",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojjettoota sana keessaas ogeeyyiin hundi golgaawwan kudhan kanneen quncee talbaa gaarii foʼamee fi kan kirrii bifa cuquliisaa, dhiilgee fi bildiimaa irraa hojjetamaniin dunkaana qulqulluu haa hojjetan; golgaawwan sana irrattis ogeeyyiin harka qajeelan kiirubeelii hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.8",
            "verseOrgIds": [
              "EXO.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golgaawwan sun hundinuu wal qixxee taʼanii tokkoon tokkoon isaanii dheerina dhundhuma digdamii saddeetiitii fi balʼina dhundhuma afur qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis golgaawwan shan walitti qabsiisan; shanan kaan illee akkasuma walitti qabsiisan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.10",
            "verseOrgIds": [
              "EXO.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis golgaawwan walitti qabsiifaman kanneen jalqabaa keessaa handaara isa moggaa irratti huccuu bifa cuquliisaa irraa gurroowwan tolchan; golgaawwan walitti qabsiifaman lammaffaa irrattis akkasuma tolfaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.11",
            "verseOrgIds": [
              "EXO.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis golgaa tokko irratti gurroowwan shantama tolchan; gurroowwan shantama immoo golgaawwan walitti qabsiifaman lammaffaa keessaa isa moggaa irratti tolchan; gurroowwan sunis gamaa gamanaan turan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.12",
            "verseOrgIds": [
              "EXO.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka dunkaanni qulqulluun sun tokko taʼuufis hokkoowwan warqee shantama tolchanii golgaawwan sana ittiin walitti qabsiisan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis haguuggii gubbaa dunkaana qulqulluu sanaa irra jiru haguuguuf golgaawwan rifeensa reʼee kudha tokko hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.14",
            "verseOrgIds": [
              "EXO.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golgaawwan kudha tokkoon sun hundi wal qixxee turan; dheerinni isaanii dhundhuma soddoma, balʼinni isaanii immoo dhundhuma afur ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis golgaawwan shan iddoo tokkotti walitti qabsiisan; golgaawwan kaan jaʼaan immoo iddoo tokkotti walitti qabsiisan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.16",
            "verseOrgIds": [
              "EXO.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis golgaawwan gama tokkoon walitti qabsiifaman keessaa handaara isa moggaa irratti gurroowwan shantama tolchan; golgaawwan gama kaan irratti walitti qabsiifaman keessaas handaara isa moggaa irratti gurroowwan shantama tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.17",
            "verseOrgIds": [
              "EXO.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka dunkaanni sun tokko taʼuuf ittiin walitti qabsiisuuf qabduuwwan naasii shantama tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.18",
            "verseOrgIds": [
              "EXO.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunkaana sanaafis irra buusaa kaldhee korbeessa hoolaa kan halluu diimaa cuuphame, isa irraan immoo irra buusaa gogaa duugamee hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunkaana qulqulluu sanaafis muka laaftoo irraa tuggeewwan qaqqajeeloo hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.20",
            "verseOrgIds": [
              "EXO.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dheerinni tokkoo tokkoo tuggeewwan sanaas dhundhuma kudhan, balʼinni isaa immoo dhundhuma tokkoo fi walakkaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon tuggeewwan sanaas akka wal keessa galuu dandaʼuuf mucha lama lama qaba ture. Tuggeewwan dunkaana qulqulluu sanaa hunda akkasitti tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.22",
            "verseOrgIds": [
              "EXO.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama kibba dunkaana qulqulluu sanaatiifis tuggeewwan digdama hojjetan;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.23",
            "verseOrgIds": [
              "EXO.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuggeewwan digdamman sana jalatti miilla meetii afurtama jechuunis tuggee tokko jalatti miilla lama gurra isaa lamaaniif, tuggee kaan jalattis miilla lama gurra isaa lamaaniif tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.24",
            "verseOrgIds": [
              "EXO.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama dunkaana qulqulluu sanaa kaaniifis karaa kaabaatiin tuggeewwan digdama tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.25",
            "verseOrgIds": [
              "EXO.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaniifis miilla meetiis afurtama jechuunis tuggee tokko jalatti miilla lama, tuggee kaan jalattis miilla lama tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.26",
            "verseOrgIds": [
              "EXO.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa lixa biiftuutiin, dugda duuba dunkaana qulqulluu sanaatiif tuggee jaʼa hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.27",
            "verseOrgIds": [
              "EXO.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaa dugda duubaas golee dunkaana qulqulluu sanaatiif utubaa lama tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.28",
            "verseOrgIds": [
              "EXO.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuggeewwan golee kunneen jalaa hamma gubbaatti walitti fayyifamanii bantii irratti qubeelaa tokkoon walitti qabsiifaman; tuggeewwan golee lamaaniis akkanuma hojjetan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.29",
            "verseOrgIds": [
              "EXO.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu tuggeewwan saddeeti kanneen miilla meetii kudha jaʼa qabanitu ture; tokkoon tokkoon tuggee sanaas miilla lama lama qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.30",
            "verseOrgIds": [
              "EXO.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas muka laaftoo irraa dagaleewwan tolchan; tuggeewwan dunkaana qulqulluu sana irra gama tokkoon jiraniif dagaleewwan shan,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuggeewwan gama kaaniin jiraniif shan, tuggeewwan dugda duubaan karaa lixa biiftuutiin jiraniif immoo dagaleewwan shan tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dagalee walakkaa jiru sana akka inni gidduu tuggeewwaniitiin moggaa tokkoo hamma moggaa kaaniitti fullaʼu godhan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuggeewwan sanaattis warqee dibanii akka dagaleewwan baataniif qubeelaawwan warqee itti tolchan. Dagaleewwan sanaattis akkasuma warqee uffisan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis kirrii bifa cuquliisaa, dhiilgee, bildiimaa fi quncee talbaa haphii irraa golgaa tolchan; golgaa kana irrattis ogeessi harka qajeelu tokko fakkii kiirubeelii tolche.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golgaa sanaafis utubaawwan muka laaftoo afur tolchanii warqee itti uffisan; utubaa sanaafis hokkoowwan warqee hojjetanii miilla meetii afur itti tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis balbala dunkaanichaatiif golgaa kirrii bifa cuquliisaa, dhiilgee, bildiimaa fi quncee talbaa kan qalʼifamee foʼamee harkaan irratti hodhame tokko faayessanii tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis utuboota hokkoo qaban shan hojjetanii, fiixee fi somaawwan utubootaatti warqee uffisan; miilla isaanii shananis naasii irraa tolchan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
        }
      ]
    }
  ],
