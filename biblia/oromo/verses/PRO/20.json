        {
          "text": "uume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka hin hiyyoomneef, hirriba hin jaallatin;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:13"
      },
      "items": [
        {
          "text": "midhaan akka quuftuuf, dammaqii jiraadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni waa bitatu, \"Wanni kun gaarii miti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "wanni kun gaarii miti!\" jedha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:14"
      },
      "items": [
        {
          "text": "ergasii immoo dhaqee waaʼee waan bitate sanaa boona.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warqeen ni jira; lulli diimaanis baayʼinaan jira;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:15"
      },
      "items": [
        {
          "text": "arrabni beekumsa dubbatu garuu faaya gatii guddaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
