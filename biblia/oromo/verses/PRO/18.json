      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:11"
      },
      "items": [
        {
          "text": "isaanis akka dallaa ol dheeraatti hedu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
