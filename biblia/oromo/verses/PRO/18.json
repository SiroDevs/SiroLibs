      "attrs": {
        "style": "q2",
        "vid": "PRO 18:14"
      },
      "items": [
        {
          "text": "hafuura cabe garuu eenyutu obsuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
