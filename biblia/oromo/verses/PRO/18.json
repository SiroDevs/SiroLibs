      "attrs": {
        "style": "q2",
        "vid": "PRO 18:16"
      },
      "items": [
        {
          "text": "fuula namoota gurguddaa durattis isa dhiʼeessa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
