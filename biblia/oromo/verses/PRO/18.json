      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:15"
      },
      "items": [
        {
          "text": "gurri ogeessaas waan kana barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
