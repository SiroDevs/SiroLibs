      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:9"
      },
      "items": [
        {
          "text": "ofii isaatii ni eebbifama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
