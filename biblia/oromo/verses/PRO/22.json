      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:10"
      },
      "items": [
        {
          "text": "wal diddaa fi arrabsoonis hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
