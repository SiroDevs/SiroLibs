            "sid": "PRO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hubataan balaa argee jalaa dhokata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:3"
      },
      "items": [
        {
          "text": "wallaalaan immoo ittuma deemee adabama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gad of qabiisnii fi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.4",
                "verseOrgIds": [
                  "PRO.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuun,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:4"
      },
      "items": [
        {
          "text": "qabeenya, ulfinaa fi jireenya namaa kennu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
