          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hammina facaasu rakkina haammata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:8"
      },
      "items": [
        {
          "text": "uleen aarii isaas ni hurraaʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
