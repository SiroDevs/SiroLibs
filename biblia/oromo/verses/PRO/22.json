          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoostuu of biraa ariʼi; lolli ni qabbanaaʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
