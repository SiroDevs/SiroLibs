    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mataa Jabaachuu Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa mana Yaaqoob,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "isin warri maqaa Israaʼeliin waamamtan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "kanneen sanyii Yihuudaa irraa argamtan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "isin warri maqaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiin",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.1",
                "verseOrgIds": [
                  "ISA.48.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kakattanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "garuu dhugaadhaan yookaan qajeelummaadhaan utuu hin taʼin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "maqaa Waaqa Israaʼel dhooftan waan kana dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "isin warri maqaa magaalaa qulqullittiitiin of waamtan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "kanneen Waaqa Israaʼelitti irkattan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "waan kana dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "maqaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.2",
                "verseOrgIds": [
                  "ISA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuu dha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani wantoota durii duraan dursee dubbadheera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "isaan afaan kootii baʼan; 1 anis akka isaan beekaman nan godhe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "anis akkuma tasaa hojjedhe; isaanis ni raawwataman.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka ati mata jabeessa taate beekeen tureetii;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "ribuun morma keetii sibiila ture;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "addi kee naasii ture.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani wantoota kanneen bara dheeraan dura sitti himeera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "ani akka ati, 'waaqota koo tolfamootu isaan hojjete;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "fakkii koo kan muka irraa hojjetamee fi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "waaqa sibiila irraa hojjetametu murteesse'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "jechuu hin dandeenyeef",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "utuu isaan hin uumaminiin dura sitti himeera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati wantoota kanneen dhageesseerta; isaan hunda ilaali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "Ati isaan amantee hin fudhattuu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "\"Ani ammaa jalqabee waan haaraa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "waan dhokfamee jiru kan ati hin beekin sitti nan hima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan amma uumaman malee bara dheeraan dura miti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "ati harʼaan dura waaʼee isaanii hin dhageenye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "Kanaafuu ati,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "'Kunoo ani waaʼee isaanii beekeen ture'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "jechuu hin dandeessu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati takkumaa dhageessee yookaan hubattee hin beektu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "gurri kee durumaa jalqabee hin banamne.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "Ani akka ati micciiramaa taate beeka;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "ati dhaloota keetii jalqabdee fincilaa jedhamtee waamamte.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani maqaa kootiif jedhee dheekkamsa koo nan tursiisa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "ani akka si hin balleessineef galata kootiif jedhee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "dheekkamsa koo duubatti harkisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, ani yoo akka meetiitti taʼuu baate iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "si qulqulleesseera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.10",
            "verseOrgIds": [
              "ISA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
