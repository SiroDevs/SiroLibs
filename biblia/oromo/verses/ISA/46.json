        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waaqota Baabilon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beel gad jedha; Neboo akka malee gugguufa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "waaqonni isaanii tolfamoon kotte duudaa fi horiitti feʼamaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "fakkiiwwan isaan qabatanii jooran baʼaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "horii dadhabeef baʼaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan gugguufanii walii wajjin gad jedhu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "baʼaa sana oolchuu hin dandaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "isaan iyyuu ni boojiʼamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa mana Yaaqoob,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "isin hambaan mana Israaʼel hundi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "warri ani gaafa isin gadameessa keessatti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "uumamtanii jalqabee ol isin qabee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "gaafa dhalattanii jalqabees isin baadhe hundi dhaggeeffadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma dulloomtanii arrii baaftanitti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "ani isa; isuma isin jiraachisuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "Ani isin uumeera; isinan baadhas;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "ani isinan jiraachisa; isinan baraaras.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin eenyuun wal bira na qabdu yookaan eenyuun wal na qixxeessitu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:5"
      },
      "items": [
        {
          "text": "Akka wal madaalluufis eenyutti na fakkeessitu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni tokko tokko korojoo isaanii keessaa warqee gad naqanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "madaalliidhaan meetii madaalu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "Waaqa tolfamaa tolchuuf jedhanii tumtuu warqee qacaru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "isaanis gad jedhanii sagaduuf.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ol fuudhanii gatiittii isaaniitti ni baatu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "iddoo isaatti ni deebisu; innis achi dhaabata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Inni iddoo sanaa sochoʼuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Yoo namni gara isaatti iyye iyyuu, inni deebii hin kennu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "inni rakkoo isaa keessaa isa baasuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa finciltoota, waan kana yaadadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:8"
      },
      "items": [
        {
          "text": "qalbiittis qabadhaa; garaa keessan keessas kaaʼadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoota darban kanneen bara durii yaadadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "ani Waaqa; kan biraa hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "ani Waaqa; kan akka koo hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dhuma waan tokkoo jalqabumatti nan labsa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "waan amma iyyuu dhufuuf jiru, ani durumaa jalqabee dubbadheera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Ani, 'Kaayoon koo cimee jiraata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "waan na gammachiisu hundas nan hojjedha' nan jedha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baʼa biiftuutii allaattii waa adamsitu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "lafa fagootii immoo nama kaayyoo koo fiixaan baasu nan waama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "Ani waanan dubbadhe nan guuta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "waanan karoorfadhes nan raawwadha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
