      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "kan fayyina labsanii, kan Xiyooniin,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "\"Waaqni kee moʼeera!\" jedhanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "tulluuwwan irratti akkam miidhagaa dha!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaggeeffadhu! Eegdonni kee sagalee isaanii ol fudhataniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "isaan tokkummaadhaan gammachuudhaan iyyu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "Yeroo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.52.8",
                "verseOrgIds": [
                  "ISA.52.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Xiyoonitti deebiʼutti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:8"
      },
      "items": [
        {
          "text": "isaan ijuma isaaniitiin ni argu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
