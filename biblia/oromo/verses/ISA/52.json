          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa diigamtoota Yerusaalem",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:9"
      },
      "items": [
        {
          "text": "tokkummaadhaan faarfannaa gammachuu faarfadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        }
      ]
    },
