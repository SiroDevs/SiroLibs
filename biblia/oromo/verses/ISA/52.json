      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "kan nagaa labsanii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 52:7"
      },
      "items": [
        {
          "text": "kan oduu gammachiisaa fidanii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        }
      ]
