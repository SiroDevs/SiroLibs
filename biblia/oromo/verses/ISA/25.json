      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:6"
      },
      "items": [
        {
          "text": "foon coomaa fi daadhii wayinii filatamaa ni qopheessa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        }
      ]
