      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 25:1"
      },
      "items": [
        {
          "text": "waan ati amanamummaa kee kan mudaa hin qabneen",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.1",
            "verseOrgIds": [
              "ISA.25.1"
            ]
          }
        }
