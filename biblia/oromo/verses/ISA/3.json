              "attrs": {
                "verseId": "ISA.3.1",
                "verseOrgIds": [
                  "ISA.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "Yerusaalemii fi Yihuudaa irraa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "kennaa fi gargaarsa isaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:1"
      },
      "items": [
        {
          "text": "kan midhaaniitii fi kan bishaanii hunda irraa fudhata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.1",
            "verseOrgIds": [
              "ISA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
