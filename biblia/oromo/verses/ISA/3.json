            "number": "2",
            "style": "v",
            "sid": "ISA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gootaa fi loltuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "abbaa murtiitii fi raajii,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:2"
      },
      "items": [
        {
          "text": "hooda himaa fi maanguddoo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.2",
            "verseOrgIds": [
              "ISA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ajajaa shantamaatii fi nama ulfina qabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:3"
      },
      "items": [
        {
          "text": "gorsituu, ogeessa hojii harkaatii fi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "ogeessa waa dawweessuu beeku irraa fudhata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.3",
            "verseOrgIds": [
              "ISA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani dargaggoota qondaaltota isaanii nan godha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:4"
      },
      "items": [
        {
          "text": "ijoolleen isaan bulchu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.4",
            "verseOrgIds": [
              "ISA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni wal hacuucu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "namni tokko nama kaanitti, ollaanis, ollaa isaatti kaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "Dargaggeessi jaarsatti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:5"
      },
      "items": [
        {
          "text": "tuffatamaanis kabajamaatti kaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.5",
            "verseOrgIds": [
              "ISA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko mana abbaa isaatti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "obboloota isaa keessaa tokko qabee,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "\"Ati qoloo qabda; kanaafuu bulchaa nuuf taʼi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:6"
      },
      "items": [
        {
          "text": "tuullaa waan diigamee kanattis itti gaafatama fudhu!\" jedha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.6",
            "verseOrgIds": [
              "ISA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu gaafas,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "\"Ani furmaata taʼuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "Ani nyaata yookaan uffata tokko illee mana kootii hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:7"
      },
      "items": [
        {
          "text": "bulchaa sabaa na hin taasisinaa\" jedhee iyya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.7",
            "verseOrgIds": [
              "ISA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerusaalem gatantaraa jirti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "Yihuudaan immoo kufteerti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "dubbii isaaniitii fi gochi isaanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.3.8",
                "verseOrgIds": [
                  "ISA.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mormuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:8"
      },
      "items": [
        {
          "text": "ulfina argamuu isaa xureessa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.8",
            "verseOrgIds": [
              "ISA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haalli fuula isaanii dhugaa isaanitti baʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "isaan akkuma Sodoom cubbuu isaanii ifa baasu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "isaan cubbuu isaanii hin dhokfatan.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "Isaaniif wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:9"
      },
      "items": [
        {
          "text": "Isaan balaa guddaa ofitti fidaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.9",
            "verseOrgIds": [
              "ISA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka wanni kun isaaniif tolu qajeeltotatti himaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:10"
      },
      "items": [
        {
          "text": "isaan buʼaa hojii isaanii nyaatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.10",
            "verseOrgIds": [
              "ISA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamaadhaaf wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "Badiisni isatti ni dhufa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 3:11"
      },
      "items": [
        {
          "text": "Inni gatii harka isaa ni argata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.11",
            "verseOrgIds": [
              "ISA.3.11"
            ]
