      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "\"Ani warra duraan walitti qabaman biratti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
