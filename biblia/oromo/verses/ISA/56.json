            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "\"Kottaa daadhii wayinii dhugnaa!",
