    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni yeroo kanatti Israaʼelitti waraana kaasan; Israaʼeloonnis isaan duraa baqatan; hedduun isaaniis Tulluu Gilboʼaa irratti dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonni ittuma jabeessanii Saaʼolii fi ilmaan isaa ariʼan; isaanis ilmaan isaa jechuunis Yoonaataan, Abiinaadaabii fi Malkii-Shuwaa ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lollis naannoo Saaʼolitti baayʼee cime; warri xiyyaan lolanis isa qaqqabanii isa madeessan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼolis namicha miʼa lolaa isaa baatuun, \"Goraadee kee luqqifadhuutii na waraani; yoo kanaa achii namoonni dhagna hin qabamin kunneen dhufanii natti taphatuu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 10:4"
      },
      "items": [
        {
          "text": "Namichi miʼa lolaa baatuuf sun garuu waan akka malee sodaateef isa hin waraanne; kanaafuu Saaʼol goraadee ofii isaa luqqifatee irratti kufe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi miʼa lolaa baatu sun yommuu akka Saaʼol duʼe argetti innis goraadee ofii isaa irratti kufee duʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Saaʼolii fi ilmaan isaa sadan ni duʼan; warri mana isaa hundinuus walumaan dhuman.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni sulula keessa turan hundi yommuu akka loltoonni baqatan, akka Saaʼolii fi ilmaan isaas dhuman arganitti magaalaawwan isaanii dhiisanii baqatan. Filisxeemonni immoo dhufanii keessa qubatan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filisxeemonnis guyyaa itti aanutti yommuu warra dhuman irraa hidhannaa hiikkachuu dhufanitti akka Saaʼolii fi ilmaan isaa Tulluu Gilboʼaa irratti kukkufanii jiran argan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis erga hidhata Saaʼolii hiikkatanii mataa isaan irraa kutanii booddee akka isaan waaqota tolfamoo fi namoota isaaniitti oduu gaarii labsaniif guutummaa Filisxeemiitti ergamoota ni ergan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo miʼa lolaa isaa mana waaqota tolfamoo isaanii keessa, mataa isaa immoo mana Daagon waaqicha tolfamaa sanaa keessatti ni fannisan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiraattonni Yaabeesh Giliʼaad hundi yommuu waan Filisxeemonni Saaʼolin godhan dhagaʼanitti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "namoonni jajjaboon isaanii hundi dhaqanii reeffa Saaʼolii fi reeffa ilmaan isaa guuranii gara Yaabeeshitti ni fidan. Ergasii immoo reeffa isaanii muka guddaa Yaabeesh keessaa tokko jalatti awwaalan; guyyaa torbas ni sooman.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaʼol sababii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.13",
                "verseOrgIds": [
                  "1CH.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "amanamaa hin taʼiniif duʼe; inni dubbii",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiif",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.13",
                "verseOrgIds": [
                  "1CH.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "hin ajajamne; qooda kanaa ilaaltuu gorsa gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.14",
                "verseOrgIds": [
                  "1CH.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gorsa hin gaafanne. Kanaaf",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.10.14",
                "verseOrgIds": [
                  "1CH.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajjeese; mootummaa isaas dabarsee Daawit ilma Isseeyiitiif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    }
  ],
