          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sana booddee",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.27",
                "verseOrgIds": [
                  "1CH.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ergamaa isaa sanatti dubbate; innis goraadee isaa manʼee isaatti ni deebise.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit yeroo sanatti akka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.28",
                "verseOrgIds": [
                  "1CH.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "oobdii Ornaa namicha gosa Yebuus sanaa irratti deebii isaa kenne ni hubate; achittis aarsaa ni dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dunkaanni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.29",
                "verseOrgIds": [
                  "1CH.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Museen gammoojjiitti hojjetee fi iddoon aarsaa gubamuu Gibeʼoon keessa gaara sagadaa irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit garuu sababii goraadee ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.21.30",
                "verseOrgIds": [
                  "1CH.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaateef achi dhaqee fuula iddoo aarsaa sanaa duratti Waaqa kadhachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.30",
            "verseOrgIds": [
              "1CH.21.30"
            ]
          }
        }
