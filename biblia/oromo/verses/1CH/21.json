        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Loltoota Isaa Lakkaaʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
