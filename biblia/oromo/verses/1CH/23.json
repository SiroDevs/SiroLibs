          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kunneen ilmaan Lewwii kanneen akkuma mana abbootii isaaniitti hangafoonni abbootii warri maqaa maqaadhaan galmeeffamanii tokko tokkoon lakkaaʼaman, hojjettoota umuriin isaanii waggaa digdamaa fi sanaa ol taʼe warra mana qulqullummaa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "keessa tajaajilanii dha.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit akkana jedhee tureetii; \"",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel saba isaatiif boqonnaa kenneera; bara baraanis Yerusaalem keessa ni jiraata;",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "siʼachi Lewwonni dunkaana yookaan miʼoota achi keessatti itti fayyadaman hin baatan.\"",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma qajeelcha Daawit dhuma irratti kenneetti, Lewwonni waggaa digdamaa fi sanaa olii hedamaniiruutii.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
