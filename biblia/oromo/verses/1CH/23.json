          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwonni akkasiin itti gaafatama dunkaana wal gaʼii fi Iddoo Qulqulluu eeguuf qaban raawwatan; akkasumas ajaja obboloota isaanii sanyiiwwan Aroon jalatti itti gaafatamummaa mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.23.32",
                "verseOrgIds": [
                  "1CH.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti qaban raawwachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
