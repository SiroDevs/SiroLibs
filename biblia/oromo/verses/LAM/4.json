      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "gara jabeessa taʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
