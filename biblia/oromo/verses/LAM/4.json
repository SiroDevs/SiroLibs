    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "harma isaanii ni kennu;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:3"
      },
      "items": [
        {
          "text": "sabni koo garuu akkuma guchii gammoojjii",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.3",
            "verseOrgIds": [
              "LAM.4.3"
            ]
          }
        }
      ]
    },
