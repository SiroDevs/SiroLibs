      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "warqee qulqulluutti ilaalamaa turan sun",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "amma akkamitti akka okkotee supheetti,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "akka hojii suphee dhooftuutti ilaalamu!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
          }
        }
      ]
