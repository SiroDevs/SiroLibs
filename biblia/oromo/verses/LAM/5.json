          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu ijoollee abbaa hin qabne taane;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:3"
      },
      "items": [
        {
          "text": "haadhonni keenya immoo",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "haadhota hiyyeessaa taʼaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.3",
            "verseOrgIds": [
              "LAM.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LAM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu bishaan dhugnuuf kaffaluu qabna turre;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:4"
      },
      "items": [
        {
          "text": "qoraan illee bittaa qofaan arganna.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.4",
            "verseOrgIds": [
              "LAM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LAM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri nu ariʼan koomee keenya bira jiru;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:5"
      },
      "items": [
        {
          "text": "nu dadhabneerra; boqonnaas hin qabnu.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.5",
            "verseOrgIds": [
              "LAM.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
