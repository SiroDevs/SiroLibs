      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:8"
      },
      "items": [
        {
          "text": "namni harka isaaniitii bilisa nu baasu tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
