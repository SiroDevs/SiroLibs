          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanguddoonni karra magaalaa duraa deemaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
