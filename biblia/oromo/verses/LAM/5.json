      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:14"
      },
      "items": [
        {
          "text": "dargaggoonnis weedduu isaanii dhiisaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.14",
            "verseOrgIds": [
              "LAM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LAM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gammachuun garaa keenya keessaa badeera;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:15"
      },
      "items": [
        {
          "text": "shuubbisuun keenyas booʼichatti geeddarameera.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.15",
            "verseOrgIds": [
              "LAM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LAM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gonfoon mataa keenya irraa buʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:16"
      },
      "items": [
        {
          "text": "Nuuf wayyoo; nu cubbuu hojjenneerraatii!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.16",
            "verseOrgIds": [
              "LAM.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
