          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LAM.5.1",
                "verseOrgIds": [
                  "LAM.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", waan nurra gaʼe yaadadhu;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.1",
            "verseOrgIds": [
              "LAM.5.1"
            ]
          }
        }
