          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handhuuraan keenya alagootaaf,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:2"
      },
      "items": [
        {
          "text": "manneen keenyas Namoota Ormaatiif",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "dabarfamanii kennamaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.2",
            "verseOrgIds": [
              "LAM.5.2"
            ]
          }
        }
      ]
    },
    {
