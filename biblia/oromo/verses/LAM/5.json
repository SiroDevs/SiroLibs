          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garbootatu nu bulcha;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.8",
            "verseOrgIds": [
              "LAM.5.8"
            ]
          }
        }
