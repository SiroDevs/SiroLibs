      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:10"
      },
      "items": [
        {
          "text": "akkuma badaa ibiddaa hoʼa.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.10",
            "verseOrgIds": [
              "LAM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
