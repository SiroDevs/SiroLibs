      "attrs": {
        "style": "q2",
        "vid": "LAM 5:13"
      },
      "items": [
        {
          "text": "ijoolleen dhiiraa muka baachuun gatantaran.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.13",
            "verseOrgIds": [
              "LAM.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
