        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:12"
      },
      "items": [
        {
          "text": "maanguddoonni ulfina hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.12",
            "verseOrgIds": [
              "LAM.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
