      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 5:9"
      },
      "items": [
        {
          "text": "lubbuu keenya balaaf saaxillee buddeena arganna.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.5.9",
            "verseOrgIds": [
              "LAM.5.9"
            ]
          }
