            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et le premier sort échut, pour Asaph, à Joseph ; à Guedalia, le second ; lui et ses frères et ses fils étaient douze.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
