          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et comme l'arche de l'alliance de l'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        },
