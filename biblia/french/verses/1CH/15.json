                "verseOrgIds": [
                  "1CH.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "aida les Lévites qui portaient l'arche de l'alliance de l'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.26",
                "verseOrgIds": [
                  "1CH.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", ils sacrifièrent sept veaux et sept béliers.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et David était vêtu d'une robe de byssus, ainsi que tous les Lévites qui portaient l'arche, et les chantres, et Kenania, le chef de la musique",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "text": "des chantres ; et David avait sur lui un éphod de lin.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et tout Israël faisait monter l'arche de l'alliance de l'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.28",
                "verseOrgIds": [
                  "1CH.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "avec des cris de joie, et au son du cor, et avec des trompettes et des cymbales, et en faisant retentir des luths et des harpes.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
