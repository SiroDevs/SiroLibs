              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Saül eut encore plus peur de David, et Saül fut ennemi de David tous ses jours.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        },
