                "verseOrgIds": [
                  "EXO.10.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dit à Moïse : Étends ta main vers les cieux, et il y aura sur le pays d'Égypte des ténèbres, et on touchera de la main les ténèbres.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
