              "attrs": {
                "verseId": "EXO.10.25",
                "verseOrgIds": [
                  "EXO.10.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", notre",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
