          "text": "endurcit le cœur du Pharaon, et il ne voulut pas les laisser aller.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
