                "verseOrgIds": [
                  "EXO.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "endurcit le cœur du Pharaon, et il ne laissa point aller les fils d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        }
