                "verseId": "EXO.10.18",
                "verseOrgIds": [
                  "EXO.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.18",
            "verseOrgIds": [
              "EXO.10.18"
            ]
          }
        },
