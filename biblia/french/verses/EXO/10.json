              "type": "text",
              "attrs": {
                "verseId": "EXO.10.26",
                "verseOrgIds": [
                  "EXO.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", notre",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
