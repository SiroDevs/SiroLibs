          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse dit : Comme tu l'as dit, je ne reverrai plus ta face !",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
