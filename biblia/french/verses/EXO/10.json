          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.26",
                "verseOrgIds": [
                  "EXO.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", jusqu'à ce que nous soyons parvenus là.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
