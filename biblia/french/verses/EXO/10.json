          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Moïse dit : Tu nous donneras aussi dans nos mains des sacrifices et des holocaustes, et nous [les] offrirons à l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
