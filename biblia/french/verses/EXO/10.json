          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nos troupeaux aussi iront avec nous ; il n'en restera pas un ongle, car nous en prendrons pour servir l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
