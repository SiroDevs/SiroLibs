              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et le Pharaon appela Moïse, et dit : Allez, servez l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.24",
                "verseOrgIds": [
                  "EXO.10.24"
                ]
              }
            }
          ]
        },
        {
          "text": "; seulement que votre menu et votre gros bétail restent ; vos petits enfants aussi iront avec vous.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
