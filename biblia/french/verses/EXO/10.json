          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "char",
