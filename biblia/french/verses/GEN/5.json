          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Seth, après qu'il eut engendré Énosh, vécut 807 ans ; et il engendra des fils et des filles.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et tous les jours de Seth furent 912 ans ; et il mourut.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
            ]
          }
        }
      ]
