          "text": "Et Hénoc, après qu'il eut engendré Methushélah, marcha avec",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "char",
