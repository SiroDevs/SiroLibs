        },
        {
          "text": "Mais Paul [dit] : Plût à",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "ACT.26.29",
                "verseOrgIds": [
                  "ACT.26.29"
                ]
              }
            }
          ]
        },
        {
          "text": "que non seulement toi, mais aussi tous ceux qui m'entendent aujourd'hui, vous deveniez de toutes manières",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        },
        {
          "text": "tels que je suis, hormis ces liens.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.29",
            "verseOrgIds": [
              "ACT.26.29"
            ]
          }
        }
      ]
