              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "et quand ils se furent retirés, ils conférèrent entre eux, disant : Cet homme ne fait rien qui soit digne de mort ou de liens.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.31",
            "verseOrgIds": [
              "ACT.26.31"
            ]
          }
        },
