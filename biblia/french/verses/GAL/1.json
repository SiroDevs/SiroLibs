{
  "id": "GAL.1",
  "number": "1",
  "bookId": "GAL",
  "reference": "Galates 1",
  "copyright": "Texte libre de droits",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "GAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paul, apôtre, non de la part des hommes, ni par l'homme, mais par Jésus Christ, et",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.1",
                "verseOrgIds": [
                  "GAL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "le Père qui l'a ressuscité d'entre les morts,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.1",
            "verseOrgIds": [
              "GAL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "et tous les frères qui sont avec moi, aux assemblées de la Galatie :",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Grâce et paix à vous, de la part de",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.3",
                "verseOrgIds": [
                  "GAL.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "le Père et de notre seigneur Jésus Christ,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.3",
            "verseOrgIds": [
              "GAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui s'est donné lui-même pour nos péchés, en sorte qu'il nous retire du présent siècle mauvais, selon la volonté de notre",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.4",
                "verseOrgIds": [
                  "GAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "et Père,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "auquel soit",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        },
        {
          "text": "la gloire aux siècles des siècles ! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je m'étonne de ce que vous passez si promptement de celui qui vous a appelés par la grâce de Christ, à un évangile différent,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui n'en est pas un autre ; mais il y a des gens qui vous troublent, et qui veulent pervertir l'évangile du Christ.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.7",
            "verseOrgIds": [
              "GAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais quand nous-mêmes, ou quand un ange venu du ciel vous évangéliserait outre ce que nous vous avons évangélisé, qu'il soit anathème.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.8",
            "verseOrgIds": [
              "GAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Comme nous l'avons déjà dit, maintenant aussi je le dis encore : si quelqu'un vous évangélise outre ce que vous avez reçu, qu'il soit anathème.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.9",
            "verseOrgIds": [
              "GAL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car maintenant, est-ce que je m'applique à satisfaire des hommes, ou",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.10",
                "verseOrgIds": [
                  "GAL.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "? Ou est-ce que je cherche à complaire à des hommes ? Si je complaisais encore à des hommes, je ne serais pas esclave de Christ.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or je vous fais savoir, frères, que l'évangile qui a été annoncé par moi n'est pas selon l'homme.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.11",
            "verseOrgIds": [
              "GAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car moi, je ne l'ai pas reçu de l'homme non plus, ni appris, mais par la révélation de Jésus Christ.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.12",
            "verseOrgIds": [
              "GAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car vous avez entendu dire [quelle a été] autrefois ma conduite dans le judaïsme, comment je persécutais outre mesure l'assemblée de",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.13",
                "verseOrgIds": [
                  "GAL.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "et la dévastais,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "et comment j'avançais dans le judaïsme plus que plusieurs de ceux de mon âge dans ma nation, étant le plus ardent zélateur des traditions de mes pères.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais quand il plut à",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.15",
                "verseOrgIds": [
                  "GAL.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", qui",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "text": "m'a mis à part dès le ventre de ma mère et qui m'a appelé par sa grâce,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "de révéler son Fils en moi, afin que je l'annonce",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "text": "parmi les nations, aussitôt, je ne pris pas conseil de la chair ni du sang,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ne montai à Jérusalem vers ceux qui étaient apôtres avant moi, mais je m'en allai en Arabie, et je retournai de nouveau à Damas.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puis, trois ans après, je montai à Jérusalem pour faire la connaissance de Céphas, et je demeurai chez lui 15 jours ;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "et je ne vis aucun autre des apôtres, sinon Jacques le frère du Seigneur.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or dans les choses que je vous écris, voici, devant",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.20",
                "verseOrgIds": [
                  "GAL.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", je ne mens point.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensuite j'allai dans les pays de Syrie et de Cilicie.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or j'étais inconnu de visage aux assemblées de la Judée qui sont en Christ,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mais seulement elles entendaient dire : Celui qui nous persécutait autrefois, annonce",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "text": "maintenant la foi qu'il détruisait",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "text": "jadis ;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "et elles glorifiaient",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.24",
            "verseOrgIds": [
              "GAL.1.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "GAL.1.24",
                "verseOrgIds": [
                  "GAL.1.24"
                ]
              }
            }
          ]
        },
        {
          "text": "à cause de moi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.24",
            "verseOrgIds": [
              "GAL.1.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GAL.2",
