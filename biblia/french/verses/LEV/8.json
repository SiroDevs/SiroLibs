                "verseId": "LEV.8.29",
                "verseOrgIds": [
                  "LEV.8.29"
                ]
              }
            }
          ]
        },
        {
          "text": "; ce fut – du bélier de consécration – la part de Moïse, comme l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
