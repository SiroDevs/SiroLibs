            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "text": "et nos offrandes élevées, et le fruit de tout arbre, le moût et l'huile, aux sacrificateurs, dans les chambres de la maison de notre",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
