          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et nous avons jeté le sort, sacrificateurs, lévites, et peuple, au sujet de l'offrande du bois à amener à la maison de notre",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
