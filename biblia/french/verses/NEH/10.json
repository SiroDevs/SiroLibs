                "verseOrgIds": [
                  "NEH.10.35"
                ]
              }
            }
          ]
        },
        {
          "text": ", selon nos maisons de pères, à des époques fixes, chaque année, pour le brûler sur l'autel de l'",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
