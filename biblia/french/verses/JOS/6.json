          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JOS.6.27",
                "verseOrgIds": [
                  "JOS.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "était avec Josué ; et sa renommée se répandit",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        },
        {
          "text": "dans tout le pays.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.27",
            "verseOrgIds": [
              "JOS.6.27"
            ]
          }
        }
