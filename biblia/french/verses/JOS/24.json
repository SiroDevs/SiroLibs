                "verseOrgIds": [
                  "JOS.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "saint, il est un",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JOS.24.19",
                "verseOrgIds": [
                  "JOS.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "jaloux : il ne pardonnera pas votre transgression et vos péchés.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
