          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si vous abandonnez l'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
