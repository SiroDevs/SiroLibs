              "attrs": {
                "verseId": "JOS.24.27",
                "verseOrgIds": [
                  "JOS.24.27"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Josué renvoya le peuple, chacun à son héritage.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        }
      ]
    },
