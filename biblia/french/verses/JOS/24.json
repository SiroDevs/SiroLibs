                "verseId": "JOS.24.20",
                "verseOrgIds": [
                  "JOS.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", et si vous servez des dieux étrangers",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        },
        {
          "text": ", alors il se retournera et vous fera du mal et vous consumera après vous avoir fait du bien.",
