                "verseOrgIds": [
                  "JOS.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
