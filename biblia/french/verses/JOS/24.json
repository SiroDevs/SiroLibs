          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Israël servit l'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
