          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Éléazar, fils d'Aaron, mourut ; et on l'enterra dans le coteau de Phinées, son fils, qui lui avait été donné dans la montagne d'Éphraïm.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
            "verseOrgIds": [
              "JOS.24.33"
            ]
          }
        }
