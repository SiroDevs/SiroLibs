          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il vit Amalek, et proféra son discours sentencieux, et dit :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
    },
    {
