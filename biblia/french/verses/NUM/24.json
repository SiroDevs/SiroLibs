      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:20"
      },
      "items": [
        {
          "text": "Amalek était la première des nations ; et sa fin sera la destruction.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
