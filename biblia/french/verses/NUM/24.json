          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il vit le Kénien, et il proféra son discours sentencieux, et dit :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:21"
      },
      "items": [
        {
          "text": "Forte est ta demeure, et tu as placé ton nid dans le rocher.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.21",
            "verseOrgIds": [
              "NUM.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toutefois le Kénien doit être consumé, jusqu'à ce qu'Assur t'emmène captif.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.22",
            "verseOrgIds": [
              "NUM.24.22"
            ]
          }
        }
      ]
