                "verseOrgIds": [
                  "EZR.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "qui est à Jérusalem,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
