            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Béni soit l'",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
