                "verseOrgIds": [
                  "PSA.99.8"
                ]
              }
            }
          ]
        },
        {
          "text": "! tu leur as répondu, tu as été pour eux un",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.99.8",
                "verseOrgIds": [
                  "PSA.99.8"
                ]
              }
            }
          ]
        },
        {
          "text": "qui pardonnait, et prenait vengeance de leurs actes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.8",
            "verseOrgIds": [
              "PSA.99.8"
            ]
          }
        }
      ]
    },
