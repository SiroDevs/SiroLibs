                  "PSA.99.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", et prosternez-vous en la montagne de sa sainteté ; car l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.99.9",
            "verseOrgIds": [
              "PSA.99.9"
            ]
          }
        },
