    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 146:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Louez Jah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        },
        {
          "text": "Mon âme, loue l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.1",
                "verseOrgIds": [
                  "PSA.146.1"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.1",
            "verseOrgIds": [
              "PSA.146.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 146:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je louerai l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.2",
                "verseOrgIds": [
                  "PSA.146.2"
                ]
              }
            }
          ]
        },
        {
          "text": "durant ma vie ; je chanterai des cantiques à mon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.2",
                "verseOrgIds": [
                  "PSA.146.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tant que j'existerai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 146:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne vous confiez pas dans les principaux, dans un fils d'homme, en qui il n'y a pas de salut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.3",
            "verseOrgIds": [
              "PSA.146.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 146:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Son esprit sort, l'homme retourne dans le sol d'où il est tiré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        },
        {
          "text": "; en ce même jour ses desseins périssent.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.4",
            "verseOrgIds": [
              "PSA.146.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 146:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bienheureux celui qui a le",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.5",
                "verseOrgIds": [
                  "PSA.146.5"
                ]
              }
            }
          ]
        },
        {
          "text": "de Jacob pour son secours, qui s'attend à l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.5",
                "verseOrgIds": [
                  "PSA.146.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", son",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.5",
                "verseOrgIds": [
                  "PSA.146.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.5",
            "verseOrgIds": [
              "PSA.146.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 146:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a fait les cieux et la terre, la mer, et tout ce qui s'y trouve ; qui garde la vérité à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 146:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui exécute le jugement en faveur des opprimés ; qui donne du pain à ceux qui ont faim !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 146:7"
      },
      "items": [
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.7",
                "verseOrgIds": [
                  "PSA.146.7"
                ]
              }
            }
          ]
        },
        {
          "text": "met en liberté les prisonniers.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 146:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.8",
                "verseOrgIds": [
                  "PSA.146.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ouvre les yeux des aveugles ; l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.8",
                "verseOrgIds": [
                  "PSA.146.8"
                ]
              }
            }
          ]
        },
        {
          "text": "relève ceux qui sont courbés ; l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.8",
                "verseOrgIds": [
                  "PSA.146.8"
                ]
              }
            }
          ]
        },
        {
          "text": "aime les justes ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.8",
            "verseOrgIds": [
              "PSA.146.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
