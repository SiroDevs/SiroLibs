          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.10",
                "verseOrgIds": [
                  "PSA.146.10"
                ]
              }
            }
          ]
        },
        {
          "text": "régnera à toujours, – ton",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.10",
                "verseOrgIds": [
                  "PSA.146.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ô Sion ! de génération en génération. Louez Jah !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.10",
            "verseOrgIds": [
              "PSA.146.10"
            ]
          }
        }
      ]
