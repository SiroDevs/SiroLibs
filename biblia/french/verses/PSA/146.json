          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 146:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.146.9",
                "verseOrgIds": [
                  "PSA.146.9"
                ]
              }
            }
          ]
        },
        {
          "text": "garde les étrangers ; il affermit l'orphelin et la veuve, et confond",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        },
        {
          "text": "la voie des méchants.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.9",
            "verseOrgIds": [
              "PSA.146.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
