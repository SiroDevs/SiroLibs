      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 118:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Célébrez l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.1",
                "verseOrgIds": [
                  "PSA.118.1"
                ]
              }
            }
          ]
        },
        {
          "text": "! Car il est bon ; car sa bonté demeure à",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        },
        {
          "text": "toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.1",
            "verseOrgIds": [
              "PSA.118.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 118:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'Israël dise, que sa bonté demeure à toujours !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.2",
            "verseOrgIds": [
              "PSA.118.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 118:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que la maison d'Aaron dise, que sa bonté demeure à toujours !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.3",
            "verseOrgIds": [
              "PSA.118.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 118:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que ceux qui craignent l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.4",
            "verseOrgIds": [
              "PSA.118.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.4",
                "verseOrgIds": [
                  "PSA.118.4"
                ]
              }
            }
          ]
        },
        {
          "text": "disent, que sa bonté demeure à toujours !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.4",
            "verseOrgIds": [
              "PSA.118.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 118:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dans ma détresse j'ai invoqué Jah ; Jah m'a répondu, [et m'a mis] au large.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.5",
            "verseOrgIds": [
              "PSA.118.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 118:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.6",
                "verseOrgIds": [
                  "PSA.118.6"
                ]
              }
            }
          ]
        },
        {
          "text": "est pour moi, je ne craindrai pas ; que me fera l'homme ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.6",
            "verseOrgIds": [
              "PSA.118.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 118:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.7",
                "verseOrgIds": [
                  "PSA.118.7"
                ]
              }
            }
          ]
        },
        {
          "text": "est pour moi entre ceux qui me secourent ; et moi je verrai [mon plaisir] en ceux qui me haïssent.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.7",
            "verseOrgIds": [
              "PSA.118.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 118:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mieux vaut mettre sa confiance en l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.8",
                "verseOrgIds": [
                  "PSA.118.8"
                ]
              }
            }
          ]
        },
        {
          "text": "que de se confier en l'homme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.8",
            "verseOrgIds": [
              "PSA.118.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 118:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mieux vaut mettre sa confiance en l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.9",
            "verseOrgIds": [
              "PSA.118.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.9",
                "verseOrgIds": [
                  "PSA.118.9"
                ]
              }
            }
          ]
        },
        {
          "text": "que de se confier dans les principaux.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.9",
            "verseOrgIds": [
              "PSA.118.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 118:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toutes les nations m'avaient environné ; au nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.10",
                "verseOrgIds": [
                  "PSA.118.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", certes je les ai détruites.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.10",
            "verseOrgIds": [
              "PSA.118.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 118:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elles m'avaient environné, oui, environné ; au nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.11",
            "verseOrgIds": [
              "PSA.118.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.11",
                "verseOrgIds": [
                  "PSA.118.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", certes je les ai détruites.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.11",
            "verseOrgIds": [
              "PSA.118.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 118:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elles m'avaient environné comme des abeilles ; elles ont été éteintes comme un feu d'épines ; au nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.12",
                "verseOrgIds": [
                  "PSA.118.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", certes je les ai détruites.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.12",
            "verseOrgIds": [
              "PSA.118.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 118:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu m'avais rudement poussé, pour que je tombe ; mais l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.13",
                "verseOrgIds": [
                  "PSA.118.13"
                ]
              }
            }
          ]
        },
        {
          "text": "m'a été en secours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.13",
            "verseOrgIds": [
              "PSA.118.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 118:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jah a été ma force et mon cantique, et il a été mon salut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.14",
            "verseOrgIds": [
              "PSA.118.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 118:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "La voix de triomphe et de salut est dans les tentes des justes : la droite de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.15",
                "verseOrgIds": [
                  "PSA.118.15"
                ]
              }
            }
          ]
        },
        {
          "text": "agit puissamment ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.15",
            "verseOrgIds": [
              "PSA.118.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 118:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "La droite de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.16",
                "verseOrgIds": [
                  "PSA.118.16"
                ]
              }
            }
          ]
        },
        {
          "text": "est haut élevée, la droite de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.118.16",
                "verseOrgIds": [
                  "PSA.118.16"
                ]
              }
            }
          ]
        },
        {
          "text": "agit puissamment ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.16",
            "verseOrgIds": [
              "PSA.118.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 118:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je ne mourrai pas, mais je vivrai, et je raconterai les œuvres de Jah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.17",
            "verseOrgIds": [
              "PSA.118.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 118:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jah m'a sévèrement châtié, mais il ne m'a pas livré à la mort.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.18",
            "verseOrgIds": [
              "PSA.118.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 118:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouvrez-moi les portes de la justice ; j'y entrerai, je célébrerai Jah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.118.19",
            "verseOrgIds": [
              "PSA.118.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 118:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
