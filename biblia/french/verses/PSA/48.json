{
  "id": "PSA.48",
  "number": "48",
  "bookId": "PSA",
  "reference": "Psaumes 48",
  "copyright": "Texte libre de droits",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "PSA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantique. Psaume des fils de Coré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.2",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "est grand et fort digne de louange dans la ville de notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.2",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", dans sa montagne sainte.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Belle dans son élévation, la joie de toute la terre, est la montagne de Sion, aux côtés du nord, la ville du grand roi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.4",
                "verseOrgIds": [
                  "PSA.48.4"
                ]
              }
            }
          ]
        },
        {
          "text": "est connu dans ses palais pour une haute retraite.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car voici, les rois se sont assemblés",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        },
        {
          "text": ", ils ont passé outre ensemble :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils ont vu, – ils ont été étonnés ; ils ont été troublés, ils se sont enfuis consternés.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Là, le tremblement les a saisis, une angoisse comme [celle de] la femme qui enfante.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Par le vent d'orient tu as brisé les navires de Tarsis.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Comme nous avons entendu, ainsi nous l'avons vu dans la ville de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.9",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées, dans la ville de notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.9",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.9",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "l'établit pour toujours. Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.10",
                "verseOrgIds": [
                  "PSA.48.10"
                ]
              }
            }
          ]
        },
        {
          "text": "! nous avons pensé à ta bonté, au milieu de ton temple.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.11",
                "verseOrgIds": [
                  "PSA.48.11"
                ]
              }
            }
          ]
        },
        {
          "text": "! comme ton nom, ainsi est ta louange, jusqu'aux bouts de la terre ; ta droite est pleine de justice.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que la montagne de Sion se réjouisse, que les filles de Juda s'égaient, à cause de tes jugements.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faites le tour de Sion, et faites-en le circuit ; comptez ses tours,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faites attention à son rempart, considérez ses palais, afin que vous le racontiez à la génération à venir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.14",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car ce",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.15",
            "verseOrgIds": [
              "PSA.48.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.15",
                "verseOrgIds": [
                  "PSA.48.15"
                ]
              }
            }
          ]
        },
        {
          "text": "est notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.15",
            "verseOrgIds": [
              "PSA.48.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.15",
                "verseOrgIds": [
                  "PSA.48.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", pour toujours et à perpétuité ; il sera notre guide jusqu'à la mort.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.15",
            "verseOrgIds": [
              "PSA.48.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.49",
