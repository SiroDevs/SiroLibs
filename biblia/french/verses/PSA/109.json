{
  "id": "PSA.109",
  "number": "109",
  "bookId": "PSA",
  "reference": "Psaumes 109",
  "copyright": "Texte libre de droits",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "109",
        "style": "c",
        "sid": "PSA 109"
      },
      "items": [
        {
          "text": "109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 109:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au chef de musique. De David. Psaume. Ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.1",
                "verseOrgIds": [
                  "PSA.109.1"
                ]
              }
            }
          ]
        },
        {
          "text": "de ma louange ! ne te tais point.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 109:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car la bouche du méchant et la bouche de la fraude se sont ouvertes contre moi : ils parlent contre moi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        },
        {
          "text": "avec une langue menteuse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 109:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils m'ont entouré de paroles de haine, et ils me font la guerre sans cause.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 109:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pour mon amour, ils ont été mes adversaires ; mais moi [je me suis adonné à la] prière.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 109:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils m'ont rendu le mal pour le bien, et la haine pour mon amour.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 109:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Prépose sur lui un méchant, et que l'adversaire",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        },
        {
          "text": "se tienne à sa droite ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 109:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quand il sera jugé, qu'il soit déclaré méchant, et que sa prière lui soit [comptée] comme un péché ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 109:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que ses jours soient peu nombreux, qu'un autre prenne sa charge ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 109:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que ses fils soient orphelins, et sa femme veuve ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 109:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que ses fils soient vagabonds, et qu'ils mendient, et qu'ils aillent quêtant loin de leurs [demeures en] ruines.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 109:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que l'usurier jette le filet sur tout ce qui est à lui, et que les étrangers pillent [le fruit de] son travail ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 109:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'il n'y ait personne qui étende sa bonté sur lui, et qu'il n'y ait personne qui use de grâce envers ses orphelins ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 109:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que sa postérité soit retranchée ; que, dans la génération qui suivra, leur nom soit effacé ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 109:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que l'iniquité de ses pères revienne en mémoire devant l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.14",
                "verseOrgIds": [
                  "PSA.109.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", et que le péché de sa mère ne soit point effacé ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 109:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'ils soient continuellement devant l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.15",
                "verseOrgIds": [
                  "PSA.109.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", et qu'il retranche leur mémoire de la terre ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 109:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parce qu'il ne s'est point souvenu d'user de bonté, et qu'il a persécuté l'affligé et le pauvre, et celui qui a le cœur brisé, pour le faire mourir.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 109:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il a aimé la malédiction : – qu'elle vienne sur lui ! Et il n'a pas pris plaisir à la bénédiction : – qu'elle soit loin de lui !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.17",
            "verseOrgIds": [
              "PSA.109.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 109:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et qu'il soit revêtu de la malédiction comme de sa robe ; et qu'elle entre au-dedans de lui comme de l'eau, et dans ses os comme de l'huile ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.18",
            "verseOrgIds": [
              "PSA.109.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 109:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'elle lui soit comme un vêtement dont il se couvre, et comme une ceinture qui le ceigne continuellement.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.19",
            "verseOrgIds": [
              "PSA.109.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 109:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Telle soit, de par l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.20",
            "verseOrgIds": [
              "PSA.109.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.20",
                "verseOrgIds": [
                  "PSA.109.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", la récompense de mes adversaires et de ceux qui parlent en mal contre mon âme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.20",
            "verseOrgIds": [
              "PSA.109.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 109:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais toi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.21",
            "verseOrgIds": [
              "PSA.109.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.21",
                "verseOrgIds": [
                  "PSA.109.21"
                ]
              }
            }
          ]
        },
        {
          "text": "! Seigneur ! agis pour moi à cause de ton nom ; car ta gratuité est bonne ; délivre-moi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.21",
            "verseOrgIds": [
              "PSA.109.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 109:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car je suis affligé et pauvre, et mon cœur est blessé au-dedans de moi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.22",
            "verseOrgIds": [
              "PSA.109.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 109:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je m'en vais comme l'ombre quand elle s'allonge ; je suis jeté çà et là comme la sauterelle ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.23",
            "verseOrgIds": [
              "PSA.109.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 109:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mes genoux chancellent par le jeûne, et ma chair s'est amaigrie et n'a plus sa graisse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.24",
            "verseOrgIds": [
              "PSA.109.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 109:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et moi, je leur suis en opprobre ; quand ils me voient, ils hochent la tête.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.25",
            "verseOrgIds": [
              "PSA.109.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 109:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aide-moi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.26",
            "verseOrgIds": [
              "PSA.109.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.26",
                "verseOrgIds": [
                  "PSA.109.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", mon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.26",
            "verseOrgIds": [
              "PSA.109.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.26",
                "verseOrgIds": [
                  "PSA.109.26"
                ]
              }
            }
          ]
        },
        {
          "text": "! Sauve-moi selon ta bonté !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.26",
            "verseOrgIds": [
              "PSA.109.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 109:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et qu'on sache que c'est ici ta main, – que toi, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.27",
            "verseOrgIds": [
              "PSA.109.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.27",
                "verseOrgIds": [
                  "PSA.109.27"
                ]
              }
            }
          ]
        },
        {
          "text": "! tu l'as fait.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.27",
            "verseOrgIds": [
              "PSA.109.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 109:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'eux, ils maudissent ; mais toi, bénis. S'ils s'élèvent, qu'ils soient honteux, et que ton serviteur se réjouisse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.28",
            "verseOrgIds": [
              "PSA.109.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PSA 109:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que mes adversaires soient revêtus de confusion, et qu'ils se couvrent de leur honte comme d'un manteau.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.29",
            "verseOrgIds": [
              "PSA.109.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PSA 109:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Alors] de ma bouche je célébrerai hautement l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.30",
            "verseOrgIds": [
              "PSA.109.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.30",
                "verseOrgIds": [
                  "PSA.109.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", et je le louerai au milieu de la multitude ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.30",
            "verseOrgIds": [
              "PSA.109.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PSA 109:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il s'est tenu à la droite du pauvre, pour le sauver de ceux qui jugeaient son âme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.31",
            "verseOrgIds": [
              "PSA.109.31"
            ]
          }
        }
      ]
    }
  ],
