                "verseOrgIds": [
                  "EZK.28.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", leur",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        },
