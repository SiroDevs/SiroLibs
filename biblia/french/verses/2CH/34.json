              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", de marcher après l'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
