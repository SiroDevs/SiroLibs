              "type": "text",
              "attrs": {
                "verseId": "2CH.34.32",
                "verseOrgIds": [
                  "2CH.34.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", du",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
