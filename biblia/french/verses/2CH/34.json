          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "text": "tous ceux qui se trouvaient en Israël à servir l'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
