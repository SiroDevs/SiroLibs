          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et le roi monta à la maison de l'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", et tous les hommes de Juda, et les habitants de Jérusalem, et les sacrificateurs, et les lévites, et tout le peuple, depuis le grand jusqu'au petit ; et on lut, eux l'entendant",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "text": ", toutes les paroles du livre de l'alliance qui avait été trouvé dans la maison de l'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
