                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": "et de garder ses commandements et ses témoignages et ses statuts, de tout son cœur et de toute son âme, pour pratiquer les paroles de l'alliance, écrites dans ce livre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
