                  "MAT.22.32"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Abraham, et le",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
