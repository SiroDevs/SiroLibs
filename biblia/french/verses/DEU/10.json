              "attrs": {
                "verseId": "DEU.10.17",
                "verseOrgIds": [
                  "DEU.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", votre",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
