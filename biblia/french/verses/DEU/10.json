          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et vous aimerez l'étranger ; car vous avez été étrangers dans le pays d'Égypte.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
