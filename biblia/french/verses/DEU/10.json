                "verseOrgIds": [
                  "DEU.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", est le",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
