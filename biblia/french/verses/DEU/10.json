          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Circoncisez donc votre cœur",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.16",
            "verseOrgIds": [
              "DEU.10.16"
            ]
          }
        },
        {
          "text": ", et ne roidissez plus votre cou ;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.16",
            "verseOrgIds": [
              "DEU.10.16"
            ]
          }
        },
