                "verseOrgIds": [
                  "DEU.30.9"
                ]
              }
            }
          ]
        },
        {
          "text": "prendra de nouveau plaisir en toi, pour [ton] bien, comme il a pris plaisir en tes pères ;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
