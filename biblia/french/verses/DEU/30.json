                "verseId": "DEU.30.1",
                "verseOrgIds": [
                  "DEU.30.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", t'aura chassé,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
