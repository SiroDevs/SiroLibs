                "verseId": "DEU.30.3",
                "verseOrgIds": [
                  "DEU.30.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
