                "verseOrgIds": [
                  "DEU.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.30.2",
                "verseOrgIds": [
                  "DEU.30.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", et que tu auras écouté sa voix, selon tout ce que je te commande aujourd'hui, toi et tes fils, de tout ton cœur et de toute ton âme,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
