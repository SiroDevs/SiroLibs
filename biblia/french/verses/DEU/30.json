          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "text": "seraient au bout des cieux, l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
