                "verseOrgIds": [
                  "DEU.30.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", circoncira ton cœur et le cœur de ta semence, pour que tu aimes l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
