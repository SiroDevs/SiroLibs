                "verseId": "DEU.26.19",
                "verseOrgIds": [
                  "DEU.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
