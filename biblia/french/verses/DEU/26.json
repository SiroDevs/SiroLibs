              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aujourd'hui l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.16",
                "verseOrgIds": [
                  "DEU.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.16",
                "verseOrgIds": [
                  "DEU.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", te commande de pratiquer ces statuts et ces ordonnances ; et tu les garderas et tu les feras de tout ton cœur et de toute ton âme.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu as fait promettre aujourd'hui à l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.17",
                "verseOrgIds": [
                  "DEU.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "qu'il sera ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.26.17",
                "verseOrgIds": [
                  "DEU.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", pour que tu marches dans ses voies, et que tu gardes ses statuts, et ses commandements, et ses ordonnances, et que tu écoutes sa voix ;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
