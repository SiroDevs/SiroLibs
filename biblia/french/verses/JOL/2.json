              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne craignez pas, bêtes des champs, car les pâturages du désert verdissent, car l'arbre porte son fruit, le figuier et la vigne donnent leur force",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.22",
            "verseOrgIds": [
              "JOL.2.22"
