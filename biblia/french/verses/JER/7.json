          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "*La parole qui vint à Jérémie de par l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.1",
                "verseOrgIds": [
                  "JER.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", disant :",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiens-toi dans la porte de la maison de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", et là, crie cette parole et dis : Écoutez la parole de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", vous, tout Juda, qui entrez par ces portes pour vous prosterner devant l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.2",
                "verseOrgIds": [
                  "JER.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ainsi dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.3",
                "verseOrgIds": [
                  "JER.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées, le",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.3",
                "verseOrgIds": [
                  "JER.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël : Amendez vos voies et vos actions, et je vous ferai demeurer dans ce lieu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mettez pas votre confiance en des paroles de mensonge, disant : C'est ici le temple de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", le temple de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", le temple de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.4",
                "verseOrgIds": [
                  "JER.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais si vous amendez réellement vos voies et vos actions, si vous faites réellement la justice",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "text": "entre un homme et son prochain,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "si vous n'opprimez pas l'étranger, l'orphelin et la veuve, et que vous ne versiez pas le sang innocent dans ce lieu, et que vous ne marchiez pas après d'autres dieux pour votre dommage,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.6",
            "verseOrgIds": [
              "JER.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "je vous ferai demeurer dans ce lieu, dans le pays que j'ai donné à vos pères, de siècle en siècle.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, vous vous confiez en des paroles de mensonge, qui ne profitent pas.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.8",
            "verseOrgIds": [
              "JER.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quoi ? voler, tuer, commettre adultère, jurer faussement, brûler de l'encens à Baal, marcher après d'autres dieux que vous ne connaissez pas !…",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.9",
            "verseOrgIds": [
              "JER.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "et vous venez, et vous vous tenez devant moi dans cette maison qui est appelée de mon nom, et vous dites : Nous sommes délivrés pour faire toutes ces abominations.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.10",
            "verseOrgIds": [
              "JER.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cette maison qui est appelée de mon nom, est-elle une caverne de voleurs à vos yeux ? Moi aussi, voici, je l'ai vu, dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.11",
                "verseOrgIds": [
                  "JER.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car allez à mon lieu qui était à Silo, où j'ai fait demeurer mon nom au commencement, et regardez ce que je lui ai fait, à cause de l'iniquité de mon peuple Israël.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et maintenant, parce que vous avez fait toutes ces actions, dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.13",
                "verseOrgIds": [
                  "JER.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", et que je vous ai parlé, me levant de bonne heure et parlant, et que vous n'avez pas écouté, et que je vous ai appelés et que vous n'avez pas répondu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "je ferai à cette maison qui est appelée de mon nom, en laquelle vous avez mis votre confiance, et au lieu que je vous ai donné, à vous et à vos pères, comme j'ai fait à Silo ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "et je vous chasserai de devant ma face, comme j'ai chassé tous vos frères, toute la semence d'Éphraïm.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et toi, ne prie pas pour ce peuple, et ne fais monter pour eux ni cri ni prière ; et n'insiste pas auprès de moi, car je ne t'écouterai pas.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne vois-tu pas ce qu'ils font dans les villes de Juda, et dans les rues de Jérusalem ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils ramassent le bois, et les pères allument le feu, et les femmes pétrissent la pâte pour faire des gâteaux à la reine des cieux, et pour répandre des libations à d'autres dieux, afin de me provoquer à colère.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Est-ce moi qu'ils provoquent à colère ? dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.19",
                "verseOrgIds": [
                  "JER.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": ". N'est-ce pas eux-mêmes, à la honte de leur visage ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est pourquoi, ainsi dit le Seigneur, l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.20",
                "verseOrgIds": [
                  "JER.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": ": Voici, ma colère et ma fureur vont être versées sur ce lieu-ci, sur l'homme et sur la bête, sur l'arbre des champs et sur le fruit de la terre ; et elles s'embraseront et ne s'éteindront pas.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ainsi dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.21",
                "verseOrgIds": [
                  "JER.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "des armées, le",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.21",
                "verseOrgIds": [
                  "JER.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël : Ajoutez vos holocaustes à vos sacrifices, et mangez de la chair.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car je n'ai point parlé avec vos pères, et je ne leur ai point commandé touchant des holocaustes et des sacrifices, au jour où je les fis sortir du pays d'Égypte.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais je leur ai commandé ceci, disant : Écoutez ma voix, et je serai votre",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.23",
                "verseOrgIds": [
                  "JER.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", et vous serez mon peuple",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "text": "; et marchez dans toute la voie que je vous commande, afin que vous vous trouviez bien.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils n'écoutèrent pas et n'inclinèrent pas leur oreille ; mais ils marchèrent dans les conseils, dans l'obstination de leur mauvais cœur, et ils sont allés en arrière et non en avant.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Depuis le jour où vos pères sortirent du pays d'Égypte, jusqu'à ce jour, je vous ai envoyé tous mes serviteurs les prophètes, chaque jour me levant de bonne heure, et les envoyant.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais ils ne m'ont point écouté, et ils n'ont point incliné leur oreille ; et ils ont roidi leur cou, ils ont fait pis que leurs pères.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et tu leur diras toutes ces paroles, mais ils ne t'écouteront pas ; et tu crieras après eux, mais ils ne te répondront pas.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et tu leur diras : C'est ici la nation qui n'a point écouté la voix de l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.28",
                "verseOrgIds": [
                  "JER.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", son",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.28",
                "verseOrgIds": [
                  "JER.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", et qui n'a point accepté la correction ; la fidélité a péri, et est retranchée de leur bouche.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Coupe ta chevelure, et jette-la loin, et, sur les hauteurs",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "text": ", élève une complainte ; car l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.29",
                "verseOrgIds": [
                  "JER.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "a rejeté et abandonné la génération de sa colère",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car les fils de Juda ont fait ce qui est mauvais à mes yeux, dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.30",
                "verseOrgIds": [
                  "JER.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": "; ils ont mis leurs abominations dans la maison qui est appelée de mon nom, pour la rendre impure.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils ont bâti les hauts lieux de Topheth, qui est dans la vallée du fils de Hinnom, pour brûler au feu leurs fils et leurs filles, ce que je n'ai point commandé et qui ne m'est point monté au cœur.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est pourquoi, voici, des jours viennent, dit l'",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "JER.7.32",
                "verseOrgIds": [
                  "JER.7.32"
                ]
              }
            }
          ]
        },
        {
          "text": ", où l'on ne dira plus Topheth et la vallée du fils de Hinnom, mais la vallée de la tuerie ; et on enterrera à Topheth, jusqu'à ce qu'il n'y ait plus de place",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les cadavres de ce peuple seront en pâture aux oiseaux des cieux et aux bêtes de la terre, et il n'y aura personne qui les effraie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et je ferai cesser dans les villes de Juda et dans les rues de Jérusalem la voix de l'allégresse et la voix de la joie, la voix de l'époux et la voix de l'épouse ; car le pays deviendra un désert.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.34",
            "verseOrgIds": [
              "JER.7.34"
            ]
          }
        }
      ]
    }
  ],
