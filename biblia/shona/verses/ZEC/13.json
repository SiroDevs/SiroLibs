  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ZEC 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kushambidzwa paZvivi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva iro imba yaDhavhidhi navagari vomuJerusarema, vachadziurirwa chitubu kuti vanatswe kubva pachivi nokusachena.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.1",
            "verseOrgIds": [
              "ZEC.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva iro, ndichabvisa mazita ezvifananidzo panyika, uye haangazorangarirwizve,\" ndizvo zvinotaura Jehovha Wamasimba Ose! \"Ndichabvisa zvose vaprofita nemweya wokusachena panyika.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.2",
            "verseOrgIds": [
              "ZEC.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana pana ani zvake acharamba achiprofita, baba vake namai vake vakamubereka, vachati kwaari, 'Unofanira kufa, nokuti wakareva nhema muzita raJehovha.' Paachaprofita, vabereki vake vachamubaya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.3",
            "verseOrgIds": [
              "ZEC.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva iro muprofita mumwe nomumwe achanyara nokuda kwechiratidzo chechiprofita chake. Haangazopfeki nguo yemvere yomuprofita kuti anyengere.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.4",
            "verseOrgIds": [
              "ZEC.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achati, 'Handisi muprofita. Ndiri murimi; ivhu ndiwo upenyu hwangu kubva pauduku hwangu.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.5",
            "verseOrgIds": [
              "ZEC.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mumwe munhu akamubvunza achiti, 'Maronda aya ari pamuviri wako ndeeiko?' achapindura achiti, 'Maronda andakakuvadzwa paimba yeshamwari dzangu.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufudzi arohwa, makwai akapararira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muka, iwe munondo, urwise mufudzi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:7"
      },
      "items": [
        {
          "text": "urwise munhu ari pedyo neni!\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:7"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 13:7"
      },
      "items": [
        {
          "text": "\"Rova mufudzi, makwai agopararira,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:7"
      },
      "items": [
        {
          "text": "uye ndichasimudza ruoko rwangu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:7"
      },
      "items": [
        {
          "text": "kuti rurwise madiki acho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyika yose,\" ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:8"
      },
      "items": [
        {
          "text": "\"zvikamu zviviri muzvitatu zvichaurayiwa zvigoparara;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:8"
      },
      "items": [
        {
          "text": "asi chikamu chimwe chete muzvitatu ndicho chichasaramo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikamu chimwe chete ichochi muzvitatu ndichachiisa mumoto;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:9"
      },
      "items": [
        {
          "text": "ndichavanatsa sesirivha",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:9"
      },
      "items": [
        {
          "text": "uye ndichavaedza segoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 13:9"
      },
      "items": [
        {
          "text": "Vachadana kuzita rangu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:9"
      },
      "items": [
        {
          "text": "uye ndichavapindura;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 13:9"
      },
      "items": [
        {
          "text": "ndichati, 'Ndivo vanhu vangu.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 13:9"
      },
      "items": [
        {
          "text": "Uye ivo vachati, 'Jehovha ndiye Mwari wedu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.9",
            "verseOrgIds": [
              "ZEC.13.9"
            ]
          }
        }
      ]
    }
  ],
