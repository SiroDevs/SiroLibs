{
  "id": "ZEC.4",
  "number": "4",
  "bookId": "ZEC",
  "reference": "Zekaria 4",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ZEC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chigadziko choMwenje cheGoridhe neMiti yeMiorivhi Miviri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mutumwa akataura neni akauyazve kwandiri akandimutsa, somunhu anomutswa pahope dzake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.1",
            "verseOrgIds": [
              "ZEC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandibvunza achiti, \"Unooneiko?\" Ndakapindura ndikati, \"Ndinoona chigadziko chomwenje chegoridhe rizere, chine mbiya pamusoro pacho nemwenje minomwe pamusoro pacho, mwenje mumwe nomumwe une mbombi nomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve pane miti miviri yemiorivhi parutivi pacho, mumwe kurutivi rworudyi rwembiya nomumwe kurutivi rworuboshwe kwayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.3",
            "verseOrgIds": [
              "ZEC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabvunza mutumwa aitaura ndichiti, \"Izvi zviiko, ishe wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.4",
            "verseOrgIds": [
              "ZEC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Hauzivi kuti izvi zvii?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:5"
      },
      "items": [
        {
          "text": "Ini ndakapindura ndichiti, \"Kwete, ishe wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akati kwandiri, \"Iri ndiro shoko raJehovha kuna Zerubhabheri: 'Hazviitwi nehondo kana nesimba, asi nomweya wangu,' ndizvo zvinotaura Jehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.6",
            "verseOrgIds": [
              "ZEC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uri chiiko, iwe gomo guru? Pamberi paZerubhabheri uchaitwa bani. Ipapo iye achabudisa ibwe rokumusoro vanhu vachidanidzira vachiti, 'Mwari ngaariropafadze! Mwari ngaariropafadze!' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.7",
            "verseOrgIds": [
              "ZEC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.8",
            "verseOrgIds": [
              "ZEC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Maoko aZerubhabheri akateya nheyo dzetemberi ino; maoko ake achaipedzisazve. Ipapo uchaziva kuti Jehovha Wamasimba Ose akandituma kwauri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.9",
            "verseOrgIds": [
              "ZEC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiani anoshora zuva rezvinhu zviduku? Vanhu vachafara pavachaona rwodzi rwokuyera muruoko rwaZerubhabheri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:10"
      },
      "items": [
        {
          "text": "\"(Zvinomwe izvi ndizvo maziso aJehovha, anoona nyika yose.)\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakabvunza mutumwa ndichiti, \"Ko, miti yemiorivhi miviri iyi iri kurudyi nokuruboshwe kwechigadziko chomwenje ndeyei?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve ndakamubvunza kuti, \"Ko, matavi aya maviri omuorivhi parutivi pembombi mbiri dzegoridhe dzinodurura mafuta egoridhe ndeei?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Hauzivi kuti izvi zvii?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 4:13"
      },
      "items": [
        {
          "text": "Ini ndikati, \"Kwete, ishe wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akati, \"Ava ndivo vaviri vakazodzwa kuti vashumire Ishe wenyika yose.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.14",
            "verseOrgIds": [
              "ZEC.4.14"
            ]
          }
        }
      ]
    }
  ],
