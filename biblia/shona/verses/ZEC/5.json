  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ZEC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rugwaro Rwakapetwa Rwaibhururuka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatarisazve ndikaona, hapo pamberi pangu paiva norugwaro rwakapetwa rwaibhururuka!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandibvunza akati, \"Unooneiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 5:2"
      },
      "items": [
        {
          "text": "Ndakapindura ndikati, \"Ndinoona rugwaro rwakapetwa rwuri kubhururuka, rwakareba makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "text": "nokufara makubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye iye akati kwandiri, \"Uku ndiko kutuka kunobuda pamusoro penyika yose; nokuti sezvazvakanyorwa kune rimwe divi, mbavha imwe neimwe ichaparadzwa, uye sezvazvakanyorwa kune rimwe divi racho, mumwe nomumwe anopika zvenhema achaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose, 'Ndichabudisa kutuka, uye kuchapinda muimba yembavha nomumba mouyo anopika nhema nezita rangu. Kucharamba kuri mumba make uye kuchaparadza zvose mapango namabwe ayo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mukadzi akanga ari muDengu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mutumwa akanga achitaura neni akaswedera kwandiri akati, \"Simudza meso ako uone kuti ichi chii chiri kubuda apo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.5",
            "verseOrgIds": [
              "ZEC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabvunza ndikati, \"Chiiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 5:6"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Iri idengu rokuyeresa.\" Uye akatizve, \"Ichi ndicho chitadzo chavanhu vari munyika yose.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo hwidibiro yomutobvu yakasimudzwa, uye mukadzi akanga akagara mudengu imomo!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa akati, \"Uyu ndiye zvakaipa,\" achibva amusundidzira zvakare mudengu uye ndokuzarira muromo wedengu nehwidibiro yomutobvu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.8",
            "verseOrgIds": [
              "ZEC.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakasimudza meso angu ndikaona, hapo pamberi pangu paiva navakadzi vaviri, mhepo iri mumapapiro avo! Vaiva namapapiro anenge mapapiro edambiramurove, uye vakasimudza dengu vakaenda naro mudenga pakati pedenga nenyika.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabvunza mutumwa akanga achitaura neni ndikati, \"Vari kuriendesa kupiko, dengu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Kunyika yeBhabhironi kundorivakira imba. Kana yapera, dengu richaiswa imomo panzvimbo yaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        }
      ]
    }
  ],
