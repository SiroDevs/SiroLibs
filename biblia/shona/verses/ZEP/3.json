        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ramangwana reJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rine nhamo guta ravamanikidzi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:1"
      },
      "items": [
        {
          "text": "rakapanduka uye rikasvibiswa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.1",
            "verseOrgIds": [
              "ZEP.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harina warinoteerera,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "harigamuchiri kudzorwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "Harivimbi naJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:2"
      },
      "items": [
        {
          "text": "hariswederi pedyo naMwari waro.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.2",
            "verseOrgIds": [
              "ZEP.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Machinda aro ishumba dzinoomba,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:3"
      },
      "items": [
        {
          "text": "vatongi varo mapere amadekwana,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:3"
      },
      "items": [
        {
          "text": "vasingasiyi chinhu chamangwanani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.3",
            "verseOrgIds": [
              "ZEP.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprofita vavo vanozvikudza;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "vanhu vanonyengera.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "Vaprista varo vanozvidza nzvimbo tsvene",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:4"
      },
      "items": [
        {
          "text": "uye vanoputsa murayiro.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.4",
            "verseOrgIds": [
              "ZEP.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ari mariri mutsvene;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "haaiti zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "Mangwanani oga oga anotonga nokururamisira kwake,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "zuva rimwe nerimwe idzva anoriuyisa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:5"
      },
      "items": [
        {
          "text": "asi vasakarurama havanyari.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.5",
            "verseOrgIds": [
              "ZEP.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakaparadza ndudzi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "shongwe dzavo dzakaparara.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "Ndakasiya nzira dzavo dzisisafambwi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "hapasisina anopfuura nomo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "Maguta avo akaparadzwa;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:6"
      },
      "items": [
        {
          "text": "hapana achasiyiwa, kana mumwe zvake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakati kuguta,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "'Zvirokwazvo uchanditya",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "ugogamuchira kudzorwa!'",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "Ipapo vagari varo havangaparadzwi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "kana kuranga kwangu kwose hakungauyi pariri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "Asi vakanga vachine shungu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:7"
      },
      "items": [
        {
          "text": "dzokuita uori pakuita kwavo kwose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndimirirei,\" ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "\"zuva randichasimuka kuti ndigopupura.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "Ndafunga kuunganidza ndudzi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "kuunganidza ushe hwose",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "uye nokudurura hasha dzangu pavari,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "kutsamwa kukuru kwangu kwose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "Nyika yose ichaparadzwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:8"
      },
      "items": [
        {
          "text": "nomoto wegodo rokutsamwa kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.8",
            "verseOrgIds": [
              "ZEP.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo ndichachenesa miromo yavanhu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:9"
      },
      "items": [
        {
          "text": "kuti vose zvavo vadane kuzita raJehovha",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:9"
      },
      "items": [
        {
          "text": "uye vamushumire nomwoyo mumwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva mhiri kwenzizi dzeEtiopia vanamati vangu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
            "verseOrgIds": [
              "ZEP.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 3:10"
