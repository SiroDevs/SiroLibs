  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1JN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutenda kuMwanakomana waMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe anotenda kuti Jesu ndiye Kristu, akaberekwa naMwari, uye mumwe nomumwe anoda baba anodawo mwana wavo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.1",
            "verseOrgIds": [
              "1JN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvatinoziva nazvo kuti tinoda vana vaMwari: kana tichida Mwari uye tichiita mirayiro yake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.2",
            "verseOrgIds": [
              "1JN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ndiko kuda Mwari: kuteerera mirayiro yake. Uye mirayiro yake hairemi,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vose vakaberekwa naMwari vanokunda nyika. Uku ndiko kukunda kwakakunda nyika, iko kutenda kwedu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.4",
            "verseOrgIds": [
              "1JN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko anokunda nyika? Ndiye chete anotenda kuti Jesu ndiye Mwanakomana waMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiye akauya nemvura neropa, Jesu Kristu. Haana kuuya nemvura bedzi, asi nemvura neropa. Uye Mweya ndiye anopupura, nokuti Mweya ndiye chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.6",
            "verseOrgIds": [
              "1JN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kune zvitatu zvinopupura zvinoti:",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.7",
            "verseOrgIds": [
              "1JN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya, mvura, neropa; uye zvitatu izvi zvinotenderana.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.8",
            "verseOrgIds": [
              "1JN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinogamuchira uchapupu hwavanhu, asi uchapupu hwaMwari hukuru nokuti ndihwo uchapupu hwaMwari, hwaakapa pamusoro poMwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.9",
            "verseOrgIds": [
              "1JN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu mumwe nomumwe anotenda muMwanakomana waMwari ano uchapupu uhu mumwoyo make. Munhu mumwe nomumwe asingatendi Mwari, akabva amuita murevi wenhema, nokuti haana kutenda kupupura kwaMwari kwaakaita pamusoro poMwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.10",
            "verseOrgIds": [
              "1JN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye uku ndiko kupupura kuti: Mwari akatipa upenyu husingaperi, uye upenyu uhu huri muMwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.11",
            "verseOrgIds": [
              "1JN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo ano Mwanakomana ano upenyu; uyo asina Mwanakomana waMwari haana upenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.12",
            "verseOrgIds": [
              "1JN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mashoko Okupedzisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndanyora izvi kwamuri imi munotenda muzita roMwanakomana waMwari kuitira kuti muzive kuti mune upenyu husingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.13",
            "verseOrgIds": [
              "1JN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiko kusatya kwatinako mukuswedera kwedu kuna Mwari: kuti kana tichikumbira chinhu chipi nechipi nokuda kwake, anotinzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.14",
            "verseOrgIds": [
              "1JN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana tichiziva kuti anotinzwa pazvose zvatinokumbira, tinoziva kuti tava nazvo zvatakumbira kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akaona hama yake ichiita chivi chisingaurayisi, anofanira kunyengetera uye Mwari achamupa upenyu. Ndinoreva vaya vane chivi chisingaurayisi. Pane chivi chinourayisa. Handirevi kuti anyengetere pamusoro pacho.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.16",
            "verseOrgIds": [
              "1JN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuita chakaipa kwose chivi, uye pane chivi chisingaurayisi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.17",
            "verseOrgIds": [
              "1JN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinoziva kuti mumwe nomumwe akaberekwa naMwari haarambi achiita chivi; uyo akaberekwa naMwari anomuchengeta zvakanaka, uye akaipa haagoni kumukuvadza.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinoziva kuti tiri vana vaMwari, uye kuti nyika yose iri pasi powakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinozivawo kuti Mwanakomana waMwari akauya akatipa kunzwisisa, kuitira kuti timuzive iye wechokwadi. Uye tiri maari iye wechokwadi, kunyange muMwanakomana wake Jesu Kristu. Ndiye Mwari wechokwadi noupenyu husingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.20",
            "verseOrgIds": [
              "1JN.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana vanodikanwa, ibvai pazvifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.21",
            "verseOrgIds": [
              "1JN.5.21"
            ]
          }
        }
      ]
    }
  ],
