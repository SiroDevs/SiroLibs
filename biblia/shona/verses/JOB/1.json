  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JOB 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mavambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyika yeUzi maiva nomumwe murume ainzi Jobho. Murume uyu akanga asina chaangapomerwa uye akarurama; aitya Mwari uye ainzvenga zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.1",
            "verseOrgIds": [
              "JOB.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga ana vanakomana vanomwe navanasikana vatatu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.2",
            "verseOrgIds": [
              "JOB.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akanga ana makwai zviuru zvinomwe, ngamera zviuru zvitatu, nenzombe dzairingana majoko mazana mashanu, uye mazana mashanu embongoro hadzi, navaranda vakawanda kwazvo. Akanga ari munhu mukuru kuna vose pakati pavanhu vokumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.3",
            "verseOrgIds": [
              "JOB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vake vaisiita madzoro okuita mutambo mudzimba dzavo, uye vaikokawo hanzvadzi dzavo nhatu kuzodya nokunwa pamwe chete navo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.4",
            "verseOrgIds": [
              "JOB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva yomutambo yapera, Jobho aituma nhume kundovadana kuti vazonatswa. Aimuka mangwanani-ngwanani achibayira mwana mumwe nomumwe chipiriso chinopiswa, achiti, \"Zvichida vana vangu vakatadza uye vakatuka Mwari mumwoyo yavo.\" Aya ndiwo aiva maitiro aJobho nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.5",
            "verseOrgIds": [
              "JOB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuedzwa kwaJobho kwoKutanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino rimwe zuva vatumwa vakauya kuzomira pamberi paJehovha, naSataniwo akasvika pamwe chete navo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.6",
            "verseOrgIds": [
              "JOB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Satani, \"Wabvepiko?\" Satani akapindura Jehovha akati, \"Ndabva pakupota-pota nenyika napakukwidza nokudzika mairi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.7",
            "verseOrgIds": [
              "JOB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Satani, \"Warangarira muranda wangu Jobho here? Hakuna munhu akafanana naye panyika, haana chaanopomerwa uye akarurama, munhu anotya Mwari uye anonzvenga chakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akati, \"Ko, Jobho anongotya Mwari pasina here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hamuna kumupoteredza noruzhowa iye neimba yake nezvose zvaanazvo here? Makaropafadza basa ramaoko ake, uye pfuma yake yakatekeshera munyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi tambanudzai henyu ruoko rwenyu murove zvose zvaanazvo, zvirokwazvo achakutukai pachena.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Satani, \"Saka zvakanaka, zvose zvaanazvo zviri mumaoko ako, asi iye usamubata.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 1:12"
      },
      "items": [
        {
          "text": "Ipapo Satani akabva pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva vanakomana vaJobho navanasikana vake vakati vachidya uye vachinwa waini vari paimba yomukoma wavo mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nhume yakasvika kuna Jobho ikati, \"Nzombe dzanga dzichirima uye mbongoro dzanga dzichifura nechapedyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaSebhia vakarwisa vakazvitora vakaenda nazvo. Vauraya varanda nomunondo ini ndoga ndini ndapunyuka kuti ndizokuzivisai!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kutaura kudaro, imwe nhume yakasvika ikati, \"Moto waMwari waburuka kudenga ukapisa makwai navaranda, uye ini ndoga ndini ndapunyuka kuti ndizokuzivisai!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kutaura kudaro, imwe nhume yakasvika ikati, \"VaKaradhea vaita mapoka matatu okupamba vakatora ngamera dzenyu vakaenda nadzo. Vauraya varanda venyu nomunondo, uye ini ndoga ndini ndapunyuka kuti ndizokuzivisai!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kutaura kudaro, imwezve nhume yakasvika ikati, \"Vanakomana venyu navanasikana venyu vanga vachidya nokunwa waini vari mumba momukoma wavo mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakarepo mhepo huru yavhuvhuta ichibva kugwenga ikarova makona mana eimba. Yawira pamusoro pavo uye vafa, uye ini ndoga ndini ndasara kuti ndizokuzivisai!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jobho akasimuka ndokubvarura nguo dzake akaveura musoro wake. Ipapo akawira pasi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.20",
            "verseOrgIds": [
              "JOB.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanamata achiti:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "text": "\"Ndakabuda mudumbu ramai vangu ndiri mushwi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "text": "uye ndichadzokera ndiri mushwi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "text": "Jehovha akapa uye Jehovha akatora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 1:21"
      },
      "items": [
        {
          "text": "Zita raJehovha ngarirumbidzwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.21",
            "verseOrgIds": [
              "JOB.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazvinhu izvi zvose, Jobho haana kutadza kana kupa Mwari mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.22",
            "verseOrgIds": [
              "JOB.1.22"
            ]
          }
        }
      ]
    }
  ],
