          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganda rangu riri kusviba uye riri kufunuka;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
