      "attrs": {
        "style": "q2",
        "vid": "JOB 30:30"
      },
      "items": [
        {
          "text": "muviri wangu unopisa nefivha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.30",
            "verseOrgIds": [
              "JOB.30.30"
            ]
          }
