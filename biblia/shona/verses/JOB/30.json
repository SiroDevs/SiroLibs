          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumonyoroka kwoura hwangu hakumbomiri;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
          }
        }
      ]
    },
