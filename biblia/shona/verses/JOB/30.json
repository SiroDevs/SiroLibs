      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:28"
      },
      "items": [
        {
          "text": "ndinosimuka pakati peungano ndichichemera rubatsiro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.28",
            "verseOrgIds": [
              "JOB.30.28"
            ]
          }
        }
      ]
    },
    {
