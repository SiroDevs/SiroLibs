          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinodzungaira ndichisvibiswa, asi kwete nezuva;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.28",
            "verseOrgIds": [
              "JOB.30.28"
            ]
          }
        }
