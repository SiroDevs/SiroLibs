          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndava hama yamakava,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
