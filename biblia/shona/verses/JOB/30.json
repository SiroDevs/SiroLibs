      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:24"
      },
      "items": [
        {
          "text": "paanochemera rubatsiro pakutambudzika kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.24",
            "verseOrgIds": [
              "JOB.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, handina kuchema nokuda kwevaitambura here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:25"
      },
      "items": [
        {
          "text": "Ko, mweya wangu hauna kuva neshungu pamusoro pavarombo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.25",
            "verseOrgIds": [
              "JOB.30.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
