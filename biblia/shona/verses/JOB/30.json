            "sid": "JOB 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, pandakanga ndakarindira zvakanaka, zvakaipa zvakasvika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:26"
      },
      "items": [
        {
          "text": "pandakatarisira chiedza, ipapo rima rakasvika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.26",
            "verseOrgIds": [
              "JOB.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
