      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:29"
      },
      "items": [
        {
          "text": "neshamwari yamazizi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.29",
            "verseOrgIds": [
              "JOB.30.29"
            ]
          }
        }
      ]
    },
    {
