      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 30:27"
      },
      "items": [
        {
          "text": "mazuva okutambudzika anondivinga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.30.27",
            "verseOrgIds": [
              "JOB.30.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
