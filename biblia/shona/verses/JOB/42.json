    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Jobho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jobho akapindura kuna Jehovha akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinoziva kuti imi munogona kuita zvose;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:2"
      },
      "items": [
        {
          "text": "hapana urongwa hwenyu hungakoneswa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.2",
            "verseOrgIds": [
              "JOB.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabvunza kuti, 'Ndianiko uyu anodzikatira zano rangu iye asina zivo?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "Zvirokwazvo ndakataura pamusoro pezvinhu zvandisinganzwisisi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:3"
      },
      "items": [
        {
          "text": "zvinhu zvinoshamisa kwazvo kuti ini ndizvizive.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.3",
            "verseOrgIds": [
              "JOB.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mati imi, 'Chinzwa zvino,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "uye ini ndichataura; ndichakubvunza iwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:4"
      },
      "items": [
        {
          "text": "uye iwe uchandipindura.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.4",
            "verseOrgIds": [
              "JOB.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzeve dzangu dzakanga dzanzwa nezvenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:5"
      },
      "items": [
        {
          "text": "asi zvino meso angu akuonai imi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.5",
            "verseOrgIds": [
              "JOB.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndinozvishora pachangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 42:6"
      },
      "items": [
        {
          "text": "uye ndinotendeuka hangu muguruva nomumadota.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magumo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati areva zvinhu izvi kuna Jobho, akati kuna Erifazi muTemani, \"Ndakakutsamwira iwe neshamwari dzako mbiri, nokuti hamuna kutaura zvakarurama pamusoro pangu, sezvakaitwa nomuranda wangu Jobho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino chitorai hando nomwe namakondobwe manomwe mugoenda kumuranda wangu Jobho mundozvibayira sechipiriso chenyu chinopiswa. Muranda wangu Jobho achakunyengetererai, uye ini ndichagamuchira munyengetero wake ndigorega kukuitirai zvakafanira upenzi hwenyu. Hamuna kutaura zvakarurama pamusoro pangu, somuranda wangu Jobho.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Erifazi muTemani, Bhiridhadhi muShuhi naZofari muNamaati vakaita zvavakaudzwa naJehovha; uye Jehovha akagamuchira munyengetero waJobho.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge Jobho anyengeterera shamwari dzake, Jehovha akaita kuti abudirirezve akamupa zvakapetwa kaviri kupfuura zvaakanga anazvo kare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanunʼuna vake vose nehanzvadzi dzake navose vaimuziva vakauya vakadya pamwe chete naye mumba make. Vakamuvaraidza uye vakamunyaradza pamusoro pamatambudziko akanga aiswa naJehovha pamusoro pake, uye mumwe nomumwe wavo akamupa chidimbu chesirivha nemhete yegoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akaropafadza kupedzisira kwoupenyu hwaJobho kupfuura kutanga. Akanga ana makwai zviuru gumi nezvina, zviuru zvitanhatu zvengamera, nenzombe dzingasungwa pamajoko chiuru nembongoro chiuru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akazovawo navanakomana vanomwe navanasikana vatatu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanasikana wake wokutanga akamutumidza zita rokuti Jemima, wechipiri akamuti Kezia uye wechitatu akamutumidza kuti Kereni-Hapuki.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyika yose hapana kuwanikwa vakadzi vakanaka kupinda vanasikana vaJobho, uye baba vavo vakavapa nhaka pamwe chete nehanzvadzi dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi, akazorarama makore zana namakumi mana; akaona vana vake navana vavana vake kusvikira parudzi rwechina.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro akafa, akwegura ava namakore mazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
