  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "JOB 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jobho akapfuurira mberi nokutaura achiti:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.1",
            "verseOrgIds": [
              "JOB.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvirokwazvo naMwari mupenyu, iye akaramba kundiruramisira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:2"
      },
      "items": [
        {
          "text": "iye Wamasimba Ose, akaita kuti ndinzwe shungu pamwoyo wangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.2",
            "verseOrgIds": [
              "JOB.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "chero ndichine upenyu mandiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:3"
      },
      "items": [
        {
          "text": "ndichine kufema kwaMwari mumhino dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.3",
            "verseOrgIds": [
              "JOB.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "miromo yangu haingatauri zvakashata,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:4"
      },
      "items": [
        {
          "text": "uye rurimi rwangu harungatauri nokunyengera.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.4",
            "verseOrgIds": [
              "JOB.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handingambobvumi kuti muri kutaura chokwadi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:5"
      },
      "items": [
        {
          "text": "kusvikira ndafa, handizorambi kururama kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.5",
            "verseOrgIds": [
              "JOB.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichachengetedza kururama kwangu uye handingakuregedzi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:6"
      },
      "items": [
        {
          "text": "hana yangu haingandipi mhosva ndichiri mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.6",
            "verseOrgIds": [
              "JOB.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vavengi vangu ngavaite savakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:7"
      },
      "items": [
        {
          "text": "navadzivisi vangu savasakarurama!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.7",
            "verseOrgIds": [
              "JOB.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, munhu asina Mwari ane tariro yeiko kana afa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:8"
      },
      "items": [
        {
          "text": "Mwari paanotora upenyu hwake?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.8",
            "verseOrgIds": [
              "JOB.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, Mwari anoteerera kuchema kwake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:9"
      },
      "items": [
        {
          "text": "paanowirwa nenhamo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.9",
            "verseOrgIds": [
              "JOB.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye angawana mufaro muna Wamasimba Ose here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:10"
      },
      "items": [
        {
          "text": "Ko, achadana kuna Mwari panguva dzose here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.10",
            "verseOrgIds": [
              "JOB.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichakudzidzisai nezvesimba raMwari;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:11"
      },
      "items": [
        {
          "text": "nzira dzaWamasimba Ose handingadzivanzi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.11",
            "verseOrgIds": [
              "JOB.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mose makazviona izvi pachenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:12"
      },
      "items": [
        {
          "text": "Zvino munotaurireiko zvisina maturo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.12",
            "verseOrgIds": [
              "JOB.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haano magumo anogoverwa vakaipa naMwari,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:13"
      },
      "items": [
        {
          "text": "iyo nhaka inogamuchirwa navanhu vano utsinye, kubva kuna Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.13",
            "verseOrgIds": [
              "JOB.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvinei kuti vana vake vakawanda sei, magumo avo munondo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:14"
      },
      "items": [
        {
          "text": "zvizvarwa zvake hazvizombowani zvokudya zvakakwana.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.14",
            "verseOrgIds": [
              "JOB.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denda richaviga vaya vanenge vasara,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:15"
      },
      "items": [
        {
          "text": "uye chirikadzi dzavo hadzingavachemi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.15",
            "verseOrgIds": [
              "JOB.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange akaunganidza sirivha seguruva,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:16"
      },
      "items": [
        {
          "text": "uye zvokupfeka zvikaita somurwi wevhu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.16",
            "verseOrgIds": [
              "JOB.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvaanowana zvichapfekwa navakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:17"
      },
      "items": [
        {
          "text": "uye vasina mhaka vachagovana sirivha yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.17",
            "verseOrgIds": [
              "JOB.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imba yaanovaka yakaita sedende rechipfukuto,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:18"
      },
      "items": [
        {
          "text": "sechirindo chakaitwa nomurindi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.18",
            "verseOrgIds": [
              "JOB.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anovata pasi akapfuma, asi haachazviitizve;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 27:19"
      },
      "items": [
        {
          "text": "paanosvinura meso ake, wanei zvose zvaenda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.27.19",
            "verseOrgIds": [
              "JOB.27.19"
            ]
          }
