    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Bhiridhadhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Bhiridhadhi muShuhi akapindura akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.1",
            "verseOrgIds": [
              "JOB.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muchapedza kutaura uku riiniko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:2"
      },
      "items": [
        {
          "text": "Chimbonyatsofungai, ipapo tigotaurirana hedu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinobatirweiko semombe",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:3"
      },
      "items": [
        {
          "text": "uye tichionekwa samapenzi pamberi penyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyewe unozvibvamburanya mukutsamwa kwako,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "nyika ingasiyiwa nokuda kwako here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "Kana matombo angafanira kubviswa panzvimbo yawo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwenje weakaipa unodzimwa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:5"
      },
      "items": [
        {
          "text": "murazvo womoto wake unopera kupisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiedza chiri mutende rake chinova rima;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:6"
      },
      "items": [
        {
          "text": "mwenje uri parutivi pake unodzima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba renhambwe dzake rinorukutika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:7"
      },
      "items": [
        {
          "text": "mano ake pachake anomuwisira pasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka dzake dzinomuwisira mumumbure,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:8"
      },
      "items": [
        {
          "text": "uye anodzungaira ari mumaburi awo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musungo unomubata chitsitsinho;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:9"
      },
      "items": [
        {
          "text": "rugombe runomubatisisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chishwe chakavanzwa muvhu nokuda kwake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:10"
      },
      "items": [
        {
          "text": "musungo wakaradzikwa munzira yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyisa kunomuvhundutsa kumativi ose,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:11"
      },
      "items": [
        {
          "text": "uye kunomuteverera panhambwe dzake dzose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfumvu inomudokwairira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:12"
      },
      "items": [
        {
          "text": "njodzi yakamugaririra paanowa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inodya zvikamu zveganda rake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:13"
      },
      "items": [
        {
          "text": "dangwe rorufu rinopedza mitezo yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anodzurwa kubva patende raanovimba naro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:14"
      },
      "items": [
        {
          "text": "agoendeswa kuna mambo anotyisa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto unogara mutende rake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:15"
      },
      "items": [
        {
          "text": "safuri inopisa inoparadzirwa pamusoro pougaro hwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto unogara mutende rake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:16"
      },
      "items": [
        {
          "text": "uye matavi ake anosvava kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurangarirwa kwake kunopera panyika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:17"
      },
      "items": [
        {
          "text": "haana zita munyika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anobviswa pachiedza achiendeswa murima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:18"
      },
      "items": [
        {
          "text": "uye anodzingwa panyika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana mwana kana chizvarwa chinotevera pakati pavanhu vokwake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.19",
            "verseOrgIds": [
              "JOB.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:19"
      },
      "items": [
        {
          "text": "hakuna akasara kwaaimbogara.",
          "type": "text",
          "attrs": {
