        "style": "q2",
        "vid": "JOB 24:19"
      },
      "items": [
        {
          "text": "saizvozvo guva rinobvuta vaya vakatadza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
