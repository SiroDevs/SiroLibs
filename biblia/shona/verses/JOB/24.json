      "attrs": {
        "style": "q2",
        "vid": "JOB 24:18"
      },
      "items": [
        {
          "text": "mugove wavo wenyika wakatukwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
