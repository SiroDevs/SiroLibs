          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndinongotya kutambura kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.28",
            "verseOrgIds": [
              "JOB.9.28"
            ]
          }
        }
      ]
