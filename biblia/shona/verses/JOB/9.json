          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ndikati, 'Ndichakanganwa kunyunyuta kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.27",
            "verseOrgIds": [
              "JOB.9.27"
            ]
          }
        }
      ]
    },
