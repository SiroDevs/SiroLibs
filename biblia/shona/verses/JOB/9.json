        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana dambudziko rikauyisa rufu nokukurumidza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.23",
            "verseOrgIds": [
              "JOB.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:23"
      },
      "items": [
        {
          "text": "achaseka kushaya tariro kwavasina mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.23",
            "verseOrgIds": [
              "JOB.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
