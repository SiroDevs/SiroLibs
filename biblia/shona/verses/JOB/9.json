          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo ndatopiwa hangu mhosva,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.29",
            "verseOrgIds": [
              "JOB.9.29"
            ]
          }
        }
      ]
    },
