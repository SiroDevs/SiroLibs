      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:29"
      },
      "items": [
        {
          "text": "ko, ndichagotamburirei pasina?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.29",
            "verseOrgIds": [
              "JOB.9.29"
            ]
          }
        }
      ]
    },
