      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:26"
      },
      "items": [
        {
          "text": "kufanana namakondo anomhanyira nyama yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.26",
            "verseOrgIds": [
              "JOB.9.26"
            ]
          }
        }
      ]
    },
    {
