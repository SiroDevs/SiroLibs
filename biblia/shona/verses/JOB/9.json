          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panowira nyika mumaoko avakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
