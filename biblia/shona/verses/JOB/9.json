        "style": "q2",
        "vid": "JOB 9:33"
      },
      "items": [
        {
          "text": "kuti aise ruoko rwake patiri tose,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.33",
            "verseOrgIds": [
              "JOB.9.33"
            ]
          }
