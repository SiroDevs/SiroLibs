          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange dai ndisina mhosva, muromo wangu waizongondipa mhaka;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.20",
            "verseOrgIds": [
              "JOB.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:20"
      },
      "items": [
        {
          "text": "dai zvangu ndakarurama, iwo waizongondipa mhaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.20",
            "verseOrgIds": [
              "JOB.9.20"
            ]
          }
        }
      ]
    },
    {
