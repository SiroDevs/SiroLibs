          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunyange ndisina mhosva,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
