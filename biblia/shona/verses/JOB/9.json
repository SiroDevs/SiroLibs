      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:21"
      },
      "items": [
        {
          "text": "handina hangu hanya nazvo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:21"
      },
      "items": [
        {
          "text": "ndinozvidza upenyu hwangu pachangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
