            "sid": "JOB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mazuva angu anokurumidza kupfuura mumhanyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.25",
            "verseOrgIds": [
              "JOB.9.25"
            ]
          }
        }
      ]
