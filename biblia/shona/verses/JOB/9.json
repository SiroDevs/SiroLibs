      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:24"
      },
      "items": [
        {
          "text": "vatongi vayo anovapofumadza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:24"
      },
      "items": [
        {
          "text": "Kana asiri iye, zvino ndianiko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
