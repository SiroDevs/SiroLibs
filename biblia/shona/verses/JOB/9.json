      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:27"
      },
      "items": [
        {
          "text": "ndichashandura chiso changu, ndigonyemwerera,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.27",
            "verseOrgIds": [
              "JOB.9.27"
            ]
          }
        }
      ]
    },
    {
