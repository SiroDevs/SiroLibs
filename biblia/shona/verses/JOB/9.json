      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:25"
      },
      "items": [
        {
          "text": "anobhururuka oenda asina kumboona mufaro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.25",
            "verseOrgIds": [
              "JOB.9.25"
            ]
          }
        }
      ]
    },
