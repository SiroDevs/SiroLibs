            "sid": "JOB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakangofanana; ndokusaka ndichiti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.22",
            "verseOrgIds": [
              "JOB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:22"
      },
      "items": [
        {
          "text": "'Iye anoparadza vasina mhosva nevakaipa.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.22",
            "verseOrgIds": [
              "JOB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
