      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:30"
      },
      "items": [
        {
          "text": "uye ndikashamba maoko angu nesoda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.30",
            "verseOrgIds": [
              "JOB.9.30"
            ]
          }
        }
      ]
    },
