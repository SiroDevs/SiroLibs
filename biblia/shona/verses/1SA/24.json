  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "1SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anorega kuuraya Sauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokudzoka kwaSauro kundodzinganisa vaFiristia, akaudzwa kuti, \"Dhavhidhi ari muRenje reEni Gedhi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.1",
            "verseOrgIds": [
              "1SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Sauro akatora zviuru zvavarume vakatsaurwa kubva muIsraeri yose akasimuka akaenda kundotsvaka Dhavhidhi navanhu vake pedyo naMatombo eNgururu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.2",
            "verseOrgIds": [
              "1SA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasvika pamatanga amakwai munzira iyoyo; pakanga pane bako, uye Sauro akapindamo kuti azorore. Dhavhidhi navanhu vake vakanga vari mukati kati mebako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.3",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakati, \"Iri ndiro zuva rakataurwa naJehovha paakati kwamuri, 'Ndichaisa vavengi vako mumaoko ako kuti uvaitire sezvaunoda.' \" Ipapo Dhavhidhi akakambaira chinyararire asingaonekwi akacheka kona yenguo yaSauro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo Dhavhidhi akarohwa nehana nokuda kwokuti akanga acheka kona yenguo yaSauro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.5",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuvanhu vake, \"Jehovha ngaandidzivise kuti ndirege kuita chinhu chakadai kuna tenzi wangu, muzodziwa waJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namashoko aya Dhavhidhi akatsiura vanhu vake akasavatendera kuti varwise Sauro. Zvino Sauro akabva pabako akaenda hake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akabuda mubako akadanidzira kuna Sauro achiti, \"Ishe wangu mambo!\" Sauro akati acheuka, Dhavhidhi akakotamira pasi nechiso chake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.8",
            "verseOrgIds": [
              "1SA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuna Sauro, \"Sei muchiteerera vanhu pavanoti, 'Dhavhidhi anotsvaka kukukuvadzai?'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.9",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhasi mazvionera nameso enyu kuti Jehovha akuisai sei mumaoko angu muri mubako. Vamwe vandikurudzira kuti ndikuurayei, asi ndakuregererai, ndikati, 'Handingasimudzi ruoko rwangu pamusoro patenzi wangu, nokuti ndiye muzodziwa waJehovha.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai, baba vangu, tarirai benga renguo yenyu riri muruoko rwangu! Ndacheka kona yenguo yenyu asi handina kukuurayai. Zvino chinzwisisai muzive kuti handina mhosva yokukuitirai zvakaipa kana kukumukirai. Handina kukutadzirai, asi imi muri kundivhima kuti mundiuraye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.11",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ngaatonge pakati penyu nemi. Uye Jehovha ngaatsive zvakaipa zvamakaita kwandiri, asi ruoko rwangu harungarwi nemi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvinoreva tsumo yekare ichiti, 'Kuno wakaipa kunobuda mabasa akaipa,' saizvozvo ruoko rwangu harungarwi nemi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.13",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ko, mambo waIsraeri akabuda kuzorwa naaniko? Ndianiko wamunodzinganisa? Imbwa yakafa here? Nhata here?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ngaave mutongi wedu uye aone pakati penyu neni. Ngaatsvake mhaka yangu aiwane; ngaandiruramisire nokundirwira kubva muruoko rwenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati apedza kutaura mashoko aya, Sauro akabvunza akati, \"Inzwi rako here, Dhavhidhi mwanakomana wangu?\" Ipapo akachema kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
              "1SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Iwe wakarurama kupfuureni. Iwe wakandiitira zvakanaka, asi ini ndakakuitira zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchangobva kundirondedzera iye zvino zvakanaka zvawakandiitira; Jehovha akandiisa mumaoko ako, asi hauna kundiuraya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akawanikidza muvengi wake angamurega achienda asina vanga here? Jehovha ngaakuripire zvakanaka nokuda kwezvawakandiitira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoziva zvirokwazvo kuti iwe uchava mambo uye umambo hweIsraeri huchasimbiswa mumaoko ako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pika kwandiri naJehovha kuti iwe hauchazoparadzi zvizvarwa zvangu kana kuparadza zita rangu kubva pamhuri yababa vangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akapika kuna Sauro. Ipapo Sauro akadzokera kumusha kwake, asi Dhavhidhi navanhu vake vakaenda kunhare yavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.22",
            "verseOrgIds": [
              "1SA.24.23"
            ]
          }
        }
      ]
    }
  ],
