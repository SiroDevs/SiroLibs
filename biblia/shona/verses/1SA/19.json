  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1SA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauro anoedza kuuraya Dhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akataurira mwanakomana wake Jonatani navaranda vake vose kuti vauraye Dhavhidhi. Asi Jonatani aida Dhavhidhi zvikuru",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamuudza akati, \"Baba vangu Sauro vari kutsvaka mukana wokukuuraya. Ungware, mangwana mangwanani; uende undovanda uye ugare ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndichabuda ndigondomira nababa vangu mumunda maunenge uri. Ndichataura navo pamusoro pako ndigozokuudza zvandinenge ndaona.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani akataura zvakanaka pamusoro paDhavhidhi kuna Sauro baba vake akati kwavari, \"Mambo ngaarege kuita zvakaipa kumuranda wake Dhavhidhi; haana kukutadzirai, uye zvaakaita zvakakubatsirai zvikuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.4",
            "verseOrgIds": [
              "1SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabata upenyu hwake mumaoko ake paakauraya muFiristia. Jehovha akakundira vaIsraeri vose nokukunda kukuru, uye imi makazviona mukafara. Zvino munoitireiko zvakaipa kumunhu asina mhosva saDhavhidhi nokumuuraya pasina chikonzero?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.5",
            "verseOrgIds": [
              "1SA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akateerera kuna Jonatani akaita mhiko iyi achiti, \"Zvirokwazvo naJehovha mupenyu, Dhavhidhi haangaurayiwi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.6",
            "verseOrgIds": [
              "1SA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jonatani akadana Dhavhidhi sapamazuva akare akamuudza zvose zvavakanga vataurirana. Akauya naye kuna Sauro, uye Dhavhidhi akava naSauro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hondo yakavapozve, Dhavhidhi akabuda akaenda akandorwa navaFiristia. Akavauraya nokuuraya kukuru zvokuti vakatiza pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mweya wakaipa wakabva kuna Jehovha wakauya pamusoro paSauro paakanga agere mumba make ane pfumo rake muruoko rwake. Dhavhidhi paakanga achiridza mbira,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akaedza kumubayira kumadziro nepfumo rake, asi Dhavhidhi akamunzvenga Sauro akabayira pfumo mukati mamadziro. Usiku ihwohwo Dhavhidhi akatiza, akapunyuka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akatuma vanhu kumba kwaDhavhidhi kuti vairinde uye kuti vamuuraye mangwanani. Asi Mikari, mukadzi waDhavhidhi, akamuudza kuti, \"Kana ukasatiza noupenyu hwako manheru ano, mangwana uchaurayiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.11",
            "verseOrgIds": [
              "1SA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mikari akaburutsa Dhavhidhi napawindo, iye akatiza akapunyuka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.12",
            "verseOrgIds": [
              "1SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mikari akatora chidhori akachiradzika pamubhedha, akachifukidza nejira akaisa mvere dzembudzi kumusoro wacho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati atuma vanhu kundobata Dhavhidhi, Mikari akati, \"Ari kurwara.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akadzorera vanhu kwakare kuti vandoona Dhavhidhi akataura kwavari akati, \"Uyai naye kuno kwandiri ari pamubhedha wake kuti ndigomuuraya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi varume vakati vapinda, vakaona kuti pakanga pane chidhori pamubhedha, uye kuti pamusoro wacho paiva nemvere dzembudzi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati kuna Mikari, \"Seiko wakandinyengera kudai uchiendesa muvengi wangu kure kuti apunyuke?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 19:17"
      },
      "items": [
        {
          "text": "Mikari akamuudza kuti, \"Iye ati kwandiri, 'Ndirege ndiende hangu. Ndichakuurayireiko iwe?' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati atiza, apunyuka, akaenda kuna Samueri kuRama akamuudza zvose zvakanga zvaitwa kwaari naSauro. Ipapo iye naSamueri vakaenda kuNayoti vakandogarako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko rakasvika kuna Sauro richiti, \"Dhavhidhi ari kuNayoti paRama.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akatuma vanhu kundomubata. Asi vakati vaona boka ravaprofita vachiprofita, naSamueri amire ipapo somutungamiri wavo, Mweya waMwari wakauya pamusoro pavanhu vaSauro, naivowo vakaprofita.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akaudzwa nezvazvo, akatumazve vamwe varume, naivowo vakaprofita.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira, iye akaendawo kuRama akaenda kutsime guru rapaSeku. Zvino akabvunza akati, \"Samueri naDhavhidhi varipiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 19:22"
      },
      "items": [
        {
          "text": "Ivo vakati, \"Uko kuNayoti paRama.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Sauro akaenda kuNayoti paRama. Asi Mweya waMwari wakauya kunyange pamusoro pake, akafamba achiprofita kusvikira kuNayoti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.23",
            "verseOrgIds": [
              "1SA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa nguo dzake akaprofitawo pamberi paSamueri uye akavata pasi akashama zuva rose nousiku hwose. Naizvozvo vanhu vanoti, \"NaSaurowo ari pakati pavaprofita here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.24",
            "verseOrgIds": [
              "1SA.19.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1SA.20",
    "number": "20",
