  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "EPH 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Takaitwa vapenyu muna Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muri imi, makanga makafa mukudarika kwenyu nomuzvivi,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.1",
            "verseOrgIds": [
              "EPH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "izvo zvamaigara mazviri pamaitevera nzira dzenyika ino uye nedzomutongi woushe hwomuchadenga, iwo mweya unoshanda zvino muna avo vasingateereri.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu tose taigara pakati pavo pane imwe nguva, tichikudza kuchiva kwenyama yedu yezvivi uye tichitevera zvido zvedu nezvataifunga. Sezvakangoita vamwe vose, pakuzvarwa kwedu takanga tiri vana vokutsamwirwa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nokuda kworudo rwake rukuru kwatiri, Mwari, iye akapfuma pangoni,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.4",
            "verseOrgIds": [
              "EPH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatiita vapenyu muna Kristu kunyange zvedu takanga takafa mukudarika kwedu, makaponeswa nenyasha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
            "verseOrgIds": [
              "EPH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akatimutsa pamwe chete naKristu akatigarisa kudenga muna Kristu Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.6",
            "verseOrgIds": [
              "EPH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti munguva dzinouya aratidze pfuma yake huru yenyasha dzake, zvichiratidzwa muunyoro hwake kwatiri muna Kristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.7",
            "verseOrgIds": [
              "EPH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti makaponeswa nenyasha, kubudikidza nokutenda, uye izvi hazvibvi kwamuri, chipo chaMwari,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.8",
            "verseOrgIds": [
              "EPH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwete namabasa, kuti parege kuva nomunhu anozvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.9",
            "verseOrgIds": [
              "EPH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti tiri basa raMwari, rakasikwa muna Kristu Jesu kuti tiite mabasa akanaka, akagadzirwa naMwari kare kuti tiaite.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tiri vamwe chete muna Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, rangarirai kuti kare imi veDzimwe Ndudzi pakuzvarwa uye muchinzi \"vasina kudzingiswa\" naavo vaizviti \"vakadzingiswa\" (uko kunoitwa pamuviri namaoko avanhu),",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.11",
            "verseOrgIds": [
              "EPH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "rangarirai kuti panguva iyoyo makanga makaparadzaniswa naKristu, musingaverengwi muzvizvarwa zveIsraeri uye muri vatorwa musungano dzechipikirwa, musina tariro uye musina Mwari munyika.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.12",
            "verseOrgIds": [
              "EPH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino muna Kristu Jesu, imi makanga muri kure kare, makaswededzwa pedyo kubudikidza neropa raKristu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
            "verseOrgIds": [
              "EPH.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti iye pachake ndiye rugare rwedu, akaita kuti vaviri vave chinhu chimwe uye akaparadza mukaha, irwo rusvingo rwokuvengana rwaivaparadzanisa,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.14",
            "verseOrgIds": [
              "EPH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuparadza munyama yake murayiro, mitemo yacho pamwe chete uye nezvakatemwa. Vavariro yake yakanga iri yokusika maari munhu mumwe chete mutsva kubva pavaviri, naizvozvo aite rugare,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.15",
            "verseOrgIds": [
              "EPH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mumuviri mumwe chete uyu ayananise vaviri ava kuna Mwari kubudikidza nomuchinjikwa, wakaparadza kuvengana kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.16",
            "verseOrgIds": [
              "EPH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akauya akaparidza rugare kwamuri imi makanga muri kure uye rugare kuna avo vakanga vari pedyo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.17",
            "verseOrgIds": [
              "EPH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kubudikidza naye isu tose tinosvika kuna Baba noMweya mumwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.18",
            "verseOrgIds": [
              "EPH.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka, hamuchisiri vatorwa kana vaeni, asi vagari pamwe chete navanhu vaMwari uye mava veimba yaMwari,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.19",
            "verseOrgIds": [
              "EPH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "makavakwa panheyo dzavapostori navaprofita, naKristu Jesu pachake iye dombo rapakona.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.20",
            "verseOrgIds": [
              "EPH.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maari imba yose yakabatanidzwa pamwe chete uye inokura kuti ive temberi tsvene muna She.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.21",
            "verseOrgIds": [
              "EPH.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye maari nemiwo makavakwa pamwe chete kuti muve ugaro hwaMwari muMweya.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.22",
            "verseOrgIds": [
              "EPH.2.22"
            ]
          }
        }
      ]
    }
  ],
