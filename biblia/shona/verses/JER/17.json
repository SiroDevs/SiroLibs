      "attrs": {
        "style": "q2",
        "vid": "JER 17:12"
      },
      "items": [
        {
          "text": "ndicho nzvimbo yedu tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.12",
            "verseOrgIds": [
              "JER.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi Jehovha, tariro yaIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "vose vanokusiyai vachanyadziswa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "Vose vanotsauka kwamuri vachanyorwa muvhu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
