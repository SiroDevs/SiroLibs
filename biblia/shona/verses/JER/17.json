      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:11"
      },
      "items": [
        {
          "text": "uye pakupedzisira achazviona kuti ibenzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.11",
            "verseOrgIds": [
              "JER.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
