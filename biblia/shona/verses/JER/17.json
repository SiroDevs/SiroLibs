      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "nokuti vakasiya Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
