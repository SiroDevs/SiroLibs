          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chigaro choushe chinobwinya, chakanga chakasimudzirwa kubva pakutanga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.12",
