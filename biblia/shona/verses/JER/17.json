      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:13"
      },
      "items": [
        {
          "text": "chitubu chemvura mhenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.13",
            "verseOrgIds": [
              "JER.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, ndiporesei, ipapo ndichaporeswa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:14"
      },
      "items": [
        {
          "text": "ndiponesei, ipapo ndichaponeswa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:14"
      },
      "items": [
        {
          "text": "nokuti imi ndimi wandinorumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.14",
            "verseOrgIds": [
              "JER.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanogara vachiti kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:15"
      },
      "items": [
        {
          "text": "\"Shoko raJehovha riripiko?",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:15"
      },
      "items": [
        {
          "text": "Ngarizadziswe iye zvino!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.15",
            "verseOrgIds": [
              "JER.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina kutiza pakuva mufudzi wenyu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:16"
      },
      "items": [
        {
          "text": "munoziva kuti handina kushora zuva rokupera kwetariro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:16"
      },
      "items": [
        {
          "text": "Zvinobuda mumuromo mangu zviri pachena pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.16",
            "verseOrgIds": [
              "JER.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musava chinhu chinotyisa kwandiri;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.17",
            "verseOrgIds": [
              "JER.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:17"
      },
      "items": [
        {
          "text": "ndimi utiziro hwangu pazuva renjodzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.17",
            "verseOrgIds": [
              "JER.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatambudzi vangu ngavanyadziswe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:18"
      },
      "items": [
        {
          "text": "asi ini ndidzivirirei pakunyadziswa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:18"
      },
      "items": [
        {
          "text": "ngavavhunduswe ivo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:18"
      },
      "items": [
        {
          "text": "asi ini ndidzivirirei kuti ndisavhunduswa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:18"
      },
      "items": [
        {
          "text": "Uyisai pamusoro pavo zuva renjodzi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:18"
      },
      "items": [
        {
          "text": "vaparadzei nokuparadza kwakapetwa kaviri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuchengeta Sabata rive Dzvene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvakataurwa naJehovha kwandiri: \"Enda undomira pasuo ravanhu, panopinda nokubuda namadzimambo eJudha; ugondomirazve pane mamwe masuo ose eJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kwavari, 'Inzwai shoko raJehovha, imi madzimambo eJudha navanhu vose veJudha navose vanogara muJerusarema vanopinda napamasuo aya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha: Zvichenjererei kuti murege kutakura mutoro nomusi weSabata kana kuupinza napasuo reJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musabudisa mitoro mudzimba dzenyu kana kuita basa ripi neripi pazuva reSabata, asi chengetai zuva reSabata rive dzvene, sezvandakarayira madzitateguru enyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havana kunzwa kana kurereka nzeve dzavo; vakava nemitsipa mikukutu uye havana kumboteerera kana kugamuchira kurayirwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mukachenjerera kuti munditeerere, ndizvo zvinotaura Jehovha, mukasauya nemitoro napamasuo eguta iri nomusi weSabata, asi muchichengeta zuva reSabata kuti rive dzvene nokusaita basa ripi neripi pazuva iroro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo madzimambo anogara pachigaro choushe chaDhavhidhi vachauya napamasuo eguta namachinda avo. Ivo namachinda avo vachauya vakakwira ngoro namabhiza, vachiperekedzwa navarume veJudha navose vanogara muJerusarema, uye guta rino richagarwa nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.25",
            "verseOrgIds": [
              "JER.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vachauya kumaguta eJudha uye nokumisha yakapoteredza Jerusarema, kubva kunyika yeBhenjamini nokujinga rezvikomo zvokumavirira, nokunyika yemakomo uye nokuNegevhi, vachiuyisa zvipiriso zvinopiswa nezvibayiro, uye zvipiriso zvezviyo, nezvinonhuhwira nezvipo zvokuvonga kuimba yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mukarega kunditeerera kuti muchengete zuva reSabata kuti rive dzvene, musingaregi kutakura mutoro pamunopinda pamasuo eJerusarema nezuva reSabata, ipapo ndichabatidza moto usingadzimwe mumasuo eJerusarema uchapedza nharo dzaro.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.27",
            "verseOrgIds": [
              "JER.17.27"
            ]
          }
        }
      ]
    }
  ],
