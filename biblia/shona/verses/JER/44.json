  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "44",
        "style": "c",
        "sid": "JER 44"
      },
      "items": [
        {
          "text": "44",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njodzi nokuda kwoKunamata Zvifananidzo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko iri rakasvika kuna Jeremia pamusoro pavaJudha vose vakanga vagere zasi kweIjipiti, muMigidhori nomuTapanesi nomuNofi, nokumusoro kweIjipiti, richiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.1",
            "verseOrgIds": [
              "JER.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri: Makaona njodzi huru yandakauyisa pamusoro peJerusarema nomumaguta ose eJudha. Nhasi uno asiyiwa angova matongo",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.2",
            "verseOrgIds": [
              "JER.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuda kwezvakaipa zvavakaita. Vakanditsamwisa nokuda kwokupisira zvinonhuhwira uye nokunamata vamwe vamwari vavasina kumboziva ivo kana imi kana madzibaba enyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.3",
            "verseOrgIds": [
              "JER.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatuma ndatumazve varanda vangu vaprofita kuti vati, 'Regai kuita chinhu chinonyangadza chandinovenga!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.4",
            "verseOrgIds": [
              "JER.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havana kunzwa kana kuteerera: havana kudzoka kubva pane zvakaipa zvavo kana kurega kupisa zvinonhuhwira kuna vamwe vamwari.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.5",
            "verseOrgIds": [
              "JER.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo kutsamwa kwangu kunotyisa kwakadururwa; kukapisa maguta eJudha uye nenzira dzeJerusarema ndikazviparadza zvikava matongo sezvazvakaita nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.6",
            "verseOrgIds": [
              "JER.44.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino, zvanzi naJehovha, Wamasimba Ose, Mwari waIsraeri: Munouyisireiko njodzi yakakura kudai pamusoro penyu nokuparadzira kubva kuJudha varume navakadzi, navana, navacheche nokudaro muchisara musina kana nomumwe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.7",
            "verseOrgIds": [
              "JER.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munonditsamwisireiko nezvamunoita namaoko enyu, muchipisira zvinonhuhwira kuna vamwe vamwari vomuIjipiti kwamakaenda kundogara? Muchazviparadza pachenyu mukazviita chinhu chinotukwa nechinozvidzwa pakati pendudzi dzose dzepanyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.8",
            "verseOrgIds": [
              "JER.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makanganwa here zvakashata zvakaitwa namadzibaba enyu namadzimambo navanamambokadzi veJudha uye zvakashata zvakaitwa nemi navakadzi venyu munyika yeJudha nomunzira dzeJerusarema?",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.9",
            "verseOrgIds": [
              "JER.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusvikira pazuva ranhasi havana kuzvininipisa kana kuratidza rukudzo, kana kutevera murayiro wangu nezvirevo zvangu zvandakatema pamberi penyu napamberi pamadzibaba enyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri: Ndafunga kuuyisa njodzi pamusoro penyu ndigoparadza Judha yose.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.11",
            "verseOrgIds": [
              "JER.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichabvisa vakasara veJudha vakanga vashinga kuenda kuIjipiti kundogarako. Vose vachafira muIjipiti, vachafa nomunondo kana kufa nenzara. Kubva kumuduku kusvikira kumukuru, vachafa nomunondo kana nenzara. Vachava chinhu chinotukwa nechinosemwa, chinhu chinoshorwa nechinonyadzisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.12",
            "verseOrgIds": [
              "JER.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndicharanga vaya vanogara kuIjipiti nomunondo, nenzara uye nedenda sokuranga kwandakaita Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.13",
            "verseOrgIds": [
              "JER.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna kuna vakasara veJudha vakaenda kunogara kuIjipiti vachapunyuka kana kurarama kuti vadzoke kunyika yeJudha, uko kwavanoshuva kuti vadzokere kundogara; hakuna achadzoka kunze kwavashoma vachatiza.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vose vaiziva kuti vakadzi vavo vaipisira zvinonhuhwira kuna vamwe vamwari, pamwe chete navakadzi vose vaivapo, ungano huru, navanhu vose vakanga vagere Kumusoro neZasi kweIjipiti, vakati kuna Jeremia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.15",
            "verseOrgIds": [
              "JER.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hatingateereri shoko rawataura kwatiri muzita raJehovha!",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.16",
            "verseOrgIds": [
              "JER.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo tichaita zvinhu zvose zvatakati tichaita. Tichapisira zvinonhuhwira kuna Mambokadzi woKudenga nokumudururira zvipiriso zvokunwa sezvatakaita isu namadzibaba edu, namadzimambo edu uye namachinda edu mumaguta eJudha nomunzira dzomuJerusarema. Panguva iyoyo takanga tine zvokudya zvizhinji uye takanga tigere zvakanaka tisina zvaitirwadza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.17",
            "verseOrgIds": [
              "JER.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kubva patakamira kupisira zvinonhuhwira kuna Mambokadzi woKudenga nokudururira zvipiriso zvokunwa kwaari, hapana chatakawana uye tanga tichingofa nomunondo nenzara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.18",
            "verseOrgIds": [
              "JER.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vakapamhidzira vachiti, \"Patakapisira zvinonhuhwira kuna Mambokadzi woKudenga, uye tikadururira zvipiriso zvokunwa kwaari, varume vedu vakanga vasingazivi here kuti taimuitira makeke akaita somufananidzo wake uye tichimudururira zvipiriso zvinonwiwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.19",
            "verseOrgIds": [
              "JER.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jeremia akati kuvanhu vose, varume navakadzi, vakanga vachimupindura,",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.20",
            "verseOrgIds": [
              "JER.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ko, Jehovha haana kurangarira here uye akafunga pamusoro pezvinonhuhwira zvaipiswa mumaguta eJudha nomunzira dzeJerusarema nemi namadzibaba enyu namadzimambo enyu namachinda enyu uye navanhu venyika?",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.21",
            "verseOrgIds": [
              "JER.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati haasisina mwoyo murefu pakuipa kwezviito zvenyu nezvinhu zvinonyangadza zvamakaita, nyika yenyu ikava chinhu chinotukwa uye nedongo risina anogaramo, sezvazvakaita nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.22",
            "verseOrgIds": [
              "JER.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwokuti makapisira zvinonhuhwira uye makatadzira Jehovha uye hamuna kumuteerera kana kutevera murayiro wake kana zvirevo zvake kana zvaakatema, njodzi iyi yaiswa pamusoro penyu sezvamunoona zvino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jeremia akati kuvanhu vose kusanganisira vakadzi, \"Inzwai shoko raJehovha, imi vanhu vose veJudha vari muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.24",
            "verseOrgIds": [
              "JER.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Wamasimba Ose, Mwari waIsraeri: Imi navakadzi venyu maratidza nezviito zvenyu, zvamakavimbisa pamakati, 'Zvirokwazvo mhiko dzedu dzatakapika tichadzizadzisa nokupisa zvinonhuhwira uye nokudururira zvipiriso zvokunwa kuna Mambokadzi woKudenga.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 44:25"
      },
      "items": [
        {
          "text": "\"Endererai henyu mberi zvino, itai zvamakavimbisa! Chengetai mhiko dzenyu!",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi inzwai shoko raJehovha, imi vaJudha mose munogara muIjipiti: 'Ndinopika nezita rangu guru,' ndizvo zvinotaura Jehovha, 'kuti hakuna anobva kuJudha agere papi napapi zvapo muIjipiti achadana zita rangu kana kupika achiti: \"Zvirokwazvo naIshe Jehovha mupenyu,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.26",
            "verseOrgIds": [
              "JER.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinovarindira kuti ndivaitire zvakaipa kwete zvakanaka, vaJudha vari muIjipiti vachafa nomunondo uye nenzara kusvikira vose vaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avo vachapunyuka pamunondo vakadzokera kunyika yeJudha vachibva kuIjipiti vachava vashoma kwazvo. Ipapo vose vakasara vavaJudha vakauya kuzogara kuIjipiti vachaziva kuti shoko rinogara nderani, rangu kana ravo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.28",
            "verseOrgIds": [
              "JER.44.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
