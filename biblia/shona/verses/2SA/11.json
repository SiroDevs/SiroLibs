  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "2SA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi naBhatishebha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munguva yechirimo, madzimambo paanoenda kundorwa, Dhavhidhi akatuma Joabhu navaranda vamambo nehondo yose yeIsraeri. Vakandoparadza vaAmoni uye vakakombawo Rabha. Asi Dhavhidhi akasara muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino rimwe zuva madekwana Dhavhidhi akamuka pamubhedha wake akafamba pamusoro pedenga romuzinda. Aripo padenga akaona mukadzi aishamba. Mukadzi uyu akanga akanaka kwazvo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.2",
            "verseOrgIds": [
              "2SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Dhavhidhi akatuma munhu kundobvunza nezvomukadzi uyu. Murume akatumwa akati, \"Ko, uyu haasi Bhatishebha here mwanasikana waEriamu mukadzi waUria muHiti?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akatuma nhume kundomutora. Akauya kwaari, iye akarara naye; nokuti akanga azvinatsa pakusachena kwake. Ipapo akadzokera kumba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.4",
            "verseOrgIds": [
              "2SA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi uyu akabata pamuviri ndokubva atuma shoko kuna Dhavhidhi achiti, \"Ndava nemimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akatuma shoko kuna Joabhu akati, \"Nditumire Uria muHiti.\" Saka Joabhu akamutumira kuna Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.6",
            "verseOrgIds": [
              "2SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uria akati asvika kwaari, Dhavhidhi akamubvunza kuti Joabhu aiva akadini hake, zvose navarwi uye kuti hondo yaifamba sei.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.7",
            "verseOrgIds": [
              "2SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Uria, \"Enda hako kuimba yako unoshamba tsoka dzako.\" Naizvozvo Uria akabva pamuzinda wamambo, uye achangoenda, mambo akamutumira chipo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Uria akarara pasuo romuzinda navaranda vose vatenzi wake akasaenda kumba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
            "verseOrgIds": [
              "2SA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi paakaudzwa kuti, \"Uria haana kuenda kumba kwake,\" akamubvunza akati, \"Hauna kubva parwendo here? Sei usina kuenda kumba kwako?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uria akati kuna Dhavhidhi, \"Areka navaIsraeri pamwe chete navaJudha vagere mumatende, uye tenzi wangu Joabhu navanhu vaishe wangu vari mumisasa kusango. Ko, ini ndaigozoenda sei kumba kwangu kuti ndidye ndichinwa nokurara nomudzimai wangu? Zvirokwazvo noupenyu hwenyu, handingaiti chinhu chakadaro!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.11",
            "verseOrgIds": [
              "2SA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kwaari, \"Chigara hako pano kwezuva rimwe chete, mangwana ndigokutendera hangu kuti udzokere.\" Naizvozvo Uria akagara muJerusarema zuva iroro neraitevera.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.12",
            "verseOrgIds": [
              "2SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakokwa naDhavhidhi, akadya nokunwa naye, uye Dhavhidhi akaita kuti adhakwe. Asi ava madekwana Uria akabuda akandovata panhoo yake pamwe chete navaranda vatenzi wake; haana kuenda kumba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifumi chamangwana Dhavhidhi akanyora tsamba kuna Joabhu akaituma naUria.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.14",
            "verseOrgIds": [
              "2SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanyora mairi achiti, \"Isa Uria pamberi paya panorwiwa zvinotyisa zvikuru. Ipapo iwe umusiye ari oga kuti abayiwe afe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joabhu paakanga akakomba guta, akaisa Uria panzvimbo yaaiziva kuti ndipo paiva navarume voumhare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veguta pavakabuda vakarwa naJoabhu, vamwe vevarume vehondo yaDhavhidhi vakakundwa; uye Uria muHiti akafawo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akatumira Dhavhidhi mashoko amafambiro akanga aita hondo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayira nhume achiti, \"Kana wapedza kurondedzera kuna mambo mafambiro aita hondo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "hasha dzamambo dzingakwira, uye angangokubvunza achiti, 'Ko, sei maswedera pedyo zvakadaro neguta muchirwa? Manga musingazivi here kuti vaizokupfurai nemiseve vari parusvingo?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko akauraya Abhimereki mwanakomana waJerubhi-Bhesheti? Haasi munhukadzi here akakanda guyo pamusoro pake richibva parusvingo, zvokuti akafira paTebhezi? Sei maswedera pedyo norusvingo?' Kana akakubvunza izvi, ipapo uti kwaari, 'Muranda wenyu Uria muHiti afawo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhume yakaenda, uye yakati yasvika, yakaudza Dhavhidhi zvose zvayakanga yarayirwa naJoabhu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.22",
            "verseOrgIds": [
              "2SA.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhume yakati kuna Dhavhidhi, \"Varume avo vatikurira vakatibudira pachena, asi isu tavasairira kusvikira vasvika pasuo reguta.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.23",
            "verseOrgIds": [
              "2SA.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vapfuri vapfura varanda venyu vari parusvingo, uye vamwe vavaranda vamambo vafa. Uyewo, muranda wenyu Uria muHiti afa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.24",
            "verseOrgIds": [
              "2SA.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akarayira nhume achiti, \"Uti kuna Joabhu, 'Izvi ngazvirege kukushungurudza; munondo haubayi rutivi rumwe asi nokunouyawo wabaya. Ramba uchirwisa guta uriparadze.' Taura izvi kuna Joabhu kuti umukurudzire.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mukadzi waUria paakanzwa kuti murume wake akanga afa, akamuchema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mazuva okuchema akati apera, Dhavhidhi akamuuyisa kumba kwake, akava mukadzi wake, uye akamuberekera mwanakomana. Asi chinhu ichi chakaitwa naDhavhidhi hachina kufadza Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.27",
            "verseOrgIds": [
              "2SA.11.27"
            ]
          }
        }
      ]
    }
  ],
