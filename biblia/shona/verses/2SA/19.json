  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "2SA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akaudzwa kuti, \"Mambo anochema nokuungudza nokuda kwaAbhusaromu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.1",
            "verseOrgIds": [
              "2SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kuhondo yose, kukunda kwezuva iro kwakashandurwa kukava kuchema, nokuti pazuva iro, mauto akazvinzwa zvichinzi, \"Mambo anochema nokuda kwomwanakomana wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.2",
            "verseOrgIds": [
              "2SA.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakapinda muguta vachiverevedza savanhu vanoverevedza vachinyara nokuti vatiza kubva kuhondo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.3",
            "verseOrgIds": [
              "2SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akafukidza chiso chake akachema zvikuru achiti, \"Haiwa mwanakomana wangu Abhusaromu! Haiwa Abhusaromu, mwanakomana wangu, mwanakomana wangu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.4",
            "verseOrgIds": [
              "2SA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joabhu akapinda mumba kuna mambo akati, \"Nhasi manyadzisa vanhu vose, avo vachangoponesa upenyu hwenyu noupenyu hwavanakomana navanasikana venyu uye noupenyu hwavakadzi venyu navarongo venyu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.5",
            "verseOrgIds": [
              "2SA.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoda avo vanokuvengai uye munovenga avo vanokudai. Mazviratidza pachena nhasi kuti vatungamiri vehondo navanhu vavo havarevi chinhu kwamuri. Ndinoona kuti maifarira kuti dai Abhusaromu ararama nhasi uye kuti dai tose zvedu tafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.6",
            "verseOrgIds": [
              "2SA.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino budai munokurudzira vanhu venyu. Ndinopika naJehovha kuti kana mukasabuda, hakuna munhu achasara nemi usiku huno. Zvichava zvakaipisisa kwamuri kupinda njodzi dzose dzakakuwirai kubva pauduku hwenyu kusvikira zvino.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.7",
            "verseOrgIds": [
              "2SA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akasimuka akandoisa chigaro chake pasuo. Vanhu vakati vaudzwa kuti, \"Mambo agere pasuo,\" vose vakauya pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.8",
            "verseOrgIds": [
              "2SA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "2SA 19:8"
      },
      "items": [
        {
          "text": "Dhavhidhi anodzokera kuJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:8"
      },
      "items": [
        {
          "text": "Zvichakadaro, vaIsraeri vakanga vatizira kumisha yavo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.8",
            "verseOrgIds": [
              "2SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumarudzi ose avaIsraeri, vanhu vose vakanga vachikakavadzana vachiti, \"Mambo akatisunungura kubva muruoko rwavaFiristia. Asi zvino atiza nyika nokuda kwaAbhusaromu;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.9",
            "verseOrgIds": [
              "2SA.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Abhusaromu, uyo watakazodza kuti atitonge, afa muhondo. Saka munoregereiko kutaura nezvokudzosa mambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.10",
            "verseOrgIds": [
              "2SA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Dhavhidhi akatuma shoko naZadhoki naAbhiatari, vaprista achiti, \"Bvunzai vakuru veJudha kuti, 'Seiko imi mava vokupedzisira kudzosa mambo kumuzinda wake, sezvo zvinotaurwa muIsraeri yose zvasvika pamba pake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.11",
            "verseOrgIds": [
              "2SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi muri hama dzangu, muri venyama yangu chaivo uye veropa rangu. Saka maitireiko vokupedzisira kudzosa mambo?'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.12",
            "verseOrgIds": [
              "2SA.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye muti kuna Amasa, 'Ko, iwe hauzi wenyama yangu uye weropa rangu here? Mwari ngaandirove, ngaarambe achidaro kwazvo, kana kubva zvino zvichienda mberi, iwe ukarega kuva mukuru wehondo yangu panzvimbo yaJoabhu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.13",
            "verseOrgIds": [
              "2SA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabata mwoyo yavarume vose veJudha vakaita sokunge vaiva munhu mumwe. Vakatuma shoko kuna mambo vachiti, \"Dzokai, imi navanhu venyu mose.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.14",
            "verseOrgIds": [
              "2SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akadzoka akasvika paJorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.15",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:15"
      },
      "items": [
        {
          "text": "Zvino vanhu veJudha vakanga vasvika kuGirigari kuti vaende kundosangana namambo vagomuyambutsa Jorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.15",
            "verseOrgIds": [
              "2SA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei mwanakomana waGera, muBhenjamini aibva kuBhahurimi, akakurumidza kuburuka navanhu veJudha kuti vandosangana naMambo Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.16",
            "verseOrgIds": [
              "2SA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga ane vaBhenjamini vaisvika chiuru, pamwe chete naZibha, mutariri weimba yaSauro, uye navanakomana vake gumi navashanu navaranda vake makumi maviri. Vakamhanyira kuJorodhani uko kwakanga kwava namambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.17",
            "verseOrgIds": [
              "2SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakayambuka rukova kuti vandotora veimba yamambo uye kuti vaite zvose zvaaida.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:18"
      },
      "items": [
        {
          "text": "Shimei mwanakomana waGera akati ayambuka Jorodhani, akawira pasi nechiso chake pamberi pamambo",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.18",
            "verseOrgIds": [
              "2SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati kwaari, \"Ishe wangu ngaarege kundipa mhaka. Regai henyu kurangarira kukanganisa kwakaitwa nomuranda wenyu pazuva rakabva ishe wangu mambo paJerusarema. Mambo ngaazvidzime mundangariro dzake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.19",
            "verseOrgIds": [
              "2SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ini muranda wenyu ndinozviziva kuti ndakatadza, asi nhasi ndauya pano sewokutanga weimba yose yaJosefa kuti ndiburuke ndizosangana naishe wangu iye mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.20",
            "verseOrgIds": [
              "2SA.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhishai mwanakomana waZeruya akati, \"Ko, Shimei haafaniri kuurayiwa nokuda kwaizvozvi here? Akatuka muzodziwa waJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.21",
            "verseOrgIds": [
              "2SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akapindura akati, \"Ndineiko nemi, imi vanakomana vaZeruya zvokuti nhasi mava vavengi vangu! Pane munhu angafanira kufa muIsraeri nhasi here? Ko, handizivi here kuti nhasi ndiri mambo weIsraeri?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.22",
            "verseOrgIds": [
              "2SA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akati kuna Shimei, \"Haungafi.\" Uye mambo akamuvimbisa nemhiko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.23",
            "verseOrgIds": [
              "2SA.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefibhosheti muzukuru waSauro, akaburukawo kundosangana namambo. Haana kuva nehanya netsoka dzake kana kuguririra ndebvu dzake kana kusuka nguo dzake kubvira pazuva rakasimuka mambo kusvikira pazuva raakadzoka ari mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.24",
            "verseOrgIds": [
              "2SA.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasvika achibva kuJerusarema achindosangana namambo, mambo akamubvunza akati, \"Wakaregereiko kuenda neni, Mefibhosheti?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.25",
            "verseOrgIds": [
              "2SA.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Ishe wangu mambo, sezvo ini muranda wenyu ndiri chirema, ndakati, 'Ndichaita kuti mbongoro yangu igadzikwe chigaro uye ndigoitasva, kuti ndigoenda namambo.' Asi Zibha muranda wangu akandipandukira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.26",
            "verseOrgIds": [
              "2SA.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akandorevera nhema muranda wenyu kuna ishe wangu mambo. Ishe wangu mambo akaita somutumwa waMwari; saka itai henyu zvinokufadzai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.27",
            "verseOrgIds": [
              "2SA.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvose zvasekuru vangu hazvifanirwi nechimwe chinhu asi rufu ruchibva kuna she wangu mambo, asi makapa muranda wenyu nzvimbo pakati paavo vanodya patafura yenyu. Saka ini ndine mvumo yeiko yokukumbirazve kuna mambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.28",
            "verseOrgIds": [
              "2SA.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kwaari, \"Uchataurireiko zvakawanda? Ndinokurayira iwe naZibha kuti mugovane minda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.29",
            "verseOrgIds": [
              "2SA.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefibhosheti akati kuna mambo, \"Ngaatore hake zvinhu zvose, sezvo zvino ishe wangu mambo asvika kumusha ari mupenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.30",
            "verseOrgIds": [
              "2SA.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhazirai muGireadhi akasvikawo achibva kuRogerimi kuti ayambuke Jorodhani namambo uye kuti amuperekedze panzira yake ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.31",
            "verseOrgIds": [
              "2SA.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Bhazirai akanga akwegura kwazvo, ava namakore makumi masere. Akanga achiriritira mambo panguva yaakanga agere paMahanaimi, nokuti akanga ari munhu akapfuma kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.32",
            "verseOrgIds": [
              "2SA.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kuna Bhazirai, \"Yambuka pamwe chete neni ugogara neni muJerusarema, uye ini ndichakuriritira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.33",
            "verseOrgIds": [
              "2SA.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Bhazirai akapindura mambo akati, \"Makore manganiko andichararama, zvokuti ndingafanira kukwidza kuJerusarema namambo?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.34",
            "verseOrgIds": [
              "2SA.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndava namakore makumi masere. Ndichagona kuziva mutsauko pakati pechakanaka nechisina kunaka here? Ko, muranda wenyu achagona kuravira chaanodya nechaanonwa here? Ko, ndichagona kunzwa manzwi avarume navakadzi vanoimba here? Muranda wenyu achaitireiko kuti ave mumwe mutoro kuna ishe wangu mambo?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.35",
            "verseOrgIds": [
              "2SA.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda wenyu achayambuka Jorodhani namambo kwenhambwe pfupi, asi mambo anondipireiko mubayiro wakadai?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.36",
            "verseOrgIds": [
              "2SA.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai muranda wenyu adzokere hake, kuti ndinofira muguta rangu pedyo nehwiro hwababa vangu namai vangu. Asi hoyu muranda wangu Kimihami. Ngaayambuke hake naishe iye mambo. Mumuitire henyu zvose zvinokufadzai.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.37",
            "verseOrgIds": [
              "2SA.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati, \"Kimihami achayambuka neni, uye ndichamuitira zvose zvinokufadza. Uye zvose zvaunoda kwandiri ndichakuitira.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.38",
            "verseOrgIds": [
              "2SA.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanhu vose vakayambuka Jorodhani, uye ipapo mambo akazoyambukawo. Mambo akatsvoda Bhazirai akamuropafadza, uye Bhazirai akadzokera kumba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.39",
            "verseOrgIds": [
              "2SA.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2SA 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati ayambukira kuGirigari, Kimihami akayambuka naye. Mauto ose eJudha nehafu yavarwi veIsraeri vakanga vayambutsa mambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.40",
            "verseOrgIds": [
              "2SA.19.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2SA 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye varume vose veIsraeri vakauya kuna mambo vakati kwaari, \"Hama dzedu, varume veJudha, vakabireiko mambo vakamuuyisa neimba yake mhiri kweJorodhani, pamwe chete navanhu vake vose?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.41",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2SA 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vose veJudha vakapindura varume veIsraeri vachiti, \"Takaita izvi nokuti mambo ihama yedu yapedyo. Seiko imi matsamwiswa nazvo? Tambodya here zvinhu zvamambo? Tambozvitorera kana chinhu chimwe chete here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2SA 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume veIsraeri vakapindura varume veJudha vakati, \"Tine migove gumi muna mambo; uye zvisiri izvozvo chete, Dhavhidhi ndowedu kukunda imi. Saka seiko imi muchitizvidza? Ko, hatizisu takatanga kutaura kuti mambo adzoke here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 19:43"
      },
      "items": [
        {
          "text": "Asi varume veJudha vakapindura nehasha kwazvo kupfuura varume veIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
        }
      ]
    }
  ],
