  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amunoni naTamari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munguva iyoyo, Amunoni mwanakomana waDhavhidhi akachiva Tamari, hanzvadzi yaAbhusaromu mwanakomana waDhavhidhi yakanga yakanaka kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amunoni akatambudzika kusvikira pakurwara pamusoro paTamari hanzvadzi yake, nokuti hazvaigona kuti amuite chimwe chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.2",
            "verseOrgIds": [
              "2SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Amunoni aiva neshamwari yake yainzi Jonadhabhu mwanakomana waShimea, mukoma waDhavhidhi. Jonadhabhu akanga ari munhu aiva namano.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.3",
            "verseOrgIds": [
              "2SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvunza Amunoni akati, \"Seiko, iwe mwanakomana wamambo, uchipunyaira mangwanani oga oga? Haungandiudzewo here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:4"
      },
      "items": [
        {
          "text": "Amunoni akati kwaari, \"Ndinoda Tamari, hanzvadzi yomununʼuna wangu Abhusaromu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonadhabhu akati, \"Enda unorara unyepedzere kurwara. Zvino kana baba vako vauya kuzokuona, uti kwavari, 'Ndinokumbira kuti hanzvadzi yangu Tamari auye andipe zvokudya. Ndinoda kuti agadzire zvokudya ini ndichiona kuti ndimuone uye ndigodya zvichibva mumaoko ake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.5",
            "verseOrgIds": [
              "2SA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Amunoni akavata pasi akanyepedzera kurwara. Zvino mambo paakauya kuzomuona, Amunoni akati kwaari, \"Ndinokumbira kuti Tamari hanzvadzi yangu auye andibikire chingwa chakaisvonaka ndichiona, kuti ndigodya zvichibva mumaoko ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.6",
            "verseOrgIds": [
              "2SA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatumira shoko kuna Tamari kumba kwamambo akati, \"Enda kumba kwehanzvadzi yako Amunoni umugadzirire zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.7",
            "verseOrgIds": [
              "2SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Tamari akaenda kumba kwaAmunoni hanzvadzi yake, uyo akanga akarara pasi. Akatora mukanyiwa, akakanya, akaumba chingwa uye akachibika iye achiona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.8",
            "verseOrgIds": [
              "2SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora pani ndokumupa chingwa, asi iye akaramba kudya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:9"
      },
      "items": [
        {
          "text": "Amunoni akati, \"Vanhu vose ngavabude muno.\" Saka vanhu vose vakabuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amunoni ndokubva ati kuna Tamari, \"Uya nezvokudya muno mumba mangu mokurara ndidye zvichibva muruoko rwako.\" Zvino Tamari akatora chingwa chaakanga abika akaenda nacho mumba yokurara yehanzvadzi yake Amunoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.10",
            "verseOrgIds": [
              "2SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akati achimupa kuti adye, iye akamubata akati, \"Uya urare neni, hanzvadzi yangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.11",
            "verseOrgIds": [
              "2SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwaari, \"Kwete, hanzvadzi yangu! Usandichinya. Chinhu chakadai hachifaniri kuitwa muIsraeri! Usaita chinhu chakaipa zvakadai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.12",
            "verseOrgIds": [
              "2SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ini ndichavei? Uchava somumwe wamapenzi akaipa muIsraeri. Ndapota, taura namambo; haangamborambi kuti ndiroorwe newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.13",
            "verseOrgIds": [
              "2SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye akaramba kumuteerera, uye nokuti akanga ane simba kumudarika, akamubata chibharo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Amunoni akabva amuvenga nokuvenga kukuru kwazvo, akamuvenga kupfuura kumuda kwaaiva ambomuita. Amunoni akati kwaari, \"Muka uende!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.15",
            "verseOrgIds": [
              "2SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwaari, \"Kwete! Kundidzinga muno kwakashata kudarika zvawatondiita nechakare.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:16"
      },
      "items": [
        {
          "text": "Asi iye akaramba kumuteerera.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadana muranda wake akati kwaari, \"Dzinga mukadzi uyu abve muno uye ukiye mukova kana achinge abuda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.17",
            "verseOrgIds": [
              "2SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muranda wake akamubudisa panze akakiya mukova shure kwake. Akanga akapfeka nguo yaikosha zvikuru yaipenya, nokuti ndidzo nguo dzaipfekwa navanasikana vamambo vaiva mhandara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.18",
            "verseOrgIds": [
              "2SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari akazvizodza madota akabvarura nguo inokosha yaakanga akapfeka. Akabata musoro wake ndokuenda achichema zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanzvadzi yake Abhusaromu akati kwaari, \"Ko, ndiAmunoni, hanzvadzi yako, anga anewe here? Chinyarara zvako, hanzvadzi; iye ihanzvadzi yako. Usanyanyozvidya mwoyo nazvo.\" Uye Tamari akagara mumba maAbhusaromu hanzvadzi yake, akava mukadzi akasurukirwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo Dhavhidhi akati anzwa zvose izvi, akatsamwa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.21",
            "verseOrgIds": [
              "2SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu haana kana kumbotaura shoko kuna Amunoni, rakanaka kana rakaipa; akavenga Amunoni nokuti akanga akanyadzisa hanzvadzi yake Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhusaromu anouraya Amunoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mamakore maviri; vaveuri vamakwai aAbhusaromu pavakanga vari paBhaari Hazori pedyo nomuganhu weEfuremu, akakoka vanakomana vose vamambo kuti vauye ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.23",
            "verseOrgIds": [
              "2SA.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akaenda kuna mambo akandoti, \"Muranda wenyu aita kuti vaveuri vauye. Ndapota, ko, mambo namakurukota ake haangauyi kuzova neni here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akapindura akati, \"Kwete, mwanakomana wangu. Hatifaniri kuenda tose; tingazova mutoro kwauri.\" Kunyange zvazvo akamugombedzera, akaramba kuenda, asi akamuropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhusaromu akati, \"Kana zvisingaiti, chitenderai henyu mununʼuna wangu Amunoni kuti aende nesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:26"
      },
      "items": [
        {
          "text": "Mambo akamubvunza akati, \"Ko, iye anoendereiko nemi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Abhusaromu akavanyengetedza, saka akazotendera Amunoni navanakomana vose vamambo kuti vaende navo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akarayira vanhu vake akati, \"Teererai! Kana Amunoni anwa waini zvokuti haachabviri nokufara uye ini ndikati kwamuri, 'Urayai Amunoni,' ibvai mamuuraya. Musatya. Handizini ndakurayirai here? Simbai mutsunge mwoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.28",
            "verseOrgIds": [
              "2SA.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanhu vaAbhusaromu vakaita kuna Amunoni sokurayirwa kwavakanga vaitwa naAbhusaromu. Ipapo vana vose vamambo vakasimuka, vakatasva manyurusi avo vakatiza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachiri munzira kudaro, shoko rakasvika kuna Dhavhidhi richiti, \"Abhusaromu auraya vanakomana vose vamambo; hapana kana mumwe zvake asara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.30",
            "verseOrgIds": [
              "2SA.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akasimuka, akabvarura nguo dzake akazvambarara pasi; ipapo varanda vake vose vakauya vaine nguo dzakabvaruka vakamira paari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jonadhabhu mwanakomana waShimea, mukoma waDhavhidhi, akati, \"Ishe wangu ngaarege kufunga kuti vauraya machinda ake ose; Amunoni oga ndiye afa. Izvi zvakagara zviri muurongwa hwaAbhusaromu kubvira musi wakabatwa chibharo hanzvadzi yake Tamari naAmunoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvino Ishe wangu mambo ngaarege kuzvidya mwoyo neshoko rokuti vanakomana vose vamambo vafa. Amunoni oga ndiye afa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo, Abhusaromu akatiza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:34"
      },
      "items": [
        {
          "text": "Zvino murume akanga amire akarinda akatarira kumusoro akaona vanhu vazhinji mumugwagwa nechokumavirazuva kwake, vachiburuka norutivi rwegomo. Nharirire iyi yakaenda ikandoudza mambo kuti, \"Ndiri kuona varume kunzira yeHoronaimu, kurutivi rwegomo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonadhabhu akati kuna Mambo, \"Tarirai, vanakomana vamambo vasvika; zvaitika sokutaura kwomuranda wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achipedza kutaura, vanakomana vamambo vakabva vapinda, vachiungudza zvikuru. Zvino mambo pamwe chete navaranda vake vakachema neshungu kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akatiza akaenda kuna Tarimai mwanakomana waAmihudhi, mambo weGeshuri. Asi mambo Dhavhidhi akachema pamusoro pomwanakomana wake mazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Abhusaromu atiza akaenda kuGeshuri, akandogarako kwamakore matatu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mweya wamambo wakashuva kwazvo kuenda kuna Abhusaromu, nokuti zvino akanga anyaradzwa pamusoro porufu rwaAmunoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
    }
  ],
