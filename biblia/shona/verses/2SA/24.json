{
  "id": "2SA.24",
  "number": "24",
  "bookId": "2SA",
  "reference": "2 Samueri 24",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anoverenga varume vokurwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwaMwari kwakava pamusoro pavaIsraeri zvakare, uye akakurudzira Dhavhidhi achiti, \"Enda undoverenga vaIsraeri navaJudha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.1",
            "verseOrgIds": [
              "2SA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akati kuna Joabhu navakuru vehondo vaiva naye, \"Endai pakati pamarudzi ose avaIsraeri kubva kuDhani kusvikira kuBheerishebha mundonyora varume vokurwa, kuti ndizive kuti vangani varipo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.2",
            "verseOrgIds": [
              "2SA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Joabhu akapindura mambo achiti, \"Jehovha Mwari wenyu ngaawanze varwi kakapetwa kupfuura rune zana, uye meso ashe wangu mambo azvione. Asi ishe wangu mambo anodireiko kuita chinhu chakadai?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.3",
            "verseOrgIds": [
              "2SA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, shoko ramambo rakakunda raJoabhu navatungamiri vehondo; saka vakabva pamberi pamambo kuti vandonyora varume vokurwa muIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokuyambuka Jorodhani, vakadzika matende avo pedyo neAroeri, zasi kweguta riri mumupata, uye ipapo vakaenda napakati peGadhi vakandosvika kuJazeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenda kuGireadhi nokudunhu reTahitimi Hodhishi, uye napaDhani Joani uye vakapoterera nokuSidhoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakaenda vakananga kunhare yeTire nokumaguta ose avaHivhi navaKenani. Pakupedzisira, vakaenda kuBheerishebha zasi kweJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokuenda kwavo munyika yose, vakadzoka kuJerusarema papera mwedzi mipfumbamwe namazuva makumi maviri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akazivisa uwandu hwavanhu kuna mambo akati: MuIsraeri makanga mune mazana masere ezviuru zvavarume vakanga vakasimba, vaigona kubata munondo, uye muJudha maiva namazana mashanu ezviuru.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana yaDhavhidhi yakarova shure kwokuverenga kwake varume vokurwa, akati kuna Jehovha, \"Ndatadza zvikuru pane zvandaita. Haiwa Jehovha, zvino ndinokukumbirai, bvisa mhaka yomuranda wenyu. Ndaita chinhu choupenzi kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.10",
            "verseOrgIds": [
              "2SA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi akati achimuka mangwanani, shoko raJehovha rakasvika kuna Gadhi muprofita, muoni waDhavhidhi richiti,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda undoudza Dhavhidhi kuti, 'Zvanzi naJehovha: Ndiri kukupa zvinhu zvitatu. Sarudza chimwe chete chazvo kuti ndichiite pamusoro pako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Gadhi akaenda kuna Dhavhidhi akati kwaari, \"Unoda kuti munyika yako muve nenzara kwamakore matatu here? Kana kuti mwedzi mitatu yokutiza kubva kuvavengi vako ivo vachikudzinganisa? Kana kuti mazuva matatu edenda munyika yako? Zvino funga pamusoro pazvo ugosarudza kuti ndingandopindura sei iye andituma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Gadhi, \"Ndiri pakutambudzika kukuru. Ngatiwirei hedu mumaoko aJehovha, nokuti ngoni dzake ihuru; asi musandirega ndichiwira mumaoko avanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha akatuma denda pamusoro peIsraeri kubva mangwanani iwayo kusvikira panguva yakatarwa, uye vanhu zviuru makumi manomwe vakafa kubva kuDhani kusvikira kuBheerishebha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.15",
            "verseOrgIds": [
              "2SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa akati atandavadza ruoko rwake kuti aparadze Jerusarema, Jehovha akazvidemba nokuda kwenjodzi iyi akati kumutumwa akanga achiparadza vanhu, \"Zvaringana! Dzora ruoko rwako.\" Mutumwa waJehovha ipapo akanga ava paburiro raArauna muJebhusi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.16",
            "verseOrgIds": [
              "2SA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati aona mutumwa akanga achiuraya vanhu, akati kuna Jehovha, \"Ini ndini ndakatadza uye ndikaita zvakaipa. Ava vanongova havo makwai chete. Chiiko chavakaita? Ruoko rwenyu ngaruwire pamusoro pangu ini nemhuri yangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anovaka Aritari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro Gadhi akaenda kuna Dhavhidhi akati kwaari, \"Kwira undovakira Jehovha aritari paburiro raArauna muJebhusi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
              "2SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akakwira sezvaakanga arayirwa naJehovha kubudikidza naGadhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna akati atarisa akaona mambo navanhu vake vachiuya vakananga kwaari, akabuda akandokotamira pasi pamberi pamambo chiso chake chakatsikitsira pasi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna akati, \"Seiko ishe wangu mambo auya kumuranda wake?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 24:21"
      },
      "items": [
        {
          "text": "Dhavhidhi akapindura akati, \"Kuzotenga buriro rako, kuti ndivakire Jehovha aritari, kuti denda riri pamusoro pavanhu rigume.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna akati kuna Dhavhidhi, \"Ishe wangu mambo ngaatore zvose zvinomufadza agozvipira kuna Jehovha. Hedzi nzombe dzechibayiro chinopiswa, neiyi mipuro namajoko enzombe kuti dzive huni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa mambo, Arauna anopa zvose izvi kuna mambo.\" Arauna akatizve kwaari, \"Jehovha Mwari wenyu ngaakugamuchirei.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mambo akapindura Arauna akati, \"Kwete, ndinoda kuzvitenga kwauri. Handingabayiri Jehovha Mwari wangu zvibayiro zvinopiswa zvandisina kutenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 24:24"
      },
      "items": [
        {
          "text": "Saka Dhavhidhi akatenga buriro nenzombe uye akazvipira namakumi mashanu amashekeri",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
        {
          "text": "esirivha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akavakira Jehovha aritari ipapo uye akabayira zvipiriso zvinopiswa nezvipiriso zvokuwadzana. Ipapo Jehovha akapindura munyengetero wokukumbirira nyika, uye denda rikapera pamusoro peIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.25",
            "verseOrgIds": [
              "2SA.24.25"
            ]
          }
        }
      ]
    }
  ],
