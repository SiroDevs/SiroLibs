      "attrs": {
        "style": "q1",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Mukombe unobva kuruoko rwaJehovha rworudyi uri kuuya kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
