      "attrs": {
        "style": "q2",
        "vid": "HAB 2:14"
      },
      "items": [
        {
          "text": "sezvakaita mvura kuzadza kwayakaita gungwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
