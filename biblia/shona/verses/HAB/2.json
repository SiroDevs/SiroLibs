      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "kuti vanhu vanoshandira zvinoparadzwa nomoto,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
