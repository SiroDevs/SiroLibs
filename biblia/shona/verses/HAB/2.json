      "attrs": {
        "style": "q2",
        "vid": "HAB 2:12"
      },
      "items": [
        {
          "text": "uye anosimbisa guta nezvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
