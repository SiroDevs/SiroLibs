              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judha haana kukwanisa kudzinga vaJebhusi vakanga vachigara muJerusarema; nanhasi vaJebhusi vageremo navanhu veJudha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.63",
