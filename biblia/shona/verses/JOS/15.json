          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriati Bhaari (iro Kiriati Jearimi) neRabha ndiwo maguta maviri nemisha yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
              "JOS.15.60"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JOS 15:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murenje maiva ne:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:61"
      },
      "items": [
        {
          "text": "Bheti Arabha, Midhini, Sekaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JOS 15:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibhishani, Guta roMunyu, neEni Gedhi ndiwo maguta matanhatu pamwe chete nemisha yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.62",
            "verseOrgIds": [
              "JOS.15.62"
            ]
          }
        }
      ]
    },
