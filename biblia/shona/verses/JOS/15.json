          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyika yamakomo maiva ne:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:48"
      },
      "items": [
        {
          "text": "Shamiri, Jatiri, Soko,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhana, Kiriati Sana (iro Dhebhiri),",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.49",
            "verseOrgIds": [
              "JOS.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anabhi, Ashitemo, Animi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.50",
            "verseOrgIds": [
              "JOS.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosheni, Horoni, neGiro anova maguta gumi nerimwe pamwe chete nemisha yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
