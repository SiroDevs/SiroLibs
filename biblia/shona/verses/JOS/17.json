  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOS 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiwo mugove worudzi rwaManase sedangwe raJosefa, ndiko kuti mugove waMakiri dangwe raManase. Makiri ndiye akanga ari tateguru wavaGireadhi, uye akanga apiwa Gireadhi neBhashani nokuti vaMakiri vakanga vari varwi vakuru.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mugove uyu wakanga uri wavanhu vakasara vaManase dzimba dzaAbhiezeri, Hereki, Asirieri, Shekemu, Hefa naShemidha. Izvi ndizvo zvimwe zvizvarwa zvechirume zvaManase mwanakomana waJosefa nedzimba dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Zerofehadhi mwanakomana waHeferi, mwanakomana waGireadhi, mwanakomana waMakiri, mwanakomana waManase, akanga asina vanakomana asi vanasikana chete. Mazita avo aiti Mara, Noa, Hogira, Mirika, naTiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakaenda kuna Ereazari muprista nokuna Joshua mwanakomana waNuni, nokuvatungamiri vakandoti, \"Jehovha akarayira Mozisi kuti atipe nhaka pakati pehama dzedu.\" Naizvozvo Joshua akavapa nhaka pamwe chete navanunʼuna vababa vavo, sezvakanga zvarayirwa naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugove waManase waisanganisira matunhu gumi tisingaverengi Gireadhi neBhashani dzaiva kumabvazuva kweJorodhani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vanasikana vorudzi rwaManase vakapiwa nhaka pakati pavanakomana. Nyika yeGireadhi yakanga iri yezvimwe zvizvarwa zvose zvaManase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yaManase yaitangira kuAsheri ichindosvika kuMikimetati kumabvazuva kweShekemu. Muganhu wainanga nechezasi uchibva ikoko uye waisanganisira vanhu vakanga vagere muEni Tapua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nyika yeTapua yakanga iri yaManase asi guta reTapua pacharo raiva pamuganhu waManase, rakanga riri ravaEfuremu.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino muganhu waipfuurira zasi kuRwizi rweKana. Kwakanga kuna maguta aiva aEfuremu akanga ari pakati pamaguta aManase, asi muganhu waManase wakanga uri nechokumusoro kworwizi uchindogumira pagungwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nechezasi nyika iyi yakanga iri yaEfuremu uye kurutivi rwokumusoro yakanga iri yaManase. Nyika yaManase yaisvika kugungwa uye yaiganhurana naAsheri nechokumusoro uye naIsakari kumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukati meIsakari neAsheri, Manase akanga ainewo Bheti Shani, Ibhireami navanhu veDhori, Enidhori, Tanaki neMegidho, pamwe chete nemisha yakapoteredza (yechitatu pakuverengwa iNafoti).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vana vaManase havana kugona kugara mumaguta aya, nokuti vaKenani vakashinga kugara munyika iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, vaIsraeri vakati vava nesimba, vakaisa vaKenani pasi pavo ndokuvashandisa chibharo, asi havana kuvadzinga zvachose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vaJosefa vakati kuna Joshua, \"Makatipireiko mugove mumwe chete nechikamu chimwe chete kuti ive nhaka yedu? Tiri vanhu vazhinji uye Jehovha akatiropafadza zvikuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akapindura achiti, \"Kana muri vanhu vazhinji, uye kana nyika yezvikomo yaEfuremu iri diki chaizvo kwamuri, endai kudondo munozvitemera nzvimbo ikoko kunyika yavaPerizi neyavaRefaiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vaJosefa vakati, \"Nyika yamakomo haitikwaniri, uye vaKenani vose vanogara mubani vane ngoro dzesimbi, ivo vose vari muBheti Sheani nemisha yaro pamwe chete navari muMupata weJezireeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Joshua akati kuimba yaJosefa, imba yaEfuremu naManase, \"Imi muri vanhu vazhinji uye mune simba guru. Hamungave nomugove mumwe chete",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi nyika yamakomo ichava yenyu; nokuti kunyange riri dondo, muchafanira kuritema rigova renyu kusvikira kwarinoperera, nokuti munofanira kudzinga vaKenani, kunyange vane ngoro dzesimbi uye vane simba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
