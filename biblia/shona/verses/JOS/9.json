{
  "id": "JOS.9",
  "number": "9",
  "bookId": "JOS",
  "reference": "Joshua 9",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOS 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaIsraeri vanonyengedzwa navaGibheoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino madzimambo ose aigara kumavirira kweJorodhani navaiva munyika yamakomo, mujinga mamakomo kumadokero, mumahombekombe ose eGungwa Guru kusvikira kuRebhanoni (madzimambo avaHiti, navaAmori, navaKenani, navaPerizi, navaHivhi navaJebhusi) vakanzwa nezvazvo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.1",
            "verseOrgIds": [
              "JOS.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaungana pamwe chete kuti varwisane naJoshua navaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.2",
            "verseOrgIds": [
              "JOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu veGibheoni pavakanzwa zvakanga zvaitwa Jeriko neAi naJoshua,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.3",
            "verseOrgIds": [
              "JOS.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakafunga zano: Vakaenda senhume nembongoro dzavo dzakatakura masaga akasakara nehomwe dzewaini dzakasakara, dzakatsemuka dzikasonanidzwazve.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.4",
            "verseOrgIds": [
              "JOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakapfeka shangu dzakasakara. Zvingwa zvose zvembuva yavo zvakanga zvakaoma nokuvhuvha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
              "JOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakaenda kuna Joshua mumusasa paGirigari ndokubva vati kwaari nokuvarume veIsraeri, \"Tabva kunyika iri kure; zvino itai sungano nesu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
            "verseOrgIds": [
              "JOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino varume veIsraeri vakati kuvaHivhi, \"Asi zvichida munogara pedyo nesu. Tingagoita sungano nemi sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo ndokuti kuna Joshua, \"Tiri varanda venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 9:8"
      },
      "items": [
        {
          "text": "Asi Joshua akavabvunza achiti, \"Ndimi vanaani uye munobvepi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati kwaari, \"Varanda venyu vabva kunyika iri kure kure nokuda kwomukurumbira waJehovha Mwari wenyu. Nokuti takanzwa nezvake: zvose zvaakaita muIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nezvose zvaakaita kumadzimambo maviri avaAmoni kumabvazuva eJorodhani nokuna Sihoni mambo weHeshibhoni, naOgi mambo weBhashani, aitonga muAshitaroti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vakuru vedu navagari vose vomunyika yedu vakati kwatiri, 'Torai mbuva yerwendo rwenyu; muende munosangana navo muti kwavari, \"Tiri varanda venyu; itai sungano nesu.\" '",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.11",
            "verseOrgIds": [
              "JOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvingwa zvedu izvi zvakanga zvichidziya patakazvitora mudzimba dzedu zuva ratakasimuka tichiuya kuno. Asi zvino chionai kuoma nokuvhuvha kwazvaita.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.12",
            "verseOrgIds": [
              "JOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye homwe dzewaini idzi dzaiva itsva patakadzizadza, asi chionai kubvaruka kwadzaita. Uye mbatya dzedu neshangu dzedu zvasakara nokuda kworwendo rurefu refu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.13",
            "verseOrgIds": [
              "JOS.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veIsraeri vakaravira mbuva yavo asi havana kubvunza Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joshua akaita sungano yorugare navo kuti vavarege vari vapenyu, uye vakuru veungano vakaisimbisa nemhiko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mushure mamazuva matatu vaita sungano navaGibheoni, vaIsraeri vakanzwa kuti vakanga vari vavakidzani, vagere pedyo navo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vaIsraeri vakasimuka vakasvika mumaguta avo zuva rechitatu: aiti Gibheoni, neKefira, neBheroti, neKiriati Jearimi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaIsraeri havana kuvarwisa, nokuti vakuru veungano vakanga vaita mhiko kwavari naJehovha, Mwari waIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 9:18"
      },
      "items": [
        {
          "text": "Ungano yose yakapopotera vatungamiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi vatungamiri vose vakapindura vachiti, \"Takapika kwavari naJehovha, Mwari waIsraeri, zvino hatigoni kuita chinhu kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvatichaita kwavari: Tichavarega vari vapenyu, kuitira kuti kutsamwa kwaMwari kurege kutiwira nokuda kwokuputsa mhiko yatakapika kwavari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenderera mberi vachiti, \"Varegei vari vapenyu, asi ngavave vatemi vehuni navacheri vemvura veungano yose.\" Naizvozvo zvakanga zvarehwa navatungamiri zvakaitwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joshua akadana vaGibheoni akati kwavari, \"Sei makatinyengedza muchiti, 'Tinogara kure kure nemi,' asi imi muchigara pedyo nesu?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mava vanhu vakatukwa: Hamuchazofi makarega kuva vatemi vehuni navacheri vemvura veimba yaMwari wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakapindura Joshua vachiti, \"Varanda venyu vakanga vaudzwa pachena kuti Jehovha Mwari wenyu akanga arayira Mozisi muranda wake sei kuti akupei nyika yose nokuparadza vose vageremo pamberi penyu. Naizvozvo taityira upenyu hwedu nokuda kwenyu, zvino ndicho chikonzero takaita izvi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tava mumaoko enyu. Itai kwatiri chero zvamunoona zvakanaka uye zvakarurama.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Joshua akavaponesa kubva kuvaIsraeri, ivo vakasavauraya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva iroro Joshua akaita vaGibheoni vatemi vehuni navacheri vemvura yeungano neyearitari yaJehovha panzvimbo yaizosarudzwa naJehovha. Uye ndizvo zvavari kusvikira nanhasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOS.10",
    "number": "10",
