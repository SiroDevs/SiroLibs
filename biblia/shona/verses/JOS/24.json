            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mezvinhu izvi Joshua mwanakomana waNuni, muranda waJehovha, akafa ava namakore zana negumi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakamuviga munyika yenhaka yake, paTimunati Sera, munyika yamakomo yaEfuremu, nechokumusoro kweGomo reGaashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakashumira Jehovha nguva dzose dzoupenyu hwaJoshua, uye napamazuva ose avakuru vakasara vari vapenyu Joshua afa, avo vakaona zvinhu zvose zvakanga zvaitirwa Israeri naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapfupa aJosefa, ayo akanga auyiwa nawo navana vaIsraeri kubva kuIjipiti, akavigwa paShekemu, munzvimbo yakanga yatengwa naJakobho kuvanakomana vaHamori, baba vaShekemu, nezana remari yesirivha. Iyi yakava nhaka yezvizvarwa zvaJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Ereazari mwanakomana waAroni akafa, akavigwa paGibhea munzvimbo yakanga yapiwa mwanakomana wake Finehasi, munyika yamakomo yaEfuremu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
            "verseOrgIds": [
              "JOS.24.33"
            ]
          }
        }
      ]
