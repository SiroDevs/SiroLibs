  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuganhurwa kweNyika yokuMavirira kweJorodhani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino idzi ndidzo nzvimbo dzakagamuchirwa navana vaIsraeri senhaka munyika yeKenani, dzavakagoverwa nomuprista Ereazari, naJoshua mwanakomana waNuni, navakuru vedzimba dzamadzibaba amarudzi avana vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhaka yavo yakagoverwa nemijenya kumarudzi mapfumbamwe nehafu yamarudzi, sezvakanga zvaraiyirwa naJehovha kuna Mozisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akanga apa marudzi maviri ane hafu nhaka yawo kumabvazuva kweJorodhani; asi vaRevhi haana kuvapa nhaka pakati pavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vana vaJosefa vakanga vava marudzi maviri, rwaManase norwaEfuremu. VaRevhi havana kuwana mugove wenyika asi maguta okugara, namafuro amakwai avo nemombe dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vana vaIsraeri vakakamura-kamura nyika, sezvazvakanga zvarayirwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karebhu anopiwa Hebhuroni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vanhu veJudha vakaenda kuna Joshua paGirigari, uye Karebhu, mwanakomana waJefune muKenizi, akati kwaari, \"Imi munoziva zvakataurwa naJehovha kuna Mozisi munhu waMwari, pamusoro pangu nemi, paKadheshi Bharinea.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanga ndava namakore makumi mana pandakatumwa naMozisi muranda waJehovha, paKadheshi Bharinea kundosora nyika, uye ndakadzoka neshoko kwaari sezvandakafunga ini,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi hama dzangu dzakanga dzakwidza neni dzakaodza mwoyo yavanhu, nokutya. Kunyange zvakadaro ini ndakatevera Jehovha Mwari wangu nomwoyo wose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka pazuva iro Mozisi akapika kwandiri akati, 'Nyika yose yauchafamba pairi netsoka dzako, ichava nhaka yako, navana vako nokusingaperi, nokuti wakatevera Jehovha Mwari wangu nomwoyo wako wose.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino ipapo, sokuvimbiswa kwakaitwa naJehovha, akandiraramisa kwamakore makumi mana namashanu, kubva panguva yaakataura izvi kuna Mozisi, vaIsraeri pavaidzungaira murenje. Naizvozvo nhasi ndiri pano, ndava namakore makumi masere namashanu!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakangosimba nanhasi sezvandakanga ndakaita musi wandakatumwa naMozisi; ndichine simba guru rokuti ndinokwanisa kuenda kundorwa sezvandakanga ndakaita kare.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chindipa nyika iyo yamakomo, yandakavimbiswa naJehovha musi iwoyo. Iwe pachako wakanzwa kare kuti vaAnaki vakanga varipo uye kuti maguta avo akanga ari makuru uye akakomberedzwa, asi Jehovha achindibatsira, ndichavadzinga sezvaakataura.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joshua akaropafadza Karebhu, mwanakomana waJefune akamupa Hebhuroni senhaka yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Hebhuroni yakava nhaka yaKarebhu mwanakomana waJefune muKenizi kubvira ipapo, nokuti akatevera Jehovha, Mwari waIsraeri, nomwoyo wake wose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Hebhuroni yaimbonzi Kiriati Abha ichibva pana Abha akanga ano mukurumbira pakati pavaAnaki vose.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 14:15"
      },
      "items": [
        {
          "text": "Ipapo nyika yakazorora pakurwa hondo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
