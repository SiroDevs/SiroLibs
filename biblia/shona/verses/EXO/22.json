  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "EXO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudzivirirwa kweMidziyo kana Pfuma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akaba nzombe kana gwai uye akauraya kana kutengesa anofanira kuripa mombe shanu nokuda kwenzombe uye makwai mana pagwai rimwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana mbavha ikabatwa ichipaza uye ikarohwa ikafa, nyakudzivirira haana mhosva yokuteura ropa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi kana zvikaitika shure kwokubuda kwezuva, anenge ane mhosva yokuteura ropa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:3"
      },
      "items": [
        {
          "text": "\"Mbavha inofanira kudzora zvayaba, asi kana isina chinhu, inofanira kutongeswa kuti iripe umbavha hwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana chipfuwo chakabiwa chikawanikwa chichiri chipenyu muruoko rwake, ingava nzombe kana mbongoro kana gwai, iye anofanira kuripa zvava zviviri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akafudza zvipfuwo zvake mumunda kana mumunda womuzambiringa uye akarega zvipfuwo zvake zvichidya mumunda womunhu, anofanira kudzorera zvakaisvonaka zvinobva mumunda wake kana mumunda wake womuzambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana moto ukapfuta uye ukapararira muzvikwenzi zveminzwa zvokuti unopisa mirwi yezviyo kana zviyo zvimire, kana munda wose, munhu abatidza moto anofanira kudzorera nomuripo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akapa muvakidzani wake sirivha kana zvinhu kuti achengete zvichibva zvabiwa kubva mumba momuvakidzani, mbavha yacho, kana ikabatwa, inofanira kuripa zvakapetwa kaviri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mbavha isina kuwanikwa, muridzi wemba anofanira kumira pamberi pavatongi kuti zvionekwe kana akaisa ruoko rwake pazvinhu zvomumwe munhu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyaya dzose dzokuchengeta zvisiri pamutemo, nzombe, mbongoro, gwai, nguo kana chimwewo zvacho chakarasika chinonzi nomumwe munhu, 'Ndechangu ichi', vaviri ava vanofanira kuuya nenyaya dzavo pamberi pavatongi. Munhu uyo achanzi ane mhosva navatongi anofanira kuripira muvakidzani wake zvakapetwa kaviri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akapa mbongoro, nzombe, gwai kana chipfuwo chipi zvacho kumuvakidzani wake kuti achengete chichibva chafa kana kukuvara kana kutorwa pasina anozviona,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyaya iri pakati pavo inofanira kugadziriswa nokuita mhiko pamberi paJehovha yokuti muvakidzani haana kuisa maoko ake pazvinhu zvomumwe munhu. Muridzi anofanira kugamuchira izvi, uye hapana muripo unodikanwa apa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana chipfuwo chakabiwa kubva kumuvakidzani, iye anofanira kudzorera kumuridzi nomuripo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana chakabvarurwa-bvarurwa nechikara chesango, iye achauyisa zvakasara zvacho zvive umboo uye haazosungirwi kuripa chipfuwo chakabvamburwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akakwereta chipfuwo kubva kumuvakidzani wake uye chikakuvara kana kufa, muridzi wacho asipo, anofanira kuripa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana muridzi ane chipfuwo chacho, akwereta haafaniri kuzoripa. Kana chipfuwo ichi changa chichiripirwa mari yokuchishandisa, mari yakaripwa yacho ndiyo inozozadzisa kurasikirwa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugarisana navamwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana murume akanyengera musikana anenge ari mhandara asina kutsidzira kuti awanikwe uye akavata naye, iye anofanira kubvisa roora, uye achava mukadzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana baba vake vasingadi zvachose kuti vamupe kwaari, anofanira bedzi kubvisa roora rinobvisirwa mhandara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usatendera muroyikadzi kuti ararame.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani anoita chipfuwo mukadzi anofanira kuurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani anobayira kuna mwari upi zvake kunze kwangu anofanira kuparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usabata mutorwa zvakaipa kana kumudzvinyirira, nokuti imi makanga muri vatorwa muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musaitira zvakaipa chirikadzi nenherera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukaita izvozvo uye ivo vakachema kwandiri, zvirokwazvo ndichanzwa kuchema kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwangu kuchamuka, uye ndichakuurayai nomunondo; vakadzi venyu vachava chirikadzi uye vana venyu vachava nherera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana mukakweretesa mari kuno mumwe wavanhu vangu vari pakati penyu vanoshaya, musaita somunhu webasa rokukweretesa; musamuripisa yava nemhindu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ukatora jasi romuvakidzani wako sechitsidzo, uridzorere kwaari zuva rodoka,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti jasi rake ndicho chifukidzo bedzi chaanacho chomuviri wake. Achavata akafukeiko? Paanochema kwandiri, ini ndichanzwa, nokuti ndine tsitsi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usamhura Mwari kana kutuka mutongi wavanhu vako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usarega kupa zvipiriso zvinobva mumatura ako kana muzvisviniro zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:29"
      },
      "items": [
        {
          "text": "\"Unofanira kundipa dangwe ravanakomana vako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muite zvimwe chetezvo kumombe dzenyu nokumakwai enyu. Murege zvigare mazuva manomwe navanamai vazvo, asi muzvipe kwandiri pazuva rorusere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munofanira kuva vanhu vangu vatsvene. Saka musadya nyama yechipfuwo chakabvamburwa nezvikara zvesango, muikandire kumbwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
      ]
    }
