            "number": "33",
            "style": "v",
            "sid": "EXO 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urembedze chidzitiro pazvikorekedzo uye ugoisa areka yeChipupuriro shure kwechidzitiro. Chidzitiro ichi chichaparadzanisa",
          "type": "text",
          "attrs": {
