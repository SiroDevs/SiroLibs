          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urirembedze nezvikorekedzo zvegoridhe pamatanda mana omuunga akafukidzwa negoridhe uye amire pamusoro pezvigadziko zvina zvesirivha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
