  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "EXO 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tabhenakeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite tabhenakeri nezvidzitiro gumi zvomucheka wakarukwa zvakaisvonaka, nowebhuruu, pepuru nomutsvuku, namakerubhi akasonerwa mairi nemhizha dzamabasa amaoko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidzitiro zvose zvinofanira kuva zvakaenzana, zvakareba makubhiti makumi maviri namasere",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "text": "uye makubhiti mana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "text": "paupamhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubatanidze zvidzitiro zvishanu pamwe chete, ugoita zvimwe chetezvo nezvimwe zvishanu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite zvishwe zvomucheka webhuruu kurutivi rwokumucheto wechidzitiro zvakabatanidzwa pamwe chete, uye ugoita zvimwe chete nechidzitiro chokumucheto mune zvimwe zvakabatanidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite zvishwe makumi mashanu pachidzitiro chimwe chete uye makumi mashanu ezvishwe pamucheto wechidzitiro chezvimwe zvakabatanidzwa, zvishwe zvitarisane chimwe nechimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugoita zvikoreko zvegoridhe makumi mashanu uye uzvishandise kubatanidza zvidzitiro pamwe chete kuitira kuti tabhenakeri ive chinhu chimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite zvidzitiro zvamakushe embudzi zvetende riri pamusoro petabhenakeri, zvose zvive gumi nerimwe pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidzitiro zvose zviri gumi nerimwe zvinofanira kuenzana, makubhiti makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "text": "pakureba uye makubhiti mana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "text": "paupamhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubatanidze zvidzitiro zvishanu pamwe chete zviite chinhu chimwe chete uye zvimwe zvitanhatu zvivewo chinhu chimwe chete. Upete chidzitiro chechitanhatu kaviri pamberi petende.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite zvishwe makumi mashanu pamupendero wechidzitiro chokumucheto zvakabatanidzwa uyewo pamupendero wechidzitiro chokumucheto kwezvimwe zvakabatanidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugoita zvikorekedzo zvendarira makumi mashanu ugozviisa muzvishwe kuti zvibatanidze tende pamwe chete chigova chinhu chimwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zviri zvokuwedzera urefu hwezvidzitiro zvetende, hafu yechidzitiro inenge yasara inofanira kurembera necheshure kwetabhenakeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvidzitiro zvetende zvinofanira kurebesa nekubhiti rimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "text": "pamativi ose ari maviri; zvinenge zvasara zvinofanira kurembera pamativi etabhenakeri kuti zvigoifukidza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite chifukidzo chetende chamatehwe amakondobwe akapendwa nezvitsvuku, uye pamusoro paizvozvo chifukidzo chamatehwe emombe dzomugungwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uitire tabhenakeri mapuranga akati twi amatanda omuunga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puranga rimwe nerimwe rinofanira kureba makubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "text": "uye kubhiti nehafu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "text": "paupamhi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nembambo mbiri dzakamiswa dzakatarisana. Uite mapuranga ose etabhenakeri nenzira iyoyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite mapuranga makumi maviri okurutivi rwezasi rwetabhenakeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye uite zvigadziko zvesirivha makumi mana kuti zvive pasi pawo, zvigadziko zviviri papuranga rimwe nerimwe, chimwe chete pasi pembambo imwe neimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno rumwe rutivi, rwokumusoro kwetabhenakeri, uite mapuranga makumi maviri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye zvigadziko zvesirivha makumi mana. Zviviri zviri pasi pepuranga rimwe nerimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite mapuranga matanhatu kurutivi rwokumucheto cheto, ndiko kumavirira etabhenakeri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye uite mapuranga maviri amakona okumucheto cheto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamakona maviri aya, anofanira kuva maviri maviri kubva pasi kusvikira kumusoro, uye agadzikwe mumhete imwe chete; ose ari maviri ngaave saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka pachava namapuranga masere uye zvigadziko zvesirivha gumi nezvitanhatu, zviviri pasi pepuranga rimwe nerimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uyewo uite mbariro dzamatanda omuunga: shanu dzamapuranga okuno rumwe rutivi rwetabhenakeri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "shanu dzaaya ari pano rumwe rutivi, uye shanu dzamapuranga okumavirira, kumucheto cheto kwetabhenakeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbariro yapakati inofanira kutandavara kubva kumucheto kusvikira kuno mumwe mucheto napakati pamapuranga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufukidze mapuranga negoridhe uye ugoita mhete dzegoridhe kuti dzigobata mbariro. Uyewo ufukidze mbariro negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Umise tabhenakeri maererano nomufananidzo wawakaratidzwa mugomo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
            "verseOrgIds": [
              "EXO.26.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite chidzitiro chebhuruu, nechepepuru nechitsvuku chomucheka wakarukwa zvakaisvonaka, namakerubhi akasonerwapo nenyanzvi yokusona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
