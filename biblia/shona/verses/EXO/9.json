              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akabva pana Faro akabuda muguta. Akatambanudzira maoko ake kuna Jehovha; kutinhira nechimvuramabwe zvakamira, uye mvura haina kuzonayazve panyika.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akati aona kuti mvura nechimvuramabwe uye nokutinhira zvapera, akatadzazve: Iye namachinda ake vakaomesa mwoyo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mwoyo waFaro wakaoma uye akasada kutendera vaIsraeri kuenda, sokutaura kwakanga kwaita Jehovha kubudikidza naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
