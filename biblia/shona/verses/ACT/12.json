  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ACT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chishamiso choKubuda Mutorongo kwaPetro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakanga iri nguva inenge imwe cheteyo Mambo Herodhi paakasunga vamwe vaiva nhengo dzekereke, achida kuvatambudza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga aita kuti Jakobho mukoma waJohani aurayiwe nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.2",
            "verseOrgIds": [
              "ACT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakaona kuti izvozvo zvakafadza vaJudha, akapfuurira mberi akandosungawo Petro. Izvi zvakaitika panguva yoMutambo weZvingwa Zvisina Mbiriso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.3",
            "verseOrgIds": [
              "ACT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokumusunga, akamuisa mutorongo, akaita kuti arindwe namapoka mana avarwi, boka rimwe nerimwe riina varwi vana. Herodhi akanga achida kumumisa padare rokutongwa shure kwePasika.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.4",
            "verseOrgIds": [
              "ACT.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Petro akachengetwa mutorongo, asi kereke yakanga ichimunyengeterera zvikuru kuna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku hwaaifanira kumiswa pamberi pedare naHerodhi husati hwasvika, Petro akanga avete pakati pavarwi vaviri, akasungwa nengetani mbiri, uye varindi vakanga vakamira vakarinda vari pamukova.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.6",
            "verseOrgIds": [
              "ACT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo mutumwa waShe akaonekwa uye chiedza chakavhenekera muchitokisi. Akarova Petro parutivi ndokumumutsa achiti, \"Kurumidza muka!\" Ipapo ngetani dzakawa pamaoko aPetro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.7",
            "verseOrgIds": [
              "ACT.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa akati kwaari, \"Pfeka nguo dzako neshangu dzako.\" Uye Petro akaita saizvozvo. Mutumwa akati kwaari, \"Monera jasi rako ubve wanditevera.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.8",
            "verseOrgIds": [
              "ACT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akamutevera achibuda mutorongo, asi akanga asingazivi kuti zvaiitwa nomutumwa zvakanga zvichitoitika; akafunga kuti aiona chiratidzo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.9",
            "verseOrgIds": [
              "ACT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapfuura napavarindi vokutanga nevechipiri ndokusvika pasuo resimbi rakanga rakatarira kuguta. Rakangovazarukira roga, vakapinda nepariri. Vakati vafamba kusvika kumagumo kweimwe nzira, pakarepo mutumwa akamusiya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.10",
            "verseOrgIds": [
              "ACT.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Petro akapengenuka akati, \"Zvino ndava kuziva ndisingatongokahadziki kuti Ishe atuma mutumwa wake uye andinunura pamaoko aHerodhi napazvinhu zvose zvanga zvakatarisirwa navanhu vechiJudha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.11",
            "verseOrgIds": [
              "ACT.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakati zvajeka kwaari, akaenda kumba kwaMaria mai vaJohani, ainziwo Mako, uko kwakanga kwakaungana vanhu vazhinji vachinyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akagogodza pamukova wokunze, musikana ainzi Rodha akauya kuzodaira kugogodza uku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati anzwa kuti inzwi raPetro, akafara zvikuru akadzokera achimhanya asati atongozarura musuo akavaudza akati, \"Petro ari pamukova!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwaari, \"Wava kupenga.\" Paakaramba achisimbisisa kuti zvakanga zviri izvo, ivo vakati, \"Anofanira kunge ari mutumwa wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Petro akaramba achigogodza, uye vakati vazarura mukova, vakamuona vakashamiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akaninira maoko ake kwavari kuti vanyarare ndokurondedzera kuti Ishe akanga amubudisa sei mutorongo. Akati, \"Muudze Jakobho nehama pamusoro paizvozvi.\" Ipapo akabva akaenda kune imwe nzvimbo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani acho, kwakava nebope guru pakati pavarwi vachida kuziva kuti chii chakanga chaitika kuna Petro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Herodhi amutsvakisisa kwazvo uye asina kumuwana, akanyatsobvunzisisa varindi ndokubva arayira kuti vaurayiwe. Ipapo Herodhi akabva kuJudhea akaenda kuKesaria akandogarako kwechinguva.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaHerodhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga atsamwirana navanhu veTire neSidhoni, ndokubva vabatana pamwe chete vakauya kwaari kuti vataure naye. Vakati vawana rutsigiro rwaBhurasto, muranda akatendeka wamambo, vakakumbira runyararo, nokuti vaipona nenyika yamambo, nokuti ndiko kwavaiwana zvokudya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.20",
            "verseOrgIds": [
              "ACT.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rakanga ratarwa, Herodhi akapfeka nguo dzake dzoushe, akagara pachigaro chake choushe akataura kuvanhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadanidzira vachiti, \"Iri inzwi ramwari, kwete romunhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo, nokuti Herodhi haana kurumbidza Mwari, mutumwa waShe akamurova, akadyiwa nehonye uye akafa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.23",
            "verseOrgIds": [
              "ACT.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye shoko raMwari rakaramba richikura uye richipararira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.24",
            "verseOrgIds": [
              "ACT.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhanabhasi naSauro vakati vapedza basa ravo, vakadzokera kuJerusarema, vakatorawo Johani, ainzi Mako.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.25",
            "verseOrgIds": [
              "ACT.12.25"
            ]
          }
        }
      ]
    }
  ],
