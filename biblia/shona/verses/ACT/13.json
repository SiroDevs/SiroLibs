  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ACT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhanabhasi naSauro Vanotumwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukereke yapaAndioki maiva navaprofita navadzidzisi vaiti: Bhanabhasi, Simeoni ainzi Nigeri, Rusiasi wokuSairini, Manaeni (akanga arerwa naHerodhi mubati) naSauro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.1",
            "verseOrgIds": [
              "ACT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vachinamata Ishe uye vachitsanya, Mweya Mutsvene akati, \"Nditsaurirei Bhanabhasi naSauro kuti vabate basa randakavadanira.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.2",
            "verseOrgIds": [
              "ACT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakati vapedza kutsanya nokunyengetera, vakaisa maoko avo pamusoro pavo vakavatuma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.3",
            "verseOrgIds": [
              "ACT.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vapostori vanoparidza paSaipurasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava vaviri vakati vatumwa naMweya Mutsvene parwendo rwavo, vakaburuka vakaenda kuSerusia, vakazobvako vakakwira chikepe ndokuenda kuSaipurasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.4",
            "verseOrgIds": [
              "ACT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika paSaramisi, vakaparidza shoko raMwari musinagoge ravaJudha. Johani akanga achivabatsira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.5",
            "verseOrgIds": [
              "ACT.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakafamba nomuchiwi chose kudzamara vasvika kuPafosi. Vakasangana neimwe nʼanga yechiJudha ikoko, uye akanga ari muprofita wenhema ainzi Bhari Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.6",
            "verseOrgIds": [
              "ACT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanga ari muchengeti womubati wenyika ainzi Segio Paurusi. Mubati akanga ari murume akachenjera, akadana Bhanabhasi naSauro nokuti aida kunzwa shoko raMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.7",
            "verseOrgIds": [
              "ACT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Erimasi nʼanga (nokuti ndizvo zvaireva zita rake) akavapikisa akaedza kutsausa mubati uyu pakutenda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.8",
            "verseOrgIds": [
              "ACT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akanga achinziwo Pauro, azere noMweya Mutsvene akatarisisa Erimasi akati,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.9",
            "verseOrgIds": [
              "ACT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe uri mwana wadhiabhori nomuvengi wezvinhu zvose zvakarurama! Uzere nokunyengera kwose namano akaipa. Hausi kuzorega here kumonyorotsa nzira dzakarurama dzaShe?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.10",
            "verseOrgIds": [
              "ACT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ruoko rwaShe rwava pamusoro pako. Uchava bofu, uye uchatadza kuona chiedza chezuva kwechinguva.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.11",
            "verseOrgIds": [
              "ACT.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 13:11"
      },
      "items": [
        {
          "text": "Pakarepo mhute nerima zvakauya pamusoro pake, akadzivaira pose pose achitsvaka mumwe munhu angamutungamirira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.11",
            "verseOrgIds": [
              "ACT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubati akati aona zvakanga zvaitika akatenda nokuti akashamiswa nedzidziso yezvaShe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.12",
            "verseOrgIds": [
              "ACT.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro anoparidza paAndioki yePisidhia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachibva paPafosi, Pauro navanhu vaaifamba navo vakakwira chikepe vakaenda kuPega muPamufiria, uye vava ikoko Johani akavasiya akadzokera kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.13",
            "verseOrgIds": [
              "ACT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachibva kuPega vakapfuurira kuAndioki yePisidhia. Nomusi weSabata vakapinda musinagoge vakasvikogara pasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.14",
            "verseOrgIds": [
              "ACT.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokuverengwa kwoMurayiro naVaprofita, vabati vomusinagoge vakatuma shoko kwavari vachiti, \"Hama, kana mune shoko rokukuridzira vanhu, tapota taurai henyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.15",
            "verseOrgIds": [
              "ACT.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro akasimuka, akaninira noruoko rwake akati, \"Varume veIsraeri nemi mose vedzimwe ndudzi vanonamata Mwari, nditeererei!",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.16",
            "verseOrgIds": [
              "ACT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari wavanhu veIsraeri akasarudza madzibaba edu; akaita kuti vanhu vabudirire panguva yavaigara muIjipiti, akavabudisa munyika iyo nesimba guru,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.17",
            "verseOrgIds": [
              "ACT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "akava nomwoyo murefu namaitiro avo kwamakore anenge makumi mana vari mugwenga,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.18",
            "verseOrgIds": [
              "ACT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakunda ndudzi nomwe muKenani akapa nyika yavo kuvanhu vake kuti ive nhaka yavo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.19",
            "verseOrgIds": [
              "ACT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakatora makore anenge mazana mana namakumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 13:20"
      },
      "items": [
        {
          "text": "\"Shure kwaizvozvi, Mwari akavapa vatongi kusvikira panguva yaSamueri muprofita.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.20",
            "verseOrgIds": [
              "ACT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanhu vakakumbira mambo, akavapa Sauro mwanakomana waKishi, worudzi rwaBhenjamini, uyo akatonga kwamakore makumi mana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.21",
            "verseOrgIds": [
              "ACT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge abvisa Sauro, akagadza Dhavhidhi kuti ave mambo wavo. Iye akapupura pamusoro pake achiti, 'Ndawana Dhavhidhi mwanakomana waJese murume wapamwoyo pangu; iye achaita zvinhu zvose zvandinoda kuti aite.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.22",
            "verseOrgIds": [
              "ACT.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubva kuzvizvarwa zvomurume uyu Mwari akavigira vaIsraeri Muponesi Jesu, sezvaakanga avimbisa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.23",
            "verseOrgIds": [
              "ACT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu asati auya, Johani akaparidza kutendeuka norubhabhatidzo kuvanhu vose veIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.24",
            "verseOrgIds": [
              "ACT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johani paakanga ava kupedzisa basa rake, akati, 'Munofunga kuti ndini ani? Handizi iye uya. Kwete, asi iye ari kuuya shure kwangu, ndiye wandisingakodzeri kusunungura shangu dzake.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.25",
            "verseOrgIds": [
              "ACT.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hama dzangu, vana vaAbhurahama nemi vedzimwe ndudzi vanotya Mwari, shoko iri roruponeso rakatumirwa kwatiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu veJerusarema navatongi vavo havana kuziva Jesu, asi pakumupa mhaka kwavo vakazadzisa mashoko avaprofita anoverengwa Sabata rimwe nerimwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange vasina kuwana hwaro chaihwo hwokuti atongerwe rufu, vakakumbira Pirato kuti amuuraye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.28",
            "verseOrgIds": [
              "ACT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vapedza zvose zvakanga zvakanyorwa pamusoro pake, vakamuburutsa pamuti vakamuradzika muguva.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari akamumutsa kubva kuvakafa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akaonekwa mazuva mazhinji naavo vakafamba naye kubva kuGarirea kusvikira kuJerusarema. Ndivo zvapupu zvake zvino kuvanhu vokwedu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tiri kukuudzai nhau dzakanaka kuti: Zvakavimbiswa madzibaba edu naMwari,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "akazvizadzisa kwatiri isu, vana vavo, nokumutsa Jesu kubva kuvakafa. Sezvazvakanyorwa muPisarema rechipiri zvichinzi:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 13:33"
      },
      "items": [
        {
          "text": "\" 'Ndiwe Mwanakomana wangu;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 13:33"
      },
      "items": [
        {
          "text": "nhasi ndava baba vako.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chokwadi chokuti Mwari akamumutsa kubva kuvakafa, akasazomboora, chinotaurwa mumashoko aya anoti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.34",
            "verseOrgIds": [
              "ACT.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 13:34"
      },
      "items": [
        {
          "text": "\" 'Ndichakupa maropafadzo matsvene, uye echokwadi akavimbiswa kuna Dhavhidhi.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.34",
            "verseOrgIds": [
              "ACT.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro zvinotaurwa pane rimwe pisarema kuti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 13:35"
      },
      "items": [
        {
          "text": "\" 'Hamungaregi Mutsvene wenyu achiona kuora.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti Dhavhidhi akati aita kuda kwaMwari pamazuva ake, akavata; akavigwa namadzibaba ake uye muviri wake wakaora.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.36",
            "verseOrgIds": [
              "ACT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi uyo akamutswa naMwari haana kuona kuora.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, hama dzangu, ndinoda kuti muzive kuti kubudikidza naJesu, kukanganwirwa kwezvivi kunoparidzwa kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.38",
            "verseOrgIds": [
              "ACT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubudikidza naye munhu wose anotenda anoruramiswa pazvinhu zvose zvamanga musingagoni kururamiswa pazviri nomurayiro waMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.39",
            "verseOrgIds": [
              "ACT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjerai kuti zvakataurwa navaprofita zvirege kuitika kwamuri, zvinoti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.40",
            "verseOrgIds": [
              "ACT.13.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Tarirai imi vaseki,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 13:41"
      },
      "items": [
        {
          "text": "mushamiswe uye muparare,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 13:41"
      },
      "items": [
        {
          "text": "nokuti ndiri kuzoita chimwe chinhu pamazuva enyu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 13:41"
      },
      "items": [
        {
          "text": "chamusingazombotendi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 13:41"
      },
      "items": [
        {
          "text": "kunyange dai mumwe munhu akakuudzai.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro naBhanabhasi vava kubuda musinagoge, vanhu vakavakoka kuti vazotaurazve pamusoro pezvinhu izvi paSabata raizotevera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.42",
            "verseOrgIds": [
              "ACT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungano rakati rapararira, vazhinji vavaJudha navamwe vakanga vatendeukira kuchiJudha vakatevera Pauro naBhanabhasi, ivo vakataura navo uye vakavakurudzira kuti varambe vari munyasha dzaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "PaSabata rakatevera rinenge guta rose rakaungana kuzonzwa shoko raShe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.44",
            "verseOrgIds": [
              "ACT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vakati vaona vanhu vazhinji, vakazadzwa negodo vakataura zvakaipa pamusoro pezvakanga zvichitaurwa naPauro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.45",
            "verseOrgIds": [
              "ACT.13.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro naBhanabhasi vakavapindura vasingatyi vakati, \"Zvanga zvakafanira kuti titaure shoko raMwari kwamuri imi kutanga. Sezvo mariramba uye mukasazviona savanhu vakafanira upenyu husingaperi, tava kuenda zvino kune veDzimwe Ndudzi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.46",
            "verseOrgIds": [
              "ACT.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti izvi ndizvo zvakarayirwa kwatiri naShe achiti:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 13:47"
      },
      "items": [
        {
          "text": "\" 'Ndakakuitai chiedza kune veDzimwe Ndudzi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 13:47"
      },
      "items": [
        {
          "text": "kuti muvigire migumo yenyika ruponeso.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
              "ACT.13.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "VeDzimwe Ndudzi vakati vanzwa izvozvo, vakafara uye vakakudza shoko raShe; uye vose vakanga vakatarirwa upenyu husingaperi vakatenda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.48",
            "verseOrgIds": [
              "ACT.13.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "ACT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raShe rakapararira mudunhu rose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.49",
            "verseOrgIds": [
              "ACT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaJudha vakakurudzira vakadzi vaitya Mwari uye vaikudzikana navarume vairemekedzwa veguta, vakamutsira Pauro naBhanabhasi kutambudzwa, uye vakavadzinga mudunhu ravo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.50",
            "verseOrgIds": [
              "ACT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakazunza guruva patsoka dzavo vachiratidza kusafara pamusoro pavo ndokubva vaenda kuIkoniamu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vadzidzi vakazadzwa nomufaro uye noMweya Mutsvene.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.52",
            "verseOrgIds": [
              "ACT.13.52"
            ]
          }
        }
      ]
    }
  ],
