  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MRK 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waVarimi Vakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino akatanga kutaura navo nemifananidzo achiti, \"Mumwe murume akasima munda wemizambiringa. Akaukomberedza noruzhowa, akachera gomba rechisviniro chewaini uye akavaka shongwe yokurinda. Ipapo akauchengetesa kuvarimi akaenda parwendo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.1",
            "verseOrgIds": [
              "MRK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakukohwa akatuma muranda kumuchengeti womunda kuti andotora kwavari mimwe michero yomunda wemizambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.2",
            "verseOrgIds": [
              "MRK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakamubata, vakamurova vakamudzosa asina chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.3",
            "verseOrgIds": [
              "MRK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatuma mumwe muranda; vakarova murume uyu mumusoro vakamunyadzisa zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.4",
            "verseOrgIds": [
              "MRK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapamhazve kutuma mumwe, uye uyo vakamuuraya. Akatuma vamwe vazhinji; vamwe vavo vakavarova, vamwe vakavauraya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.5",
            "verseOrgIds": [
              "MRK.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akanga asara nomumwe chete wokutuma, mwanakomana, waaida kwazvo. Akamutuma kwokupedzisira achiti, 'Vacharemekedza mwanakomana wangu.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.6",
            "verseOrgIds": [
              "MRK.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi vachengeti vakataurirana vakati, 'Uyu ndiye mudyi wenhaka. Uyai, ngatimuurayei, nhaka igova yedu.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.7",
            "verseOrgIds": [
              "MRK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakamutora vakamuuraya, vakamurasira kunze kwomunda wemizambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.8",
            "verseOrgIds": [
              "MRK.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino muridzi womunda wemizambiringa achaiteiko? Achauya agouraya vachengeti vaya vomunda agopa munda wemizambiringa kuna vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.9",
            "verseOrgIds": [
              "MRK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, hamuna kuverenga here rugwaro urwu runoti:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.10",
            "verseOrgIds": [
              "MRK.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 12:10"
      },
      "items": [
        {
          "text": "\" 'Dombo rakarambwa navavaki",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.10",
            "verseOrgIds": [
              "MRK.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 12:10"
      },
      "items": [
        {
          "text": "ndiro rava musoro wekona;",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.10",
            "verseOrgIds": [
              "MRK.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe akaita izvi,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.11",
            "verseOrgIds": [
              "MRK.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 12:11"
      },
      "items": [
        {
          "text": "uye zvinoshamisa pamberi pedu'?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.11",
            "verseOrgIds": [
              "MRK.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakatsvaka nzira yokumusunga nayo nokuti vakaziva kuti akanga ataura mufananidzo uyu pamusoro pavo. Asi vakanga vachitya vanhu vazhinji; saka vakamusiya vakaenda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuripa Mutero kuna Kesari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo vakatuma vamwe vavaFarisi navaHerodhi kuna Jesu kuti vandomubata namashoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.13",
            "verseOrgIds": [
              "MRK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya kwaari vakati, \"Mudzidzisi, tinoziva kuti muri munhu akarurama. Imi hamutsauswi navanhu, nokuti hamuteereri kuti ndivanaani, asi munodzidzisa nzira yaMwari zviri maererano nechokwadi. Zvakanaka here kuripa mutero kuna Kesari kana kuti kwete?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.14",
            "verseOrgIds": [
              "MRK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinofanira kuripa here kana kuti tinofanira kuregera?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.15",
            "verseOrgIds": [
              "MRK.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 12:15"
      },
      "items": [
        {
          "text": "Asi Jesu achiziva kunyengera kwavo, akati, \"Seiko muchiedza kunditeya? Ndipei kuno dhenari ndirione.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.15",
            "verseOrgIds": [
              "MRK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya nemari yacho, iye akavabvunza akati, \"Mufananidzo uyu ndowani? Uye runyoro urwu ndorwani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.16",
            "verseOrgIds": [
              "MRK.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 12:16"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"NdezvaKesari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.16",
            "verseOrgIds": [
              "MRK.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akati kwavari, \"Ipai Kesari zvaKesari uye kuna Mwari zvaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 12:17"
      },
      "items": [
        {
          "text": "Uye vakashamiswa naye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwanana paKumuka kwaVakafa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaSadhusi, vaya vanoti hakuna kumuka kwavakafa, vakauya kwaari nomubvunzo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Mudzidzisi, Mozisi akatinyorera kuti kana mukoma womurume akafa uye akasiya mukadzi asina vana, mununʼuna wake anofanira kuwana chirikadzi iyi kuti amutsire mukoma wake vana.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.19",
            "verseOrgIds": [
              "MRK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kwakanga kuna vanakomana vomunhu mumwe chete vanomwe. Wokutanga akawana uye akafa akasasiya vana.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.20",
            "verseOrgIds": [
              "MRK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechipiri akatora chirikadzi iya, asi naiyewo akafa, akasasiya vana. Ndizvo zvakaitikawo kuno wechitatu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.21",
            "verseOrgIds": [
              "MRK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviripo ndezvokuti, hakuna pavanomwe ava akasiya kana mwana. Pakupedzisira mukadzi akazofawo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.22",
            "verseOrgIds": [
              "MRK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumuka kwavakafa, achava mukadzi waani, sezvo akanga akawanikwa navanomwe ava?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.23",
            "verseOrgIds": [
              "MRK.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Hamuna kurasika here nokuda kwokusaziva Magwaro kana simba raMwari?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.24",
            "verseOrgIds": [
              "MRK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakafa pavanomuka, havazowani uye havazowaniswi; vachaita savatumwa vokudenga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.25",
            "verseOrgIds": [
              "MRK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pamusoro pokumuka kwavakafa, hamuna kuverenga here mubhuku raMozisi, panhoroondo dzegwenzi raipfuta, kuti Mwari akati kwaari, 'Ndini Mwari waAbhurahama, Mwari waIsaka, naMwari waJakobho'?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.26",
            "verseOrgIds": [
              "MRK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haazi Mwari wavakafa, asi wavapenyu. Makarasika kwazvo!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murayiro Mukuru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavadzidzisi vomurayiro akauya akavanzwa vachitaurirana. Akaona kuti Jesu akanga avapa mhinduro yakanaka, akamubvunza akati, \"Pamirayiro yose, ndoupiko unonyanya kukosha?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Unonyanya kukosha, ndouyu: 'Inzwa, iwe Israeri, Ishe Mwari wedu, ndiye Ishe mumwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ida Ishe Mwari wako nomwoyo wako wose uye nomweya wako wose nokufunga kwako kwose uye nesimba rako rose.'",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechipiri ndouyu: 'Ida wokwako sezvaunozvida iwe.' Hakuna murayiro mukuru kupfuura iyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume akapindura akati, \"Mapindura zvakanaka, mudzidzisi. Mataura chokwadi pamataura kuti Mwari ndiye mumwe chete uye hakuna mumwe kunze kwake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumuda nomwoyo wako wose, nokunzwisisa kwako kwose uye nesimba rako rose, uye kuda wokwako sezvaunozvida iwe ndizvo zvinonyanya kukosha kupfuura zvipiriso zvose zvinopiswa, nezvibayiro.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati aona kuti akanga apindura nokuchenjera, akati kwaari, \"Hausi kure noumambo hwaMwari.\" Uye kubvira ipapo hakuna munhu akazotsunga kumubvunza mimwezve mibvunzo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristu Mwanakomana Waani?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu paakanga achidzidzisa ari mutemberi, akabvunza akati, \"Seiko vadzidzisi vomurayiro vachiti Kristu mwanakomana waDhavhidhi?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi pachake achitaura noMweya Mutsvene, akati:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 12:36"
      },
      "items": [
        {
          "text": "\" 'Ishe akati kuna She wangu:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 12:36"
      },
      "items": [
        {
          "text": "\"Gara kuruoko rwangu rworudyi",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 12:36"
      },
      "items": [
        {
          "text": "kusvikira ndaisa vavengi vako",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 12:36"
      },
      "items": [
        {
          "text": "pasi petsoka dzako.\" '",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi pachake anomuti 'Ishe.' Zvino anogova mwanakomana wake seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.37",
            "verseOrgIds": [
              "MRK.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 12:37"
      },
      "items": [
        {
          "text": "Vanhu vazhinji vakateerera kwaari nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.37",
            "verseOrgIds": [
              "MRK.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakudzidzisa kwake, Jesu akati, \"Chenjererai vadzidzisi vomurayiro. Vanoda kufamba-famba vakapfeka nguo refu uye vachikwaziswa mumisika,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.38",
            "verseOrgIds": [
              "MRK.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kuti vave nezvigaro zvakakwirira kwazvo mumasinagoge uye nenzvimbo dzinokudzwa pamabiko.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.39",
            "verseOrgIds": [
              "MRK.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoparadza dzimba dzechirikadzi uye vanoita minyengetero mirefu kuti vaonekwe navanhu. Vanhu vakadai vacharangwa zvikuru kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.40",
            "verseOrgIds": [
              "MRK.12.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chipo cheChirikadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akagara pasi akatarisana nenzvimbo yaiiswa zvipo uye akatarisisa vanhu vazhinji vachiisa mari yavo muchivigiro chemari mutemberi. Vapfumi vazhinji vaikandamo mari zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
            "verseOrgIds": [
              "MRK.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi chirikadzi yakasvika ikaisamo tumari tuviri tuduku.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
              "MRK.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akadana vadzidzi vake kwaari, akati, \"Ndinokuudzai chokwadi, chirikadzi murombo iyi yaisa mari zhinji muchivigiro kupfuura vamwe vose.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.43",
            "verseOrgIds": [
              "MRK.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vapa kubva paupfumi hwavo; asi chirikadzi iyi yapa, ichitora pakushayiwa kwayo, yaisa zvose zvayanga ichifanira kurarama nazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.44",
            "verseOrgIds": [
              "MRK.12.44"
            ]
          }
        }
      ]
    }
  ],
