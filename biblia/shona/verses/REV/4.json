        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chigaro choUshe choKudenga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi ndakatarisa, uye ipapo pamberi pangu pakanga pano mukova wakanga wakazaruka kudenga. Uye inzwi randakanzwa richitaura kwandiri rakanga rakaita sehwamanda, rakati, \"Kwira kuno, ndigokuratidza zvinofanira kuitika shure kwaizvozvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo ndakava muMweya, uye ipapo pamberi pangu pakava nechigaro choushe kudenga, nomumwe akanga agere pamusoro pacho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akanga agerepo akanga akaita sedombo rejasipa nekarineri. Muraravungu, wakanga wakafanana nedombo reemaradhi, wakanga wakakomberedza chigaro choushe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvigaro zvoushe makumi maviri nezvina zvakanga zvakakomberedza chigaro choushe, uye vakanga vagere pamusoro pazvo vakanga vari vakuru makumi maviri navana. Vakanga vakapfeka nguo chena uye vane korona dzegoridhe mumisoro yavo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pachigaro choushe pakabuda kupenya kwemheni, kudengenyeka uye namaungira okutinhira. Pamberi pechigaro choushe, pakanga pane mwenje minomwe yaipfuta. Iyi ndiyo mweya minomwe yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamberi pechigaro choushe paivawo nezvaitarisika segungwa regirazi, rakachena sedombo rekristaro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 4:6"
      },
      "items": [
        {
          "text": "Pakati, paipoteredza chigaro choushe, pakanga pane zvisikwa zvina, uye zvakanga zvakafukidzwa nameso, mberi neshure.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisikwa chipenyu chokutanga chakanga chakaita seshumba, chechipiri chakanga chakaita senzombe, chechitatu chakanga chine chiso sechomunhu, chechina chakanga chakaita segondo rinobhururuka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwe nechimwe chezvisikwa zvipenyu zvina chakanga china mapapiro matanhatu uye chakanga chakafukidzwa nameso kumativi ose, kunyange pasi pamapapiro acho. Masikati nousiku hazvina kumborega kuti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 4:8"
      },
      "items": [
        {
          "text": "\"Mutsvene, mutsvene, mutsvene,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 4:8"
      },
      "items": [
        {
          "text": "ndiye Ishe Mwari Wamasimba Ose,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 4:8"
      },
      "items": [
        {
          "text": "akanga aripo, aripo, uye achazouya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose paipa zvisikwa zvipenyu mbiri, kukudzwa nokuvonga kuna iye anogara pachigaro choushe, iye anogara nokusingaperi-peri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakuru makumi maviri navana vaiwira pasi pamberi pake iye anogara pachigaro choushe, uye vaimunamata iye anogara nokusingaperi-peri. Vaikanda korona dzavo pamberi pechigaro choushe vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Makafanira, Ishe naMwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 4:11"
      },
      "items": [
        {
          "text": "kugamuchira kubwinya nokukudzwa, uye nesimba,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 4:11"
      },
      "items": [
        {
          "text": "nokuti makasika zvinhu zvose,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 4:11"
      },
      "items": [
        {
          "text": "nokuda kwenyu zvakasikwa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 4:11"
      },
      "items": [
        {
          "text": "uye zviripo nokuda kwenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.11",
            "verseOrgIds": [
              "REV.4.11"
            ]
          }
        }
      ]
    }
  ],
