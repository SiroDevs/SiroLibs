              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakaona chikara namadzimambo enyika uye nehondo dzavo dzakaungana pamwe chete kuti dzindorwa nomutasvi akanga ari pabhiza uye nehondo yake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
