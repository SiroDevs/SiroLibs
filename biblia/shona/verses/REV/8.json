  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "REV 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chisimbiso cheChinomwe noMudziyo weZvinonhuhwira weGoridhe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati azarura chisimbiso chechinomwe, kwakava nokunyarara kudenga kwenguva inenge hafu yeawa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndakaona vatumwa vanomwe vanomira pamberi paMwari, uye vakapiwa hwamanda nomwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe mutumwa, akanga ano mudziyo wezvinonhuhwira wegoridhe, akauya akamira paaritari. Akapiwa zvinonhuhwira zvizhinji zvokuzopa, pamwe chete neminyengetero yavatsvene vose, paaritari yegoridhe pamberi pechigaro choushe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utsi hwezvinonhuhwira, pamwe chete neminyengetero yavatsvene, zvakakwira pamberi paMwari kubva muruoko rwomutumwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mutumwa akatora mudziyo wezvinonhuhwira, akauzadza nomoto waibva paaritari, akaukanda panyika; uye ipapo kwakaita mabhananʼana, maungira okutinhira, kupenya kwemheni nokudengenyeka kwenyika.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hwamanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vatumwa vanomwe vakanga vane hwamanda nomwe vakagadzirira kudziridza.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa wokutanga akaridza hwamanda yake, ipapo kukauya chimvuramabwe nomoto zvakavhenganiswa neropa, uye zvikakandwa pamusoro penyika. Chikamu chimwe chete muzvitatu chenyika chakapiswa, chikamu chimwe chete muzvitatu chemiti chikapiswa, uye uswa hwose hunyoro hukapiswa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa wechipiri akaridza hwamanda yake uye chimwe chinhu chakanga chakaita segomo guru, raipfuta rose, chikakandwa mugungwa. Chikamu chimwe chete muzvitatu chegungwa chakashanduka chikava ropa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "chikamu chimwe chete muzvitatu chezvisikwa zvipenyu zviri mugungwa chikafa, uye chikamu chimwe chete muzvitatu chezvikepe chikaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa wechitatu akaridza hwamanda yake, uye nyeredzi huru, yakanga ichipfuta somwenje, yakawa kubva kudenga pamusoro pechikamu chimwe chete muzvitatu chenzizi nezvitubu zvemvura,",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "zita renyeredzi rainzi Chinovava. Chikamu chimwe chete muzvitatu chemvura zhinji chakavava, uye vanhu vazhinji vakafa nokuda kwemvura yakanga yovava.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa wechina akaridza hwamanda yake, uye chikamu chimwe chete muzvitatu chezuva chikarohwa, chikamu chimwe chete muzvitatu chomwedzi, nechikamu chimwe chete muzvitatu chenyeredzi, zvokuti chikamu chimwe chete muzvitatu chazvo chakashanduka chikasviba. Chikamu chimwe chete muzvitatu chezuva iro chakanga chisina chiedza, uyewo nechikamu chimwe chete muzvitatu chousiku uhwo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakatarira, ndakanzwa gondo rakanga richibhururuka pakati pomuchadenga richirira nenzwi guru richiti, \"Nhamo! Nhamo! Nhamo kuna vanogara panyika, nokuda kwehwamanda dzava kuda kuzoridzwa navamwe vatumwa vatatu!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
      ]
    }
  ],
