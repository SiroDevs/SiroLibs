  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "REV 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanhu Zviuru Zana naMakumi Mana neZvina vanoiswa Chisimbiso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi, ndakaona vatumwa vana vamire pamakona mana enyika, vakabata mhepo ina dzenyika kuti vadzivise mhepo ipi zvayo kuvhuvhuta panyika kana pamusoro pegungwa kana pamuti upi zvawo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakaona mumwe mutumwa achibva kumabvazuva, ane chisimbiso chaMwari mupenyu. Akadanidzira nenzwi guru kuvatumwa vana vakanga vapiwa simba rokuti vatadzire nyika negungwa akati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musatadzira nyika kana gungwa kana miti kusvikira taisa chisimbiso pahuma dzavaranda vaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakanzwa kuwanda kwaavo vakanga vaiswa chisimbiso: zviuru zana namakumi mana nezvina, kubva kumarudzi ose avaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kurudzi rwaJudha, zviuru gumi nezviviri vakaiswa chisimbiso,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:5"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaRubheni, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:5"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaGadhi, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaAsheri, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:6"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaNafutari, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:6"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaManase, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaSimeoni, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:7"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaRevhi, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:7"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaIsakari, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva kurudzi rwaZebhuruni, zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:8"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaJosefa zviuru gumi nezviviri,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "REV 7:8"
      },
      "items": [
        {
          "text": "kubva kurudzi rwaBhenjamini zviuru gumi nezviviri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vazhinji zhinji vakanga vakapfeka nguo chena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi ndakatarira uye ndikaona ipapo pamberi pangu vazhinji zhinji vakanga vasingagoni kuverengwa, vaibva kundudzi dzose, nokumarudzi ose, navanhu vemitauro yose, vamire pamberi pechigaro choushe napamberi peGwayana. Vakanga vakapfeka nguo chena uye vakabata matavi emichindwe mumaoko avo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakadanidzira nenzwi guru vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:10"
      },
      "items": [
        {
          "text": "\"Ruponeso ndorwaMwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:10"
      },
      "items": [
        {
          "text": "anogara pachigaro choushe,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:10"
      },
      "items": [
        {
          "text": "uye ndorweGwayana.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatumwa vose vakanga vamire vakakomberedza chigaro choushe uye vakakomberedza vakuru nezvisikwa zvipenyu zvina. Vakawira pasi nezviso zvavo pamberi pechigaro choushe vakanamata Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.11",
            "verseOrgIds": [
              "REV.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "\"Ameni!",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "Kurumbidzwa nokubwinya",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "nouchenjeri nokuvonga nokukudzwa",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "noushe nesimba",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "ngazvive kuna Mwari wedu nokusingaperi-peri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:12"
      },
      "items": [
        {
          "text": "Ameni!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mumwe wavakuru akandibvunza akati, \"Ava vakapfeka nguo chena, ndivanaaniko, uye vakabvepi?\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakapindura ndikati, \"Ishe, imi munoziva.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 7:14"
      },
      "items": [
        {
          "text": "Uye iye akati, \"Ava ndivo vaya vakabuda mukutambudzika kukuru; vakasuka nguo dzavo vakadzichenesa muropa reGwayana.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "\"vari pamberi pechigaro chaMwari",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "uye vanomushumira masikati nousiku mutemberi yake;",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 7:15"
      },
      "items": [
        {
          "text": "uye iye anogara pachigaro choushe achatambanudza tende rake pamusoro pavo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havachazoziyi nenzara zvakare;",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 7:16"
      },
      "items": [
        {
          "text": "havachazonzwi nyota zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
