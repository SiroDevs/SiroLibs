    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makamuri aVaprista",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume uya akanditungamirira nechokumusoro nechomukati moruvazhe rwokunze ndokundiendesa kumakamuri akanga akatarisana noruvazhe rwetemberi uye pakatarisana namadziro okunze kurutivi rwokumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imba yakanga ino mukova wakatarisa kumusoro yakanga yakareba makubhiti zana",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "text": "uye makubhiti makumi mashanu paupamhi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakatarisana namakubhiti makumi maviri oruvazhe rwomukati, uye pakatarisana nenzira yakanga yakavakirwa yoruvazhe rwokunze kwakanga kuna mabiravira akatarisana, akaturikidzwa ari matatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamberi pamakamuri pakanga pane nzvimbo yokufamba yakanga ine upamhi makubhiti gumi uye makubhiti zana pakureba. Makonhi ayo akanga ari nechokumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino makamuri apamusoro akanga ari maduku, nokuti nzvimbo dzokuratidzira dzakanga dzatorera nzvimbo yakawanda kubva paari kupfuura makamuri apasi namakamuri apakati peimba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makamuri omuturikidzwa wechitatu akanga asina mbiru, sezvakanga zvakaita ruvazhe; saka akanga ari maduku panzvimbo youriri pane aya akanga ari pasi uye nechapakati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakanga pane madziro aitevedzana namakamuri uye noruvazhe rwokunze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutsara wamakamuri kurutivi runotevedzana noruvazhe rwokunze wakanga uri makubhiti makumi mashanu pakureba, mutsara waparutivi rwaiva pedyo pedyo nenzvimbo tsvene wakanga una makubhiti zana pakureba kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makamuri apasi akanga ano mukova kurutivi rwokumabvazuva kana munhu achipinda kwaari achibva nechokuruvazhe rwokunze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Parutivi rwezasi zvichitevedzana nokureba kworusvingo rworuvazhe rwokunze, pedyo noruvazhe rwetemberi uye kwakatarisana norusvingo rwokunze, pakanga pane makamuri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenzvimbo yokufamba nayo nechemberi kwawo. Aya akanga akafanana namakamuri okumusoro; akanga akaenzana pakureba noupamhi, akanga akafanana pokubuda napo uye nokuyerwa kwawo. Sezvakanga zvakaita makonhi okumusoro",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndizvo zvakanga zvakaita mikova yamakamuri ezasi. Pakanga pane mukova paitangira nzvimbo yokufamba nayo pakanga pakangoenzana namadziro akanangana nawo zvichipfuurira zvakananga kumabvazuva, kana munhu achipinda mumakamuri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwandiri, \"Makamuri okumusoro neezasi iwo akatarisana noruvazhe rwetemberi ndeevaprista, ndipo panodyirwa zvipiriso zvitsvene-tsvene navaprista vanoswedera pana Jehovha. Vachaisa ipapo zvipiriso zvitsvene-tsvene, zvipiriso zvezviyo, zvechivi, uye zvemhosva, nokuti nzvimbo yacho itsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana vaprista vakangopinda panzvimbo tsvene, havachafaniri kubudira kuruvazhe rwokunze kusvikira vasiya nguo dzavanga vachishandisa pakushumira, nokuti idzo itsvene. Vanofanira kupfeka dzimwe nguo vasati vasvika pedyo nenzvimbo dzavanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati apedza kuyera zvakanga zviri mukati metemberi, akandibudisa kunze nechokusuo rokumabvazuva ndokubva ayera nzvimbo yacho yose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayera rutivi rwokumabvazuva netsvimbo yokuyeresa; yakanga ina makubhiti mazana mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayerawo rutivi rwokumusoro; rwakanga runa makubhiti anosvika mazana mashanu nechiyero chetsvimbo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayerawo rutivi rwezasi; rwakanga runa makubhiti mazana mashanu nechiyero chetsvimbo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatendeukira kurutivi rwokumavirira ndokuyera; rwakanga runa makubhiti anosvika mazana mashanu nechiyero chetsvimbo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akayera nzvimbo kumativi mana ose. Yakanga ino rusvingo rwakaipoteredza, mazana mashanu amakubhiti pakureba uye mazana mashanu paupamhi, kuti zviparadzanise zvitsvene nezvisati zviri zvitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    }
  ],
