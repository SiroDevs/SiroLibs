  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EZK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanasikana Vaviri Zvifeve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, kwakanga kuna vakadzi vaviri, vanasikana vamai vamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.2",
            "verseOrgIds": [
              "EZK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakava zvifeve muIjipiti, vakaita ufeve vachiri vadiki. Munyika imomo, mazamu oumhandara hwavo akabatwa-batwa uye zvipfuva zvavo zvakabatwa-batwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.3",
            "verseOrgIds": [
              "EZK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zita romukoma rainzi Ohora, uye mununʼuna wake ainzi Ohoribha. Ivo vakanga vari vangu uye vakabereka vanakomana navanasikana. Ohora ndiye Samaria uye Ohoribha ndiye Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ohora akaita ufeve iye achiri wangu; akachiva zvikomba zvake, ivo vaAsiria, varwi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.5",
            "verseOrgIds": [
              "EZK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakanga vakapfeka nguo dzebhuruu, vabati navatungamiri vehondo, vakanga vari majaya akanaka chose, uye vari vatasvi vamabhiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.6",
            "verseOrgIds": [
              "EZK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita ufeve navapamusoro-soro vose veAsiria uye akazvisvibisa nezvifananidzo zvose zvavose vaaichiva.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.7",
            "verseOrgIds": [
              "EZK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kurega ufeve hwaakatangira kuIjipiti, paakavata navarume achiri muduku, vakabata-bata chipfuva choumhandara hwake uye vakadurura ruchiva rwavo pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.8",
            "verseOrgIds": [
              "EZK.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo ndakamuisa kuzvikomba zvake, ivo vaAsiria, vaakanga achichiva.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.9",
            "verseOrgIds": [
              "EZK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvisa nguo akasara asina, ashama, vakatora vanakomana vake navanasikana ndokubva vamuuraya nomunondo. Akabva ava shumo pakati pavakadzi uye akarangwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mununʼuna wake Ohoribha akazviona izvozvo, asi nokuda kworuchiva rwake noufeve hwake, akanyanya ufeve kupfuura mukoma wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.11",
            "verseOrgIds": [
              "EZK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachivawo vaAsiria, vatongi navatungamiri vehondo, varwi vakapfeka zvakakwana, vatasvi vaifamba namabhiza, namajaya akanaka ose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.12",
            "verseOrgIds": [
              "EZK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona kuti naiyewo akazvisvibisa; vose vari vaviri vakafamba nenzira imwe cheteyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.13",
            "verseOrgIds": [
              "EZK.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi akaenderera mberi noufeve hwake. Akaona mifananidzo yavarume pamadziro, mifananidzo yavaKaradhea mitsvuku,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.14",
            "verseOrgIds": [
              "EZK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "vana mabhandi akamonera muzviuno zvavo nenguwani dzemicheka dzairembera pamisoro yavo; vakaita samachinda engoro dzeBhabhironi, vagari veKaradhea.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.15",
            "verseOrgIds": [
              "EZK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakangovaona, akabva avachiva ndokutumira nhume kwavari muKaradhea.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.16",
            "verseOrgIds": [
              "EZK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaBhabhironi vakauya kwaari, kunhoo yorudo, mukuchiva kwavo, vakamusvibisa. Shure kwokusvibiswa kwake navo, akavafuratira kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.17",
            "verseOrgIds": [
              "EZK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakaenderera mberi noufeve hwake pachena uye akaratidza kushama kwake, ndakamufuratira zvandisembura, sokufuratira kwandakanga ndaita mukoma wake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.18",
            "verseOrgIds": [
              "EZK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akaramba achiwedzera unzenza hwake achirangarira mazuva ouduku hwake, paakanga ari chifeve muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.19",
            "verseOrgIds": [
              "EZK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachiva zvikomba zvake ikoko, vane mitezo yakaita sembongoro uye zvinobuda mavari zvakaita sezvamabhiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.20",
            "verseOrgIds": [
              "EZK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka wakapanga unzenza hwouduku hwako, pawaiva muIjipiti chipfuva chako chakabatwa-batwa uye mazamu ouduku hwako akabatwa-batwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo, Ohoribha, zvanzi naIshe Jehovha: Ndichakumutsira zvikomba zvako kuti zvikurwise, ivo vawakasemburwa navo ukavafuratira, ndichavauyisa kuzorwa newe vachibva kumativi ose,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaBhabhironi navaKaradhea vose, varume vePekodhi neveShowa neKowa, uye vaAsiria vose pamwe chete navo, majaya akanaka, vose vari vabati nevatungamiri vamauto, namachinda engoro navarume vezvigaro zvapamusoro, vose vakatasva mabhiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.23",
            "verseOrgIds": [
              "EZK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachauya kuzorwa newe vaine zvombo, nengoro uye neboka ravanhu vazhinji, vachagadzirira kuti varwe newe kumativi ose nenhoo huru neduku uye nenguwani dzokurwa nadzo. Ndichakudzorera kwavari kuti urangwe, uye vachakuranga sezvakafanira mitemo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.24",
            "verseOrgIds": [
              "EZK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichamutsa godo rangu kuti ndirwe newe, uye ivo vachakurwisa nehasha. Vachagura mhino yako nenzeve dzako, uye vakasara venyu vachaurayiwa nomunondo. Vachakutorerai vanakomana venyu navanasikana venyu, uye vachasara venyu vachaparadzwa nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.25",
            "verseOrgIds": [
              "EZK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachakubvisai nguo dzenyu uye vachakutorerai ukomba hwenyu hwakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.26",
            "verseOrgIds": [
              "EZK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndichagumisa unzenza hwenyu noufeve hwamakatangira muIjipiti. Hamuchazotariri zvinhu izvi muchizvishuva kana kuzorangarira Ijipiti zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.27",
            "verseOrgIds": [
              "EZK.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti zvanzi naIshe Jehovha: Ndava kuzokuisa mumaoko avanhu vaunovenga, kuna avo vawakafuratira wasemburwa navo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vachakuitira ruvengo vagokutorera zvinhu zvose zvawakashandira. Vachakusiya usina kupfeka wakashama, uye kunyadzisa kwoufeve hwako kuchaiswa pachena. Unzenza hwako nokupata kwako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.29",
            "verseOrgIds": [
              "EZK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvakaisa izvi pamusoro pako, nokuti iwe wakachiva ndudzi ndokuzvisvibisa nezvifananidzo zvadzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.30",
            "verseOrgIds": [
              "EZK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakafamba nenzira yomununʼuna wako; saka ndichaisa mukombe wake muruoko rwako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.31",
            "verseOrgIds": [
              "EZK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "\"Uchanwa mukombe womukoma wako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "mukombe mukuru wakadzika;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "uchakuvigira kusekwa nokumhurwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "nokuti une zvakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchazadzwa nokudhakwa nokusuwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "mukombe wokuparadza nokuputsa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "mukombe womukoma wako Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchanwa zvokupedza kuti tsvai;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "uchauputsa ukava zvaenga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "uye uchacheka mazamu ako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "Ndini ndazvitaura, ndizvo zvinotaura Ishe Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo zvanzi naIshe Jehovha: Sezvo wakandikanganwa ukandirasira shure kwako, unofanira kuzvitakurira matambudziko ounzenza hwako noufeve hwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Mwanakomana womunhu unganditongerewo Ohora naOhoribha here? Ipapo uvazivise zvinonyangadza zvavanoita,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.36",
            "verseOrgIds": [
              "EZK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vakaita ufeve uye ropa riri mumaoko avo. Vakaita ufeve nezvifananidzo zvavo; vakasvika pakubayira vana vavo, vavakandiberekera ini, kuti zvive zvokudya zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.37",
            "verseOrgIds": [
              "EZK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaitawo izvi kwandiri: Panguva imwe cheteyo vakasvibisa nzvimbo yangu tsvene vakasvibisa maSabata angu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.38",
            "verseOrgIds": [
              "EZK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva ravakabayira vana vavo, kuzvifananidzo zvavo, vakapinda munzvimbo yangu tsvene vakaisvibisa. Ndizvo zvavakaita mumba mangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.39",
            "verseOrgIds": [
              "EZK.23.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vakatuma kunyange nenhume kundodana varume uye pavakasvika iwe wakazvishambidza nokuda kwavo, ukazodza meso ako ndokuzvishongedza noukomba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.40",
            "verseOrgIds": [
              "EZK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakagara panhoo yakaisvonaka ine tafura yakagadzikwa pamberi payo pawakanga wakaisa zvinonhuhwira namafuta akanga ari angu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.41",
            "verseOrgIds": [
              "EZK.23.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mheremhere yavanhu vakanga vasina hanya yakanga yakamukomberedza: VaSabhea vakaunzwa kubva kugwenga pamwe chete navarume vaibva pamhomho yavanhu vezhowezhowe, uye vakashongedza mabhenguro mumaoko omukadzi nomununʼuna wake nekorona dzakaisvonaka pamisoro yavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.42",
            "verseOrgIds": [
              "EZK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakati pamusoro paiye akanga apera noufeve, 'Zvino ngavamushandise sechifeve, nokuti ndizvo zvaari.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.43",
            "verseOrgIds": [
              "EZK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakavata naye. Sokuvata kunoita varume nechifeve, saizvozvo vakavata navakadzi nzenza, ivo vanaOhora naOhoribha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.44",
            "verseOrgIds": [
              "EZK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vanhu vakarurama vachavatonga nechirango chinopiwa vakadzi vanoita ufeve uye vanoteura ropa, nokuti ivo zvifeve uye ropa riri pamaoko avo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naIshe Jehovha: Uyai neboka ravarwi vazovarwisa muvatyise uye muvapambe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhomho ichavatema namabwe uye igovabaya neminondo; vachauraya vanakomana vavo navanasikana vavo vagopisa dzimba dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.47",
            "verseOrgIds": [
              "EZK.23.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka ndichagumisa unzenza panyika, kuti vakadzi vose vayambirwe vagorega kutevedzera.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.48",
            "verseOrgIds": [
              "EZK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucharangwa nokuda kwounzenza hwako uye uchatakura mubayiro wezvivi zvokufeva kwako. Ipapo uchaziva kuti ndini Ishe Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        }
      ]
    }
  ],
