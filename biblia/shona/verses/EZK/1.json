  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EZK 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvisikwa Zvipenyu noKubwinya kwaJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore ramakumi matatu, nomwedzi wechina pazuva rechishanu, ndiri pakati pavakatapwa, paRwizi rweKebhari, matenga akazarurwa, ndikaona zviratidzo zvaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechishanu romwedzi, riri gore rechishanu rokutapwa kwaMambo Jehoyakini,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "shoko raJehovha rakasvika kuna Ezekieri muprista, mwanakomana waBhuzi paRwizi rweKebhari munyika yavaBhabhironi. Ipapo, ruoko rwaJehovha rwakanga rwuri pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatarira, ndikaona dutu remhepo richibva nechokumusoro, gore guru rine mheni yaipenya uye rakakomberedzwa nechiedza chaibwinya. Pakati pomoto paitarisika sedare rinopfuta,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mumoto makanga mune zvakanga zvakaita sezvisikwa zvipenyu zvina. Pakuonekwa kwazvo, chimiro chazvo chakanga chiri chomunhu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi chimwe nechimwe chazvo chakanga chine zviso zvina namapapiro mana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makumbo azvo akanga akarurama; tsoka dzazvo dzakanga dzakaita sedzemhuru uye dzichipenya sendarira yakabwinyiswa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakanga zvina maoko omunhu pasi pamapapiro azvo pamativi azvo mana. Zvose zviri zvina zvaiva nezviso namapapiro,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye mapapiro azvo aigunzvana. Chimwe nechimwe chazvo chaienda mberi chakarurama; zvakanga zvisingacheuki pakufamba kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviso zvazvo zvairatidzika sezvizvi: chimwe nechimwe pauna hwazvo chaiva nechiso chomunhu, uye kurudyi, chimwe nechimwe chaiva nechiso cheshumba, uye kuruboshwe, chiso chenzombe; chimwe nechimwe chaiva nechiso chegondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizvo zvakanga zvakaita zviso zvazvo. Mapapiro azvo akanga akatambanudzirwa kumusoro; chimwe nechimwe chakanga china mapapiro maviri rimwe richigunzva bapiro rechimwe chisikwa kumativi ose, uye mapapiro maviri akafukidza muviri wacho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwe nechimwe chainanga mberi chakarurama. Kwose kwaienda mweya, ndiko kwazvaienda, zvisingacheuki pakufamba kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuonekwa kwezvisikwa zvipenyu izvi kwakanga kwakaita samazimbe omoto anopfuta, kana somwenje. Moto waienda mberi uchidzoka pakati pezvisikwa; wakanga uchipenya, uye mheni yaipenya mauri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisikwa zvaimhanya zvichienda mberi zvichidzoka semheni inopenya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakati ndichitarira kuzvisikwa zvipenyu, ndakaona vhiri riri pasi porutivi rwechisikwa chimwe nechimwe nezviso zvacho zvina.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ndiko kwaiva kuratidzika namagadzirirwo amavhiri acho: Akanga achivaima sebwe rekristaro, uye zvose zviri zvina zvakanga zvakafanana pakuonekwa kwazvo. Pakuonekwa kwawo napamagadzirirwo awo akanga akaita sevhiri rimwe riri mukati merimwe vhiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakufamba kwazvo, zvaigona kuenda neimwe yenzira ina dzakanga dzakatariswa nezvisikwa zvina; mavhiri akanga asingatsauki zvisikwa pazvaifamba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marimu acho akanga akakwirira uye aishamisa, uye marimu ose ari mana akanga azere nameso kwose kwose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisikwa zvipenyu zvaiti kana zvofamba, mavhiri aiva parutivi ofambawo; uye kana zvisikwa zvipenyu zvikasimuka kubva pasi, mavhiri aisimukawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwose kwaienda mweya, zvaiendawo, uye mavhiri aisimuka pamwe chete nazvo, nokuti mweya wezvisikwa zvipenyu wakanga uri mumavhiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisikwa pazvaifamba, iwo aifambawo; paimira zvisikwa, naiwo aimirawo; uye paingosimuka zvisikwa kubva pasi, mavhiri aisimukawo pamwe chete nazvo, nokuti mweya wezvisikwa zvipenyu wakanga uri mumavhiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusoro kwemisoro yezvisikwa zvipenyu kwakanga kwakawaridzwa chinhu chakanga chakaita sedenga, chaivaima sechando uye chaishamisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasi pedenga mapapiro azvo akanga akatambanudzwa, bapiro rechimwe chisikwa richinosangana nebapiro rechimwe chisikwa, uye chimwe nechimwe chaiva namapapiro maviri akanga akafukidza muviri wacho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisikwa zvaiti zvofamba, ndainzwa kuunga kwamapapiro azvo, zvichitinhira semvura zhinji, senzwi roWamasimba Ose, sebope ravarwi. Zvaiti zvikamira zvaideredza mapapiro azvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo inzwi rakasvika richibva kumusoro kwedenga rakanga riri pamusoro pazvo, pazvakanga zvakamira zvakaderedza mapapiro azvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusoro kwedenga rakanga riri pamusoro pemisoro yazvo, kwakanga kune chinhu chairatidzika sechigaro choushe chakanga chakaita sebwe resafuri uye pamusoro-soro pechigaro choushe pakanga pano mufananidzo wakanga wakaita sewomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona kuti pane zvairatidzika sechiuno chake zvichikwira kumusoro, akanga akaita sedare romoto unopenya, sokunge akazara nomoto, uye kubva ipapo zvichienda pasi, airatidzika somoto; uye chiedza chaipenya kwazvo chakanga chakamukomberedza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvakaita muraravungu uri mumakore pazuva rokunaya kwemvura, izvozvo, ndizvo zvakanga zvakaita kubwinya kwakanga kwakamukomberedza. Izvi ndizvo zvakanga zvakaita kuonekwa kwokubwinya kwaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 1:28"
      },
      "items": [
        {
          "text": "Pandakazviona izvozvo, ndakawira pasi nechiso changu, ndikanzwa inzwi romumwe akanga achitaura.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
      ]
    }
  ],
