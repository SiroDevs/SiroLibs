  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JHN 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusungwa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati apedza kunyengetera, Jesu akabva navadzidzi vake akayambuka Mupata weKidhironi. Parutivi penzvimbo iyi paiva nebindu remiorivhi, uye iye navadzidzi vake vakapindamo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.1",
            "verseOrgIds": [
              "JHN.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Judhasi uyo akamupandukira, aiziva nzvimbo yacho, nokuti Jesu aichimbosanganamo navadzidzi vake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.2",
            "verseOrgIds": [
              "JHN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Judhasi akasvika kubindu, achitungamirira boka ravarwi navamwe vatariri vaibva kuvaprista vakuru nokuvaFarisi. Vakanga vane mwenje namarambi uye nezvombo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.3",
            "verseOrgIds": [
              "JHN.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu, achiziva zvose zvakanga zvichizoitika kwaari, akabuda akaenda kwavari akati, \"Munotsvaka ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.4",
            "verseOrgIds": [
              "JHN.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Jesu weNazareta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:5"
      },
      "items": [
        {
          "text": "Jesu akati, \"Ndini iye.\" (Uye Judhasi mupanduki uya akanga amire navo ipapo.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu paakati, \"Ndini iye,\" vakasudurukira shure vakawira pasi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapamhazve kuvabvunza achiti, \"Ndianiko wamunoda?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:7"
      },
      "items": [
        {
          "text": "Uye ivo vakati, \"Jesu weNazareta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndakuudzai kuti ndini iye. Kana muchitsvaka ini, zvino chiregai varume ava vaende.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.8",
            "verseOrgIds": [
              "JHN.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaitika kuti mashoko aakanga ataura azadziswe, okuti: \"Handina kurasikirwa nomumwe weava vamakandipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.9",
            "verseOrgIds": [
              "JHN.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Simoni, uyo akanga ano munondo, akauvhomora akacheka muranda womuprista mukuru, akagura nzeve yake yokurudyi. (Zita romuranda uyo rainzi Marikusi.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.10",
            "verseOrgIds": [
              "JHN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akarayira Petro achiti, \"Isa munondo wako mumuhara! Ko, ndicharega kunwa mukombe wandapiwa naBaba here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoendeswa kuna Anasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo boka ravarwi navatariri vavaJudha vakabata Jesu vakamusunga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.12",
            "verseOrgIds": [
              "JHN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakatanga kuenda naye kuna Anasi, uyo akanga ari tezvara waKayafasi, iye aiva muprista mukuru gore iroro.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.13",
            "verseOrgIds": [
              "JHN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kayafasi uyu ndiye uya akapa vaJudha zano rokuti zvainge zvakanaka kuti munhu mumwe chete afire vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuramba kwaPetro kwokutanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro nomumwe mudzidzi vainge vachitevera Jesu. Nemhaka yokuti mudzidzi uyu aizivikanwa nomuprista mukuru uyu, akapinda naJesu mudare redzimhosva romuprista mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.15",
            "verseOrgIds": [
              "JHN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi Petro akasara kunze ari pamukova. Mumwe mudzidzi, aizivikanwa nomuprista mukuru, akadzoka akandotaura nomusikana aichengeta pamusuo ndokupinza Petro mukati.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.16",
            "verseOrgIds": [
              "JHN.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musikana akanga ari pamukova akabvunza Petro akati, \"Iwe hausi mumwe wavadzidzi vake here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:17"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Handisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaitonhora, saka varanda nevatariri vakamira vakadziya moto wavakanga vavesa kuti vadziyirwe. Petro akanga amirewo navo, achidziyawo moto.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muprista Mukuru anobvunza Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo, muprista mukuru akabvunza Jesu pamusoro pavadzidzi vake uye nezvedzidziso yake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.19",
            "verseOrgIds": [
              "JHN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura achiti, \"Ndakataura pachena kunyika. Ndaigara ndichidzidzisa mumasinagoge kana patemberi, apo paiungana vaJudha vose pamwe chete. Handina kutaura chinhu muchivande.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munondibvunzireiko? Bvunzai avo vakandinzwa. Zvirokwazvo vanoziva zvandakareva.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.21",
            "verseOrgIds": [
              "JHN.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati ataura izvi, mumwe wavatariri vakanga vari pedyo naye akamurova kumeso. Akati, \"Ndiyo nzira yaunopindura nayo muprista mukuru here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.22",
            "verseOrgIds": [
              "JHN.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Kana ndataura chimwe chinhu chakaipa, taura kuti chakaipa ndechipi. Asi kana ndataura chokwadi, seiko wandirova?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Anasi akamuendesa, akasungwa kuna Kayafasi muprista mukuru.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuramba kwaPetro kwechipiri nokwechitatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro achakamira achidziya moto, akabvunzwazve kuti, \"Iwe hausi mumwe wavadzidzi vake here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:25"
      },
      "items": [
        {
          "text": "Akazviramba izvozvo, achiti, \"Handizi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavaranda vomuprista mukuru, hama youya akanga agurwa nzeve yake naPetro, akamupikisa akati \"Ko, handina kukuona unaye mubindu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.26",
            "verseOrgIds": [
              "JHN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro akazvirambazve izvozvo, uye panguva iyoyo jongwe rakatanga kurira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anomiswa pamberi paPirato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaJudha vakatungamirira Jesu kubva kuna Kayafasi vakaenda naye kumuzinda womubati weRoma. Zvino akanga achiri mangwanani, uye kuti varege kusvibiswa, vaJudha vakarega kupinda mumuzinda; vaida kuti vakwanise kuzodya Pasika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.28",
            "verseOrgIds": [
              "JHN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Pirato akabuda kwavari akavabvunza achiti, \"Mhosva yomurume uyu ndeyeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.29",
            "verseOrgIds": [
              "JHN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vachiti, \"Dai anga asiri mutadzi, tingadai tisina kuuya naye kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.30",
            "verseOrgIds": [
              "JHN.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akati, \"Mutorei imi mumutonge nomurayiro wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:31"
      },
      "items": [
        {
          "text": "VaJudha vakaramba vachiti, \"Asika, isu hatina mvumo yokuuraya munhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaitika kuitira kuti mashoko akanga ataurwa naJesu achiratidza mafiro aaizoita azadziswe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pirato akadzokerazve mumuzinda, akadana Jesu akamubvunza achiti, \"Ndiwe mambo wavaJudha here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.33",
            "verseOrgIds": [
              "JHN.18.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Kufunga kwako woga here kana kuti vamwe vataura newe pamusoro pangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.34",
            "verseOrgIds": [
              "JHN.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akapindura achiti, \"Ndiri muJudha here ini? Vanhu vako navaprista vako vakuru vauya newe kwandiri. Wakaiteiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.35",
            "verseOrgIds": [
              "JHN.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Umambo hwangu hahusi hwenyika ino. Dai zvanga zvakadaro, varanda vangu vaizorwa kuti ndirege kusungwa navaJudha. Asi zvino umambo hwangu hunobva kune imwe nzvimbo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.36",
            "verseOrgIds": [
              "JHN.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akati, \"Saka uri mamboka!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:37"
      },
      "items": [
        {
          "text": "Jesu akapindura akati, \"Wataura zvakanaka pawati ndiri mambo. Chokwadi ndechokuti, ndizvo zvandakazvarirwa, uye nokuda kwaizvozvo ndakauya munyika, kuti ndizopupurira chokwadi. Ani naani anoda chokwadi anonditeerera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akamubvunza akati, \"Chokwadi chiiko?\" Akati ataura izvozvo akabudazve kunze kuvaJudha akati, \"Handiwani hwaro hwemhosva yomurume uyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi itsika yenyu imi kuti ini ndikusunungurirei musungwa panguva yePasika. Munoda here kuti ndikusunungurirei mambo wavaJudha?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.39",
            "verseOrgIds": [
              "JHN.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadanidzira vachiti, \"Kwete, uyu! Tipei Bharabhasi!\" Zvino Bharabhasi akanga ari gororo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.40",
            "verseOrgIds": [
              "JHN.18.40"
            ]
          }
        }
      ]
    }
  ],
