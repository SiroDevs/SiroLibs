{
  "id": "JHN.17",
  "number": "17",
  "bookId": "JHN",
  "reference": "Johani 17",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JHN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anozvinyengeterera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati ataura izvi, akatarira kudenga akanyengetera achiti:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JHN 17:1"
      },
      "items": [
        {
          "text": "\"Baba, nguva yasvika. Kudzai Mwanakomana wenyu, kuti Mwanakomana wenyu akukudzei.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti makamupa simba pamusoro pavanhu vose kuti ape upenyu husingaperi kuna vose vamakamupa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino uhu ndihwo upenyu husingaperi: kuti vakuzivei imi, Mwari oga wechokwadi, naJesu Kristu wamakatuma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakauyisa kukudzwa kwamuri panyika nokuti ndakapedza basa ramakandipa kuti ndiite.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, Baba, ndikudzei pamberi penyu nokukudzwa kwandaiva nako ndinemi nyika isati yavambwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anonyengeterera Vadzidzi Vake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakaratidza zita renyu kuna avo vamakandipa panyika. Vakanga vari venyu; mukavapa kwandiri uye vakateerera shoko renyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vanoziva kuti zvinhu zvose zvamakandipa zvinobva kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakavapa mashoko amakandipa uye vakaagamuchira. Vakaziva zvechokwadi kuti ndakabva kwamuri, uye vakatenda kuti makandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinovanyengeterera. Handisi kunyengeterera nyika, asi avo vamakandipa nokuti ndevenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose zvandinazvo ndezvenyu, uye zvose zvamunazvo ndezvangu. Uye kukudzwa kwakauya kwandiri kubudikidza navo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini handichagarizve munyika, asi ivo vachiri munyika, uye ini ndiri kuuya kwamuri. Baba Vatsvene, vadzivirirei nesimba rezita renyu, zita ramakandipa, kuti vave vamwe sesu tiri vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandainge ndiinavo, ndakavadzivirira uye ndikavachengeta zvakanaka nezita ramakandipa. Hakuna akarasika kunze kwouyo akatongerwa kuparadzwa kuitira kuti Rugwaro ruzadziswe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino ini ndiri kuuya kwamuri, asi ndiri kutaura zvinhu izvi ndichiri munyika, kuitira kuti vave nomufaro wangu wakazara mukati mavo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakavapa shoko renyu uye nyika yakavavenga, nokuti havachisiri venyika sezvandisiri wenyika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyengetero wangu hausi wokuti muvabvise panyika asi kuti muvadzivirire pane akaipa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havasi venyika, seni ndisiri wenyika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaitei vatsvene nechokwadi chenyu; shoko renyu ndiro chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvamakandituma munyika, neniwo ndakavatuma munyika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwavo ndinozviita mutsvene, kuti naivowo vaitwe vatsvene muzvokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.19",
            "verseOrgIds": [
              "JHN.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anonyengeterera Vatendi Vose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munyengetero wangu hausi waava voga. Ndinonyengetererawo avo vachazotenda kwandiri kubudikidza nemharidzo yavo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.20",
            "verseOrgIds": [
              "JHN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vose vave vamwe, Baba, sezvo imi muri mandiri uye ini ndiri mamuri. Naivowo ngavave matiri kuitira kuti nyika igotenda kuti makandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakavapa kubwinya kuya kwamakandipa, kuti vave vamwe sesu tiri vamwe:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi mavari uye imi mandiri. Ngavakwaniswe muhumwe kuti nyika izive kuti makandituma uye makavada kunyange sezvamakandida ini.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.23",
            "verseOrgIds": [
              "JHN.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba, ndinoda kuti vaya vamakandipa vave neni pandinenge ndiri, uye kuti vaone kubwinya kwangu, iko kubwinya kwamakandipa nokuti makandida nyika isati yasikwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba vakarurama, kunyange nyika isingakuziviyi, ini ndinokuzivai, uye ivo vanoziva kuti makandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.25",
            "verseOrgIds": [
              "JHN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakakuzivisai kwavari, uye ndicharamba ndichiita kuti vakuzivei kuitira kuti rudo rwamakandida narwo rwuve mavari uye kuti ini pachangu ndive mavari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.26",
            "verseOrgIds": [
              "JHN.17.26"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JHN.18",
