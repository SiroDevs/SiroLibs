      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:16"
      },
      "items": [
        {
          "text": "kana miromo yako ichitaura zvakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.16",
            "verseOrgIds": [
              "PRO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
