          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usarega mwoyo wako uchichiva vatadzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        }
      ]
    },
