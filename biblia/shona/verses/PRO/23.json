      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:10"
      },
      "items": [
        {
          "text": "kana kupinda paminda yenherera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.10",
            "verseOrgIds": [
              "PRO.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
