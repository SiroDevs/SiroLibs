          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo ramangwana rako rine tariro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.18",
            "verseOrgIds": [
              "PRO.23.18"
            ]
          }
        }
      ]
    },
