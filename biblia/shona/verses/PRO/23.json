      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:18"
      },
      "items": [
        {
          "text": "uye tariro yako haingaparadzwi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.18",
            "verseOrgIds": [
              "PRO.23.18"
            ]
          }
        }
      ]
    },
