      "attrs": {
        "style": "q2",
        "vid": "PRO 23:19"
      },
      "items": [
        {
          "text": "uye uchengete mwoyo wako panzira yakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.19",
            "verseOrgIds": [
              "PRO.23.19"
