      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:17"
      },
      "items": [
        {
          "text": "asi nguva dzose shingairira kutya Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.17",
            "verseOrgIds": [
              "PRO.23.17"
            ]
          }
        }
      ]
    },
    {
