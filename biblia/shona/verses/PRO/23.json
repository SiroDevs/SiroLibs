      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:13"
      },
      "items": [
        {
          "text": "ukamuranga neshamhu, haafi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.13",
            "verseOrgIds": [
              "PRO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
