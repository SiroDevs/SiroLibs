          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana wangu, kana mwoyo wako wakachenjera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 23:15"
      },
      "items": [
        {
          "text": "ipapo mwoyo wangu uchafara;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.23.15",
            "verseOrgIds": [
              "PRO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
