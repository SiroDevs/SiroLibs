  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PRO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yambiro pamusoro poMukadzi Chifeve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:1"
      },
      "items": [
        {
          "text": "chengeta mashoko angu ugoviga mirayiro yangu mauri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengeta mirayiro yangu ugorarama;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:2"
      },
      "items": [
        {
          "text": "uchengete dzidziso dzangu semboni yeziso rako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzvisungirire paminwe yako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:3"
      },
      "items": [
        {
          "text": "uzvinyore pahwendefa yomwoyo wako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kuuchenjeri, \"Uri hanzvadzi yangu,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:4"
      },
      "items": [
        {
          "text": "uye uti kunzwisisa ndiyo hama yako;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvichakuchengeta kure nomukadzi chifeve;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:5"
      },
      "items": [
        {
          "text": "kubva pamudzimai asingazvibati anokwezva namashoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napawindo remba yangu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:6"
      },
      "items": [
        {
          "text": "ndakatarira panze nomumagirazi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona pakati pavasina mano",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "ndikacherechedza pakati pamajaya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "rimwe jaya rakanga risina njere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakanga richidzika nomugwagwa pedyo nepakona yomukadzi uya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:8"
      },
      "items": [
        {
          "text": "richifamba rakananga kumba kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "panguva yorubvunzavaeni,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:9"
      },
      "items": [
        {
          "text": "zuva ravira, kunze kwosviba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi akabuda kuzosangana naye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:10"
      },
      "items": [
        {
          "text": "akapfeka sechifeve uye azere nounyengeri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotaura noruzha uye anozvikudza,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:11"
      },
      "items": [
        {
          "text": "tsoka dzake hadzigari pamba;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "imwe nguva ari munzira, imwe nguva ari pazvivara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:12"
      },
      "items": [
        {
          "text": "Anorindira pamakona ose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamubata ndokumutsvoda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:13"
      },
      "items": [
        {
          "text": "uye nechiso chisina nyadzi akati:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndine zvipiriso zvokuwadzana kumba kwangu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:14"
      },
      "items": [
        {
          "text": "nhasi ndazadzisa mhiko dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndauya kuzosangana newe;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:15"
      },
      "items": [
        {
          "text": "ndanga ndichikutsvaka, zvino ndazokuwana!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndawaridza mubhedha wangu machira ane mavara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:16"
      },
      "items": [
        {
          "text": "anobva kuIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasasa zvinonhuhwira pamubhedha wangu, zvinoti:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:17"
      },
      "items": [
        {
          "text": "mura, gavakava nesinamoni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uya, tinwe tigute norudo kusvikira mangwanani;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.18",
            "verseOrgIds": [
              "PRO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:18"
      },
      "items": [
        {
          "text": "ngatifare zvedu norudo!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.18",
            "verseOrgIds": [
              "PRO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume wangu haako kumba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.19",
            "verseOrgIds": [
              "PRO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
