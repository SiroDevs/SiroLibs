          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuronga kwomwoyo ndekwomunhu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:1"
      },
      "items": [
        {
          "text": "asi mhinduro yorurimi inobva kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzira dzose dzomunhu dzinoita sedzakanaka pakuona kwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:2"
      },
      "items": [
        {
          "text": "asi Jehovha anoyera zvinangwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumikidza kuna Jehovha chose chaunoita,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:3"
      },
      "items": [
        {
          "text": "ipapo urongwa hwako huchabudirira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anoitira zvinhu zvose magumo azvo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:4"
      },
      "items": [
        {
          "text": "kunyange akaipa anomuitira zuva renjodzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anovenga vose vane mwoyo inozvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:5"
      },
      "items": [
        {
          "text": "Zvirokwazvo, havangaregi kurangwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubudikidza norudo nokutendeka, chivi chinoyananisirwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:6"
      },
      "items": [
        {
          "text": "kubudikidza nokutya Jehovha munhu anorega kuita zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana nzira dzomunhu dzichifadza Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:7"
      },
      "items": [
        {
          "text": "anoita kuti kunyange vavengi vake vagarisane naye murugare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani kuva nezvishoma mukururama,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:8"
      },
      "items": [
        {
          "text": "pane kuva nezvakawanda kwazvo mukusaruramisira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwoyo make munhu anoronga gwara rake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:9"
      },
      "items": [
        {
          "text": "asi Jehovha ndiye anotonga kufamba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miromo yamambo inotaura seinotaura chirevo chaMwari,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.10",
            "verseOrgIds": [
              "PRO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:10"
      },
      "items": [
        {
          "text": "uye muromo wake haufaniri kurega kururamisira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.10",
            "verseOrgIds": [
              "PRO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviyero nezvienzaniso zvechokwadi zvinobva kuna Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:11"
      },
      "items": [
        {
          "text": "zviyero zvose zviri muhomwe ndiye akazviita.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzimambo anovenga kuita zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:12"
      },
      "items": [
        {
          "text": "nokuti chigaro choushe chinosimbiswa nokururama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzimambo anofarira miromo inotaura chokwadi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:13"
      },
      "items": [
        {
          "text": "anoremekedza munhu anotaura chokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwamambo inhume yorufu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:14"
      },
      "items": [
        {
          "text": "asi munhu akachenjera anonyaradza kutsamwa uku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana chiso chamambo chichibwinya, zvinoreva upenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:15"
      },
      "items": [
        {
          "text": "nyasha dzake dzakaita segore remvura panguva yomunakamwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani sei kuwana uchenjeri pane goridhe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:16"
      },
      "items": [
        {
          "text": "kusarudza njere pane sirivha!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugwagwa mukuru wavakarurama unonzvenga zvakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:17"
      },
      "items": [
        {
          "text": "uye anochengeta nzira yake anochengeta upenyu hwake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
