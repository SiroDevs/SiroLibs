  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JAS 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yambiro kuVapfumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JAS 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino inzwai, imi vapfumi, chemai muungudze nokuda kwenjodzi iri kuuya pamusoro penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.1",
            "verseOrgIds": [
              "JAS.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JAS 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upfumi hwenyu hwaora, uye nguo dzenyu dzakadyiwa nezviundudzi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.2",
            "verseOrgIds": [
              "JAS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JAS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goridhe renyu nesirivha zvava nengura. Ngura yazvo ichakupupurirai zvakaipa uye zvichapedza nyama yenyu somoto. Makazvichengetera upfumi mumazuva okupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.3",
            "verseOrgIds": [
              "JAS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JAS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai mibayiro yamakatadza kupa vashandi venyu vaicheka muminda yenyu iri kudanidzira pamusoro penyu. Kuchema kwavacheki kwasvika munzeve dzaIshe Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.4",
            "verseOrgIds": [
              "JAS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JAS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makararama mumafaro panyika uye muchizvikudza. Makakodza mwoyo yenyu pazuva rokuzvibaya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JAS 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makatonga uye mukaponda vanhu vasina mhosva, vakanga vasingapikisani nemi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
              "JAS.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwoyo Murefu muKutambudzika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JAS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, hama dzangu, ivai nomwoyo murefu, kusvikira pakuuya kwaShe. Tarirai mamiriro anoita murimi kuti aone chibereko chinokosha chenyika uye kuti anoita mwoyo murefu sei pakumirira kwake mvura yomunakamwe nemvura yamasutso.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.7",
            "verseOrgIds": [
              "JAS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JAS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemiwo, ivai nomwoyo murefu uye mumire nesimba, nokuti kuuya kwaShe kwava pedyo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
            "verseOrgIds": [
              "JAS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musanyunyutirana, hama dzangu, kuti murege kutongwa. Mutongi amire pamusuo!",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
              "JAS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama dzangu, somuenzaniso womwoyo murefu pakutambudzika, tarirai vaprofita vakataura muzita raShe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.10",
            "verseOrgIds": [
              "JAS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JAS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvamunoziva, tinoti vakaropafadzwa avo vakatsungirira. Makanzwa zvokutsungirira kwaJobho uye makaona zvakaitwa naIshe pakupedzisira. Ishe azere netsitsi nengoni.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.11",
            "verseOrgIds": [
              "JAS.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pazvo zvose, hama dzangu, musapika, nedenga kana nenyika kana nechimwe chinhu zvacho. \"Hongu\" yenyu ngaive hongu, uye \"Kwete\" yenyu ngaive kwete, kuti murege kutongwa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munyengetero woKutenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno mumwe wenyu anotambudzika here? Ngaanyengetere. Kuno mumwe anofara here? Ngaaimbe nziyo dzokurumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
            "verseOrgIds": [
              "JAS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno mumwe wenyu anorwara here? Ngaadane vakuru vekereke kuti vazomunyengeterera uye vagomuzodza mafuta muzita raIshe.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
            "verseOrgIds": [
              "JAS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye munyengetero unoitwa mukutenda uchaita kuti munhu anorwara apore; Ishe achamumutsa. Kana akatadza, acharegererwa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo reururai zvivi zvenyu mumwe kuno mumwe uye munyengetererane kuti mugoporeswa. Munyengetero womunhu akarurama une simba uye unoshanda.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akanga ari munhu sesu. Akanyengetera zvine simba kuti kurege kunaya, uye hakuna kunaya panyika kwamakore matatu nehafu.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.17",
            "verseOrgIds": [
              "JAS.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve, akanyengetera, denga rikanayisa mvura, nyika ikabereka zvibereko zvayo.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama dzangu, kana mumwe wenyu akatsauka kubva pachokwadi uye mumwe akamudzora,",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "murangarire izvi kuti: Ani naani anodzora mutadzi kubva panzira yokudarika kwake, achamuponesa kubva parufu uye achafukidza zvivi zvizhinji.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.20",
            "verseOrgIds": [
              "JAS.5.20"
            ]
          }
        }
      ]
    }
  ],
