  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "HEB 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ngatisiyei dzidziso dzokutanga pamusoro paKristu uye tipfuurire mberi mukukura, tisingaisizve nheyo dzokutendeuka kubva pamabasa anotungamirira kurufu, uye nokutenda muna Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.1",
            "verseOrgIds": [
              "HEB.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "dzidziso pamusoro pokubhabhatidzwa nedzokuisa maoko pamusoro, dzokumuka kubva kuvakafa, uye nedzokutongwa kusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.2",
            "verseOrgIds": [
              "HEB.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana Mwari achitendera, ndizvo zvatichaita.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.3",
            "verseOrgIds": [
              "HEB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti hazvigoni kuti vaya vakambovhenekerwa, vaya vakamboravira chipo chokudenga, vakagoverwa Mweya Mutsvene,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.4",
            "verseOrgIds": [
              "HEB.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakaravira kunaka kweshoko raMwari uye namasimba enyika inouya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.5",
            "verseOrgIds": [
              "HEB.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vatendeukezve mushure mokunge vatsauka, nokuti pakurasikirwa kwavo vanorovererazve Mwanakomana waMwari, vachimunyadzisa pachena.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.6",
            "verseOrgIds": [
              "HEB.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika inonwa mvura inonaya nguva nenguva pamusoro payo uye inobereka zvirimwa zvinobatsira avo vanoirima, ndiyo inoropafadzwa naMwari.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.7",
            "verseOrgIds": [
              "HEB.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nyika inobereka minzwa norukato haibatsiri uye ine dambudziko rokuti ichatukwa. Pakupedzisira ichapiswa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvazvo tichitaura sezvizvi, hama dzinodikanwa, tinoziva kwazvo kuti kwamuri kuchabva zvinhu zviri nani, zvinhu zvinoshanda pamwe chete noruponeso.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.9",
            "verseOrgIds": [
              "HEB.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari haazi asina kururama; haangakanganwi basa renyu norudo rwamakamuratidza pamaibatsira vanhu vake uye kuti muchiri kuramba muchivabatsira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.10",
            "verseOrgIds": [
              "HEB.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinoda kuti mumwe nomumwe wenyu ave nokushingaira kumwe cheteko kusvikira kumagumo, kuitira kuti muve nechokwadi chetariro yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.11",
            "verseOrgIds": [
              "HEB.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatidi kuti muve simbe, asi kuti muve vateveri vaavo vanodya nhaka yakavimbiswa kubudikidza nokutenda nokutsungirira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
            "verseOrgIds": [
              "HEB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chokwadi cheVimbiso yaMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari paakaita vimbiso yake kuna Abhurahama, sezvo kwakanga kusina mumwe mukuru kwaari wokuti angapika naye, akapika naiye amene,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.13",
            "verseOrgIds": [
              "HEB.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "achiti, \"Zvirokwazvo ndichakuropafadza uye ndichakupa zvizvarwa zvizhinji.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.14",
            "verseOrgIds": [
              "HEB.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mushure mokumirira nomwoyo murefu, Abhurahama akagamuchira chipikirwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.15",
            "verseOrgIds": [
              "HEB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vanopika nomukuru kwavari, uye mhiko ndiyo inosimbisa zvinenge zvataurwa, uye inopedza gakava rose.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.16",
            "verseOrgIds": [
              "HEB.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Mwari aida kuti aratidze pachena kusashanduka kwechido chake kuvadyi venhaka yakapikirwa, akakusimbisa nemhiko.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.17",
            "verseOrgIds": [
              "HEB.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaita izvi kuitira kuti, nezvinhu zviviri zvisingashanduki, zvokuti Mwari haagoni kureva nhema, isu vakatiza tikandobatisisa tariro yatakapiwa, tichasimbiswa zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.18",
            "verseOrgIds": [
              "HEB.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tine tariro iyi sechibatiso choMweya, chakasimba chisingazungunuswi. Inopinda mukati mechidzitiro chomutemberi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.19",
            "verseOrgIds": [
              "HEB.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "makapinda Jesu akatitangira isu, akapinda akatimiririra. Akava muprista mukuru nokusingaperi worudzi rwaMerikizedheki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.20",
            "verseOrgIds": [
              "HEB.6.20"
            ]
          }
        }
      ]
    }
  ],
