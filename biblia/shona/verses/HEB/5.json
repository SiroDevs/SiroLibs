  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "HEB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista mukuru mumwe nomumwe anosarudzwa kubva pakati pavanhu uye anogadzwa kuti avamiririre pazvinhu zvaMwari, kuti ape zvipo nezvibayiro pamusoro pezvivi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anogona kunzwira tsitsi vaya vasingazivi uye navaya vari kutsauka, sezvo iye pachake ari pasi poutera.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka achifanira kupa zvibayiro zvezvivi zvake, pamwe chete nezvezvivi zvavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana munhu anozvipa kukudzwa uku; anofanira kudanwa naMwari, sezvakaitwa Aroni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvowo Kristu haana kuzvitorera iye kubwinya kwokuva muprista mukuru. Asi Mwari akati kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 5:5"
      },
      "items": [
        {
          "text": "\"Ndiwe Mwanakomana wangu;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 5:5"
      },
      "items": [
        {
          "text": "nhasi ndava baba vako.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akati, pane imwe nzvimbo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 5:6"
      },
      "items": [
        {
          "text": "\"Ndiwe muprista nokusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 5:6"
      },
      "items": [
        {
          "text": "worudzi rwaMerikizedheki.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamazuva oupenyu hwaJesu panyika, akauya kuna iye akanga achigona kumurwira parufu neminyengetero nemikumbiro, achichema nokuchema kukuru nemisodzi, uye akanzwika nokuda kwokutya kwake Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvake akanga ari mwanakomana, akadzidza kuteerera kubva pakutambudzika kwake",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akati akwaniswa, akazova muvambi wokuponeswa kusingaperi kuna vose vanomuteerera",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akanzi naMwari ave muprista mukuru worudzi rwaMerikizedheki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yambiro pamusoro poKutsauka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tine zvizhinji zvokutaura pamusoro peizvi, asi zvinorema kuzvitsanangura kwamuri nokuti munononoka kunzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti, kunyange maifanira kuva vadzidzisi pari zvino munotoda mumwe munhu kuti akudzidzisei zvakare zvokwadi yezvokuvamba zveshoko raMwari. Muchiri kuda mukaka, kwete zvokudya zvikukutu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe anoraramiswa nomukaka, achiri mucheche, haasati anzwisisa dzidziso pamusoro pokururama.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvokudya zvikukutu ndezvavakuru, avo vakazvidzidzisa nokuramba vachizviita, kutsaura zvakanaka kubva kune zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
    }
  ],
