  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1PE 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuraramira Mwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, sezvo Kristu akatambudzika mumuviri wake, nemiwo muzvishongedze nomurangariro iwoyo, nokuti uyo akatambudzika mumuviri wake akarega chivi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.1",
            "verseOrgIds": [
              "1PE.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvo, haagari upenyu hwake hwose hwapanyika pakuchiva kwavanhu kwakaipa, asi mukuda kwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nguva yakapfuura yakaringana kare yamakapedza muchiita kuda kwavahedheni yamairarama muutere, kuchiva, kudhakwa, kutamba kwakaipa, kuraradza nokunamata zvifananidzo zvinonyangadza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanofunga kuti zvinoshamisa kuti imi hamuchapindi pamwe chete navo mukurarama kwokusazvidzora kwavo kuzhinji, uye vanokutukai kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vachazvidavirira kuna iye akazvigadzirira kutonga vapenyu navakafa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nokuda kwaizvozvi vhangeri rakaparidzwa kunyange nokuna vakafa, kuitira kuti vagotongwa nomutoo wavanhu nokuda kwenyama, asi vagorarama nomutoo waMwari nokuda kwomweya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuguma kwezvinhu zvose kwava pedyo. Naizvozvo ndangariro dzenyu ngadzichene uye muzvidzore kuti mugogona kunyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo zvose dananai norudo rukuru, nokuti rudo runofukidza zvivi zvizhinji.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muitirane rudo kuno mumwe nomumwe wenyu musinganyunyuti.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe ngaashandise chipo chaanacho kuti ashandire vamwe, akatendeka muutariri hwenyasha dzaMwari mukuwanda kwadzo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu achitaura, ngaadaro somunhu anotaura mashoko chaiwo aMwari. Kana munhu achishumira, ngaazviite nesimba raanopiwa naMwari, kuitira kuti muzvinhu zvose Mwari arumbidzwe kubudikidza naJesu Kristu. Iye ngaave nokubwinya nesimba nokusingaperi-peri. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutambudzika nokuda kwokuva muKristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadikani, musashamiswa nokurwadza kwokutambudzika nemiedzo, sokunge chinhu chisingazivikanwi chaitika kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi farai kuti munogovana naKristu mumatambudziko, kuitira kuti mufare kwazvo pakuonekwa kwokubwinya kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchitukwa nokuda kwezita raKristu, makaropafadzwa, nokuti mweya wokubwinya nowaMwari unogara pamuri.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakurege kuva nomumwe wenyu achatambudzika, nemhaka yokuti imhondi, kana mbavha, kana kuti anoita zvimwe zvakaipa zvemhando ipi zvayo, kana kusarega zvavamwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, kana muchitambudzika somuKristu, musanyadziswa, asi rumbidzai Mwari nokuti mune zita iroro.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
              "1PE.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti inguva yokuti kutonga kutange mumba maMwari; uye kana kuchitanga nesu, zvichazoveiko kuna vaya vasingateereri vhangeri raMwari?",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 4:18"
      },
      "items": [
        {
          "text": "\"Kana zvichiremera akarurama kuti aponeswe,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 4:18"
      },
      "items": [
        {
          "text": "ko, asingazivi Mwari nomutadzi vachazovei?\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino, vaya vanotambudzika nokuda kwaMwari vanofanira kuzviisa kuMusiki wavo akatendeka uye vagoramba vachiita zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.19",
            "verseOrgIds": [
              "1PE.4.19"
            ]
          }
        }
      ]
    }
  ],
