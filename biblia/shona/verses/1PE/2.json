{
  "id": "1PE.2",
  "number": "2",
  "bookId": "1PE",
  "reference": "1 Petro 2",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1PE 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, muzvidzore pane zvakaipa zvose namanomano ose, nokunyengera, negodo, nokureva kwose.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.1",
            "verseOrgIds": [
              "1PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Savacheche vachangoberekwa, pangai mukaka wakachena womweya, kuti mugokuriswa nawo muruponeso rwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.2",
            "verseOrgIds": [
              "1PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "sezvo makaravira zvino kuti Ishe akanaka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.3",
            "verseOrgIds": [
              "1PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibwe Benyu naVanhu Vakasanangurwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvamunouya kwaari, iye Ibwe Benyu, rakarambwa navanhu asi rakasarudzwa naMwari uye rinokosha kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.4",
            "verseOrgIds": [
              "1PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemiwo, samabwe mapenyu, muri kuvakwa muimba yomweya kuti muve uprista hutsvene muchipa zvibayiro zvomweya zvinogamuchirwa kuna Mwari kubudikidza naJesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.5",
            "verseOrgIds": [
              "1PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti muRugwaro zvinonzi:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "\"Tarirai, ndakaisa ibwe muZioni,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "ibwe rakasanangurwa, rinokosha,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "uye munhu anovimba naye",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:6"
      },
      "items": [
        {
          "text": "haatongonyadziswi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.6",
            "verseOrgIds": [
              "1PE.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kunemi vanotenda, iri ibwe rinokosha. Asi kuna avo vasingatendi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:7"
      },
      "items": [
        {
          "text": "\"Ibwe rakaraswa navavaki",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:7"
      },
      "items": [
        {
          "text": "ndiro rava musoro wekona,\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.7",
            "verseOrgIds": [
              "1PE.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "\"Ibwe rinogumbusa vanhu",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "nedombo rinoita kuti vawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1PE 2:8"
      },
      "items": [
        {
          "text": "Vanogumburwa nokuti havateereri shoko, zvinova ndizvo zvavakatemerwawo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.8",
            "verseOrgIds": [
              "1PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi muri vanhu vakasanangurwa, uprista hwamambo, rudzi rutsvene, vanhu vaMwari chaivo, vaakadana kuti muparidze kunaka kwaiye akakudanai kuti mubve murima, muuye muchiedza chake chinoshamisa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.9",
            "verseOrgIds": [
              "1PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare makanga musiri vanhu, asi zvino mava vanhu vaMwari; kare makanga musinganzwirwi ngoni, asi zvino makagamuchira ngoni.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.10",
            "verseOrgIds": [
              "1PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadikani, ndinokukurudzirai, savatorwa navaeni munyika, kuti muzvidzore pakuchiva kwenyama, kunorwa nomweya wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.11",
            "verseOrgIds": [
              "1PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugare upenyu hwakanaka pakati pavahedheni kuti, kunyange vachikupomerai mhosva, vaone mabasa enyu akanaka vagokudza Mwari pazuva raanotishanyira.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.12",
            "verseOrgIds": [
              "1PE.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuzviisa pasi paVatongi naVanatenzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzviise pasi pamasimba ose akagadzwa pakati penyu navanhu nokuda kwaIshe: angava mambo, saiye mutongi mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.13",
            "verseOrgIds": [
              "1PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana vabati, vakatumwa naye kuti vazoranga vaya vanoita zvakaipa uye kuti varumbidze vaya vanoita zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.14",
            "verseOrgIds": [
              "1PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kuda kwaMwari kuti, nokuita zvakanaka, muchanyaradza kusaziva kwamapenzi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.15",
            "verseOrgIds": [
              "1PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garai savanhu vakasununguka, asi musingaiti kuti kusununguka kwenyu kuve chifukidzo chezvakaipa; garai savaranda vaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.16",
            "verseOrgIds": [
              "1PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzai vanhu vose norukudzo chairwo: Idai hama dzose, ityai Mwari, kudzai mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.17",
            "verseOrgIds": [
              "1PE.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda, zviisei pasi pavatenzi venyu nokukudza kwose, kwete kuna avo vakanaka navane hanya bedzi, asi nokuna vayawo vane hasha.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.18",
            "verseOrgIds": [
              "1PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvinorumbidzwa kana munhu achitsungirira ari pasi pokurwadziwa nokutambudzika kusakafanira nokuti anoziva kuti Mwari ariko.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.19",
            "verseOrgIds": [
              "1PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mungarumbidzwa sei kana muchirohwa nokuda kwokuita zvakaipa uye muchitsunga mazviri? Asi kana muchitambudzika nokuda kwokuti munoita zvakanaka uye muchitsunga mazviri, izvozvo zvinorumbidzwa pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.20",
            "verseOrgIds": [
              "1PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makadanirwa izvozvi, nokuti Kristu akatambudzika nokuda kwenyu, akakusiyirai muenzaniso, kuti mutevere makwara ake.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.21",
            "verseOrgIds": [
              "1PE.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haana kutadza,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 2:22"
      },
      "items": [
        {
          "text": "uye kunyengera hakuna kuwanikwa mumuromo make.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.22",
            "verseOrgIds": [
              "1PE.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakamutuka, haana kudzorera; paakatambudzika, haana kutyisidzira. Asi, akazviisa kuna iye anotonga nokururama.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.23",
            "verseOrgIds": [
              "1PE.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye pachake akatakura zvivi zvedu mumuviri wake pamuti, kuitira kuti isu tife kuzvivi tigorarama zvakarurama; namavanga ake imi makaporeswa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.24",
            "verseOrgIds": [
              "1PE.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1PE 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti imi makanga makaita samakwai akarasika, asi zvino madzokera kuMufudzi noMutariri wemweya yenyu.",
          "type": "text",
