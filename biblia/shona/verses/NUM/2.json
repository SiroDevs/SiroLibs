      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vose vakadanwa kumusasa waDhani vanosvika zviuru zana namakumi mashanu nezvinomwe, namazana matanhatu. Ndivo vachava vokupedzisira pakusimuka, vari pasi pemireza yavo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
