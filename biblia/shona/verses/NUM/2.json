          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka rake rina vanhu vanosvika zviuru makumi mashanu nezvitatu, namazana mana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        }
      ]
    },
