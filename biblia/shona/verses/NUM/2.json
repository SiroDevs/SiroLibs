            "sid": "NUM 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudzi rwaNafutari ndirwo ruchatevera. Mutungamiri wavanhu vokwaNafutari ndiAhira mwanakomana waEnani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
        {
          "name": "verse",
