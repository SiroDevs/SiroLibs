          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nehando, namakondobwe, namakwayana, mugadzire zvipiriso zvazvo nezvipiriso zvokunwa maererano nouwandu hwakarayirwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.24",
