            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva rechitanhatu, mugadzire hando sere, makondobwe maviri uye makwayana makono egore rimwe chete, gumi namana, zvose zvisina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.29",
