          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire pamwe chete nehando, makondobwe, uye namakwayana, zvipiriso zvazvo zvezviyo nezvipiriso zvokunwa maererano nouwandu hwakarayirwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.21",
            "verseOrgIds": [
              "NUM.29.21"
            ]
          }
