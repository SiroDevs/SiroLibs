    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva rokutanga romwedzi wechinomwe, muite ungano tsvene uye murege kubata basa ramazuva ose. Izuva rokuti muridze hwamanda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kugadzirira Jehovha chipiriso chinopiswa chehando imwe chete duku, gondobwe rimwe chete uye makwayana makono manomwe egore rimwe chete, ose asina kuremara, zvive zvinonhuhwira zvinofadza pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire pamwe chete nehando duku chipiriso chezviyo chezvikamu zvitatu mugumi zveefa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "text": "yeupfu hwakatsetseka hwakavhenganiswa pamwe chete namafuta, negondobwe, zvikamu zviviri mugumi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete nerimwe nerimwe ramakwayana manomwe, chikamu chimwe chete mugumi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muisewo nhongo imwe chete yembudzi sechipiriso chechivi kuti muzviyananisire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zviri kupamhidzirwa pamusoro pezvipiriso zvinopiswa zvomwedzi nomwedzi, nezvezuva nezuva uye nezvipiriso zvezviyo nezvipiriso zvokunwa sokurongwa kwazvo. Ndizvo zvipiriso zvinoitirwa Jehovha nomoto, zvinonhuhwira zvinofadza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zuva Rokuyananisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva regumi romwedzi wechinomwe munofanira kuita ungano tsvene. Munofanira kuzviramba uye murege kubata basa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupe chibayiro chinopiswa chehando duku yegore rimwe chete kuna Jehovha sezvinonhuhwira zvinofadza: hando imwe chete negondobwe rimwe chete uye namakwayana makono manomwe egore rimwe chete, zvisina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire pamwe chete nehando, chipiriso chezviyo chezvikamu zvitatu mugumi zveefa youpfu hwakatsetseka, hwakavhenganiswa namafuta; pamwe chete negondobwe, zvikamu zviviri mugumi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye parimwe nerimwe ramakwayana manomwe, chikamu chimwe chete mugumi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muisewo nhongo yembudzi sechipiriso chechivi, muchipamhidzira kuchipiriso chechivi chokuyananisira uye nechibayiro chinopiswa chamazuva ose nechipiriso chacho chezviyo, uye nezvipiriso zvazvo zvokunwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutambo waMatumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva regumi namashanu romwedzi wechinomwe, muite ungano tsvene uye musaita basa ramazuva ose. Muite mutambo wokupemberera Jehovha kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muuye nechibayiro chinopiswa kuti chive chinonhuhwira zvinofadza kuna Jehovha, chibayiro chinopiswa chehando duku gumi nenhatu, makondobwe maviri namakwayana makono gumi namana egore rimwe chete, ose asina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire chipiriso chezvikamu zvitatu mugumi zveefa youpfu hwakatsetseka, hwakavhenganiswa namafuta pamwe chete neimwe neimwe yehando duku gumi nenhatu; pamwe chete nerimwe nerimwe ramakondobwe maviri, zvikamu zviviri mugumi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye pamwe chete nerimwe nerimwe ramakwayana gumi namana, chikamu chimwe chete mugumi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muisewo nhongo yembudzi imwe chete sechipiriso chechivi, pamusoro pechipiriso chinopiswa nechipiriso chacho chezviyo nechipiriso chokunwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva rechipiri mugadzire hando duku gumi nembiri, makondobwe maviri uye makwayana makono gumi namana egore rimwe, zvose zvisina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire nehando, namakondobwe uye namakwayana, zvipiriso zvezviyo nezvipiriso zvinonwiwa maererano nouwandu hwakarayirwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muisewo nhongo yembudzi imwe chete sechipiriso chechivi, muchipamhidzira kuchipiriso chamazuva ose pamwe chete nechipiriso chacho uye nezvipiriso zvazvo zvokunwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.19",
            "verseOrgIds": [
              "NUM.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
