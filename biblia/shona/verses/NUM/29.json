            "sid": "NUM 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva rechitatu, mugadzire hando gumi neimwe, makondobwe maviri uye namakwayana makono gumi namana egore rimwe chete, zvose zvisina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.20",
            "verseOrgIds": [
              "NUM.29.20"
            ]
          }
        },
        {
          "name": "verse",
