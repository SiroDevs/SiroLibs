          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva rechina, mugadzire hando gumi, makondobwe uye makwayana gumi namana egore rimwe chete, zvose zvisina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.23",
            "verseOrgIds": [
              "NUM.29.23"
            ]
          }
        },
        {
          "name": "verse",
