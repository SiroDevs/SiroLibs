          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaKohati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi naAroni:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Verenga vaKohati ivo bazi ravaRevhi nedzimba dzavo nemhuri dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uverenge varume vose kubvira pane vane makore makumi matatu kusvikira pane vane makore makumi mashanu vanouya kuzoshanda basa romuTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iri ndiro basa ravaKohati muTende Rokusangana: kuchengetedza zvinhu zvitsvene-tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ungano yosimuka Aroni navanakomana vake vanofanira kupinda vagobvisa chidzitiro vagofukidza areka yeChipupuriro nacho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanofanira kuchifukidza namatehwe emhou dzomugungwa, vagowarira mucheka webhuruu pamusoro pacho uye vagoisa matanda panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamusoro petafura yoKuvapo, vanofanira kuwarira mucheka webhuruu vagoisa pamusoro pawo ndiro, madhishi uye mbiya, nemikombe yezvipiriso zvinonwiwa; chingwa chamazuva ose chinofanira kuramba chiri pamusoro payo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvinhu izvi, vanofanira kuwarira mucheka mutsvuku, vagoifukidza namatehwe emhou dzomugungwa, vagoisa matanda acho panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanofanira kutora mucheka webhuruu vagofukidza chigadziko chomwenje wokuvhenekesa, pamwe chete nemwenje yacho netambo netireya dzacho nemidziyo yacho yose yamafuta anoshandiswa pakuvhenekesa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanofanira kuchiputira pamwe chete nezvimwe zvacho muchifukidzo chamatehwe emhou dzomugungwa vagochiisa pamatanda okutakurisa nawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamusoro pearitari yegoridhe, vanofanira kuwarira mucheka webhuruu vagoufukidza namatehwe emhou dzomugungwa vagopinza matanda panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanofanira kutora midziyo yose inoshandiswa pakushumira munzvimbo tsvene, vagoiputira mumucheka webhuruu, vagofukidza izvozvo namatehwe emhou dzegungwa uye vagozviisa pamatanda okutakurisa nawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanofanira kubvisa madota paaritari yendarira vagowarira mucheka wepepuru pamusoro payo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanofanira kuisa pamusoro payo midziyo yose inoshandiswa pakushumira paaritari kusanganisira namakango, forogo dzenyama, foshoro nembiya dzokusasa. Vanofanira kuwarira chifukidzo chamatehwe emhou dzegungwa pamusoro payo, vagopinza matanda ayo panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mushure mokunge Aroni navanakomana vake vapedza kufukidza midziyo yose mitsvene, uye kana vava kusimuka, vaKohati ndivo vanofanira kuuya kuzotakura. Asi havafaniri kubata zvinhu zvitsvene, kuti varege kufa. VaKohati ndivo vanofanira kutakura zvinhu zviri muTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ereazari mwanakomana waAroni, muprista, anofanira kuva mutariri wamafuta emwenje, zvinonhuhwira, chipiriso chezviyo chamazuva ose uye namafuta okuzodza. Anofanira kuva mutariri wetabhenakeri yose nezvinhu zvose zviri mairi, kusanganisira nemidziyo yayo mitsvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi naAroni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uone kuti rudzi rwavaKohati haruna kuparadzwa kubva pakati pavaRevhi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti vararame uye varege kufa pavanoswedera pedyo nezvinhu zvitsvene, uvaitire izvi: Aroni navanakomana vake vanofanira kupinda munzvimbo tsvene vagorayira murume mumwe nomumwe basa rake nezvaanofanira kuita.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaKohati havafaniri kupinda kundotarisa zvinhu zvitsvene, kana kwechinguva, kuti varege kufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaGerishoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Verengawo vaGerishoni nemhuri dzavo uye nedzimba dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uverenge varume vose kubvira pane vane makore makumi matatu kusvikira pane vane makore makumi mashanu vanouya kuzoshanda basa romuTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiro basa redzimba dzavaGerishoni pavanoshanda vachitakura mitoro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanofanira kutakura zvidzitiro zvetabhenakeri, Tende Rokusangana, zvifukidzo zvaro uye zvifukidzo zvokunze zvamatehwe emhou dzegungwa, zvidzitiro zvapamukova wokupinda kuTende Rokusangana,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvidzitiro zvaparuvazhe runopoteredza tabhenakeri nearitari, chidzitiro chapamukova, tambo nemidziyo yose inoshandiswa pakushumira. VaGerishoni vanofanira kuita zvose zvinofanira kuitwa pakushandisa zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabasa avo ose kungava kutakura kana kuita rimwe basa, zvinofanira kuitwa nokurayira kwaAroni navanakomana vake. Muchavatuma sebasa ravo zvose zvavanofanira kutakura.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiro basa redzimba dzavaGerishoni paTende Rokusangana. Vanofanira kurayirwa pamabasa avo naItamari mwanakomana waAroni muprista.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaMerari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Verenga vaMerari nedzimba dzavo nemhuri dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Verenga varume vose kubvira pane vane makore makumi matatu kusvikira pane vane makore makumi mashanu vanouya kuzoshanda basa muTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
