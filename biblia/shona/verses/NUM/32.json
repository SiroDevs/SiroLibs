      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akapa kuvaGadhi, navaRubheni nehafu yorudzi rwaManase, mwanakomana waJosefa, umambo hwaSihoni mambo wavaAmori noumambo hwaOgi mambo weBhashani, nyika yose namaguta ayo uye nenyika dzose dzakavapoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaGadhi vakavaka Dhibhoni, Ataroti, Aroeri,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataroti Shafani, Jazeri, Jogubheha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheti Nimura neBheti Harani samaguta akakomberedzwa, uye vakavaka matanga amakwai avo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vaRubheni vakavakazve Heshibhoni, Ereare Kiriatihaimi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete neNebho neBhaari Meoni (mazita aya akashandurwa) neSibhima. Vakapa mazita kumaguta avakavaka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvaMakiri mwanakomana waManase zvakaenda kuGireadhi, zvikaritapa zvikadzinga vaAmori vakanga varimo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akapa Gireadhi kuvaMakiri, zvizvarwa zvaManase, ivo vakagara ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jairi, chizvarwa chaManase, akakunda misha yaro akaitumidza kuti Havhoti Jairi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Nobha akakunda Kenati nenzvimbo dzakaripoteredza akaritumidza kuti Nobha zita rake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
