  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "LUK 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chivi, Kutenda neZvokuita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kuvadzidzi vake, \"Zvinhu zvinoita kuti vanhu vatadze zvinototi zviuye, asi ane nhamo munhu uyo anouya nazvo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvaiva nani kwaari kuti guyo risungirirwe pamutsipa wake agokandwa mugungwa pano kuti atadzise mumwe wavaduku ava.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.2",
            "verseOrgIds": [
              "LUK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvingwarirei.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:3"
      },
      "items": [
        {
          "text": "\"Kana hama yako ichitadza, itsiure, uye kana akatendeuka, umuregerere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana akakutadzira kanomwe pazuva, uye akadzoka kwauri kanomwe achiti, 'Ndatendeuka,' muregerere.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.4",
            "verseOrgIds": [
              "LUK.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vapostori vakati kuna She, \"Tiwedzereiwo kutenda kwedu!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.5",
            "verseOrgIds": [
              "LUK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Kana muno kutenda kuduku duku setsanga yemasitadhi, munogona kuti kumuti womuonde uyu, 'Dzurwa usimwe mugungwa,' uye uchakuteererai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngatitii mumwe wenyu anga aine muranda anorima kana kuti anofudza makwai. Angati here kumuranda paanopinda achibva kumunda, 'Uya pano iye zvino ugare pasi udye'?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.7",
            "verseOrgIds": [
              "LUK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, haangati here, 'Ndigadzirire chokudya changu, uzvigadzirire iwe ugondimirira pandinenge ndichidya nokunwa; shure kwaizvozvo iwe ungazodya hako nokunwa'?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.8",
            "verseOrgIds": [
              "LUK.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, angavonga muranda nokuda kwokuti akaita zvaakaudzwa here?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.9",
            "verseOrgIds": [
              "LUK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka nemiwo, pamunenge maita zvose zvamakaudzwa kuti muite, munofanira kuti, 'Tiri varanda vasina maturo; tangoita zvatanga tichifanira kuita.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.10",
            "verseOrgIds": [
              "LUK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanhu Gumi vanoporeswa Maperembudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ari munzira achienda kuJerusarema, Jesu akafamba achitevedza muganhu waiva pakati peSamaria neGarirea.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanga opinda mumusha, varume gumi vaiva namaperembudzi vakasangana naye. Vakamira vari nechokure",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.12",
            "verseOrgIds": [
              "LUK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakadanidzira nenzwi guru vachiti, \"Jesu, Tenzi, tinzwireiwo ngoni!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.13",
            "verseOrgIds": [
              "LUK.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achivaona, akati kwavari, \"Endai munozviratidza kuvaprista.\" Uye pavaienda, vakabva vanatswa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavo akati aona kuti akanga aporeswa, akadzoka achirumbidza Mwari nenzwi guru.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.15",
            "verseOrgIds": [
              "LUK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazviwisira patsoka dzaJesu akamuvonga. Uye akanga ari muSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.16",
            "verseOrgIds": [
              "LUK.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Ko, havasi vose gumi vakaporeswa here? Ko, vamwe vapfumbamwe varipi?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwashayikwa mumwe woga adzoka akazorumbidza Mwari kunze kwouyu mutorwa here?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.18",
            "verseOrgIds": [
              "LUK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwaari, \"Simuka uende; kutenda kwako kwakuporesa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuuya kwoUmambo hwaMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati abvunzwa navaFarisi kuti umambo hwaMwari hwaizosvika riini, Jesu akapindura akati, \"Umambo hwaMwari hahuuyi nokunyatsocherechedza kwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vanhu havangati, 'Hohuno pano' kana kuti 'Uho uko,' nokuti umambo hwaMwari huri mamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.21",
            "verseOrgIds": [
              "LUK.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kuvadzidzi vake, \"Nguva iri kuuya yamuchashuva kuona rimwe ramazuva oMwanakomana woMunhu, asi hamuzorioni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vachati kwamuri, 'Hoyo uko!' kana kuti 'Houno pano!' Musamhanya muchivatevera.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.23",
            "verseOrgIds": [
              "LUK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti semheni inopenya ichivhenekera muchadenga ichibva kuno rumwe rutivi ichienda kuno rumwe rutivi, ndizvo zvichaita Mwanakomana woMunhu pazuva rake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
            "verseOrgIds": [
              "LUK.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi anofanira kutanga kumbotambudzika zvikuru uye acharambwa norudzi urwu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.25",
            "verseOrgIds": [
              "LUK.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sezvazvakanga zvakaita pamazuva aNoa, ndizvo zvazvichaitawo mumazuva oMwanakomana woMunhu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vaidya, vachinwa, vachiwana nokuwaniswa kusvikira zuva rakapinda Noa muareka. Ipapo mafashamu akasvika akavaparadza vose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
              "LUK.17.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvakanga zvakadarowo pamazuva aRoti. Vanhu vakanga vachidya nokunwa, vachitonga nokutongesa, vachidyara nokuvaka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pazuva rakabuda Roti muSodhomu, moto nesuriferi zvakanaya, zvichibva kudenga zvikavaparadza vose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvichaita saizvozvo pazuva iro Mwanakomana woMunhu acharatidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro hakuna munhu ari pamusoro pedenga remba, ane nhumbi dzake mukati memba, anofanira kuburuka kuti andodzitora. Saizvozvowo, hakuna munhu ari kumunda achadzokera chinhu chero chipi zvacho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai mukadzi waRoti!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.32",
            "verseOrgIds": [
              "LUK.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anoedza kuchengetedza upenyu hwake acharasikirwa nahwo, uye ani naani anorasikirwa noupenyu hwake achahuponesa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoti kwamuri, pazuva iro vanhu vaviri vachange vari pamubhedha mumwe; mumwe achatorwa mumwe achisiyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vaviri vachange vachikuya zviyo pamwe chete; mumwe achatorwa uye mumwe achasiyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vachange vari mumunda, mumwe achatorwa uye mumwe achasiyiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvunza vakati, \"Kupiko Ishe?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:37"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Pano mutumbi, ndipo panoungana magora.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
