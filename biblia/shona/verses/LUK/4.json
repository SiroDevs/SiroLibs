{
  "id": "LUK.4",
  "number": "4",
  "bookId": "LUK",
  "reference": "Ruka 4",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "LUK 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuedzwa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu, azere noMweya Mutsvene, akadzoka kubva paJorodhani akatungamirirwa noMweya mugwenga,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
            "verseOrgIds": [
              "LUK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "umo maakaedzwa naSatani kwamazuva makumi mana. Haana chaakadya pamazuva iwayo, uye pakupera kwamazuva iwayo akanzwa nzara.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.2",
            "verseOrgIds": [
              "LUK.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akati kwaari, \"Kana iwe uri mwanakomana waMwari, rayira dombo iri kuti rive chingwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.3",
            "verseOrgIds": [
              "LUK.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Kwakanyorwa kuchinzi, 'Munhu haararami nechingwa bedzi, asi neshoko rimwe nerimwe rinobuda mumuromo maMwari.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.4",
            "verseOrgIds": [
              "LUK.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akamutungamirira kunzvimbo yakakwirira uye akamuratidza munguva diki diki umambo hwose hwenyika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.5",
            "verseOrgIds": [
              "LUK.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwaari, \"Ndichakupa simba rahwo rose nokubwinya kwahwo, nokuti ndakahupiwa, uye ini ndinogona kuhupa kuna ani zvake wandinoda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.6",
            "verseOrgIds": [
              "LUK.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka kana ukandinamata, huchava hwako hwose.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.7",
            "verseOrgIds": [
              "LUK.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Kwakanyorwa kuchinzi, 'Namata Ishe Mwari wako umushumire iye oga.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.8",
            "verseOrgIds": [
              "LUK.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akamutungamirira kuJerusarema akamuita kuti amire pachiruvi chetemberi. Akati kwaari, \"Kana uri mwanakomana waMwari, zviwisire pasi uchibva pano.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.9",
            "verseOrgIds": [
              "LUK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kwakanyorwa kuchinzi:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.10",
            "verseOrgIds": [
              "LUK.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 4:10"
      },
      "items": [
        {
          "text": "\" 'Acharayira vatumwa vake pamusoro pako",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.10",
            "verseOrgIds": [
              "LUK.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 4:10"
      },
      "items": [
        {
          "text": "kuti vakuchengete kwazvo;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.10",
            "verseOrgIds": [
              "LUK.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachakusimudza mumaoko avo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.11",
            "verseOrgIds": [
              "LUK.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 4:11"
      },
      "items": [
        {
          "text": "kuti rutsoka rwako rurege kugumburwa padombo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.11",
            "verseOrgIds": [
              "LUK.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Zvinonzi, 'Usaedza Ishe Mwari wako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.12",
            "verseOrgIds": [
              "LUK.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akati apedza kuedza kwake kwose uku, akabva paari kusvikira pane imwe nguva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.13",
            "verseOrgIds": [
              "LUK.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anorambwa muNazareta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akadzokera kuGarirea musimba roMweya, uye shoko pamusoro pake rakapararira kumativi ose enyika.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadzidzisa mumasinagoge avo, uye munhu wose akamurumbidza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.15",
            "verseOrgIds": [
              "LUK.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda kuNazareta, kwaakanga arerwa, uye nomusi weSabata akapinda musinagoge, setsika yake. Akasimuka kuti averenge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.16",
            "verseOrgIds": [
              "LUK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rugwaro rwakapetwa rwaIsaya rwakapiwa kwaari. Pakurubhedhenura, akawana pakanga pakanyorwa kuti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
            "verseOrgIds": [
              "LUK.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mweya waShe uri pamusoro pangu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 4:18"
      },
      "items": [
        {
          "text": "nokuti akandizodza",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 4:18"
      },
      "items": [
        {
          "text": "kuti ndiparidze vhangeri kuvarombo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 4:18"
      },
      "items": [
        {
          "text": "Akandituma kuti ndiparidze rusununguko kuna vakasungwa",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 4:18"
      },
      "items": [
        {
          "text": "uye kuti vasingaoni vaone,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 4:18"
      },
      "items": [
        {
          "text": "kuti ndisunungure vakamanikidzwa,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.18",
            "verseOrgIds": [
              "LUK.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ndiparidze gore rakanaka raShe.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.19",
            "verseOrgIds": [
              "LUK.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapeta rugwaro, akarudzosera kumubati akagara pasi. Meso avanhu vose vakanga vari musinagoge akanga akati nde-e kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.20",
            "verseOrgIds": [
              "LUK.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akatanga nokuti kwavari, \"Nhasi rugwaro urwu rwazadziswa munzeve dzenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.21",
            "verseOrgIds": [
              "LUK.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakataura zvakanaka pamusoro pake uye vakashamiswa namashoko akanaka akanga achibuda mumuromo make. Vakati, \"Ko, uyu haazi mwanakomana waJosefa here?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.22",
            "verseOrgIds": [
              "LUK.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwavari, \"Zvirokwazvo muchataura tsumo iyi kwandiri muchiti: 'Murapi, chizvirapa! Itawo muguta rako rino zvatakanzwa kuti wakaita muKapenaume.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.23",
            "verseOrgIds": [
              "LUK.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenderera mberi achiti, \"Ndinokuudzai chokwadi kuti hakuna muprofita anogamuchirwa muguta rake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.24",
            "verseOrgIds": [
              "LUK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti kwakanga kune chirikadzi zhinji muIsraeri panguva yaEria, panguva yakadzivirwa denga kwamakore matatu nehafu uye nzara huru ikavapo munyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.25",
            "verseOrgIds": [
              "LUK.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Eria haana kutumwa kuno mumwe wavo, asi kuchirikadzi yeZerafati munyika yeSidhoni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.26",
            "verseOrgIds": [
              "LUK.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kwaiva navazhinji vaiva namaperembudzi panguva yaEria muprofita, asi hapana mumwe chete pakati pavo akanatswa kunze kwaNaamani muSiria.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.27",
            "verseOrgIds": [
              "LUK.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakanga vari musinagoge vakatsamwa kwazvo pavakanzwa izvi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.28",
            "verseOrgIds": [
              "LUK.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasimuka, vakamubudisa muguta, vakamutora vakaenda naye kumucheto cheto kwechikomo chakanga chakavakirwa guta ravo, kuti vamusundidzire kumawere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.29",
            "verseOrgIds": [
              "LUK.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akafamba napakati pemhomho yavanhu akaenda zvake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.30",
            "verseOrgIds": [
              "LUK.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anodzinga Mweya Wakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaburuka zasi kuKapenaume, guta riri muGarirea, akatanga kudzidzisa vanhu nomusi weSabata.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.31",
            "verseOrgIds": [
              "LUK.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakashamiswa nokudzidzisa kwake, nokuti shoko rake raiva nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.32",
            "verseOrgIds": [
              "LUK.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musinagoge makanga muno murume akanga akabatwa nedhimoni, mweya wakaipa, uye akadanidzira nenzwi guru achiti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.33",
            "verseOrgIds": [
              "LUK.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"A! Munodeiko kwatiri imi Jesu weNazareta? Ko, mauya kuzotiparadza kanhi? Ndinoziva kuti muri ani, muri Mutsvene waMwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.34",
            "verseOrgIds": [
              "LUK.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akaurayira achiti, \"Nyarara! Buda maari!\" Ipapo dhimoni rakaputsira murume uyu pasi pamberi pavo vose rikabuda risina kumukuvadza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.35",
            "verseOrgIds": [
              "LUK.4.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakashamiswa vakataurirana vachiti, \"Kudzidzisa uku ndokupi? Anorayira mweya yakaipa nechikuriri uye nesimba, ichibva yabuda!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.36",
            "verseOrgIds": [
              "LUK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukurumbira wake wakapararira munzvimbo dzose dzakapoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoporesa Vazhinji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akabva pasinagoge akaenda kumba kwaSimoni. Zvino mai vomukadzi waSimoni vairwara nefivha, uye vakakumbira Jesu kuti avabatsire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akakotamira kwavari akarayira fivha, ikabva pavari. Vakasimuka pakarepo vakatanga kuvashandira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakati rodoka, vanhu vakauya kuna Jesu navose vakanga vana marudzi akasiyana-siyana ezvirwere, akaisa maoko ake pamusoro pomumwe nomumwe wavo akavaporesa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.40",
            "verseOrgIds": [
              "LUK.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, madhimoni akabuda muvanhu vazhinji, achidanidzira achiti, \"Ndiwe Mwanakomana waMwari!\" Asi iye akaatsiura akasaatendera kuti ataure, nokuti iwo aiziva kuti ndiye Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.41",
            "verseOrgIds": [
              "LUK.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani, Jesu akaenda kunzvimbo yakanyarara ari oga. Vanhu vakanga vachimutsvaka uye vakati vamuwana paakanga ari, vakaedza kumudzivisa kuti asabva kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.42",
            "verseOrgIds": [
              "LUK.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye akati, \"Ndinofanira kuparidza vhangeri roumambo hwaMwari kuna mamwewo maguta, nokuti ndizvo zvandakatumirwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.43",
            "verseOrgIds": [
              "LUK.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akaramba achiparidza mumasinagoge eJudhea.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.44",
            "verseOrgIds": [
              "LUK.4.44"
            ]
          }
        }
      ]
    }
  ],
