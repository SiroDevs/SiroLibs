  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "LUK 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutenda kwoMukuru weZana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati apedza kutaura zvose izvi vanhu vachizvinzwa, akapinda muKapenaume.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.1",
            "verseOrgIds": [
              "LUK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imomo maiva nomuranda womukuru wezana, aidiwa chose natenzi wake, akanga achirwara uye ava kuda kufa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.2",
            "verseOrgIds": [
              "LUK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wezana akanzwa nezvaJesu uye akatuma vamwe vakuru vavaJudha kwaari, achimukumbira kuti auye kuzoporesa muranda wake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.3",
            "verseOrgIds": [
              "LUK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika kuna Jesu, vakamukumbira zvikuru vachiti, \"Murume uyu akafanira kuti mumuitire izvi,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.4",
            "verseOrgIds": [
              "LUK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti anoda rudzi rwedu uye ndiye akavaka sinagoge redu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.5",
            "verseOrgIds": [
              "LUK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Jesu akaenda navo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.6",
            "verseOrgIds": [
              "LUK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 7:6"
      },
      "items": [
        {
          "text": "Akanga asiri kure nomusha pakatumwa shamwari nomukuru wezana kuti dzinoti kwaari, \"Ishe, musazvinetsa zvenyu, nokuti handina kukodzera kuti imi mupinde mumba mangu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.6",
            "verseOrgIds": [
              "LUK.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka ndisina kumbofunga kuti ini ndive nekodzero yokuuya kwamuri. Asi, taurai henyu shoko, uye muranda wangu achapora.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.7",
            "verseOrgIds": [
              "LUK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ini pachangu, ndiri munhu ari pasi pavamwe, uye ndine varwi vari pasi pangu. Ndinoti kuno uyu, 'Enda,' uye anoenda, kuno mumwe, 'Uya' uye anouya. Ndinoti kumuranda wangu, 'Ita ichi,' uye anochiita.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.8",
            "verseOrgIds": [
              "LUK.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati anzwa izvi, akashamiswa kwazvo naye, akatendeukira kuvanhu vazhinji vaimutevera akati, \"Ndinoti kwamuri, handina kumboona kutenda kwakadai kunyange muIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.9",
            "verseOrgIds": [
              "LUK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vaya vakanga vatumwa vakadzokera kumba vakawana muranda uya apora.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.10",
            "verseOrgIds": [
              "LUK.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anomutsa Mwanakomana weChirikadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasina kupera nguva refu, Jesu akaenda kuguta rainzi Naini, vadzidzi vake navanhu vazhinji kwazvo vakaendawo naye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.11",
            "verseOrgIds": [
              "LUK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzoti ave kuswedera pasuo reguta, munhu akafa akanga akatakurwa achiburitswa kunze, aingova mwanakomana mumwe chete wamai vake, uye vakanga vari chirikadzi. Uye vanhu vazhinji kwazvo vaibva muguta vaiva navo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.12",
            "verseOrgIds": [
              "LUK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe akati achivaona, mwoyo wake wakavanzwira tsitsi, akati kwavari, \"Musachema.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.13",
            "verseOrgIds": [
              "LUK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaswedera pedyo akabata hwanyanza, uye vaya vakanga vakamutakura vakamira. Akati, \"Jaya, ndinoti kwauri, muka!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.14",
            "verseOrgIds": [
              "LUK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu uya akanga afa akamuka akagara akatanga kutaura, uye Jesu akamupa kuna mai vake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.15",
            "verseOrgIds": [
              "LUK.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakazadzwa nokutya vakarumbidza Mwari. Vakati, \"Muprofita mukuru amuka pakati pedu. Mwari auya kuzobatsira vanhu vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.16",
            "verseOrgIds": [
              "LUK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko iri pamusoro paJesu rakapararira muJudhea yose nenyika dzose dzakapoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.17",
            "verseOrgIds": [
              "LUK.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhume dzakabva kuna Johani Mubhabhatidzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vaJohani vakamuudza pamusoro pezvinhu izvi zvose. Akadana vaviri vavo,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.18",
            "verseOrgIds": [
              "LUK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "akavatuma kuna She kuti vandobvunza kuti, \"Ndimi here iye aifanira kuuya kana kuti tomirira mumwewo?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.19",
            "verseOrgIds": [
              "LUK.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume ava vakati vasvika kuna Jesu, vakati, \"Johani Mubhabhatidzi akatituma kwamuri kuti tizobvunza kuti, 'Ndimi here mainzi muchauya, kana kuti timirire mumwewo?' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.20",
            "verseOrgIds": [
              "LUK.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Jesu akaporesa vazhinji vakanga vane zvirwere, matenda nemweya yakaipa uye akasvinudza vazhinji vakanga vari mapofu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.21",
            "verseOrgIds": [
              "LUK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akapindura nhume achiti, \"Dzokerai munoudza Johani zvamaona nezvamanzwa zvokuti: Mapofu anosvinudzwa, zvirema zvinofamba, vaya vana maperembudzi vanoporeswa, matsi dzinonzwa, vakafa vanomutswa uye vhangeri riri kuparidzwa kuvarombo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.22",
            "verseOrgIds": [
              "LUK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa munhu asingagumbuswi nokuda kwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.23",
            "verseOrgIds": [
              "LUK.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokubva kwenhume dzaJohani, Jesu akatanga kutaura kuvanhu vazhinji pamusoro paJohani achiti, \"Makabuda mukaenda kurenje kundooneiko? Rutsanga rwaizungunuswa nemhepo here?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.24",
            "verseOrgIds": [
              "LUK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zvisizvo, makabuda kundooneiko? Munhu akanga akafuka nguo dzakanaka here? Kwete, vaya vanopfeka nguo dzomutengo mukuru uye vanogara zvakanaka ndivo vari mumizinda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.25",
            "verseOrgIds": [
              "LUK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi makabuda kundooneiko? Muprofita here? Hongu, ndinokuudzai, uyewo anokunda muprofita.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.26",
            "verseOrgIds": [
              "LUK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye uya akanyorwa nezvake zvichinzi:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.27",
            "verseOrgIds": [
              "LUK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 7:27"
      },
      "items": [
        {
          "text": "\" 'Ndichatuma nhume yangu pamberi pako,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.27",
            "verseOrgIds": [
              "LUK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 7:27"
      },
      "items": [
        {
          "text": "uyo achakugadzirira nzira yako pamberi pako.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.27",
            "verseOrgIds": [
              "LUK.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai kuti, pakati paavo vose vakaberekwa navakadzi hakuna mukuru kuna Johani; asi muduku muumambo hwaMwari mukuru kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.28",
            "verseOrgIds": [
              "LUK.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose, kunyange navateresi, vakati vanzwa mashoko aJesu, vakabvuma kuti nzira yaMwari yakarurama, nokuti vakanga vabhabhatidzwa naJohani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.29",
            "verseOrgIds": [
              "LUK.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaFarisi nenyanzvi dzomurayiro vakaramba kuda kwaMwari pamusoro pavo, nokuti vakanga vasina kubhabhatidzwa naJohani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.30",
            "verseOrgIds": [
              "LUK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino, ndingafananidza rudzi rwakadai neiko? Vakafanana neiko?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.31",
            "verseOrgIds": [
              "LUK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita savana vagere pamusika vachidanidzira kuno mumwe nomumwe wavo vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 7:32"
      },
      "items": [
        {
          "text": "\" 'Takakuridzirai hwamanda,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 7:32"
      },
      "items": [
        {
          "text": "asi hamuna kutamba;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 7:32"
      },
      "items": [
        {
          "text": "takaimba rwiyo rworufu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 7:32"
      },
      "items": [
        {
          "text": "uye hamuna kuchema.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Johani Mubhabhatidzi akauya asingadyi chingwa uye asinganwi waini, imi mukati, 'Ane dhimoni.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.33",
            "verseOrgIds": [
              "LUK.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana woMunhu akauya achidya uye achinwa, imi mukati, 'Houno munhu wamadyo uye chidhakwa, shamwari yavateresi na\"vatadzi\".'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.34",
            "verseOrgIds": [
              "LUK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi uchenjeri hunoratidzwa navana vahwo vose.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.35",
            "verseOrgIds": [
              "LUK.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anozodzwa Mafuta noMukadzi Mutadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mumwe wavaFarisi akakoka Jesu kuti azodya naye, saka akaenda kumba kwomuFarisi uyu akandogara kuti adye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.36",
            "verseOrgIds": [
              "LUK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe mukadzi womuguta umu akanga achirarama muzvivi akati anzwa kuti Jesu akanga agere pakudya mumba momuFarisi, akauya nechinu chamafuta anonhuhwira chearabhasta,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.37",
            "verseOrgIds": [
              "LUK.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "akamira shure kwake akatanga kuchema, uye akanyorovesa tsoka dzake nemisodzi yake. Ipapo akadzipukuta nebvudzi romusoro wake, akadzitsvoda uye akadzizodza mafuta anonhuhwira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.38",
            "verseOrgIds": [
              "LUK.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino muFarisi uya akanga amukoka akati achiona izvi, akati mumwoyo make, \"Dai munhu uyu anga ari muprofita, angadai aziva kuti mukadzi uyu amubata akaita sei, kuti mutadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.39",
            "verseOrgIds": [
              "LUK.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akamupindura akati, \"Simoni, ndine chinhu chandinoda kukutaurira.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.40",
            "verseOrgIds": [
              "LUK.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 7:40"
      },
      "items": [
        {
          "text": "Iye akati, \"Ndiudzei henyu mudzidzisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.40",
            "verseOrgIds": [
              "LUK.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vamwe varume vaviri vakanga vane chikwereti kumunhu mumwe chete. Mumwe akanga ane chikwereti chamadhenari mazana mashanu, uye mumwe madhenari makumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.41",
            "verseOrgIds": [
              "LUK.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna akanga ane mari yokuripa chikwereti pavari vose vari vaviri, saka nyakukweretesa akadzima zvikwereti zvavo vose. Zvino ndoupiko pauviri hwavo achanyanya kumuda?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.42",
            "verseOrgIds": [
              "LUK.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni akapindura akati, \"Ndinofunga kuti ndouya akadzimirwa chikwereti chikuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.43",
            "verseOrgIds": [
              "LUK.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 7:43"
      },
      "items": [
        {
          "text": "Jesu akati, \"Wataura zvakanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.43",
            "verseOrgIds": [
              "LUK.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatendeukira kumukadzi ndokuti kuna Simoni, \"Unoona here mukadzi uyu? Ndapinda mumba mako; hauna kundipa kana mvura yokugeza tsoka dzangu, asi uyu anyorovesa tsoka dzangu nemisodzi yake uye akadzipukuta nebvudzi romusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.44",
            "verseOrgIds": [
              "LUK.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe hauna kunditsvoda, asi mukadzi uyu, kubvira panguva yandapinda, haana kurega kutsvoda tsoka dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.45",
            "verseOrgIds": [
              "LUK.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe hauna kuzodza musoro wangu namafuta, asi iye adira zvinonhuhwira patsoka dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.46",
            "verseOrgIds": [
              "LUK.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, ndinokuudza kuti zvivi zvake zvizhinji zvaregererwa nokuti iye ada zvikuru. Asi uya akaregererwa zvishoma, anodawo zvishoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.47",
            "verseOrgIds": [
              "LUK.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akati kwaari, \"Zvivi zvako zvaregererwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.48",
            "verseOrgIds": [
              "LUK.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakanga vakokwa vakatanga kutaura pakati pavo vachiti, \"Ndianiko uyu anoti kunyange nezvivi anokanganwira?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.49",
            "verseOrgIds": [
              "LUK.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kumukadzi, \"Kutenda kwako kwakuponesa; chienda norugare.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.50",
            "verseOrgIds": [
              "LUK.7.50"
            ]
          }
        }
      ]
    }
  ],
