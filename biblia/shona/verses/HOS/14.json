  "bookId": "HOS",
  "reference": "Hosea 14",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "HOS 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutendeuka kunouyisa Maropafadzo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Israeri, dzokera kuna Jehovha Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:1"
      },
      "items": [
        {
          "text": "Zvivi zvako ndizvo zvakauyisa kuwa kwako!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endai namashoko",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "uye mudzokere kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "Muti kwaari: \"Regererai zvivi zvedu zvose",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "mutigamuchire nenyasha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:2"
      },
      "items": [
        {
          "text": "kuti tigopa zvibereko zvemiromo yedu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiria haingatiponesi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "hatingatasvi mabhiza ehondo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "Hatizombotizve, 'Vamwari vedu'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "kune zvakagadzirwa namaoko edu chaiwo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:3"
      },
      "items": [
        {
          "text": "nokuti nherera dzinowana tsitsi mamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichaporesa kusateerera kwavo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "uye ndichangovada hangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:4"
      },
      "items": [
        {
          "text": "nokuti hasha dzangu dzabva kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichava sedova kuna Israeri;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "achatunga seruva remahapa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "Somusidhari weRebhanoni",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:5"
      },
      "items": [
        {
          "text": "achadzikisa midzi yake;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mabukira ake achakura.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "Kunaka kwake kuchafanana nekwomuti womuorivhi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:6"
      },
      "items": [
        {
          "text": "kunhuhwira kwake sekwomusidhari weRebhanoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vachagarazve mumumvuri wake.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Achabudirira sezviyo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "Achatunga maruva somuzambiringa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:7"
      },
      "items": [
        {
          "text": "uye mbiri yake ichafanana newaini yeRebhanoni.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhai Efuremu, ndichineiko chokuita nezvifananidzo?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Ndichamupindura uye ndichamuchengeta.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "Ndakafanana nomuti womupaini wakasvibira;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:8"
      },
      "items": [
        {
          "text": "kubereka kwako kunobva kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani akachenjera? Achacherechedza zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Ndiani anonzvera? Achazvinzwisisa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "Nzira dzaJehovha dzakarurama;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "vakarurama vanofamba madziri,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 14:9"
      },
      "items": [
        {
          "text": "asi vatadzi vanogumburwa madziri.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.10"
            ]
          }
        }
      ]
    }
  ],
