    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi, pamwe chete navatungamiri vehondo: vakatsaura vamwe vavanakomana vaAsafi, Hemani naJedhutuni kuti vaite ushumiri hwokuprofita kuchiridzwa mbira, mitengeranwa namakandira. Aya ndiwo mazita avarume vaiita basa iri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuvanakomana vaAsafi:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:2"
      },
      "items": [
        {
          "text": "Zakuri, Josefa, Netania naAsarera. Vanakomana vaAsafi vaitungamirirwa naAsafi uyo aiprofita achitungamirirwa namambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ari Jedhutuni, kuvanakomana vake:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:3"
      },
      "items": [
        {
          "text": "Gedharia, Zeri, Jeshaya, Shimei, Hashabhia naMatitia, vatanhatu pamwe chete, vachitungamirirwa nababa vavo Jedhutuni uyo aiprofita achishandisa mbira mukuvonga nokurumbidza Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ari Hemani, kubva kuvanakomana vake:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:4"
      },
      "items": [
        {
          "text": "Bhukia, Matania, Uzieri, Shubhaeri naJerimoti; Hanania, Hanani, Eriata, Gidhariti naRomamiti-Ezeri; Joshibhekasha, Maroti, Hotiri naMahazioti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose ava vaiva vanakomana vaHemani muoni wamambo. Akavapiwa kubudikidza nezvivimbiso zvaMwari kuti amukudze. Mwari akapa Hemani vanakomana gumi navana, navanasikana vatatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vose ava vaitungamirirwa namadzibaba avo mukuimba mutemberi yaJehovha, nomukuridza makandira nemitengeranwa nembira, kuti vaite ushumiri paimba yaMwari. Asafi, Jedhutuni naHemani vaiva pasi pamambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nehama dzavo, vose vakadzidzira uye vakava nyanzvi mukuimbira Jehovha, vaisvika mazana maviri amakumi masere navasere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaduku navakuru pamwe chete, mudzidzisi pamwe chete nomudzidzi, vakakanda mijenya pakupiwa mabasa avo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujenya wokutanga waiva waAsafi, wakawira pana Josefa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
