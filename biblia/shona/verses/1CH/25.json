    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:9"
      },
      "items": [
        {
          "text": "vanakomana vake nehama dzake—gumi navaviri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 25:9"
      },
      "items": [
        {
          "text": "wechipiri kuna Gedharia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        }
