          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Mikiroti, uyo aiva baba vaShimea. Ivo vaigarawo pedyo nehama dzavo muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri aiva baba vaKishi, Kishi aiva baba vaSauro, uye Sauro aiva baba vaJonatani, Mariki-Shua, Abinadhabhi, naEshi-Bhaari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana waJonatani ainzi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:34"
      },
      "items": [
        {
          "text": "Meribhi-Bhaari uyo aiva baba vaMika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.34",
            "verseOrgIds": [
              "1CH.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaMika vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:35"
      },
      "items": [
        {
          "text": "Pitoni, Mereki Tarea, naAhazi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi aiva baba vaJehoadha, Jehoadha aiva baba vaAremeti, Azimavheti naZimiri uye Zimiri aiva baba vaMoza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza aiva baba vaBhinea Rafa aiva mwanakomana wake, Ereasa mwanakomana wake naAzeri mwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azeri aiva navanakomana vatanhatu, uye aya ndiwo mazita avo:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:38"
      },
      "items": [
        {
          "text": "Arizakami, Bhokeru, Ishumaeri, Shearia, Obhadhia naHanani. Vose ava vaiva vanakomana vaAzeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vomununʼuna wake Esheki vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 8:39"
      },
      "items": [
        {
          "text": "Uramu dangwe rake, Jeushi mwanakomana wake wechipiri naErifereti wechitatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaUramu vaiva varwi voumhare vaigona kushandisa uta. Vaiva navanakomana navazukuru vazhinji vaisvika zana namakumi mashanu pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 8:40"
      },
      "items": [
        {
          "text": "Vose ava vaiva zvizvarwa zvaBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.40",
            "verseOrgIds": [
              "1CH.8.40"
            ]
          }
        }
      ]
