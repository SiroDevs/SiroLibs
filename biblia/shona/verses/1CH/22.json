  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1CH 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati, \"Imba yaJehovha Mwari inofanira kuva pano, pamwe chete nearitari yezvipiriso zvinopisirwa Israeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugadzirira kuvaka Temberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akarayira kuti vatorwa vose vaigara muIsraeri vaungane pamwe chete, uye kubva mukati mavo akasarudza vavezi vamatombo kuti vagadzire matombo akavezwa zvakanaka okuvakisa imba yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapa simbi dzakawanda kwazvo kuti dzigoshandiswa kugadzirisa zvipikiri zvamakonhi apamasuo nezvikorekedzo uye ndarira yakawanda kupfuura yaigona kuiswa pachikero.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapawo zvakare matanda emisidhari akawanda kupfuura aigona kuverengwa, nokuti vaSidhoni nevaTire vakanga vavigira Dhavhidhi matanda akawanda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Mwanakomana wangu Soromoni mudiki kwazvo uye haasati ava noruzivo, uye imba ichavakirwa Jehovha inofanira kuva huru kwazvo, inorumbidzwa uye inokudzwa kwazvo pamberi pendudzi dzose. Saka ndichaigadzirira.\" Saka Dhavhidhi akagadzirira zvikuru kwazvo asati afa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akadana mwanakomana wake Soromoni akamurayira kuti avake imba yaJehovha, Mwari weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Soromoni, \"Mwanakomana wangu zvaiva mumwoyo mangu kuti ndivakire Zita raJehovha Mwari wangu imba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi shoko iri raJehovha rakauya kwandiri richiti, 'Wakadeura ropa zhinji uye ukarwa hondo dzakawanda. Iwe haungavakiri Zita rangu imba, nokuti wakadeura ropa rakawanda kwazvo pamberi pouso hwangu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi uchava nomwanakomana achava murume worugare nokuzorora, uye ndichamupa zororo kubva kuvavengi vake kumativi ose. Zita rake achanzi Soromoni uye ndichapa Israeri runyararo norugare panguva yokutonga kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeye ndiye achavakira Zita rangu imba. Achava mwanakomana wangu uye ini ndichava baba vake. Uye ndichasimbisa chigaro choumambo hwake pamusoro peIsraeri nokusingaperi.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino mwanakomana wangu, Jehovha ave newe, uye uve nokubudirira uye uvake imba yaJehovha Mwari wako sezvaakati uchaita.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ngaakupe uchenjeri nokunzwisisa paachakuisa pakutonga pamusoro peIsraeri, kuitira kuti uchengete murayiro waJehovha Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uchava nokubudirira kana ukachenjerera kuchengetedza mitemo nemirayiro yakapiwa Mozisi naJehovha kuti ape Israeri. Iva nesimba utsunge mwoyo. Usatya uye usaora mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakatambura zvikuru kwazvo kuti ndipe kutemberi yaJehovha matarenda zviuru zana",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "text": "zvegoridhe, matarenda miriyoni",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "text": "esirivha, ndarira nesimbi yakawanda zvokuti haingayerwe pachikero, namatanda namatombo. Uye unogona kuwedzera pamusoro pazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une varume vebasa vazhinji kwazvo: vavezi vamatombo, vavezi vamatanda navamwe varume vane unyanzvi mumabasa ose akasiyana-siyana",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mune zvegoridhe nesirivha, ndarira nesimbi navarume voumhizha vasingaverengeki. Zvino chitanga basa uye Jehovha ave newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akarayira vatungamiri vose veIsraeri kuti vabatsire mwanakomana wake Soromoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.17",
            "verseOrgIds": [
              "1CH.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Ko, Jehovha Mwari wenyu haasi nemi here? Uye haana kukupai zororo kumativi ose here? Nokuti akaisa vagari venyika iyi muruoko rwangu, uye nyika iri pasi paJehovha nepasi pavanhu vake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.18",
            "verseOrgIds": [
              "1CH.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zvipirei mwoyo nemweya kutsvaka Jehovha Mwari wenyu. Tangai kuvaka nzvimbo tsvene yaJehovha Mwari, kuitira kuti mugouyisa areka yesungano yaJehovha nemidziyo mitsvene yaMwari mutemberi ichavakirwa Zita raJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        }
      ]
    }
  ],
