  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1CH 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chivimbiso chaMwari kuna Dhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge Dhavhidhi agara mumuzinda wake akati kuna Natani muprofita, \"Ndiri pano zvangu ndigere mumuzinda womusidhari, asi areka yesungano yaJehovha iri pasi peTende.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani akapindura kuna Dhavhidhi akati, \"Zvose zvamunazvo mupfungwa itai nokuti Mwari anemi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ihwohwo shoko raMwari rakasvika kuna Natani richiti:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.3",
            "verseOrgIds": [
              "1CH.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda unotaurira muranda wangu Dhavhidhi kuti, 'Zvanzi naJehovha: Hausiwe uchandivakira imba yokugara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina kumbogara mumba kubvira zuva randakaburitsa Israeri kubva muIjipiti kusvikira zuva ranhasi. Ndaifamba kubva mutende ndichienda mune rimwe, kubva pane imwe nzvimbo yokugara ndichienda pane imwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.5",
            "verseOrgIds": [
              "1CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwose kwose kwandakafamba navaIsraeri vose, ndakamboti here kuno mumwe zvake wavatungamiri vavo, wandairayira kuti afudze vanhu vangu, \"Seiko usina kundivakira imba yomusidhari?\" '",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.6",
            "verseOrgIds": [
              "1CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino naizvozvo udza muranda wangu Dhavhidhi kuti, 'Zvanzi naJehovha Wamasimba Ose: Ndakakutora kubva kumafuro kwawakanga uchifudza makwai, kuti uve mutongi wavanhu vangu Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanga ndinewe kwose kwawaienda uye ndakauraya vavengi vako vose pamberi pako. Zvino ndichaita kuti zita rako rive samazita avarume vakuru kwazvo panyika.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.8",
            "verseOrgIds": [
              "1CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndichapa nzvimbo kuvanhu vangu Israeri uye ndichavadyara kuti vave nomusha wavo pachavo uye kuti vasazokanganiswa. Vanhu vakaipa havangazovadzvinyiriri zvakare sezvavakavaita pakutanga",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.9",
            "verseOrgIds": [
              "1CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye sezvavakaita kubvira panguva yandakagadza vatungamiri vavanhu vangu Israeri. Ndichakundawo vavengi venyu vose.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1CH 17:10"
      },
      "items": [
        {
          "text": "\" 'Ndinokuudza kuti Jehovha achakuvakira imba:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mazuva ako akwana uye pauchaenda kundova namadzibaba ako, ndichasimudza mwana wako achakutevera paumambo, mumwe wavanakomana vako pachako uye ndichasimbisa umambo hwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.11",
            "verseOrgIds": [
              "1CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeye ndiye achandivakira imba, uye ndichasimbisa chigaro chake choumambo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.12",
            "verseOrgIds": [
              "1CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichava baba vake uye iye achava mwanakomana wangu. Handizobvisi rudo rwangu kwaari zvakare sokurubvisa kwandakaita kune akakutangira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
            "verseOrgIds": [
              "1CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichamugadza kuti atonge imba yangu noumambo hwangu nokusingaperi; chigaro chake chichasimbiswa nokusingaperi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani akandotaura kuna Dhavhidhi mashoko ose echiratidzo chose ichi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munyengetero waDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo Dhavhidhi akapinda akagara pamberi paMwari akati:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1CH 17:16"
      },
      "items": [
        {
          "text": "\"Ndini aniko, nhai Jehovha Mwari, uye mhuri yangu chiiko, kuti mandisvitsawo pano?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye sokuti izvi hazvina kukwana pamberi penyu, haiwa Mwari, mataurazve nezveramangwana reimba yomuranda wenyu. Mandiona sokunge ndini ndinokudzwa kupinda vanhu vose, imi Jehovha Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chiizve chimwe chingataurwa naDhavhidhi kwamuri nokuda kwokuti maremekedza muranda wenyu kudai? Nokuti munoziva muranda wenyu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi Jehovha, nokuda kwomuranda wenyu uye maererano nokuda kwenyu maita chinhu chikuru ichi mukaita kuti zvivimbiso izvi zvikuru zviziviswe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hakuna mumwe akaita semi, imi Jehovha, uye hakuna Mwari kunze kwenyu, sezvatakanzwa nenzeve dzedu pachedu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndiani akaita savanhu venyu Israeri, rudzi rumwe chete panyika runa Mwari warwo akaenda kundozvidzikinurira vanhu, kuti azviitire zita, uye kuti aite zvishamiso zvikuru zvinotyisa, nokudzinga ndudzi kubva pamberi pavanhu venyu vamakadzikinura kubva kuIjipiti?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.21",
            "verseOrgIds": [
              "1CH.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makazvigadzirira vanhu venyu Israeri kuti vave venyu pachenyu nokusingaperi, uye imi, imi Jehovha, mava Mwari wavo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.22",
            "verseOrgIds": [
              "1CH.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uye zvino, Jehovha, itai kuti chivimbiso chamaita kumuranda wenyu neimba yake chisimbiswe nokusingaperi. Itai sezvamakavimbisa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti chisimbiswe uye kuti zita renyu rive guru nokusingaperi. Ipapo vanhu vachati, 'Jehovha Wamasimba Ose, Mwari waIsraeri, ndiye Mwari waIsraeri.' Uye imba yomuranda wenyu Dhavhidhi ichasimbiswa pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imi Mwari wangu, mazivisa muranda wenyu kuti muchamuvakira imba. Saka muranda wenyu atsunga kuti anyengetere kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, muri Mwari! Mavimbisawo zvinhu izvi zvakanaka kumuranda wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino makafadzwa kuti muropafadze imba yomuranda wenyu kuti ienderere mberi nokusingaperi pamberi penyu, nokuti imi, imi Jehovha, mairopafadza uye ichava yakaropafadzwa nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.27",
            "verseOrgIds": [
              "1CH.17.27"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.18",
