    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:23"
      },
      "items": [
        {
          "text": "Mari, Edheri, naJerimoti, vatatu pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vaiva zvizvarwa zvaRevhi nemhuri dzavo, vakuru vemhuri sezvazvakanga vakanyorwa pasi pamazita avo uye vachiverengwa mumwe nomumwe, zvichireva vashandi vaiva namakore makumi maviri naanopfuura vaishanda mutemberi yaJehovha.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Dhavhidhi akanga ati, \"Sezvo Jehovha, Mwari waIsraeri apa zororo kuvanhu vake uye akauya kuzogara muJerusarema nokusingaperi,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaRevhi havachafaniri kuramba vachitakura tabhenakeri kana mimwe midziyo yose yaishandiswa pabasa rayo.\"",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maererano nokurayira kwaDhavhidhi kwokupedzisira, vaRevhi vakaverengwa kubva pana vana makore makumi maviri kana anopfuura ipapo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basa ravaRevhi raiva rokubatsira zvizvarwa zvaAroni, mukubata basa romutemberi yaJehovha: kuvatariri voruvanze, makamuri omumativi, kunatsa zvinhu zvose zvaiera, nokuita mamwe mabasa paimba yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaiva vachengeti vechingwa chaiiswa patafura, upfu hwakatsetseka hwezvipiriso zvezviyo, zvingwa zvitete zvisina mbiriso, kubika nokusanganisa, uye zviero zvose zvouwandu noukuru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaifanirawo zvakare kumira mangwanani oga oga vachitenda uye vachirumbidza Jehovha. Vaifanira kuita zvimwe chetezvo manheru",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye napose paipiwa zvipiriso zvinopiswa kuna Jehovha pamaSabata uye napamitambo yoKugara kwoMwedzi napane mimwe mitambo yakarayirwa. Vaifanira kushanda pamberi paJehovha nguva dzose nouwandu hwaidiwa uye nenzira yavakanga varayirwa kuti vaiite.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro vaRevhi vakaita mabasa omuTende Rokusangana, romuNzvimbo Tsvene uye vari pasi pehama dzavo zvizvarwa zvaAroni, mubasa roushumiri mutemberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
    }
  ],
