          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ereazari akafa asina vanakomana: aingova navanasikana chete. Hama dzavo, vanakomana vaKishi vakavaroora.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.22",
