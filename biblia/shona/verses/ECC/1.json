              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakazvipira kutsvaka kunzwisisa uchenjeri uyezve noupengo noupenzi, asi ndakadzidzawo zvakare kuti, naizvozviwo kudzingana nemhepo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
