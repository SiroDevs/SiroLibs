          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo, Mwari paanopa munhu upi zvake mari nezvinhu, uye achiita kuti akwanise kuti afadzwe nazvo kuti agamuchire mugove wake uye kuti afadzwe nebasa rake, ichi chipo chinobva kuna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.19",
            "verseOrgIds": [
              "ECC.5.18"
            ]
          }
