  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ECC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona chimwe chinhu chakaipa pasi pezuva, uye chinoremedza vanhu zvikuru:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari anopa munhu mari nezvinhu zvakawanda uye nokukudzwa, zvokuti haana chaangashayiwa pazvinhu zvinodiwa nomwoyo wake, asi Mwari haazomutenderi kuti afadzwe nazvo, uye mutorwa ndiye anozofadzwa nazvo panzvimbo yake. Izvi hazvina maturo, chinhu chakaipa chinorwadza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu angava navana zana agorarama makore akawanda, asi hazvinei kuti ararama nguva yakareba sei, kana akasafara nezvaanowana uyezve akasavigwa zvakanaka, ndinoti mwana aberekwa ari gavamwedzi ari nani pana iye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anouya asina zvaanoreva anoendazve murima, uye murima zita rake rinofukidzirwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange asina kumboona zuva kana kuziva chinhu, ane zororo rinopfuura munhu iyeyu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunyange akararama makore anokwana zviuru zviviri, asi akatadza kufadzwa nezvaanowana. Ko, vose havaendi kunzvimbo imwe chete here?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kushingaira kwose kwomunhu kunoitirwa muromo wake,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:7"
      },
      "items": [
        {
          "text": "kunyange zvakadaro kuda kwake zvokudya hakugutswi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, akachenjera anokurira",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:8"
      },
      "items": [
        {
          "text": "benzi pachii?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 6:8"
      },
      "items": [
        {
          "text": "Ko, murombo anowanei nokuziva",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:8"
      },
      "items": [
        {
          "text": "kuzvibata pamberi pavamwe?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviri nani zvinoonekwa nameso",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:9"
      },
      "items": [
        {
          "text": "pane kutsvaka-tsvaka kwomwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 6:9"
      },
      "items": [
        {
          "text": "Izviwo hazvina maturo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:9"
      },
      "items": [
        {
          "text": "kudzinganisana nemhepo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinhu chipi nechipi chiripo chakapiwa zita kare,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:10"
      },
      "items": [
        {
          "text": "uye munhu zvaari zvakazivikanwa kare;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 6:10"
      },
      "items": [
        {
          "text": "hakuna munhu anorwisana",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:10"
      },
      "items": [
        {
          "text": "nomunhu anomupfuura pasimba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwanda kwamashoko",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:11"
      },
      "items": [
        {
          "text": "ndikowo kuwanda kwezvisina maturo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:11"
      },
      "items": [
        {
          "text": "uye zvingabatsira aniko zvakadai?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndiani angaziva zvakanakira munhu muupenyu, pamazuva mashoma uye asina maturo anopfuura somumvuri? Nokuti ndiani angaudza munhu zvinozomutevera mushure mokunge iye aenda?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
        }
      ]
    }
  ],
