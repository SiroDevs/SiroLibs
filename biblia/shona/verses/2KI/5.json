  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naamani Anoporeswa Maperembudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Naamani, mukuru wehondo yamambo weAramu, aiva munhu mukuru kwazvo pamberi patenzi wake uye aikudzwa zvikuru, nokuti kubudikidza naye, Jehovha akapa mambo weAramu kukunda. Aiva murwi ane simba noumhare, asi aiva namaperembudzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mauto eAramu akabuda kundorwa akadzoka ava nomusikana weIsraeri wavakanga vatapa, uye akashandira mukadzi waNaamani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuna tenzikadzi wake, \"Dai tenzi wangu aiona muprofita ari muSamaria! Aizomuporesa pamaperembudzi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.3",
            "verseOrgIds": [
              "2KI.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani akaenda kuna tenzi wake akamutaurira zvaakanga audzwa nomusikana akanga abva kuIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.4",
            "verseOrgIds": [
              "2KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weAramu akati, \"Zvakanaka, enda hako. Ini ndichatumirawo tsamba kuna mambo weIsraeri.\" Naizvozvo Naamani akaenda, akatora matarenda gumi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "text": "esirivha nezviuru zvitanhatu zvamashekeri",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "text": "egoridhe uye nemhando gumi dzenguo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsamba yaakaenda nayo kuna mambo weIsraeri yaiti: \"Ndatuma muranda wangu Naamani netsamba iyi kuti umurape maperembudzi ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akati achangopedza kuverenga tsamba iyi, akabvarura nguo dzake akati, \"Ndini Mwari here? Ndinogona kuuraya nokuraramisa here? Sei murume uyu atuma munhu kwandiri kuti azorapwa maperembudzi ake. Onai kuti anoedza sei kutsvaka bopoto neni!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha munhu waMwari, akati anzwa kuti mambo weIsraeri abvarura nguo dzake, akamutumira shoko akati, \"Mabvarurireiko nguo dzenyu? Regai murume uyo auye kwandiri, uye achaziva kuti muIsraeri mune muprofita.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Naamani akaenda namabhiza ake nengoro akandomira pamukova weimba yaErisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akatuma nhume yake kwaari achiti, \"Enda unoshamba kanomwe muJorodhani, ipapo nyama yako ichadzoredzerwa pakare uye uchava wakanatswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Naamani akabvapo atsamwa akati, \"Ndanga ndichifunga kuti zvirokwazvo achauya kwandiri agomira achidana kuzita raJehovha Mwari wake, agoninira ruoko rwake panzvimbo yacho agondiporesa maperembudzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, Abhana neFaripari, idzo nzizi dzeDhamasiko, hadzisi nani kupinda mvura yose yeIsraeri here? Handaigona kushamba madziri ndikanatswa here?\" Naizvozvo akabvapo akaenda akatsamwa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda vaNaamani vakaenda kwaari vakati, \"Nhai baba, dai muprofita anga akuudzai kuti muite chinhu chikuru, hamaizochiita here? Zvino zvaati kwamuri, 'Shambai mugonatswa!' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akaburuka akandozvinyudza muna Jorodhani kanomwe, sezvaakanga audzwa nomunhu waMwari, nyama yake ikadzoredzerwa pakare ikava yakachena, seyomwana mucheche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Naamani akadzokera neboka rake rose kumunhu waMwari. Akamira pamberi pake akati, \"Zvino ndava kuziva kuti hakuna Mwari panyika yose kunze kwomunyika yeIsraeri. Ndapota, gamuchirai chipo chabva kumuranda wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muprofita akati, \"Zvirokwazvo, naJehovha mupenyu, iye wandinoshumira, handisi kuzogamuchira chinhu.\" Kunyange zvazvo Naamani akamugombedzera, iye akaramba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani akati, \"Ndapota, kana musingadi, muranda wenyu ngaapiwe hake ivhu ringatakurwa namanyurusi maviri, nokuti muranda wenyu haachambofazve akaita chipiriso chinopiswa nechibayiro kuna vamwe vamwari vapi zvavo asi kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.17",
            "verseOrgIds": [
              "2KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha ngaakanganwire muranda wenyu pachinhu chimwe chete ichi: Vatenzi vangu pavanopinda mutemberi yaRimoni kundonamatamo pasi, uye vakasendamira paruoko rwangu, neni ndikakotama ndirimowo, pandinokotama mutemberi yaRimoni, Jehovha ngaakanganwire muranda wenyu pachinhu ichi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.18",
            "verseOrgIds": [
              "2KI.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati, \"Enda hako norugare.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:19"
      },
      "items": [
        {
          "text": "Mushure mokunge Naamani afamba kwechinhambo,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.19",
            "verseOrgIds": [
              "2KI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi muranda waErisha munhu waMwari, akati mumwoyo make, \"Tenzi wangu arerutsira zvakanyanya Naamani, muAramu uyu, pakusagamuchira kubva kwaari zvaanga auya nazvo. Zvirokwazvo naJehovha mupenyu, ndichamhanya ndimutevere ndigotora chimwe chinhu kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Gehazi akatevera Naamani. Zvino Naamani akati amuona achimumhanyira, akaburuka mungoro kuti andosangana naye. Akati kwaari, \"Kwakanaka here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi akapindura akati, \"Kwakanaka. Tenzi wangu andituma achiti, 'Pane majaya maviri abva kuboka ravaprofita achangosvika kwandiri achibva kunyika yamakomo yaEfuremu. Ndapota, muvape henyu tarenda resirivha",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        },
        {
          "text": "nemhando mbiri dzenguo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.22",
            "verseOrgIds": [
              "2KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani akati, \"Torai henyu matarenda maviri.\" Akagombedzera Gehazi kuti azvigamuchire, ndokubva asungira matarenda maviri esirivha mumasaga maviri, nemhando mbiri dzenguo. Akazvipa kuvaranda vake vaviri, vakazvitakura vari mberi kwaGehazi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.23",
            "verseOrgIds": [
              "2KI.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi akati asvika pachikomo, akatora zvinhu kubva kuvaranda akazviisa mumba make. Akadzosa varume vaya ivo ndokuenda havo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.24",
            "verseOrgIds": [
              "2KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akapinda akandomira pamberi paErisha tenzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "Erisha akamubvunza akati, \"Wanga uripiko Gehazi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 5:25"
      },
      "items": [
        {
          "text": "Gehazi akapindura akati, \"Muranda wenyu haana kwaamboenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
