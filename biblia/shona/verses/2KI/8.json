              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafamba munzira dzeimba yaAhabhu akaita zvakaipa pamberi paJehovha, sezvakaitwa neimba yaAhabhu, nokuti akanga ari mukuwasha kumhuri yaAhabhu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
