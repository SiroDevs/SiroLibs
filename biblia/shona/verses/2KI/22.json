  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "2KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bhuku roMurayiro Rinowanikwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia akanga ava namakore masere paakava mambo, uye akatonga muJerusarema kwamakore makumi matatu nerimwe. Zita ramai vake rainzi Jedhidha mwanasikana waAdhaya; aibva kuBhozikati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.1",
            "verseOrgIds": [
              "2KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakanaka pamberi paJehovha uye akafamba munzira dzose dzababa vake Dhavhidhi, akasatsaukira kurudyi kana kuruboshwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore regumi namasere rokutonga kwake, Mambo Josia akatuma munyori, Shafani mwanakomana waAzaria, mwanakomana waMeshurami, kutemberi yaJehovha. Akati kwaari,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda kuna Hirikia muprista mukuru umuudze kuti averenge mari yakauyiswa mutemberi yaJehovha, iya yakaunganidzwa navarindi vomukova ichibva kuvanhu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite kuti vaipe kuvarume vakagadzwa kuti vatarire basa rapatemberi. Uye varume ava vanofanira kuripa vabati vanogadzira temberi yaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "vavezi, navavaki navavezi vamatombo. Uyezve uite kuti vatenge matanda namatombo akavezwa kuti vagadzirise temberi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havafaniri kubvunzwa pamusoro pemari yakaiswa mumaoko avo, nokuti ivo vakatendeka pakubata kwavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hirikia muprista mukuru akati kuna Shafani munyori, \"Ndawana Bhuku roMurayiro mutemberi yaJehovha.\" Akaripa kuna Shafani, uyo akariverenga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Shafani munyori akaenda kuna mambo akandomuzivisa kuti: \"Vabati venyu varipa mari iya yakanga iri mutemberi yaJehovha vakaipa kuvashandi navatariri vapatemberi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Shafani munyori akazivisa mambo achiti, \"Hirikia muprista andipa bhuku.\" Uye Shafani akariverenga pamberi pamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati anzwa mashoko eBhuku roMurayiro, akabvarura nguo dzake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayira Hirikia muprista, naAhikami mwanakomana waShafani, naAkibhori mwanakomana waMikaya, naShafani munyori, naAsaya muranda wamambo achiti,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Endai munondibvunzirawo Jehovha, ini navanhu ava, uye navanhu vose veJudha, pamusoro pezvakanyorwa mubhuku rakawanikwa iri. Nokuti kutsamwa kwaJehovha kwaakatitsamwira nako kukuru nokuda kwamadzibaba edu asina kuteerera mashoko ebhuku iri; havana kuita zvose zvakafanira zvakanyorwa pamusoro pedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hirikia muprista, naAhikami, naAkibhori, naShafani naAsaya vakaenda kundotaura naHuridha muprofitakadzi, akanga ari mukadzi waSharumi mwanakomana waTikivha, mwanakomana waHarihasi, muchengeti wenguo. Aigara muJerusarema, muDunhu reChipiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.14",
            "verseOrgIds": [
              "2KI.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Zvanzi naJehovha, Mwari weIsraeri: Udzai murume akutumai kwandiri kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.15",
            "verseOrgIds": [
              "2KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Zvanzi naJehovha: Ndichauyisa dambudziko pamusoro penzvimbo ino navanhu vayo, zvichienderana nezvose zvakanyorwa mubhuku rakaverengwa namambo weJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.16",
            "verseOrgIds": [
              "2KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vakandirasa, vakapisira zvinonhuhwira kuna vamwe vamwari, vakanditsamwisa nokuda kwezvifananidzo zvose zvavakaita namaoko avo, kutsamwa kwangu kuchapfuta pamusoro penzvimbo ino uye hakungadzimwi.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.17",
            "verseOrgIds": [
              "2KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzai mambo weJudha, akutumai kuzobvunza Jehovha, kuti, 'Zvanzi naJehovha, Mwari waIsraeri, pamusoro pamashoko amakanzwa:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
              "2KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti mwoyo wako wakanga uri munyoro uye ukazvininipisa pamberi paJehovha pawakanzwa zvandakataura pamusoro penzvimbo ino navanhu vayo, kuti vachatukwa uye kuti vachaitwa dongo, uye nokuti wakabvarura nguo dzako ukachema pamberi pangu, ndakunzwa, ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.19",
            "verseOrgIds": [
              "2KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndichakurongedza kumadzibaba ako, uye uchavigwa murugare. Meso ako haachazooni matambudziko ose andichauyisa panzvimbo ino.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.20",
            "verseOrgIds": [
              "2KI.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 22:20"
      },
      "items": [
        {
          "text": "Naizvozvo vakaendesa mhinduro yake kuna mambo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.20",
            "verseOrgIds": [
              "2KI.22.20"
            ]
          }
        }
      ]
    }
  ],
