  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eria naObhadhia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mushure menguva huru, mugore rechitatu, shoko raJehovha rakauya kuna Eria richiti, \"Enda undozviratidza kuna Ahabhu, uye ini ndichanayisa mvura panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.1",
            "verseOrgIds": [
              "1KI.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Eria akaenda kundozviratidza kuna Ahabhu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:2"
      },
      "items": [
        {
          "text": "Zvino nzara yakanga yanyanya kwazvo muSamaria,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Ahabhu akanga adana Obhadhia uyo akanga ari mutariri womuzinda wake. (Obhadhia akanga achitenda kuna Jehovha zvikuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.3",
            "verseOrgIds": [
              "1KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jezebheri paakanga achiuraya vaprofita vaJehovha, Obhadhia akanga atora vaprofita zana akavaviga mumapako maviri, makumi mashanu mune rimwe nerimwe. Uye akavapa kudya nemvura.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.4",
            "verseOrgIds": [
              "1KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabhu akanga ati kuna Obhadhia, \"Enda munyika umu kuzvitubu zvose nemipata yose. Zvimwe tingawana uswa tiraramise mabhiza namanyurusi kuitira kuti tirege kuzouraya kana chimwe chete chezvipfuwo zvedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.5",
            "verseOrgIds": [
              "1KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakagovana nzvimbo dzavaizoenda, Ahabhu achienda kune rimwe divi, Obhadhia kune rimwewo divi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obhadhia akati achifamba, Eria akasangana naye. Obhadhia akamuziva akakotamira pasi, akati, \"Chaizvoizvo chokwadi, ndimi here ishe wangu Eria?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.7",
            "verseOrgIds": [
              "1KI.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Hongu. Enda undoudza ishe wako kuti, 'Eria ari kuno.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.8",
            "verseOrgIds": [
              "1KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obhadhia akabvunza akati, \"Ndatadzeiko zvamava kuendesa muranda wenyu kuna Ahabhu kuti andourayiwa?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.9",
            "verseOrgIds": [
              "1KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo naJehovha Mwari wenyu mupenyu, hakuna rudzi kana nyika, ishe wangu, kwaasina kutuma mumwe munhu kuti andokutsvagai. Uye kana pane nyika kana rudzi vaiti makanga musiko, aitovamanikidza kuti vapike kuti vakanga vakushayai.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.10",
            "verseOrgIds": [
              "1KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino mava kundiudza kuti ndiende kuna ishe wangu ndinoti, 'Eria ari kuno.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.11",
            "verseOrgIds": [
              "1KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini handizivi kuti Mweya waJehovha uchakuendesai kupi kana ndabva pano pamuri. Kana ndikaenda kundoudza Ahabhu, iye akazokushayai, anondiuraya. Asi ini muranda wenyu ndakashumira Jehovha kubvira pauduku hwangu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.12",
            "verseOrgIds": [
              "1KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe wangu, hamuna kunzwa here zvandakaita, Jezebheri paakanga achiuraya vaprofita vaJehovha? Ndakaviga vaprofita vaJehovha zana mumapako maviri, makumi mashanu mune rimwe nerimwe uye ndakavapa kudya nemvura.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.13",
            "verseOrgIds": [
              "1KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mava kundiudza kuti ndiende kuna ishe wangu ndinoti, 'Eria ari kuno.' Anondiuraya!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.14",
            "verseOrgIds": [
              "1KI.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akati, \"NaJehovha Wamasimba Ose mupenyu, wandinoshandira, zvirokwazvo ndichazvipira kuna Ahabhu nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eria paGomo reKarimeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Obhadhia akaenda kundosangana naAhabhu akamuudza, uye Ahabhu akaenda kundosangana naEria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.16",
            "verseOrgIds": [
              "1KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakaona Eria, akati kwaari, \"Ndiwe here, iwe mutambudzi weIsraeri?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.17",
            "verseOrgIds": [
              "1KI.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akapindura akati, \"Handina kuuyisa dambudziko kuIsraeri, asi imi nemhuri yenyu ndimi makadaro. Makasiya mirayiro yaJehovha mukatevera Bhaari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.18",
            "verseOrgIds": [
              "1KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino danai vanhu muIsraeri yose kuti vazosangana neni paGomo reKarimeri. Muuyewo namazana mana namakumi mashanu avaprofita vaBhaari namazana mana avaprofita vaAshera vanodya patafura yaJezebheri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Ahabhu akatuma shoko muIsraeri yose akaunganidza vaprofita paGomo reKarimeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.20",
            "verseOrgIds": [
              "1KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akaenda pamberi pavanhu akati, \"Mucharamba muchifunga mifungo miviri kusvikira riniko? Kana Jehovha ari Mwari, muteverei; asi kana Bhaari ari Mwari, muteverei.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:21"
      },
      "items": [
        {
          "text": "Asi vanhu havana chavakataura.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Eria akati kwavari, \"Ini chete pavaprofita vaJehovha ndini ndasara, asi Bhaari ane vaprofita mazana mana namakumi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.22",
            "verseOrgIds": [
              "1KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Titorerei hando mbiri. Ivo ngavazvisarudzire yavo, uye ngavaicheke-cheke kuita zvidimbu zvidimbu vagoiisa pamusoro pehuni, asi havafaniri kudzitungidza nomoto. Ini ndichagadzira imwe hando yacho ndigoiisa pamusoro pehuni asi handizodzitungidzi nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.23",
            "verseOrgIds": [
              "1KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mudane kuzita ramwari wenyu, uye ini ndichadana kuzita raJehovha. Mwari achapindura nomoto ndiye Mwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:24"
      },
      "items": [
        {
          "text": "Ipapo vanhu vose vakati, \"Zvawataura zvakanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akati kuvaprofita vaBhaari, \"Sarudzai imwe yehando idzi mugotanga imi kuigadzira, sezvo makawanda. Danai kuzita ramwari wenyu, asi musatungidza moto.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakatora hando yavakanga vapiwa vakaigadzira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:26"
      },
      "items": [
        {
          "text": "Ipapo vakadana kuzita raBhaari kubvira mangwanani kusvikira masikati. Vakadanidzira vakati, \"Bhaari, tipindure!\" Asi mhinduro haina kuwanikwa; hapana akapindura. Vakatamba vachipoterera aritari yavakanga vaita.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava masikati, Eria akatanga kuvatuka akati, \"Danidzirisai! Zvirokwazvo ndimwari! Zvichida ari kufunga zvakadzama kwazvo, kana kuti ane basa kwazvo, kana kuti ari parwendo. Zvimwe akavata zvokuti anotofanira kumutswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.27",
            "verseOrgIds": [
              "1KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakatonyanyisa kudanidzira, vakazvicheka-cheka neminondo namapfumo, setsika yavo, kusvikira ropa ravo raerera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.28",
            "verseOrgIds": [
              "1KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masikati akapfuura, ivo vakaramba vachiprofita zveshungu kusvikira nguva yechibayiro chamanheru. Asi hapana chakaitika, hapana akapindura, hapana akaratidza hanya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Eria akati kuvanhu vose, \"Uyai kuno kwandiri.\" Vakauya kwaari, iye akagadzira aritari yaJehovha yakanga yaputswa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akatora mabwe gumi namaviri, rimwe chete rakamirira rudzi rumwe chete rwavanakomana vaJakobho, uyo akanga audzwa naJehovha kuti, \"Zita rako richava Israeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akashandisa mabwe aya kuvaka aritari muzita raJehovha, uye akachera mugero waipoteredza aritari wakanga wakakura zvokuti waikwana maseya maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "text": "embeu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaronga huni, akacheka hando kuita zvidimbu zvidimbu, akaiisa pamusoro pehuni. Ipapo akati kwavari, \"Zadzai zvirongo zvikuru zvina nemvura mugoidira pamusoro pechipiriso napamusoro pehuni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.33",
            "verseOrgIds": [
              "1KI.18.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Pamhidzai zvakare,\" ivo vakapamhazve.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:34"
      },
      "items": [
        {
          "text": "Akatizve, \"Pamhidzai kechitatu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvura yakaerera ichipoteredza aritari ikazadzawo nomugero.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yechibayiro, muprofita Eria akaenda pamberi akanamata akati, \"Haiwa Jehovha, Mwari waAbhurahama, Isaka naIsraeri, ngazvizivikanwe nhasi kuti ndimi Mwari munyika yeIsraeri uye kuti ini ndiri muranda wenyu, uyewo kuti ndaita zvinhu zvose izvi sezvamakandirayira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.36",
            "verseOrgIds": [
              "1KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, ndipindurei, ndipindurei, kuitira kuti vanhu ava vazive kuti imi, Jehovha, ndimi Mwari, uye kuti muri kudzora mwoyo yavo zvakare.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo moto waJehovha wakaburuka ukapisa chibayiro, nehuni namabwe nevhu, ukananzva mvura yose yaiva mumugero.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.38",
            "verseOrgIds": [
              "1KI.18.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose pavakaona izvi, vakawira pasi nezviso zvavo, vakadanidzira vachiti, \"Jehovha ndiye Mwari! Jehovha ndiye Mwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Eria akavarayira akati, \"Batai vaprofita vaBhaari. Musarega kana mumwe chete achipunyuka!\" Vakavabata, uye Eria akaita kuti vaendeswe zasi kuMupata weKishoni vakandourayirwako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Eria akati kuna Ahabhu, \"Chienda undodya uye unwe, nokuti kune kutinhira kwemvura zhinji.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Ahabhu akaenda kundodya nokunwa, asi Eria akakwira pamusoro pegomo reKarimeri, akakotamira pasi akaisa chiso chake pakati pamabvi ake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaudza muranda wake kuti, \"Enda undotarisa kwakadziva kugungwa.\" Akakwira akandotarisa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:43"
      },
      "items": [
        {
          "text": "Akati, \"Hakuna chiriko uku.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:43"
      },
      "items": [
        {
          "text": "Eria akati, \"Dzokerazve,\" kanomwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kechinomwe muranda akati, \"Gore duku rakaenzana nechanza chomunhu riri kukwira richibva mugungwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 18:44"
      },
      "items": [
        {
          "text": "Saka Eria akati, \"Enda undoudza Ahabhu kuti, 'Sunga ngoro yako uburuke usati wadzivirirwa nemvura.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 18:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva imwe cheteyo denga rakasviba namakore, mhepo ikavhuvhuta, mvura zhinji ikauya, Ahabhu akaenda nengoro kuJezireeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.45",
            "verseOrgIds": [
              "1KI.18.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 18:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba raJehovha rakauya pana Eria, akasunga jasi rake nebhanhire, akamhanya pamberi paAhabhu nzira yose kusvika kuJezireeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.46",
            "verseOrgIds": [
              "1KI.18.46"
            ]
          }
        }
      ]
    }
  ],
