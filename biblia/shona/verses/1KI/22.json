{
  "id": "1KI.22",
  "number": "22",
  "bookId": "1KI",
  "reference": "1 Madzimambo 22",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mikaya anoprofita pamusoro paAhabhu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamakore matatu pakati peAramu neIsraeri pakanga pasina hondo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.1",
            "verseOrgIds": [
              "1KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mugore rechitatu, Jehoshafati mambo weJudha akaburuka zasi kundoona mambo weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.2",
            "verseOrgIds": [
              "1KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akanga ati kuvaranda vake, \"Hamuzivi here kuti Ramoti Gireadhi ndeyedu asi hapana chatiri kuita kuti tiitore zvakare kubva kuna mambo weAramu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.3",
            "verseOrgIds": [
              "1KI.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akakumbira Jehoshafati akati, \"Uchaenda neni here kundorwa neRamoti Gireadhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:4"
      },
      "items": [
        {
          "text": "Jehoshafati akapindura mambo weIsraeri achiti, \"Ini ndakangofanana newe, vanhu vangu vakafanana nevako, mabhiza angu samabhiza ako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehoshafati akatiwo kuna mambo weIsraeri, \"Tanga watsvaga zvinorayirwa naJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.5",
            "verseOrgIds": [
              "1KI.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo weIsraeri akaunganidza pamwe chete, vaprofita, vangangoita varume mazana mana, akavabvunza akati, \"Ndoenda here kundorwa neRamoti Gireadhi, kana kuti ndoregera?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:6"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Endai nokuti Jehovha achaiisa muruoko rwamambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehoshafati akabvunza achiti, \"Hapana here mumwe muprofita waJehovha pano watingabvunza?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.7",
            "verseOrgIds": [
              "1KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akapindura Jehoshafati akati, \"Pachine murume mumwe chete watinogona kubvunza Jehovha naye, asi ndinomuvenga nokuti haamboprofiti chinhu chakanaka pamusoro pangu asi zvakaipa nguva dzose. NdiMikaya, mwanakomana waImura.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:8"
      },
      "items": [
        {
          "text": "Jehoshafati akapindura akati, \"Mambo haafaniri kutaura kudaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo weIsraeri akadana mumwe wavaranda vake akati, \"Uyisa Mikaya mwanakomana waImura izvozvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.9",
            "verseOrgIds": [
              "1KI.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri naJehoshafati, mambo weJudha, vakanga vakagara pazvigaro zvavo vakapfeka nguo dzavo dzoumambo vari paburiro, pedyo nesuo reSamaria, vaprofita vose vachiprofita pamberi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.10",
            "verseOrgIds": [
              "1KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Zedhekia mwanakomana waKenaana akanga agadzira nyanga dzesimbi, akati, \"Zvanzi naJehovha: 'Nedzidzi muchatunga vaAramu kusvikira vaparara!' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.11",
            "verseOrgIds": [
              "1KI.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaprofita vose vakanga vachiprofita zvimwe chetezvo. Vakati, \"Rwisai Ramoti Gireadhi mukunde, nokuti Jehovha achariisa muruoko rwamambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhume yakanga yaenda kundodana Mikaya yakati kwaari, \"Tarirai, somunhu mumwe chete, vamwe vaprofita vari kutaura kuti mambo vachabudirira. Shoko renyu ngaribvumirane neravo, uye mutaurewo zvakanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.13",
            "verseOrgIds": [
              "1KI.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mikaya akati, \"NaJehovha mupenyu, ndinogona chete kumuudza zvandinoudzwa naJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.14",
            "verseOrgIds": [
              "1KI.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasvika, mambo akamubvunza akati, \"Mikaya, toenda here kundorwa neRamoti Gireadhi, kana kuti torega?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:15"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Rwisai mukunde nokuti Jehovha achariisa muruoko rwamambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kwaari, \"Ndinofanira kukupikisa kangani kuti undiudze chokwadi pasina chimwe chinhu muzita raJehovha?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.16",
            "verseOrgIds": [
              "1KI.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mikaya akapindura akati, \"Ndakaona Israeri yose yakapararira pamakomo samakwai asina mufudzi, uye Jehovha akati, 'Vanhu ava havana tenzi. Mumwe nomumwe wavo ngaaende kumba norugare.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.17",
            "verseOrgIds": [
              "1KI.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akati kuna Jehoshafati, \"Handina kukuudza here kuti haamboprofiti chinhu chakanaka pamusoro pangu, asi zvakaipa chete?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.18",
            "verseOrgIds": [
              "1KI.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akaenderera mberi akati, \"Naizvozvo chinzwai shoko raJehovha: Ndakaona Jehovha akagara pachigaro chake choushe, uye hondo dzose dzokudenga dzakamira dzakamupoteredza kurudyi nokuruboshwe kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.19",
            "verseOrgIds": [
              "1KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akati, 'Ndiani achaenda kundokwezva Ahabhu kuti arwise Ramoti Gireadhi agoenda kundofira ikoko?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:20"
      },
      "items": [
        {
          "text": "\"Mumwe akataura izvi, mumwe akataura izvo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira, mumwe mweya wakauya ukamira pamberi paJehovha ukati, 'Ndichandomukwezva ini.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.21",
            "verseOrgIds": [
              "1KI.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha akabvunza akati, 'Nenzira ipi?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:22"
      },
      "items": [
        {
          "text": "\"Iwo wakati, 'Ndichaenda ndonova mweya unoreva nhema mumiromo yavaprofita vake vose.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 22:22"
      },
      "items": [
        {
          "text": "\"Jehovha akati, 'Uchabudirira mukumukwezva. Enda undozviita.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka iye zvino Jehovha aisa mweya unoreva nhema mumiromo yavaprofita venyu vose ava. Jehovha atema kuti muchawira mudambudziko guru kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Zedhekia mwanakomana waKenaana akaenda kwaari akarova Mikaya nembama. Akamubvunza achiti, \"Mweya waJehovha wakafamba nenzira ipiko uchibva kwandiri kuti uzotaura kwauri?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.24",
            "verseOrgIds": [
              "1KI.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akapindura akati, \"Uchazviziva musi wauchaenda kundohwanda muimba yomukati.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.25",
            "verseOrgIds": [
              "1KI.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo weIsraeri akarayira akati, \"Torai Mikaya mumudzosere kuna Amoni mutongi weguta nokuna Joashi mwanakomana wamambo",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.26",
            "verseOrgIds": [
              "1KI.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "muti, 'Zvanzi namambo: Isai munhu uyu mutorongo murege kumupa chimwe chinhu kunze kwechingwa nemvura kusvikira ndadzoka norugare.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.27",
            "verseOrgIds": [
              "1KI.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya akati, \"Kana zvikaitika kuti madzoka norugare, Jehovha haana kutaura neni.\" Ipapo akatizve, \"Inzwai mashoko angu imi vanhu mose!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahabhu anourayiwa paRamoti Gireadhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo weIsraeri naJehoshafati mambo weJudha vakaenda kuRamoti Gireadhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.29",
            "verseOrgIds": [
              "1KI.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akati kuna Jehoshafati, \"Ndichapinda muhondo iyi ndichinge mumwe munhu, asi iwe pfeka mbatya dzako dzoumambo.\" Saka mambo weIsraeri akazviita somumwe munhu akaenda kundorwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.30",
            "verseOrgIds": [
              "1KI.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo weAramu akanga arayira vatungamiri vake vengoro makumi matatu navaviri achiti, \"Musarwa nomunhu upi zvake, muduku kana mukuru, kunze kwamambo weIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.31",
            "verseOrgIds": [
              "1KI.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatungamiri vengoro pavakaona Jehoshafati, vakafunga kuti, \"Zvirokwazvo uyu ndiye mambo weIsraeri.\" Naizvozvo vakatendeuka kuti vamurwise, asi Jehoshafati paakaridza mhere,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.32",
            "verseOrgIds": [
              "1KI.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "vatungamiri vengoro vakaona kuti akanga asiriye mambo weIsraeri ndokubva varega kumutevera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.33",
            "verseOrgIds": [
              "1KI.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mumwe murume akapfura museve wake chipfurepfure akabva abaya mambo weIsraeri paisangana zvipenga zvembatya dzake dzehondo. Mambo akati kumuchairi wengoro yake, \"Tendeutsa ngoro undibvise pano pari kurwiwa. Ndakuvadzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.34",
            "verseOrgIds": [
              "1KI.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hondo yakarwiwa zuva rose, uye mambo akaita zvokutsigirwa mungoro yake akatarisa vaAramu. Ropa rakabva paronda rake rakaerera rikaenda mukati mengoro, uye manheru iwayo akabva afa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.35",
            "verseOrgIds": [
              "1KI.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva parakanga rava kuvira, kwakadaidzirwa kuhondo yose kuti, \"Munhu wose kuguta rake; munhu wose kunyika yake!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mambo akafa, akauyiswa kuSamaria, akavigwa ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.37",
            "verseOrgIds": [
              "1KI.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasuka ngoro padziva reSamaria (panova ndipo paishambira zvifeve), imbwa dzikananzva ropa rake, sezvakanga zvarehwa neshoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.38",
            "verseOrgIds": [
              "1KI.22.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zviri zvimwe zvakaitika panguva yokutonga kwaAhabhu, zvichisanganisira zvose zvaakaita, muzinda waakavaka nenyanga dzenzou, namaguta aakavaka, hazvina kunyorwa here mubhuku renhoroondo dzegore negore dzamadzimambo eIsraeri?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.39",
            "verseOrgIds": [
              "1KI.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabhu akazorora namadzibaba ake. Ipapo Ahazia mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoshafati Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati mwanakomana waAsa akava mambo weJudha mugore rechina raAhabhu, mambo weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.41",
            "verseOrgIds": [
              "1KI.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati akanga ane makore makumi matatu namashanu okuberekwa paakava mambo, uye akatonga muJerusarema kwamakore makumi maviri namashanu. Zita ramai vake raiva Azubha, mwanasikana waShirihi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.42",
            "verseOrgIds": [
              "1KI.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazvinhu zvose akafamba munzira dzababa vake Asa uye haana kurasika achibva padziri; akaita zvakanga zvakanaka pamberi paJehovha. Zvisinei, nzvimbo dzakakwirira hadzina kubviswa, uye vanhu vakaramba vachipa zvibayiro uye vachipisa zvinonhuhwira ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.43",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati akanga ane rugarewo namambo weIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zviri zvimwe zvakaitika panguva yokutonga kwaJehoshafati, zvinhu zvaakaita nehondo dzaakarwa, hazvina kunyorwa here mubhuku renhoroondo dzegore negore dzamadzimambo eJudha?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.45",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa panyika zvifeve zvavarume zvakanga zvasara kunyange mushure menguva yokutonga kwababa vake Asa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 22:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo muEdhomu makanga musina mambo; maitongwa nejinda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.47",
            "verseOrgIds": [
              "1KI.22.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 22:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehoshafati akavaka chitsama chezvikepe chokutakurisa zvinhu zvokutengesa kuti zviende kuOfiri kundotora goridhe, asi hazvina kuenda nokuti zvakaparara paEzioni Gebheri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.48",
            "verseOrgIds": [
              "1KI.22.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 22:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Ahazia mwanakomana waAhabhu akati kuna Jehoshafati, \"Regai varanda vangu vaende navaranda venyu nezvikepe zvenyu.\" Asi Jehoshafati akaramba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.49",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehoshafati akazorora namadzibaba ake akavigwa pavakavigwa muguta raDhavhidhi baba vake. Ipapo Jehoramu mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazia Mambo weIsraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 22:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia mwanakomana waAhabhu akava mambo weIsraeri muSamaria mugore regumi namanomwe raJehoshafati mambo weJudha, uye akatonga Israeri kwamakore maviri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.51",
            "verseOrgIds": [
              "1KI.22.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 22:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakaipa pamberi paJehovha nokuti akafamba munzira dzababa namai vake nomunzira dzaJerobhoamu mwanakomana waNebhati, akaita kuti Israeri iite chivi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.52",
            "verseOrgIds": [
              "1KI.22.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 22:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akashandira uye akanamata Bhaari, akaita kuti Jehovha, Mwari weIsraeri atsamwe, sezvakanga zvaitwa nababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.53",
            "verseOrgIds": [
              "1KI.22.54"
            ]
          }
        }
      ]
    }
  ],
