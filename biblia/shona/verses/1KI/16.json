            "number": "34",
            "style": "v",
            "sid": "1KI 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munguva yaAhabhu, Hieri wokuBheteri akavakazve Jeriko. Mwanakomana wake wedangwe, Abhiramu, akafa paakavaka hwaro hweguta, uye mwanakomana wake wegotwe Segubhi akafa paakamisa masuo aro, sezvazvakarehwa neshoko raJehovha naJoshua mwanakomana waNuni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        }
      ]
    }
