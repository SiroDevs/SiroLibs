  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "GEN 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anoenda kuIjipiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Israeri akasimuka nezvose zvakanga zviri zvake, uye akati asvika kuBheerishebha, akapa zvibayiro kuna Mwari wababa vake Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.1",
            "verseOrgIds": [
              "GEN.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akataura kuna Israeri muchiratidzo usiku akati, \"Jakobho! Jakobho!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 46:2"
      },
      "items": [
        {
          "text": "Iye akati, \"Ndiri pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akati, \"Ndini Mwari, iye Mwari wababa vako. Usatya kuenda kuIjipiti, nokuti ndichakuita rudzi rukuru ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.3",
            "verseOrgIds": [
              "GEN.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaburuka kuIjipiti pamwe chete newe, uye zvirokwazvo ndichakudzosazve. Uye ruoko rwaJosefa chairwo ndirwo ruchazarira meso ako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.4",
            "verseOrgIds": [
              "GEN.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho akabva paBheerishebha, uye vanakomana vaIsraeri vakatora baba vavo Jakobho navana vavo navakadzi vavo vakavakwidza mungoro dzakanga dzatumirwa naFaro kuti dzivatakure.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.5",
            "verseOrgIds": [
              "GEN.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaendawo nezvipfuwo zvavo nepfuma yose yavakanga vawana muKenani, uye Jakobho navana vake vose vakaenda kuIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.6",
            "verseOrgIds": [
              "GEN.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda pamwe chete navanakomana vake, navazukuru vake navanasikana vake navanasikana vavo, vana vake vose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avanakomana vaIsraeri (Jakobho nezvizvarwa zvake) vakaenda kuIjipiti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 46:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 46:8"
      },
      "items": [
        {
          "text": "Rubheni dangwe raJakobho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaRubheni vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:9"
      },
      "items": [
        {
          "text": "Hanoki, Paru, Hezironi naKami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaSimeoni vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:10"
      },
      "items": [
        {
          "text": "Jemueri, Jamini, Ohadhi, Jakini, Zohari naShauri, mwanakomana womukadzi muKenani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaRevhi vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:11"
      },
      "items": [
        {
          "text": "Gerishoni, Kohati naMerari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaJudha vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:12"
      },
      "items": [
        {
          "text": "Eri, Onani, Shera, Perezi naZera (asi Eri naOnani vakanga vafira munyika yeKenani).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:12"
      },
      "items": [
        {
          "text": "Vanakomana vaPerezi:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "GEN 46:12"
      },
      "items": [
        {
          "text": "Hezironi naHamuri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaIsakari vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:13"
      },
      "items": [
        {
          "text": "Tora, Pua, Jashubhi naShimironi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaZebhuruni vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:14"
      },
      "items": [
        {
          "text": "Seredhi, Eroni naJareri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vanakomana vakaberekerwa Jakobho naRea muPadhani Aramu, kunze kwaDhaina mwanasikana wake. Vanakomana navanasikana vake ava vakanga vari makumi matatu navatatu pamwe chete.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaGadhi vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:16"
      },
      "items": [
        {
          "text": "Zefoni, Hagi, Shuni, Ezibhoni, Eri, Arodhi naAreri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaAsheri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Imina, Ishivha, Ishivhi naBheria. Hanzvadzi yavo yakanga iri Sera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Vanakomana vaBheria vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "GEN 46:17"
      },
      "items": [
        {
          "text": "Hebheri naMarikieri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vana vakaberekerwa Jakobho naZiripa, uyo akanga apiwa naRabhani kuna Rea mwanasikana wake, gumi navatanhatu pamwe chete.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaRakeri mukadzi waJakobho vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:19"
      },
      "items": [
        {
          "text": "Josefa naBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuIjipiti, Manase naEfuremu vakaberekerwa Josefa naAsenati mwanasikana waPotifera, muprista waOni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaBhenjamini vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:21"
      },
      "items": [
        {
          "text": "Bhera, Bhekeri, Gera, Naamani, Ehi, Roshi, Mupimi, Hupimi naAridhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vakanga vari vanakomana vaRakeri vakanga vaberekerwa Jakobho, gumi navana pamwe chete.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana waDhani aiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:23"
      },
      "items": [
        {
          "text": "Hushimi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaNafutari vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.24",
            "verseOrgIds": [
              "GEN.46.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 46:24"
      },
      "items": [
        {
          "text": "Jazieri, Guni, Jezeri naShiremi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.24",
            "verseOrgIds": [
              "GEN.46.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vanakomana vakaberekerwa Jakobho naBhiriha, uya akapiwa naRabhani kuna Rakeri mwanasikana wake, vanomwe pamwe chete.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakaenda naJakobho kuIjipiti, vaya vakanga vari zvizvarwa zvake chaizvo, tisingaverengi vakadzi vavanakomana vake, vaiva vanhu makumi matanhatu navatanhatu pakuwanda.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete navanakomana vaviri vakaberekerwa Josefa muIjipiti, vose vemhuri yaJakobho, avo vakaenda kuIjipiti, vakanga vari makumi manomwe pamwe chete.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jakobho akatuma Judha pamberi pake kuna Josefa kuti aratidzwe nzira yokuenda nayo kuGosheni. Vakati vasvika mudunhu reGosheni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akaita kuti ngoro yake igadzirirwe uye akaenda kuGosheni kundosangana nababa vake Israeri. Josefa paakangosvika pamberi pavo, akambundikira baba vake uye akachema kwenguva refu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri akati kuna Josefa, \"Zvino ndagadzirira kufa, sezvo ndazvionera pachangu kuti uchiri mupenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 46:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josefa akati kuhama dzake nokune veimba yababa vake, \"Ini ndichaenda kuti ndinotaura naFaro uye ndichandoti kwaari, 'Madzikoma angu neveimba yababa vangu, vakanga vachigara kunyika yeKenani, vauya kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu ava vafudzi; vanochengeta zvipfuwo, uye vauya namakwai avo nemombe dzavo nezvose zvavanazvo.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 46:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunodanwa naFaro uye akakubvunzai achiti, 'Basa renyu ndereiko?'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 46:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi munofanira kupindura muchiti, 'Varanda venyu vaiva vachengeti vezvipfuwo kubvira pauduku hwavo, sezvakanga zvichiitawo madzibaba edu.' Ipapo muchatenderwa kugara munyika yeGosheni, nokuti vafudzi vose vanonyangadza kuvaIjipita.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.34",
            "verseOrgIds": [
              "GEN.46.34"
            ]
          }
        }
      ]
    }
  ],
