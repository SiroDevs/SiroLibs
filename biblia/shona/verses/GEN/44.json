              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda wenyu akapa rubatso rwokuchengetedzeka kwomukomana kuna baba vangu. Ndakati, 'Kana ndikasadzoka naye kwamuri, ndini ndichava nemhosva pamberi penyu, baba vangu, upenyu hwangu hwose!'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.32",
            "verseOrgIds": [
              "GEN.44.32"
            ]
          }
        }
      ]
    },
