              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino, ndapota, regai henyu muranda wenyu asare kuno senhapwa yashe wangu pachinzvimbo chomukomana, uye murege mukomana adzokere namadzikoma ake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.33",
            "verseOrgIds": [
              "GEN.44.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
