  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "GEN 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akazviwisira pamusoro pababa vake akachema pamusoro pavo uye akavatsvoda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josefa akarayira varapi vaimushandira kuti vasasike baba vake Israeri. Saka varapi vakamusasika,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakapedza mazuva makumi mana azere, nokuti ndiyo yakanga iri nguva yaidikanwa yokusasika mutumbi. Uye vaIjipiti vakamuchema kwamazuva makumi manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva okuchema akati apera, Josefa akati kune veimba yaFaro, \"Kana ndawana nyasha pamberi penyu, nditaurireiwo kuna Faro. Mumuudze kuti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Baba vangu vakaita kuti ndipike mhiko uye vakati, \"Ini ndava kufa; mundivige muguva randakazvicherera munyika yeKenani.\" Zvino regai hangu ndikwidze ndinoviga baba vangu; ipapo ndigozodzoka hangu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faro akati, \"Kwira hako undoviga baba vako, sezvo vakaita kuti upikire kuita izvozvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Josefa akakwidza kundoviga baba vake. Varanda vose vaFaro vakamuperekedza, vanokudzwa vomumba make navose vanokudzwa vomuIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tisingaverengi vose vomumhuri yaJosefa namadzikoma ake uye navose veimba yababa vake. Vana vavo chete namakwai avo nemombe dzavo, ndivo vakasiyiwa muGosheni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngoro navatasvi vamabhiza vakaendawo naye. Rakanga riri boka guru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika paburiro raAtadhi, pedyo neJorodhani, vakachema zvikuru neshungu; uye ipapo Josefa akatara mazuva manomwe okuchema baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaKenani vaigara ikoko vakati vachiona kuchema ikoko paburiro raAtadhi, vakati, \"VaIjipita vari pakuchema kukuru.\" Ndokusaka nzvimbo iyo iri pedyo neJorodhani yakatumidzwa zita rokuti Abheri Miziraimi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanakomana vaJakobho vakaita sezvaakavarayira:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamutakura vakaenda naye kunyika yeKenani uye vakamuviga mubako mumunda weMakapera, pedyo neMamure, rakatengwa naAbhurahama senzvimbo yokuviga kubva kuna Efuroni muHiti, pamwe chete nomunda wacho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokuvigwa kwababa vake, Josefa akadzokera kuIjipiti, pamwe chete namadzikoma ake navamwe vose vakanga vaenda naye kundoviga baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josefa anosimbaradza hama dzake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzikoma aJosefa akati aona kuti baba vavo vakanga vafa, vakati, \"Zvimwe Josefa angadaro achiri kutivenga uye akatitsiva pane zvakaipa zvose zvatakaita kwaari?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.15",
            "verseOrgIds": [
              "GEN.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakatuma shoko kwaari vakati, \"Baba vako vakasiya varayira vasati vafa vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.16",
            "verseOrgIds": [
              "GEN.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Izvi ndizvo zvamunofanira kutaura kuna Josefa: Ndinokumbira kuti ukanganwire madzikoma ako zvivi zvavo nezvitadzo zvavakaita pavakakuitira zvakaipa kwazvo. Zvino ndapota kanganwira hako zvivi zvavaranda vaMwari wababa vako.' \" Pakasvika shoko ravo kwaari, Josefa akachema.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo madzikoma ake akauya akazviwisira pasi pamberi pake. Vakati, \"Tiri varanda venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Josefa akati kwavari, \"Musatya. Ko, ini ndiri pachinzvimbo chaMwari here?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.19",
            "verseOrgIds": [
              "GEN.50.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi makafunga kundiitira zvakaipa, asi Mwari akafunga kuita zvakanaka kuti apedzise zviri kuitwa iye zvino, iko kuponeswa kwemweya mizhinji.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.20",
            "verseOrgIds": [
              "GEN.50.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvino, musatya. Ndichakuriritirai imi navana venyu.\" Akavasimbaradza uye akataura nounyoro kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaJosefa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akagara muIjipiti pamwe chete nemhuri yose yababa vake. Akararama kwamakore zana negumi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.22",
            "verseOrgIds": [
              "GEN.50.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akaona vana vaEfuremu vorudzi rwechitatu. Uyewo vana vaMakiri mwanakomana waManase vakaiswa pamakumbo aJosefa pavakaberekwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.23",
            "verseOrgIds": [
              "GEN.50.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 50:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Josefa akati kumadzikoma ake, \"Ini ndava kuzofa. Asi zvirokwazvo Mwari achakubatsirai nokukubudisai munyika muno achikuendesai kunyika yakavimbiswa nemhiko kuna Abhurahama, Isaka naJakobho.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 50:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Josefa akaita kuti vanakomana vaIsraeri vapike mhiko uye akati, \"Zvirokwazvo Mwari achakubatsirai, uye ipapo munofanira kutakura mapfupa angu kubva munzvimbo ino.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.25",
            "verseOrgIds": [
              "GEN.50.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 50:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Josefa akafa ava namakore zana negumi. Uye shure kwokumusasika, akaiswa mubhokisi muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.26",
            "verseOrgIds": [
              "GEN.50.26"
            ]
          }
        }
      ]
    }
  ],
