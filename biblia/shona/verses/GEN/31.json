  "reference": "Genesisi 31",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "GEN 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anotiza kubva kuna Rabhani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akanzwa kuti vanakomana vaRabhani vakanga vachiti, \"Jakobho atora zvose zvaiva zvababa vedu uye awana upfumi hwose uhu kubva kune zvaiva zvababa vedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Jakobho akaona kuti ndangariro dzaRabhani kwaari dzakanga dzisisina kuita sapakutanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.2",
            "verseOrgIds": [
              "GEN.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Jakobho, \"Dzokera kunyika yamadzibaba ako nokuhama dzako, uye ndichava newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jakobho akatuma shoko kuna Rakeri naRea kuti vauye kusango kwakanga kuna makwai ake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.4",
            "verseOrgIds": [
              "GEN.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Ndinoona kuti ndangariro dzababa venyu kwandiri hadzisisina kuita sezvadzakanga dzakaita kare, asi Mwari wababa vangu aneni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.5",
            "verseOrgIds": [
              "GEN.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoziva kuti ndakashandira baba venyu nesimba rangu rose,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.6",
            "verseOrgIds": [
              "GEN.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi baba venyu vakandinyengera nokushandura-shandura mubayiro wangu kagumi kose. Kunyange zvakadaro hazvo, Mwari haana kuvatendera kuti vandikuvadze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.7",
            "verseOrgIds": [
              "GEN.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakati, 'Zvina mavara zvichava mubayiro wako,' ipapo zvipfuwo zvose zvakabereka zvina mavara, uye pavakati, 'Zvine mitsetse zvichava mubayiro wako,' ipapo zvipfuwo zvose zvakaberekwa zvine mitsetse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.8",
            "verseOrgIds": [
              "GEN.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwari akatora zvipfuwo zvababa venyu akazvipa kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Panguva yokubereka kwezvipfuwo, ndakarota dzimwe hope dzokuti ndakatarira ndikaona kuti nhongo dzembudzi dzaisangana nezvipfuwo dzakanga dzine mitsetse, dzina mavara kana kuti dzina makwapa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.10",
            "verseOrgIds": [
              "GEN.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waMwari akati kwandiri mukurota, 'Jakobho,' ini ndikapindura ndikati, 'Ndiri pano.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.11",
            "verseOrgIds": [
              "GEN.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akati, 'Tarira uone kuti nhongo dzose dzembudzi dzinosangana nezvipfuwo zvose dzine mitsetse, mavara kana makwapa, nokuti ndaona zvose zvakanga zvichiitwa naRabhani kwauri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.12",
            "verseOrgIds": [
              "GEN.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndini Mwari weBheteri, kuya kwawakazodza mbiru uye kwawakaita mhiko neni. Zvino kurumidza ubve munyika ino udzokere kunyika kwawakazvarirwa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.13",
            "verseOrgIds": [
              "GEN.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rakeri naRea vakati, \"Ko, tichine mugove munhaka yababa vedu here?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.14",
            "verseOrgIds": [
              "GEN.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, havationi savatorwa here? Havana kungotitengesa chete, asi vakashandisa mutengo wedu wose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.15",
            "verseOrgIds": [
              "GEN.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo pfuma yose yakatorwa naMwari kubva kuna baba vedu ndeyedu nevana vedu. Saka ita zvose zvaunoudzwa naMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho akaisa vana vake navakadzi vake pangamera,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.17",
            "verseOrgIds": [
              "GEN.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akatinha zvipfuwo zvose pamwe chete nepfuma yose yaakanga aunganidza muPadhani Aramu, kuti aende kuna baba vake Isaka kunyika yeKenani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.18",
            "verseOrgIds": [
              "GEN.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabhani akati aenda kundoveura makwai ake, Rakeri akaba vamwari vomumba mababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.19",
            "verseOrgIds": [
              "GEN.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, Jakobho akanyengera Rabhani muAramu nokusamuudza kuti ava kuenda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.20",
            "verseOrgIds": [
              "GEN.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akatiza nezvose zvaakanga anazvo, akayambuka Rwizi akananga kunyika yezvikomo yeGireadhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rabhani anotevera Jakobho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechitatu Rabhani akazoudzwa kuti Jakobho akanga atiza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.22",
            "verseOrgIds": [
              "GEN.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora hama dzake, akatevera Jakobho kwamazuva manomwe uye vakamubatira munyika yezvikomo yeGireadhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.23",
            "verseOrgIds": [
              "GEN.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akasvika kuna Rabhani muAramu mukurota usiku uye akati kwaari, \"Chenjera kuti urege kutaura chinhu chipi zvacho kuna Jakobho, chakanaka kana chakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akanga adzika tende rake munyika yezvikomo yeGireadhi paakabatwa naRabhani, uye Rabhani nehama dzake vakadzikawo musasa ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.25",
            "verseOrgIds": [
              "GEN.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rabhani akati kuna Jakobho, \"Waiteiko? Wandinyengera, uye watakura vanasikana vangu senhapwa muhondo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.26",
            "verseOrgIds": [
              "GEN.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, watizirei muchivande uye ukandinyengera? Seiko usina kundiudza, kuitira kuti ndaidai ndakuendesa nomufaro uye kuchiimbwa nziyo nokuridzwa matambureni norudimbwa?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.27",
            "verseOrgIds": [
              "GEN.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hauna kunditendera kutsvoda vazukuru vangu kana kuonekana navanasikana vangu. Waita zvoupenzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.28",
            "verseOrgIds": [
              "GEN.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine simba rokukukuvadza; asi usiku Mwari wababa vako ati kwandiri, 'Chenjera kuti urege kutaura chinhu chipi zvacho kuna Jakobho, chakanaka kana chakaipa.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.29",
            "verseOrgIds": [
              "GEN.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino wakada kuenda nokuda kwokushuva kudzokera kuimba yababa vako. Asi wakabireiko vamwari vangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.30",
            "verseOrgIds": [
              "GEN.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akapindura Rabhani akati, \"Ndakanga ndichitya, nokuti ndakafunga kuti maizonditorera vanasikana venyu nechisimba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.31",
            "verseOrgIds": [
              "GEN.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mukawana munhu upi zvake anenge ana vamwari venyu, iyeye haafaniri kurarama. Pamberi pehama dzedu zvionerei pachenyu kana pane chinhu chenyu pano neni; uye kana zvakadaro, muchitore henyu.\" Zvino Jakobho akanga asingazivi kuti Rakeri akanga aba vamwari vacho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Rabhani akapinda mutende raJakobho nomutende raRea uye nomumatende maviri avarandakadzi, asi haana kuwana chinhu. Mushure mokubuda kwake mutende raRea, akapinda mutende raRakeri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.33",
            "verseOrgIds": [
              "GEN.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Rakeri akanga atora vamwari vomuimba yababa vake akavaisa pasi pechigaro chengamera yake uye akanga agere pamusoro pazvo. Rabhani akatsvaka pakati pezvinhu zvose mutende asi haana kuwana chinhu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.34",
            "verseOrgIds": [
              "GEN.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeri akati kuna baba vake, \"Regai henyu kutsamwa, ishe wangu, kuti handigoni kusimuka pamberi penyu; ndiri pamutowo wavakadzi.\" Saka akatsvaka asi haana kuwana vamwari veimba yake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akatsamwa uye akapopotera Rabhani akati, \"Mhaka yangu ndeyeiko? Chivi chandakaita ndecheiko zvamandivhima mukadai?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.36",
            "verseOrgIds": [
              "GEN.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zvamatsvaka pakati penhumbi dzangu dzose, chiiko chamawana chokumba kwenyu? Chiisei pano pamberi pehama dzenyu, uye ngavatonge pakati pedu isu vaviri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.37",
            "verseOrgIds": [
              "GEN.31.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakanga ndinemi makore makumi maviri aya. Makwai enyu nembudzi dzenyu hazvina kusvodza, uye handina kudya makondobwe amakwai enyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.38",
            "verseOrgIds": [
              "GEN.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina kuuya kwamuri nezvipfuwo zvakabvamburwa nezvikara zvesango; ndakatakura mutoro wacho pachangu. Uye makareva muripo kubva kwandiri pane zvose zvakabiwa masikati kana usiku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.39",
            "verseOrgIds": [
              "GEN.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo aiva magariro angu: Ndakapiswa nezuva masikati uye nechando usiku, uye hope dzakatiza mumaziso angu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.40",
            "verseOrgIds": [
              "GEN.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakanga zvakaita saizvozvi kwamakore gumi namana nokuda kwavanasikana venyu vaviri ava nemakore matanhatu nokuda kwezvipfuwo zvenyu, uye makashandura mubayiro wangu kagumi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.41",
            "verseOrgIds": [
              "GEN.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai Mwari wababa vangu, iye Mwari waAbhurahama uye aityiwa naIsaka, akanga asineni, zvirokwazvo mungadai makandiendesa ndisina chinhu. Asi Mwari akaona kutambudzika kwangu nokubata kwamaoko angu, uye usiku akakutsiurai.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabhani akapindura Jakobho akati, \"Madzimai aya vanasikana vangu, uye vana ava vana vangu, uye zvipfuwo izvi ndezvangu. Zvose zvaunoona ndezvangu. Asi ndichaiteiko nhasi pamusoro pavanasikana vangu ava, kana pamusoro pavana vavakabereka?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.43",
            "verseOrgIds": [
              "GEN.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uya zvino, ngatiite sungano, iwe neni, uye ngaive chapupu pakati pedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jakobho akatora ibwe akarimisa sembiru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.45",
            "verseOrgIds": [
              "GEN.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuhama dzake, \"Unganidzai mamwe mabwe.\" Saka vakatora mabwe vakaaunganidza vakaita murwi, uye vakadya ipapo pamurwi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabhani akautumidza zita rokuti Jegari Sahadhuta, uye Jakobho akautumidza kuti Gareedhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.47",
            "verseOrgIds": [
              "GEN.31.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabhani akati, \"Murwi uyu ndiwo uchapupu pakati pangu newe nhasi.\" Ndokusaka wakanzi Gareedhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.48",
            "verseOrgIds": [
              "GEN.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanga uchinziwo Mizipa, nokuti akati, \"Jehovha ngaachengete iwe neni patinenge tiri kure nokure.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ukabata vanasikana vangu zvakaipa kana kutora vamwe vakadzi kunze kwevanasikana vangu, kunyange dai mumwe munhu akasava nesu, rangarira kuti Mwari ndiye chapupu pakati pako neni.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabhani akatiwo kuna Jakobho, \"Hoyu murwi uyu, uye heyi mbiru yandamisa iyi pakati pako neni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.51",
            "verseOrgIds": [
              "GEN.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murwi uyu ndiwo chapupu uye mbiru iyi ndiyo chapupu, kuti handizopfuuri murwi uno ndichiuya kwauri kuti ndizokukuvadza uye kuti iwe hauzopfuuri murwi uno nembiru uchiuya kurutivi rwangu kuti uzondikuvadza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari waAbhurahama naMwari waNahori, iye Mwari wababa vavo, ngaatonge pakati pedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 31:53"
      },
      "items": [
        {
          "text": "Saka Jakobho akaita mhiko muzita raiye aityiwa nababa vake Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapa chibayiro imomo munyika yezvikomo uye akakoka hama dzake kuti dzizodya. Mushure mokudya vakavatapo usiku ihwohwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 31:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani akatevera Rabhani akatsvoda vazukuru vake navanasikana vake uye akavaropafadza. Ipapo akabva akadzokera kumusha kwake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.55",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        }
      ]
    }
  ],
