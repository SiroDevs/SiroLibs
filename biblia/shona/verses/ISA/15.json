            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chirevo chaJehovha maererano neMoabhu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
