          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhibhoni rakwira kutemberi yaro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "kunzvimbo dzaro dzakakwirira kundochema;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Moabhu ari kuungudza pamusoro peNebho napamusoro peMedhebha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Misoro yose yaveurwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "ndebvu dzose dzabviswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
