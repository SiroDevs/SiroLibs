            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:13"
      },
      "items": [
        {
