      "attrs": {
        "style": "q2",
        "vid": "ISA 19:13"
      },
      "items": [
        {
          "text": "vatungamiri veMemufisi vanyengerwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.13",
            "verseOrgIds": [
              "ISA.19.13"
            ]
          }
        }
      ]
    },
    {
