      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:16"
      },
      "items": [
        {
          "text": "uye ndichaita kuti nzvimbo dzakaipa dziti chechetere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:16"
      },
      "items": [
        {
          "text": "Izvi ndizvo zvinhu zvandichaita;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:16"
      },
      "items": [
        {
          "text": "handizovasiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ivo vanovimba nezvifananidzo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:17"
      },
      "items": [
        {
          "text": "vanoti kune zvakaumbwa, 'Ndimi vamwari vedu,'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:17"
      },
      "items": [
        {
          "text": "vachadzoserwa shure mukunyadziswa kukuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeri iBofu neMatsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai, imi matsi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:18"
      },
      "items": [
        {
          "text": "tarirai, imi mapofu, muone!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko bofu, asi muranda wangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:19"
      },
      "items": [
        {
          "text": "uye matsi kufanana nenhume yandinotuma?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:19"
      },
      "items": [
        {
          "text": "Ndianiko bofu rakafanana naiye akazvipira kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:19"
      },
      "items": [
        {
          "text": "kana bofu rakafanana nomuranda waJehovha?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaona zvinhu zvizhinji, asi hauna kuva nehanya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:20"
      },
      "items": [
        {
          "text": "nzeve dzako dzakazaruka, asi hauna chaunonzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakafadza Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:21"
      },
      "items": [
        {
          "text": "nokuda kwokururama kwake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:21"
      },
      "items": [
        {
          "text": "kuti akudze murayiro wake uye aubwinyise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ava ndivo vanhu vakapambwa uye vakabirwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "vose vakasungwa mumakomba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "kana kuti vakavanzwa mumatorongo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "Vakava vabatwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "pasina anovarwira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "vakaitwa chinhu chakapambwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "pasina anoti, \"Vadzoserei kwavakabva.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani pakati penyu achateerera izvi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:23"
      },
      "items": [
        {
          "text": "kana kurerekera nzeve dzake zvikuru panguva inouya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani akarega Jakobho achipambwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:24"
      },
      "items": [
        {
          "text": "akaendesa Israeri kuvapambi?",
          "type": "text",
          "attrs": {
