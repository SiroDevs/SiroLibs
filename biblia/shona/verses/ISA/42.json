      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:15"
      },
      "items": [
        {
          "text": "uye madziva ndichaaomesa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichatungamirira mapofu nenzira dzavasingazivi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:16"
      },
      "items": [
        {
          "text": "nomumakwara avasina kuziva,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:16"
      },
      "items": [
        {
          "text": "ndichavatungamirira; ndichashandura rima rikava chiedza pamberi pavo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
    },
    {
