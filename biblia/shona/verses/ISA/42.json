  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "ISA 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muranda waJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tarirai muranda wangu, wandinotsigira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "musanangurwa wangu wandinofarira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "Ndichaisa Mweya wangu pamusoro pake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "uye achavigira ndudzi kururamisirwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haazodanidziri kana kuridza mhere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:2"
      },
      "items": [
        {
          "text": "kana kusimudza inzwi munzira dzomuguta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutsanga rwakapwanyika haangaruvhuni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:3"
      },
      "items": [
        {
          "text": "uye nomwenje unopfungaira haazoudzimi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:3"
      },
      "items": [
        {
          "text": "Mukutendeka, achavigira vanhu kururamisira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "haangakoniwi uye haangaperi simba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:4"
      },
      "items": [
        {
          "text": "kusvikira asimbisa kururamisirwa panyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:4"
      },
      "items": [
        {
          "text": "Zviwi zvichaisa tariro yazvo mumurayiro wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naMwari Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "iye akasika matenga akaatatamura,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "akatambanudza nyika nezvose zvinobuda mairi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "anopa kufema kuvanhu vayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "noupenyu kuna avo vanofamba pamusoro payo:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ini, Jehovha, ndakakudana mukururama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "ndichabata ruoko rwako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "Ndichakuchengeta ndigokuita",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "kuti uve sungano yavanhu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "nechiedza kune veDzimwe Ndudzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti usvinudze meso asingaoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:7"
      },
      "items": [
        {
          "text": "usunungure vakasungwa mutorongo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:7"
      },
      "items": [
        {
          "text": "uye usunungure vari mugomba, avo vagere murima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndini Jehovha; ndiro zita rangu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:8"
      },
      "items": [
        {
          "text": "Handizopi kukudzwa kwangu kuno mumwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:8"
      },
      "items": [
        {
          "text": "kana kurumbidzwa kwangu kuzvifananidzo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira, zvinhu zvakare zvaitika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "uye ndiri kutaura zvinhu zvitsva;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "izvo zvisati zvavapo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "ndinozvizivisa kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwiyo rwoKurumbidza Jehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha rwiyo rutsva,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "murumbidzei kubva kumagumo enyika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "imi munoburukira kugungwa, nezvose zviri mariri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "imi zviwi, navose vanogaramo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwenga namaguta aro ngazvidanidzire;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "nzvimbo dzinogara Kedhari ngadzifare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "Vanhu veSera ngavaimbe nomufaro;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "ngavapururudze pamusoro pemakomo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngavape rukudzo kuna Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:12"
      },
      "items": [
        {
          "text": "uye vaparidze rumbidzo yake kuzviwi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha achabuda somunhu ane simba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:13"
      },
      "items": [
        {
          "text": "semhare, achamutsa kushingaira kwake;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:13"
      },
      "items": [
        {
          "text": "nokudanidzira, achamutsa kurwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:13"
      },
      "items": [
        {
          "text": "uye achakunda vavengi vake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
