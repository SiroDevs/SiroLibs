      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nokuti ndanga ndakanyarara kwenguva refu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:14"
      },
      "items": [
        {
          "text": "ndanga ndinyerere uye ndichizvidzora.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:14"
      },
      "items": [
        {
          "text": "Asi zvino kufanana nomukadzi ari kusununguka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:14"
      },
      "items": [
        {
          "text": "ndiri kudanidzira, ndiri kufemedzeka nokutakwaira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaparadza makomo nezvikomo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:15"
      },
      "items": [
        {
          "text": "uye ndichaomesa zvose zvawo zvinomera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:15"
      },
      "items": [
        {
          "text": "ndichashandura nzizi dzikava zviwi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
