  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "54",
        "style": "c",
        "sid": "ISA 54"
      },
      "items": [
        {
          "text": "54",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubwinya kuchaita Zioni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 54:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imba, iwe mukadzi asina mwana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "iwe usina kumbobereka mwana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "pururudza uimbe rwiyo, pembera nomufaro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "iwe usina kumborwadziwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "nokuti vana vomukadzi akasiyiwa ari oga vazhinji kupfuura",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "veane murume,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ISA 54:1"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wedzera nzvimbo yetende rako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "tambanudza micheka yetende rako ifare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "usarega kuita izvozvo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "rebesa tambo dzako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:2"
      },
      "items": [
        {
          "text": "simbisa mbambo dzako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti uchapararira kurudyi nokuruboshwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "vana vako vachatorera dzimwe ndudzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:3"
      },
      "items": [
        {
          "text": "uye vachagara mumatongo amaguta avo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usatya hako: haunganyadziswi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Usatya kunyadziswa; haunganinipiswi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "Uchakanganwa nyadzi dzapaudiki hwako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:4"
      },
      "items": [
        {
          "text": "uye hauzorangaririzve kunyadzisa kwouchirikadzi hwako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Muiti wako ndiye murume wako,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Jehovha Wamasimba Ose ndiro zita rake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "Mutsvene waIsraeri ndiye Mudzikinuri wako;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:5"
      },
      "items": [
        {
          "text": "anonzi Mwari wenyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha achakudanazve",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "sokunge wanga uri mukadzi akasiyiwa, uye anotambudzika pamweya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "mukadzi akawanikwa achiri mudiki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:6"
      },
      "items": [
        {
          "text": "pedzezvo ndokurambwa,\" ndizvo zvinotaura Mwari wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwechinguvana ndakakusiya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:7"
      },
      "items": [
        {
          "text": "asi netsitsi huru ndikakudzosazve.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 54:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichisundwa nehasha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "ndakavanza chiso changu kwauri kwechinguva,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "asi nounyoro husingaperi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "ndichava netsitsi, pamusoro pako,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:8"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha Mudzikinuri wako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 54:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwandiri izvi zvakafanana namazuva aNoa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "pandakapika kuti mvura zhinji yaNoa haizofukidzizve nyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "Naizvozvo zvino ndapika kuti ndirege kukutsamwira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:9"
      },
      "items": [
        {
          "text": "kana kukutukazve.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 54:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange makomo akazungunuswa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "uye zvikomo zvikabviswa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "rudo rwangu rusingaperi harungazungunuswi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "uye sungano yangu yorugare haingabviswi,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 54:10"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha anokunzwira tsitsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
