      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhume dzakabva kuBhabhironi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Merodhaki-Bharadhani mwanakomana waBharadhani mambo weBhabhironi, akatumira matsamba nechipo kuna Hezekia, nokuti akanga anzwa nezvokurwara nokupora kwake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
            "verseOrgIds": [
              "ISA.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akagamuchira nhume nomufaro akavaratidza zvakanga zviri mumatura ake: sirivha, goridhe, zvinonhuhwira namafuta anokosha nenhumbi dzake dzose dzokurwa uye nezvose zvaiwanikwa papfuma yake. Hapana chinhu mumuzinda wake kana muumambo hwake chavasina kuratidzwa naHezekia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.2",
            "verseOrgIds": [
              "ISA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprofita Isaya akaenda kuna Mambo Hezekia akabvunza achiti, \"Varume avo vakati kudini, uye vakabvepi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 39:3"
      },
      "items": [
        {
          "text": "Hezekia akapindura achiti, \"Vakabva kunyika iri kure. Vakauya kwandiri vachibva kuBhabhironi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprofita akamubvunza achiti, \"Vakaoneiko mumuzinda menyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 39:4"
      },
      "items": [
        {
          "text": "Hezekia akati, \"Vakaona zvose zviri mumuzinda mangu. Pakati pepfuma yangu hapana chandisina kuvaratidza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Isaya akati kuna Hezekia, \"Inzwa shoko raJehovha Wamasimba Ose:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo nguva ichauya iyo zvose zviri mumba mako, nezvose zvakaunganidzwa namadzibaba ako kusvikira nhasi, zvichatakurwa zvichiendeswa kuBhabhironi. Hapana chichasara, ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vamwe vavana vako, venyama neropa rako chairo vauchabereka, vachatorwa uye vachava varanda mumuzinda wamambo weBhabhironi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akapindura achiti, \"Shoko raJehovha rawataura rakanaka.\" Nokuti akafunga kuti, \"Pachava norugare nokudzivirirwa pamazuva oupenyu hwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
  ],
