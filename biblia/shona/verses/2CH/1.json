      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2CH 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soromoni anokumbira Uchenjeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni mwanakomana waDhavhidhi akasimbisa kwazvo ushe hwake, nokuti Jehovha Mwari wake akanga anaye uye akamuita kuti ave mukuru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akataura kuIsraeri yose, kuvatungamiri vezviuru nokuvatungamiri vamazana, kuvatongi nokuvatungamiri vose muIsraeri, vakuru vemhuri,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Soromoni neungano yose vakaenda kunzvimbo yakakwirira yeGibheoni, nokuti Tende Rokusangana raMwari rakanga ririko, iro rakanga ragadzirwa naMozisi muranda waMwari murenje.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi akanga auyisa areka yaMwari kubva kuKiriati Jearimi kunzvimbo yaakanga aigadzirira nokuti akanga aidzikira tende muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aritari yendarira yakanga yagadzirwa naBhezareri mwanakomana waUri, mwanakomana waHuri, yakanga iri muGibheoni pamberi peTabhenakeri yaJehovha; saka Soromoni neungano vakandomubvunza ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akakwira kuaritari yendarira pamberi paJehovha muTende Rokusangana akandobayira zvipiriso zvinopiswa zvinokwana chiuru pairi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku ihwohwo Mwari akazviratidza kuna Soromoni akati kwaari, \"Kumbira chose chaungada kuti ndikupe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akapindura Mwari akati, \"Makaratidza unyoro hwenyu hukuru kwazvo kuna Dhavhidhi baba vangu uye mukandiita mambo pachinzvimbo chavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, Jehovha Mwari, itai henyu kuti chivimbiso chenyu kuna baba vangu Dhavhidhi chizadziswe, nokuti makandiita mambo pamusoro pavanhu vakawanda seguruva renyika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipeiwo uchenjeri noruzivo, kuti ndigotungamirira vanhu ava, nokuti ndiani angagona kutonga vanhu venyu vakawanda ava?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akati kuna Soromoni, \"Sezvo ichi chiri chido chemwoyo wako uye hauna kukumbira upfumi hwakawanda kana kukudzwa, kana kufa kwavavengi vako, uye nokuti hauna kukumbira upenyu hurefu asi uchenjeri noruzivo kuti utonge vanhu vangu avo vandakuita mambo pamusoro pavo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.11",
            "verseOrgIds": [
              "2CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "naizvozvo uchapiwa uchenjeri noruzivo. Uye ini ndichakupawo upfumi, hwakawanda nokukudzwa zvisati zvambowanikwa namadzimambo ose akakutangira zvakare hakunazve mambo achauya shure kwako achava nazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akaenda kuJerusarema achibva kunzvimbo yakakwirira paGibheoni, kubva paTende Rokusangana. Uye akatonga Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akazviunganidzira ngoro namabhiza; aiva nengoro chiuru namazana mana, nezviuru gumi nezviviri zvamabhiza, zvaaichengetera mumaguta engoro uye nokuJerusarema kwaaivawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akaita kuti sirivha negoridhe zviwanikwe kwose kwose muJerusarema samatombo uye misidhari ikawanda semionde mujinga mezvikomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabhiza aSoromoni aitengwa kuIjipiti nokuKuwe, vatengi vamambo vaitenga kubva kuKuwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaitenga ngoro imwe chete kubva kuIjipiti ichiita mashekeri mazana matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        },
        {
          "text": "esirivha uye bhiza rimwe chete richiita mashekeri zana namakumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        },
        {
          "text": ". Ivo vaizoatengeserawo kumadzimambo ose avaHiti navaAramu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
  ],
