  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JDG 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MuRevhi noMurongo wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva iwayo Israeri yakanga isina mambo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 19:1"
      },
      "items": [
        {
          "text": "Zvino mumwe muRevhi akanga achigara munyika iri kure yezvikomo yeEfuremu akatora murongo aibva kuBheterehema muJudha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akanga asina kutendeka kwaari. Akamusiya akadzokerazve kumba kwababa vake kuBheterehema, Judha. Mushure mokunge agarako kwemwedzi mina,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.2",
            "verseOrgIds": [
              "JDG.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "murume wake akaenda kwaari kundomunyengetedza kuti adzoke. Akanga ane muranda wake nembongoro mbiri. Akamupinza mumba mababa vake, uye baba vake vakati vamuona, vakamugamuchira nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.3",
            "verseOrgIds": [
              "JDG.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tezvara vake, ivo baba vomusikana, vakamugombedzera kuti agare; saka akagara naye kwamazuva matatu, vachidya nokunwa uye achivatapo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.4",
            "verseOrgIds": [
              "JDG.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechina vakamuka mangwanani vakagadzirira kuti vaende, asi baba vomusikana vakati kumukuwasha wavo, \"Simbisa mwoyo wako nechokudya; ipapo mugoenda henyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vose vari vaviri vakagara pasi kuti vadye nokunwa pamwe chete. Mushure maizvozvo, baba vomusikana vakati, \"Ndapota chivata hako usiku uno uye umbofara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.6",
            "verseOrgIds": [
              "JDG.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye murume uyu akati asimuka kuti aende, tezvara vake vakamunyengetedza, saka akavatapo usiku uhwo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.7",
            "verseOrgIds": [
              "JDG.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani ezuva reshanu, paakamuka kuti aende, baba vomusikana vakati, \"Simbisa mwoyo wako. Gara kusvikira masikati!\" Saka vose vari vaviri vakadya pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.8",
            "verseOrgIds": [
              "JDG.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume, murongo wake uye nomuranda wake, vakati vasimuka kuti vaende, tezvara wake, baba vomusikana vakati, \"Zvino chiona kwava kudoka. Chivata hako pano usiku huno; kwavira. Gara ufadze mwoyo wako. Mangwana mangwanani, ungamuka ugopinda hako munzira yako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, nokusada kuvatazve humwe usiku, murume uya akabuda akaenda akananga kuJebhusi (ndiro Jerusarema), nembongoro dzake mbiri dzakaiswa zvigaro, nomurongo wake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vava pedyo neJebhusi uye zuva rakanga rovira, muranda akati kuna tenzi wake, \"Uyai, titsaukire muguta iri ravaJebhusi tindovatamo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenzi wake akapindura akati, \"Kwete. Hatingapindi muguta ravatorwa, vanhu varo zvavasiri vaIsraeri. Tichapfuurira kuGibhea.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenderera mberi akati, \"Uyai, tiedze kusvika kuGibhea kana kuRama tigovata mune imwe yenzvimbo idzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakapfuurira mberi, uye zuva rakavira pavakanga vasvika muGibhea muBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imomo, ndimo mavakamira kuti vavate. Vakaenda vakandogara muchivara cheguta, asi hapana munhu akavatora akavapinza mumba make usiku.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madekwana iwayo, imwe harahwa yaibva munyika yezvikomo yeEfuremu, yaigara muGibhea (vanhu venzvimbo vaiva vaBhenjamini), yakasvika ichibva kubasa rayo kumunda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.16",
            "verseOrgIds": [
              "JDG.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakati yatarira ikaona mufambi ari muchivara cheguta, harahwa yakabvunza ikati, \"Uri kuendepiko? Wabvepiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.17",
            "verseOrgIds": [
              "JDG.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Tiri kubva kuBheterehema muJudha; tiri kuenda kure kunyika yezvikomo yeEfuremu, ndiko kwandinogara. Ndakanga ndiri kuBheterehema muJudha, asi iye zvino ndiri kuenda kumba kwaJehovha. Hapana munhu anditora akandipinza mumba make.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tine zvose mashanga nouswa hwembongoro dzedu uye chingwa chedu newaini yedu, isu varanda venyu, ini, murandakadzi wenyu, nejaya ratinaro. Hatina chinhu chatingada hedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.19",
            "verseOrgIds": [
              "JDG.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harahwa yakati, \"Munogona kuuya kumba kwangu. Ndichakupai zvose zvamunoshayiwa. Asi bedzi usavata pachivara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.20",
            "verseOrgIds": [
              "JDG.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akamutora akamupinza mumba make uye akapa mbongoro dzake zvokudya. Vakati vashamba tsoka dzavo, vakadya zvokudya uye vakanwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.21",
            "verseOrgIds": [
              "JDG.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachiri pakufara havo, vamwe vanhu vakaipa vomuguta vakakomba imba. Vachigogodza pamukova, vakadanidzira kuharahwa yakanga iri iyo muridzi weimba vachiti, \"Budisa murume uyo apinda mumba mako kuti tivate naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muridzi wemba akabuda panze akati kwavari, \"Kwete, shamwari dzangu, regai kuita zvakaipa kudai. Sezvo murume uyu ari mueni wangu, regai kuita chinhu ichi chinonyadzisa kudai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.23",
            "verseOrgIds": [
              "JDG.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai, heyi mhandara mwanasikana wangu uyu, nemurongo wake. Ndichavabudisa kwamuri izvozvi, uye munogona kuvabata mugoita kwavari zvose zvamunoda. Asi kumurume uyu, regai kuita chinhu chinonyadzisa zvakadaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.24",
            "verseOrgIds": [
              "JDG.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi varume ava havana kuda kumuteerera. Saka murume uyu akatora murongo wake akamuendesa kunze kwavari, uye vakamubata chibharo vakamuchinya usiku hwose, uye panguva dzamambakwedza vakamuregedza kuti aende.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.25",
            "verseOrgIds": [
              "JDG.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaedza, mukadzi akadzokera kumba kwaigara tenzi wake, akawira pasi pamukova wemba uye akavatapo kusvikira kwaedza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tenzi wake akati achimuka mangwanani akazarura mukova wemba akabuda panze kuti afambire mberi norwendo rwake, onei hoyo murongo wake avete akawira pasi pamukova wemba, maoko ake ari pachikumbaridzo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.27",
            "verseOrgIds": [
              "JDG.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwaari, \"Muka; handei.\" Asi pakanga pasina mhinduro. Ipapo murume uya akamuisa pambongoro akasimuka akaenda kumusha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achisvika kumusha, akatora banga akagura-gura murongo wake, mutezo muzvidimbu gumi nezviviri akazvitumira munzvimbo dzose dzeIsraeri.",
