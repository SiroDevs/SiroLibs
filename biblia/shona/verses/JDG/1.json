  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JDG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaIsraeri vanorwa navaKenani vakasara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokufa kwaJoshua, vaIsraeri vakabvunza Jehovha vakati, \"Ndiani pakati pedu achatanga kukwidza kundorwa navaKenani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akapindura akati, \"Judha ngaaende; ndapa nyika mumaoko ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.2",
            "verseOrgIds": [
              "JDG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume veJudha vakati kuvaSimeoni hama dzavo, \"Ngatiendei tose kunyika yatakagoverwa, kuti tindorwa navaKenani. Nesuwo tichaenda nemi kumugove wenyu.\" Saka vaSimeoni vakaenda navo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judha paakarwisa, Jehovha akaisa vaKenani navaPerizi mumaoko avo uye vakauraya varume zviuru gumi paBhezeki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndipo pavakawana Adhoni Bhezeki vakarwa naye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.5",
            "verseOrgIds": [
              "JDG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adhoni Bhezeki akatiza, asi vakamudzinganisa vakamubata, vakagura zvigunwe zvake zvikuru zvomumaoko nezvigunwe zvake zvikuru zvomumakumbo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.6",
            "verseOrgIds": [
              "JDG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Adhoni Bhezeki akati, \"Madzimambo makumi manomwe, vagurwa zvigunwe zvikuru zvomumaoko nezvigunwe zvikuru zvokumakumbo, vakanonga zvimedu zvezvokudya pasi petafura yangu. Zvino Mwari anditsiva pane zvandakaita kwavari.\" Vakaenda naye kuJerusarema akandofira ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veJudha vakarwisawo Jerusarema vakaritora. Vakakunda guta nomunondo uye vakaripisa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.8",
            "verseOrgIds": [
              "JDG.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, varume veJudha vakaburuka vakandorwa navaKenani vaigara munyika yezvikomo, kuNegevhi uye nomujinga mezvikomo zvokumavirira.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.9",
            "verseOrgIds": [
              "JDG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenda vakandorwa navaKenani vaigara muHebhuroni (rainzi Kiriati Abha kare) vakakunda Sheshai, Ahimani neTarimai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.10",
            "verseOrgIds": [
              "JDG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachibva ipapo, vakaenda vakandorwa navanhu vaigara muDhebhiri (rainzi Kiriati Seferi kare.)",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.11",
            "verseOrgIds": [
              "JDG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Karebhu akati, \"Ndichapa mwanasikana wangu Akisa kuti ave mukadzi kumurume acharwisa uye achatapa Kiriati Seferi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.12",
            "verseOrgIds": [
              "JDG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otinieri mwanakomana waKenazi, mununʼuna waKarebhu, akarikunda, saka Karebhu akapa mwanasikana wake Akisa kuti awanikwe naye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.13",
            "verseOrgIds": [
              "JDG.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva akati achisvika kuna Otinieri, akamukurudzira kuti akumbire munda kuna baba vake. Akati aburuka pambongoro yake, Karebhu akamubvunza akati, \"Ndingakuitireiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.14",
            "verseOrgIds": [
              "JDG.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Ndiitirei zvakanaka. Sezvo makandipa nyika kuNegevhi, ndipeiwo matsime emvura.\" Ipapo Karebhu akamupa matsime okumusoro neezasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvatezvara vaMozisi, vaKeni, vakakwidza vachibva kuGuta reMichindwe vaine varume veJudha kuti vandogara pakati pavanhu vokuGwenga reJudha riri kuNegevhi pedyo neAradhi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.16",
            "verseOrgIds": [
              "JDG.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume veJudha vakaenda navaSimeoni hama dzavo vakandorwisa vaKenani vaigara muZefati, uye vakaparadza guta iri zvachose. Naizvozvo rakatumidzwa kuti Horima.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.17",
            "verseOrgIds": [
              "JDG.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veJudha vakakundazve Gaza, Ashikeroni neEkironi, guta rimwe nerimwe nenyika yaro.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.18",
            "verseOrgIds": [
              "JDG.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akanga ana vanhu veJudha. Vakatora nyika yezvikomo kuti ive yavo, asi havana kugona kudzinga vanhu vaibva mumapani, nokuti vakanga vane ngoro dzesimbi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokuvimbisa kwaMozisi, Hebhuroni yakapiwa kuna Karebhu, uyo akabudisa mairi vanakomana vatatu vaAnaki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vaBhenjamini vakatadza kudzinga vaJebhusi, vaigara muJerusarema; kusvikira nhasi vaJebhusi vageremo navaBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino veimba yaJosefa vakarwisa Bheteri, uye Jehovha aiva navo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vatuma vanhu kundosora Bheteri (rainzi Ruzi kare),",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
              "JDG.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vasori vakaona murume achibuda muguta vakati kwaari, \"Tiratidze kuti tingapinda sei muguta tigokuitira zvakanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.24",
            "verseOrgIds": [
              "JDG.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akavaratidza, uye vakakunda guta nomunondo asi vakaponesa murume uya nemhuri yake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaenda kunyika yavaHiti, kwaakandovaka guta akaritumidza kuti Ruzi, rinova ndiro zita raro nanhasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Manase haana kudzinga vanhu veBheti Shani kana veTanaki kana veDhori kana veIbhireami kana veMegidho uye nenzvimbo dzavo dzokugara dzakapoteredza, nokuti vaKenani vakanga vazvipira kuti vagare munyika iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.27",
            "verseOrgIds": [
              "JDG.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakati vasimba vakamanikidza vaKenani kuti vashande basa rechibharo asi havana kumbovadzinga zvachose.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Efuremu haana kudzingawo vaKenani vaigara muGeeri, asi vaKenani vakaramba vagere pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
              "JDG.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "NaZebhuruniwo haana kudzinga vaKenani vaigara muKitironi kana muNaharori, avo vakaramba vagere pakati pavo; asi vakaita kuti vaite basa rechibharo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Asheri haanawo kudzinga vaya vaigara muAko kana veSidhoni kana Ahirabhi kana Akizibhi kana Heribha kana Afeki kana Rehobhi,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.31",
            "verseOrgIds": [
              "JDG.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nokuda kwaizvozvo vanhu veAsheri vakagara pakati pavaKenani avo vaigara munyika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
            "verseOrgIds": [
              "JDG.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafutari haana kudzinga avo vaigara muBheti Shemeshi kana muBheti Anati; asi vaNafutari vakagarawo pakati pavaKenani vaigara munyika, uye vaya vaigara muBheti Shemeshi neBheti Anati vakava vashandi vebasa rechibharo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.33",
            "verseOrgIds": [
              "JDG.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmori vakasundira vaDhani kunyika yezvikomo, vakasavatendera kuburuka kuti vauye kumapani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vaAmori vakashingirira kuti varambe vari muGomo reHeresi, Aijaroni neShaaribhimi, asi simba reimba yaJosefa rakati richiwanda, naivowo vakamanikidzwa kushanda basa rechibharo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganhu wavaAmori waibva paMupata weChinyavada uchisvika kuSera uye uchipfuurira mberi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.36",
            "verseOrgIds": [
              "JDG.1.36"
            ]
          }
        }
      ]
    }
