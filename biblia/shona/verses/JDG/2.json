  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JDG 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutumwa waJehovha paBhokimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha akakwidza achibva kuGirigari akaenda kuBhokimi akati, \"Ndakakubudisai kubva muIjipiti uye ndikakutungamirirai munyika yandakapikira madzitateguru enyu. Ndakati, 'Handichazomboputsi sungano yangu nemi,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.1",
            "verseOrgIds": [
              "JDG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye imi musazoita sungano navanhu venyika ino, asi munofanira kuputsa aritari dzavo.' Asi hamuna kunditeerera. Makaitireiko izvozvo?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.2",
            "verseOrgIds": [
              "JDG.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvino ndinokuudzai kuti handichazovadzingi pamberi penyu, vachava minzwa kumativi enyu uye vamwe vavo vachava musungo kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.3",
            "verseOrgIds": [
              "JDG.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa waJehovha akati ataura zvinhu izvi kuvaIsraeri vose, vanhu vakachema kwazvo,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.4",
            "verseOrgIds": [
              "JDG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakatumidza nzvimbo iyo kuti Bhokimi. Ipapo, vakabayira zvipiriso kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.5",
            "verseOrgIds": [
              "JDG.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusateerera noKukundwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge Joshua ati vaIsraeri vaende, vakaenda vakandotora nyika, mumwe nomumwe kunhaka yake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakashumira mazuva ose okurarama kwaJoshua uye napamazuva avakuru vakasara vari vapenyu uye vakanga vaona zvinhu zvikuru zvose zvakanga zvaitirwa Israeri naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua mwanakomana waNuni, muranda waJehovha, akafa ava namakore zana negumi rimwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakamuviga munyika yenhaka yake, paTiminati Heresi munyika yezvikomo yeEfuremu, kumusoro kweGomo reGaashi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge chizvarwa chake chose chasanganiswa namadzibaba acho, chimwe chizvarwa chakanga chisingazivi Jehovha kana zvaakanga aitira Israeri chakamuka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaIsraeri vakaita zvakaipa pamberi paJehovha uye vakashumira vanaBhaari.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarasa Jehovha, Mwari wamadzibaba avo, akanga avabudisa kubva muIjipiti. Vakatevera uye vakanamata vamwari vakasiyana-siyana vendudzi dzakanga dzakavapoteredza. Vakatsamwisa Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vakamurasa uye vakashumira Bhaari navaAshitoreti.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukutsamwira kwake vaIsraeri, Jehovha akavaisa mumaoko avapambi avo vakazovapamba. Akavatengesa kuvavengi vavo vakanga vakavapoteredza, avo vavakanga vasisagoni kudzivisa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose paienda Israeri kundorwa, ruoko rwaJehovha rwairwa navo kuti ruvakunde, sezvaakanga apika kwavari. Vakanga vari munhamo huru.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akavamutsira vatongi vakavaponesa kubva mumaoko avapambi ava.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.16",
            "verseOrgIds": [
              "JDG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro havana kuzoteerera kuvatongi vavo asi vakaita ufeve navamwe vamwari uye vakavanamata. Havana kuita samadzibaba avo, nokuti vakakurumidza kutsauka munzira yaifamba madzibaba avo, nzira yokuteerera kumirayiro yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose pavaimutsirwa mutongi naJehovha, iye aiva nomutongi uyo, uye aivaponesa kubva mumaoko avavengi vavo, mutongi paainge achiri mupenyu; nokuti Jehovha ainge avanzwira ngoni pavaigomera vari pasi pavaya vaivadzvinyirira uye vachivarwadzisa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mutongi paainge afa, vanhu vaidzokera kunzira dzakaipisisa kupinda dziya dzamadzibaba avo, vachitevera vamwe vamwari, vachivashandira uye vachivanamata. Vakaramba kusiya mabasa avo akaipa nokusindimara kwemwoyo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.19",
            "verseOrgIds": [
              "JDG.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Jehovha akavatsamwira zvikuru akati, \"Nemhaka yokuti rudzi urwu rwakaputsa sungano yangu yandakaita namadzitateguru avo uye vakasanditeerera,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.20",
            "verseOrgIds": [
              "JDG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "handichadzingizve pamberi pavo rudzi rupi zvarwo rwedzimwe ndudzi dzakasiyiwa naJoshua pakufa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.21",
            "verseOrgIds": [
              "JDG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichavashandisa kuti vaedze vaIsraeri, kuti ndione kuti vachachengeta here nzira yaJehovha vagofamba mairi sezvakaitwa namadzitateguru avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akatendera ndudzi idzo kuti dzisare; haana kudzidzinga pakarepo uye haana kudziisa mumaoko aJoshua.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.23",
            "verseOrgIds": [
              "JDG.2.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JDG.3",
    "number": "3",
