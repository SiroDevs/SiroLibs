  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JDG 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhibhora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokufa kwaEhudhi, vaIsraeri vakaitazve zvakaipa pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.1",
            "verseOrgIds": [
              "JDG.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha akavatengesa mumaoko aJabhini, mambo weKenani, aitonga ari muHazori. Mukuru wehondo yake akanga ari Sisera, uyo aigara muHarosheti Hagoyimi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.2",
            "verseOrgIds": [
              "JDG.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwokuti akanga ane ngoro dzesimbi mazana mapfumbamwe uye akadzvinyirira vaIsraeri zvakaipisisa kwazvo kwamakore makumi maviri, vakachemera rubatsiro kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.3",
            "verseOrgIds": [
              "JDG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhibhora, muprofitakadzi, mukadzi waRapidhoti, akanga achitungamirira vaIsraeri panguva iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.4",
            "verseOrgIds": [
              "JDG.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aitonga mhaka ari pasi poMuchindwe waDhibhora pakati peRama neBheteri munyika yezvikomo yaEfuremu, uye vaIsraeri vaiuya kwaari kuzotongerwa mhosva dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.5",
            "verseOrgIds": [
              "JDG.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatuma shoko kuna Bharaki mwanakomana waAbhinoami aibva kuKadheshi muNafutari akati kwaari, \"Jehovha, Mwari waIsraeri anokurayira kuti, 'Enda undotora zviuru gumi zvavarume veNafutari neveZebhuruni ugovatungamirira kuGomo reTabhori.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakwezva Sisera, mukuru wehondo yaJabhini, nengoro dzake uye namauto ake kuRwizi rweKishoni ndigomuisa mumaoko ako.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.7",
            "verseOrgIds": [
              "JDG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharaki akati kwaari, \"Kana imi mukaenda neni, ini ndichaenda; asi kana musingaendi neni, neni handingaendi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.8",
            "verseOrgIds": [
              "JDG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhibhora akati, \"Zvakanaka hazvo, ndichaenda newe. Asi nokuda kwenzira yauri kuda kuita nayo izvi, kukudzwa hakungavi kwako, nokuti Jehovha achaisa Sisera muruoko rwomukadzi.\" Saka Dhibhora akaenda naBharaki kuKadheshi,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.9",
            "verseOrgIds": [
              "JDG.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uko kwaakandodana Zebhuruni naNafutari. Varume zviuru gumi vakamutevera, naDhibhorawo akaenda navo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.10",
            "verseOrgIds": [
              "JDG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Hebheri muKeni akanga asiya vamwe vaKeni, zvizvarwa zvaHobhabhi, hanzvadzi yomukadzi waMozisi akandodzika tende rake pamuti mukuru muZaananimi pedyo neKadheshi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.11",
            "verseOrgIds": [
              "JDG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vaudza Sisera kuti Bharaki mwanakomana waAbhinoami akanga akwidza kuGomo reTabhori,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.12",
            "verseOrgIds": [
              "JDG.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisera akaunganidza pamwe chete ngoro dzesimbi mazana mapfumbamwe navarume vose vaaiva navo, kubva kuHarosheti Hagoyimi kusvikira kuRwizi rweKishoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.13",
            "verseOrgIds": [
              "JDG.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhibhora akati kuna Bharaki, \"Enda! Iri ndiro zuva rapiwa Sisera mumaoko ako naJehovha. Ko, Jehovha haasi mberi kwako here?\" Saka Bharaki akaburuka muGomo reTabhori, achiteverwa navarume zviuru gumi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.14",
            "verseOrgIds": [
              "JDG.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakungofamba kwaBharaki, Jehovha akakunda nomunondo Sisera nengoro dzake dzose nehondo yake, uye Sisera akasiya ngoro yake akatiza netsoka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.15",
            "verseOrgIds": [
              "JDG.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Bharati akatevera ngoro nehondo yaSisera akandosvika kuHarosheti Hagoyimi. Mauto ose aSisera akaurayiwa nomunondo; hapana munhu akasara.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.16",
            "verseOrgIds": [
              "JDG.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, Sisera akatiza netsoka akaenda kutende raJaeri, mukadzi waHebheri muKeni, nokuti pakati paJabhini mambo weHazori nemhuri yaHebheri pakanga pane kunzwanana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.17",
            "verseOrgIds": [
              "JDG.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaeri akabuda kuti andosangana naSisera akati kwaari, \"Uyai ishe wangu, pindai zvenyu mukati chaimo. Musatya.\" Saka akapinda mutende rake, uye akaisa chifukidzo pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.18",
            "verseOrgIds": [
              "JDG.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Ndine nyota. Ndapota, ndipeiwo mvura.\" Akadziura guchu romukaka, akamupa kuti anwe, ndokubva amufukidza hake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.19",
            "verseOrgIds": [
              "JDG.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatizve kwaari, \"Mira pamukova wetende. Kana mumwe munhu akauya pano akakubvunza achiti, 'Pano munhu here pano?' uti, 'Kwete.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.20",
            "verseOrgIds": [
              "JDG.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jaeri, mukadzi waHebheri, akatora mbambo yetende nenyundo akaenda paari chinyararire, iye akafa nehope, aneta. Akaroverera mbambo napachavovo, ikanyura muvhu, akafa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.21",
            "verseOrgIds": [
              "JDG.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharaki akasvika achitevera Sisera, uye Jaeri akabuda kundomuchingamidza, achiti, \"Uyai, ndizokuratidzai munhu wamuri kutsvaka.\" Saka akapinda naye mukati, onei hoyo Sisera avete uye mbambo yetende iri muchavovo chake, afa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.22",
            "verseOrgIds": [
              "JDG.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro, Mwari akakunda Jabhini, mambo wavaKenani, pamberi pavaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
            "verseOrgIds": [
              "JDG.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ruoko rwavaIsraeri rwakaramba ruchiwedzera simba pakurwisa Jabhini, mambo wavaKenani kusvikira vamuparadza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.24",
            "verseOrgIds": [
              "JDG.4.24"
            ]
          }
        }
      ]
    }
  ],
