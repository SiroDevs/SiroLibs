      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha, mufarisise, imi vakarurama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:1"
      },
      "items": [
        {
          "text": "zvakanaka kuti vakarurama vamurumbidze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.1",
            "verseOrgIds": [
              "PSA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha nembira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:2"
      },
      "items": [
        {
          "text": "muimbirei nziyo nomutengeranwa une hungiso gumi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.2",
            "verseOrgIds": [
              "PSA.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muimbirei rwiyo rutsva;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:3"
      },
      "items": [
        {
          "text": "muridze zvakanaka, mugopururudza nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.3",
            "verseOrgIds": [
              "PSA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti shoko raJehovha rakarurama uye nderechokwadi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:4"
      },
      "items": [
        {
          "text": "iye akatendeka pane zvose zvaanoita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.4",
            "verseOrgIds": [
              "PSA.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anoda kururama nokururamisira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:5"
      },
      "items": [
        {
          "text": "nyika izere norudo rwake rusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.5",
            "verseOrgIds": [
              "PSA.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudenga denga kwakaitwa neshoko raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:6"
      },
      "items": [
        {
          "text": "hondo dzenyeredzi dzaikoko, nokufema kwomuromo wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.6",
            "verseOrgIds": [
              "PSA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anounganidza mvura zhinji yegungwa muzvirongo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:7"
      },
      "items": [
        {
          "text": "anoisa kwakadzika mumatura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.7",
            "verseOrgIds": [
              "PSA.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yose ngaitye Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:8"
      },
      "items": [
        {
          "text": "marudzi ose enyika ngaamuremekedze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.8",
            "verseOrgIds": [
              "PSA.33.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti iye akataura, zvikaitika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:9"
      },
      "items": [
        {
          "text": "akarayira, zvikamira zvakasimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.9",
            "verseOrgIds": [
              "PSA.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anokonesa urongwa hwendudzi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:10"
      },
      "items": [
        {
          "text": "anopinganidza mifungo yendudzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.10",
            "verseOrgIds": [
              "PSA.33.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi urongwa hwaJehovha hunomira hwakasimba nokusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:11"
      },
      "items": [
        {
          "text": "nendangariro dzomwoyo wake kusvikira kuzvizvarwa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.11",
            "verseOrgIds": [
              "PSA.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwakaropafadzwa rudzi rwakaita Jehovha Mwari warwo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:12"
      },
      "items": [
        {
          "text": "vanhu vaakasarudza kuti vave nhaka yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.12",
            "verseOrgIds": [
              "PSA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anotarira pasi ari kudenga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:13"
      },
      "items": [
        {
          "text": "uye anoona marudzi ose avanhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.13",
            "verseOrgIds": [
              "PSA.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari pachigaro chake anotarira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:14"
      },
      "items": [
        {
          "text": "vose vagere panyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.14",
            "verseOrgIds": [
              "PSA.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye anoumba mwoyo yavanhu vose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:15"
      },
      "items": [
        {
          "text": "anofungisisa zvose zvavanoita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.15",
            "verseOrgIds": [
              "PSA.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapana mambo anoponeswa nokukura kwehondo yake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:16"
      },
      "items": [
        {
          "text": "hapana murwi anopunyuka nokuda kwesimba rake guru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.16",
            "verseOrgIds": [
              "PSA.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhiza itariro isina maturo pakurwirwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:17"
      },
      "items": [
        {
          "text": "harigoni kuponesa kunyange rine simba guru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.17",
            "verseOrgIds": [
              "PSA.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi meso aJehovha ari pamusoro paavo vanomutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 33:18"
      },
      "items": [
        {
          "text": "napamusoro paavo vakaisa tariro yavo murudo rwake rusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.33.18",
            "verseOrgIds": [
              "PSA.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
