      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:3"
      },
      "items": [
        {
          "text": "riri kuwira pamusoro peGomo reZioni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.3",
            "verseOrgIds": [
              "PSA.133.3"
            ]
          }
        }
      ]
    },
