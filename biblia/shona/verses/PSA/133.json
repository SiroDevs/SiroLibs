      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:1"
      },
      "items": [
        {
          "text": "kana hama dzichigara pamwe chete mukubatana!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.1",
            "verseOrgIds": [
              "PSA.133.1"
            ]
          }
        }
