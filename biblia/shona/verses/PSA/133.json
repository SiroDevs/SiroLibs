          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakafanana namafuta anokosha adururirwa pamusoro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "anoerera kundebvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "anoerera kundebvu dzaAroni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 133:2"
      },
      "items": [
        {
          "text": "anoburukira kusvikira pamipendero yenguo dzake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.133.2",
            "verseOrgIds": [
              "PSA.133.2"
            ]
          }
        }
      ]
    },
    {
