          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 116",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 116:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoda Jehovha, nokuti akanzwa inzwi rangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:1"
      },
      "items": [
        {
          "text": "akandinzwira tsitsi pakuchema kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 116:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akarerekera nzeve yake kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:2"
      },
      "items": [
        {
          "text": "ndichadana kwaari mazuva ose oupenyu hwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 116:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misungo yorufu yakandipinganidza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "kurwadza kweguva kwakauya pamusoro pangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "ndakakundwa nenhamo nokusuwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 116:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakadana kuzita raJehovha ndikati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:4"
      },
      "items": [
        {
          "text": "\"Haiwa Jehovha, ndiponesei!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 116:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ane nyasha uye akarurama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:5"
      },
      "items": [
        {
          "text": "Mwari wedu azere netsitsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 116:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anodzivirira vakatendeka pamwoyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:6"
      },
      "items": [
        {
          "text": "pandakanga ndiri pakushayiwa kukuru, iye akandiponesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 116:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa mweya wangu, chizorora zvakare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:7"
      },
      "items": [
        {
          "text": "nokuti Jehovha akakuitira zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 116:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti imi, iyemi Jehovha, makarwira mweya wangu parufu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "meso angu pamisodzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "uye makumbo angu pakugumburwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 116:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ndifambe pamberi paJehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:9"
      },
      "items": [
        {
          "text": "munyika yavapenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 116:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatenda; naizvozvo ndakati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:10"
      },
      "items": [
        {
          "text": "\"Ndiri kutambudzika kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 116:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye pakuvhunduka kwangu ndakati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:11"
      },
      "items": [
        {
          "text": "\"Vanhu vose vanoreva nhema.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 116:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndingaripira seiko Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:12"
      },
      "items": [
        {
          "text": "pamusoro pokunaka kwake kwose kwandiri?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 116:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichasimudza mukombe woruponeso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:13"
      },
      "items": [
        {
          "text": "ndigodana kuzita raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 116:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichazadzisa mhiko dzangu kuna Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:14"
      },
      "items": [
        {
          "text": "pamberi pavanhu vake vose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 116:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinhu chinokosha pamberi paJehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:15"
      },
      "items": [
        {
          "text": "ndirwo rufu rwavatsvene vake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 116:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, zvirokwazvo ndiri muranda wenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "ndiri muranda wenyu, mwanakomana womurandakadzi wenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "makandisunungura pangetani dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 116:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichabayira chipo chokuvonga kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.17",
            "verseOrgIds": [
              "PSA.116.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:17"
      },
      "items": [
        {
          "text": "uye ndichadana kuzita raJehovha.",
          "type": "text",
