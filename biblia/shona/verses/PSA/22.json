  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "PSA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Namaimbirwo e\"Nondo yamangwanani.\" Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari wangu, Mwari wangu, mandisiyireiko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "text": "Sei muri kure zvakadai nokundiponesa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "text": "kure zvakadai namashoko okugomera kwangu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari wangu, ndinodanidzira masikati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "asi hamundipinduri, nousiku, uye handinyarari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi makagadzwa saIye Mutsvene;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "ndimi rumbidzo yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzibaba edu akavimba nemi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:4"
      },
      "items": [
        {
          "text": "vakavimba, uye mukavarwira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakachema kwamuri, vakaponeswa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:5"
      },
      "items": [
        {
          "text": "vakavimba nemi uye havana kunyadziswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ini ndiri honye kwete munhu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "ndinozvidzwa navanhu uye ndinoshorwa namarudzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vanondiona vanondiseka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:7"
      },
      "items": [
        {
          "text": "vanoshamisa miromo yavo vachindituka, vachidzungudza misoro yavo vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anovimba naJehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "Jehovha ngaamununure.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "Ngaamuponese,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "sezvo achimufarira.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndimi makandibudisa mudumbu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "mukaita kuti ndivimbe nemi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "ndichiri pachipfuva chamai vangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pakuzvarwa kwangu, ndakaiswa kwamuri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:10"
      },
      "items": [
        {
          "text": "kubva mudumbu ramai vangu, makanga muchingova Mwari wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai kuva kure neni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "nokuti dambudziko riri pedyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "uye hakuna angabatsira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hando zhinji dzakandikomba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:12"
      },
      "items": [
        {
          "text": "hando dzine simba dzeBhashani dzakandipoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shumba dzinoomba dzichibvambura nyama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:13"
      },
      "items": [
        {
          "text": "dzinondishamira miromo yadzo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndadururwa semvura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "uye mapfupa angu ose abva asvodogoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "Mwoyo wangu washanduka ukava namo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "wanyungudika mukati mangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba rangu raoma sechaenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "uye rurimi rwangu runonamatira kumusoro kwomuromo wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "munondiradzika muguruva rorufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
