  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "65",
        "style": "c",
        "sid": "PSA 65"
      },
      "items": [
        {
          "text": "65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi. Rwiyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurumbidzwa kwakakumirirai, imi Mwari, muZioni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:1"
      },
      "items": [
        {
          "text": "kwamuri mhiko dzedu dzichazadziswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, imi munonzwa munyengetero,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:2"
      },
      "items": [
        {
          "text": "vanhu vose vachauya kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patakanga takafukidzwa nezvivi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:3"
      },
      "items": [
        {
          "text": "makakanganwira kudarika kwedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaropafadzwa avo vamunosarudza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "navamunoswededza pedyo kuti vagare pavanze dzenyu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "Takagutswa nezvinhu zvakanaka zveimba yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "zvetemberi yenyu tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munotipindura namabasa okururama anotyisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "imi Mwari Muponesi wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "tariro yemigumo yepasi pose",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "namakungwa ari kure kure,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyemi makaumba makomo nesimba renyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "makazvishongedza nesimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyemi makanyaradza kutinhira kwamakungwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "iko kutinhira kwamafungu aro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "nokupopota kwendudzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanogara kure kure vanotya zvishamiso zvenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "uko kunobuda mambakwedza uye madekwana achipera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "munodanidzira nziyo dzomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mune hanya nenyika uye munoidiridza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "munoipfumisa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "Hova dzaMwari dzizere nemvura",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "kuti dzivigire vanhu zviyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "nokuti saizvozvo ndimi makazvirayira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munozadza mihoronga yacho nemvura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "uye munoenzanisa mihomba yacho;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "munoinyorovesa nemvura inopfunha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "munoropafadza zvibereko zvayo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoshongedza gore nekorona yezvakawanda zvenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "uye ngoro dzenyu dzinopfachukira nezvakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uswa hwomurenje hwopfachukira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:12"
      },
      "items": [
        {
          "text": "zvikomo zvakafukidzwa nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuro azara namapoka emakwai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:13"
      },
      "items": [
        {
          "text": "uye mipata yafukidzwa nezviyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:13"
      },
      "items": [
        {
          "text": "zvinodanidzira nomufaro uye zvinoimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    }
  ],
