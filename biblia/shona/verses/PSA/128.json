            "number": "1",
            "style": "v",
            "sid": "PSA 128:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaropafadzwa vose vanotya Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:1"
      },
      "items": [
        {
          "text": "vanofamba munzira dzake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 128:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchadya chibereko chokushanda kwako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:2"
      },
      "items": [
        {
          "text": "maropafadzo nokubudirira zvichava zvako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 128:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi wako achava somuzambiringa unobereka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "pakati peimba yako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "vanakomana vako vachaita samabukira omuorivhi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:3"
      },
      "items": [
        {
          "text": "vakakomberedza tafura yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 128:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizvo zvakaita munhu akaropafadzwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:4"
      },
      "items": [
        {
          "text": "anotya Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 128:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ngaakuropafadzei kubva kuZioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "mazuva ose oupenyu hwenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:5"
      },
      "items": [
        {
          "text": "muone henyu kubudirira kweJerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
