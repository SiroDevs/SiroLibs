      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:6"
      },
      "items": [
        {
          "text": "Rugare ngaruve pana Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        }
