      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 102:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ngazvinyorerwe zvizvarwa zvamangwana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:18"
      },
      "items": [
        {
          "text": "kuti vanhu vasati vasikwa vagorumbidza Jehovha vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.18",
            "verseOrgIds": [
              "PSA.102.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 102:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha akatarira pasi ari panzvimbo yake tsvene yakakwirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:19"
      },
      "items": [
        {
          "text": "ari kudenga akacherechedza pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.19",
            "verseOrgIds": [
              "PSA.102.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 102:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti anzwe kugomera kwavasungwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.20",
            "verseOrgIds": [
              "PSA.102.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:20"
      },
      "items": [
        {
          "text": "agosunungura avo vakatongerwa rufu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.20",
            "verseOrgIds": [
              "PSA.102.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 102:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zita raJehovha richaparidzwa muZioni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.21",
            "verseOrgIds": [
              "PSA.102.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:21"
      },
      "items": [
        {
          "text": "nokurumbidzwa kwake muJerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.21",
            "verseOrgIds": [
              "PSA.102.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 102:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "panoungana marudzi noushe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.22",
            "verseOrgIds": [
              "PSA.102.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:22"
      },
      "items": [
        {
          "text": "kuti vanamate Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.22",
            "verseOrgIds": [
              "PSA.102.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 102:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva youpenyu hwangu akatapudza simba rangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:23"
      },
      "items": [
        {
          "text": "akaita kuti mazuva angu ave mashoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.23",
            "verseOrgIds": [
              "PSA.102.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 102:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:24"
      },
      "items": [
        {
          "text": "\"Regai kundibvisa, imi Mwari wangu, pakati pamazuva angu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:24"
      },
      "items": [
        {
          "text": "makore enyu anoramba aripo kusvikira kuzvizvarwa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.24",
            "verseOrgIds": [
              "PSA.102.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 102:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamavambo makateya nheyo dzenyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.25",
            "verseOrgIds": [
              "PSA.102.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:25"
      },
      "items": [
        {
          "text": "uye matenga ibasa basa ramaoko enyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.25",
            "verseOrgIds": [
              "PSA.102.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 102:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvo zvichaparara, asi imi munogara muripo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:26"
      },
      "items": [
        {
          "text": "zvose zvichasakara senguo. Senguo muchavabvisa uye vacharaswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.26",
            "verseOrgIds": [
              "PSA.102.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PSA 102:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi mucharamba makadaro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:27"
      },
      "items": [
        {
          "text": "uye makore enyu haatongogumi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.27",
            "verseOrgIds": [
              "PSA.102.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PSA 102:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana vavaranda venyu vachagara pamberi penyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 102:28"
      },
      "items": [
        {
          "text": "zvizvarwa zvavo zvichasimbiswa pamberi penyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.102.28",
            "verseOrgIds": [
              "PSA.102.29"
            ]
          }
        }
      ]
    }
