          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa murume",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
