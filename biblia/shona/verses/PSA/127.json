      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:4"
      },
      "items": [
        {
          "text": "ndizvo zvakaita vanakomana voujaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
