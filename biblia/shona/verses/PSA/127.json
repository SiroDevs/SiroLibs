          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Jehovha asingavaki imba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "vavaki vayo vanoshandira pasina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "Kana Jehovha asingachengeti guta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "varindi vanomira vakarinda pasina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 127:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvina maturo kumuka mangwanani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "nokunonoka kuvata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "uchitambudzikira zvokudya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "nokuti anopa hope kuna vaanoda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
