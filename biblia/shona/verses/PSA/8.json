          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makamuita muduku zvishoma pana Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:5"
      },
      "items": [
        {
          "text": "uye mukamushongedza korona yokubwinya nokukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
