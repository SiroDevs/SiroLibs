            "number": "2",
            "style": "v",
            "sid": "PSA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamiromo yavana navacheche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "makaisa rumbidzo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "nokuda kwavavengi venyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "kuti munyaradze muvengi nomutsivi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
