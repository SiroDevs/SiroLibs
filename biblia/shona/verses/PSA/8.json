    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba negititi. Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, Ishe wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "zita renyu rakaisvonaka sei panyika yose!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 8:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "Makaisa kubwinya kwenyu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "kudenga kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
