    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 143:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, inzwai munyengetero wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "ndinzwirei ngoni pakuchema kwangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "uyai mundisunungure nokutendeka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "uye nokururama kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 143:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musauyisa muranda wenyu mukutongwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:2"
      },
      "items": [
        {
          "text": "nokuti hakuna mupenyu akarurama pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 143:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvengi anondidzinganisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "anondirovera pasi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "anondiita kuti ndigare murima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "savaya vakafa kare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 143:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvo mweya wangu unoziya mukati mangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:4"
      },
      "items": [
        {
          "text": "mwoyo wangu unovhundutswa mukati mangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 143:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinorangarira mazuva akare kare;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "ndinofungisisa pamusoro pamabasa enyu ose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "uye ndinofunga zvakaitwa namaoko enyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 143:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinotambanudzira maoko angu kwamuri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:6"
      },
      "items": [
        {
          "text": "mweya wangu unokushuvai senyika yakaoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.143.6",
                "verseOrgIds": [
                  "PSA.143.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 143:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, kurumidzai kundipindura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "mweya wangu woziya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Regai kundivanzira chiso chenyu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "nokuti ndingazova savaya vakaburukira mugomba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 143:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani ngaandivigire shoko rorudo rwenyu rusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "nokuti ndinovimba nemi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Ndiratidzei nzira yandinofanira kufamba nayo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "nokuti ndinosimudzira mweya wangu kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 143:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinunurei kubva kuvavengi vangu, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:9"
      },
      "items": [
        {
          "text": "nokuti ndinozvivanza mamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 143:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzidzisei kuita kuda kwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "nokuti muri Mwari wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "mweya wenyu wakanaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "ngaunditungamirire panzira yakati chechetere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 143:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, chengetedzai upenyu hwangu nokuda kwezita renyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:11"
      },
      "items": [
        {
          "text": "ndibudisei panhamo, mukururama kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 143:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaradzai vavengi vangu, murudo rwenyu rusingaperi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "paradzai vavengi vangu vose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "nokuti ndiri muranda wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    }
