          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Israeri, isai tariro yenyu pana Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:3"
      },
      "items": [
        {
          "text": "kubva zvino nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
