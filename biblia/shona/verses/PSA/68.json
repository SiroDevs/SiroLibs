  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "68",
        "style": "c",
        "sid": "PSA 68"
      },
      "items": [
        {
          "text": "68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 68",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Mutungamiri mukuru wokuimba. Pisarema raDhavhidhi. Rwiyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 68:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari ngaasimuke, vavengi vake ngavaparadzirwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:1"
      },
      "items": [
        {
          "text": "vavengi vake ngavatize pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.1",
            "verseOrgIds": [
              "PSA.68.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 68:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokupeperetswa kunoitwa utsi nemhepo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "saizvozvo vapeperetsei;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "sokunyauka kunoita namo pamberi pomoto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:2"
      },
      "items": [
        {
          "text": "vakaipa ngavaparare pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.2",
            "verseOrgIds": [
              "PSA.68.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 68:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakarurama ngavafare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:3"
      },
      "items": [
        {
          "text": "vafarisise pamberi paMwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:3"
      },
      "items": [
        {
          "text": "ngavafare vapembere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.3",
            "verseOrgIds": [
              "PSA.68.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 68:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Mwari, imbirai zita rake nziyo dzokurumbidza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "murumbidzei zvikuru iye anofamba pamusoro pamakore,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "zita rake ndiJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:4"
      },
      "items": [
        {
          "text": "uye farai pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.4",
            "verseOrgIds": [
              "PSA.68.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 68:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba venherera, mudziviriri wechirikadzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:5"
      },
      "items": [
        {
          "text": "ndiye Mwari ari paugaro hwake utsvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.5",
            "verseOrgIds": [
              "PSA.68.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 68:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vari voga Mwari akavagarisa mumhuri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:6"
      },
      "items": [
        {
          "text": "anosesedza vasungwa vachiimba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:6"
      },
      "items": [
        {
          "text": "asi mhandu dzinogara panyika yatsva nezuva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.6",
            "verseOrgIds": [
              "PSA.68.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 68:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamakatungamirira vanhu venyu, imi Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:7"
      },
      "items": [
        {
          "text": "pamakafamba napakati perenje,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.7",
            "verseOrgIds": [
              "PSA.68.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.68.7",
                "verseOrgIds": [
                  "PSA.68.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 68:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyika yakazungunuka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "matenga akadurura mvura, pamberi paMwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "iye weSinai, pamberi paMwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:8"
      },
      "items": [
        {
          "text": "iye Mwari waIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.8",
            "verseOrgIds": [
              "PSA.68.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 68:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi Mwari, makanayisa mvura zhinji;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:9"
      },
      "items": [
        {
          "text": "mukaita kuti nhaka yenyu yakaneta ifefeterwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.9",
            "verseOrgIds": [
              "PSA.68.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 68:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu venyu vakagaramo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:10"
      },
      "items": [
        {
          "text": "uye imi Mwari, kubva pane, zvakawanda zvenyu, makariritira varombo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.10",
            "verseOrgIds": [
              "PSA.68.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 68:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe akataura shoko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:11"
      },
      "items": [
        {
          "text": "vanhu vakaparidza shoko vaiva vazhinji kwazvo:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.11",
            "verseOrgIds": [
              "PSA.68.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 68:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Madzimambo navarwi vakakurumidza kutiza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:12"
      },
      "items": [
        {
          "text": "mumisasa, vanhu vakagovana zvakapambwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.12",
            "verseOrgIds": [
              "PSA.68.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 68:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange pamunenge makavata pakati pemoto yemisasa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:13"
      },
      "items": [
        {
          "text": "mapapiro enjiva yangu akafukidzwa nesirivha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:13"
      },
      "items": [
        {
          "text": "minhenga yayo negoridhe rinovaima.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.13",
            "verseOrgIds": [
              "PSA.68.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 68:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamasimba Ose paakaparadzira madzimambo munyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 68:14"
      },
      "items": [
        {
          "text": "zvakanga zvakaita sechando chawira pamusoro peZarimoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.68.14",
            "verseOrgIds": [
              "PSA.68.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 68:15"
          },
          "items": [
            {
