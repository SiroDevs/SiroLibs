  "verseCount": 5,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "70",
        "style": "c",
        "sid": "PSA 70"
      },
      "items": [
        {
          "text": "70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi. Chikumbiro.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 70:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurumidzai kundiponesa, imi Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:1"
      },
      "items": [
        {
          "text": "Haiwa Jehovha kurumidzai kuuya mundibatsire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.1",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 70:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanotsvaka upenyu hwangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "ngavanyadziswe uye vakanganiswe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "vose vanofarira kuparara kwangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "ngavadzorwe shure vanyare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 70:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoti kwandiri, \"Hekani waro! Hekani waro!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "ngavadzorerwe shure nokuda kwenyadzi dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 70:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vose vanokutsvakai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "ngavafare nokufarisisa mamuri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "vanoda ruponeso rwenyu ngavagare vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "\"Mwari ngaakudzwe!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 70:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndiri murombo nomushayiwi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "uyai nokukurumidza kwandiri, imi Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Imi muri mubatsiri wangu nomurwiri wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Haiwa Jehovha, musanonoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    }
  ],
