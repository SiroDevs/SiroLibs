          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Jehovha rwiyo rutsva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "nokuti akaita zvinhu zvinoshamisa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "ruoko rwake rworudyi nechanza chake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:1"
      },
      "items": [
        {
          "text": "chitsvene zvakamukundisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 98:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akazivisa ruponeso rwake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:2"
      },
      "items": [
        {
          "text": "uye akaratidza kururama kwake kundudzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 98:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarangarira rudo rwake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "nokutendeka kwake kuimba yaIsraeri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "migumo yose yenyika yakaona",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:3"
      },
      "items": [
        {
          "text": "ruponeso rwaMwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.3",
            "verseOrgIds": [
              "PSA.98.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 98:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danidzirai nomufaro kuna Jehovha, imi nyika yose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:4"
      },
      "items": [
        {
          "text": "imbai nziyo mupembere nomufaro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.4",
            "verseOrgIds": [
              "PSA.98.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 98:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "imbirai Jehovha nembira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:5"
      },
      "items": [
        {
          "text": "nembira nenzwi rokuimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.5",
            "verseOrgIds": [
              "PSA.98.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 98:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nehwamanda nokurira kworunyanga rwegondobwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:6"
      },
      "items": [
        {
          "text": "danidzirai nomufaro pamberi paJehovha, iye Mambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.6",
            "verseOrgIds": [
              "PSA.98.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 98:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa ngaritinhire, nezvose zviri mariri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:7"
      },
      "items": [
        {
          "text": "nenyika, navose vanogaramo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.7",
            "verseOrgIds": [
              "PSA.98.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 98:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzizi ngadziuchire maoko adzo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:8"
      },
      "items": [
        {
          "text": "makomo ngaaimbe pamwe chete nomufaro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.8",
            "verseOrgIds": [
              "PSA.98.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 98:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngaaimbe pamberi paJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "nokuti anouya kuzotonga nyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "Achatonga nyika zvakarurama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 98:9"
      },
      "items": [
        {
          "text": "navanhu nokururamisira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.9",
            "verseOrgIds": [
              "PSA.98.9"
            ]
          }
        }
      ]
