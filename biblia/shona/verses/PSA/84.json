      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:12"
      },
      "items": [
        {
          "text": "akaropafadzwa munhu anovimba nemi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.12",
            "verseOrgIds": [
              "PSA.84.13"
            ]
          }
        }
