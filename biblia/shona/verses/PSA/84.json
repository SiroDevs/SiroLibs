          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha Wamasimba Ose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.12",
            "verseOrgIds": [
              "PSA.84.13"
            ]
          }
        }
      ]
    },
