  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waVasikana Gumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Panguva iyoyo umambo hwokudenga huchange hwakafanana navasikana gumi, vakatora mwenje yavo vakabuda kundochingamidza chikomba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vashanu vavo vakanga vari mapenzi uye vashanu vavo vakanga vakachenjera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapenzi vaya vakatora mwenje yavo asi havana kuisa mafuta mairi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vakachenjera vakatora mafuta mumidziyo pamwe chete nemwenje yavo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikomba chakanonoka kusvika, vose vakabatwa nehope ndokuvata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pava pakati pousiku vakanzwa mheremhere: 'Chikomba chauya! Budai mumuchingamidze!'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.6",
            "verseOrgIds": [
              "MAT.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo vasikana vose vakamuka uye vakagadziridza mwenje yavo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapenzi akati kuna vakachenjera, 'Tipeiwo mamwe emafuta enyu; mwenje yedu yava kudzima.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.8",
            "verseOrgIds": [
              "MAT.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vakapindura vakati, 'Kwete, zvimwe haangakwaniri isu nemi tose. Asi endai kuna vaya vanotengesa mafuta mugondozvitengera mamwe.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.9",
            "verseOrgIds": [
              "MAT.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi vachiri munzira kundotenga mafuta, chikomba chakasvika. Vasikana vakanga vakagadzirira vakapinda naye mumutambo wesvitsa uye musuo ukapfigwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.10",
            "verseOrgIds": [
              "MAT.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pashure vamwe vaya vakadzokawo. Vakati, 'Ishe! Ishe! Tizarurireiwo musuo!'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi akavapindura achiti, 'Ndinokuudzai chokwadi, handikuzivei.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.12",
            "verseOrgIds": [
              "MAT.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo garai makagadzirira nokuti hamuzivi musi kana nguva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mufananidzo waMatarenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvakare, zvichaita somurume akabuda kuti afambe rwendo, akadana varanda vake akavachengetesa pfuma yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuno mumwe akapa matarenda mashanu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "text": "emari, kuno mumwe matarenda maviri, uye kuno mumwe tarenda rimwe chete, mumwe nomumwe maererano nokugona kwake. Ipapo akaenda zvake parwendo rwake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume akapiwa matarenda mashanu akaenda pakarepo akandoshandisa mari yake akawanazve mamwe mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saizvozvo uya aiva namatarenda maviri akawana mamwe maviri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi murume akanga apiwa tarenda rimwe chete akaenda akandochera gomba muvhu ndokuviga mari yatenzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Shure kwenguva refu tenzi wavaranda vaya akadzoka akagadzirisa nezvemari idzi navo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume akanga apiwa matarenda mashanu akauya namamwe mashanu, akati, 'Tenzi, makandipa matarenda mashanu. Tarirai ndakawana mamwe mashanu.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tenzi wake akapindura akati, 'Waita zvakanaka iwe muranda akanaka, akatendeka! Wanga wakatendeka pazvinhu zvishoma; ndichakuita mutariri wezvinhu zvizhinji. Pinda mumufaro watenzi wako!'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Murume akanga apiwa matarenda maviri akauyawo. Akati, 'Tenzi makandipa matarenda maviri, tarirai ndakawanazve mamwe maviri.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tenzi wake akapindura akati, 'Waita zvakanaka, iwe muranda akanaka, akatendeka! Wanga wakatendeka pazvinhu zvishoma, ndichakuita mutariri wezvinhu zvizhinji. Pinda mumufaro watenzi wako!'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo murume akanga apiwa tarenda rimwe chete akauya, akati, 'Tenzi, ndakaziva kuti muri munhu akaoma, munokohwa pamusina kudyara uye munounganidza pamusina kukusha mbeu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro ndakatya ndikandocherera tarenda renyu muvhu. Tarirai, pfuma yenyu iyi.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tenzi wake akapindura akati, 'Iwe muranda akaipa, ano usimbe! Saka wakanga uchiziva zvako kuti ndinokohwa pandisina kudyara nokuunganidza pandisina kukusha mbeu?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ungadai wakachengetesa mari yangu kune vamabhangi kuitira kuti pakudzoka kwangu ndaizoiwana yabereka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mutorerei tarenda iri mupe kune uyo ane matarenda gumi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti wose anazvo achapiwa zvimwe, agova nezvakawanda kwazvo. Ani naani asina, kunyange nezvaanazvo achazvitorerwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye chikandai muranda uyo asingabatsiri kunze kurima, uko kuchava nokuchema nokurumanya kwameno.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makwai neMbudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana woMunhu paanouya nokubwinya kwake, navatumwa vose, achagara pachigaro chake choushe mukubwinya kwokudenga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzose dzichaunganidzwa pamberi pake, achatsaura vanhu mumwe kubva kuno mumwe somufudzi anotsaura makwai kubva kumbudzi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achaisa makwai kurudyi rwake, uye mbudzi kuruboshwe rwake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo Mambo achati kuna avo vari kurudyi rwake, 'Uyai imi makaropafadzwa naBaba vangu, mutore nhaka yenyu, umambo hwamakagadzirirwa kubva pakusikwa kwenyika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakanga ndine nzara mukandipa chokudya, ndakanga ndine nyota, mukandipa chokunwa, ndakanga ndiri mweni mukandipinza mumba,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakanga ndisina zvokupfeka mukandipfekedza, ndakanga ndichirwara mukandipepa, ndakanga ndiri mutorongo mukandishanyira.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo vakarurama vachamupindura vachiti, 'Ishe, takakuonai riniko mune nzara tikakupai chokunwa?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takakuonai riniko muri mweni tikakupinzai mumba, kana musina zvokupfeka tikakupfekedzai?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takakuonai riniko muchirwara kana muri mutorongo tikakushanyirai?'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
              "MAT.25.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mambo achapindura achiti, 'Ndinokuudzai chokwadi kuti, chose chamakaitira mumwe wavaduku vehama dzangu idzi, makachiitira ini.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo achati kune avo vari kuruboshwe rwake, 'Ibvai kwandiri imi makatukwa mupinde mumoto usingadzimi wakagadzirirwa dhiabhori navatumwa vake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakanga ndine nzara mukasandipa chokudya, ndakanga ndine nyota, mukasandipa chokunwa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakanga ndiri mweni mukasandipinza mumba, ndakanga ndisina zvokupfeka mukasandipfekedza, ndakanga ndichirwara uye ndiri mutorongo mukasandishanyira.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo vachapindura vachiti, 'Ishe, takakuonai riniko mune nzara kana mune nyota kana muri mweni kana musina zvokupfeka kana muchirwara kana muri mutorongo tikasakubatsirai?'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Achapindura achiti, 'Ndinokuudzai chokwadi kuti, zvose zvamusina kuitira mumwe wavaduku ava, hamuna kuzviitira ini.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo vachaenda mukurangwa kusingaperi, asi vakarurama vachipinda muupenyu husingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
        }
      ]
    }
  ],
