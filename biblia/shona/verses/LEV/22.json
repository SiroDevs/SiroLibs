  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "LEV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Udza Aroni navanakomana vake kuti varemekedze zvipiriso zvitsvene zvavaIsraeri zvavanditsaurira kuti varege kusvibisa zita rangu dzvene. Ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uti kwavari, 'Kuzvizvarwa zvichatevera, kana mumwe wezvizvarwa zvenyu asina kuchena akaswedera pedyo nezvinhu zvakatsaurirwa Jehovha navaIsraeri, munhu iyeye anofanira kubviswa pamberi pangu. Ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana chizvarwa chaAroni chikava nechirwere chamaperembudzi kana akava nezvinoyerera pamuviri wake, haangadyi zvipiriso zvitsvene kusvikira acheneswa. Achavawo asina kuchena kana akabata chimwe chinhu chakasvibiswa nechitunha kana nomumwe murume anobuda mbeu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana kuti akabata chose chinokambaira chingamusvibisa kana munhu upi zvake angamusvibisa, kungava kusachena kupi zvako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu uyo achabata kusachena uku achava asina kuchena kusvikira manheru. Haafaniri kudya zvipiriso zvipi zvazvo zvitsvene kusvikira ashamba nemvura.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zuva rovira, achava akachena, uye mushure maizvozvo angadya zvipiriso zvitsvene, nokuti ndizvo zvokudya zvake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haafaniri kudya chimwe chinhu chinowanikwa chakafa kana kuti chabvamburwa nemhuka dzesango, akazosvibiswa nayo. Ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Vaprista vanofanira kuchengeta zvandakarayira kuitira kuti vasava nemhosva uye vakazofa nokuda kwokuti vashora zvandakarayira. Ndini Jehovha anovaita vatsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Hakuna wokunze kwemhuri yomuprista angadya chipiriso chitsvene, kana mueni womuprista kana mushandi wake angachidya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana muprista akatenga nhapwa nemari, kana kuti nhapwa ikaberekerwa mumba make, nhapwa iyoyo inogona kudya chokudya chake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mwanasikana womuprista akawanikwa nomumwe munhu asiri muprista haagoni kudya chipi zvacho chezvitsvene zvinouyiswa kumuprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mwanasikana womuprista akava chirikadzi kana kuti akarambwa, iye asina vana, akadzoka kuzogara mumba mababa vake sapaudiki hwake, anogona kudya chokudya chababa vake. Asi munhu asina kukodzera haangadyi kudya uku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu upi zvake akadya chipiriso chitsvene nokusaziva, anofanira kudzorera kumuprista chipiriso ichi agowedzera chikamu chimwe chete muzvishanu pamusoro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista havafaniri kusvibisa zvipiriso zvitsvene zvinopiwa navaIsraeri kuna Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuvabvumira kudya zvipiriso zvitsvene nokudaro vakazviuyisira mhosva pamusoro pavo inoda muripo. Ndini Jehovha, anovaita vatsvene.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvibayiro zvisingagamuchirwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taura kuna Aroni navanakomana vake nokuvaIsraeri vose uti kwavari, 'Kana mumwe wenyu, angava muIsraeri kana mutorwa, anogara muIsraeri, akapa chipo kuti chive chipiriso chinopiswa kuna Jehovha, kungava kuzadzisa mhiko kana kungopawo chipo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "munofanira kupa mukono usina kuremara wemombe, kana gwai, kana mbudzi kuitira kuti zvigogamuchirwa panzvimbo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musauya nechinhu chipi zvacho chakaremara nokuti hachizogamuchirwi panzvimbo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akauyisa kubva mudanga remombe kana ramakwai chipiriso chokuwadzana kuna Jehovha achizadzisa kupika kwake kana kuti sechipo chokungopawo, chinofanira kuva chisina kuremara kana chisina gwapa kuti chigamuchirwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musapa kuna Jehovha zvakapofumara, zvakakuvara kana zvakaremara, kana chinhu chine mhezi kana chine maronda anopararira. Musaisa chipi zvacho chezvinhu izvi paaritari sechipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munogona kupa zvakadaro sechipo chokungopawo, nzombe kana gwai rakaremera kana zvine mitezo yakarebesa kana yakapfupikisa, asi hazvigamuchirwi pakuzadzisa mhiko.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamufaniri kupa kuna Jehovha chipiriso chemhuka ina manhu akakuvara, akatswanywa, akabvamburwa kana akachekwa. Hamufaniri kuita izvi munyika menyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye hamufaniri kugamuchira mhuka dzakadai kubva mumaoko omutorwa muchizodzipa sechokudya chaMwari wenyu. Hadzizogamuchirwi panzvimbo yenyu nokuti dzakaremara uye hadzina kukwana.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mhuru, kana gwai, kana mbudzi ikaberekwa, inofanira kugara namai vayo kwamazuva manomwe. Kubva pazuva rorusere zvichienda mberi, ichagamuchirwa sechipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musauraya mombe nomwana wayo kana gwai nomwana waro musi mumwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana muchibayira Jehovha chibayiro chokuvonga, chibayirei nenzira inoita kuti chigogamuchirwa panzvimbo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinofanira kudyiwa musi iwoyo, musasiya zvimwe zvacho kusvikira mangwana. Ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chengetai mirayiro yangu mugoitevera. Ndini Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
