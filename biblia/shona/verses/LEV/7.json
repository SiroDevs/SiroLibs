              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino iyi ndiyo mirayiro yezvipiriso zvinopiswa, chipiriso chezviyo, chipiriso chechivi, chipiriso chemhosva, chipiriso chokugadzwa nechipiriso chokuwadzana,",
          "type": "text",
