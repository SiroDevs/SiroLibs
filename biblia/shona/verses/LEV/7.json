            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiwo mugove wezvibayiro zvinoitirwa Jehovha nomoto zvakapiwa kuna Aroni navanakomana vake pazuva ravakagadzwa kuti vashumire Jehovha savaprista.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva ravakazodzwa, Jehovha akarayira kuti vaIsraeri vape izvi kwavari somugove wavanofanira kugara vachiwana kuzvizvarwa zvichatevera.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
    },
    {
