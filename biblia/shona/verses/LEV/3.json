        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvipiriso zvoKuwadzana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana chipiriso chomumwe chiri chokuwadzana, uye akapa chipfuwo, chichibva mudanga, chingava chikono kana chikadzi, anofanira kuuyisa pamberi paJehovha chipfuwo chisina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.1",
            "verseOrgIds": [
              "LEV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuisa ruoko rwake pamusoro pechibayiro chake agochibayira pamusuo weTende Rokusangana. Ipapo vanakomana vaAroni vaprista vachasasa ropa kumativi ose earitari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pachipiriso chokuwadzana anofanira kuuya nechipiriso chinoitwa nomoto kuna Jehovha, mafuta ose anofukidza ura, kana akabatana nahwo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "itsvo mbiri namafuta ari pamusoro padzo, pedyo napachiuno, nezvinofukidza chiropa, zvaachabvisa pamwe chete neitsvo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.4",
            "verseOrgIds": [
              "LEV.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vanakomana vaAroni vanofanira kuzvipisa paaritari pamusoro pechipiriso chinopiswa chinenge chichitsva pamoto, sechibayiro chinoitwa nomoto, chinonhuhwira zvinofadza kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.5",
            "verseOrgIds": [
              "LEV.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana achipa gwai sechipiriso chokuwadzana kuna Mwari anofanira kupa gono kana gadzi risina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana achipa gwayana, anofanira kuriuyisa pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuisa ruoko rwake pamusoro pechibayiro chake agochiuraya pamberi peTende Rokusangana. Ipapo vanakomana vaAroni vachasasa ropa paaritari kumativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pachipiriso chokuwadzana anofanira kuuya nechipiriso chinoitirwa Jehovha nomoto, mafuta acho, ose mafuta echimuswe chakakora chakadimurwa, nechapamusana, ose mafuta akafukidza ura neakabatana nahwo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "itsvo mbiri namafuta ari padziri pedyo nechiuno nezvakafukidza chiropa, achazvibvisa pamwe chete neitsvo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista achazvipisa paaritari sezvokudya, chipiriso chinoitwa kuna Mwari nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana chipiriso chake chiri mbudzi, anofanira kuipa kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuisa ruoko rwake pamusoro payo agoibayira pamberi peTende Rokusangana. Ipapo vanakomana vaAroni vachasasa ropa rayo paaritari kumativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.13",
            "verseOrgIds": [
              "LEV.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kune zvaanopa anofanira kupa kuna Jehovha chipiriso ichi chakaitwa nomoto, mafuta ose anofukidza zvose zvomukati kana zvakabatana nazvo,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "itsvo mbiri namafuta ari padziri pedyo nechiuno neakafukidza chiropa, zvichabviswa pamwe chete neitsvo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.15",
            "verseOrgIds": [
              "LEV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vachazvipisa paaritari sezvokudya, chipiriso chinoitwa nomoto, chinonhuhwira zvinofadza. Mafuta ose ndeaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Uyu murayiro usingaperi kumarudzi achatevera, kwose kwamuchagara: Hamufaniri kudya mafuta kana ropa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.17",
            "verseOrgIds": [
              "LEV.3.17"
            ]
          }
        }
      ]
    }
  ],
