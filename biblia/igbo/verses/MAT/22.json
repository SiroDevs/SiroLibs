{
  "id": "MAT.22",
  "number": "22",
  "bookId": "MAT",
  "reference": "Matiu 22",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "MAT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu banyere oriri ọlụlụ nwunye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs gwara ha okwu ọzọ nʼilu sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Alaeze eluigwe dị ka otu eze, nke kwadoro oke oriri ọlụlụ di na nwunye, nʼihi nwa ya nwoke.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.2",
                "verseOrgIds": [
                  "MAT.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "O zipụrụ ndị ohu ya ka ha gaa chetara ndị ahụ a kpọrọ ka ha bịa. Ma ha niile achọghị ịbịa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.3",
                "verseOrgIds": [
                  "MAT.22.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"O zipụkwara ndị ohu ya ọzọ na-ejere ya ozi ka ha gaa gwa ndị ahụ a kpọrọ oriri sị, 'E dozichaala ihe oriri ugbu a, egburu m oke ehi, na anụ ọzọ gbara abụba. Edoziela ihe niile. Bịanụ nʼoriri ọlụlụ di na nwunye.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.4",
                "verseOrgIds": [
                  "MAT.22.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ndị ahụ niile a kpọrọ oriri gawaara mkpa ha nʼihi na ha akpọghị ya ihe ọbụla. Otu onye gara nʼala ubi ya, nke ọzọ nʼụlọ ahịa ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.5",
                "verseOrgIds": [
                  "MAT.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị fọdụrụ jidere ndị ohu ya, mee ha ihe ihere ma gbukwaa ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.6",
                "verseOrgIds": [
                  "MAT.22.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye eze ahụ were iwe nke ukwuu, zipụ ndị agha ya ka ha gaa laa ndị ogbu mmadụ ahụ nʼiyi, rechapụkwa obodo ha nʼọkụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.7",
                "verseOrgIds": [
                  "MAT.22.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ ọ gwara ndị ohu ya sị, 'E doziela m oriri ọlụlụ di na nwunye, ma ndị a kpọrọ oku ekwesighị ekwesi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.8",
                "verseOrgIds": [
                  "MAT.22.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ugbu a, gaanụ nʼakụkụ ụzọ niile, kpọbatanụ ndị niile unu hụrụ, ka ha bịa nʼoriri ọlụlụ di na nwunye a.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.9",
                "verseOrgIds": [
                  "MAT.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị ohu ahụ pụrụ gaa nʼokporoụzọ niile kpọbata mmadụ niile ha hụrụ. Ha kpọbatara ndị bụ ezi mmadụ na ndị bụ ajọ mmadụ. Ụlọ oriri ahụ jupụtakwara na ndị a kpọrọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.10",
                "verseOrgIds": [
                  "MAT.22.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma mgbe eze ahụ batara ileta ndị niile nọ na nri, ọ hụrụ otu nwoke nke na-eyighị uwe ọlụlụ nwunye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.11",
                "verseOrgIds": [
                  "MAT.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ jụrụ ya ajụjụ sị, 'Enyi m, i si aṅaa bata nʼebe a mgbe ị na-eyighị uwe ọlụlụ di na nwunye?' O mechiri ọnụ ya nʼihi na o nweghị ihe ọ ga-asa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.12",
                "verseOrgIds": [
                  "MAT.22.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eze ahụ nyere ndị ozi ya iwu sị ha, 'Keenụ ya eriri, aka na ụkwụ, tụpụkwanụ ya nʼezi, nʼime ọchịchịrị, ebe ịkwa akwa na ịta ikikere eze ga-adị.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.13",
                "verseOrgIds": [
                  "MAT.22.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼihi na akpọrọ ọtụtụ mmadụ oku, maọbụ mmadụ ole na ole ka a họọrọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.14",
                "verseOrgIds": [
                  "MAT.22.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịtụ ụtụ nye Siza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ndị Farisii",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "text": "zukọtara na-achọ ụzọ ha ga-esi mee ka o kwuhie ọnụ ka ha site na ya jide ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zigara ndị na-eso ụzọ ha na ndị nʼotu Herọd ka ha jụọ ya sị, \"Onye ozizi, anyị maara nke ọma na ị bụ onye eziokwu, na ị na-ezikwa ụzọ Chineke nʼeziokwu. Ị dịghị asọkwa onye ọbụla anya, nʼihi na ị dịghị ele mmadụ anya nʼihu nʼagbanyeghị ndị ha bụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.16",
            "verseOrgIds": [
              "MAT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a gwa anyị, gịnị bụ uche gị? O ziri ezi nʼiwu ịtụ ụtụ nye Siza, ka ọ bụ na o zighị ezi?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.17",
            "verseOrgIds": [
              "MAT.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe Jisọs maara ihe ọjọọ ha bu nʼobi, ọ zara sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndị ihu abụọ! Gịnị mere unu ji anwa m ọnwụnwa?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.18",
                "verseOrgIds": [
                  "MAT.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gosinụ m ego e ji akwụ ụgwọ ụtụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.19",
                "verseOrgIds": [
                  "MAT.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Ha wetaara ya otu mkpụrụ ego.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.19",
            "verseOrgIds": [
              "MAT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ jụrụ ha ajụjụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.20",
            "verseOrgIds": [
              "MAT.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ka e sekwasịrị onyinyo ya nʼelu ego a? Aha onye kwa dị nʼokpuru onyinyo a?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.20",
                "verseOrgIds": [
                  "MAT.22.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara sị ya, \"Ọ bụ nke Siza.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:21"
      },
      "items": [
        {
          "text": "Mgbe ahụ ọ gwara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dị mma. Nyenụ Siza ihe ruuru Siza, ma nyekwanụ Chineke ihe niile bụ nke ruuru Chineke.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.21",
                "verseOrgIds": [
                  "MAT.22.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nụrụ nke a, ọ gbagwojuru ha anya, nʼihi ya, ha hapụrụ ya pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọlụlụ nwunye na mbilite nʼọnwụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ kwa, ụfọdụ ndị Sadusii, ndị na-asị na mbilite nʼọnwụ adịghị, bịakwutere ya ịghụ ya ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ozizi, \"Mosis kwuru sị, ọ bụrụ na nwoke ọbụla anwụọ na-amụtaghị nwa, nwanne ya nwoke ga-alụrụ nwanyị ahụ di ya nwụrụ, ka ọ mụtara nwanne ya nwoke ahụ nwụrụ anwụ nwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, e nwere ụmụnne nwoke asaa nʼetiti anyị. Onye nke mbụ lụrụ nwunye, nwụọ, ma ebe ọ dịghị ụmụ ọ mụtara, ọ hapụrụ nwanne ya nwunye ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka nke abụọ mekwara, ma nke atọ, ruo na nke asaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, nwanyị ahụ nʼonwe ya nwụkwara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, nʼoge mbilite nʼọnwụ, nwunye onye ka nwanyị a ga-abụ, ebe ọ bụ na ụmụnne nwoke asaa ndị a lụtụchara ya mgbe ọ nọ nʼụwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs zara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu na-ejehie ụzọ nʼihi na unu aghọtaghị ihe akwụkwọ nsọ na-ekwu. Unu aghọtakwaghị ụdị ike Chineke nwere.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.29",
                "verseOrgIds": [
                  "MAT.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na mbilite nʼọnwụ, ịlụ di na nwunye agaghị adịkwa, kama ha ga-adị ka ndị mmụọ ozi nʼeluigwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.30",
                "verseOrgIds": [
                  "MAT.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma nʼihe banyere mbilite nʼọnwụ nke ndị nwụrụ anwụ, ọ bụ na unu agụtabeghị ihe Chineke gwara unu sị,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.31",
                "verseOrgIds": [
                  "MAT.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mụ onwe m bụ Chineke nke Ebraham, Chineke nke Aịzik na Chineke nke Jekọb.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.32",
                "verseOrgIds": [
                  "MAT.22.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụghị Chineke nke ndị nwụrụ anwụ, kama ọ bụ nke ndị dị ndụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.32",
                "verseOrgIds": [
                  "MAT.22.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe igwe mmadụ ahụ nụrụ nke a, ozizi ya juru ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu kachasị mkpa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Farisii nụrụ na ọ emeela ka ndị Sadusii mechie ọnụ ha, ha gbakọtara otu ebe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu onye nʼime ha, bụ onye ozizi iwu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "text": "bịara jụọ ya ajụjụ iji nwaa ya:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ozizi, olee iwu nke kachasị mkpa nʼime iwu niile?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zara sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Hụ Onyenwe gị bụ Chineke gị nʼanya site nʼobi gị niile na site na mkpụrụobi gị niile, na site nʼuche gị niile.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.37",
                "verseOrgIds": [
                  "MAT.22.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nke a bụ iwu nke mbụ, bụrụkwa iwu kachasị iwu niile.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.38",
                "verseOrgIds": [
                  "MAT.22.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iwu ọzọ na-eso nke a nʼịdị mkpa bụ nke a, 'Hụ onye agbataobi gị nʼanya dị ka i si hụ onwe gị nʼanya.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.39",
                "verseOrgIds": [
                  "MAT.22.39"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iwu ndị ọzọ niile na ihe niile ndị amụma kwuru dabeere nʼebe iwu abụọ ndị a nọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.40",
                "verseOrgIds": [
                  "MAT.22.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajụjụ Jisọs jụrụ ndị Farisii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Farisii gbakọrọ nʼotu ebe, Jisọs jụrụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ka unu na-eche banyere Kraịst? Nwa onye ka ọ bụ?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.42",
                "verseOrgIds": [
                  "MAT.22.42"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 22:42"
      },
      "items": [
        {
          "text": "Ha zara sị ya, \"Ọ bụ nwa Devid.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị mekwaranụ Devid site na ntụziaka nke Mmụọ Nsọ jiri kpọọ ya 'Onyenwe m'? Nʼihi na ọ sịrị,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.43",
                "verseOrgIds": [
                  "MAT.22.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Onyenwe anyị gwara Onyenwe m sị ya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.22.44",
                "verseOrgIds": [
                  "MAT.22.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 22:44"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
