  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ agbọghọ iri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A ga-eji alaeze eluigwe tụnyere akụkọ ụmụ agbọghọ iri ndị weere oriọna ha pụta izute onye na-alụ nwunye ọhụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.1",
                "verseOrgIds": [
                  "MAT.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ise nʼime ha maara ihe, ma ise ndị ọzọ bụ ndị nzuzu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.2",
                "verseOrgIds": [
                  "MAT.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ise ndị nzuzu ahụ weere oriọna ha, ma ha ejighị mmanụ ọkụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.3",
                "verseOrgIds": [
                  "MAT.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ise ndị maara ihe, wụjuru mmanụ ọkụ na karama, tinyekwa oriọna ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.4",
                "verseOrgIds": [
                  "MAT.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe onye na-alụ nwunye ọhụrụ ahụ nọrọ ọdụ nʼọbịbịa ya, ụra tụwara ha, ha dinara ala rahụ ụra.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.5",
                "verseOrgIds": [
                  "MAT.25.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼetiti abalị e tiri mkpu nʼoke olu sị, 'Onye na-alụ nwunye ọhụrụ na-abịa, pụtanụ gaa zute ya!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.6",
                "verseOrgIds": [
                  "MAT.25.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ ụmụ agbọghọ niile ahụ",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.7",
                "verseOrgIds": [
                  "MAT.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "biliri mụnye oriọna ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.7",
                "verseOrgIds": [
                  "MAT.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ise ndị nzuzu ahụ rịọrọ ise ndị maara ihe sị, 'Biko, wụnyetụrụnụ anyị ụfọdụ nʼime mmanụ ọkụ unu, lee na oriọna anyị na-anyụ anyụ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.8",
                "verseOrgIds": [
                  "MAT.25.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndị maara ihe zara ha sị, 'Mba! Ọ gaghị ezuru anyị na unu. Kama gaanụ zuru nke unu nʼaka ndị na-ere ya.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.9",
                "verseOrgIds": [
                  "MAT.25.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma mgbe ha pụrụ ịzụta mmanụ ọkụ ahụ, onye na-alụ nwunye ọhụrụ bịarutere. Ndị jikeere ejikere soro ya banye nʼoriri ọlụlụ di na nwunye ahụ. E mechikwara ọnụ ụzọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.10",
                "verseOrgIds": [
                  "MAT.25.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Emesịa, ise ndị nzuzu ahụ",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.11",
                "verseOrgIds": [
                  "MAT.25.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "lọghachiri na-ekwu sị, 'Onyenwe anyị, Onyenwe anyị, meghere anyị ụzọ!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.11",
                "verseOrgIds": [
                  "MAT.25.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ọ zaghachiri ha sị, 'Nʼezie, nʼezie, agwa m unu, amaghị m ndị unu bụ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.12",
                "verseOrgIds": [
                  "MAT.25.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya mere, na-anọgidenụ na nche, nʼihi na unu amaghị ụbọchị ahụ, maọbụ oge awa ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.13",
                "verseOrgIds": [
                  "MAT.25.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ijizi akụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọzọ, ọ ga-adị ka otu nwoke chọrọ ịga njem. Ọ kpọkọtara ndị ohu ya niile nyefee ha akụnụba ya nʼaka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.14",
                "verseOrgIds": [
                  "MAT.25.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "O nyere onye nke mbụ talenti ise, nke abụọ ka o nyere talenti abụọ. O nyere onye nke ikpeazụ otu talenti.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.15",
                "verseOrgIds": [
                  "MAT.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "O nyere ha nʼotu nʼotu dị ka ike ha ha. Mgbe ahụ ọ hapụrụ ha gaa ije ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.15",
                "verseOrgIds": [
                  "MAT.25.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ahụ natara talenti ise weere ego ahụ malite ịzụ ahịa. Ngwangwa o retara talenti ise ọzọ nʼuru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.16",
                "verseOrgIds": [
                  "MAT.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Otu a kwa, onye nke e nyere talenti abụọ zụpụtakwara talenti abụọ ọzọ nʼuru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.17",
                "verseOrgIds": [
                  "MAT.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma onye ahụ natara otu talenti gara gwuo ala lie ego nna ya ukwu, nʼihi ichezi ya nke ọma.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.18",
                "verseOrgIds": [
                  "MAT.25.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ogologo oge gasịrị, nna ukwu ndị ohu ahụ lọtara site nʼije ya. Ọ kpọkọtara ha niile ka ha gụzie akụ ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.19",
                "verseOrgIds": [
                  "MAT.25.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ahụ natara talenti ise batara wetakwa ise ọzọ. Ọ gwara nna ya ukwu sị, 'Ị nyere m talenti ise, ma ugbu a azụpụtala m talenti ise ọzọ!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.20",
                "verseOrgIds": [
                  "MAT.25.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna ya ukwu sịrị ya, 'I mere nke ọma ezi ohu kwesiri ntụkwasị obi. I zipụtala na i kwesiri ntụkwasị obi nʼihe dị ntakịrị. Nʼihi ya aga m etinye gị nʼebe ị ga-elekọta ọtụtụ ihe. Bata nʼọṅụ nke nna gị ukwu.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.21",
                "verseOrgIds": [
                  "MAT.25.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye nke e nyere talenti abụọ bịara sị, 'Nna anyị ukwu, i nyere m talenti abụọ, ma lee, eritala m talenti abụọ ọzọ nʼuru.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.22",
                "verseOrgIds": [
                  "MAT.25.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna ya ukwu sịrị ya, 'I mere nke ọma. Ị bụ ezi ohu kwesiri ntụkwasị obi. I zipụtala na i kwesiri ntụkwasị obi nʼihe dị ntakịrị. Nʼihi ya aga m etinye gị nʼebe ị ga-elekọta ọtụtụ ihe. Bata nʼọṅụ nke nna gị ukwu.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.23",
                "verseOrgIds": [
                  "MAT.25.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye e nyere otu talenti batara sị, 'Nna anyị ukwu, amaara m onye ị bụ. Ị bụ onye aka ntagide. Ị na-ewe ihe ubi nʼebe ị na-akụghị mkpụrụ. Ị na-achịkọtakwa nʼebe ị na-agbasaghị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.24",
                "verseOrgIds": [
                  "MAT.25.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi nke a, atụrụ m egwu, a gara m liere gị ego talenti gị nʼala. Lee ihe gị werekwa.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.25",
                "verseOrgIds": [
                  "MAT.25.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna ya ukwu zara ya sị, 'Ohu ọjọọ na onye umengwụ. Ị maara na m na-ewe ihe ubi nʼebe m na-akụghị mkpụrụ, na-achịkọtakwa nʼebe m na-agbasaghị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.26",
                "verseOrgIds": [
                  "MAT.25.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ị gaara etinye ego m nʼaka ndị na-echekwa ego, ndị gaara akwụghachi ya na ọmụrụnwa ya, nke m gaara anata mgbe m lọghachiri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.27",
                "verseOrgIds": [
                  "MAT.25.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Napụtanụ ya talenti ahụ o ji, were ya nye onye ji talenti iri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.28",
                "verseOrgIds": [
                  "MAT.25.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na onye ọbụla nwere ka a ga e tinyekwuru ka o nwebigakwa oke. Ma onye ahụ ọ na-adịghị nke o nwere, a ga-anapụ ya ọ bụladị nke nta o nwere.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.29",
                "verseOrgIds": [
                  "MAT.25.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tụpụnụ ohu a na-abaghị uru nʼezi, nʼime ọchịchịrị, ebe ịkwa akwa na ịta ikikere eze ga-adị.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.30",
                "verseOrgIds": [
                  "MAT.25.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe nke ikpeazụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe Nwa nke Mmadụ ga-abịa nʼebube ya na ndị mmụọ ozi niile, mgbe ahụ ka ọ ga-anọ nʼelu ocheeze ebube ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.31",
                "verseOrgIds": [
                  "MAT.25.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mba niile nke ụwa ga-ezukọtakwa nʼihu ya. Ọ ga-ekewapụta ha, otu obodo site nʼibe ya, dị ka onye ọzụzụ atụrụ sị ekewapụta ụmụ atụrụ site nʼụmụ ewu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.32",
                "verseOrgIds": [
                  "MAT.25.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ ga-edebe ụmụ atụrụ ahụ nʼakụkụ aka nri ya, ma ụmụ ewu ga-anọ nʼaka ekpe ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.33",
                "verseOrgIds": [
                  "MAT.25.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ, eze ga-asị ndị nọ nʼaka nri ya, 'Batanụ nʼime alaeze, unu ndị Nna m gọziri agọzi, batanụ nʼime alaeze nke e doziiri unu site na mgbe e kere ụwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.34",
                "verseOrgIds": [
                  "MAT.25.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na mgbe agụụ gụrụ m unu nyere m nri. Mgbe akpịrị kpọrọ m nkụ unu nyere m ihe ọṅụṅụ. Mgbe m bụ ọbịa unu kpọbatara m.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.35",
                "verseOrgIds": [
                  "MAT.25.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe m gba ọtọ, unu zụtara uwe nye m. Mgbe m dara ọrịa unu lekọtara m. Anọkwara m nʼụlọ mkpọrọ unu bịara leta m.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.36",
                "verseOrgIds": [
                  "MAT.25.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ ndị ezi omume ahụ ga-ajụ ya sị, 'Onyenwe anyị, olee mgbe anyị hụrụ gị ka agụụ na-agụ gị anyị enye gị nri? Olee mgbe anyị hụrụ gị ka akpịrị na-akpọ gị nkụ, anyị ekuru mmiri ọṅụṅụ nye gị?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.37",
                "verseOrgIds": [
                  "MAT.25.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee mgbe kwa ka anyị hụrụ gị dị ka onye ọbịa anyị akpọbata gị? Olee mgbe kwa ka anyị hụrụ gị ka ị gba ọtọ anyị enye gị uwe?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.38",
                "verseOrgIds": [
                  "MAT.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee mgbe kwa ka anyị hụrụ gị nʼọrịa, maọbụ nʼụlọ mkpọrọ anyị abịa leta gị?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.39",
                "verseOrgIds": [
                  "MAT.25.39"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Eze ahụ ga-azaghachi ha sị, 'Nʼezie asị m unu, mgbe unu mesoro otu nʼime ndị a dị nta nʼime ụmụnne m omume ọma, ọ bụ m ka unu mesoro omume ahụ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.40",
                "verseOrgIds": [
                  "MAT.25.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ ọ ga-asịkwa ndị nọ nʼaka ekpe ya, 'Pụọnụ nʼihu m unu ndị a bụrụ ọnụ. Baanụ nʼime ọdọ ọkụ ebighị ebi ahụ a kwadobeere ekwensu na ndị mmụọ ozi ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.41",
                "verseOrgIds": [
                  "MAT.25.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na mgbe agụụ na-agụ m, unu enyeghị m ihe ọbụla ka m rie. Mgbe akpịrị na-akpọ m nkụ, unu ekunyeghị m mmiri ka m ṅụọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.42",
                "verseOrgIds": [
                  "MAT.25.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe m nọ dị ka ọbịa, unu akpọbataghị m nʼụlọ unu. Mgbe m gba ọtọ, unu enyeghị m uwe. Mgbe ahụ na-esighị m ike, unu elekọtaghị m. Mgbe m nọ nʼụlọ mkpọrọ, unu abịaghị leta m.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.43",
                "verseOrgIds": [
                  "MAT.25.43"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ ha ga-azakwa sị, 'Onyenwe anyị, olee mgbe anyị hụrụ gị ka agụụ na-agụ gị, maọbụ ka akpịrị na-akpọ gị nkụ, maọbụ oge ị bụ onye ọbịa, maọbụ oge ị gba ọtọ, maọbụ oge ị nọ nʼọrịa, maọbụ ị nọ nʼụlọ mkpọrọ, ma anyị elekọtaghị gị?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.44",
                "verseOrgIds": [
                  "MAT.25.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ ga-aza ha sị, 'Eziokwu ahụ bụ nke a, mgbe ahụ unu jụrụ inyere otu nʼime ndị a dị nta aka, ọ bụ m ka unu jụrụ i nyere aka.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.45",
                "verseOrgIds": [
                  "MAT.25.45"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndị a ga-aba nʼịta ahụhụ ebighị ebi. Ma ndị ezi omume ga-aba na ndụ ebighị ebi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.25.46",
                "verseOrgIds": [
                  "MAT.25.46"
                ]
              }
            }
          ]
        }
      ]
    }
