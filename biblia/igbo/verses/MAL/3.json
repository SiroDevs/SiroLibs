                "verseOrgIds": [
                  "MAL.3.16"
                ]
              }
            }
          ]
        },
        {
          "text": "gwarịtara ibe ha okwu,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
