  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EST 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eze asọpụrụ Mọdekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ahụ, ụra abịaghị eze nʼanya ma ọlị. Nʼihi ya, o metụrụ ya nʼobi ịgụ akwụkwọ ihe ncheta. Ya mere, o nyere iwu ka e wetara ya akwụkwọ a na-edekọta ihe niile e mere nʼoge ọchịchị ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.1",
            "verseOrgIds": [
              "EST.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ya, ọ gụtara ihe e dere banyere Mọdekai, otu o si kpughee izuzu ọjọọ Bigtan na Teresh, ndị onozi eze na-eche nche nʼọnụ ụzọ ụlọeze, gbara igbu eze Sekses.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ eze jụrụ ajụjụ sị, \"Gịnị bụ ihe ọma e meerela Mọdekai nʼihi ihe a o mere?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:3"
      },
      "items": [
        {
          "text": "Ndị ozi ya zara, \"O nwebeghị ihe ọbụla e meere ya!\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze sịrị, \"Onye nọ nʼogige?\" Ma Heman ka batachara na mbata ogige ụlọeze, ịgwa eze banyere mkwugbu Mọdekai nʼelu osisi nke o guzobere nʼihi ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.4",
            "verseOrgIds": [
              "EST.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-ejere ya ozi zara, \"Heman na-eguzo nʼogige.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:5"
      },
      "items": [
        {
          "text": "Eze sịrị, \"Kpọbata ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Heman batara, eze jụrụ ya ajụjụ sị, \"Gịnị bụ ugwu m kwesiri inye onye mere ihe na-atọ m ụtọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:6"
      },
      "items": [
        {
          "text": "Heman chere nʼime onwe ya sị, \"Oleekwanụ onye ọzọ eze ga-achọ inye ugwu karịa mụ onwe m?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere ọ zara eze, \"Banyere nwoke ahụ ọ masịrị eze ịkwanyere ugwu,",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.7",
            "verseOrgIds": [
              "EST.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nye iwu ka e wepụta uwe gị, nke gị bụ eze yitụrụla, na ịnyịnya gị, nke eze gbaarala, nke e kpukwasịrị oyiyi okpueze nʼisi ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka enye uwe ahụ na ịnyịnya ahụ nʼaka otu onye kachasị nwee ugwu nʼime ụmụ eze, ka ha yikwasị nwoke ahụ nke eze chọrọ ịsọpụrụ uwe ahụ, ka ịnyịnya buru ya dịka ha dọkpụ ya na-ejegharị nʼokporoụzọ niile nʼobodo, na-ekwusa nʼihu ya na-asị, 'Otu a ka a na-emere nwoke ahụ ọ masịrị eze inye nsọpụrụ!' \"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ eze nyere Heman iwu, sị; \"Ahaa! Ntụpụta gị dị mma nke ukwuu! Mee ngwangwa, were uwe ndị a, na ịnyịnya m, meekwara Mọdekai onye Juu ahụ na-anọdụ nʼọnụ ụzọ ama ụlọeze ihe niile ndị a i kwuru. Hụkwa na i mechasịrị ihe ndị a niile i kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Heman chịịrị uwe eze ahụ yikwasị ya Mọdekai nʼahụ. O mekwara ka ọ nọdụ nʼelu ịnyịnya eze. Emesịa, o duuru ya jegharịa nʼakụkụ obodo ahụ niile na-eti mkpu na-asị, \"Otu a ka eze ga-esi sọpụrụ nwoke ahụ ihe ya dị ya mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Mọdekai lọghachiri nʼọnụ ụzọ ama eze. Ma Heman mere ngwangwa laa nʼụlọ ya, kpuchiekwa isi ya nʼiru ụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ kọọrọ Zeresh nwunye ya, na ndị enyi ya niile ihe niile nke mere ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:13"
      },
      "items": [
        {
          "text": "Ndị ndụmọdụ ya na nwunye ya Zeresh sịrị ya, \"Ebe ọ bụ na Mọdekai, onye ị bidoro ịda nʼihu ya, bụ onye Juu, ị gaghị enwe ike emegide ya, ị ghaghị ịla nʼiyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na ya nọ na-akparịta ụka, ndị onozi eze bịaruru duru Heman ngwangwa maka ịga nʼoriri ahụ Esta kwadoro.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
    }
  ],
