  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1CO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl mere onwe ya ihe ịmaatụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụghị m onye nwe onwe ya? Abụghị m onyeozi Kraịst? Ọ bụ na m ahụghị Jisọs Onyenwe anyị? Unu abụghị ihe ngosipụta ọrụ m rụrụ nʼime Onyenwe anyị?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.1",
            "verseOrgIds": [
              "1CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m abụghị onyeozi nʼebe ndị ọzọ nọ, nʼebe unu nọ, abụ m onyeozi nʼeziokwu nʼihi na unu bụ akara nke ọrụ onyeozi m nʼime Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ngọpụ m nye ndị ahụ na-enyocha m bụ nke a.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.3",
            "verseOrgIds": [
              "1CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na anyị enweghị ike iri ihe oriri na ịṅụ ihe ọṅụṅụ?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.4",
            "verseOrgIds": [
              "1CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na anyị enweghị ike iduru nwunye onye bụ onye kwere ekwe gaa ebe ọbụla anyị na-aga dịka ndị ozi ọzọ na-eme, na dịka ụmụnne Onyenwe anyị na Sefas na-emekwa?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.5",
            "verseOrgIds": [
              "1CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ naanị mụ na Banabas bụ ndị na-enweghị ike ịhapụ ịrụ ọrụ maka ihe anyị ga na-eri?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.6",
            "verseOrgIds": [
              "1CO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee onye agha unu maara nke na-esi nʼakpa ya akwụ onwe ya ụgwọ ọnwa? Ka ọ dị onye ọrụ ubi vaịnị unu maara nke na-adịghị eri mkpụrụ e si nʼubi ahụ weta? Olee onye ọzụzụ atụrụ unu maara nke na-adịghị aṅụ mmiri ara e si nʼigwe atụrụ ọ na-azụ apịpụta?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaghị m ekwu ihe a nʼihi na ha bụ ihe na-eme ụbọchị niile nʼetiti ndị mmadụ? Akwụkwọ iwu, o kwukwaghị otu ihe ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.8",
            "verseOrgIds": [
              "1CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e dere ya nʼiwu nke Mosis, \"Ekechila ọnụ ehi mgbe ọ na-azọcha mkpụrụ ọka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "text": "Unu chere na ọ bụ naanị ehi ka Chineke bu nʼobi kwuo okwu a?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, nʼihi anyị ka eji dee ya nʼakwụkwọ. Nʼezie, e dere ihe ndị a nʼihi anyị, nʼihi na onye rụrụ ọrụ nʼubi na onye na-azọcha mkpụrụ dị nʼubi ahụ, na-eme nke a nʼolileanya na o kwesiri iketa oke site na mkpụrụ e si nʼubi ahụ weta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.10",
            "verseOrgIds": [
              "1CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụ anyị kụrụ nʼime obi unu bụ mkpụrụ nke mmụọ. Ọ ga-abụ ihe ọjọọ ma anyị sị unu nyetụ anyị ụfọdụ nʼime akụnụba unu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.11",
            "verseOrgIds": [
              "1CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ndị ọzọ kwesiri iketa uru dị otu a nʼahụ unu, ọ bụ na anyị ekwesighị iketa karịa?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 9:12"
      },
      "items": [
        {
          "text": "Ma ọ dịbeghị mgbe anyị rịọrọ unu ihe ọbụla, kama anyị na-agbalịsị ike ịhụ na ọ dịghị ihe ga-egbochi unu iji ezi obi na-ege ntị nʼoziọma Kraịst nke anyị wetara.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na unu amataghị na ndị na-arụ ọrụ nʼụlọnsọ ukwu na-esi nʼụlọnsọ ahụ na-eweta ihe ha na-eri? Ndị na-agbakwa odibo nʼebe ịchụ aja na-eketakwa oke nʼihe eji chụọ aja?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.13",
            "verseOrgIds": [
              "1CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu aka ahụ kwa, Onyenwe anyị ekwuola na ndị niile na-ekwusa oziọma ya ga-esi nʼoziọma eweta nri ha ga-eri dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.14",
            "verseOrgIds": [
              "1CO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o nweghị mgbe m jirila ike ndị a m nwere irite uru nʼọrụ m nara ndị mmadụ ihe. Anaghị m ede nke a nʼakwụkwọ ka a na-ebutere m ihe onyinye. Nʼihi na ọ kaara m mma ka m nwụọ kama m ga-ekwe ka onye ọbụla mee ka ịnya isi m bụrụ ihe efu nʼihi ihe onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.15",
            "verseOrgIds": [
              "1CO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaghị anya isi nʼihi na ana m ezisa oziọma, maka na nke ahụ bụ ọrụ e nyere m nʼiwu ka m rụọ. Ahụhụ dịịrị m ma ọ bụrụ na m ezisaghị oziọma.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.16",
            "verseOrgIds": [
              "1CO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sị na m ji aka m họpụta onwe m ịrụ ọrụ a, agaara m enwe ụgwọ ọrụ, ma na ọ bụrụ na o sighị nʼuche aka m, unu mara na-ahanyere m ya nʼaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.17",
            "verseOrgIds": [
              "1CO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị bụ ụgwọ ọrụ m? Ụgwọ ọrụ m bụ ọṅụ m na-enwe site nʼizisa oziọma a, na-anaghị onye ọbụla ụgwọ ọrụ ọbụla, maọbụ ihe ruru m dịka onye na-ezisa oziọma ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.18",
            "verseOrgIds": [
              "1CO.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl ji inwe onwe ya jee ozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na-abụghị m ohu onye ọbụla, ma emeela m onwe m ohu nye mmadụ niile ka m nwee ike site nʼụzọ dị otu a rite ọtụtụ mkpụrụobi nʼuru nye Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.19",
            "verseOrgIds": [
              "1CO.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ndị Juu nọọ, ana m eme dịka onye Juu, ka m nwee ike rite ndị Juu nʼuru. Nʼetiti ndị nọ nʼokpuru iwu, ana m emekwa dịka otu nʼime ndị nọ nʼokpuru iwu (nʼagbanyeghị na mụ onwe m anọghị nʼokpuru iwu), ka m si otu a nwee ike rite ndị nọ nʼokpuru iwu nʼuru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.20",
            "verseOrgIds": [
              "1CO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ndị na-anọghị nʼokpuru iwu nọ, emere m onwe m ka onye na-anọghị nʼokpuru iwu (ma nke a apụtaghị na m na-akwụsị ime ihe iwu Chineke na-achọ. Ana m emekwa dịka onye nọ nʼokpuru iwu Kraịst), ka m nwee ike rite ndị na-anọghị nʼokpuru iwu nʼuru.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.21",
            "verseOrgIds": [
              "1CO.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ndị na-adịghị ike nọ, ana m emekwa dịka ha, ka m nwee ike rite ndị na-adịghị ike nʼuru. Otu ọbụla mmadụ si dịrị, ana m agbalị chọọ ụzọ m ga-esi mee ka ọ nabata m, ka m nwee ike site nʼụzọ niile ọbụla zọpụta ụfọdụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.22",
            "verseOrgIds": [
              "1CO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m eme ihe ndị a niile nʼihi oziọma, ma ka m nwekwa ike keta oke na ngọzị ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.23",
            "verseOrgIds": [
              "1CO.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpa ọ dị mmadụ ịkwanyere onwe ya ugwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu amataghị na mgbe ọtụtụ mmadụ na-agba ọsọ ịsọ mpi, ọ bụ naanị otu onye na-enwe ihe onyinye nke mbụ? Ya mere, gbasienụ ọsọ ike, ka unu nweta onyinye ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.24",
            "verseOrgIds": [
              "1CO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-ejikere ịgba ọsọ maọbụ egwuregwu ọzọ na-enwe ntachiobi nʼọtụtụ ahụhụ nke ya na ọzụzụ so. Ha na-azụ onwe ha naanị ka ha nweta okpueze okoko osisi na-emebi emebi. Ma ọsọ anyị na-agba bụ ka anyị nweta okpueze nke na-apụghị imebi emebi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.25",
            "verseOrgIds": [
              "1CO.9.25"
            ]
          }
        },
        {
