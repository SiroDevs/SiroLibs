            }
          ]
        },
        {
          "text": "dịka onye Nazirait. Onyinye onye ahụ ga-enye ga-abụ dịka nkwa ido nsọ ya si dị, tinyere ihe ndị ọzọ ha nwere ike inye. Onye dị otu a aghaghị imezu nkwa ọbụla o kwere dịka iwu metụtara onye Nazirait si dị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
