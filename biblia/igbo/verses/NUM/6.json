              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nke a bụ iwu dịrị onye ọ bụla kpebiri ikewapụ onwe ya nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
