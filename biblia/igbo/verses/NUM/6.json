    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye Nazirait",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.1",
                "verseOrgIds": [
                  "NUM.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.1",
            "verseOrgIds": [
              "NUM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ndị Izrel sị ha, \"Mgbe nwoke maọbụ nwanyị ṅụrụ iyi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "text": "o ji kpebie ikwe nkwa pụrụ iche nke ikewapụ onwe ya nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.2",
                "verseOrgIds": [
                  "NUM.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka onye Nazirait,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha ga-ekewapụ onwe ha site na ịṅụ mmanya, maọbụ detụ ihe ọṅụṅụ ọbụla na-aba nʼanya ire. Ha agaghị aṅụ mmiri mkpụrụ vaịnị, ọ gaghị ata mkpụrụ vaịnị ọhụrụ maọbụ nke a mịkpọrọ amịkpọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oge ahụ niile ọ bụ onye Nazirait,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "text": "ọ gaghị eri ihe ọbụla sitere na mkpụrụ osisi vaịnị maọbụ mkpụrụ ya maọbụ okpokoro azụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼime oge niile nke imezu nkwa ikewapụ onwe ya nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.5",
                "verseOrgIds": [
                  "NUM.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", agụba agaghị agabiga ya nʼisi. Ọ ga-anọgide bụrụ onye dị nsọ tutu ruo oge nkwa ikewapụ onwe ya nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.5",
                "verseOrgIds": [
                  "NUM.6.5"
                ]
              }
            }
          ]
        },
        {
          "text": "zuru. Nʼihi nke a, ọ ga-ahapụ agịrị isi ya ka o too.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼime oge niile nke imezu nkwa ikewapụ onwe ya nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.6",
                "verseOrgIds": [
                  "NUM.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ gaghị aga nso mmadụ ọbụla nwụrụ anwụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụladị na nna ya, maọbụ nne ya, maọbụ nwanne ya nwoke, maọbụ nwanne ya nwanyị anwụọ. Ọ gaghị emerụ onwe ya nʼihi ha, nʼihi na akara ikewapụ onwe ya iche nye Chineke dị ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge niile nke ikewapụ onwe ya, onye e doro nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.8",
                "verseOrgIds": [
                  "NUM.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na mmadụ anwụọ na mberede nʼakụkụ onye nazirait, si otu a merụọ agịrị isi ya nke na-egosi ido nsọ ya, ọ ghaghị ịkpacha isi ya nʼụbọchị nke asaa bụ ụbọchị ime ka ọ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke ọzọ ya, bụ nʼụbọchị nke asatọ. Ọ ghaghị iwetara onye nchụaja nduru abụọ maọbụ ụmụ kpalakwukwu abụọ, nʼọnụ ụzọ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ ga-ewere otu nʼime ha chụọrọ ya aja mmehie. Ọ ga-ewerekwa nnụnụ nke ọzọ chụọrọ ya aja nsure ọkụ maka ikpuchiri onye ahụ nwere akara ido nsọ mmehie ya, bụ nke o mere site nʼịnọ onye nwụrụ anwụ nso. Ọ ga-edokwa isi ya nsọ ọzọ nʼụbọchị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ekewapụ onwe ya nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.12",
                "verseOrgIds": [
                  "NUM.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka o mere na mmalite ụbọchị niile nke ido nsọ ya. Wetakwa otu nwa ebule gbara otu afọ maka aja ikpe ọmụma. A gaghị agụnyere ya ụbọchị ndị ahụ niile gafere tupu o merụọ onwe ya, nʼihi na o merụrụ onwe ya mgbe ọ nọ ọnọdụ imezu nkwa nkewapụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nke a bụ iwu dịrị onye Nazirait mgbe oge ido onwe ya nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.13",
                "verseOrgIds": [
                  "NUM.6.13"
                ]
              }
            }
          ]
        },
        {
          "text": "zuru. A ga-eduru ya bịa nʼọnụ ụzọ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka ọ ga-anọ chee onyinye ya ndị a nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.14",
                "verseOrgIds": [
                  "NUM.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": ": nwa ebule na-enweghị ntụpọ, gbara otu afọ, maka aja nsure ọkụ na otu nwa nne atụrụ na-enweghị ntụpọ gbara otu afọ maka aja mmehie, na otu ebule ahụ zuruoke maka aja udo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinyere aja mkpụrụ ọka, na aja ihe ọṅụṅụ na otu nkata achịcha a na-ejighị ihe na-eko achịcha mee, na achịcha e ji ezi ụtụ ọka a gwara mmanụ oliv mee, na achịcha mbadamba na-ekoghị eko nke e tere mmanụ oliv.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye nchụaja ahụ ga-eche ihe aja ndị a niile nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.16",
                "verseOrgIds": [
                  "NUM.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", chụọ aja mmehie na aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji nwa ebule ahụ chụọ aja udo nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.17",
                "verseOrgIds": [
                  "NUM.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya na nkata achịcha na-ekoghị eko ahụ. Ọ ga-achụkwa aja mkpụrụ ọka, na aja ihe ọṅụṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ahụ, onye ahụ doro onwe ya nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.18",
                "verseOrgIds": [
                  "NUM.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-akpụchapụ agịrị isi ya nke bụ ihe na-egosi ido nsọ ya. Ọ ga-eme nke a na mbata ọnụ ụzọ ụlọ nzute ahụ. Emesịa, ọ ga-etinye agịrị isi ahụ ọ kpụchapụtara nʼọkụ ahụ dị nʼokpuru aja udo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe a kpụchasịrị onye ahụ agịrị isi ya, nke na-egosi ido nsọ ya, onye nchụaja ga-ewere ubu aka ebule ahụ e sịrị esi, otu ogbe achịcha na-ekoghị eko na otu mbadamba achịcha na-ekoghị eko site na nkata ahụ, tinye ha niile nʼaka onye ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ nʼoge a, ga-ewere aja ndị a fufee ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.20",
                "verseOrgIds": [
                  "NUM.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka aja mfufe. Ha niile ga-abụ ihe nsọ nye onye nchụaja ahụ, tinyere obi anụ ahụ e fufere efufe, na apata anụ ahụ e chere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.6.20",
                "verseOrgIds": [
                  "NUM.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". Mgbe nke a gasịrị, onye ahụ doro onwe ya nsọ nwere onwe ya ịṅụ mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
