  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "NUM 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obodo ndị Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, mgbe ndị Izrel ka nọ nʼakụkụ osimiri Jọdan nʼobosara ala Moab, na ncherita ihu Jeriko, ka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.1",
                "verseOrgIds": [
                  "NUM.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nye ndị Izrel iwu ka ha nye ndị Livayị ụfọdụ obodo ebe ha ga-ebi. Obodo ndị a ga-abụ ndị si nʼihe nketa ndị Izrel ketara. Nyekwa ha ala ebe anụ ụlọ ha ga-anọ na-akpa nri, nke ga-agba obodo ndị a gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.2",
            "verseOrgIds": [
              "NUM.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a ga-abụrụ ha ebe obibi, ma ala niile gbara ha gburugburu ga-abụ ebe ịta nri nke igwe ehi na atụrụ, na anụ ụlọ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.3",
            "verseOrgIds": [
              "NUM.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ala ebe ịta nri nke obodo niile nke unu ga-enye ndị Livayị ga-adị narị mita anọ na ọkara nʼogologo site na mgbidi obodo ga gburugburu mgbidi obodo ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.4",
            "verseOrgIds": [
              "NUM.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere nʼobodo ndị Livayị ọbụla, ala ịzụ anụ ụlọ ga-adị narị mita anọ na ọkara site na mgbidi ha ruo nʼoke ala ha. Ọ ga-adị narị mita anọ na ọkara nʼakụkụ ọwụwa anyanwụ, narị mita anọ na ọkara nʼakụkụ ọdịda anyanwụ, narị mita anọ na ọkara nʼakụkụ ugwu, narị mita anọ na ọkara nʼakụkụ ndịda. Obodo ha ga-adịkwa nʼetiti ala ịzụ anụ ụlọ ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.5",
            "verseOrgIds": [
              "NUM.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obodo mgbaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Obodo isii nʼime obodo ndị ahụ unu na-enye ndị Livayị ga-abụ obodo mgbaba, ebe onye ọbụla gburu mmadụ na-amaghị ama nwere ike gbaga izere ndụ ya. Tinyere obodo ndị a unu ga-enyekwasị ha iri obodo anọ na abụọ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.6",
            "verseOrgIds": [
              "NUM.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere obodo niile a ga-enye ndị Livayị ga-adị iri obodo anọ na asatọ, tinyere obosara ala ịzụ igwe ewu na atụrụ nke gbara obodo ndị a gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.7",
            "verseOrgIds": [
              "NUM.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo unu na-enye ndị Livayị site nʼihe nketa ndị Izrel ga-abụ dịka unu si keta oke unu. A ga-esite nʼaka ebo nwere ọtụtụ obodo wepụta ọtụtụ obodo, ma site nʼaka ebo obodo ha nwere na-ehighị nne wepụta ole na ole.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.8",
            "verseOrgIds": [
              "NUM.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.9",
                "verseOrgIds": [
                  "NUM.35.9"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ndị Izrel sị ha, 'mgbe unu gafere Jọdan banye nʼala Kenan,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "họpụtanụ ụfọdụ obodo ka ọ bụrụ obodo mgbaba ebe mmadụ nwere ike ịgbabanye ma ọ bụrụ na o gbuo mmadụ na-amaghị ama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a ga-abụ ebe mgbaba nye onye na-ezere ndụ site nʼaka onye ahụ chọrọ ịbọrọ ọbọ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        },
        {
          "text": "ka a ghara igbu onye e boro ebubo igbu mmadụ tutu ruo mgbe e buru ụzọ kpee ya ikpe nʼihu ọgbakọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo isii ndị a unu wepụtara ga-abụ obodo mgbaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.13",
            "verseOrgIds": [
              "NUM.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Họpụta obodo mgbaba atọ nʼakụkụ ọzọ nke Jọdan. Ka atọ ndị ọzọ dịrị na Kenan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a agaghị abụ ebe izere ndụ maka naanị ndị Izrel, kama ọ dịkwara ndị ọbịa na ndị ọzọ bi nʼetiti unu, ka onye na-akpachaghị anya gbuo mmadụ gbaga ebe ahụ izere ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na mmadụ e jiri mkpirisi igwe tigbuo mmadụ ibe ya, a ga-agụ onye dị otu a dịka ogbu mmadụ. A ga-egbukwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwa na mmadụ ejide nʼaka ya nkume nke o nwere ike iji tugbuo mmadụ, ọ bụrụ na ọ tụọ mmadụ nkume ahụ tugbuo ya, ọ bụ ogbu mmadụ. Ogbu mmadụ ahụ aghakwaghị ịnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.17",
            "verseOrgIds": [
              "NUM.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sikwa na mmadụ ji ihe e ji osisi tụọ nʼaka ya, nke o nwere ike i ji tigbuo mmadụ, ọ bụrụ na o tie mmadụ ihe osisi ahụ, tigbuo ya, ọ bụ ogbu mmadụ. A ghaghị ime ka ogbu mmadụ ahụ nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-abọ ọbọ ọbara ga-egbu ogbu mmadụ ahụ nʼonwe ya mgbe ọbụla o zutere ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na mmadụ esite nʼekworo nuo onye ọzọ aka, maọbụ kpachara anya tụọ onye ahụ ihe nke mere ka ọ nwụọ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.20",
            "verseOrgIds": [
              "NUM.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ na o sitere nʼobi ọnụma jiri aka ya tie mmadụ ihe nke mere ka ọ nwụọ, a ga-egbu onye ahụ, nʼihi na ogbu mmadụ ka ọ bụ. Onye na-agwachite ọchụ ga-egbu ogbu mmadụ ahụ mgbe ọbụla o zutere ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ọ bụrụ na mmadụ ebughị iro nʼobi nutuo mmadụ ibe ya na mberede, maọbụ tụọ ya ihe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ tụtuo nkume nke datara dagbuo mmadụ ibe ya mgbe ọ na-ahụghị ya, bụ onye na-abụghị onye iro ya, onye ọ na-ebughị nʼobi imejọ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, ndị ọgbakọ ga-ekpe ikpe nʼetiti onye e boro ebubo na onye na-agwachite ọchụ dịka usoro iwu ndị a si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzukọ aghaghị ichekwa onye e boro ebubo na o gburu mmadụ site nʼaka onye na-agwachite ọchụ, zilaga onye ahụ e boro ebubo nʼobodo mgbaba, bụ ebe ha gbalagara. Onye ahụ e boro ebubo ga-anọgide nʼobodo mgbaba ahụ tutu ruo mgbe onyeisi nchụaja nwụrụ, bụ onye ahụ e tere mmanụ nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ọ bụrụ na ogbu mmadụ a ahapụ obodo mgbaba ahụ pụọ, ọ bụrụkwa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na onye ahụ na-abọ ọbọ ọbara achọta ya nʼazụ obodo mgbaba ahụ, o nwere ike igbu onye ahụ e boro ebubo, ikpe igbu mmadụ agaghị ama ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ e boro ebubo na o gburu mmadụ aghaghị ịnọ nʼime obodo mgbaba ahụ tutu ruo mgbe onyeisi nchụaja nwụrụ. Ọ bụ naanị mgbe onyeisi nchụaja nwụchara, ka ha nwere ike ịlaghachi nʼụlọ ya, nʼihe nketa ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndị a bụ usoro iwu ga-adịgide nye unu site nʼọgbọ ruo nʼọgbọ, nʼebe obibi unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye ọbụla gburu mmadụ ga-anwụ. A ga-ama ya ikpe ọnwụ naanị mgbe e nwere karịa otu onye akaebe. Ọ dịghị onye ọbụla a ga-egbu nʼihi akaebe nke otu onye gbara megide ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unu a narakwala ihe ịgbara isi nʼọnọdụ ndụ nke onye gburu mmadụ, bụ onye nke ikpe ọnwụ mara. Aghaghị ime ka ha nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unu a narakwala ihe mgbapụta site nʼaka onye ọbụla nke gbagara nʼobodo mgbaba, site otu a kwere ka ha lọghachite azụ ga biri nʼala nke aka ha tupu onyeisi nchụaja anwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unu emerụkwala ala ahụ nke unu bi nʼime ya. Ọbara igbu ọchụ na-emerụ ala. Ọ dịkwaghị mkpuchi mmehie a ga-eme banyere ala a wufuru ọbara nʼime ya, ma ọ bụghị naanị ọbara nke onye ahụ gburu ọchụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu emerụla ala ahụ unu na-aga ibi nʼime ya. Nʼihi na mụ onwe m bikwa nʼebe ahụ, mụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.34",
                "verseOrgIds": [
                  "NUM.35.34"
                ]
              }
            }
          ]
        },
        {
          "text": "bi nʼetiti ụmụ Izrel.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
    }
  ],
