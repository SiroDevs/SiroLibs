          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị nke asatọ ndị Izrel niile ga-enwe oke nzukọ. Ị gaghị arụ ọrụ ọbụla nʼụbọchị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.35",
            "verseOrgIds": [
              "NUM.29.35"
            ]
          }
        },
        {
          "name": "verse",
