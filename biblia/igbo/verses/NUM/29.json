              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ga-eso aja oke ehi, ebule na ụmụ atụrụ ndị ahụ bụ aja mkpụrụ ọka na aja ihe ọṅụṅụ dịka e si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.37",
            "verseOrgIds": [
              "NUM.29.37"
            ]
          }
