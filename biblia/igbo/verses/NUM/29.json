          ]
        },
        {
          "text": "\" 'Tinyere onyinye a na-enye dịka nkwa e kwere si dị, na onyinye afọ ofufu unu, unu ga-akwadoro",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.39",
            "verseOrgIds": [
              "NUM.29.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.39",
                "verseOrgIds": [
                  "NUM.29.39"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye ndị a nʼoge mmemme a kara aka unu: aja nsure ọkụ unu, onyinye mkpụrụ ọka na onyinye ihe ọṅụṅụ na aja udo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.39",
            "verseOrgIds": [
              "NUM.29.39"
            ]
          }
        }
