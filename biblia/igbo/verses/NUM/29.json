          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chụọ aja nsure ọkụ, nke isisi ya dị",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.36",
            "verseOrgIds": [
              "NUM.29.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.36",
                "verseOrgIds": [
                  "NUM.29.36"
                ]
              }
            }
          ]
        },
        {
          "text": "ezi ụtọ. Ị ga-eji otu nwa oke ehi, otu ebule na ụmụ ebule asaa ndị gbara otu afọ, otu afọ, ndị na-enweghị ntụpọ ọbụla, chụọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.36",
            "verseOrgIds": [
              "NUM.29.36"
            ]
          }
        },
        {
