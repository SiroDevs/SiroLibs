  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "NUM 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme Opi Ike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ụbọchị unu ga-egbu opi ike ga-adị nʼabalị mbụ nke ọnwa asaa nʼafọ ọbụla. Nʼụbọchị ahụ, a ga-enwe mkpọkọta dị nsọ nke mmadụ niile. Unu agaghị arụ ọrụ ọbụla nʼụbọchị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, unu ga-achụ aja nsure ọkụ a ga-eji otu oke ehi, na ebule, na ụmụ atụrụ asaa gbara otu afọ, otu afọ ndị na-enweghị ntụpọ, chụọ. Nke a bụ aja na-adị",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.2",
                "verseOrgIds": [
                  "NUM.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ezi mma, ma na-esi ya isi ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aja mkpụrụ ọka ka a ga-eji lita ụtụ ọka isii na ọkara a gwakọtara ya na mmanụ chụọ, nʼisi oke ehi ahụ, lita anọ na ọkara, nʼisi ebule,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na lita abụọ, nʼisi otu nwa atụrụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyere otu mkpi a ga-eji chụọ aja maka mkpuchi mmehie unu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aja ndị a niile bụ nke a ga-etinye nye nʼaja nsure ọkụ a na-achụ kwa ọnwa, na aja nsure ọkụ a na-achụ ụbọchị niile, ha na aja mkpụrụ ọka, na aja ihe ọṅụṅụ dịka e depụtara. Ha bụ aja ihe oriri a na-achụrụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.6",
                "verseOrgIds": [
                  "NUM.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", aja nwere isisi dị ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja ikpuchi mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị nke iri nke ọnwa asaa ahụ, unu ga-enwekwa nzukọ dị nsọ. Unu ga-ebudata onwe unu nʼala. O nweghịkwa ụdị ọrụ ọbụla unu ga-arụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, unu ga-achụrụ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.8",
                "verseOrgIds": [
                  "NUM.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": "aja nsure ọkụ, nke isisi ya na-atọ ya ụtọ. A ga-eji otu nwa oke ehi, na otu ebule, na ụmụ ebule asaa gbara otu afọ, otu afọ ndị na-enweghị ntụpọ chụọ aja a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aja mkpụrụ ọka ga-eso ya. A ga-eji lita ụtụ ọka isii na ọkara a gwakọtara ya na mmanụ chụọ aja nwa oke ehi ahụ. Jiri lita ụtụ ọka anọ na ọkara chụọ aja ebule,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "jirikwa lita ụtụ ọka abụọ chụọ aja nʼisi otu nʼime nwa atụrụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyekwa otu mkpi a ga-eji chụọ aja mmehie. A ga-atụkwasị nke a nʼaja mkpuchi mmehie a na-achụ, tinyere aja nsure ọkụ a na-achụ ụbọchị niile, na aja mkpụrụ ọka, na aja ihe ọṅụṅụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.11",
            "verseOrgIds": [
              "NUM.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme Ụlọ Ikwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị iri na ise nke ọnwa asaa, a ga-enwe mkpọkọta dị nsọ nke ụmụ Izrel niile. Nʼụbọchị ahụ, onye ọbụla agaghị arụ ọrụ ọbụla, nʼihi na ọ bụ mmalite mmemme abalị asaa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.12",
                "verseOrgIds": [
                  "NUM.29.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.12",
            "verseOrgIds": [
              "NUM.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheenụ onyinye a na-enye site nʼọkụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.29.13",
                "verseOrgIds": [
                  "NUM.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nke isisi ya na-atọ ya ụtọ, jirinụ oke ehi iri na atọ, na ebule abụọ, na ụmụ ebule iri na anọ ndị na-enweghị ntụpọ, ndị gbara otu afọ, otu afọ, chụọ aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-atụkwasịkwa aja mkpụrụ ọka nke e ji lita ụtụ ọka isii na ọkara gwakọta ya na mmanụ, nʼisi otu nʼime oke ehi iri na atọ ndị ahụ niile. Lita anọ na ọkara nʼisi otu ebule nʼime ebule abụọ ndị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma lita abụọ nʼisi otu nʼime nwa atụrụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
            "verseOrgIds": [
              "NUM.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyekwa otu mkpi maka ịchụ aja mmehie, ya na aja nsure ọkụ a na-achụ nʼoge ha, tinyere aja mkpụrụ ọka na aja onyinye ihe ọṅụṅụ so ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị abụọ nke mmemme a, a ga-eji oke ehi iri na abụọ, ebule abụọ, na ụmụ ebule iri na anọ gbara otu afọ, otu afọ, ndị na-enweghị ntụpọ chụọ aja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.17",
            "verseOrgIds": [
              "NUM.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ga-eso aja oke ehi, na ebule na ụmụ atụrụ ndị ahụ nʼọnụọgụgụ ha, bụ aja mkpụrụ ọka, na aja ihe ọṅụṅụ dịka e si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.18",
            "verseOrgIds": [
              "NUM.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyekwa otu mkpi maka aja mmehie, ya na aja nsure ọkụ a na-achụ nʼoge ha, na aja mkpụrụ ọka, na aja ihe ọṅụṅụ so ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.19",
            "verseOrgIds": [
              "NUM.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị nke atọ nke mmemme ahụ, ị ga-ewere ụmụ oke ehi iri na otu, na ebule abụọ, na ụmụ ebule iri na anọ ndị gbara otu afọ, otu afọ, ndị na-enweghị ntụpọ, chụọ aja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.20",
            "verseOrgIds": [
              "NUM.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ga-eso aja oke ehi na ebule na ụmụ atụrụ ndị ahụ nʼọnụọgụgụ ha bụ aja mkpụrụ ọka na aja ihe ọṅụṅụ dịka e si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.21",
            "verseOrgIds": [
              "NUM.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyekwa otu mkpi maka aja mmehie, ya na aja nsure ọkụ a na-achụ nʼoge ha, na aja mkpụrụ ọka, na aja ihe ọṅụṅụ so ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.22",
            "verseOrgIds": [
              "NUM.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị nke anọ nke mmemme ahụ, ị ga-ewere ụmụ oke ehi iri, ebule abụọ, ụmụ ebule iri na anọ ndị gbara otu afọ, otu afọ, ndị na-enweghị ntụpọ, chụọ aja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.23",
            "verseOrgIds": [
