  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "NUM 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmiri si na nkume",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel, bụ nzukọ ahụ niile rutere nʼọzara Zin nʼọnwa nke mbụ. Ha manyere ụlọ ha na Kadesh. Ọ bụkwa nʼebe ahụ ka Miriam nwụrụ. E lie ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.1",
            "verseOrgIds": [
              "NUM.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmiri ọṅụṅụ adịghị nye ndị nzukọ ahụ. Ya mere na ha gbakọtara imegide Mosis na Erọn.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.2",
            "verseOrgIds": [
              "NUM.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sesịrị Mosis okwu sị, \"Ọ gaara akara anyị mma ma a sị na anyị nwụrụ mgbe ụmụnna anyị nwụrụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.3",
            "verseOrgIds": [
              "NUM.20.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.3",
                "verseOrgIds": [
                  "NUM.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.3",
            "verseOrgIds": [
              "NUM.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji kpọbata ọgbakọ nke",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.4",
            "verseOrgIds": [
              "NUM.20.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.4",
                "verseOrgIds": [
                  "NUM.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼime ọzara a, ime ka anyị na anụ ụlọ anyị niile nwụọ nʼebe a?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.4",
            "verseOrgIds": [
              "NUM.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji si nʼala Ijipt kpọpụta anyị, kpọbata anyị nʼebe ọjọọ a? O nweghị mkpụrụ ọghịgha maọbụ fiig, enweghị mkpụrụ vaịnị maọbụ mkpụrụ pomegranet. Ọ dịghị mmiri dị nke ha ga-aṅụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.5",
            "verseOrgIds": [
              "NUM.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis na Erọn si nʼebe ọgbakọ ahụ nọ tụgharịa gaa nʼọnụ ụzọ ụlọ nzute, daa kpụọ ihu ha nʼala. E mee ka ha hụ ebube",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.6",
            "verseOrgIds": [
              "NUM.20.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.6",
                "verseOrgIds": [
                  "NUM.20.6"
                ]
              }
            }
          ]
        },
        {
          "text": "anya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.6",
            "verseOrgIds": [
              "NUM.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.7",
                "verseOrgIds": [
                  "NUM.20.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.7",
            "verseOrgIds": [
              "NUM.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Were mkpara ahụ, gị na nwanne gị Erọn kpọkọta nzukọ Izrel niile. Gwa nkume ahụ okwu nʼihu ha, ọ ga-asọpụta mmiri ya. Unu ga-eme ka mmiri si na nkume ahụ sọpụta nye ọgbakọ ahụ, ka ha na igwe anụ ụlọ ha, ṅụọ mmiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.8",
            "verseOrgIds": [
              "NUM.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere Mosis sitere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.9",
                "verseOrgIds": [
                  "NUM.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "weere mkpara ahụ dịka iwu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.9",
                "verseOrgIds": [
                  "NUM.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Mosis na Erọn kpọkọtara ụmụ Izrel niile nʼihu nkume ahụ. Mgbe ha bịaruru nso, Mosis gwara ha okwu sị ha, \"Geenụ ntị unu ndị nnupu isi! Ọ bụ site na nkume a ka anyị ga-enye unu mmiri?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.10",
            "verseOrgIds": [
              "NUM.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Mosis weliri aka ya elu jiri mkpara ahụ tie nkume ahụ ugboro abụọ. Mmiri sitere na ya sọpụta. Ọgbakọ Izrel niile na igwe anụ ụlọ ha ṅụkwara mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.11",
            "verseOrgIds": [
              "NUM.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.12",
            "verseOrgIds": [
              "NUM.20.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.12",
                "verseOrgIds": [
                  "NUM.20.12"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu sị, \"Ebe ọ bụ na unu jụrụ ikwenye nʼokwu m, jụkwa ido m nsọ nʼihu ndị Izrel niile, unu agaghị edubata ọgbakọ ndị a nʼala ahụ m na-aga inye ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.12",
            "verseOrgIds": [
              "NUM.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kpọrọ ebe ahụ mmiri Meriba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        },
        {
          "text": "nʼihi na ọ bụ nʼebe ahụ ka Izrel wesoro",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.13",
                "verseOrgIds": [
                  "NUM.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "iwe. O gosikwara ha ịdị nsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Edọm ajụ na Izrel ga-agafe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis sitere nʼọzara Kadesh, zipụ ndị ozi ka ha gakwuru eze Edọm, sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.14",
            "verseOrgIds": [
              "NUM.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NUM 20:14"
      },
      "items": [
        {
          "text": "\"Otu a ka nwanne gị bụ Izrel na-ekwu: Ị nụla akụkọ ihe nhụju anya niile dakwasịrị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.14",
            "verseOrgIds": [
              "NUM.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nna anyị gara biri nʼala Ijipt. Anyị biri nʼebe ahụ ọtụtụ afọ. Ndị Ijipt mekpara anyị na nna nna anyị ha ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.15",
            "verseOrgIds": [
              "NUM.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe anyị tikuru",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.16",
            "verseOrgIds": [
              "NUM.20.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.16",
                "verseOrgIds": [
                  "NUM.20.16"
                ]
              }
            }
          ]
        },
        {
          "text": "mkpu akwa, ọ nụrụ akwa anyị, zitere anyị mmụọ ozi ya, onye dupụtara anyị site nʼala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.16",
            "verseOrgIds": [
              "NUM.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NUM 20:16"
      },
      "items": [
        {
          "text": "\"Ugbu a, anyị nọ na Kadesh obodo dị nso nʼoke ala gị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.16",
            "verseOrgIds": [
              "NUM.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko kwere ka anyị si nʼala gị gafee. Anyị ga-akpachara anya hụ na anyị esiteghị nʼubi ihe ọkụkụ gị maọbụ nʼubi vaịnị gị gafee. Anyị agaghị aṅụ mmiri ọbụla site nʼolulu mmiri gị. Anyị ga-anọgide naanị nʼokporoụzọ eze. Anyị agaghị ahapụ ya, chee ihu akụkụ aka nri maọbụ aka ekpe, tutu ruo mgbe anyị gafechara oke ala gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.17",
            "verseOrgIds": [
              "NUM.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze Edọm zara sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.18",
            "verseOrgIds": [
              "NUM.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NUM 20:18"
      },
      "items": [
        {
          "text": "\"Unu amanyela ụkwụ; ọ bụrụ na unu anwaa anwa bata nʼala m, aga m eji ndị agha m zute unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.18",
            "verseOrgIds": [
              "NUM.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Izrel zara ozi o ziri sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.19",
            "verseOrgIds": [
              "NUM.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NUM 20:19"
      },
      "items": [
        {
          "text": "\"Ọ bụ naanị nʼokporoụzọ ka anyị ga-esi gafee. Ọ bụrụ na anyị maọbụ anụ ụlọ anyị a ṅụọ mmiri dị nʼala gị, anyị ga-akwụ ọnụahịa ya. Naanị mkpa anyị bụ ịgafe. Ọ dịghị ihe ọzọ anyị chọrọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.19",
            "verseOrgIds": [
              "NUM.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze Edọm aṅaghị ntị, ọ gwaghere ha ọnụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.20",
            "verseOrgIds": [
              "NUM.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NUM 20:20"
      },
      "items": [
        {
          "text": "\"Unu agaghị esite nʼala gabiga.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.20",
            "verseOrgIds": [
              "NUM.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 20:20"
      },
      "items": [
        {
          "text": "Edọm chịkọtara ọtụtụ ndị agha dị ike duru ha pụọ ịga izute ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.20",
            "verseOrgIds": [
              "NUM.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na ndị Edọm ekweghị ka ndị Izrel si nʼoke ala ha gafee, ndị Izrel tụgharịrị azụ hapụ isi ụzọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.21",
            "verseOrgIds": [
              "NUM.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Erọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbakọ Izrel niile sitere na Kadesh bulie ije gagide rute nʼugwu Hor.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.22",
            "verseOrgIds": [
              "NUM.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼugwu Hor, nʼoke ala Edọm, Onyenwe anyị gwara Mosis na Erọn okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.23",
            "verseOrgIds": [
              "NUM.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oge eruola mgbe Erọn ga-anwụ. Ọ gaghị abanye nʼala ahụ m nyere ụmụ Izrel, nʼihi na unu abụọ nupuru isi nʼiwu m na mmiri Meriba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.24",
            "verseOrgIds": [
              "NUM.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, kpọrọ Erọn na nwa ya nwoke Elieza, duru ha gaa nʼugwu Hor.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
              "NUM.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka ị ga-eyipụ Erọn uwe onye nchụaja o yi, yikwasị ha Elieza nwa ya nwoke. Ọ bụkwa nʼebe ahụ ka Erọn ga-anọ nwụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.26",
            "verseOrgIds": [
              "NUM.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere Mosis mere dịka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.20.27",
                "verseOrgIds": [
                  "NUM.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya iwu. Ha atọ rigoro nʼugwu Hor mgbe nzukọ Izrel niile nọ na-ele ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.27",
            "verseOrgIds": [
              "NUM.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha ruru nʼelu ugwu ahụ, Mosis yipụrụ Erọn uwe onye nchụaja ya yikwasị ha nwa ya nwoke Elieza. Erọn nọkwa nʼebe ahụ, nʼelu ugwu ahụ nwụọ. Emesịa, Mosis na Elieza tụgharịrị site nʼugwu ahụ lọghachi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.28",
            "verseOrgIds": [
              "NUM.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọgbakọ Izrel nụrụ ihe banyere ọnwụ Erọn ha ruru ụjụ nʼihi ya iri ụbọchị atọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.29",
            "verseOrgIds": [
              "NUM.20.29"
            ]
          }
        }
      ]
    }
  ],
