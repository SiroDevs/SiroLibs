  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "NUM 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Idebe ọmụma ụlọ ikwu ọcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.1",
                "verseOrgIds": [
                  "NUM.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nye ndị Izrel iwu ka ha site nʼọmụma ụlọ ikwu ha kpọpụ onye ekpenta ọbụla maọbụ onye ihe si nʼahụ na-asọpụta, na ndị merụrụ onwe ha site nʼimetụ onye nwụrụ anwụ aka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.2",
            "verseOrgIds": [
              "NUM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu a metụtara onye ọbụla, nwoke na nwanyị. Kpọpụ ha ka ha gaa nʼazụ ọmụma ụlọ ikwu, ka ha ghara imerụ ogige ụlọ ikwu ha bụ ebe ahụ m binyere unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel mezuru iwu a, site nʼetiti ha kpọpụ ndị dị otu a, dịka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.4",
                "verseOrgIds": [
                  "NUM.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịkwụghachi ụgwọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.5",
                "verseOrgIds": [
                  "NUM.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha, 'Mgbe onye ọbụla, nwoke maọbụ nwanyị, mejọrọ mmadụ ibe ya nʼụzọ ọbụla, si otu a bụrụ onye na-ekwesighị ntụkwasị obi nye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.6",
                "verseOrgIds": [
                  "NUM.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ onye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye dị otu a aghaghị ikwupụta mmehie ya, kwụghachi onye ahụ o mejọrọ ihe iwu kwuru na ọ ga-akwụ. Ọ ga-atụkwasị nʼelu ihe ọ na-akwụghachi onye ahụ o mejọrọ ego ọzọ ruru otu ụzọ nʼụzọ ise.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye ahụ enweghị onye ikwu ya bụ onye a ga-akwụghachi ụgwọ nʼihi mejọọ ahụ, ihe ịkwụghachi ụgwọ ahụ ga-abụ nke",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.8",
                "verseOrgIds": [
                  "NUM.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", aghaghị inye onye nchụaja. A ga-atụkwasịkwa ya ebule a ga-eji chụọ aja mkpuchi mmehie nʼihi onye ahụ mehiere.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyinye niile dị nsọ ndị Izrel wetaara onye nchụaja bụ nke onye nchụaja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyinye dị nsọ niile mmadụ na-eweta bụ nke onye na-eweta ya, ma onyinye e nyere onye nchụaja bụ nke onye nchụaja.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu banyere ekwesighị ntụkwasị obi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.11",
                "verseOrgIds": [
                  "NUM.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha, Ọ bụrụ na nwunye mmadụ ejehie ụzọ bụrụ onye na-ekwesighị ntụkwasị obi nʼebe di ya nọ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12",
            "verseOrgIds": [
              "NUM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "site nʼidinakwuru nwoke ọzọ nʼụzọ zoro ezo nʼebe di ya nọ ruo na achọpụtaghị adịghị ọcha ya (ebe a na-enweghị onye ga-agba akaebe megide ya, maọbụ na e jidere ya mgbe ọ na-akwa iko ahụ),",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na mmụọ ekworo abịakwasị di ya, ọ bụrụkwa na di nwanyị ahụ na-enyo nwunye ya enyo, na-ele ya anya dịka onye merụrụ onwe ya, ma ọ bụkwanụ, ọ bụrụ na di ya esite nʼekworo nyoo nwunye ya, ọ bụ ezie na nwanyị ahụ bụ onye na-emerụghị onwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nwoke a ga-akpọrọ nwunye ya bịakwute onye nchụaja. Ọ ga-eweta onyinye iji ịbịaru nso nʼihi nwunye ya, nke bụ iko ụtụ ọka balị abụọ a na-awụkwasịghị mmanụ, maọbụ ụda na-esi isi ụtọ a gwakọrọ agwakọ, nʼihi na ọ bụ onyinye mkpụrụ ọka e sitere nʼobi jupụtara nʼekworo nye, onyinye ịkpọtụ uche nʼikpe ọmụma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye nchụaja ga-akpọbata nwanyị a mee ka o guzo nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.16",
                "verseOrgIds": [
                  "NUM.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ekunye mmiri nsọ nʼime ite aja, kporo aja nʼala site nʼụlọ nzute ahụ wụnye ya nʼime mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka nwanyị ahụ guzo nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.18",
                "verseOrgIds": [
                  "NUM.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye nchụaja ahụ ga-atọsa agịrị isi ya, tinye onyinye mkpụrụ ọka ncheta ahụ, nke bụ onyinye mkpụrụ ọka ekworo ahụ nʼọbụaka nwanyị a. Onye nchụaja nʼonwe ya ga-eguzo nʼihu nwanyị a jide ite mmiri ilu ahụ na-eweta ọbụbụ ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye nchụaja ga-eme ka nwanyị a ṅụọ iyi, mgbe ọ na-agwa ya okwu sị, \"Ọ bụrụ na o nweghị nwoke ọbụla gị na ya nwere mmekọ, ọ bụrụ na ị kpafughị ghọọ onye na-adịghị ọcha mgbe ị nọ nʼụlọ di gị, ka ihe ọjọọ ọbụla ghara izute gị site na mmiri ilu a na-eweta ọbụbụ ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị kpafuola mgbe ị ka nọ nʼụlọ di gị, ọ bụrụ na i merụọla onwe gị site na idinakwuru nwoke ọzọ na-abụghị di gị,\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nʼoge a, onye nchụaja ga-eme ka nwanyị a ṅụọ iyi nke ya na ọbụbụ ọnụ a so, gwa nwanyị okwu sị ya) \"ka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.21",
                "verseOrgIds": [
                  "NUM.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "mee ka ndị ị nọ nʼetiti ha bụọ gị ọnụ ma kọchaa gị mgbe o mere ka apata gị ree ure, mgbe o mere ka afọ gị koo eko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mmiri ilu a, nke na-eweta ọbụbụ ọnụ banye gị nʼahụ ime ka afọ gị koo eko, imekwa ka akpanwa gị daa ada.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 5:22"
      },
      "items": [
        {
          "text": "\" 'Nwanyị ahụ ga-aza sị, \"Amen, ya dịrị m otu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ahụ onye nchụaja ahụ ga-ede ọbụbụ ọnụ ndị a nʼakwụkwọ, sanye ha nʼime mmiri ilu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.23",
            "verseOrgIds": [
              "NUM.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ ga-enye nwanyị a mmiri ilu ahụ na-eweta ọbụbụ ọnụ ka ọ ṅụọ, mmiri a ga-abanye ya nʼime ahụ, wetara ya ịta ahụhụ dị ilu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, onye nchụaja ga-anara nwanyị ahụ onyinye mkpụrụ ọka ekworo ahụ o ji nʼọbụaka ya, fegharịa ya nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.25",
                "verseOrgIds": [
                  "NUM.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", buru ya gaa nʼebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-esite nʼonyinye mkpụrụ ahụ kporo nke ga-eju ya aka, nke na-anọchite anya ha niile, suo ha ọkụ nʼelu ebe ịchụ aja. Emesịa, ọ ga-enye nwanyị ahụ mmiri ahụ ka ọ ṅụọ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na nwanyị a emerụọla onwe ya, bụrụ onye na-ekwesighị ntụkwasị obi nye di ya, mgbe ọ ṅụrụ mmiri na-eweta ọbụbụ ọnụ, ọ ga-abanye nʼime ya wetara ya ahụhụ dị ilu. Afọ ya ga-eko, buo ibu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "text": "akpanwa ya a gaghị anagide nwa. Ọ ga-aghọ onye a bụrụ ọnụ nʼetiti ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na nwanyị emerụghị onwe ya, kama ọ bụ onye dị ọcha, ọ ga-abụ onye nwere onwe ya site nʼikpe ọmụma. Ọ ga-atụrụ ime mụta ụmụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nke a bụ iwu metụtara ikwo ekworo mgbe nwanyị bi nʼụlọ di ya kpafuru merụọ onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maọbụ mgbe ekworo jupụtara nwoke nʼobi nʼihi na ọ gụrụ nwunye ya dịka onye na-ekwesighị ntụkwasị obi. Onye nchụaja ga-eme ka nwanyị a guzo nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.5.30",
                "verseOrgIds": [
                  "NUM.5.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", mezuokwa ihe niile nʼusoro dịka e si depụta ha nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị ama di nwanyị a ikpe dịka onye mere ihe ọjọọ, kama nwanyị a ga-ebu ahụhụ ya na mmehie ya naanị ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
            "verseOrgIds": [
              "NUM.5.31"
            ]
          }
        }
      ]
    }
  ],
