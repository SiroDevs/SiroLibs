        },
        {
          "text": "nọnyeere Samuel mgbe ọ na-eto, meekwa ka amụma niile Samuel buru mezuo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.19",
            "verseOrgIds": [
