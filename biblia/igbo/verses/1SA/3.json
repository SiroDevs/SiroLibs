        "vid": "1SA 3:16"
      },
      "items": [
        {
          "text": "Samuel zara sị, \"Lee m nʼebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
