          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Samuel gwara ya ihe niile, o zokwaghị ihe ọbụla. Mgbe ahụ Elayị kwuru okwu sị, \"Ya onwe ya bụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.18",
                "verseOrgIds": [
                  "1SA.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya meekwa dịka o si dị ya mma nʼanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        }
      ]
    },
