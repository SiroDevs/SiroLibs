  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyenwe anyị akpọọ Samuel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwata ahụ bụ Samuel nọkwa na-ejere",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.1",
                "verseOrgIds": [
                  "1SA.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ozi nʼihu Elayị. Nʼụbọchị ndị ahụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.1",
                "verseOrgIds": [
                  "1SA.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ụkọ, adịghịkwa ahụ ọtụtụ ọhụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruru nʼotu abalị, ka Elayị dinara ala nʼọnọdụ ya ịrahụ ụra, ebe ọ bụ na anya ya akala nka nke bụ na ọ dịghị ahụzikwa ụzọ nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, oriọna",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "text": "Chineke anyụbeghị, Samuel dinara nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.3",
                "verseOrgIds": [
                  "1SA.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼebe ahụkwa ka igbe ọgbụgba ndụ Chineke dị.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.4",
                "verseOrgIds": [
                  "1SA.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ Samuel oku,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:4"
      },
      "items": [
        {
          "text": "Samuel zara sị, \"Lee m nʼebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O biliri jekwuru Elayị, sị ya, \"Lee m abịala m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:5"
      },
      "items": [
        {
          "text": "Ma Elayị sịrị ya, \"Mba, akpọghị m gị, laghachi gaa dinaa ala.\" Samuel gara dina ala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.6",
                "verseOrgIds": [
                  "1SA.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ ya sị, \"Samuel!\" Samuel gbaara ọsọ jekwuru Elayị sị ya, \"Lee m, gịnị ka m ga-eme?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:6"
      },
      "items": [
        {
          "text": "Ma Elayị zara sị ya. \"Mba akpọghị m gị oku, nwa m. Laghachi gaa dinaa ala.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Samuel amatabeghị onye",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.7",
                "verseOrgIds": [
                  "1SA.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ, ekpughebeghị okwu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.7",
                "verseOrgIds": [
                  "1SA.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nye ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.8",
                "verseOrgIds": [
                  "1SA.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ ya oku nke ugbo atọ; ọzọkwa Samuel biliri jekwuru Elayị sị ya, \"Lee m, gịnị ka ị chọrọ ka m mee?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:8"
      },
      "items": [
        {
          "text": "Mgbe ahụ, Elayị ghọtara na ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.8",
                "verseOrgIds": [
                  "1SA.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na-akpọ nwantakịrị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi ya ọ gwara Samuel okwu sị, \"Laghachi, dinaa ala. Ọ bụrụ na ọ kpọọ gị ọzọ, sị ya, 'Lee m, kwuo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.9",
                "verseOrgIds": [
                  "1SA.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼihi na ohu gị na-ege ntị.' \" Ya mere Samuel laghachiri gaa dinaa ala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.10",
                "verseOrgIds": [
                  "1SA.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bịara guzo onwe ya nʼebe ahụ, kpọọ ya ọzọ dịka o si kpọọ ya na mbụ sị, \"Samuel! Samuel!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:10"
      },
      "items": [
        {
          "text": "Samuel zara sị, \"Lee m, kwuo, nʼihi na ohu gị na-anụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.11",
                "verseOrgIds": [
                  "1SA.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Samuel sị, \"Lee, ana m aga ime ihe nʼIzrel nke ga-eme ka ntị nụrụ ya zụọ wuruwuru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ aga m emezu ihe niile m kwuru megide Elayị na ezinaụlọ ya, site na mmalite ruo ọgwụgwụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na agwara m ya na m ga-ekpe ezinaụlọ ya ikpe, ruo mgbe ebighị ebi, nʼihi mmehie ahụ ọ maara ihe banyere ya. Nʼihi na ụmụ ya mere onwe ha ndị a na-elelị anya,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "text": "ma o meghị ihe ọbụla ịkwụsị ha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, aṅụọla m iyi nye ụlọ Elayị sị, 'Ikpe ọmụma dịkwasịrị ụlọ Elayị bụ nke a na-agaghị eji onyinye maọbụ ịchụ aja kpuchie.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuel dinara ala tutu ruo ụtụtụ. Mgbe chi bọrọ, o meghere ọnụ ụzọ ụlọ nzute",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.15",
                "verseOrgIds": [
                  "1SA.3.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka ọ na-eme. Ma egwu tụrụ ya ịgwa Elayị ọhụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Elayị kpọrọ ya sị, \"Samuel, nwa m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
