  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2CO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebe obibi anyị nʼeluigwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anyị ma nke ọma na mgbe e mebiri ụlọ ikwu nke anyị bi nʼime ya, bụ ụlọ nke ụwa a, anyị nwere ụlọ nke sitere na Chineke, ụlọ nke ejighị aka wuo, ga-adị ebighị ebi nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a anyị nọ na-asụ ude, na-enwe agụụ inweta ebe obibi anyị dị nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ ga-abụ anyị yiri ya, ka anyị hapụ ịdị ka ndị gba ọtọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ niile anyị nọ nʼime ụlọ ikwu a,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "text": "anyị na-anọgide nʼịsụ ude nke ibu arọ. Ọ bụghị nʼihi na anyị chọrọ ịnwụ anwụ bụrụ ndị na-enweghị anụ ahụ, kama ọ bụ nʼihi na anyị chọrọ ka e yikwasị anyị anụ ahụ nke eluigwe ahụ, ka anụ ahụ a pụrụ ịnwụ anwụ yikwasị ndụ ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke onye ya onwe ya, bụ onye kwadobere anyị maka mgbanwo nke a, nyekwara anyị Mmụọ Nsọ ka ọ bụrụ onye ga-ahụ na anyị ga-enwetazu nkwa ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, anyị nwere obi ike mgbe niile, nʼihi na anyị maara na mgbe anyị na-aga nʼihu na-adị ndụ nʼanụ ahụ a, anyị na Onyenwe anyị anọghị.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ọ bụ okwukwe ka anyị ji adị ndụ ọ bụghị ihe anya hụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi siri anyị ike. Ọ gaara amasị anyị ịhapụ ụlọ nke a anyị bi na ya, bụ ahụ anyị ma lakwuru Onyenwe anyị nʼebe obibi ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ma anyị nọ nʼụlọ a maọbụ nʼọzọ, ihe anyị chọrọ bụ ka anyị mee ihe ga-atọ ya ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anyị niile ga-eguzo nʼihu oche ikpe Kraịst, mgbe ahụ onye ọbụla nʼime anyị, nʼotu nʼotu, ga-anata ụgwọ ọrụ dịka ihe ọ rụrụ na-anụ ahụ ya mgbe ọ nọ nʼime ụwa si dị, maọbụ ezi ihe maọbụ ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ije ozi nke ịdị na mma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼihi na anyị maara nnọọ ihe ịtụ egwu Onyenwe anyị pụtara, ka anyị ji na-arụsị ọrụ ike ka ndị mmadụ mata Chineke makwaara ụdị mmadụ anyị bụ. Enwekwara m olileanya na nke a pụtara ihe nye akọnuche unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị adịghị agbalị ịgwa unu na anyị dị mma, kama anyị chọrọ inye unu ihe unu ga-eji nyaa isi mgbe unu na-ekwu ihe banyere anyị, ka unu nwee ike ịmata ihe unu ga-azaghachi ndị ahụ na-anya isi banyere ihe ha ji anya ha hụ, kama ihe dị mmadụ nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na anyị amaghị onwe anyị, ọ bụ nʼihi Chineke, ọ bụrụ na anyị nwere uche zuruoke, ọ bụ nʼihi unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.13",
            "verseOrgIds": [
              "2CO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ịhụnanya Kraịst na-akwagide anyị, nʼihi na anyị kwere na otu onye nwụrụ maka mmadụ niile, nke pụtara na mmadụ niile anwụọla.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.14",
            "verseOrgIds": [
              "2CO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nwụrụ nʼihi mmadụ niile, ka ndị dị ndụ gharakwa ịdịrị onwe ha ndụ ọzọ, kama maka onye ahụ nwụrụ nʼihi ha ma sikwa nʼọnwụ kulie.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bido ugbu a gawa, anyị adịghị elekwa onye ọbụla anya dịka mmadụ nkịtị. Nʼihi na anyị sitere nʼụzọ dị otu a lee Kraịst anya, chee na ọ bụ mmadụ efu. Ma ugbu a, anyị amakwaghị ya nʼụzọ dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ bụrụ na onye ọbụla amalite ịdị ndụ nʼime Kraịst, ọ ghọọla onye e kere ọhụrụ, ihe ochie agaala, nke ọhụrụ anọchie.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.17",
            "verseOrgIds": [
              "2CO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ Chineke bụ onye na-eme ihe ndị a. Ọ bụ ya onwe ya sitere nʼaka Kraịst mee ka anyị na ya dịrị nʼudo. Ma ugbu a, o nyela anyị ọrụ ije ozi, ịkpọ ndị ọzọ ka ha bịa ka ya na ha dịrịkwa nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.18",
            "verseOrgIds": [
              "2CO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nke a pụtara bụ na Chineke sitere na Kraịst na-eme ka ya na ụwa dị na mma. Ọ dịghị agụkọrọ ụmụ mmadụ mmehie niile, kama o tinyela nʼaka anyị ozi banyere ụzọ o si eme ka ya na ụmụ mmadụ dịkwa na mma ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, anyị bụ ndị na-anọchi anya Kraịst ijere ya ozi nʼụwa. Chineke ji anyị na-agwa unu okwu. Anyị na-arịọ unu dịka ọ bụ Kraịst nʼonwe ya na-arịọ unu. Biko, bịanụ ka unu na Chineke dịrị nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.20",
            "verseOrgIds": [
              "2CO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o mere ka onye ahụ na-amaghị mmehie bụrụ mmehie nʼọnọdụ anyị, ka esi otu a mee ka anyị nwee oke nʼime ezi omume Chineke site na ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.21",
            "verseOrgIds": [
              "2CO.5.21"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CO.6",
    "number": "6",
