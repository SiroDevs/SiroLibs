          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị onwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.18.23",
                "verseOrgIds": [
                  "JER.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "maara nzube ọjọọ ha niile igbu m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "Agbagharala ha ajọ omume ha;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "maọbụ hichapụ mmehie ha site nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "Mee ka ụkwụ ha gbuchapụ ka ha daa nʼihu gị;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:23"
      },
      "items": [
        {
          "text": "mesie ha ike mgbe ị na-ewe iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
        }
