        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụbọchị Mbibi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.1",
                "verseOrgIds": [
                  "JER.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị gaghị alụtara onwe gị nwunye, ị gaghị amụtakwa ụmụ ndị ikom na ndị inyom nʼebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.3",
                "verseOrgIds": [
                  "JER.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru banyere ụmụ ndị ikom niile na ụmụ ndị inyom niile a mụrụ nʼala a. Otu a ka ọ kwukwara banyere nne na nna ụmụntakịrị ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ha ga-anwụ site nʼajọ ọrịa nke ga-egbu ha niile. O nweghị onye ga-eru ụjụ nʼihi ha, a gaghị elikwa ha. Kama ha ga-adị ka unyi e kposara nʼala. Mma agha na ụnwụ ga-ala ha nʼiyi, ozu ha ga-abụkwa ihe oriri nye ụmụ anụ ufe na ụmụ anụ ọhịa nke ụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.5",
                "verseOrgIds": [
                  "JER.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, \"Abanyela nʼụlọ ọbụla a na-akwa ozu; abanyela maka iso ha ruo ụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "text": "maọbụ maka igosi ha ebere, nʼihi na ewepụla m ngọzị m nʼịhụnanya m, na ọmịiko m site nʼebe ha nọ,\" otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.5",
                "verseOrgIds": [
                  "JER.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ndị ukwu na ndị nta nʼime ha ga-anwụ nʼala a. O nweghị onye ga-eli ha, maọbụ ruo ụjụ nʼihi ha. O nweghị onye ga-akpụcha isi ya, maọbụ gbuo onwe ya mma nʼihi ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị onye ga-eweta ihe oriri nye ndị zukọrọ maka ịkasị ndị na-eru ụjụ obi. Nri agaghị adị ọ bụladị nye ndị na-eru ụjụ, nʼihi ọnwụ nna ha maọbụ ọnwụ nne ha. Ọ dịkwaghị onye ga-enye ha ihe ọṅụṅụ nʼihi ịkasị ha obi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abanyekwala nʼụlọ ebe e nwere oriri soro ndị nọ nʼebe ahụ nọdụ ala iri ihe na ịṅụ ihe ọṅụṅụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.9",
                "verseOrgIds": [
                  "JER.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, onye bụkwa Chineke Izrel kwuru, 'Nʼihu gị, na nʼoge ndị a niile ị dị ndụ, ka m ga-eme ka ụzụ ọṅụ na obi ụtọ, na olu ndị ikom na nke ndị inyom na-alụ di na nwunye kwụsị.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ị gwara ndị a ihe ndị a, ha ga-ajụ gị ajụjụ sị, 'Gịnị mere",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.10",
                "verseOrgIds": [
                  "JER.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ji kpebie izitere anyị ụdị oke ịla nʼiyi dị otu a? Gịnị bụ ihe ọjọọ anyị mere? Gịnị bụ mmehie anyị mere megide",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.10",
                "verseOrgIds": [
                  "JER.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ị ga-asa ha sị ha, 'Ihe ndị a na-adakwasị unu nʼihi na nna nna unu ha gbakụtara m azụ,' otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.11",
                "verseOrgIds": [
                  "JER.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara, 'gbasoro, fee ma kpọọkwa isiala nye chi ndị ọzọ. Ha jụrụ iso m, jụkwa idebe ihe m nyere ha nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu emesoola m mmeso ọjọọ karịa ụdị mmeso nna unu ha mesoro m. Lee ka unu niile nʼotu nʼotu si agbaso ụzọ isiike nke obi ọjọọ unu chepụtara, kama irubere m isi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
              "JER.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, aga m esite nʼala a tufuo unu. Aga m atụbanye unu nʼala ahụ unu na nna unu ha na-amaghị. Ebe ahụ ka unu ga-anọkwa fee chi ndị ọzọ ehihie na abalị. Nʼihi na agaghị m emere unu amara.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Otu ọ dị, ụbọchị ndị ahụ na-abịa,\" ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.14",
                "verseOrgIds": [
                  "JER.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara, \"mgbe ndị mmadụ na-agaghị asịkwa ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "text": "'Dịka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.14",
                "verseOrgIds": [
                  "JER.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "na adị ndụ, bụ onye ahụ sitere nʼala Ijipt kpọpụta ụmụ Izrel.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma a ga-asị, 'Dịka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.15",
                "verseOrgIds": [
                  "JER.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, bụ onye ahụ kpọpụtara Izrel site nʼala dị nʼugwu, na mba ahụ niile ọ chụsara ha.' Nʼihi na aga m akpọlata ha nʼala ahụ m nyere nna nna ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, aga m ezipu ọtụtụ ndị ọkụ azụ ka ha gaa jide ha.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.16",
                "verseOrgIds": [
                  "JER.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri. \"Mgbe nke ahụ gasịrị, aga m ezipụkwa ọtụtụ ndị na-achụ nta, ndị ga-esite nʼelu ugwu ukwu niile na nʼelu ugwu nta niile, na nʼọnụ mgbawara dị na nkume niile, chụọ nta ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m ahụzu ụzọ ha niile. O nweghị ihe zoro ezo nʼebe m nọ. Anya m na-ahụzukwa mmehie ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.17",
            "verseOrgIds": [
              "JER.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m akwụghachi ha okpukpu abụọ nʼihi ajọ omume ha, na mmehie ha, nʼihi na ha ejirila oyiyi ihe arụ a pịrị apị ha, nke na-enweghị ndụ nʼime ya, merụọ ala m. Ha emeekwala ka arụsị bụ ihe arụ jupụta nʼihe nketa m.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.18",
            "verseOrgIds": [
              "JER.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.19",
                "verseOrgIds": [
                  "JER.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", ị bụ ike m na ebe m e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:19"
      },
      "items": [
        {
          "text": "ebe mgbaba m nʼoge nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 16:19"
      },
      "items": [
        {
          "text": "Mba niile nke ụwa ga-esite na nsọtụ ụwa niile bịakwute gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:19"
      },
      "items": [
        {
          "text": "Ha ga-abịakwute gị sị gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 16:19"
      },
      "items": [
        {
          "text": "\"Nna anyị ha enweghị ihe ọbụla karịakwa chi ndị na-abụghị chi nʼezie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:19"
      },
      "items": [
        {
          "text": "Ha bụkwa chi na-abaghị uru, nke na-adịghị ewetara ha ihe ọma ọbụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ ọ pụrụ imere onwe ya chi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:20"
      },
      "items": [
        {
          "text": "E, ma chi ndị ahụ abụghị chi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, aga m eme ka ha mata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:21"
      },
      "items": [
        {
          "text": "Nʼoge a ka m ga-eme ka ha mata ike m,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:21"
      },
      "items": [
        {
          "text": "na ịdị ike m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 16:21"
      },
      "items": [
        {
          "text": "Mgbe ahụ, ha ga-amata",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:21"
      },
      "items": [
        {
          "text": "na aha m bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
