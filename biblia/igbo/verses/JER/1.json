{
  "id": "JER.1",
  "number": "1",
  "bookId": "JER",
  "reference": "Jeremaya 1",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JER 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ okwu Jeremaya nwa Hilkaya, bụ otu onye nʼime ndị nchụaja, nọ nʼAnatot nke dị nʼala Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.2",
                "verseOrgIds": [
                  "JER.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere nʼafọ nke iri na atọ nʼoge ọchịchị Amọn, eze Juda bụ nwa Josaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozi ndị ọzọ rukwara ya ntị nʼoge Jehoiakim nwa Josaya, bụ eze Juda, ruokwa nʼọnwa nke ise nʼafọ nke iri na otu nke Zedekaya nwa Josaya, bụ eze Juda kwụsịrị, mgbe a dọkpụụrụ ndị Jerusalem nʼagha buru ha ka ha gaa biri na mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ Jeremaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.4",
                "verseOrgIds": [
                  "JER.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere m, na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amaara m gị tupu a tụrụ ime gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "tupu a mụọ gị, edoro m gị nsọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "ahọpụtakwara m gị dịka onye amụma nye mba niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asịrị m, \"Ewoo, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.6",
                "verseOrgIds": [
                  "JER.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Lee, amaghị m ekwu okwu. Abụ m naanị nwantakịrị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.7",
                "verseOrgIds": [
                  "JER.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Asịkwala 'Abụ m naanị nwantakịrị,' nʼihi na ị ga-agakwuru onye ọbụla m zigara gị, ị ga-ekwukwa ihe niile m nyere gị nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atụkwala egwu nʼihi ha, nʼihi na mụ onwe nọnyere gị ịnapụta gị,\" ọ bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.8",
                "verseOrgIds": [
                  "JER.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.9",
                "verseOrgIds": [
                  "JER.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "setịpụrụ aka ya metụ m nʼọnụ, sị m, \"Lee, ewerela m okwu m tinye gị nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, taa, ana m eme gị onye nlekọta mba dị iche iche na alaeze niile, ihopu na ikwada, ịla nʼiyi na ịtịkpọkwa ha, i wulite ma kụọkwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.11",
                "verseOrgIds": [
                  "JER.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere m, na-asị, \"Jeremaya, gịnị ka ị na-ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:11"
      },
      "items": [
        {
          "text": "Azara m sị, \"Ana m ahụ otu alaka osisi alụmọnd.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.12",
                "verseOrgIds": [
                  "JER.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Ị hụrụ nke ọma, nʼihi na m na-eche okwu ọnụ ịhụ m na m mezuru ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.13",
                "verseOrgIds": [
                  "JER.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere m nke ugboro abụọ na-asị, \"Gịnị ka ị na-ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:13"
      },
      "items": [
        {
          "text": "A sịrị m, \"Ana m ahụ ite mmiri ọkụ, nke na-agbọ agbọ, nke e mere ka o hulata chee ọnụ ya na ndịda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.14",
                "verseOrgIds": [
                  "JER.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Ihe egwu ga-esite nʼugwu bịakwasị ndị niile bi nʼala a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, ana m akpọku ndị niile bi nʼalaeze dị nʼugwu,\" otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.15",
                "verseOrgIds": [
                  "JER.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "\"Ndị eze ha ga-abịa doo ocheeze ha",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "nʼọnụ ụzọ ama e si abata Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "imegide ogologo mgbidi nke obodo ahụ gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "na imegidekwa obodo niile nke Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ekwupụta ikpe niile m megide ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:16"
      },
      "items": [
        {
          "text": "nʼihi ajọ omume ha niile nʼịgbakụta m azụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:16"
      },
      "items": [
        {
          "text": "na isure ihe nsure ọkụ na-esi isi ụtọ nye chi ndị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:16"
      },
      "items": [
        {
          "text": "nakwa ịkpọ isiala nye ihe ndị ahụ niile ha ji aka ha kpụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bilie ọtọ, jikere onwe gị, ka ị pụọ gaa gwa ha ihe ọbụla m nyere gị nʼiwu. Atụkwala ụjọ ha, ma ọ bụghị ya, aga m emenye gị egwu nʼihu ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.17",
            "verseOrgIds": [
              "JER.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na lee, site taa gaa nʼihu emeela m gị ka ị dịrị ka obodo e wusiri ike. Ị dịkwa ka mgbidi e ji igwe kpụọ, na dịka ibo e ji ọla dị arọ kpụọ, iguzogide ala ahụ niile. Iguzogide ndị eze Juda niile, ndịisi ala Juda niile, na ndị nchụaja niile, na ndị mmadụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.18",
            "verseOrgIds": [
              "JER.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-agbalị ka ha megide gị, ma ha agaghị emeri gị. Nʼihi na mụ onwe m nọnyeere gị, aga m anapụtakwa gị.\" Otu ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.19",
            "verseOrgIds": [
              "JER.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.19",
                "verseOrgIds": [
                  "JER.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.19",
            "verseOrgIds": [
              "JER.1.19"
            ]
          }
        }
      ]
    }
  ],
