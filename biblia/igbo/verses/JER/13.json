      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:18"
      },
      "items": [
        {
          "text": "\"Sitenụ nʼocheeze unu rịdata,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:18"
      },
      "items": [
        {
          "text": "nʼihi na okpueze ọma unu",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        }
