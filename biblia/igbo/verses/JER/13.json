            "sid": "JER 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị ka ị ga-asị mgbe",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.21",
                "verseOrgIds": [
                  "JER.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka ndị ahụ ị gụrụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:21"
      },
      "items": [
        {
          "text": "dịka ndị enyi gị bịa buso gị agha?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:21"
      },
      "items": [
        {
          "text": "Ihe mgbu nke ga-abịakwasị gị",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:21"
      },
      "items": [
        {
          "text": "ọ gaghị adị ka ihe mgbu na-abịakwasị nwanyị ime na-eme?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ị ga-ajụkwa obi gị ajụjụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:22"
      },
      "items": [
        {
          "text": "\"Gịnị mere ihe ndị a ji dakwasị m?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:22"
      },
      "items": [
        {
          "text": "Ọ bụ nʼihi ịba ụba nke mmehie gị",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:22"
      },
      "items": [
        {
          "text": "ka e ji dọwaa uwe mwụda gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:22"
      },
      "items": [
        {
          "text": "merụọ gị ahụ nʼakụkụ ahụ gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.22",
            "verseOrgIds": [
              "JER.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Kush ọ pụrụ ịgbanwe akpụkpọ ahụ ya?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:23"
      },
      "items": [
        {
          "text": "Agụ ọ pụrụ ịgbanwe akpụkpọ ahụ ya tụrụ agwa agwa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:23"
      },
      "items": [
        {
          "text": "Nʼụzọ dị otu a kwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:23"
      },
      "items": [
        {
          "text": "unu ndị ihe ọjọọ riri ahụ apụghị ime ezi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.23",
            "verseOrgIds": [
              "JER.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m efesasị unu dịka ahịhịa ọka kpọrọ nkụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.24",
            "verseOrgIds": [
              "JER.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:24"
      },
      "items": [
        {
          "text": "nke oke ifufe si nʼọzara na-ebugharị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.24",
            "verseOrgIds": [
              "JER.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe unu fetara na nza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:25"
      },
      "items": [
        {
          "text": "oke nke m kwadoro si nʼaka m inye unu.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
