      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:20"
      },
      "items": [
        {
          "text": "igwe ewu na atụrụ ahụ unu ji na-anya isi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
