      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:20"
      },
      "items": [
        {
          "text": "ka unu hụrụ ndị ahụ si nʼugwu na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:20"
      },
      "items": [
        {
          "text": "Ebee ka igwe ewu na atụrụ ndị ahụ e tinyere unu nʼaka nọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        }
      ]
    },
