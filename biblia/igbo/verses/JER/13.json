      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "nʼihi mpako unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "Anya mmiri ga-esi m nʼanya pụta;",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
