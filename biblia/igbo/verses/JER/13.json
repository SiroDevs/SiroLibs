          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-emechi obodo niile nke Negeb.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:19"
      },
      "items": [
        {
          "text": "Ọ dịkwaghị onye ga-emeghe ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 13:19"
      },
      "items": [
        {
          "text": "A ga-adọtakwa Juda niile nʼagha",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        }
      ]
    },
