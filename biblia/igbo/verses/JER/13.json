      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:19"
      },
      "items": [
        {
          "text": "buru ha kpamkpam buga ha nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
