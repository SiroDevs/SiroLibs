      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "anya mmiri ga-esi na ya na-eruda nke ukwuu",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
