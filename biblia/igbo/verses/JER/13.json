      "attrs": {
        "style": "q2",
        "vid": "JER 13:17"
      },
      "items": [
        {
          "text": "Ọ bụ na nzuzo ka m ga-anọ kwaa akwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.17",
            "verseOrgIds": [
              "JER.13.17"
            ]
          }
        }
