          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwanụ eze na nne eze okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.18",
            "verseOrgIds": [
              "JER.13.18"
            ]
          }
        }
