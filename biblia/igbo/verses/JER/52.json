  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "52",
        "style": "c",
        "sid": "JER 52"
      },
      "items": [
        {
          "text": "52",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndọta nʼagha a dọtara Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekaya gbara iri afọ abụọ na otu mgbe ọ malitere ịbụ eze. Ọ chịrị dị ka eze na Jerusalem afọ iri na otu. Aha nne ya bụ Hamutal nwa Jeremaya, onye Libna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.1",
            "verseOrgIds": [
              "JER.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe jọrọ njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.2",
                "verseOrgIds": [
                  "JER.52.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka Jehoiakim mere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.2",
            "verseOrgIds": [
              "JER.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼihi iwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.3",
                "verseOrgIds": [
                  "JER.52.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ihe ndị a niile ji bịakwasị Jerusalem na Juda. Nʼikpeazụ, o sitere nʼihu ya chụpụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:3"
      },
      "items": [
        {
          "text": "Nʼoge a, Zedekaya nupuru isi nʼokpuru eze Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.3",
            "verseOrgIds": [
              "JER.52.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, nʼafọ nke itoolu, nke ọchịchị Zedekaya, nʼụbọchị nke iri nʼọnwa nke iri, nke afọ ahụ, Nebukadneza, eze Babilọn, duuru usuu ndị agha ya niile bịa ibuso Jerusalem agha. Ha mara ụlọ ikwu ndị agha nʼazụ obodo ahụ, wuokwa mgbidi nnọchibido gburugburu obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.4",
            "verseOrgIds": [
              "JER.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọchibidoro obodo a nʼagha ruo nʼafọ nke iri na otu nke ọchịchị eze Zedekaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.5",
            "verseOrgIds": [
              "JER.52.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị nke itoolu, nke ọnwa anọ nʼafọ ahụ, oke ụnwụ siri ike dị nʼobodo ahụ ruo na ọ dịkwaghị nri dị nke ndị mmadụ ga-eri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.6",
            "verseOrgIds": [
              "JER.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, e tipuru oghere nʼaja mgbidi obodo ahụ, ndị agha niile ji abalị gbapụ site nʼọnụ ụzọ ama nke dị nʼetiti mgbidi abụọ nʼakụkụ ubi eze a gbara ogige, nʼagbanyeghị na ndị Babilọn",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "text": "nọ obodo ahụ gburugburu. Ha gbapụrụ chee ihu nʼụzọ Araba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.7",
            "verseOrgIds": [
              "JER.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma usuu ndị agha Babilọn",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "text": "chụsoro Zedekaya bụ eze nʼazụ, chụkwute ya na mbara ala Jeriko. Ndị agha ya niile sitere nʼebe ọ nọ gbasasịa, hapụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.8",
            "verseOrgIds": [
              "JER.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "e jide ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:9"
      },
      "items": [
        {
          "text": "Ha kpụgara ya eze Babilọn, nʼobodo Ribla, nke dị nʼala Hamat, ebe a nọ maa ya ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.9",
            "verseOrgIds": [
              "JER.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ribla ka eze Babilọn nọ gbuo ụmụ ndị ikom Zedekaya niile, nʼihu ya, o gbukwara ndịisi ọchịchị Juda niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.10",
            "verseOrgIds": [
              "JER.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ghụpụrụ anya Zedekaya abụọ, jiri ụdọ bronz kee ya agbụ, kpụrụ ya gaa Babilọn, ebe o tinyere ya nʼụlọ mkpọrọ tutu ruo ụbọchị ọnwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.11",
            "verseOrgIds": [
              "JER.52.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke iri, nʼọnwa nke ise, nke afọ iri na itoolu, nke ọchịchị Nebukadneza eze Babilọn, Nebuzaradan ọchịagha ndị nche eze, onye na-ejere eze Babilọn ozi, bịarutere Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.12",
            "verseOrgIds": [
              "JER.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sunyere ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.13",
                "verseOrgIds": [
                  "JER.52.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ọkụ, ụlọeze na ụlọ niile dị na Jerusalem, ụlọ ọbụla bụ nke dị mkpa ka o surere ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.13",
            "verseOrgIds": [
              "JER.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuu ndị agha Kaldịa niile bụ ndị nọ nʼokpuru onyeisi ndị nche eze ahụ, kwaturu mgbidi ahụ niile gbara Jerusalem gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.14",
            "verseOrgIds": [
              "JER.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradan, ọchịagha ndị nche eze, buru ụfọdụ nʼime ndị dakarịsịrị nʼogbenye na ndị fọdụrụ nʼime obodo ahụ, ha na ndị ǹka niile fọdụrụ, na ndị ahụ ji aka ha gbakwuru eze Babilọn, bulaa ha Babilọn, ka ha ga biri nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.15",
            "verseOrgIds": [
              "JER.52.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 52:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Nebuzaradan, hapụrụ ndị ahụ bụ nnọọ ndị ogbenye ọnụ ntụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        },
        {
          "text": "ka ha na-elekọta ubi vaịnị niile a gbara ogige na ala ubi niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.16",
            "verseOrgIds": [
              "JER.52.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 52:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Babilọn tipịara ogidi bronz niile, ha na ihe ndọkwasị niile na Oke osimiri bronz ndị ahụ dị nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.17",
                "verseOrgIds": [
                  "JER.52.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", buru bronz ahụ niile bulaa Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.17",
            "verseOrgIds": [
              "JER.52.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 52:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha chịkọọrọ ite niile, na shọvel niile na ihe ịkpakepụ ọkụ niile, na efere ịkwọsa mmiri niile, na ngaji ukwu niile, na ihe bronz niile, bụ nke e ji eje ozi nʼime ụlọnsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.18",
            "verseOrgIds": [
              "JER.52.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 52:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchịagha ndị nche eze ahụ sikwa nʼụlọnsọ ahụ chịrị ihe ndị a: efere ukwu niile, ihe ịgụnye ọkụ niile, efere ịkwọsa mmiri niile, ite niile, ihe ịdọkwasị oriọna niile, ngaji ukwu niile na iko e ji enye onyinye ihe ọṅụṅụ, ya bụ ihe ndị ahụ niile e ji ọlaedo a nụchara anụcha maọbụ ọlaọcha kpụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.19",
            "verseOrgIds": [
              "JER.52.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 52:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O burukwara bronz sitere nʼogidi abụọ ahụ, oke Osimiri ahụ na ehi iri na abụọ e ji bronz kpụọ, bụ nke dị nʼokpuru ya, na ihe ndọkwasị ya niile, nke eze bụ Solomọn mere nʼihi ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.52.20",
                "verseOrgIds": [
                  "JER.52.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha karịrị ihe a ga-eji ihe ọtụtụ tụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.20",
            "verseOrgIds": [
              "JER.52.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 52:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị dị elu nke otu nʼime ogidi abụọ ndị a bụ mita asatọ na ụma",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "text": "nʼọtụtụ. Ị dị gburugburu ya bụkwa mita ise na ụma anọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "text": "nke ọbụla nʼime ha bụ mkpịsịaka anọ. Oghere dịkwa nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.21",
            "verseOrgIds": [
              "JER.52.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 52:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi bronz nke e kpụkwasịrị nʼotu ogidi dị mita abụọ na ụma atọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "text": "nʼịdị elu. Ọ bụkwa ihe yiri mkpụrụ pomegranet e ji bronz kpaa, ka e ji chọọ ya mma gburugburu ya niile. Ogidi nke abụọ nwekwara pomegranet, yiri ibe ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.22",
            "verseOrgIds": [
              "JER.52.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 52:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomegranet ndị ahụ dị iri itoolu na isii, ọ bụkwa nʼakụkụ ọbụla ka ọ dị. Ọnụọgụgụ pomegranet niile dị nʼelu ihe ahụ a kpụrụ akpụ dị otu narị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.23",
            "verseOrgIds": [
              "JER.52.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 52:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchịagha ndị nche eze ahụ, kpụụrụ Seraya, onyeisi nchụaja, na Zefanaya, bụ onye nchụaja na-esote ya nʼọkwa, na ndị nche atọ na-eche ọnụ ụzọ mbata dịka ndị mkpọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.24",
            "verseOrgIds": [
              "JER.52.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 52:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼetiti ndị ahụ fọdụrụ nʼobodo kpụụrụ otu onyeisi na-ahụ maka ndị agha, na ndị ikom asaa na-enye eze ndụmọdụ. O kpukwaara ode akwụkwọ, onye isi ọrụ na-ahụ maka ịmanye ndị ga-aga agha, jidekwa iri ndị ikom isii bụ ndị a hụrụ nʼime obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.25",
            "verseOrgIds": [
              "JER.52.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 52:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradan, bụ ọchịagha kpụụrụ ha niile, dute ha nʼihu eze Babilọn na Ribla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.26",
            "verseOrgIds": [
              "JER.52.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 52:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ na Ribla, dị nʼobodo Hamat, ka eze nọ nye iwu ka e gbuo ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 52:27"
      },
      "items": [
        {
          "text": "Ya mere, a dọọrọ Juda nʼagha, mee ka ọ ga biri nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 52:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ọnụọgụgụ ndị ahụ Nebukadneza mere ka ha gaa biri nʼala ọzọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 52:28"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JER 52:28"
      },
      "items": [
        {
          "text": "Nʼafọ nke asaa nke ọchịchị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:28"
      },
      "items": [
        {
          "text": "puku atọ ndị Juu na iri abụọ na atọ, 3,023.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.28",
            "verseOrgIds": [
              "JER.52.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 52:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na asatọ nke ọchịchị Nebukadneza,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:29"
      },
      "items": [
        {
          "text": "ka o mere ka narị mmadụ asatọ na iri atọ na abụọ, 832 si na Jerusalem gaa biri nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.29",
            "verseOrgIds": [
              "JER.52.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 52:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri abụọ na atọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Nebuzaradan, onyeisi ndị nche alaeze Babilọn bulara ndị dị narị ndị Juu asaa na iri anọ na ise, 745 ka ha ga biri nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.30",
            "verseOrgIds": [
              "JER.52.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 52:30"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JER 52:30"
      },
      "items": [
        {
          "text": "Ọnụọgụgụ ha niile dị puku anọ na narị isii, 4,600.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakin enwere onwe ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 52:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri atọ na asaa, site na mgbe e mere ka Jehoiakin eze Juda gaa biri nʼala ọzọ, nʼafọ Awel-Maduk ghọrọ eze Babilọn. Mgbe ahụ, o mere ka Jehoiakin eze Juda, si nʼụlọ mkpọrọ pụta, nwere onwe ya. O mere nke a nʼụbọchị iri abụọ na ise nke ọnwa iri na abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.31",
            "verseOrgIds": [
              "JER.52.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 52:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ya okwu ọma, nyekwa ya ọnọdụ ugwu dị elu karịa ọnọdụ ndị eze ndị ọzọ niile ha na ya nọ na Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.32",
            "verseOrgIds": [
              "JER.52.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 52:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Jehoiakin gbanwere uwe mkpọrọ ya, wezuga ya. Sitekwa nʼoge ahụ tutu ruo mgbe ọ nwụrụ, ya na eze na-erikọ nri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.33",
            "verseOrgIds": [
              "JER.52.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 52:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụbọchị ruo nʼụbọchị, eze Babilọn na-enye Jehoiakin oke ihe ruru ya kwa ụbọchị niile nke ọ dị ndụ, ruokwa nʼụbọchị ọnwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.34",
            "verseOrgIds": [
              "JER.52.34"
            ]
          }
        }
      ]
    }
  ],
