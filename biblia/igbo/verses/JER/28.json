  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JER 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hananaya onye amụma ụgha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo, nʼọnwa nke ise nke otu afọ ahụ, nke bụ afọ nke anọ, na mmalite ọchịchị Zedekaya eze Juda, Hananaya, nwa Azoa, onye amụma si Gibiọn, gwara m okwu nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.1",
                "verseOrgIds": [
                  "JER.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼihu ndị nchụaja na ndị mmadụ si m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.1",
            "verseOrgIds": [
              "JER.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.2",
                "verseOrgIds": [
                  "JER.28.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, 'Aga m agbaji agbụ nke eze Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.2",
            "verseOrgIds": [
              "JER.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupu afọ abụọ agabiga, aga m esi Babilọn bulata ihe ndị ahụ niile Nebukadneza eze Babilọn si nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.3",
                "verseOrgIds": [
                  "JER.28.3"
                ]
              }
            }
          ]
        },
        {
          "text": "bupụ bulaa Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.3",
            "verseOrgIds": [
              "JER.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m akpọlatakwa Jehoiakin nwa Jehoiakim, na ndị niile ọzọ e si na Juda dọta nʼagha bulaa Babilọn, nʼihi na aga m agbaji agbụ ahụ eze Babilọn nyanyere ha nʼolu.' \" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.4",
                "verseOrgIds": [
                  "JER.28.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.4",
            "verseOrgIds": [
              "JER.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jeremaya onye amụma zara Hananaya onye amụma nʼihu ndị nchụaja na ndị mmadụ niile guzo nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.5",
                "verseOrgIds": [
                  "JER.28.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.5",
            "verseOrgIds": [
              "JER.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremaya onye amụma sịrị, \"Amen!",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.6",
                "verseOrgIds": [
                  "JER.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "mezuo okwu amụma a i buru site na ibughachite ngwongwo ụlọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.6",
                "verseOrgIds": [
                  "JER.28.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na ịkpọghachite ndị niile e mere ka ha si nʼebe a gaa biri na Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.6",
            "verseOrgIds": [
              "JER.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gee ntị nụrụ ihe m ga-ekwu nʼihu gị na nʼihu ndị a niile guzo nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.7",
            "verseOrgIds": [
              "JER.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na mgbe ochie, ndị amụma ahụ bu mụ na gị ụzọ ebuola amụma banyere agha na mbibi na ọrịa na-efe efe megide ọtụtụ obodo dị iche iche, na ọtụtụ alaeze dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.8",
            "verseOrgIds": [
              "JER.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe e ji amata na ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.9",
                "verseOrgIds": [
                  "JER.28.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼezie, zitere onye amụma buru amụma kwuo na udo ga-adị, bụ naanị ma ọ bụrụ na amụma ya emezuo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.9",
            "verseOrgIds": [
              "JER.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Hananaya bụ onye amụma yipụrụ Jeremaya agbụ ahụ o yikwasịrị onwe ya nʼolu gbajie ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.10",
            "verseOrgIds": [
              "JER.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị nʼihu ọha mmadụ ahụ niile, \"Nke a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.11",
                "verseOrgIds": [
                  "JER.28.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: 'Ọ bụ nʼotu aka ahụ ka m ga-agbajipụkwa agbụ ịyagba Nebukadneza, eze Babilọn nyanyere nʼolu mba niile tupu afọ abụọ agabiga.' \" Mgbe o kwuru otu a, Jeremaya onye amụma hapụrụ ebe ahụ laa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.11",
            "verseOrgIds": [
              "JER.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hananaya bụ onye amụma gbajisiri ịyagba",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "text": "ahụ Jeremaya, onye amụma nyanyere onwe ya nʼolu, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.12",
                "verseOrgIds": [
                  "JER.28.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Jeremaya ntị sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.12",
            "verseOrgIds": [
              "JER.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaa gwa Hananaya okwu sị ya, 'Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.13",
                "verseOrgIds": [
                  "JER.28.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Ị gbajiela agbụ e ji osisi mee, ma nʼọnọdụ ya ihe ị ga-enweta bụ agbụ igwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.13",
            "verseOrgIds": [
              "JER.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.14",
                "verseOrgIds": [
                  "JER.28.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel, kwuru. Aga m anyanye mba ndị a niile agbụ igwe, i mee ka ha fee Nebukadneza eze Babilọn. Ha ga-efekwa ya. Aga m enyekwa ya ike ọ bụladị nʼebe ụmụ anụ ọhịa dị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.14",
            "verseOrgIds": [
              "JER.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jeremaya onye amụma sịrị Hananaya onye amụma, \"Gee ntị, Hananaya! Ọ bụghị",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.15",
                "verseOrgIds": [
                  "JER.28.15"
                ]
              }
            }
          ]
        },
        {
          "text": "zitere gị, ma ị ghọgbuola mba a mee ka ha tụkwasị uche nʼokwu ụgha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.15",
            "verseOrgIds": [
              "JER.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.16",
                "verseOrgIds": [
                  "JER.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Ekpebiela m isite nʼụwa wepụ gị. Ị ga-anwụ nʼafọ a, nʼihi na i kwusaala nnupu isi megide",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.28.16",
                "verseOrgIds": [
                  "JER.28.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.28.16",
            "verseOrgIds": [
              "JER.28.16"
            ]
          }
        }
      ]
