      "attrs": {
        "style": "q2",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "ga-esite nʼotu nsọtụ ala ahụ ruo na nsọtụ nke ọzọ, ripịa ndị niile dị na ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
