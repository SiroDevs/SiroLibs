      "attrs": {
        "style": "q2",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "nʼelu ebe niile dị elu nke ọzara,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
