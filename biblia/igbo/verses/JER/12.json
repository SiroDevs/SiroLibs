      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:12"
      },
      "items": [
        {
          "text": "O nweghị onye ọbụla udo ga-adịrị nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
