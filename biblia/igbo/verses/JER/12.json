          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha emeela ya ka ọ ghọọ ebe tọgbọrọ nʼefu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
