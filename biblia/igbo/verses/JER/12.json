      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:11"
      },
      "items": [
        {
          "text": "Ala ahụ niile ga-atọgbọrọkwa nʼefu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
