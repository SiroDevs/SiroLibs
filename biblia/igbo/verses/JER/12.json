          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-agha mkpụrụ ọka wiiti, maọbụ ogwu ga-epuru ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "Ha ga-adọgbu onwe ha nʼọrụ ma ha agaghị enweta ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "Ya mere, ka ihe ihere unu ghọtara dịka ihe ubi dịrị unu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        }
      ]
    },
    {
