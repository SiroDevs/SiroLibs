  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "JER 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpesa Jeremaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ezi omume ka ị bụ mgbe niile, gị",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.12.1",
                "verseOrgIds": [
                  "JER.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "mgbe ọbụla m butere ikpe bịa nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Ma achọrọ m ịgwa gị okwu banyere ikpe ziri ezi gị:",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Gịnị mere ihe ji agara ndị ajọ omume nke ọma?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:1"
      },
      "items": [
        {
          "text": "Gịnị mere ndị na-aghọ aghụghọ ji ebi ndụ enweghị nsogbu ọbụla?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị kụọla ha ka osisi, ha agbaala mgbọrọgwụ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "ha na-etokwa na-amị mkpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "Ị nọ nso mgbe niile nʼọnụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:2"
      },
      "items": [
        {
          "text": "ma ị nọ nʼebe dị anya nʼobi ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.2",
            "verseOrgIds": [
              "JER.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị onwe gị maara m",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.12.3",
                "verseOrgIds": [
                  "JER.12.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "ị na-ahụ m, na-anwapụtakwa echiche niile m na-eche banyere gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Dọkpụrụ ha dịka atụrụ a ga-egbu egbu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:3"
      },
      "items": [
        {
          "text": "Doo ha iche nye ụbọchị ahụ a ga-egbu ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.3",
            "verseOrgIds": [
              "JER.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruo ole mgbe ka ala ga-eru ụjụ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka ahịhịa dị nʼubi ga-anọgide na-akpọnwụ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Ụmụ anụmanụ na nnụnụ na-anwụchasị",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "nʼihi na ndị bi nʼala ahụ bụ ndị na-emebi iwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "Ma ndị mmadụ ahụ na-ekwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:4"
      },
      "items": [
        {
          "text": "\"Ọ gaghị ahụ ihe ga-adakwasị anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.4",
            "verseOrgIds": [
              "JER.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọsịsa Chineke nyere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ndị ji ụkwụ ha agba ọsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "emerie gị nʼọsọ nke gị na ha gbara,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "i si aṅaa chee na gị na ndị ji ịnyịnya agba ọsọ nwere ike ịgbakọta ọsọ ịsọ mpi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "Ọ bụrụ na ị sọọ ngọngọ nʼala ebe udo dị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:5"
      },
      "items": [
        {
          "text": "ị ga-esi aṅaa ghara ịsọ ngọngọ nʼọhịa dị nʼakụkụ osimiri Jọdan?",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.5",
            "verseOrgIds": [
              "JER.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, ọ bụladị ụmụnne gị, ndị ezinaụlọ nke aka gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "ararala gị nye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "Lee, ha eweliela oke olu iti mkpu megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "Atụkwasịla ha obi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:6"
      },
      "items": [
        {
          "text": "ọ bụladị mgbe ha na-ekwu okwu ọma banyere gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.6",
            "verseOrgIds": [
              "JER.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m agbakụta ụlọ m",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "na ihe nketa m họpụtara nye onwe m azụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "Aga m ewere onye ahụ m hụrụ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:7"
      },
      "items": [
        {
          "text": "nyefee ya nʼaka onye iro ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nketa m aghọrọọla m,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "ihe dịka ọdụm nọ nʼọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "Ọ na-agbọ ụja megide m;",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:8"
      },
      "items": [
        {
          "text": "ya mere, m ji kpọọ ya asị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ihe nketa m aghọbeghị",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
