      "attrs": {
        "style": "q1",
        "vid": "JER 12:10"
      },
      "items": [
        {
          "text": "ha emeela ka ubi m mara mma",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
