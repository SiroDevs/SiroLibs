          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ ndị ọzụzụ atụrụ ebibiela ubi vaịnị m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
