      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:10"
      },
      "items": [
        {
          "text": "Ha azọtọọla ubi m nʼokpuru ụkwụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
