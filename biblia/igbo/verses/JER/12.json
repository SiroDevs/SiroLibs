      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:11"
      },
      "items": [
        {
          "text": "e, ọ ghọọla ebe kpọrọ nkụ nʼebe tọgbọrọ nʼefu nʼihu m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        }
