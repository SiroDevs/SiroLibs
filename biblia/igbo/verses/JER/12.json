      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 12:13"
      },
      "items": [
        {
          "text": "nʼihi na ahụhụ ndị a sitere nʼiwe dị ọkụ nke",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
