  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "LUK 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu maka onyeisi ọrụ nwere uche",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ndị na-eso ụzọ ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.1",
            "verseOrgIds": [
              "LUK.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Otu ọgaranya nwere otu onyeisi ọrụ nke e boro ebubo na ọ na-ala akụ ya nʼiyi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.1",
                "verseOrgIds": [
                  "LUK.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.1",
            "verseOrgIds": [
              "LUK.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere ọ kpọrọ ya sị ya, 'Gịnị bụ ihe a m na-anụ banyere gị? Gbakọọrọ m otu i si na-elekọta akụ m, nʼihi na achọkwaghị m ka ị bụrụ onyeisi ọrụ ọzọ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.2",
                "verseOrgIds": [
                  "LUK.16.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onyeisi ọrụ ahụ sịrị onwe ya, 'Gịnị ka m ga-eme ugbu a nna m ukwu na-achọ ịkwụsị m ọrụ? Ike igwu ala adịghị m, ihere agakwaghị ekwe m ịrịọ arịrịọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.3",
                "verseOrgIds": [
                  "LUK.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.3",
            "verseOrgIds": [
              "LUK.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amatala m ihe m ga-eme, nke a ga-enyere m aka ma ọ bụrụ na a chụpụ m nʼọrụ nʼebe a, aga m enweta ndị ga-anabata m nʼụlọ ha.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.4",
                "verseOrgIds": [
                  "LUK.16.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya mere ọ kpọrọ ndị niile ji nna ya ukwu ụgwọ nʼotu nʼotu. Ọ jụrụ onye nke mbụ sị, 'Ego ole bụ ụgwọ i ji nna m ukwu?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.5",
                "verseOrgIds": [
                  "LUK.16.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ sịrị ya, 'Ọ bụ puku karama mmanụ oliv ka m ji ụgwọ ya.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.6",
                "verseOrgIds": [
                  "LUK.16.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 16:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onyeisi ọrụ ahụ gwara ya sị, 'Ngwangwa, were akwụkwọ degharịa ya narị karama ise.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.6",
                "verseOrgIds": [
                  "LUK.16.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ahụ, ọ jụrụ onye nke abụọ sị, 'Ego ole bụ ụgwọ i ji?'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.7",
                "verseOrgIds": [
                  "LUK.16.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 16:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ sịrị ya, 'Ọ bụ narị akpa ọka wiiti.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.7",
                "verseOrgIds": [
                  "LUK.16.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 16:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ sịrị ya, 'Ngwangwa degharịa ya iri akpa ọka wiiti asatọ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.7",
                "verseOrgIds": [
                  "LUK.16.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna ya ukwu toro onyeisi ọrụ ahụ na-ekwesighị ntụkwasị obi nʼihi na ọ kpara agwa dị ka onye nwere uche. Nʼihi na ụmụ, nke ọgbọ a, ji akọnuche na-eso ndị ọgbọ ha karịa ụmụ nke ìhè.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.8",
                "verseOrgIds": [
                  "LUK.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.8",
            "verseOrgIds": [
              "LUK.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Agwa m unu, jirinụ akụnụba nke ajọ omume metara onwe unu ndị enyi, ka ọ ga-abụ na mgbe ọ na-adịghịkwa akụ unu nwere, ha ga-anabata unu nʼụlọ obibi ha ebighị ebi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.9",
                "verseOrgIds": [
                  "LUK.16.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ọbụla kwesiri ntụkwasị obi nʼihe dị ntakịrị, ga-ekwesikwa ntụkwasị obi nʼihe dị ukwuu. Onye na-ekwesikwaghị ntụkwasị obi nʼihe dị ntakịrị, agaghịkwa ekwesi ntụkwasị obi nʼihe dị ukwuu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.10",
                "verseOrgIds": [
                  "LUK.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.10",
            "verseOrgIds": [
              "LUK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na unu abụghị ndị kwesiri ntụkwasị obi nʼakụ mmehie nke ụwa, onye ga-enyekwa ezi akụ nʼaka unu na ntụkwasị obi idebe?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.11",
                "verseOrgIds": [
                  "LUK.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.11",
            "verseOrgIds": [
              "LUK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụkwa na unu abụghị ndị kwesiri ntụkwasị obi nʼakụ onye ọzọ, onye ga-enye unu ihe nke bụ nke unu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.12",
                "verseOrgIds": [
                  "LUK.16.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dịghị onye ọbụla pụrụ ife nna ukwu abụọ, nʼihi na ọ ga-achọ ịhụ otu nʼime ha nʼanya, kpọkwa nke ọzọ asị, maọbụ, sọpụrụ otu ma lelịa nke ọzọ anya. Otu a kwa i nweghị ike ife Chineke na akụ otu mgbe ahụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.13",
                "verseOrgIds": [
                  "LUK.16.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Farisii, bụ ndị hụrụ ego nʼanya nụrụ ihe ndị a, ha jiri ya mee ihe ọchị.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu na-egosi onwe unu dị ka ndị ezi omume nʼihu ndị mmadụ ma Chineke maara obi unu. Nʼihi na ihe ndị mmadụ na-akpọ ihe dị oke mkpa bụ ihe rụrụ arụ nʼanya Chineke.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.15",
                "verseOrgIds": [
                  "LUK.16.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ozizi ndị ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iwu na ndị amụma nọ na-achị ruo oge Jọn bịara. Site nʼoge ahụ, a na-ekwusa oziọma nke alaeze Chineke, onye ọbụla na-ejikwa ike na-abanye nʼime ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.16",
                "verseOrgIds": [
                  "LUK.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ dị mfe ka eluigwe na ụwa gabiga karịa na a ga-ewepụ otu kpọm, site nʼihe niile dị nʼiwu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.17",
                "verseOrgIds": [
                  "LUK.16.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onye ọbụla gbara nwunye ya alụkwaghị m ma lụrụ nwanyị ọzọ na-eme mmehie ịkwa iko. Onye ọ bụlakwa lụrụ nwanyị di ya jụrụ na-eme mmehie ịkwa iko.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.18",
                "verseOrgIds": [
                  "LUK.16.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye ọgaranya na Lazarọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dị otu ọgaranya na-eyi uwe odo odo na ezi akwa ọcha, na-erikwa nri dị mma ụbọchị niile.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.19",
                "verseOrgIds": [
                  "LUK.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼọnụ ụzọ ụlọ ya, otu nwoke onye ogbenye nke ọnya juru ahụ ya na-edina nʼebe ahụ. Aha ya bụ Lazarọs",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.20",
                "verseOrgIds": [
                  "LUK.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ na-agụsị ya agụụ ike iri iberibe nri si na tebul ọgaranya ahụ daa nʼala. Ọ bụladị ụmụ nkịta na-abịa na-aracha ọnya dị ya nʼahụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.21",
                "verseOrgIds": [
                  "LUK.16.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe onye ogbenye ahụ nwụrụ, ndị mmụọ ozi bịara buru ya gaa nʼebe Ebraham nọ. Onye ọgaranya ahụ nwụkwara, e lie ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.22",
                "verseOrgIds": [
                  "LUK.16.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼọkụ ala mmụọ ebe onye ọgaranya ahụ nọ nʼoke ihe mgbu, ọ hụrụ Ebraham ka ọ nọ nʼebe dị anya, hụkwa Lazarọs nʼakụkụ ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.23",
                "verseOrgIds": [
                  "LUK.16.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
            "verseOrgIds": [
              "LUK.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ kpọkuru Ebraham sị ya, 'Nna m Ebraham, meere m ebere nʼihi na anọ m nʼoke ihe mgbu nʼime ọkụ a. Biko zienụ Lazarọs ka ọ denye mkpịsịaka ntakịrị ya na mmiri bịa mejụọ ire m.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.24",
                "verseOrgIds": [
                  "LUK.16.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma Ebraham sịrị ya, 'Nwa m, chetakwa na ị nara ezi ihe gị mgbe ị dị ndụ, ebe Lazarọs nara ihe ọjọọ. Ma ugbu a, a na-akasị ya obi nʼebe a ma gị onwe gị nọkwa nʼahụhụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.25",
                "verseOrgIds": [
                  "LUK.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
            "verseOrgIds": [
              "LUK.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A sịkwarị na anyị achọọ inyere gị aka, ọ gaghị ekwe mee nʼihi na e nwere olulu dị ukwuu kewara anyị na unu. Mmadụ ọbụla enwekwaghị ike isite nʼebe a bịa nʼebe unu nọ, ọ dịkwaghị onye nwere ike isite nʼebe ahụ unu nọ bịa nʼebe a.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.26",
                "verseOrgIds": [
                  "LUK.16.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ sịrị, 'Ya mere, arịọ m gị nna, ziganụ ya nʼụlọ nna m,",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.27",
                "verseOrgIds": [
                  "LUK.16.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nʼihi na enwere m ụmụnne nwoke ise. Ka ọ dọọ ha aka na ntị ka ha ghara ịbịa nʼebe a mmekpa ahụ dị.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.28",
                "verseOrgIds": [
                  "LUK.16.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ebraham sịrị, 'Ha nwere Mosis na ndị amụma, ha gee ha ntị.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.29",
                "verseOrgIds": [
                  "LUK.16.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma o kwuru, 'Nna Ebraham, nke ahụ agaghị ezu! A sị na otu onye ga-esi nʼala ndị nwụrụ anwụ gakwuru ha, ha ga-echegharị.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.30",
                "verseOrgIds": [
                  "LUK.16.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ sịrị ya, 'Ọ bụrụ na ha egeghị Mosis na ndị amụma ntị, ha agaghị ekwenye ma a sịkwarị na mmadụ esi nʼọnwụ bilie.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.16.31",
                "verseOrgIds": [
                  "LUK.16.31"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
