      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:13"
      },
      "items": [
        {
          "text": "ndị na-asị, \"Ọ bụghị site nʼike aka anyị ka anyị nwetakwara Kanaịm?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.13",
            "verseOrgIds": [
              "AMO.6.13"
            ]
          }
        }
