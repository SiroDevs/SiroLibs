              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ndị na-aṅụrị ọṅụ nʼihi na unu meriri obodo Lo Deba,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.13",
            "verseOrgIds": [
              "AMO.6.13"
            ]
          }
        }
      ]
    },
