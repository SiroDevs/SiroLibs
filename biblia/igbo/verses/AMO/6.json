  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "AMO 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahụhụ dịrị ndị na-ebi ndụ dị jụụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịrị ndị ahụ na-enweghị nsogbu nʼime Zayọn,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "na ndị ahụ na-ebi nʼizuoke nʼugwu Sameria,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "bụ ndị a maara aha ha na isi mba nke mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "ndị agbụrụ Izrel niile na-abịakwute.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaanụ Kalne, ka unu lee ya anya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "site nʼebe ahụ unu jeruo Hamat, obodo ukwu ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "mgbe ahụ unu gbada jeruokwa Gat nke dị na Filistia",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Ha ọ kacha alaeze abụọ unu mma?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Ka ala ha ọ karịrị ndị nke unu?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na-ewezuga ụbọchị ọjọọ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:3"
      },
      "items": [
        {
          "text": "ma na-eme ka ụbọchị ihe ike bịa ngwangwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azịgba unu ndị na-edina nʼelu akwa ọdụ enyi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "na-agbatị onwe ha nʼelu ihe ndina ha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "na-erikwa anụ ụmụ atụrụ dị mma",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "na ụmụ ehi e mere ka ha gbaa abụba.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-abụ abụ nke na-abaghị nʼụda ụbọ akwara,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:5"
      },
      "items": [
        {
          "text": "ma were aka ha rụọra onwe ha ngwa egwu dịka Devid mere.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na-aṅụ mmanya site nʼọba;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "na-ete mmanụ makarịsịrị mma,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "ma ịla nʼiyi nke Josef adịghị ewute ha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, unu ga-abụ ndị a ga-ebu ụzọ mee ka ha jee biri nʼala ndị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:7"
      },
      "items": [
        {
          "text": "Na mberede, oke oriri unu na idina ala setịa onwe unu ga-akwụsị.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mpako bụ ihe arụ nʼihu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ewerela onwe ya ṅụọ iyi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile ekwupụtala sị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "\"Ihe arụ ka mfụli elu nke Jekọb bụrụ m;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "ana m akpọkwa ebe ya niile e wusiri ike asị.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "Nʼihi ya, aghaghị m iwere obodo a",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "na ihe niile dị ya nʼime nyefee nʼaka ndị ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na mmadụ iri afọdụ nʼime otu ụlọ, ha niile aghaghị ịnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na nwanna, bụ onye nke na-aga ịkpọ anụ ahụ ndị a ọkụ, abata ibupụ ha nʼezi, ọ jụọ otu onye nọ nʼime ime ụlọ ahụ sị, \"O nwere onye ọzọ gị na ya nọ?\" Onye ahụ zaa, \"Ọ dịghị,\" mgbe ahụ nwanna ahụ ga-asị, \"Nọọ jụụ. Anyị agaghị akpọ aha",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.10",
                "verseOrgIds": [
                  "AMO.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na lee,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.11",
                "verseOrgIds": [
                  "AMO.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "e nyela iwu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "Ọ ghaghị itikpọsị ụlọ ukwu ndị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "tiriekwa ụlọ nta ndị ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịnyịnya ọ na-agba ọsọ nʼelu nkume?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Mmadụ ọ na-eji ehi abụọ e jikọtara ọnụ akọ elu osimiri?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Ma unu atụgharịala ikpe ziri ezi mee ya ka ọ ghọọ nsi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "mkpụrụ nke ezi omume ka unu mekwara ka ọ ghọọ ihe ilu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
