  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "AMO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igurube, ọkụ na ihe ịtụ mgbidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.1",
                "verseOrgIds": [
                  "AMO.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka m hụ. Lee, ọ na-akwado igwe igurube nke ga-abịa bibie ihe ubi niile ga-etopụta mgbe e burula ụzọ wee ihe ubi nke mbụ nke a na-enye eze, dịka ihe ruuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha tachara ahịhịa niile dị nʼala ahụ, etiri m mkpu: \"Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.2",
                "verseOrgIds": [
                  "AMO.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "biko arịọọ m gị, gbaghara. Jekọb ọ ga-esi aṅa guzosie ike? Lee, ọ dịkarịrị nta.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.3",
                "verseOrgIds": [
                  "AMO.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "chegharịrị banyere ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.3",
                "verseOrgIds": [
                  "AMO.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru sị, \"Ihe dị otu a agaghị emekwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.4",
                "verseOrgIds": [
                  "AMO.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gosiri m: Lee, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.4",
                "verseOrgIds": [
                  "AMO.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "na-akpọku ọkụ iji ya kpee ikpe. Ọkụ ahụ repịara ogbu mmiri, repịakwa ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, asịrị m, \"Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.5",
                "verseOrgIds": [
                  "AMO.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "biko, arịọọ m gị kwụsị! Olee otu Jekọb ga-esi guzosie ike? Lee na ọ dịkarịrị nta!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.6",
                "verseOrgIds": [
                  "AMO.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "chegharịrị banyere ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:6"
      },
      "items": [
        {
          "text": "Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.6",
                "verseOrgIds": [
                  "AMO.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, \"Ihe dị otu a agaghị emekwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ka o gosiri m, lee, Onyenwe anyị na-eguzo nʼakụkụ mgbidi nke e ji ihe ịtụ mgbidi tụọ nke ọma, o jikwa ihe ịtụ mgbidi nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.8",
                "verseOrgIds": [
                  "AMO.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Emọs, gịnị ka ị na-ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "Asịrị m, \"Ihe ịtụ mgbidi.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "Mgbe ahụ, Onyenwe anyị kwuru, \"Lee, mụ onwe m na-edo ihe ịtụ mgbidi nʼetiti ndị m bụ Izrel, agaghịkwa m esi ebe ha nọ gafee.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ebe niile e wuliri elu nke Aịzik aghaghị ịbụ ebe e mebiri emebi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:9"
      },
      "items": [
        {
          "text": "ebe nsọ niile nke Izrel aghaghị ịbụ ebe tọgbọrọ nʼefu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:9"
      },
      "items": [
        {
          "text": "aghakwaghị m iweli mma agha m elu iji megide ụlọ Jeroboam.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emọs na Amazaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Amazaya onye nchụaja nọ na Betel zigaara Jeroboam bụ eze Izrel ozi na-asị, \"Emọs na-akwalị izu nzuzo ka ọ megide gị nʼetiti ụlọ Izrel, ala apụghị ibu okwu niile sị ya nʼọnụ apụta.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke bụ ihe Emọs nọ na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "\" 'Jeroboam aghaghị ịnwụ site na mma agha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "Izrel aghakwaghị isite nʼala amụrụ ha jee biri nʼala ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "dịka ndị a dọtara nʼagha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Amazaya gwara Emọs, \"Gị onye ọhụ ụzọ, gbara ọsọ gbalaa ala Juda. Jee nʼebe ahụ, rie achịcha nke sitere nʼibu amụma gị, nọrọkwa nʼebe ahụ buo amụma gị.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebula amụma ọzọ na Betel, nʼihi na ọ bụ ebe nsọ nke eze, ọ bụkwa ụlọnsọ ukwu nke alaeze ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Emọs zaghachiri Amazaya, \"Ọ dịghị mgbe m bụ onye amụma, abụkwaghị m nwa onye amụma, kama abụ m onye na-elekọta igwe ewu na atụrụ, na onye ọrụ na-azụ osisi sikamọ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.15",
            "verseOrgIds": [
              "AMO.7.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
