      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:14"
      },
      "items": [
        {
          "text": "mee ka ha daa nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
            "verseOrgIds": [
              "AMO.3.14"
            ]
          }
        }
      ]
    },
