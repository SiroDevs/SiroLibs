      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:12"
      },
      "items": [
        {
          "text": "naanị ọkpụkpụ ụkwụ abụọ maọbụ iberibe ntị site nʼọnụ ọdụm,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
