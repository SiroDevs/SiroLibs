      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "ma kwakọrọkwa ihe niile dị nʼụlọ gị ndị ahụ e wusiri ike.\"",
