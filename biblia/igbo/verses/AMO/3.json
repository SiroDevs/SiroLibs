      "attrs": {
        "style": "q1",
        "vid": "AMO 3:12"
      },
      "items": [
        {
          "text": "\"Dịka onye ọzụzụ atụrụ si anapụta",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        }
      ]
