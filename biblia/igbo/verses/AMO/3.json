          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya nke a bụ ihe Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.11",
                "verseOrgIds": [
                  "AMO.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "\"Onye iro na-abịa! Ọ ga-agba ala gị gburugburu;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 3:11"
      },
      "items": [
        {
          "text": "ọ ga-akwatu ebe niile gị bụ nke e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        }
      ]
    },
    {
