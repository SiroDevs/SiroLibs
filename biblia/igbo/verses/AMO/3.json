      "attrs": {
        "style": "q2",
        "vid": "AMO 3:15"
      },
      "items": [
        {
          "text": "na nke ha wuru maka oge okpomọkụ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.15",
            "verseOrgIds": [
              "AMO.3.15"
