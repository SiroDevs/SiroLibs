      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 3:14"
      },
      "items": [
        {
          "text": "Mpi dị nʼebe ịchụ aja ka a ga-ebipụkwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
            "verseOrgIds": [
              "AMO.3.14"
            ]
          }
        }
      ]
    },
