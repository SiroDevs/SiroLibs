          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nụrụ nke a, ma gbaanụ ama megide ụmụ Jekọb,\" ọ bụ otu a ka Onyenwe anyị, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.13",
            "verseOrgIds": [
              "AMO.3.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.3.13",
                "verseOrgIds": [
                  "AMO.3.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile, kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.13",
            "verseOrgIds": [
              "AMO.3.13"
            ]
          }
        }
      ]
    },
    {
