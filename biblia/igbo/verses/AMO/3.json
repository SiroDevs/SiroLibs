              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m etida ụlọ ndị niile ha wuru maka oge oyi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.15",
            "verseOrgIds": [
