{
  "id": "AMO.8",
  "number": "8",
  "bookId": "AMO",
  "reference": "Emọs 8",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "AMO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkata mkpụrụ chara acha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.1",
                "verseOrgIds": [
                  "AMO.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gosiri m. Otu nkata nke mkpụrụ osisi ọkọchị chara acha jupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Emọs, gịnị ka ị na-ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "A sịrị m: \"Otu nkata nke mkpụrụ osisi chara acha jupụtara nʼime ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.2",
                "verseOrgIds": [
                  "AMO.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Oge ọgwụgwụ abịakwasịla ndị m, Izrel. Agaghị m ewezugakwa ntaramahụhụ dịrị ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.3",
            "verseOrgIds": [
              "AMO.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.3",
                "verseOrgIds": [
                  "AMO.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara, \"Nʼụbọchị ahụ, abụ niile nke a na-abụ nʼime ụlọnsọ ukwu ga-aghọ iti mkpu akwa. Ọtụtụ, ọtụtụ ozu ndị nwụrụ anwụ, nʼebe niile ọbụla ka atụpụsịrị ha! Mkpọtụ ọbụla adịghịkwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.3",
            "verseOrgIds": [
              "AMO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nụrụnụ nke a, unu ndị na-azọpịa ndị mkpa na-akpa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:4"
      },
      "items": [
        {
          "text": "na-emekwa ka ụmụ ogbenye dị nʼala a gwụsịa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "\"Olee mgbe ọnwa ọhụrụ ga-agafe",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "ka anyị ree mkpụrụ ubi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "na mgbe ụbọchị izuike ga-agwụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "ka anyị ree ọka wiiti?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "Ka anyị jiri ihe ọtụtụ dị nta,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "na ibuli ọnụ ngwa ahịa elu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "na aghụghọ site nʼiji ihe ọtụtụ na-ezughị ezu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri ọlaọcha zụta ụmụ ogbenye,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "jirikwa akpụkpọụkwụ abụọ anyị zụta ndị mkpa na-akpa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "ma reekọta ọka wiiti anyị zachatara nʼala ya na ezi ọka wiiti.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.7",
                "verseOrgIds": [
                  "AMO.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ewerela nganga Jekọb ṅụọ iyi, \"Nʼezie, agaghị m echefu, ọ bụladị otu nʼime ọrụ niile ha rụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.7",
            "verseOrgIds": [
              "AMO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ala agaghị ama jijiji nʼihi nke a,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "ndị niile bi nʼime ya ha agaghị eru ụjụ?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "Ala a niile ga-etoju dịka osimiri Naịl,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "a ga-eme ka ọ magharịa malie elu, ma tachaa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "dịka iyi Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma nʼụbọchị ahụ,\" otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.9",
                "verseOrgIds": [
                  "AMO.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "\"Aga m eme ka anyanwụ daa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        },
        {
          "text": "nʼetiti ehihie,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "ime ka ọchịchịrị dịrị nʼetiti oke ehihie nke ụbọchị.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aghaghị m ime ka ụbọchị oke oriri unu ghọọ ụbọchị iru ụjụ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "gbanwee abụ unu niile ka ha ghọọ abụ akwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Aga m eme ka onye ọbụla nʼime unu yiri akwa mkpe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "meekwa ka unu kpụchaa isi unu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Aga m eme ka ụbọchị ahụ dịrị ka ụbọchị a na-eru ụjụ, nʼihi otu mkpụrụ nwa nwoke nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Ọgwụgwụ ya ga-adịka ụbọchị na-elu ilu ilu.",
          "type": "text",
