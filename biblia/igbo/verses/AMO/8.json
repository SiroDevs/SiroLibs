              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ na-eji mmehie Sameria na-aṅụ iyi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.14",
            "verseOrgIds": [
