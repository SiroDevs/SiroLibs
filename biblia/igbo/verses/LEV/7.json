  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "LEV 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja ikpe ọmụma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndị a bụ usoro iwu banyere aja ikpe ọmụma, bụ nke dịkarịsịrị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.1",
            "verseOrgIds": [
              "LEV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-egbu anụ aja ikpe ọmụma ahụ nʼebe a na-egbu anụ aja nsure ọkụ, were ọbara ya fesaa nʼakụkụ niile nke ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.2",
            "verseOrgIds": [
              "LEV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụba ya niile ka a ga-enye dịka onyinye: abụba dị nʼọdụdụ ya, na abụba niile kpuchiri ihe dị nʼime afọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.3",
            "verseOrgIds": [
              "LEV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akụrụ abụọ ya, na abụba nke dị nʼelu ha, ruo nʼakụkụ ukwu ya, na umeju ya, na abụba kpuchiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.4",
            "verseOrgIds": [
              "LEV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-akpọ ha ọkụ nʼelu ebe ịchụ aja dịka onyinye nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.5",
                "verseOrgIds": [
                  "LEV.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ bụ aja ikpe ọmụma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.5",
            "verseOrgIds": [
              "LEV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ọbụla a mụrụ nʼezinaụlọ ndị nchụaja nwere ike iri anụ fọdụrụ na ya, maọbụ nʼebe nsọ ka aghaghị ịnọ rie ya. Ọ bụ ihe dịkarịsịrị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.6",
            "verseOrgIds": [
              "LEV.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Otu iwu a metụtakwara aja ikpe ọmụma na aja mmehie. Anụ ọbụla fọdụrụ ga-abụ nke onye nchụaja ahụ nke ji ha chụọ aja mkpuchi mmehie. Oke ya ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.7",
            "verseOrgIds": [
              "LEV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja nke chụrụ aja nsure ọkụ nʼisi onye ọbụla, ka ọ dịrị iwere akpụkpọ niile si nʼanụ ahụ o ji chụọ aja nye onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.8",
            "verseOrgIds": [
              "LEV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ebunye onye nchụaja chụrụ aja mkpụrụ ọka nke e ji ụtụ ọka chụọ, ụtụ ọka fọdụrụ. Otu a ka ọ ga-adịkwa nʼaja achịcha ọbụla a nụrụ anụ, maọbụ nke e siri esi, maọbụ nke e ghere eghe. Ihe ọbụla fọdụrụ ga-abụ nke onye nchụaja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.9",
            "verseOrgIds": [
              "LEV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aja mkpụrụ ọka ọbụla, ma nke e tinyere mmanụ, ma nke a na-etinyeghị mmanụ, nke fọdụrụ ga-abụ nke ụmụ ndị ikom Erọn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.10",
            "verseOrgIds": [
              "LEV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja udo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndị a bụ usoro iwu gbasara aja udo nke mmadụ ọbụla nwere ike chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.11",
                "verseOrgIds": [
                  "LEV.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼaja:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.11",
            "verseOrgIds": [
              "LEV.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na ha enye ya dịka aja ekele, tinyere aja ekele a ha ga-eweta ogbe achịcha a na-ejighị ihe na-eko achịcha mee, nke a gwakọtara ya na mmanụ oliv, na mbadamba achịcha a na-ejighị ihe na-eko achịcha mee, nke e tere mmanụ nʼelu ya, nakwa achịcha e ji ọka a kwọrọ nke ọma a gwakọtara ya na mmanụ nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.12",
            "verseOrgIds": [
              "LEV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewetakwa onyinye achịcha ọzọ nke e ji ihe na-eko achịcha, ya bụ, yiist mee, tinyere aja udo nke ekele ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.13",
            "verseOrgIds": [
              "LEV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-esikwa na ya weta otu nʼime onyinye ọbụla, chee nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.14",
                "verseOrgIds": [
                  "LEV.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", dịka onyinye. Ọ bụ nke ndị nchụaja ahụ na-efesa ọbara anụ e ji chụọ aja udo nʼelu ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.14",
            "verseOrgIds": [
              "LEV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma anụ ahụ eji chụọ aja onyinye udo nke ekele, ka a ga-eri nʼotu ụbọchị ahụ e ji ha chụọ aja. O nweghị nke a ga-ahapụ ka ọ bọọ chi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.15",
            "verseOrgIds": [
              "LEV.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ọ bụrụ na onyinye mmadụ wetara bụ onyinye afọ ofufu, maọbụ onyinye o wetara nʼihi nkwa o kwere, a ga-eri anụ aja ahụ nʼụbọchị ahụ a chụrụ ya, nweekwa ike rie nke fọdụrụ ma chi bọọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.16",
            "verseOrgIds": [
              "LEV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma anụ ọbụla fọdụrụ nʼime anụ aja ahụ, nke a na-erichapụghị nʼụbọchị nke abụọ ahụ ka a ga-akpọ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.17",
            "verseOrgIds": [
              "LEV.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na e rie anụ aja udo ahụ nʼụbọchị nke atọ, a gaghị anabata ya. A gaghị agụnyere ya onye ahụ wetara ya nʼihi na ihe rụrụ arụ ka ọ bụ. Onye ọbụla riri ya ga-abụ onye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.18",
            "verseOrgIds": [
              "LEV.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Anụ ọbụla nke metụrụ ihe rụrụ arụ aghọọla ihe na-adịghị ọcha. A gaghị eri ya. A ga-akpọ ya ọkụ. Ma nʼebe anụ ndị ọzọ dị, onye ọbụla e mere ka ọ dị ọcha nwere ike iri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.19",
            "verseOrgIds": [
              "LEV.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-esite nʼetiti ndị m kewapụ onye ọbụla riri anụ e ji chụọ aja udo nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.20",
                "verseOrgIds": [
                  "LEV.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "mgbe onye ahụ nọ nʼọnọdụ adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.20",
            "verseOrgIds": [
              "LEV.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla metụrụ ihe ọbụla rụrụ arụ aka, ma ịrụ arụ ahụ o si na mmadụ, ma o si nʼanụ ọhịa, ma o si nʼihe ọbụla ọzọ, a ga-esite nʼetiti ndị ya kewapụ ya ma ọ bụrụ na onye ahụ anọrọ nʼọnọdụ ahụ rie anụ e ji chụọ aja udo nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.21",
                "verseOrgIds": [
                  "LEV.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.21",
            "verseOrgIds": [
              "LEV.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu megidere iri abụba na ọbara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.22",
                "verseOrgIds": [
                  "LEV.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.22",
            "verseOrgIds": [
              "LEV.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha, 'Unu erila abụba ehi, maọbụ nke ewu, maọbụ nke atụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.23",
            "verseOrgIds": [
              "LEV.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụba anụ ọbụla nwụrụ anwụ maọbụ nke anụ ọhịa gburu adịghị mma oriri. E nwere ike jiri ha mee ihe ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.24",
            "verseOrgIds": [
              "LEV.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ekewapụ mmadụ ọbụla site nʼetiti ndị ya, bụ onye na-eri abụba anụmanụ nke a ga-esite na ya chee onyinye nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.25",
                "verseOrgIds": [
                  "LEV.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.25",
            "verseOrgIds": [
              "LEV.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, unu erila ọbara nnụnụ maọbụ nke anụmanụ nʼebe ọbụla unu bi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla riri ọbara ka a ga-ekewapụ site nʼetiti ndị ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ndị nchụaja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.28",
                "verseOrgIds": [
                  "LEV.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "gwakwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha, 'Onye ọbụla wetaara",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.29",
                "verseOrgIds": [
                  "LEV.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye aja udo aghaghị iweta ụfọdụ nʼime onyinye ahụ dịka onyinye pụrụ iche nye Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-eji aka ha chee onyinye nsure ọkụ ahụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.30",
                "verseOrgIds": [
                  "LEV.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha ga-eweta abụba ahụ, ya na obi anụ, fufee obi anụ ahụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.30",
                "verseOrgIds": [
                  "LEV.7.30"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka aja mfufe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-akpọ abụba ahụ ọkụ nʼebe ịchụ aja, ma obi anụ ahụ ga-abụ nke Erọn na ụmụ ya ndị ikom.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-enye onye nchụaja apata aka nri nke anụ aja udo ahụ, dịka onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa Erọn, onye ji ọbara na abụba chụọ aja udo ahụ ga-ewere apata aka nri ya dịka oke ruuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼonyinye ụmụ Izrel na-enye nʼoge aja udo, ewerela m obi anụ ahụ a na-efufe efufe, na apata anụ a na-eche nʼihu m nye Erọn, onye nchụaja na ụmụ ya ndị ikom ka ha bụrụ oke ruuru ha mgbe ọbụla ụmụ Izrel na-achụ aja udo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkụ anụ ahụ e ji chụọ aja nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.35",
                "verseOrgIds": [
                  "LEV.7.35"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke e nyekwara Erọn na ụmụ ya ndị ikom nʼụbọchị ahụ e chere ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.35",
                "verseOrgIds": [
                  "LEV.7.35"
                ]
              }
            }
          ]
        },
        {
          "text": "ijere ya ozi dịka ndị nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nʼụbọchị ahụ e tere ha mmanụ ka",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.36",
                "verseOrgIds": [
                  "LEV.7.36"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ụmụ Izrel iwu sị ha nye Erọn na ụmụ ya ndị ikom oke ndị a oge niile, site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ usoro iwu metụtara aja nsure ọkụ, na aja mkpụrụ ọka, na aja mmehie, na aja ikpe ọmụma, na onyinye ido nsọ, na aja udo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.38",
                "verseOrgIds": [
                  "LEV.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis iwu ndị a nʼugwu Saịnaị nʼụbọchị ahụ o nyere ụmụ Izrel iwu sị ha, wetara",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.7.38",
                "verseOrgIds": [
                  "LEV.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye nʼọzara Saịnaị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
    }
