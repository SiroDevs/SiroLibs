  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "LEV 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụgwọ ọrụ nrube isi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unu emerela onwe unu arụsị",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "text": "ọbụla, maọbụ guzobe oyiyi apịrị apị, maọbụ ogidi nkume ọbụla ọtọ, nye onwe unu. Unu edokwala nkume a pịrị apị ọbụla nʼala unu maka ịkpọ isiala nye ya. Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.1",
                "verseOrgIds": [
                  "LEV.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Debenụ iwu niile m nyere maka ụbọchị Izuike m,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "text": "sọpụkwaranụ ebe nsọ m. Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.2",
                "verseOrgIds": [
                  "LEV.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na unu ejegharịa nʼụkpụrụ m, lezie anya debe iwu m niile,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "aga m enye unu mmiri ozuzo nʼoge ya, nke ga-eme ka ala unu mịa ọtụtụ ihe ubi. Osisi unu niile ga-ejupụtakwa na mkpụrụ mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-anọgide na-azọcha ọka tutu ruo mgbe unu ga-aghọ mkpụrụ vaịnị unu, owuwe ihe ubi mkpụrụ vaịnị unu ga-adịgidekwa ruo oge ịkụ mkpụrụ nʼubi. Nʼụzọ dị otu a, unu ga-enwe nri ga-ezuru unu, unu ga-ebikwa nʼudo nʼala unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Aga m eme ka udo dịrị nʼala ahụ, unu ga-edina ala, ọ dịghịkwa onye ga-eme ka unu tụọ egwu ọbụla. Aga m ewezuga site nʼetiti unu ajọ anụ ọhịa, mma agha agaghị esitekwa nʼala unu bi nʼime ya gafee.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-achụ ndị iro unu ọsọ. Ha ga-ada nʼihu unu site na mma agha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ ise nʼime unu ga-achụ narị mmadụ ọsọ. Narị mmadụ nʼetiti unu ga-achụkwa iri puku mmadụ ọsọ. Ndị iro unu ga-ada nʼihu unu site na mma agha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Aga m eji ihuọma leta unu, mee ka unu mụbaa ma jupụta nʼọnụọgụgụ. Aga m eme ka ọgbụgba ndụ m nʼebe unu nọ dịgide.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-enwebiga mkpụrụ ubi oke ruo na mgbe unu ka nọ na-eri ndị ochie unu ga-ewezuga ha nʼakụkụ maka inye ohere iwebata ihe ubi ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ebe obibi m dịrị nʼetiti unu. Agaghị m asọ unu oyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ejegharị nʼetiti unu, bụrụ Chineke unu, unu ga-abụkwa ndị m.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.13",
                "verseOrgIds": [
                  "LEV.26.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu onye kpọpụtara unu site nʼala Ijipt, ka unu ghara ịbụ ndị ohu ọzọ. Etijiela m mkpọrọ igwe",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "text": "nke ịbụ ohu unu, mee ka unu bụrụ ndị ji nganga ejegharị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahụhụ nʼihi Nnupu isi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ọ bụrụ na unu ajụ ige m ntị, jụkwa imezu ihe ndị a m nyere unu iwu ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na unu ajụ ịgbaso ụkpụrụ m, sọọ iwu m ndị a oyi, si otu a mebie ọgbụgba ndụ m,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, aga m eme ka oke ụjọ, na ọrịa na-ebibi ebibi, na ahụ ọkụ, bịakwasị unu. Ọrịa ndị a ga-eme ka anya unu daa mba, ọ ga-eripịakwa anụ ahụ unu. Unu ga-akụ mkpụrụ ubi nʼubi unu ma ndị iro unu ga-eri ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eguzo megide unu nʼoge ibu agha, mee ka ndị iro unu merie unu nʼagha. Unu ga-agba ọsọ mgbe onye ọbụla na-adịghị achụ unu ọsọ. Ndị kpọrọ unu asị ga-achịkwa unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na unu anọgidesie ike ju ige m ntị nʼagbanyeghị ihe ndị a, aga m enye unu ntaramahụhụ dị okpukpu asaa nʼihi mmehie unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m etiji ịnya isi nganga unu, mee ka mbara eluigwe dịịrị unu dịka igwe, elu ala unu na-azọkwasị ụkwụ ga-adịkwa dịka bronz.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-adọgbu onwe unu nʼọrụ nʼefu, nʼihi na ala unu agaghị emepụtara unu ihe omume ya, osisi nke ala unu agaghị amịkwa mkpụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụkwa na mgbe nke a mesịrị, unu anọgidekwa jụ ime ihe m nyere nʼiwu, aga m eme ka ntaramahụhụ unu dịrị ukwuu, ugboro asaa ọzọ, nʼihi mmehie unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ezite anụ ọhịa megide unu. Ha ga-adọgbu ụmụ unu, bibie anụ ụlọ unu, meekwa ka unu dị nta nʼọnụọgụgụ, ruo na ndị a ga-ahụ nʼokporoụzọ unu ga-adị ole na ole.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụkwa na unu anọgide jụ ịdọ aka na ntị m, chie ntị nọgide na-ebu agha nnupu isi unu megide m,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mụ onwe m ga-ebu agha megide unu. Aga m eti unu ugbo ihe otiti asaa, nʼihi mmehie unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ewebata mma agha nʼebe unu nọ, ịbọ ọbọ nʼihi ọgbụgba ndụ m unu mebiri. Mgbe unu ga-agba ọsọ gbaba nʼobodo unu, aga m ezite ihe mbibi ga-ebibi unu nʼebe ahụ. Aga m enyefekwa unu nʼaka ndị iro unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka unu hapụ inwe ihe oriri ga-ezuru unu. Otu ite nri naanị ka ndị inyom iri ga-eji sie nri ha nwere. Ha ga-eji ihe ọtụtụ tụọ ya mgbe ha na-eke ya. Unu ga-eri ya, ma afọ agaghị eju unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụkwa na unu agaa nʼihu jụ ige m ntị nʼagbanyeghị ihe ndị a, nọgide na-emegide m,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, aga m egosi unu oke iwe m, nye unu ntaramahụhụ dị okpukpu asaa nʼihi mmehie unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-eri anụ ụmụ unu ndị ikom, na anụ ụmụ unu ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ebibikwa ụlọ arụsị unu niile dị nʼelu ugwu, gbutuo ebe ịchụ aja niile unu na-esure ihe nsure ọkụ na-esi isi. Aga m atụkọta ozu unu nʼelu arụsị unu na-enweghị ume ndụ, ka unu bụrụ ihe m na-asọ oyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka obodo unu niile tọgbọrọ nʼefu, kụdasịakwa ebe nsọ unu niile. Agaghị m anabatakwa isisi ụtọ nke aja unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ala unu tọgbọrọ nʼefu, mee ka ọnọdụ ịdị ala unu bụrụ ihe ga-eju ndị iro unu ga-ebi nʼime ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m achụsa unu na mba niile, mịpụta mma agha m jiri ya chụso unu ọsọ. Ala unu ga-atọgbọrọ nʼefu, a ga-etikpọkwa obodo unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ala ahụ ga-ezu ike, ogologo oge ndị ahụ niile ọ ga-atọgbọrọ nʼefu. Mgbe unu ga-anọ dịka ndị ohu nʼala ndị iro unu. Ala ahụ ga-ezu ike, imejupụta afọ izuike ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo oge niile ala ahụ tọgbọrọ nʼefu, ala ahụ ga-ezu ike, ụdị izuike ọ na-enweghị nʼafọ izuike ndị ahụ unu bi nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ndị ahụ fọdụrụ ndụ nʼime unu, aga m etinye ịda mba nʼobi ha nʼala ndị iro ha. Mkpọtụ ahịhịa nke ifufe na-ebugharị ga-eme ka ha gbapụ ọsọ. Ha ga-agba ọsọ dịka ndị si nʼihu mma agha na-agba ọsọ. Ha ga-ada mgbe onye ọbụla na-adịghị achụ ha ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, ha ga-agba ọsọ mgbe onye ọbụla na-adịghị achụ ha ọsọ. Ha ga-adagide ibe ha mgbe ha na-agba ọsọ a, dịka ndị si nʼebe a na-alụ agha na-agbapụ ọsọ. Unu agaghị enwe ike iguzo nʼihu ndị iro unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-ala nʼiyi nʼetiti ndị mba ọzọ, ala ndị iro unu ga-eri unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ a hapụrụ na ndụ nʼetiti unu ga-ata ahụhụ nʼala ndị iro ha nʼihi mmehie ha. Ha ga-atakwa ahụhụ nʼihi mmehie nke nna nna ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ọ bụrụ na ha ekwupụta mmehie",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "text": "ha niile, na mmehie niile nke ndị nna nna na ha na ha mehiere megide m, mmehie ekwesighị ntụkwasị obi ha, na mmehie nnupu isi ha, nke ha mehiere megide m,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke mere ka m doo onwe m imegide ha, na izipụ ha gaa nʼala ndị iro ha, ọ bụrụ na ha eweda onwe ha ala nabata ntaramahụhụ m nyere ha nʼihi mmehie ha",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "aga m echeta ọgbụgba ndụ mụ na Jekọb gbara, ọgbụgba ndụ mụ na Aịzik gbara, na ọgbụgba ndụ mụ na Ebraham gbara. Aga m echeta ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ala ahụ aghaghị ịtọgbọrọ nʼefu. Ọ ghakwaghị inwezu izuike ruuru ya, oge ndị ahụ ọ tọgbọrọ nʼefu, mgbe ha na-ebighị nʼime ya. Ha ga-anata ntaramahụhụ ruuru ha nʼihi na ha jụrụ iwu m, sọọkwa ụkpụrụ m oyi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ewezugakwa ihe ndị a niile, agaghị m ajụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "text": "maọbụ sọọ ha oyi, ruo na ibibi ha kpamkpam mgbe ahụ ha nọ nʼala ndị iro ha. Agakwaghị m emebi ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "text": "mụ na ha gbara nʼihi na abụ m Onyenwe anyị Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama nʼihi ha, aga m echeta ọgbụgba ndụ ahụ mụ na nna nna ha gbara, ịbụ Chineke ha, ndị ahụ m kpọpụtara site nʼala Ijipt nʼihu mba niile. Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.45",
                "verseOrgIds": [
                  "LEV.26.45"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ iwu, na ụkpụrụ na ndụmọdụ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.26.46",
                "verseOrgIds": [
                  "LEV.26.46"
                ]
              }
            }
          ]
        },
        {
          "text": "guzobere nʼugwu Saịnaị, nʼetiti ya onwe ya, na ụmụ Izrel, site nʼaka Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
      ]
    }
  ],
