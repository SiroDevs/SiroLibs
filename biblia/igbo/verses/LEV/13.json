      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usoro iwu gbasara ọrịa elu ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.13.1",
                "verseOrgIds": [
                  "LEV.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe mmadụ hụrụ etuto, maọbụ ọnya, maọbụ ntụpọ na-eko eko nʼakpụkpọ anụ ahụ ya nke dị ka ihe ọrịa ekpenta na-eweta, a ga-eduru onye ahụ bịa nʼihu Erọn onye nchụaja maọbụ ụmụ ya ndị ikom, bụ ndị nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-eleru ọrịa ahụ dị ya nʼahụ anya. Ọ bụrụ na ajị dị gburugburu ebe ahụ ebidola ịcha ọcha, ọ bụrụkwa na ebe ahụ mibara ime, ọ bụ ọrịa ekpenta. Mgbe onye nchụaja leruchara ya anya, ọ ga-ekwupụta na onye ahụ bụ onye rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwanụ na ajị dị gburugburu ebe ahụ dị ọcha, ma na ebe ahụ emighị emi karịa akụkụ ahụ ya ndị ọzọ, onye nchụaja ga-edebe onye ahụ ebe ọ ga-anọ naanị ya abalị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị asaa gasịrị, onye nchụaja ga-ele ya ahụ ọzọ. Ọ bụrụ na ọnya ahụ alabeghị, na ọ nwekwaghị mgbanwe ọbụla, a ga-edebekwa ya abalị asaa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe abalị asaa nke a gafekwara, onye nchụaja ga-elekwa ya ahụ ọzọ. Ọ bụrụ na ọ dịtụla ya mma, na ọnya ahụ agbasaghị nʼanụ ahụ ya, onye nchụaja ga-asị na ọ dị ọcha, nʼihi na ọ bụ naanị ọnya efu. Onye ahụ ga-asakwa uwe ya mmiri, mgbe ahụ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ọnya ahụ agbasaa nʼahụ ya mgbe o gosicharala onye nchụaja onwe ya maka nsacha ịdị ọcha, ọ ga-alaghachikwa azụ ga hụ onye nchụaja ahụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-eleru ya anya, ọ bụrụ na onye nchụaja achọpụta na ọnya ahụ na-agbasa, ọ ga-agụ onye ahụ dịka onye rụrụ arụ, ọ bụ ọrịa na-efe efe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ọbụla mmadụ nwere ihe dị ka ọrịa na-efe efe nʼahụ ya, a ghaghị ịkpọtara ya onye nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ele anya nʼakụkụ anụ ahụ ya zara aza ịchọpụta ma ọ dị ọcha, ma ajị dị gburugburu ebe ahụ ọ na-acha ọcha, na ịhụkwa ma ọ nwere ọnya dị gburugburu ebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye nchụaja ahụ ihe ndị a, ọ bụ ọrịa ekpenta nʼezie. Ọ ga-agụkwa onye ahụ dịka onye rụrụ arụ. A gaghị edebekwa ya ile ya ahụ, nʼihi na ọ bụrụlarị onye rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na onye nchụaja elee onye ahụ anya hụ na ọrịa ọcha ahụ enupụtala nʼakụkụ ahụ ya niile, site nʼụkwụ ya ruo nʼisi ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja a ga-eleru ya anya, ọ bụrụ na ọrịa ahụ enupụtala nʼahụ ya niile, ọ ga-ekwupụta na onye ahụ dị ọcha, ebe ọ bụ na ọrịa ahụ enupụtala mee ka anụ ahụ ya chawa ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na e nwere akụkụ ahụ ya ọnya ọ hụrụ pụtara, ọ ga-agụ ya dịka onye na-adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-enyocha ọnya ahụ. Kwupụta na onye ahụ rụrụ arụ. Ọnya ahụ rụrụ arụ nʼihi na ọrịa ekpenta ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ nʼọnya ahụ agbanwe na-acha ọcha, ha ga-agakwuru onye nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ele ya ahụ. Ọ bụrụ na ọnya niile ahụ na-acha ezi ọcha, onye nchụaja ga-agụ ya dịka onye na-enweghị ntụpọ. Ndị dị ọcha ka ha ga-abụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na etuto toro mmadụ nʼahụ alaa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma akpụkpọ anụ ahụ ya anọgide na-acha ọcha, maọbụ na-acha ọbara ọbara, a ga-ejekwuru onye nchụaja ka o lee ya anya nʼahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye nchụaja achọpụta na e nwere ọrịa dị nʼokpuru akpụkpọ ahụ ya, chọpụtakwa na ajị ya na-acha ọcha, onye nchụaja ga-agụ mmadụ ahụ dịka onye rụrụ arụ, nʼihi na ekpenta esitela nʼetuto ahụ pụta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye nchụaja achọpụta na ajị ọcha adịghị nʼakpụkpọ ahụ ya, chọpụtakwa na ọnya ahụ abanyeghị nʼime, onye nchụaja ga-edebe onye ahụ ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ụbọchị asaa ahụ, ọ bụrụ na ọnya ahụ abaa ụba karịa ka ọ dị na mbụ, onye nchụaja ga-agụ mmadụ ahụ dịka onye na-adịghị ọcha. Ọ bụ ọrịa na-emerụ emerụ ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ọ baghị ụba karịa, onye nchụaja ga-agụ mmadụ ahụ dịka onye dị ọcha, nʼihi na ihe a bụ etuto lara ala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ọkụ agbaa mmadụ, mee ka ọnya pụta ya nʼahụ: ọ bụrụ na ọnya ahụ ebido na-acha ọbara ọbara, maọbụ na-acha ezigbo ọcha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.24",
            "verseOrgIds": [
              "LEV.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-elezi onye dị otu a anya. Ọ bụrụ na ajị dị gburugburu ebe ọnya ahụ dị na-acha ọcha, maọbụ na ọnya ahụ mibara ime karịa, ọ ghọọla ekpenta nke si nʼọnya ahụ nupụta. Onye nchụaja ga-agụ mmadụ ahụ dịka onye na-adịghị ọcha. Ọ bụ ọrịa ekpenta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye nchụaja elee ya hụ na ajị dị gburugburu ebe ahụ adịghị ọcha, ọ bụrụkwa na ọ dịghị ala karịa akpụkpọ ahụ, na ọ na-aṅacha, mgbe ahụ onye nchụaja ga-edebe onye ahụ iche ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.26",
            "verseOrgIds": [
              "LEV.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, onye nchụaja ga-elezi onye ahụ anya nke ọma. Ọ bụrụ na ọ chọpụtara na ọnya ahụ na-abasaa nʼakpụkpọ ahụ ya, onye nchụaja ga-agụ onye ahụ dịka onye na-adịghị ọcha. Ọrịa na-emerụ emerụ ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.27",
            "verseOrgIds": [
              "LEV.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ọ gbanweghị, bụrụkwa na ọ basaghị nʼakpụkpọ ahụ ma ọ na-aṅacha, ọ bụ ihe ọzịza sitere nʼọkụ rere onye ahụ, onye nchụaja ga-agụ ya dịka onye dị ọcha, nʼihi na ọ bụ apa ọnya lara ala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na nwoke maọbụ nwanyị ọbụla enwee ọnya nʼisi, maọbụ na nti ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-elezi ọnya ahụ anya. Ọ bụrụ na ọ dị ala karịa akpụkpọ ahụ ya, ọ bụrụkwa na ajị dị na ya na-acha odo odo dị irighiri, onye nchụaja ga-agụ ha dịka ndị na-adịghị ọcha. Ọ bụ ọrịa na-emerụ emerụ nke dị nʼisi maọbụ nʼagba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye nchụaja achọpụta na ọnya ahụ adịghị abasa abasa, maọbụ na ajị dị nʼebe ahụ adịghị eji ojii, onye nchụaja ga-edebe onye ahụ ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa onye nchụaja ga-elezi ọnya ahụ anya. Ọ bụrụ na ọnya ahụ abasaghị karịa, ọ bụrụ na o nweghị ajị na-acha edo edo, ọ bụrụkwa na o mibaghị emiba,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-akpụchapụ ajị niile dị nʼakụkụ ebe ahụ ọnya mere ya, ma ọ gaghị akpụchapụ ajị dị nʼọnya ahụ nʼonwe ya. Onye nchụaja ga-edebe onye ahụ ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, onye nchụaja ga-elezi ọnya ahụ anya. Ọ bụrụ na ọ basaghị karịa, maọbụ mibanye nʼime karịa anụ ahụ, a ga-agụ mmadụ ahụ dịka onye dị ọcha. Ọ ga-apụ sachaa uwe ya, bụrụ onye dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na mgbe a gụchara ya nʼonye dị ọcha ọnya ahụ emesịa basaa nʼahụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ele ya anya. Ọ bụrụ na ọnya ahụ agbasaala nʼakpụkpọ ahụ ya, onye nchụaja a gaghị achọwa ajị na-acha edo edo. Onye ahụ rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ nʼuche onye nchụaja na ọnya ahụ adịghị abasa abasa, ọ bụrụkwa na ajị ojii epupụtala nʼebe ahụ, ọnya ahụ alaala. Onye dị ọcha ka mmadụ ahụ bụ. Onye nchụaja ga-ekwupụta na ọ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe nwoke maọbụ nwanyị ọbụla nwere ntụpọ ọcha nʼanụ ahụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-ele ya ahụ. Ọ bụrụ na ntụpọ ahụ adịghị achazi ezi ọcha, ọ bụ ọkọ nupụtara onye ahụ nʼahụ. Onye ahụ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ajị na-adịghịkwa nwoke nʼisi, ọ bụ isi nkwọcha, onye ahụ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu aka ahụ, ọ bụrụ na isi ya esite nʼegedege ihu ya kwọchasịa, ọ bụghị ekpenta, onye dị ọcha ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ọ bụrụ na onye ahụ enwee etuto nʼisi ya maọbụ nʼegedege ihu ya nke na-acha ọbara ọbara, na ọcha ọcha, o nwere ike bụrụ ọrịa ekpenta na-enupụta ya nʼisi maọbụ nʼegedege ihu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, onye nchụaja ga-elezi ya anya. Ọ bụrụ na etuto ahụ toro ya nʼisi maọbụ nʼegedege ihu na-acha ọbara ọbara, na ọcha ọcha, ọ ga-abụ na ọ ghọọla ọrịa ekpenta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-agụ ya dịka onye ekpenta. Ọ bụkwa onye rụrụ arụ, nʼihi ọnya ahụ dị ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ọbụla a chọpụtara na ọ bụ onye ekpenta ga-eyi uwe dọkara adọka, hapụ agịrị isi ya ka ọ dịka nke onye ara. Ọ ga-ekpuchi elu egbugbere ọnụ ya, na-eti mkpu na-asị, 'Onye rụrụ arụ ka m bụ. Onye rụrụ arụ ka m bụ!'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị niile nke ọ nọ nʼọrịa ahụ, ọ gaghị ebi nʼime obodo nʼetiti ụmụ mmadụ nʼihi na onye rụrụ arụ ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usoro iwu banyere Ọrịa na-efe efe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na a hụrụ ntụpọ yiri ntụpọ ọrịa na-efe efe nʼuwe ajị anụ maọbụ nʼuwe ogho ọcha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
            "verseOrgIds": [
              "LEV.13.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 13:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ nʼakpụkpọ anụ ọbụla, maọbụ nʼihe ọbụla e ji akpụkpọ ajị anụ maọbụ uwe ogho ọcha, uwe a kpara akpa, maọbụ nke a tụrụ atụ mee.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na ntụpọ dị nʼuwe ahụ, maọbụ nʼakpụkpọ anụ ahụ, maọbụ nke a kpara akpa, maọbụ nke atụrụ atụ, maọbụ nʼihe akpụkpọ anụ ọbụla na-acha ahịhịa ndụ maọbụ uhie uhie, o nwere ike ịbụ ọrịa na-efe efe. A ga-ewegara onye nchụaja uwe ahụ ka o lezie ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ele ya anya, were ya debe ya iche ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, onye nchụaja ga-ele ya anya ọzọ. Ọ bụrụ na ntụpọ ahụ agbasaa nʼuwe ahụ maọbụ nʼihe ahụ a kpara akpa, maọbụ nʼihe ahụ a tụrụ atụ, maọbụ nʼihe akpụkpọ anụ ahụ, nʼime ụbọchị asaa ndị a, nʼagbanyeghị ihe e ji ha eme, ọ bụ ọrịa ọjọọ na-efe efe. Ihe ahụ bụ ihe rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-akpọ uwe ahụ, maọbụ akwa ajị anụ ahụ, maọbụ akwa ajị anụ a kpara akpa, maọbụ akwa ogho ọcha ahụ, maọbụ ihe akpụkpọ anụ ọbụla ọkụ, nʼihi na ọrịa na-efe efe dị nʼime ya, nʼihi na ọrịa na-eweta mbibi ka ọ bụ. A ghakwaghị iji ọkụ rechapụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 13:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na onye nchụaja ahụ ele hụ na ntụpọ ahụ agbasaghị nʼuwe ahụ, maọbụ nʼakwa ahụ a kpara akpa, maọbụ akwa a tụrụ atụ, maọbụ nʼihe akpụkpọ anụ ahụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 13:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-enye iwu ka a saa ihe ndị ahụ niile mmiri, wezugakwa ya iche ruo ụbọchị asaa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a sachara ihe ahụ mmiri, onye nchụaja ga-ele ya anya ọzọ. Ọ bụrụ na ntụpọ ahụ agbanwebeghị, ọ bụrụ na ọ na-achakwa dịka o si acha na mbụ, mgbe ụbọchị ndị a gasịrị, ọ bụ ezie na ọ gbasaghị, ọ bụ ihe rụrụ arụ. A ga-akpọ ya ọkụ, ma ntụpọ ahụ ọ dị nʼihu uwe ahụ maọbụ nʼazụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye nchụaja elee ya anya hụ na ụcha ntụpọ dị nʼihe ahụ adịghị ukwuu nʼihi nsacha a sachara ya na mmiri, ọ ga-achakapụ akụkụ uwe ahụ, maọbụ akwa ahụ a kpara akpa maọbụ nke a tụrụ atụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 13:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ntụpọ ahụ emesịa pụta ọzọ nʼuwe ahụ, maọbụ nʼakwa ahụ a kpara akpa, maọbụ nke a tụrụ atụ, maọbụ nʼakpụkpọ anụ ahụ, o gosiri na ọ na-agbasa agbasa. Ihe ọbụla nwere ntụpọ ahụ ka a ga-akpọ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LEV 13:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe maọbụ ihe a kpara akpa, maọbụ ihe a tụrụ atụ, maọbụ ihe akpụkpọ anụ ọbụla a sara mmiri nke ntụpọ dị na ya pụrụ, a ga-asa ya mmiri ọzọ. Ọ ga-abụkwa ihe dị ọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.58",
            "verseOrgIds": [
              "LEV.13.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LEV 13:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ usoro iwu metụtara ntụpọ dịka ntụpọ ọrịa na-efe efe nke dị nʼuwe ajị anụ maọbụ uwe ogho ọcha, maọbụ nʼihe a kpara akpa maọbụ nʼihe a tụrụ atụ, maọbụ nʼihe akpụkpọ anụ. Iwu ndị a ga-enye aka ịchọpụta ma ha rụrụ arụ, maọbụ na ha dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.59",
            "verseOrgIds": [
              "LEV.13.59"
            ]
          }
        }
      ]
    }
