  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EZK 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Abụ akwa nʼihi Fero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na abụọ, nʼọnwa nke iri na abụọ, nʼụbọchị nke mbụ ya, okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.1",
                "verseOrgIds": [
                  "EZK.32.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, buliere Fero bụ eze Ijipt, abụ akwa sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "\" 'Ị dị ka ọdụm nʼetiti mba niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "Ị dịkwa ka ogologo anụ ọjọọ na-anọ nʼosimiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "I na-akpụgharị onwe gị nʼime mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "I ji ụkwụ abụọ na-agbarụ mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "na-emekwa ka mmiri iyi niile gbarụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.3",
                "verseOrgIds": [
                  "EZK.32.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "\" 'Aga m eji ọtụtụ ndị dị ukwuu nʼọnụọgụgụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "gbasaa ụgbụ m nʼelu gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "Ha ga-adọkpụkwara gị nʼime ụgbụ m.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m atụsa gị nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "nʼọhịa ka m ga-atụfukwa gị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "meekwa ka ụmụ nnụnụ niile nke eluigwe bekwasị gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "Aga m emekwa ka anụ ọhịa nke ụwa niile rijuo afọ nʼanụ ahụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m tụsasịkwa anụ ahụ gị nʼugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:5"
      },
      "items": [
        {
          "text": "werekwa ihe ọbụla fọdụrụ nʼime gị mejuo ndagwurugwu niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "M ga-eji ọbara gị na-asọ asọ dee ala niile dịka mmiri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "ọ bụladị ruo nʼugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "ebe niile mmiri si erufe ga-ejupụtakwa nʼanụ ahụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m ga-emenyụ gị dịka ọkụ, aga m ekpuchi ihu eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "meekwa ka kpakpando niile jie nji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "Aga m eji igwe ojii mechie ihu anyanwụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "ọnwa agakwaghị enye ìhè ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile nke na-enye ìhè nʼeluigwe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "ka m ga-eme ka ha jie nji nʼelu gị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "mee ka ọchịchịrị gbachie nʼala gị niile, otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.8",
                "verseOrgIds": [
                  "EZK.32.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eweta obi mgbawa nʼetiti ndị mmadụ dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "mgbe m ga-eme ka mbibi gị bịa nʼetiti mba niile",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "nʼime ala dị iche iche nke ị na-amaghị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka i ju ọtụtụ ndị mmadụ anya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "ndị eze ha ga-ama jijiji nʼụjọ maka gị",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "mgbe m ga-efegharị mma agha m nʼihu ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "Onye ọbụla nʼime ha ga-ama jijiji",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "na ntabi anya ọbụla nʼihi ndụ ya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "nʼụbọchị ahụ, ị ga-ada.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼihi na nke a bụ ihe Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.11",
                "verseOrgIds": [
                  "EZK.32.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:11"
      },
      "items": [
        {
          "text": "\" 'Mma agha nke eze Babilọn",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:11"
      },
      "items": [
        {
          "text": "ga-abịakwasị gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usuu ndị agha gị ga-adakwa nʼihu mma agha",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "nke ndị dị ike,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "bụ ndị mba ahụ kachasị mba niile njọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "Nganga niile nke Ijipt na ndị ya, ka ha ga-egwepịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "Ha ga-akwatu usuu ndị agha ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m emekwa ka anụmanụ ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:13"
      },
      "items": [
        {
          "text": "nke na-ata ahịhịa nʼakụkụ mmiri laa nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:13"
      },
      "items": [
        {
          "text": "Ụkwụ mmadụ, na ụkwụ anụmanụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:13"
      },
      "items": [
        {
          "text": "agakwaghị agbarụ mmiri ahụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, mmiri niile nke ya ga-adị ọcha,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:14"
      },
      "items": [
        {
          "text": "na-asọkwa dịka mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:14"
      },
      "items": [
        {
          "text": "Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.14",
                "verseOrgIds": [
                  "EZK.32.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
              "EZK.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m bibiri Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:15"
      },
      "items": [
        {
          "text": "kpochapụkwa ihe niile dị nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:15"
      },
      "items": [
        {
          "text": "mgbe m tidara ndị niile bi nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:15"
      },
      "items": [
        {
          "text": "ha ga-amata nʼezie na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.15",
                "verseOrgIds": [
                  "EZK.32.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.15",
            "verseOrgIds": [
              "EZK.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ abụ akwa ha ga-abụrụ ya. Ndị inyom mba dị iche iche ga-abụ ya. Ha ga-abụ ya nʼihi Ijipt na usuu ndị agha ya, otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.16",
                "verseOrgIds": [
                  "EZK.32.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Nrịda Ijipt baa nʼala ndị nwụrụ anwụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na abụọ ahụ, nʼụbọchị nke iri na ise nke ọnwa ahụ, okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.17",
                "verseOrgIds": [
                  "EZK.32.17"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere m ntị sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.17",
            "verseOrgIds": [
              "EZK.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, tie mkpu akwa nʼihi usuu ndị agha Ijipt niile, wezuga ha baa nʼokpuru ụwa ma ndị inyom mba dị iche iche dị ukwuu, ha na ndị ahụ na-arịdaru nʼolulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.18",
            "verseOrgIds": [
              "EZK.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha okwu sị ha, 'Unu o nwere ihuọma karịa ndị ọzọ? Lee, ihe na-eche gị bụ olulu. Ọ bụkwa ndị a na-ebighị ugwu ka ị ga-edinakwuru.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.19",
            "verseOrgIds": [
              "EZK.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼetiti ndị e ji mma agha gbuo ka ha ga-ada. Amịpụtala mma agha maka ya, ka a dọkpụrụ ya na igwe ndị ya niile pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.20",
            "verseOrgIds": [
              "EZK.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị dike nke ndị ndu dike ga-esite nʼala mmụọ kwuo banyere Ijipt na ndị niile ha na ya dị na mma, 'Ha arịdatala, ha na-edina ala ha na ndị a na-ebighị ugwu, nakwa ndị niile ahụ e ji mma agha gbuo.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.21",
            "verseOrgIds": [
              "EZK.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼebe ahụ ka Asịrịa na ndị agha ya niile nọ; ili ndị niile o gburu egbu gbara ya gburugburu, bụ ndị niile nwụrụ site na mma agha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.22",
            "verseOrgIds": [
              "EZK.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili ha dị na nsọtụ niile nke olulu, ndị agha ya niile gbakwara ili ya gburugburu. E gbudala ndị niile mere ka oke egwu dị nʼala ndị dị ndụ. Ndị a nwụrụ site na mma agha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.23",
            "verseOrgIds": [
              "EZK.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼebe ahụ ka Elam na usuu ndị agha ya nọ gbaa ili ya gburugburu. Ha niile bụ ndị e gburu egbu, ndị nwụrụ site na mma agha. Ndị niile mere ka oke egwu dị nʼala ndị dị ndụ arịdaruola nʼolulu ahụ dịka ndị a na-ebighị ugwu. Ha esorola ndị ahụ rịdaruru nʼala mmụọ keta oke nʼihere dịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.24",
            "verseOrgIds": [
              "EZK.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E meere ya ebe ndina nʼetiti ndị nwụrụ anwụ. Igwe mmadụ ya nwụrụ anwụ gbakwara ili ya gburugburu. Ha niile bụ ndị a na-ebighị ugwu, ndị e ji mma agha gbuo, nʼihi na-emere ka oke egwu ha dị nʼala ndị dị ndụ, ma ha na-eburu ihere ha, ha na ndị ahụ na-arịdaru nʼolulu. Ha bụ ndị e debere nʼetiti ndị nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.25",
            "verseOrgIds": [
              "EZK.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meshek na Tubal nọkwa nʼebe ahụ, ha na usuu ndị agha ha niile, gburugburu ili ha. Ha niile bụkwa ndị a na-ebighị ugwu, ndị e ji mma agha gbuo, nʼihi na ha mere ka oke egwu ha dị nʼala ndị dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.26",
            "verseOrgIds": [
              "EZK.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, e likọọla ha na ndị a na-ebighị ugwu, bụ ndị dike nʼagha, ndị nwụrụ anwụ, ndị ji ngwa agha ha gbadaa nʼime ili ha, ndị e hinyere ngwa agha ha nʼokpuru isi ha, ebe ọta",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        },
        {
          "text": "ha dịkwasịrị nʼọkpụkpụ mgbe e tinyere ha nʼili. Ma nʼezie, ndị a bụ dike nʼagha mere ka oke egwu dị nʼala ndị dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.27",
            "verseOrgIds": [
              "EZK.32.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, bụ Fero, otu a ka a ga-esi gbajie gị, ị ga-edinakwa nʼetiti ndị a na-ebighị ugwu, gị na ndị e ji mma agha gbuo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼebe ahụ ka Edọm na ndị eze ya, na ndịisi ya niile nọ. Nʼagbanyeghị ịdị ike ha, ha na ndị e ji mma agha gbuo tọgbọrọ nʼebe ahụ. Ha na ndị a na-ebighị ugwu so dinaa, bụ ndị na-arịdaru nʼolulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.29",
            "verseOrgIds": [
              "EZK.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndịisi nke mba ndị ugwu, na ndị Saịdọn niile nọ nʼebe ahụ. Ụjọ niile nke ha sitere nʼisiike ha menye ndị mmadụ egbochighị ha iketa oke nʼihere nke iso ndị e gburu egbu nwụọ. Ha soro ndị eji mma agha gbuo dinaa na-ebighị ugwu, buru ihere ha, ha na-arịdaru nʼolulu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.30",
            "verseOrgIds": [
              "EZK.32.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Fero na ndị agha ya niile ga-ahụ ndị a, ọ ga-enwe nkasiobi maka ndị ya niile, na usuu ndị agha ya niile ndị eji mma agha gbuo. Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.31",
                "verseOrgIds": [
                  "EZK.32.31"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na emeela m ka ọ gbasaa ụjọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        },
        {
          "text": "nʼala ndị dị ndụ, Fero na igwe mmadụ a niile ka a ga-eli nʼetiti ndị a na-ebighị ugwu, ya na ndị ejiri mma agha gbuo. Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.32",
                "verseOrgIds": [
                  "EZK.32.32"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.32",
            "verseOrgIds": [
              "EZK.32.32"
            ]
          }
        }
      ]
    }
  ],
