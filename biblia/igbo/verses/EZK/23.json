  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "EZK 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụnne nwanyị abụọ na-akwa iko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.1",
                "verseOrgIds": [
                  "EZK.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị m,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.1",
            "verseOrgIds": [
              "EZK.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, ọ dị ndị inyom abụọ nke otu nne mụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.2",
            "verseOrgIds": [
              "EZK.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ghọrọ ndị akwụna nʼala Ijipt site na mgbe ha bụ agbọghọ. Nʼala ahụ, a bịagidere ara ha aka, pịakwa ọnụ ara agbọghọ ha aka nʼọnọdụ igwuri egwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.3",
            "verseOrgIds": [
              "EZK.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nke okenye bụ Ohola. Aha nwanne ya nwanyị bụ Oholiba. Ha bụrịị nkem, ha mụtakwara m ụmụ ndị nwoke na ndị nwanyị. Ohola bụ Sameria, Oholiba bụkwa Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.4",
            "verseOrgIds": [
              "EZK.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ohola na-agba akwụna mgbe ọ ka bụ nkem. O nwere agụụ ịkwa iko nʼebe ndị niile ọ hụrụ nʼanya nọ, bụ ndị dike nʼagha nke ndị Asịrịa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.5",
            "verseOrgIds": [
              "EZK.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị yi uwe anụnụ, ndịisi ọchịchị na ndị ọchịagha, ha niile bụ ụmụ okorobịa mara mma nʼile anya, na ndịisi agha, ndị ikom na-amakwasị nʼelu ịnyịnya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.6",
            "verseOrgIds": [
              "EZK.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O weere onwe ya nyefee nʼaka ndị ikom Asịrịa ogugo ha kachasị elu dịka onye akwụna, merụọkwa onwe ya site nʼife arụsị dị iche iche nke onye ọbụla agụụ ya gụrụ obi ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.7",
            "verseOrgIds": [
              "EZK.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ hapụghị mmụọ akwụna ahụ dị nʼime ya, bụ nke o bidoro nʼIjipt, nke bụ na mgbe ọ bụ agbọghọ ya na ndị ikom dinakọrọ, ha na-apịkwa ọnụ ara agbọghọ ya aka, na-awụkwasịkwa agụụ nke ọchịchọ ọjọọ ha nʼahụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.8",
            "verseOrgIds": [
              "EZK.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi nke a enyefere m ya nʼaka ndị ahụ hụrụ ya nʼanya, bụ ndị Asịrịa, ndị agụụ ha na-agụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.9",
            "verseOrgIds": [
              "EZK.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gbara ya ọtọ, ha kpọọrọ ụmụ ya ndị ikom na ndị inyom, ma ya onwe ya ka ha were mma agha gbuo. Nʼụzọ dị otu a, ọ ghọrọ ihe akụkọ ilu nʼetiti ndị inyom niile, a takwara ya ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.10",
            "verseOrgIds": [
              "EZK.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oholiba bụ nwanne ya nwanyị hụrụ ihe ndị a, ma nʼime agụụ ihe ọjọọ nke gụrụ ya nakwa ịgba akwụna, ọ kpara agwa jọrọ njọ karịa nke nwanne ya nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.11",
            "verseOrgIds": [
              "EZK.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya onwe ya kwa, agụụ ụmụ Asịrịa gụrụ ya, bụ ndịisi ọchịchị, na ndị ọchịagha, ndị dike nʼagha yi uwe agha dịka o kwesiri, ndị ikom na-amakwasị nʼelu ịnyịnya, ha niile bụ ụmụ okorobịa dị mma nʼile anya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.12",
            "verseOrgIds": [
              "EZK.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m na ya onwe ya merụkwara onwe ya; ha abụọ si otu ụzọ aga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.13",
            "verseOrgIds": [
              "EZK.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"O gara nʼihu tụkwasị ihe nʼịgba akwụna ya karịa. Ọ hụrụ onyinyo ndị ikom atụnyere nʼahụ aja, bụ onyinyo nke ndị Kaldịa e ji ihe chara uhie uhie sepụta,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.14",
            "verseOrgIds": [
              "EZK.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha kere ihe okike",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.15",
            "verseOrgIds": [
              "EZK.23.15"
            ]
          }
        },
        {
          "text": "nʼukwu ha nakwa akwa okike nʼisi ha; nʼile anya ha niile dịka ndịisi ụgbọ agha ndị Babilọn, Kaldịa bụ ala amụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.15",
            "verseOrgIds": [
              "EZK.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ọ na-ele ha anya, agụ ha gụrụ ya, o zipụrụ ha ndị ozi na Kaldịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.16",
            "verseOrgIds": [
              "EZK.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ndị Babilọn bịakwutere ya, nʼelu ihe ndina ịhụnanya, nʼime agụụ nke anụ ahụ ha, ha merụrụ ya. Mgbe ha mesịrị ka ọ bụrụ ihe rụrụ arụ site nʼịkwa iko, o si nʼebe ha nọ wezuga onwe ya nʼọnọdụ ịsọ ha oyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.17",
            "verseOrgIds": [
              "EZK.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ gara nʼihu na-akwa iko nʼezoghị ezo na-ekpughekwa ọtọ ya, elepụrụ m ya anya nʼihi ịsọ oyi, dịka m mere lepụkwara anya site nʼebe nwanne ya nwanyị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.18",
            "verseOrgIds": [
              "EZK.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ gara nʼihu na-akwa iko karịa, dịka ọ na-echeta ndụ akwụna o biri nʼIjipt mgbe ọ bụ agbọghọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.19",
            "verseOrgIds": [
              "EZK.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, agụụ ndị ikom ya na ha na-akwa iko gụrụ ya, bụ ndị anụahụ ha dịka nke ịnyịnya ibu, ndị ihe ha na-anyụpụta dịkwa ka nke ịnyịnya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.20",
            "verseOrgIds": [
              "EZK.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya bụ, na-agụụ ndụ ọjọọ nke i biri mgbe ị bụ agbọghọ na-agụsị gị ike, mgbe ị nọ nʼIjipt ebe a na-abịagide gị aka nʼara, ebe apịkwara ọnụ ara nta gị aka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.21",
            "verseOrgIds": [
              "EZK.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi nke a, gị Oholiba, nke a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.22",
                "verseOrgIds": [
                  "EZK.23.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Aga m akpali ndị ahụ hụrụ gị nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "text": "megide gị, bụ ndị ahụ ihe ha na-amasịkwaghị gị ọzọ. Aga m esi nʼakụkụ niile kpọta ha, megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.22",
            "verseOrgIds": [
              "EZK.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Babilọn, ndị Kaldịa niile, ndị ikom Pekod, ndị Shoa, na ndị Koa, na ndị Asịrịa niile ha na ha soo. Ụmụ okorobịa niile dị mma ile anya, ha niile bụ ndị na-achị achị na ndị ọchịagha, ndịisi na-agba ịnyịnya, na ndị ikom ọkwa ha dị elu, ha niile ga-anọkwasị nʼelu ịnyịnya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.23",
            "verseOrgIds": [
              "EZK.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-eji ngwa agha dị iche iche, ụgbọala nke agha na ọtụtụ igwe ndị mmadụ dị iche iche; ha ji ọta ukwu na ọta nta, kpurukwa okpu agha igwe, were ọnọdụ gburugburu gị nʼakụkụ ọbụla, imegide gị. Aga m enyefe gị nʼaka ha, ka ha taa gị ahụhụ, ha ga-atakwa gị ahụhụ dịka usoro ikpe ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.24",
            "verseOrgIds": [
              "EZK.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m edo ekworo nke iwe m megide gị, ha ga-eji iwe na ọnụma mesie gị ike. Ha ga-ebipụ imi unu na ntị unu, ndị fọdụkwara nʼime unu ga-anwụ site na mma agha. Ha ga-achịkọrọ ụmụ unu ndị ikom na ndị inyom pụọ, unu ndị nke fọdụrụ ka ọkụ ga-erepịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.25",
            "verseOrgIds": [
              "EZK.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-eyipụ gị uwe ọma gị niile, chikọrọ ihe ịchọ mma gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.26",
            "verseOrgIds": [
              "EZK.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, a ga-eme ka agụ ọchịchọ ọjọọ nke anụahụ na ịkwa iko, bụ nke i bidoro nʼala Ijipt kwụsị. Ị gaghị enwekwa agụụ ile ihe ndị a niile anya maọbụ chetakwa Ijipt nʼuche gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.27",
            "verseOrgIds": [
              "EZK.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.28",
                "verseOrgIds": [
                  "EZK.23.28"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Lee, ana m aga iwere gị nyefee nʼaka ndị ahụ kpọrọ gị asị, bụ ndị ahụ ị wezugara onwe gị site nʼebe ha nọ nʼihi ịsọ oyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.28",
            "verseOrgIds": [
              "EZK.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-esite nʼịkpọ asị mesie gị ike, pụnara gị ihe niile i nwere nke ị dọgburu onwe gị nʼọrụ nʼihi ha. Ha ga-ahapụ gị ka ịgbara ọtọ ihu na azụ, mgbe ahụ ihere nke ịgba akwụna gị ga-apụta ihe. Agụụ nke ọchịchọ ọjọọ na ịkwa iko gị",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.29",
            "verseOrgIds": [
              "EZK.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "emeela ka ihe ndị a bịakwasị gị, nʼihi na agụụ mmekọrịta nʼebe mba ndị ọzọ gụrụ gị, ị jikwa arụsị ha merụọ onwe gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.30",
            "verseOrgIds": [
              "EZK.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị gbasoro nzọ ụkwụ nwanne gị nwanyị, nʼihi ya, aga m ewere iko ya tinye gị nʼaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.31",
            "verseOrgIds": [
              "EZK.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.32",
                "verseOrgIds": [
                  "EZK.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "\"Iko nwanne gị nwanyị ka ị ga-aṅụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "bụ iko sara mbara ma dịkwa omimi;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "nke ga-eme ka ị ghọọ onye a na-achị ọchị na onye a na-akwa emo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:32"
      },
      "items": [
        {
          "text": "nʼihi na ọ na-anagide ihe dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ejupụta nʼịṅụbiga mmanya oke na iru ụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "nʼihi iko mbibi na ntikpọsi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:33"
      },
      "items": [
        {
          "text": "bụ iko nke nwanne gị nwanyị bụ Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.33",
            "verseOrgIds": [
              "EZK.23.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-aṅụ ya, ṅụchaa ihe dị nʼiko ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "Ị ga-atapịakwa iberibe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        },
        {
          "text": "ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "dọkasịakwa ara gị abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 23:34"
      },
      "items": [
        {
          "text": "Ekwuola m. Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.34",
                "verseOrgIds": [
                  "EZK.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.34",
            "verseOrgIds": [
              "EZK.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.35",
                "verseOrgIds": [
                  "EZK.23.35"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Ebe ọ bụ na i chefuola m, gbakụta m azụ gị, ị ga-ata ahụhụ niile ruuru gị nʼihi mmehie, agụụ ọchịchọ ọjọọ na ịgba akwụna gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.35",
            "verseOrgIds": [
              "EZK.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.36",
                "verseOrgIds": [
                  "EZK.23.36"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Nwa nke mmadụ, ị ga-ekpe Ohola na Oholiba ikpe? Mgbe ahụ, guzogide ha mee ka ha mara ihe arụ niile ha na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.36",
            "verseOrgIds": [
              "EZK.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha akwaala iko, ọbara jupụtakwara nʼaka ha, ha na arụsị ha kwakwara iko. Ha jikwa ọ bụladị ụmụ nke ha mụtaara m chụọ aja nsure ọkụ nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.37",
            "verseOrgIds": [
              "EZK.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọzọ ha mere m bụ nke a: Ha merụrụ ebe nsọ m nʼotu ụbọchị ahụ ha mere ka ụbọchị izuike m gharakwa ịdị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.38",
            "verseOrgIds": [
              "EZK.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nʼotu ụbọchị ahụ ha ji ụmụ ha chụọ aja nye arụsị ha, bụkwa ụbọchị ha batara nʼụlọnsọ m merụọ ya. Ihe dị otu a ka ha mere nʼụlọnsọ m.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.39",
            "verseOrgIds": [
              "EZK.23.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụghị naanị nke a, ha zigara ndị ozi ịkpọ ndị ikom na-esi ebe dị anya bịa, mgbe ha bịara, nʼihi ha, ị sachara ahụ gị nke ọma, tee ihe nʼanya gị, yirikwa ezigbo ihe ịchọ mma gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.40",
            "verseOrgIds": [
              "EZK.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị nọdụrụ nʼelu ihe ndina e doziri nke ọma, na tebul e doro nʼusoro dịkwa nʼihu ya nke ị dọbara ihe nsure ọkụ na-esi isi ụtọ na mmanụ oliv bụ nke m nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.41",
            "verseOrgIds": [
              "EZK.23.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Olu igwe mmadụ ndị obi dị ụtọ na-ada gburugburu ya nʼime ụlọ, e sitekwara nʼọzara bubata ndị ṅụbigara mmanya oke, ha na ọtụtụ ndị ọzọ, Ha gbanyekwara nwanyị a na nwanne ya nwanyị mgbaaka na nkwoji aka ha, yinyekwa ha okpueze mara mma nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.42",
            "verseOrgIds": [
              "EZK.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ihe m kwuru banyere nwanyị ahụ ịkwa iko riri ahụ bụ nke a, 'Ugbu a, ka ha mesoo ya mmeso dịka onye na-agba akwụna, nʼihi na nke ahụ ka ọ bụ.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.43",
            "verseOrgIds": [
              "EZK.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bara dinakwuru ya. Dịka ndị ikom si abakwuru nwanyị akwụna, otu a ka ha si bakwuru ụmụ nwanyị ndụ ọjọọ a bụ Ohola na Oholiba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.44",
            "verseOrgIds": [
              "EZK.23.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 23:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ikpe ezi omume ga-ama ha ụdị ikpe a na-ama ndị inyom na-akwa iko na ndị na-awụsikwa ọbara. Nʼihi na ha bụ ndị na-akwa iko, na ndị ọbara dị nʼaka ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.45",
            "verseOrgIds": [
              "EZK.23.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 23:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.46",
                "verseOrgIds": [
                  "EZK.23.46"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, aga m akpọkọta igwe ndị mmadụ ga-emegide ha, nyefee ha nʼaka oke ihe egwu, nakwa ihe nlụta nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.46",
            "verseOrgIds": [
              "EZK.23.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 23:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpọkọta mmadụ ahụ ga-atụ ha nkume, werekwa mma agha gbudasịa ha. Ha ga-egbu ụmụ ha ndị ikom na ụmụ ha ndị inyom, kpọkwaa ụlọ ha niile ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.47",
            "verseOrgIds": [
              "EZK.23.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 23:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Otu a, aga m eme ka ibi ndụ ọjọọ kwụsị nʼala ahụ, ka esi otu a adọ ndị inyom niile aka na ntị, ka ha hapụ ịgbaso nzọ ụkwụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.48",
            "verseOrgIds": [
              "EZK.23.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 23:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ghaghị ịta ahụhụ nʼihi ndụ ọjọọ nke ịkwa iko gị, hụkwaa ahụhụ nʼihi mmehie niile nke ịkpọ isiala nye arụsị. Mgbe ahụ ị ga-amata na mụ onwe m bụ Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.23.49",
                "verseOrgIds": [
                  "EZK.23.49"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.49",
            "verseOrgIds": [
              "EZK.23.49"
            ]
          }
        }
      ]
    }
