  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "EZK 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.1",
                "verseOrgIds": [
                  "EZK.46.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Ọnụ ụzọ ama nke ogige ime, nke na-eche ihu nʼọwụwa anyanwụ ga-abụ ihe e mechiri emechi nʼụbọchị isii niile unu na-arụ ọrụ. Ma a ga-emeghe ya nʼụbọchị izuike, na nʼụbọchị mmemme ọnwa ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa eze ga-esitekwa na mpụta ọnụ ụlọ nke ọnụ ụzọ ama bata, guzoro nʼakụkụ ọnụ ụzọ ama. Ndị nchụaja ga-edozikwa aja nsure ọkụ ya, na aja udo ya. Ọ ga-anọkwa nʼụlọ mbata kpọọ isiala nke ofufe ya, sitekwa nʼebe ahụ pụọ. Ma a gaghị emechi ọnụ ụzọ ahụ tutu ruo anyasị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu ọnụ ụzọ ama ka ndị ala a ga-anọ fee",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.3",
                "verseOrgIds": [
                  "EZK.46.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ofufe nʼụbọchị izuike na nʼụbọchị mmemme ọnwa ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nwa eze ahụ ga-eji chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.4",
                "verseOrgIds": [
                  "EZK.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "aja nsure ọkụ nʼụbọchị izuike na nʼoge mmemme ọnwa ọhụrụ ga-abụ ụmụ ebule isii, na otu ebule, ndị na-enweghị ntụpọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eweta ihe e ji achụ aja mkpụrụ ọka, nke bụ iri lita ụtụ ọka abụọ na abụọ, na otu ebule. Ọ ga-ewetakwa lita mmanụ oliv asaa maka iri lita ụtụ ọka abụọ na abụọ ahụ, tinyere onyinye ụmụ atụrụ dịka o si masị ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị mmemme ọnwa ọhụrụ, ọ ga-eweta otu nwa oke ehi, ụmụ atụrụ isii na otu ebule, ha niile ọ dịghị nke ga-enwe ntụpọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewetakwa otu oke ehi na iri lita ụtụ ọka iri abụọ na abụọ, maka aja mkpụrụ ọka. Ọ ga-enye ebule ahụ na iri lita ụtụ ọka iri abụọ na abụọ. Ọ ga-enyekwa ụmụ atụrụ ndị ahụ na ụtụ ọka dịka o si masị ya inye ha, tinyere iri lita ọka abụọ na abụọ, nke ọ ga-eweta maka lita mmanụ oliv asaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwa eze ga-abata nʼụlọ ahụ, ọ ga-esite na mpụta ọnụ ụlọ nke ọnụ ụzọ ama, ebe ahụ kwa ka ọ ga-esikwa pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma mgbe ndị ala ahụ ga-abata nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.9",
                "verseOrgIds": [
                  "EZK.46.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼoge mmemme dị nsọ, onye ọbụla sitere nʼọnụ ụzọ dị nʼugwu bata aghaghị ịpụ site nʼọnụ ụzọ nke dị na ndịda. Ndị si na ndịda bata ga-esitekwa nʼụzọ nke ugwu pụọ. Ọ dịghị onye ga-esi nʼụzọ o si bata laghachi, kama ha ga-esi ụzọ nke chere ebe ha si bata ihu pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa eze ga-anọ nʼetiti ha, ọ bụrụ na ha abanye, ọ ga-eso ha banye, ọ bụrụkwa na ha apụwa, ọ ga-esokwa ha pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge mmemme ndị ahụ pụrụ iche, na mmemme ndị akara aka, ihe a ga-eji nye onyinye mkpụrụ ọka ga-abụ iri lita ụtụ ọka abụọ na abụọ, na otu oke ehi, na iri lita ụtụ ọka abụọ na abụọ na otu ebule, tinyere ụmụ atụrụ nke ọnụọgụgụ ya ga-abụ dịka o si masị ya, tinyere lita mmanụ asaa maka iri lita ụtụ ọka abụọ na abụọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.11",
            "verseOrgIds": [
              "EZK.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ọbụla onyeisi chọrọ inye onyinye afọ ofufu, maka ịchụrụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.12",
                "verseOrgIds": [
                  "EZK.46.12"
                ]
              }
            }
          ]
        },
        {
          "text": "aja nsure ọkụ maọbụ aja udo, a ga-emeghere ya ọnụ ụzọ ime nke dị nʼọwụwa anyanwụ ka o si nʼebe ahụ bata. Ọ ga-enye onyinye ya dịka e si enye ya nʼụbọchị izuike. Emesịa, ọ ga-atụgharịa pụọ. A ga-emechikwa ụzọ ahụ mgbe ọ pụchara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụ nwa atụrụ gbara otu afọ nke na-enweghị ntụpọ ka ị ga-eweta ụbọchị niile maka ịchụ aja nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.13",
                "verseOrgIds": [
                  "EZK.46.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ bụ kwa ụtụtụ, kwa ụtụtụ ka ị ga-eweta ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ewetakwa onyinye mkpụrụ ọka kwa ụtụtụ kwa ụtụtụ tinyere ya, ihe niile ga-emejupụta ya bụ lita ụtụ ọka isii, na lita mmanụ abụọ e ji agwakọta ya. Iche onyinye mkpụrụ ọka a nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.14",
                "verseOrgIds": [
                  "EZK.46.14"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ụkpụrụ ga-adịgide ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha ga-edozi nwa atụrụ na ụtụ ọka na mmanụ oliv ahụ, kwa ụtụtụ kwa ụtụtụ, maka aja nsure ọkụ a na-achụ kwa mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.16",
                "verseOrgIds": [
                  "EZK.46.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, ọ bụrụ na onyeisi enye onye ọbụla nʼime ụmụ ya ndị ikom onyinye site nʼihe nketa ya, ihe ahụ ga-abụ nke ya, bụrụkwa nke mkpụrụ ya, ọ ga-abụ oke ha site nʼihe nketa ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwanụ na o kenye otu nʼime ndị ohu ya ala site nʼihe nketa ya, ala ahụ ga-abụ nke ohu ahụ tutu ruo nʼafọ inwere onwe, nke bụ afọ asaa ọbụla. Mgbe ahụ, ohu ahụ ga-enwere onwe ya, ma ala ahụ ga-aghọkwa nke nwa eze ahụ. Ihe nketa ya bụ nke dịịrị naanị ụmụ ya, nke ha ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.17",
            "verseOrgIds": [
              "EZK.46.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa eze ahụ agaghị ewere ala ọbụla site nʼihe nketa ndị mmadụ nʼaka ike, si otu a chụpụ ha site nʼala ha. Ala ọbụla ọ na-enye ụmụ ya ga-abụrịrị ihe nketa sitere nʼala nke aka ya. Ka a ghara ime ka ọ bụladị otu nʼime ndị m bụrụ onye e kewapụrụ site nʼihe nketa ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị, o duuru m site nʼọnụ ụzọ dị nʼakụkụ ọnụ ụzọ ama kpọbata m nʼọnụụlọ ndị ahụ dị nsọ, nke chere ihu nʼugwu, nke bụ ihe nketa ndị nchụaja. O gosiri m otu ebe dị na nsọtụ akụkụ ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.19",
            "verseOrgIds": [
              "EZK.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Ebe a ka ndị nchụaja ga-anọ sie anụ aja ikpe ọmụma na aja mmehie. Ebe a ka ha ga-anọkwa ghee onyinye mkpụrụ ọka, ka a ghara iwebata ha na mpụta ogige a nakwa ido ndị mmadụ nsọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, o mere ka m pụta ọzọ nʼogige ezi. O duuru m gaa nʼakụkụ anọ nke ogige ahụ. Ahụrụ m na e nwere ogige nke dị nʼakụkụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ anọ nke ogige ndị a, ogige ndị ọzọ dị nʼime ha. Ha ruru mita iri abụọ na atọ nʼogologo, ebe obosara ha rukwara mita iri na asaa nʼọkara. Ogige anọ ndị a ha nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ụlọ ahụ, gburugburu ya, e nwere ahịrị e ji nkume doo, nke nwere ekwu dị nʼokpuru ahịrị nkume ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
              "EZK.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Ndị a bụ ụlọ ebe ndị niile na-eje ozi nʼụlọnsọ ukwu ahụ ga-anọ na-esi ihe aja niile ndị mmadụ webatara.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.24",
            "verseOrgIds": [
              "EZK.46.24"
            ]
          }
        }
      ]
    }
  ],
