{
  "id": "EZK.19",
  "number": "19",
  "bookId": "EZK",
  "reference": "Izikiel 19",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "EZK 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ akwa nʼihi ọnọdụ ụmụ eze Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, bụọrọnụ ndịisi Izrel abụ akwa a,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.1",
            "verseOrgIds": [
              "EZK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma kwuo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "\" 'Ụdị nne Ọdụm gịnị ka nne gị bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "nʼetiti ụmụ ọdụm.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "Ọ dinara nʼetiti ha,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "na-azụ ụmụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zụlitere otu nʼime ụmụ ya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "nke ghọrọ nwa ọdụm siri ike.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "Ọ mụtakwara ka e si adọrisi anụ ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "ghọọ ọdụm na-eri mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile nụrụ maka ihe banyere ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "mee ka ọ danye nʼolulu ha gwuru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "Ha ji nko koro ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "duru ya gaa nʼala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ọ hụrụ na ọ dịkwaghị ihe ọzọ o nwere ike ime banyere ọnọdụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "matakwa na olileanya ya abụrụla ihe efu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "ọ họpụtara nwa ya ọzọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "kuziere ya otu ọ ga-esi bụrụ ọdụm dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ghọrọ onyeisi ụmụ ọdụm niile,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ ọdụm siri ike,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "ọ mụtakwara ka e si ejide anụ ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "ya onwe ya ghọkwara ọdụm na-eri mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tikpọrọ ebe ha niile e wusiri ike",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "meekwa obodo ha niile mkpọmkpọ ebe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "Ala ahụ na ndị niile nọ nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "mara jijiji site nʼoke egwu nʼihi olu ịgbọ ụja ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị agha nke mba niile dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "pụtara gbaa ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "Ha sitere nʼakụkụ niile nwude ya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "nʼọnya olulu ha siiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha tinyere ya nko nʼimi, were dọkpuo ya nʼụlọ igwe a kpara akpa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "bute ya nʼihu eze Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "E mere ka o biri na mba ọzọ dịka ohu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "ka a ghara ịnụ ụda olu ya ọzọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "nʼugwu niile nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nne gị dịka osisi vaịnị nʼogige vaịnị",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "a kụrụ nʼakụkụ mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "nke nwere ọtụtụ alaka, nke na-amịkwa mkpụrụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "nʼihi mmiri ọ na-enweta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaka ya niile siri ike,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        }
      ]
