        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ Izikiel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, bilie ọtọ, guzo nʼụkwụ gị abụọ, nʼihi na ana m aga ịgwa gị okwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.1",
            "verseOrgIds": [
              "EZK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ahụ banyere nʼime m mgbe ahụ ọ na-ekwu okwu, mee ka m guzo ọtọ nʼụkwụ m abụọ. Anụrụ m ka ọ gwara m okwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
              "EZK.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, ana m eziga gị ka i jekwuru ndị Izrel, ndị bụ mba na-enupu isi, ndị nupuru isi megide m. Ha na nna nna ha enupula isi megide m, ruo ọ bụladị nʼụbọchị taa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.3",
            "verseOrgIds": [
              "EZK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ m na-eziga gị ka i jekwuru bụ ndị isiike na ndị nnupu isi. Sị ha, 'Ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.2.4",
                "verseOrgIds": [
                  "EZK.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha gere gị ntị, ma ha egeghị gị ntị (ha bụ ndị na-enupu isi), ihe dị mkpa bụ na ha ga-amata na onye amụma anọọla nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
            "verseOrgIds": [
              "EZK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị nwa nke mmadụ, atụla ha egwu. Ka ụjọ okwu si ha nʼọnụ ghara ịtụkwa gị. Atụla egwu, ọ bụladị ma a sị na ogwu na uke gbara gị gburugburu, ọ bụladị ma a sị na i bi nʼetiti ụmụ akpị. Ka ụjọ ghara ịtụ gị nʼihi okwu ọnụ ha, ekwekwala ka ha menye gị egwu, nʼihi na ha bụ ndị na-enupu isi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.6",
            "verseOrgIds": [
              "EZK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ghaghị izi ha ozi m ziri gị zie ha, ma ha gere ntị ma ha egeghị ntị, nʼihi na ha bụ ndị na-enupu isi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị, nwa nke mmadụ, gee ntị nʼihe m na-agwa gị. Enupula isi dịka ha si nupu isi. Meghee ọnụ gị taa ihe m ga-etinye gị nʼọnụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.8",
            "verseOrgIds": [
              "EZK.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mgbe ahụ, elere m anya hụ aka e setịpụrụ, nke ji akwụkwọ a fụkọrọ afụkọ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke e dekwara ihe nʼime ya, ihu na azụ ya. Aka ahụ ji ya gbasapụrụ ya mee ka m hụ ihe e dere nʼime ya. Ọ bụ okwu ịkwa akwa na iru ụjụ na ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
              "EZK.2.10"
            ]
          }
        }
      ]
    }
  ],
