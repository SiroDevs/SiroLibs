  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "EZK 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nwoke ahụ kpọbatara m nʼọnụ ụlọ ezumezu ahụ, ọ tụrụ akụkụ ọnụ ụzọ ya. Akụkụ ya ọbụla dị mita atọ na ụma abụọ, nke a bụ obosara ụlọ ikwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obosara ọnụ ụzọ mbata ya dị mita ise na ụma atọ. Akụkụ aja abụọ nke ọnụ ụzọ ahụ dịkwa mita abụọ na ụma asaa. Ọ tụkwara ogologo ụlọ ezumezu ahụ; ya dịrị iri mita abụọ na otu nʼogologo, obosara ya dị mita iri na otu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ banyere nʼime ime ebe nsọ ahụ, tụọ ogidi dị nʼọnụ ụzọ e si abanye nʼime ya, chọpụta na obosara nke ọbụla bụ otu mita na otu ụma, obosara ọnụ ụzọ ahụ nʼonwe ya dị mita atọ na ụma abụọ. Akụkụ aja nke ọnụ ụzọ ọbụla dị mita atọ na ụma asaa nʼobosara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụrụ ogologo ime ebe nsọ ahụ, ya dị mita iri na ọkara, obosara ya dịkwa mita iri na ọkara, nʼogologo ụlọ ezumezu ahụ. Ma ọ sịrị m, \"Ebe a bụ Ebe Kachasị Nsọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụkwara mgbidi ụlọnsọ ukwu ahụ chọpụta na ịdị igbidi ya bụ mita atọ na ụma abụọ. E nwekwara ọnụụlọ ndị dị gburugburu ụlọnsọ ukwu ahụ, nke ọbụla dị mita abụọ na otu ụma nʼigbidi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụụlọ nta ndị a dị nʼokpukpu atọ, nke ọbụla nʼelu ibe ya, okpukpu ọbụla nwere iri ọnụụlọ atọ. E nwere mgbidi gbara aja ụlọnsọ ahụ gburugburu nʼakụkụ niile, ka ha bụrụ ihe nkwado nye ọnụụlọ nta ndị a, ka ihe nkwado ndị a ghara ịbụ ihe a rụnyere nʼaja ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.6",
            "verseOrgIds": [
              "EZK.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wuru ọnụụlọ nta ndị a ka obosara ọnụụlọ ndị ahụ niile dị nʼelu ibe ha dị ukwuu karịa obosara ndị nke dị nʼokpuru ha. Nʼụzọ dị otu a, obosara ọnụụlọ niile dị nʼokpukpu nke abụọ dị ukwuu karịa nke dị nʼala; nke atọ dịkwa ukwuu karịa nke abụọ. E wukwara ebe e si arịgo site nʼokpukpu nke dịkarịsịrị ala rigoruo nʼọnụụlọ ndị kachasị elu, site nʼokpukpu nke dị nʼetiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m na ụlọnsọ ukwu ahụ nwere ebe e wuliri elu nʼakụkụ ya niile. Ọ bụkwa ebe a dị elu ka e ji mee ntọala ọnụụlọ nta ndị ahụ niile. Ịdị ogologo nke ebe ahụ e wuliri elu bụ mita atọ na ụma abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ nke mgbidi ọnụụlọ nta ndị a nʼakụkụ ezi bụ mita abụọ na ụma atọ. Ala tọgbọrọ nʼefu nʼetiti ọnụụlọ nta ụlọnsọ ukwu ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ọnụụlọ ndị nchụaja dị mita iri na ọkara nʼobosara, gbaa gburugburu ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere ọnụ ụzọ ndị a na-esi abanye nʼọnụụlọ nta ndị ahụ, site nʼala ahụ na-enweghị ihe arụrụ na ya, otu ọnụ ụzọ nʼakụkụ ugwu, nke ọzọ nʼakụkụ ndịda. Obosara ala nke fọdụrụ dị mita abụọ na ụma atọ nʼakụkụ niile gbaa gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụlọ nke na-eche ihu nʼogige ụlọnsọ ukwu ahụ, nʼakụkụ ọdịda anyanwụ, dị iri mita atọ na asaa nʼobosara, ịdị igbidi nke aja ụlọ ahụ dị mita abụọ na ụma atọ, gbaa gburugburu, ogologo ya dịkwa iri mita anọ na asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ tụrụ ụlọnsọ ukwu ahụ, ya dịrị iri mita ise na atọ, ogige ụlọnsọ, na ụlọ ahụ nakwa mgbidi ya, dịkwa iri mita ise na atọ nʼogologo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.13",
            "verseOrgIds": [
              "EZK.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obosara nke ogige ụlọnsọ nʼakụkụ ọwụwa anyanwụ, tinyere ebe ihu ụlọnsọ ukwu ahụ, dị iri mita ise na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụrụ ịdị ogologo nke ụlọ ahụ chere ihu nʼogige dị nʼazụ ụlọnsọ ukwu ahụ, tinyere ebe njegharị ya nke dị nʼakụkụ abụọ ya. Ọ dị iri mita ise na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 41:15"
      },
      "items": [
        {
          "text": "Ụlọ ezumezu ahụ, nʼime ebe nsọ ahụ, na mpụta nke ọnụ ụlọ, bụ nke chere ihu nʼogige ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya na ọnụ ụzọ ndị ahụ, na oghereikuku niile dị warawara, na ebe njegharị gbara ha atọ gburugburu, ihe niile, elu ma ala, tinyere ọnụ ụzọ bụ nke eji osisi mmachite. Ala ya, na mgbidi ya ruo na oghereikuku, ma oghereikuku niile bụkwa ihe ekpuchiri ekpuchi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu oghere dị nʼebe ọnụ ụzọ ezi, nke gara nʼime ebe nsọ, nakwa nʼahụ aja niile, na nkebi na nkebi, gbaa gburugburu nʼime na nʼezi ebe nsọ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka a tụrụ oyiyi cherubim na osisi nkwụ. Cherubim na-esota osisi nkwụ. Osisi nkwụ ọbụla na-esotakwa cherubim. Cherub ọbụla nwere ihu abụọ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.18",
            "verseOrgIds": [
              "EZK.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "otu akụkụ cherub nke bụ ihu mmadụ chere ihu nʼotu nkwụ. Ihu ya nke ọzọ, nke bụ ihu ọdụm, chere ihu na nkwụ nke dị akụkụ nke ọzọ. A tụrụ ha gburugburu ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼala ụlọ ruo nʼelu ọnụ ụzọ ya, a tụrụ oyiyi cherubim na osisi nkwụ nʼahụ aja ụlọ ezumezu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
              "EZK.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụlọ ezumezu ahụ nwere mbudo ibo nke akụkụ anọ ya ha otu nʼọtụtụ. Nke dị nʼihu Ebe ahụ Kachasị Nsọ, yiri ndị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.21",
            "verseOrgIds": [
              "EZK.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ịchụ aja ya bụ nke eji osisi wuo. Akụkụ niile nke ebe ịchụ aja a ha nʼotu. Ọ dị otu mita na ọkara nʼogologo, dịrịkwa iri sentimita itoolu nʼakụkụ ya ọbụla. Osisi ka e ji wuo nkuku anọ ya, akụkụ ya niile, na ntọala ya. Mgbe ahụ, nwoke ahụ gwara m, \"Nke a bụ tebul na-adị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.22",
            "verseOrgIds": [
              "EZK.41.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.41.22",
                "verseOrgIds": [
                  "EZK.41.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.22",
            "verseOrgIds": [
              "EZK.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụlọ ezumezu, ma Ebe ahụ Kachasị Nsọ, nwere ọnụ ụzọ abụọ, nʼotu nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
