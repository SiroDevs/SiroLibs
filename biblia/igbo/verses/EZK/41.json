              "type": "text"
            }
          ]
        },
        {
          "text": "Windo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
            "verseOrgIds": [
              "EZK.41.26"
            ]
          }
        },
        {
          "text": "dị warawara dị nʼaja mpụta ọnụ ụlọ ahụ, nke e sekwasịrị oyiyi osisi nkwụ; ọnụụlọ nta niile nke ụlọnsọ ukwu ahụ nwekwara ihe a rụnyere nʼelu ụzọ ya, nke a machiri amachi.",
          "type": "text",
