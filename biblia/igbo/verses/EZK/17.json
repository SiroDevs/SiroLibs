  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "EZK 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ugo abụọ na otu osisi vaịnị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.1",
            "verseOrgIds": [
              "EZK.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.1",
                "verseOrgIds": [
                  "EZK.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.1",
            "verseOrgIds": [
              "EZK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, tụọ ilu kọwaara ụlọ Izrel akụkọ ihe ọmụma atụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.2",
            "verseOrgIds": [
              "EZK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sị ha, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.3",
                "verseOrgIds": [
                  "EZK.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, otu ugo nke nwere nku abụọ buru ibu, nke abụba ya tụrụ agwa agwa ma dịkwa ogologo, feere bịa na Lebanọn, tụjiri ọnụ ọnụ osisi sida kachasị ibe ya ogologo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.3",
            "verseOrgIds": [
              "EZK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kubipụrụ ọnụ ọnụ alaka osisi a, buru ya gaa nʼala ebe ọtụtụ ndị na-azụ ahịa juru, kụọ ya nʼobodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.4",
            "verseOrgIds": [
              "EZK.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'O sitekwara nʼala ahụ were otu mkpụrụ kụọ ya nʼala mara nnọọ ezi mma. Ọ kụrụ ya dịka e si akụ osisi wilo nʼakụkụ ebe enwere ụba mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.5",
            "verseOrgIds": [
              "EZK.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị anya, mkpụrụ osisi ahụ gbara mgbọrọgwụ, too, ghọọ osisi vaịnị dị mkpụmkpụ, nke na-awasa awasa, nke alaka ya niile chere ihu nʼebe ugo ahụ nọ. O nwekwara alaka siri ike, na akwụkwọ mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.6",
            "verseOrgIds": [
              "EZK.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma e nwekwara ugo ọzọ, nke nwere nku sara mbara, nke jupụtara nʼabụba. Mgbe ugo a bịara, osisi vaịnị a gbasakwara mgbọrọgwụ ya na alaka ya, chee ugo ahụ ihu, ka ọ gbakwasị ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.7",
            "verseOrgIds": [
              "EZK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kụrụ ya nʼebe ala dị mma, nʼakụkụ ọtụtụ mmiri, ka o nwee ike wapụta ngalaba, mịa mkpụrụ, ghọọkwa ezigbo vaịnị mara mma.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.8",
            "verseOrgIds": [
              "EZK.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sị ha, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.9",
                "verseOrgIds": [
                  "EZK.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Ọ ga-adịhụkwa? Ọ bụ na agaghị ehopu mgbọrọgwụ ya niile, bipụkwa mkpụrụ ya niile mee ka ọ kpọnwụọ? Ka akwụkwọ ndụ niile nke na-epute ọhụrụ kpọnwụọ. Ọ gaghị ewekwa ogwe aka dị ike maọbụ ọtụtụ ndị mmadụ ihopụta ya site na mgbọrọgwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.9",
            "verseOrgIds": [
              "EZK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kụọla ya ma ọ ga-etokwa? Ọ gaghị akpọnwụ kpamkpam mgbe oke ifufe si nʼọwụwa anyanwụ feturu ya, kpọnwụchakwaa nʼala ebe ahụ ọ nọ puo?' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.11",
                "verseOrgIds": [
                  "EZK.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, gwa ndị nnupu isi ahụ, 'unu maara ihe ilu a pụtara?' Sị ha, 'Lee, Babilọn bịara na Jerusalem dọkpụrụ eze ya na ndị ọchịchị ya laa Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O were otu onye site nʼezinaụlọ eze, ya na ya gbara ndụ, bụ onye o mere ka ọ ṅụọ iyi. O sitekwara nʼala ahụ bupụ ndị ndu obodo ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, alaeze ahụ ghọrọ alaeze e wedara nʼala nke ukwuu, nke na-enweghịkwa ike ibili ọzọ. Ọganihu nke alaeze ahụ dabeere naanị na ndebe ha debere ọgbụgba ndụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o nupuru isi nʼokpuru ya site nʼiziga ndị ozi nʼIjipt ka ha nye ya ọtụtụ ịnyịnya na ndị agha. Ọ ga-enwetakwa ihe ọ chọrọ? Onye na-eme ihe dị otu a, ọ pụrụ ịgbanarị ntaramahụhụ? Ọ pụrụ imebi ọgbụgba ndụ ma gbalaga?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.15",
            "verseOrgIds": [
              "EZK.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼezie, dịka mụ onwe m na-adị ndụ, otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.16",
            "verseOrgIds": [
              "EZK.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.16",
                "verseOrgIds": [
                  "EZK.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri, ọ ga-anwụ na Babilọn, nʼala nke eze ahụ mere ka ọ nọkwasị nʼocheeze, bụ onye o ledara ịṅụ iyi ya anya mebikwaa ọgbụgba ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.16",
            "verseOrgIds": [
              "EZK.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị igwe ndị agha ya siri ike, Fero agaghị enwe ike zọpụta ya nʼagha, mgbe ha ga-ewulite mgbidi agha, gwuokwa olulu nnọchibido iji gbuo ọtụtụ mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.17",
            "verseOrgIds": [
              "EZK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lelịrị ịṅụ iyi ahụ site nʼimebi ọgbụgba ndụ ahụ. Nʼihi na o nyere aka ya nʼihe ibe ma gaa nʼihu mee ihe ndị a niile, mgbapụ agaghị adịrị ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.18",
            "verseOrgIds": [
              "EZK.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ya mere, otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.19",
                "verseOrgIds": [
                  "EZK.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, Dịka mụ onwe m na-adị ndụ, aga m akwụghachi ya nʼihi nleda anya o ledara ịṅụ iyi m nakwa nʼihi ọgbụgba ndụ nke o mebiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.19",
            "verseOrgIds": [
              "EZK.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m agbasa ụgbụ m nʼụzọ o si aga; ọnya m ga-amakwa ya. Aga m ewetakwa ya na Babilọn, nọdụkwa nʼebe ahụ taa ya ahụhụ nʼihi na ọ kwesighị ntụkwasị obi nye m.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.20",
            "verseOrgIds": [
              "EZK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mma agha ka a ga-eji gbuo ndị agha ya niile na-agbapụ ọsọ, ndị niile fọdụrụ ka a ga-achụsasị nʼakụkụ niile. Mgbe ahụ, ị ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.21",
                "verseOrgIds": [
                  "EZK.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.21",
            "verseOrgIds": [
              "EZK.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.22",
                "verseOrgIds": [
                  "EZK.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Mụ onwe m ga-esi nʼọnụ ọnụ osisi kachasị mma nke osisi sida kachasị elu kụrụ ihe m ga-akụ. Aga m esi nʼọnụ ọnụ osisi sida dị elu kụrụ alaka dị nro, nke m ga-akụ nʼugwu dị ezigbo elu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼelu ugwu niile nke Izrel ka m ga-akụnye ya. Ọ ga-awapụtakwa alaka ya, mịa mkpụrụ, bụrụkwa sida mara oke mma. Ụmụ nnụnụ dị iche iche ga-ewu akwụ ha na ya, ha ga-achọtakwa ebe obibi na ndo nke alaka ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.23",
            "verseOrgIds": [
              "EZK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, osisi ọhịa niile ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.24",
            "verseOrgIds": [
              "EZK.17.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.17.24",
                "verseOrgIds": [
                  "EZK.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ onye na-egbuda osisi niile dị elu, ma na-ewelikwa ndị dị nta elu. Na ọ bụ m na-eme ka osisi dị ndụ kpọnwụọ, ma na-emekwa ka nke nwụrụ anwụ dịrị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.24",
            "verseOrgIds": [
              "EZK.17.24"
            ]
          }
        }
      ]
    },
