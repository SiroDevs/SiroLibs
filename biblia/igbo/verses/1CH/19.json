  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1CH 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid emerie ndị Amọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, Nahash eze ndị Amọn nwụrụ, nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.1",
            "verseOrgIds": [
              "1CH.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid chere sị, \"Aga m egosi Hanọn nwa Nahash obi ebere nʼihi na nna ya gosiri m obi ebere.\" Ya mere, Devid zipụrụ ndị ozi ka ha gaa kasịe ya obi nʼihi ọnwụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:2"
      },
      "items": [
        {
          "text": "Mgbe ndị ozi Devid bịakwutere Hanọn nʼala ndị Amọn ịkasị ya obi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.2",
            "verseOrgIds": [
              "1CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndịisi ala Amọn sịrị Hanọn, bụ onyenwe ha, \"Ị na-eche na Devid na-akwanyere nna gị ụgwụ site na izite ndị ozi ya ka ha bịa kasịe gị obi? Ọ bụ na ndị ozi ya abịakwuteghị gị, naanị ka ha mee nledo, nyochapụta otu obodo a dị ma kwatuo ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.3",
            "verseOrgIds": [
              "1CH.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Hanọn jidere ndị ozi Devid nʼike, kpụchapụ ha ajị, bipụkwa uwe mwụda ha nʼetiti ike ha, zilaga ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.4",
            "verseOrgIds": [
              "1CH.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe otu onye bịara zie Devid ihe banyere ndị ikom ahụ, o zipụrụ ndị ozi, ka ha gaa zute ha, nʼihi na e mere ha ihe ihere nʼebe ọ dị ukwuu. Eze sịrị, \"Nọdụnụ na Jeriko tutu ruo mgbe afụọnụ unu tolitere, mgbe ahụ unu ga-alọta.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.5",
            "verseOrgIds": [
              "1CH.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Amọn chọpụtara na ha abụrụla ihe ịsọ oyi nʼebe Devid nọ, Hanọn na ndị Amọn zipụrụ otu puku talenti ọlaọcha iji gbazite ụgbọ agha na ndị na-agba ụgbọ agha site na Aram Naharaim, na Aram Maaka, nakwa Zoba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.6",
            "verseOrgIds": [
              "1CH.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha goro ụgbọ agha ọnụọgụgụ ya dị iri puku atọ, na puku abụọ. Ha gokwara eze Maaka na ndị agha ya, ndị bịara maa ụlọ ikwu agha ha na nso Medeba, ebe ndị Amọn sikwa nʼobodo ha niile chịkọta onwe ha pụta ịlụ agha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.7",
            "verseOrgIds": [
              "1CH.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid nụrụ nke a, o zipụrụ Joab na ndị agha ya niile bụ dike na dimkpa nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.8",
            "verseOrgIds": [
              "1CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Amọn pụtara doo onwe ha nʼusoro ibu agha, nʼọnụ ụzọ ama obodo ha. Ma ndị eze ahụ bịara agha, nọpụrụ onwe ha na mbara ala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.9",
            "verseOrgIds": [
              "1CH.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Joab hụrụ na agha dị megide ya nʼihu na azụ, ọ họpụtara ụfọdụ ndị ọkachamara site nʼetiti ndị agha Izrel, doo ha nʼusoro izute ndị Aram.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.10",
            "verseOrgIds": [
              "1CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tinyere ndị ikom fọdụrụ nʼokpuru ọchịchị Abishai, nwanne ya, e zipụrụ ha izute ndị Amọn nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.11",
            "verseOrgIds": [
              "1CH.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Abishai na-apụ, Joab gwara ya okwu sị ya, \"Ọ bụrụ na ndị Aram esie ike karịa m, mgbe ahụ, ị ga-abịa napụta m. Ọ bụrụkwanụ na ndị Amọn adịrị ike karịa gị, aga m abịa napụta gị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.12",
            "verseOrgIds": [
              "1CH.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwee obi ike, ka anyị lụọ ọgụ a dịka ndị dị ike, nʼihi ndị anyị na obodo niile nke Chineke anyị. Ka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.19.13",
                "verseOrgIds": [
                  "1CH.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": "meekwa ihe dị mma nʼanya ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joab na ndị agha so ya bịara nso ibuso ndị Aram agha, ha sitere nʼihu ha gbapụ ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Amọn hụrụ ka ndị Aram na-agbapụ ọsọ, ha onwe ha gbakwaara ọsọ nʼihu Abishai, gbaba nʼime obodo. Ya mere, Joab laghachiri na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Aram hụrụ na ndị Izrel tigburu ha, ha zipụrụ ndị ozi gara kpọta ndị Aram site nʼofe ọzọ nke Osimiri Yufretis. Ọ bụ Shofaka ọchịagha ndị agha Hadadeza na-edu ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.16",
            "verseOrgIds": [
              "1CH.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara Devid banyere nke a, ọ chịkọtara ndị Izrel niile, pụọ gafee Jọdan. O gara nso imegide ha, o doro usoro agha ya na ncherita ihu ha. Devid doro usoro ndị agha ya izute ndị Aram nʼagha, ha lụsokwara ya agha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.17",
            "verseOrgIds": [
              "1CH.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha sitere nʼihu ndị Izrel gbaa ọsọ. Devid gburu puku asaa nʼime ndị ikom na-anya ụgbọ agha, gbukwaa iri puku ndị agha anọ ndị na-eji ụkwụ eje. O gbukwara Shofaka, bụ ọchịagha agha ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.18",
            "verseOrgIds": [
              "1CH.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị eze niile nọ nʼokpuru ọchịchị Hadadeza hụrụ na Izrel etigbuola ha, ha mere ka ha na Devid dịrị nʼudo, bụrụkwa ndị nọ nʼokpuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 19:19"
      },
      "items": [
        {
          "text": "Ya mere, ndị Aram adịghịkwa njikere inyere ụmụ Amọn aka ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.19",
            "verseOrgIds": [
              "1CH.19.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1CH.20",
    "number": "20",
    "bookId": "1CH"
  },
