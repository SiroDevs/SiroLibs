            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.15.29",
                "verseOrgIds": [
                  "1CH.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "na-abata nʼobodo Devid, Mikal nwa Sọl, lepụrụ anya site na oghereikuku ụlọ. Mgbe ọ hụrụ eze Devid ka ọ na-ayọrị egwu na-aṅụrị ọṅụ, o ledara ya anya nʼime obi ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
