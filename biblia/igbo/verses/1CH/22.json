                "verseOrgIds": [
                  "1CH.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "na nʼaka ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.18",
            "verseOrgIds": [
              "1CH.22.18"
            ]
          }
        },
        {
