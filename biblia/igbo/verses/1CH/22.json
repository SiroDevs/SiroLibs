                "verseOrgIds": [
                  "1CH.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke, ka unu nweekwa ike ibubata igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
