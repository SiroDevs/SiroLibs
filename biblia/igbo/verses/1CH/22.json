                "verseOrgIds": [
                  "1CH.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu. Malitekwanụ iwu ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
