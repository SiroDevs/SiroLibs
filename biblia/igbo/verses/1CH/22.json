              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, tinyenụ obi unu na mmụọ unu nʼịgbaso",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
