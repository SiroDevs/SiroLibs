  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1CH 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwa Onyenwe anyị kwere Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid nọsara ahụ nʼụlọeze ya, ọ sịrị Netan onye amụma, \"Lee, mụ onwe m na-ebi nʼụlọ sida, ma igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.1",
                "verseOrgIds": [
                  "1CH.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dị nʼokpuru ụlọ ikwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netan zaghachiri Devid, \"Ihe ọbụla dị gị nʼobi, mee ya, nʼihi na Chineke nọnyeere gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼabalị ahụ, okwu Chineke rutere Netan ntị, na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.3",
            "verseOrgIds": [
              "1CH.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaa gwa ohu m Devid sị ya, 'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.4",
                "verseOrgIds": [
                  "1CH.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Gị onwe gị agaghị ewuru m ụlọ ebe m ga-ebi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ebibeghị m nʼụlọ site nʼụbọchị m si nʼIjipt kpọpụta Izrel ruo taa. Kama e sitela m nʼotu ọmụma ụlọ ikwu baa na nke ọzọ, sitekwa nʼotu ebe obibi gaa ebe nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.5",
            "verseOrgIds": [
              "1CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ọbụla m na-ejegharị nʼetiti ndị Izrel niile, ọ dị mgbe m sịrị onye ọbụla nʼime ndị ndu ha, ndị m nyere iwu ka ha zụọ ndị m, sị, \"Gịnị mere unu ewubereghị m ụlọ sida?\" '",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.6",
            "verseOrgIds": [
              "1CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, gwa Devid bụ ohu m, sị, 'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.7",
                "verseOrgIds": [
                  "1CH.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru: Mụ onwe m sitere nʼọhịa ebe ịta nri nke ụmụ anụ ụlọ, sikwa nʼebe ị na-azụ igwe ewu na atụrụ kpọpụta gị, mee gị onye na-achị ndị m Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọnyekwara m gị nʼebe ọbụla ị gara, kpochapụ ndị iro gị niile site nʼihu gị. Ugbu a, aga m eme ka aha gị dịka aha ndị ikom dịkarịsịrị ukwuu nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.8",
            "verseOrgIds": [
              "1CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ahọpụta otu ebe nʼihi ndị m Izrel, kụkwa ha dịka osisi ka ha biri nʼebe obibi nke aka ha, ka ha ghara ị bụkwa ndị a na-esogbu ọzọ. Ndị ajọ mmadụ agaghị emegbukwa ha dịka ha mere na mbụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.9",
            "verseOrgIds": [
              "1CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "dịka ha na-emekwa siterị na mgbe m họpụtara ndị ndu nye ndị m Izrel. Aga m eme ka ndị iro gị niile nọrọ nʼokpuru gị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1CH 17:10"
      },
      "items": [
        {
          "text": "\" 'Ana m ekwupụtara gị na",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.10",
                "verseOrgIds": [
                  "1CH.17.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ewuru gị ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị gị nʼụwa zuru, mgbe ị gakwuru ndị nna nna gị ha, aga m eme ka otu mkpụrụ gị bilie nọchie ọnọdụ gị, ọ ga-abụ otu nʼime ụmụ ndị ị mụrụ. Aga m emekwa ka alaeze ya guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.11",
            "verseOrgIds": [
              "1CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya onwe ya ga-ewuru m ụlọ, aga m emekwa ka ocheeze ya guzosie ike ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.12",
            "verseOrgIds": [
              "1CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ga-abụrụ ya nna, ya onwe ya ga-abụkwara m nwa. Agaghị m ewezuga ịhụnanya m site nʼebe ọ nọ, dịka m mere onye bu gị ụzọ chịa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
            "verseOrgIds": [
              "1CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ọ chịa ụlọ m na nʼalaeze m ruo mgbe ebighị ebi. A ga-emekwa ka ocheeze ya bụrụ ihe guzosiri ike ruo mgbe ebighị ebi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netan ziri Devid ozi dịka okwu niile nke ọhụ ahụ si dị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze Devid banyere nọdụ ala nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.16",
                "verseOrgIds": [
                  "1CH.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", sị:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1CH 17:16"
      },
      "items": [
        {
          "text": "\"Onye ka m bụ,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.16",
                "verseOrgIds": [
                  "1CH.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke, gịnịkwa ka ezinaụlọ m bụ, na ị mere ka m bịaruo nʼogogo ha otu a?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke m, dịka a ga-asị na nke a bụ ihe dị nta nʼanya gị, ugbu a, i kwuola banyere ọdịnihu nke ụlọ ohu gị. Ma gị onwe gị",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.17",
                "verseOrgIds": [
                  "1CH.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke na-ele m anya dịka a ga-asị na m bụ onye ọnọdụ ya dị elu karịchasịa nke ụmụ mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gịnị ọzọ ka Devid ga-agwa gị, nʼihi nsọpụrụ i nyere ohu gị? Nʼihi na ị maara ohu gị nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.19",
                "verseOrgIds": [
                  "1CH.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼihi okwu gị na dịka ọchịchọ obi gị si dị, i meela ihe a dị ukwuu, meekwa ka ọ mata nkwa ndị a niile dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.20",
                "verseOrgIds": [
                  "1CH.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ dịghị onye dịka gị, ọ dịkwaghị Chineke ọzọ dị ma ọ bụghị gị, dịka anyị nụrụ ya na ntị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.20",
            "verseOrgIds": [
              "1CH.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee ndị dịka ndị gị, bụ Izrel, bụ otu mba nʼelu ụwa ndị Chineke ha gara ịgbapụtara onwe ya ka ọ bụrụ otu ndị, na iji mere onwe gị aha, rụọkwa ọrụ ịtụnanya dị egwu dịkwa ukwuu nʼihi ha, site nʼịchụpụ mba dị iche iche na chi niile ha site nʼihu ndị gị, bụ ndị ị gbapụtara site nʼIjipt?",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.21",
            "verseOrgIds": [
              "1CH.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mere ka ndị gị Izrel bụrụ ndị nke gị ruo mgbe ebighị ebi. Gị onwe gị kwa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.22",
            "verseOrgIds": [
              "1CH.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.22",
                "verseOrgIds": [
                  "1CH.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", abụrụla Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.22",
            "verseOrgIds": [
              "1CH.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.23",
                "verseOrgIds": [
                  "1CH.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", mee ka nkwa a nke i kwere banyere ohu gị na ụlọ ya bụrụ nke ga-eguzosie ike ruo mgbe ebighị ebi. Mezukwaa ihe niile dịka nkwa gị si dị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.23",
            "verseOrgIds": [
              "1CH.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka o nwee ike guzosie ike. Ka aha gị bụrụ ihe dị ukwuu ruo mgbe ebighị ebi. Mgbe ahụ ndị mmadụ ga-asị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "'Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.24",
                "verseOrgIds": [
                  "1CH.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, Chineke nke na-achị Izrel, bụ Chineke Izrel.' A ga-emekwa ka ụlọ ohu gị Devid guzosie ike nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.24",
            "verseOrgIds": [
              "1CH.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gị onwe gị, Chineke m, e kpugheerela ohu gị na ị ga-ewuru ya ụlọ. Ya mere, ohu gị ji nwee obi ike ikpere gị ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.25",
            "verseOrgIds": [
              "1CH.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.26",
                "verseOrgIds": [
                  "1CH.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke. I kweekwala ohu gị nkwa ihe ọma ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
            "verseOrgIds": [
              "1CH.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ọ masịrị gị ịgọzi ụlọ ohu gị, ime ka ọ dịrị na-aga nʼihu gị ruo mgbe ebighị ebi, nʼihi na gị",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.27",
            "verseOrgIds": [
              "1CH.17.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1CH.17.27",
                "verseOrgIds": [
                  "1CH.17.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", agọziela ya. Ọ ga-abụkwa ihe a gọziri agọzi ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.27",
            "verseOrgIds": [
              "1CH.17.27"
            ]
          }
        }
      ]
    }
