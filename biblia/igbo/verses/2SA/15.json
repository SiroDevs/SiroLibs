  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "2SA 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzube ọjọọ Absalọm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị, Absalọm zụtaara onwe ya ụgbọ agha na ịnyịnya na-adọkpụ ya. O nwetakwaara onwe ya iri ndị ikom ise ndị na-agba ọsọ nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.1",
            "verseOrgIds": [
              "2SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ, ọ na-ebili gaa guzo nʼakụkụ ọnụ ụzọ e si abata Jerusalem. Ọ bụrụ na ọ hụ onye ọbụla nwere okwu ọ chọrọ ka eze mara ihe banyere ya, Absalọm na-akpọ onye ahụ jụọ ya sị, \"Olee obodo i si bịa?\" Onye ahụ na-aza sị, \"Ohu gị si nʼotu nʼime ebo dị nʼIzrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.2",
            "verseOrgIds": [
              "2SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm na-agwa onye ahụ sị, \"Ahụrụ m na okwu gị niile bụ eziokwu. Ma ọ na-ewute m na eze enweghị onye na-enyere ya aka ịnụ okwu ndị a niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.3",
            "verseOrgIds": [
              "2SA.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm na-ekwukwa sị, \"Asị na m bụ onye ikpe nʼala Izrel, onye ọbụla nwere okwu na ụka gaara abịakwute m ka m mee ka ikpe ziri ezi rute ya aka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.4",
            "verseOrgIds": [
              "2SA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye ọbụla bịara ịkpọ isiala nye ya nʼọnọdụ nsọpụrụ, ọ na-eseti aka ya, jide onye ahụ sutu ya ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.5",
            "verseOrgIds": [
              "2SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka Absalọm sị na-akpaso ndị Izrel agwa, bụ ndị ahụ niile na-abịakwute eze na-arịọ maka ikpe ziri ezi. O si otu a zuru obi ndị Izrel niile nʼohi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.6",
            "verseOrgIds": [
              "2SA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe afọ anọ gasịrị, Absalọm bịakwutere eze rịọọ ya sị, \"Biko kwere ka m jee Hebrọn mezuoro",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.7",
            "verseOrgIds": [
              "2SA.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.15.7",
                "verseOrgIds": [
                  "2SA.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nkwa m kwere ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.7",
            "verseOrgIds": [
              "2SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ohu gị bi na Geshua nʼime Aram, ekweere m nkwa a, 'Ọ bụrụ na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.8",
            "verseOrgIds": [
              "2SA.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.15.8",
                "verseOrgIds": [
                  "2SA.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eme ka m lọghachi ọzọ na Jerusalem, aga m efe ya ofufe na Hebrọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.8",
            "verseOrgIds": [
              "2SA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze sịrị ya, \"Gaa nʼudo.\" Ya mere, ọ pụrụ gaa Hebrọn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.9",
            "verseOrgIds": [
              "2SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Absalọm zigara ndị ozi na nzuzo, ka ha gaa nʼebo niile nke ala Izrel. Nke a bụ ihe o ziri ha, \"Mgbe unu nụrụ ụda opi ike, tienụ mkpu sị, 'Absalọm abụrụla eze na Hebrọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.10",
            "verseOrgIds": [
              "2SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narị mmadụ abụọ si Jerusalem soro Absalọm gaa dịka ndị ọ kpọrọ oku oriri ma ha amaghị ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.11",
            "verseOrgIds": [
              "2SA.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Absalọm nọkwa na-achụ aja ahụ, o ziri ozi ka a kpọọ Ahitofel",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.12",
            "verseOrgIds": [
              "2SA.15.12"
            ]
          }
        },
        {
          "text": "onye Gailo, otu nʼime ndị na-adụ Devid ọdụ, ka o si Gailo bịa nke bụ obodo ya. Nke a mere ka nkwekọrịta nzuzo ọjọọ ahụ na-esi ike karịa, ndị dịnyere Absalọm na-amụbanyekwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.12",
            "verseOrgIds": [
              "2SA.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgbapụ Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị anya, onyeozi bịaruru Jerusalem gwa Devid na ndị Izrel niile kwagidere Absalọm.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.13",
            "verseOrgIds": [
              "2SA.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid gwara ndị ọrụ ya niile ndị ya na ha nọ na Jerusalem, sị, \"Bilienụ! Anyị aghaghị ịgbapụ, ma ọ bụghị otu a, ọ dịghị onye nʼime anyị ga-agbanarị Absalọm. Anyị ga-ahapụ ugbu a, ma ọ bụghị ya, ọ ga-eme ngwa gafee anyị wetara anyị mbibi, werekwa mma agha gbuchapụ ndị niile nọ nʼobodo a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.14",
            "verseOrgIds": [
              "2SA.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-ejere ya ozi zara sị ya, \"Anyị dịnyere gị! Anyị jikekwara ime ihe ọbụla onyenwe anyị eze kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.15",
            "verseOrgIds": [
              "2SA.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze na ndị ụlọ ya niile si na Jerusalem pụọ. Ọ dịghị onye ọ hapụrụ karịakwa ndị iko ya nwanyị iri nʼihi ilekọta obieze ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.16",
            "verseOrgIds": [
              "2SA.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze biliri pụọ, ya na ndị niile so ya, ha kwụsịrị nʼoke ala nke obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.17",
            "verseOrgIds": [
              "2SA.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile na-ejere ya ozi, gafere nʼakụkụ ya, ha na ndị Keret na Pelet, na narị ndị ikom isii ndị Git, bụ ndị so ya site na Gat, gafekwara nọrọ nʼihu eze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.18",
            "verseOrgIds": [
              "2SA.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid tụgharịrị kpọọ Itai, onye Git, ọchịagha narị ndị agha isii ahụ sị ya, \"Gịnị mere i ji eso m? Laghachi azụ soro eze Absalọm, nʼihi na ị bụ ọbịa nʼIzrel, onye gbatara ọsọ ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.19",
            "verseOrgIds": [
              "2SA.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịbeghị anya kemgbe ị bịara. M ga-esi aṅaa kwere ka i soro m na-awagharị, ebe ọ bụ na m amaghị ebe m na-aga. Chịrị ndị agha gị laghachi. Ka obiọma na ikwesi ntụkwasị obi dịnyere unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.20",
            "verseOrgIds": [
              "2SA.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Itai zara eze sị, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.21",
            "verseOrgIds": [
              "2SA.15.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.15.21",
                "verseOrgIds": [
                  "2SA.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, onyenwe m na-adịkwa ndụ, ebe ọbụla onyenwe m bụ eze ga-anọ, ma ọ pụtara ndụ maọbụ ọnwụ, nʼebe ahụ ka odibo gị ga-anọkwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.21",
            "verseOrgIds": [
              "2SA.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid sịrị Itai, \"Gaa nʼihu, gabiga.\" Ya mere Itai, onye Git gabigara ya na ndị ikom ya niile, na ezinaụlọ niile ndị so ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.22",
            "verseOrgIds": [
              "2SA.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo niile tiri mkpu akwa mgbe ndị ahụ niile na-agabiga. Eze gafere ọdọ mmiri Kidrọn, ya na ndị mmadụ niile chere ihu nʼụzọ ọzara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.23",
            "verseOrgIds": [
              "2SA.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadọk bịakwara, ya na ndị Livayị niile, ndị bu igbe ọgbụgba ndụ Chineke. Ha dọbara igbe ọgbụgba ndụ Chineke nʼala. Abịata chụgidere aja tutu ruo mgbe mmadụ niile sitere nʼobodo ahụ gabigasịrị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.24",
            "verseOrgIds": [
              "2SA.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze sịrị Zadọk, \"Bughachi igbe Chineke a nʼime obodo. Ọ bụrụ na m ahụta amara nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.25",
            "verseOrgIds": [
              "2SA.15.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.15.25",
                "verseOrgIds": [
                  "2SA.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ ga-akpọghachi m mee ka m hụ ya, na ebe obibi ya anya ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.25",
            "verseOrgIds": [
              "2SA.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ọ sị, 'Ihe banyere gị adịghị atọkwa m ụtọ,' lee m, ya mee m otu o si dị ya mma nʼanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.26",
            "verseOrgIds": [
              "2SA.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze gwara Zadọk bụ onye nchụaja sị, \"Ọkwa ị bụ onye ọhụ ụzọ? Laghachi nʼobodo nʼudo, kpọrọ Ahimaaz nwa gị nwoke, na Jonatan nwa Abịata. Gị na Abịata kpọrọ ụmụ unu ndị ikom abụọ ndị a laghachi nʼobodo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.27",
            "verseOrgIds": [
              "2SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m akwụsị chere nʼebe e si akwọfe osimiri Jọdan, ruo mgbe ozi ga-esi nʼebe ị nọ bịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.28",
            "verseOrgIds": [
              "2SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Zadọk na Abịata bughachiri igbe Chineke na Jerusalem. Ha nọdụkwara nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.29",
            "verseOrgIds": [
              "2SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid na ndị so ya chere ihu irigo Ugwu Oliv. Mgbe ọ na-aga, Devid nọ na-akwa akwa. O yikwaghị ihe ọbụla nʼụkwụ ya, ma o ji ihe kpuchie isi ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.30",
            "verseOrgIds": [
              "2SA.15.30"
            ]
          }
        },
        {
          "text": "Ndị niile so ya kpuchikwara isi ha na-akwakwa akwa ka ha na-arịgo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.30",
            "verseOrgIds": [
              "2SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara Devid na Ahitofel onye na-adụ ya ọdụ dịnyere Absalọm, Devid kpere ekpere sị, \"O",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.31",
            "verseOrgIds": [
              "2SA.15.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.15.31",
                "verseOrgIds": [
                  "2SA.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", biko, tụgharịa ndụmọdụ Ahitofel ka ọ bụrụ ndụmọdụ nzuzu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.31",
            "verseOrgIds": [
              "2SA.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid bịaruru nʼelu Ugwu Oliv, ebe ndị mmadụ na-anọ na-efe Chineke ofufe, Hushaị, onye Akai",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.32",
            "verseOrgIds": [
              "2SA.15.32"
            ]
          }
        },
        {
          "text": "nọ nʼebe ahụ na-eche izute ya. Uwe ya dọwakwara adọwa, aja dịkwa ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.32",
            "verseOrgIds": [
              "2SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid sịrị ya, \"Ọ bụrụ na i soro m, ị ga-abụ ibu arọ nye m.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.33",
            "verseOrgIds": [
              "2SA.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị laghachi nʼobodo, sị Absalọm, 'Aga m abụ ohu gị, eze. Abụ m ohu nna gị nʼoge gara aga, ugbu a aga m abụ ohu gị.' Nʼụzọ dị otu a ị ga-enyere m aka mebie ndụmọdụ Ahitofel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.34",
            "verseOrgIds": [
              "2SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na Zadọk na Abịata ndị nchụaja agaghị eso gị nọdụ nʼebe ahụ? Gwa ha ihe ọbụla ị ga-anụta nʼụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.35",
            "verseOrgIds": [
              "2SA.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ha ndị ikom, Ahimaaz nwa Zadọk na Jonatan nwa Abịata so ha nọdụ nʼebe ahụ. Zitere m ha ka ha gwa m ihe ọbụla ị nụtara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.36",
            "verseOrgIds": [
              "2SA.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere Hushaị, enyi Devid, bịarutere Jerusalem mgbe Absalọm na-abata obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.37",
            "verseOrgIds": [
              "2SA.15.37"
            ]
          }
        }
      ]
    }
  ],
