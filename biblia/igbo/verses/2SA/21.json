  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2SA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịbọ ọbọ ndị Gibiọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụnwụ dara afọ atọ nʼoge Devid na-achị, afọ kwa afọ. Devid chọrọ ihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.1",
                "verseOrgIds": [
                  "2SA.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.1",
                "verseOrgIds": [
                  "2SA.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Ọ bụ maka Sọl na ọbara ụlọ ya kwafuru, nʼihi na o gburu ndị Gibiọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze kpọrọ ndị Gibiọn, gwa ha okwu. (Ndị Gibiọn abụghị ndị Izrel, kama ha bụ ndị fọdụrụ nʼime ndị Amọrait,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "text": "ndị bi nʼala Kenan mgbe ụmụ Izrel batara. Mgbe ahụ ha batara, ndị Izrel ṅụrụ iyi nye ndị Gibiọn",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "text": "na ha agaghị egbu ha, ma Sọl sitere nʼịnụ ọkụ nke obi nʼihi Izrel na Juda chọọ ikpochapụ ha.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jụrụ ndị Gibiọn ajụjụ sị, \"Gịnị ka m ga-emere unu? Gịnị ka m ga-eji kpuchie mmehie a e mere megide unu, ime ka unu gọzie ihe nketa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.3",
                "verseOrgIds": [
                  "2SA.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Gibiọn zara ya sị, \"Nsogbu anyị na Sọl na ndị ụlọ ya abụghị ihe a ga-eji ọlaọcha maọbụ ọlaedo mezie. Anyị achọkwaghị ka onye ọbụla nʼIzrel nwụọ nʼihi anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:4"
      },
      "items": [
        {
          "text": "Devid sịrị ha, \"Gịnị ka unu chọrọ ka m meere unu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara eze sị, \"Kwere ka anyị wezuga nwoke ahụ wetaara anyị mbibi na ịla nʼiyi, onye ahụ mere ka anyị ghara inwe ebe obibi ọbụla nʼala Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.5",
            "verseOrgIds": [
              "2SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka akpọnye anyị ndị ikom asaa site nʼụmụ ya, ka anyị kwụgbuo ha nye",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.6",
                "verseOrgIds": [
                  "2SA.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na Gibea Sọl, onye",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.6",
                "verseOrgIds": [
                  "2SA.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:6"
      },
      "items": [
        {
          "text": "Eze zara sị, \"Aga m akpọnye unu ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze nwere ọmịiko nʼahụ Mefiboshet nwa Jonatan, nwa Sọl, nʼihi ịgba ndụ dị nʼetiti ya na Jonatan nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.7",
                "verseOrgIds": [
                  "2SA.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze kpọọrọ Amoni na Mefiboshet, ụmụ ndị ikom abụọ nke Rizpa, nwa nwanyị Aịa, bụ ndị ọ mụtaara Sọl. Nakwa ụmụ ndị ikom ise nke Merab nwa Sọl mụtara mgbe ọ bụ nwunye Adriel, nwa Bazilai onye Mehola.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyefere ha niile nʼaka ndị Gibiọn; ndị Gibiọn kwụbakwara ha nʼugwu nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.9",
                "verseOrgIds": [
                  "2SA.21.9"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha asaa nwụrụ nʼotu ụbọchị na mmalite owuwe ihe ubi nke ọka balị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Rizpa, nwa nwanyị Aịa were akwa mkpe gbasara onwe ya nʼelu nkume. O kweghịkwa ka anụ ufe bekwasị ha nʼehihie, maọbụ anụ ọhịa nʼabalị. Ọ nọgidere nʼebe ahụ site nʼoge mmalite owuwe ihe ubi tutu ruo mgbe mmiri bidoro izokwasị anụ ahụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara Devid ihe Rizpa, nwa nwanyị Aịa, iko nwanyị Sọl mere,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ gara chịkọtaa ọkpụkpụ Sọl na nke nwa ya Jonatan site nʼaka ndị nwe obodo Jebesh Gilead. Ha gara na nzuzo zuru ozu Sọl na Jonatan site nʼama dị na Bet-Shan, ebe ndị Filistia kwụbara ha, oge ha gburu Sọl na Gilboa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid sitere nʼebe ahụ chịkọtaa ọkpụkpụ Sọl na nke nwa ya nwoke Jonatan, chịkọtaakwa ọkpụkpụ ndị ahụ akwụgburu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha liri ọkpụkpụ Sọl na nke nwa ya nwoke Jonatan nʼobodo Zela nʼala Benjamin, nʼime ili Kish nna Sọl, meekwa ihe ndị ọzọ niile eze nyere nʼiwu. Mgbe nke a gasịrị, Chineke zara ekpere nʼihi ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agha megide ndị Filistia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ndị Filistia busokwara Izrel agha ọzọ. Devid na ndị agha ya pụkwara ịlụso ha ọgụ. Nʼoge ha na-alụ ọgụ a, ike gwụrụ Devid nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ishibi-Benob, otu onye agbụrụ Rafa, onye ịdị arọ nke bronz dị nʼọnụ ùbe ya ruru kilogram atọ na ọkara, onye jikwa mma agha ọhụrụ, bịaruru Devid nso chọọ igbu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Abishai nwa Zeruaya bịara nyere Devid aka, tigbuo onye Filistia ahụ. Site nʼoge ahụ, ndị ikom Devid ṅụrụ iyi sị ya, \"Ị gaghị esokwa anyị gaa ibu agha ọzọ! Ka a ghara imenyụ oriọna Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe oge gaturu, ha na ndị Filistia lụrụ agha ọzọ na Gob. Nʼoge a, Sibekai,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        },
        {
          "text": "onye Husha, gburu Saf, otu nʼime ndị agbụrụ Rafa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagha ọzọ ha na ndị Filistia lụrụ na Gob, Elhanan",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "text": "nwa Jaịa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "text": "onye Betlehem gburu nwanne Golaịat onye Gat,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "text": "onye ùbe ya nwere osisi dị ogologo dịka nke onye na-ekwe akwa ji ekwe akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
