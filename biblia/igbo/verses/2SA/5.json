          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Filistia lọghachiri ọzọ, gbasaa onwe ha na Ndagwurugwu Refaim.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
              "2SA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Devid jụrụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.23",
                "verseOrgIds": [
                  "2SA.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ase, ọ zara sị, \"Esitekwala nʼihu ha gaa, kama gaa gburugburu ruo nʼazụ ha, buso ha agha na ncherita ihu osisi balsam ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.23",
            "verseOrgIds": [
              "2SA.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ị nụrụ ụda ikiri ụkwụ nʼelu osisi balsam ndị ahụ, mee ngwa malite ọgụ, nʼihi na nke a pụtara na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.24",
                "verseOrgIds": [
                  "2SA.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "eburula unu ụzọ pụọ, itigbu ndị agha Filistia.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid mere dịka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.25",
            "verseOrgIds": [
              "2SA.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.25",
                "verseOrgIds": [
                  "2SA.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya nʼiwu. O tigburu ndị Filistia, site na Geba ruo Gaza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.25",
            "verseOrgIds": [
