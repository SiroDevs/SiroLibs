  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2SA 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid abụrụ eze ndị Izrel niile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ebo Izrel niile bịakwutere Devid na Hebrọn, sị ya, \"Lee, ọkpụkpụ gị na anụ ahụ gị ka anyị bụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.1",
            "verseOrgIds": [
              "2SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge gara aga, mgbe Sọl bụ eze na-achị anyị, ọ bụ gị duuru ndị agha Izrel nʼọgụ niile, ma ọpụpụ ma mbata.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.2",
                "verseOrgIds": [
                  "2SA.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị gị, 'Ị ga-azụ ndị m, bụ Izrel, ị ga-abụkwa onye ga-achị ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.2",
            "verseOrgIds": [
              "2SA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị okenye Izrel niile bịakwutere Devid na Hebrọn, ha na eze Devid gbara ndụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.3",
                "verseOrgIds": [
                  "2SA.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na Hebrọn. Ha tere Devid mmanụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        },
        {
          "text": "ịbụ eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.3",
            "verseOrgIds": [
              "2SA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid gbara iri afọ atọ mgbe ọ malitere ịbụ eze. Ọ chịkwara iri afọ anọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịrị ndị Juda niile na Hebrọn afọ asaa na ọnwa isii. Chịakwa ndị Izrel na Juda niile mgbe ọ nọ na Hebrọn na mgbe ọ nọ na Jerusalem iri afọ atọ na atọ,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid adọta Jerusalem nʼagha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze na ndị ikom ya zọọrọ ije garuo Jerusalem ibuso ndị Jebus bi nʼebe ahụ agha. Ndị Jebus gwara Devid sị, \"Ị gaghị abata nʼebe a, ọ bụladị ndị ìsì na ndị ngwụrọ nwere ike ịchụghachi gị azụ.\" Ha na-eche sị, \"Devid agaghị abata nʼebe a,\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.6",
            "verseOrgIds": [
              "2SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼagbanyeghị okwu ndị a, Devid dọtara ebe ahụ e wusiri ike nke Zayọn nʼagha, ya bụ obodo Devid.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.7",
            "verseOrgIds": [
              "2SA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, Devid kwuru sị, \"Onye ọbụla ga-emeri ndị Jebus ga-esite nʼọnụ warawara ebe mmiri si abanye nʼobodo a banyekwuru ndị ngwụrọ na ndị ìsì a bụ ndị iro Devid.\" Ọ bụ nke a mere ha ji ekwu okwu sị, \"Ndị ìsì na ndị ngwụrọ agaghị abata nʼụlọeze ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.8",
            "verseOrgIds": [
              "2SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid biiri nʼebe ahụ e wusiri ike, kpọọ ya obodo Devid. O wuru akụkụ ebe dị gburugburu ya, site na Milo baa ruo nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.9",
            "verseOrgIds": [
              "2SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ gara nʼihu na-adị ukwuu karịa, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.10",
                "verseOrgIds": [
                  "2SA.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke, Onye pụrụ ime ihe niile nọnyeere ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.10",
            "verseOrgIds": [
              "2SA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiram bụ Eze Taịa, zitere Devid osisi sida e ji ewu ụlọ, na ndị ǹka osisi, ndị na-ewu ụlọ. Ha wuuru Devid ụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.11",
            "verseOrgIds": [
              "2SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid ghọtara na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.12",
                "verseOrgIds": [
                  "2SA.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": "emeela ka o guzosie ike dịka eze ndị Izrel. Bulikwa alaeze ya elu nʼihi ndị ya Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.12",
            "verseOrgIds": [
              "2SA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid sitere na Hebrọn kwabata na Jerusalem; ọ lụrụ ndị inyom ọzọ, nwetakwara onwe ya ọtụtụ ndị iko nwanyị. Ọ mụtakwara ọtụtụ ụmụ nwoke na ụmụ nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.13",
            "verseOrgIds": [
              "2SA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ aha ụmụ a mụụrụ ya na Jerusalem: Shamua, Shobab, Netan, Solomọn,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
            "verseOrgIds": [
              "2SA.5.14"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.14",
            "verseOrgIds": [
              "2SA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibha, Elishua, Nefeg, Jafia,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.15",
            "verseOrgIds": [
              "2SA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama, Eliada na Elifelet.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.16",
            "verseOrgIds": [
              "2SA.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid emerie ndị Filistia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Filistia nụrụ na eteela Devid mmanụ ị bụ eze ndị Izrel, ha pụrụ ka igwe ha niile ha ịchọ ya. Ma Devid nụrụ maka ya, gbadaa nʼime ebe ahụ e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.17",
            "verseOrgIds": [
              "2SA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Filistia bịara, gbasaa onwe ha na Ndagwurugwu Refaim niile.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.18",
            "verseOrgIds": [
              "2SA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid jụrụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.19",
                "verseOrgIds": [
                  "2SA.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ase sị, \"Ọ bụ m gaa buso ndị Filistia agha? Ị ga-enyefe ha nʼaka m?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 5:19"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.19",
                "verseOrgIds": [
                  "2SA.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "zara sị ya, \"Gaa, nʼihi na aghaghị m inyefe ndị Filistia nʼaka gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.19",
            "verseOrgIds": [
              "2SA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Devid gara Baal-Perazim, meriekwa ha nʼebe ahụ. O kwuru sị, \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.5.20",
                "verseOrgIds": [
                  "2SA.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "enupula megide ndị iro m nʼihu m, dịka idee mmiri si enupu.\" Nʼihi ya, a kpọrọ ebe ahụ Baal-Perazim.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.20",
            "verseOrgIds": [
              "2SA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Filistia hapụrụ arụsị niile ha nʼebe ahụ. Devid na ndị ikom ya chịkọtara ha chịpụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.21",
            "verseOrgIds": [
              "2SA.5.21"
            ]
          }
        }
      ]
    },
    {
