          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.18",
                "verseOrgIds": [
                  "ZEC.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile ruru m ntị na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.18",
            "verseOrgIds": [
              "ZEC.8.18"
            ]
          }
        }
