    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.19",
                "verseOrgIds": [
                  "ZEC.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile na-ekwu: \"Ibu ọnụ unu na-ebu nʼọnwa nke anọ, ọnwa nke ise, ọnwa nke asaa na nʼọnwa nke iri ga-aghọrọ unu oge ịṅụrị ọṅụ na oge obi ụtọ. Ha ga-abụrụ Juda mmemme obi ụtọ. Nʼihi ya, hụnụ eziokwu na udo nʼanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.19",
            "verseOrgIds": [
              "ZEC.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
              "ZEC.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.20",
                "verseOrgIds": [
                  "ZEC.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile na-ekwukwa: \"Ndị dị iche iche na ndị bi nʼọtụtụ obodo dị iche iche ka ga-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.20",
            "verseOrgIds": [
              "ZEC.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị bi nʼotu obodo ga-ejekwa nʼobodo ọzọ, sị, 'Ka anyị jee na-atụfughị oge gaa rịọọ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.21",
                "verseOrgIds": [
                  "ZEC.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": "arịrịọ, ka anyị chọọnụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.21",
                "verseOrgIds": [
                  "ZEC.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile. Mụ onwe m na-ejekwa.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.21",
            "verseOrgIds": [
              "ZEC.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ZEC 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ ndị mmadụ na ọtụtụ mba dị ike ga-abịa Jerusalem ịchọ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
            "verseOrgIds": [
              "ZEC.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.8.22",
                "verseOrgIds": [
                  "ZEC.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, na ịrịọ ya arịrịọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.22",
            "verseOrgIds": [
              "ZEC.8.22"
            ]
          }
        }
      ]
    },
