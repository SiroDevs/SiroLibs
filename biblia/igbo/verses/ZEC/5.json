  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ZEC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwụkwọ a fụkọrọ afụkọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, eleliri m anya elu, ma hụ akwụkwọ a fụkọrọ afụkọ nke na-efegharị efegharị.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.1",
            "verseOrgIds": [
              "ZEC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Gịnị ka ị na-ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 5:2"
      },
      "items": [
        {
          "text": "Azara m, \"Ahụrụ m akwụkwọ a fụkọrọ afụkọ nke na-efegharị efegharị. Ogologo ya dị mita iri, obosara ya dịkwa mita ise.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.2",
            "verseOrgIds": [
              "ZEC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara m, \"Nke a bụ ọbụbụ ọnụ nke na-apụ na-ejezu nʼala ahụ niile. Nʼihi na dịka e si detuo ya, nʼotu akụkụ ya, a ga-esi nʼala a chụpụ ndị na-ezu ohi. Dịka e si deekwa ya nʼakụkụ nke ọzọ ya, onye ọ bụla na-aṅụ iyi ụgha ka a ga-esitekwa nʼala ahụ chụpụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.3",
            "verseOrgIds": [
              "ZEC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezipụla m ya, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.5.4",
                "verseOrgIds": [
                  "ZEC.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwubiri, 'Ọ ga-abanye nʼụlọ onye ọ bụla na-ezu ohi, na nʼụlọ ndị ji aha m na-aṅụ iyi ụgha. Ọ ga-anọgide nʼụlọ ahụ mebie ya kpamkpam. Ọ ga-emebi osisi na nkume niile e ji wuo ụlọ ahụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.4",
            "verseOrgIds": [
              "ZEC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwanyị nọ nʼime nkata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi ahụ na-agwa m okwu bịakwutere m sị, \"Lelie anya gị elu hụrụ ihe na-aga ịpụta ìhè.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.5",
            "verseOrgIds": [
              "ZEC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asịrị m, \"Gịnị ka ọ bụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 5:6"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"Ọ bụ nkata.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        },
        {
          "text": "O kwukwara, \"Nke a bụ mmehie nke ndị niile bi nʼala a.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.6",
            "verseOrgIds": [
              "ZEC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, e kpughepụrụ okwuchi nkata ahụ, ma lee, ahụrụ m otu nwanyị nọdụrụ ọdụ nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.7",
            "verseOrgIds": [
              "ZEC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Nke a bụ ajọ omume.\" O nughachiri ya azụ nʼime nkata ahụ werekwa okwuchi nkata ahụ kpuchie ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.8",
            "verseOrgIds": [
              "ZEC.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eleliri m anya hụ ụmụ nwanyị abụọ ọzọ, ndị ikuku na-efe nku ha. Ha nwere nku dịka nku ụgbala. Ha buliri nkata ahụ elu nʼetiti eluigwe na ala.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajụrụ m mmụọ ozi ahụ na-agwa m okwu, \"Ebee ka ha bu nkata ahụ na-aga?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara m, \"Ha bu ya na-aga Babilọn",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        },
        {
          "text": "ebe ha ga-ewuru ya ụlọ. Mgbe ha wuchara ụlọ ahụ, ha ga-adọba nkata ahụ nʼelu ihe ndọkwasị.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
            "verseOrgIds": [
              "ZEC.5.11"
            ]
          }
        }
      ]
    }
  ],
