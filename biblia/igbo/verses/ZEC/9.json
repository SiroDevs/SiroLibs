{
  "id": "ZEC.9",
  "number": "9",
  "bookId": "ZEC",
  "reference": "Zekaraya 9",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ZEC 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe ọmụma megide ndị iro Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu Amụma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "Nke a bụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "megide ala Hadrak,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "na obodo Damaskọs ka ọ ga-ezukwa ike,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "nʼihi nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ ka anya mmadụ niile",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "na ebo niile nke Izrel dị.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ahụkwa ka ọ dị Hamat, nke dị ya nso;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:2"
      },
      "items": [
        {
          "text": "tinyekwara Taịa na Saịdọn, ọ bụ ezie na ha bụ ndị maara ihe nke ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taịa ewuolara onwe ya ebe e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "tụkọba ọlaọcha dịka aja,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "na ọlaedo dịka uzuzu nke okporoụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Onyenwe anyị ga-anapụ ya ihe niile o nwere",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "ọ ga-atụnye ike ya nʼoke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "ọ ga-ejikwa ọkụ repịa ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashkelọn ga-ejupụta nʼụjọ mgbe ọ ga-ahụ ihe ndị a ka ha na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gaza kwa, ga-aṅagharị onwe ya nʼime oke ihe mgbu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Ọ bụladị Ekrọn ga-ama jijiji nʼụjọ mgbe ha hụrụ na olileanya ha agwụla.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "A ga-anapụ Gaza eze ya ma gbukwaa ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Ọ dịghị onye ọbụla ga-ebikwa nʼAshkelọn.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ amụtara nʼịkwa iko ga-ebichi obodo Ashdọd,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:6"
      },
      "items": [
        {
          "text": "aga m emekwa ka mpako ndị Filistia ndị a kwụsị.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m wezuga ọbara niile site nʼọnụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "wezugakwa ihe rụrụ arụ niile site nʼetiti eze ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "Ndị niile fọdụrụ ga-abụ ndị nke Chineke anyị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "ha ga-adị ka otu agbụrụ na Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "Ekrọn ga-adịkwa ka ndị Jebus.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m echebe ụlọ m dịka onye nche,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "ka ndị iro ghara ịbata na ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "Ndị mkpagbu agaghị emerikwa ndị m ọzọ nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "nʼihi na anọ m na nche ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọbịbịa nke eze Zayọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṅụrịa ọṅụ nke ukwuu, gị Ada Zayọn!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Tie mkpu ọṅụ, gị Ada Jerusalem!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "Nʼihi na lee, eze gị na-abịakwute gị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "onye ezi omume na onye nwere mmeri,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "onye ewedara nʼala, nke na-anọkwasị nʼelu ịnyịnya ibu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "ọ bụladị nʼelu nwa ịnyịnya ibu, nwa ịnyịnya na-ebu ibu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewezuga ụgbọ ịnyịnya niile nke Ifrem,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "na ịnyịnya agha niile nke Jerusalem;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "a ga-agbajikwa ụta agha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "Ọ ga-ewetara mba niile udo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "ọchịchị ya ga-esite nʼotu oke osimiri ruo nʼosimiri nke ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "sitekwa nʼOsimiri Yufretis ruo na nsọtụ niile nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị onwe gị kwa, aga m eme ka ndị a tụrụ mkpọrọ nʼolulu nke mmiri na-adịghị nwere onwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.11",
            "verseOrgIds": [
              "ZEC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:11"
      },
      "items": [
        {
          "text": "nʼihi ọbara nke ọgbụgba ndụ ahụ mụ na unu gbara.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.11",
            "verseOrgIds": [
              "ZEC.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lọghachinụ nʼebe unu niile e wusiri ike, unu bụ ndị mkpọrọ nwere olileanya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.12",
            "verseOrgIds": [
              "ZEC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:12"
      },
      "items": [
        {
          "text": "Ọ bụladị taa, ana m ekwupụta ya na m ga-eme ka unu lọta, gọziekwa unu okpukpu abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.12",
            "verseOrgIds": [
              "ZEC.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m agbagọ Juda dịka m si ekwe ụta m,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "tinye Ifrem dịka àkụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "Aga m akwali ụmụ gị ndị ikom, gị Zayọn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "ka ha megide ụmụ ndị ikom ndị Griis.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:13"
      },
      "items": [
        {
          "text": "Aga m eme gị ka ị dịrị ka mma agha dị nʼaka dike nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.13",
            "verseOrgIds": [
              "ZEC.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "ga-egosi onwe ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.14",
                "verseOrgIds": [
                  "ZEC.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-egosi onwe ya nʼebe dị elu karịa ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:14"
      },
      "items": [
        {
          "text": "àkụ ya ga-efekwa dịka amụma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:14"
      },
      "items": [
        {
          "text": "Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.14",
                "verseOrgIds": [
                  "ZEC.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-afụ opi ike,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:14"
      },
      "items": [
        {
          "text": "ọ ga-azọkwa ije nʼoke ifufe nke si na ndịda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.14",
            "verseOrgIds": [
              "ZEC.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.15",
                "verseOrgIds": [
                  "ZEC.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile ga-echebe ha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "Ha ga-ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "zọdakwa nkume ịtụ iche nʼebe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "Ha ga-aṅụ ihe ọṅụṅụ mekwa mkpọtụ site na mmanya;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "ha ga-ejupụta dịka efere,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:15"
      },
      "items": [
        {
          "text": "dịka efere eji efesa ihe nʼakụkụ niile ebe a na-achụ aja na-ejupụta.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.15",
            "verseOrgIds": [
              "ZEC.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ahụ bịara,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.16",
                "verseOrgIds": [
                  "ZEC.9.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ha ga-azọpụta ndị ya,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "dịka onye ọzụzụ atụrụ si azọpụta igwe ewu na atụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "Ha ga-acha, na-egbuke nʼala ya, dịka nkume dị oke ọnụahịa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:16"
      },
      "items": [
        {
          "text": "e tinyere nʼokpueze si na-egbuke.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.16",
            "verseOrgIds": [
              "ZEC.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, lee ka ịdị mma nke ala ahụ si dị ukwuu! Leekwa ka ịma mma ya si dị ukwuu!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.17",
            "verseOrgIds": [
              "ZEC.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:17"
      },
      "items": [
        {
          "text": "Mkpụrụ ubi ga-eme ka ụmụ okorobịa tozuo oke nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.17",
            "verseOrgIds": [
              "ZEC.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:17"
      },
      "items": [
        {
          "text": "mmanya vaịnị ọhụrụ ga-emekwa ka ụmụ agbọghọ doo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.17",
            "verseOrgIds": [
              "ZEC.9.17"
            ]
          }
        }
      ]
    }
