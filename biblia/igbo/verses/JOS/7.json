  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOS 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmehie Ekan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụmụ Izrel ekwesighị ntụkwasị obi nʼihe gbasara ihe ndị ahụ e debere iche nye",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.1",
                "verseOrgIds": [
                  "JOS.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nʼihi na Ekan nwa Kami, nwa Zimri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        },
        {
          "text": "nwa Zera, onye si nʼebo Juda gara were ụfọdụ nʼime ihe ndị ahụ. Nke a mere ka iwe wee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.1",
                "verseOrgIds": [
                  "JOS.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nke ukwuu megide ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Joshua si Jeriko zipụ ụfọdụ ndị mmadụ ka ha gaa Ai, obodo dị Bet-Aven nso, nʼọwụwa anyanwụ Betel. Ọ gwara ha sị ha, \"Gaanụ nnyopụta akụkụ ala ahụ niile.\" Ya mere, ndị ahụ gara nnyochapụta obodo Ai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.2",
            "verseOrgIds": [
              "JOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha lọghachiri azụ, ha gwara Joshua sị ya, \"Ai bụ obodo nta. Ọ gaghị ewe karịa puku mmadụ abụọ maọbụ atọ imeri obodo ahụ. Ọ bakwaghị uru ka anyị niile gaa tigbuo obodo a, nʼihi na ha dị mmadụ ole na ole.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.3",
            "verseOrgIds": [
              "JOS.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ihe dịka puku ndị agha atọ ka e zigara imeri obodo Ai. Ma ngwangwa, ndị agha obodo Ai meriri ndị agha ụmụ Izrel, chụọ ha ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.4",
            "verseOrgIds": [
              "JOS.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe dịka iri mmadụ atọ na isii nʼetiti ndị agha Izrel ka e gburu nʼagha ahụ. Ndị Ai chụrụ ha ọsọ site nʼụzọ ama obodo ruo nʼebe a na-awa nkume, gbuo ha na mgbada ugwu ahụ. Nʼihi nke a, ndị agha Izrel dara mba, obi lọkwara ha mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.5",
            "verseOrgIds": [
              "JOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua na ndị okenye Izrel sitere nʼobi mwute dọwaa uwe ha, daa nʼala kpuo ihu nʼala nʼihu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.6",
                "verseOrgIds": [
                  "JOS.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼụtụtụ ruo nʼanyasị. Ha wekwara ntụ wụkwasị onwe ha nʼisi igosi obi mwute ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa, Joshua sịrị, \"Ewoo, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.7",
                "verseOrgIds": [
                  "JOS.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "! Nʼihi gịnị ka i ji mee ka ndị a gabiga osimiri Jọdan, inyefe anyị nʼaka ndị Amọrait, ime ka ha tigbuo anyị? Ọ gaara adị anyị mma nke ọma ma ọ bụrụ na anyị nọdụrụ nʼofe ọzọ nke Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko, Onyenwe m, Gịnị ka m ga-ekwu ugbu a ụmụ Izrel sitere nʼihu ndị iro ha gbaa ọsọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.8",
            "verseOrgIds": [
              "JOS.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mgbe ndị Kenan na ndị bi nʼakụkụ ala ahụ ga-anụ maka mmeri e meriri anyị, ha ga-agba anyị gburugburu lụso anyị agha, bipụ aha anyị nʼụwa. Ọ bụkwa gịnị ka ị ga-eme banyere aha ukwu gị dị ebube?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.9",
            "verseOrgIds": [
              "JOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.10",
            "verseOrgIds": [
              "JOS.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.10",
                "verseOrgIds": [
                  "JOS.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Joshua, \"Bilie ọtọ! Gịnị bụ nke a, na ị dara kpuo ihu nʼala?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.10",
            "verseOrgIds": [
              "JOS.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izrel emehiela. Ha emebiela ọgbụgba ndụ m nyere ha nʼiwu idebe, ha ewerela ụfọdụ nʼime ihe ndị ahụ e doro iche nye",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.11",
            "verseOrgIds": [
              "JOS.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.11",
                "verseOrgIds": [
                  "JOS.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ bụghị naanị na ha zuru ohi, ha nọkwa nʼelu ya ghaa ụgha banyere ya. Ha ewerekwala ihe ndị ahụ tinyekọta nʼihe nke aka ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.11",
            "verseOrgIds": [
              "JOS.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼihi nke a mere na ụmụ Izrel enwekwaghị ike iguzo nʼihu ndị iro ha. Ọ bụkwa nke a mere ha ji tụgharịa gbaa ọsọ, nʼihi na ha aghọọla ndị kwesiri ka e bibie. Ya mere, agaghị m anọnyere unu ọzọ, tutu ruo mgbe unu wezugara ma mebie site nʼetiti onwe unu, ihe ọbụla e debere iche maka mbibi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.12",
            "verseOrgIds": [
              "JOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bilie! Doo Izrel nsọ. Gwa ndị m okwu sị ha, 'Onye ọbụla nʼetiti unu ga-ejikere doo onwe ya nsọ maka echi. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.13",
                "verseOrgIds": [
                  "JOS.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel na-ekwu sị, Ihe ndị e doro nsọ dị nʼetiti unu, Izrel. Unu apụghịkwa iguzosi ike nʼihu ndị iro unu, tutu ruo mgbe unu ga-esite nʼetiti onwe unu wezuga ihe ndị ahụ.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụtụtụ echi, unu ga-apụta nʼebo nʼebo. Ebo ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.14",
                "verseOrgIds": [
                  "JOS.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtara ga-apụta nʼikwu nʼikwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "text": "ikwu ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.14",
                "verseOrgIds": [
                  "JOS.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtara ga-apụta bịa nʼezinaụlọ nʼezinaụlọ, ụlọ ọbụla nke",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.14",
                "verseOrgIds": [
                  "JOS.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "họọrọ, ndị ikom ya ga-apụta nʼotu nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye ọbụla e jidere ji ihe ndị ahụ e doro nsọ ka a ga-akpọ ọkụ, ya onwe ya, na ihe niile ọ nwere, nʼihi o mebiela iwu ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.15",
                "verseOrgIds": [
                  "JOS.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", meekwa ihe jọgburu onwe ya na njọ nʼIzrel.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Joshua biliri nʼisi ụtụtụ. O mere ka ebo niile dị nʼIzrel bịaruo nso nʼebo nʼebo, ebo Juda ka a họọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.16",
            "verseOrgIds": [
              "JOS.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, e mere ka ikwu niile dị nʼebo Juda bịaruo nso, ikwu Zera ka ahọpụtara. Mgbe e mere ka ikwu Zera pụta nʼezinaụlọ ha niile nʼotu nʼotu, ezinaụlọ Zimri bụ nke ahọpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.17",
            "verseOrgIds": [
              "JOS.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua mere ka ndị ikom niile dị nʼezinaụlọ Zimri pụta nʼotu nʼotu, ma e jidere Ekan, nwa Kami, nwa Zimri, nwa Zera onye ebo Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.18",
            "verseOrgIds": [
              "JOS.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua sịrị Ekan, \"Nwa m, nye",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.19",
                "verseOrgIds": [
                  "JOS.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel otuto, nyekwa ya nsọpụrụ. Gwa m ihe i mere. Ezonarịkwala m ihe ọjọọ i mere.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ekan zara Joshua sị ya, \"Ọ bụ eziokwu! Emehiela m megide",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
            "verseOrgIds": [
              "JOS.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.20",
                "verseOrgIds": [
                  "JOS.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel. Lee ihe m mere.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
            "verseOrgIds": [
              "JOS.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m hụrụ nʼetiti ihe ndị a kwatara nʼagha, otu uwe mwụda Babilọn",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        },
        {
          "text": "mara mma, na narị Shekel ọlaọcha abụọ, na mkpirisi ọlaedo ịdị arọ ya ruru iri shekel ise. E nwere m anya ukwu nʼebe ihe ndị a dị, chịrị ha. Lee, ezoro m ha nʼime ala nʼụlọ ikwu m, ọlaọcha ahụ dịkwa nʼokpuru ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua zigara ụfọdụ ndị ikom ka ha gaa chọọ ihe ahụ Ekan zoro. Ndị a gara nʼụlọ ikwu ahụ, chọpụta ihe ahụ ezuru nʼohi. Dịka Ekan kwuru, ihe ikpeazụ ha hụrụ bụ ọlaọcha ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.22",
            "verseOrgIds": [
              "JOS.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha chịkọtara ha niile chịtara ha Joshua. Mgbe ha bịaruru ebe Joshua na ndị Izrel niile nọ, ha chịsara ya nʼala nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
            "verseOrgIds": [
              "JOS.7.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.23",
                "verseOrgIds": [
                  "JOS.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
            "verseOrgIds": [
              "JOS.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua na ndị Izrel niile, duuru Ekan, nwa Zera, chịkọrọkwa ọlaọcha ahụ, na uwe mwụda ahụ, na mkpirisi ọlaedo ahụ, na ụmụ ya ndị ikom na ụmụ ya ndị inyom, na ehi na ịnyịnya ibu ya, na igwe ewu na atụrụ ya, na ụlọ ikwu ya, na ihe niile o nwere, gaa na Ndagwurugwu Akọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.24",
            "verseOrgIds": [
              "JOS.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua sịrị, \"Gịnị mere i ji wetara anyị nsogbu ndị a?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.25",
                "verseOrgIds": [
                  "JOS.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eme ka nsogbu dakwasịkwa gị onwe gị taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 7:25"
      },
      "items": [
        {
          "text": "Ndị Izrel niile weere nkume tugbuo ha nʼebe ahụ. Emesịa, a kpọrọ ha ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha tụkọtara ọtụtụ nkume tụkwasị ya nʼelu Ekan. Nkume ndị a dị nʼebe ahụ ruo taa. Ọ bụkwa nʼụzọ dị otu a ka iwe ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.7.26",
                "verseOrgIds": [
                  "JOS.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ji dajụọ. Ya mere, e ji akpọ ebe ahụ Ndagwurugwu Akọ ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        }
      ]
    }
