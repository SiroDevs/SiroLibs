  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOS 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ụmụ Simiọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nke abụọ sitere nʼife nza nweta oke ha bụ ebo Simiọn dịka ikwu ha si dị. Ala ha ketara dị nʼime ala e kenyere ndị Juda.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nketa ụmụ Simiọn bụ ndị a:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:2"
      },
      "items": [
        {
          "text": "Bịasheba (maọbụ Sheba), Molada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.2",
            "verseOrgIds": [
              "JOS.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza Shual, Bala, Ezem,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.3",
            "verseOrgIds": [
              "JOS.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eltolad, Betul, Homa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.4",
            "verseOrgIds": [
              "JOS.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziklag, Bet-Makabot, Haza Susa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.5",
            "verseOrgIds": [
              "JOS.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bet-Lebaot na Sharuhen, obodo iri na atọ na obodo nta ndị ọzọ gbara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.6",
            "verseOrgIds": [
              "JOS.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ain, Rimọn, Eta na Ashan, obodo anọ na obodo nta ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.7",
            "verseOrgIds": [
              "JOS.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinyekwara obodo nta ndị ọzọ niile gbara obodo ukwu ndị a gburugburu, ruo obodo Baalat-Bịa, ya bụ (obodo Rema dị na Negev).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.8",
            "verseOrgIds": [
              "JOS.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 19:8"
      },
      "items": [
        {
          "text": "Nke a bụ ihe nketa ebo Simiọn dịka ikwu ha si dị.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "E sitere nʼoke ụmụ Juda wepụta oke ụmụ Simiọn, nʼihi na ihe ụmụ Juda ketara dị ukwuu karịa ihe ha kwesiri iketa. Ọ bụ nke a mere ụmụ Simiọn ji nweta ihe nketa site nʼetiti ala ndị Juda.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ụmụ Zebụlọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebo nke atọ nwetara ihe nketa ha site nʼife nza bụ ebo Zebụlọn dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:10"
      },
      "items": [
        {
          "text": "Ala ha nwetara gbatịrị ruo Sarid.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.10",
            "verseOrgIds": [
              "JOS.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebe ahụ, oke ala ahụ gbatịrị gaa nʼakụkụ ọdịda anyanwụ, ruo Marala na Dabeshet, rukwaa iyi dị nʼihu Jokneam.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.11",
            "verseOrgIds": [
              "JOS.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O si na Sarid chigharịa ihu nʼakụkụ ọwụwa anyanwụ, oke ala ahụ ruru nʼoke ala Kislọt Teboa, gbagorokwa ruo Daberat, ruokwa Jafia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.12",
            "verseOrgIds": [
              "JOS.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbatịkwara nʼakụkụ ọwụwa anyanwụ ruo Gat Hefa, Et Kazin na Rimọn, tụgharịa nʼụzọ e si aga Nea.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.13",
            "verseOrgIds": [
              "JOS.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, ọ gara gburugburu nʼakụkụ ugwu ruo Hanatọn, ruokwa na Ndagwurugwu Ifta El ebe ọ sọtụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.14",
            "verseOrgIds": [
              "JOS.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a niile dịkwa nʼime ihe nketa ụmụ Zebụlọn: Katat, Nahalal, Shịmrọn, Idala na Betlehem.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        },
        {
          "text": "Obodo niile ndị a dị iri na abụọ, tinyere obodo nta niile gbara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a niile na obodo nta ha, so nʼala ụmụ Zebụlọn nwetara dịka ihe nketa ha, dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke Ụmụ Isaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebo nke anọ sitere nʼife nza nweta ihe nketa ha bụ ụmụ Isaka dịka ikwu ha si dị.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala na obodo ha ketara bụ ndị a:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:18"
      },
      "items": [
        {
          "text": "Jezril, Kesulọt, Shunem,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.18",
            "verseOrgIds": [
              "JOS.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafaraim, na Shịọn, Anaharat,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.19",
            "verseOrgIds": [
              "JOS.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabit, Kishiọn, Ebez na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.20",
            "verseOrgIds": [
              "JOS.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remet, En-Ganim, En-Hada na Bet-Pazez.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.21",
            "verseOrgIds": [
              "JOS.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ha ruru na Taboa, Shahazuma na Bet-Shemesh, ma kwụsị nʼosimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:22"
      },
      "items": [
        {
          "text": "Obodo ndị a niile dị iri na isii, tinyere obodo nta niile gbara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, obodo ukwu ndị a na obodo nta ha dị nʼala ahụ ebo Isaka nwetara dịka ihe nketa ha, dị ka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ụmụ Asha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebo nke ise e kenyere ala site nʼife nza bụ ụmụ Asha dịka ikwu ha si dị.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala na obodo ha ketara bụ ndị a:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:25"
      },
      "items": [
        {
          "text": "Helkat, Hali, Beten, Akshaf,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamelek, Amad na Mishal. Oke ala ha nʼakụkụ ọdịda anyanwụ gbatịrị ruo Kamel na Shihoa-Libnat.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼebe ahụ tụgharịa nʼakụkụ ọwụwa anyanwụ gawa Bet-Dagọn, ma ruokwa Zebụlọn na Ndagwurugwu Ifta El, ma gbagoro ruokwa Bet-Emek na Neiel. O sikwa nʼebe ahụ gafee, ruo Kabul, nʼakụkụ aka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gara ruo Ebrọn, Rehob, Hamọn na Kana, ruokwa ebe obodo Saịdọn gbasapụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ahụ mere dịka ọ na-alaghachi azụ bịaruo Rema, ruokwa obodo e wusiri ike bụ Taịa, tụgharịakwa gawa Hosa pụta nʼọnụ mmiri osimiri Mediterenịa nke dị nʼakụkụ Akzib",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Umma, Afek na Rehob.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:30"
      },
      "items": [
        {
          "text": "Ọnụọgụgụ obodo ndị a niile bụ iri abụọ na abụọ tinyere obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a na obodo nta ha niile dị nʼala ahụ ebo Asha nwetara dịka ihe nketa, dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ụmụ Naftalị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebo nke isii e nyere ihe nketa site nʼife nza bụ ebo Naftalị, dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ha malitere na Helef ruo nʼosisi ukwu dị na Zaananim, Adami Nekeb na Jabneel, gafee ruo Lakum, kwụsị nʼosimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebe ahụ oke ala ha gara nʼakụkụ ọdịda anyanwụ ruo Aznot Tabo, site nʼebe ahụ ruo Hukọk, rute Zebụlọn na ndịda, na Asha nʼọdịda anyanwụ, ruokwa Juda nʼakụkụ ọwụwa anyanwụ Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo niile e wusiri ike e kenyere ha bụ ndị a: Zidim, Zea, Hamat, Rakat, Kineret,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adama, Rema, Hazọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.36",
            "verseOrgIds": [
              "JOS.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedesh, Edrei, En-Hazoa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.37",
            "verseOrgIds": [
              "JOS.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iron,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        },
        {
          "text": "Migdal El, Horem, Bet-Anat na Bet-Shemesh.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:38"
      },
      "items": [
        {
          "text": "Ya mere, ọnụọgụgụ obodo ndị a niile bụ iri na itoolu, tinyere obodo nta niile gbara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a na obodo nta ha niile ka ebo Naftalị dịka ikwu ha si dị, nwetara dịka ihe nketa ha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ụmụ Dan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼife nza ebo Dan, bụ ebo nke asaa nwetara ihe nketa dịka ikwu ha si dị.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ihe nketa ha bụ ndị a:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 19:41"
      },
      "items": [
        {
          "text": "Zora, Eshtaol, Ia-Shemesh,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaalabin, Aijalon, Itla,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elọn, Timna, Ekrọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elteke, Gibeton, Baalat,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehud, Bene-Berak, Gat Rimọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me-Jakọn na Rakọn, obodo dị nʼoke ala, na ncherita ihu Jopa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe oke ala ụmụ Dan ketara sitere nʼaka ha pụọ. Ha gara buso obodo Leshem agha merie ha, were mma agha tigbuo ndị niile bi nʼime ya, bichie ya. Ha kpọrọ obodo ahụ Dan, nke bụ aha nna nna ha ochie.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị a na obodo nta ha bụ ihe nketa ebo Dan nwetara dịka ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke Joshua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e kechara ala ahụ niile, nye ebo ọbụla ala dịka ọnụọgụgụ ha niile si dị, ụmụ Izrel nyere Joshua, nwa Nun ihe nketa ha nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.19.50",
                "verseOrgIds": [
                  "JOS.19.50"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola na Joshua nwere ike iwere ala ọbụla ọ chọrọ. Ya mere, ha nyere Joshua obodo Timnat Sera nke dị nʼugwu Ifrem. Joshua wugharịrị obodo ahụ biri nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ oke ala nke Elieza onye nchụaja, Joshua nwa Nun na ndịisi ụlọ ebo ụmụ Izrel, kere na Shaịlo site nʼife nza nʼihu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": ", nʼọnụ ụzọ ụlọ nzute. Ha si otu a kebie ala ahụ.",
          "type": "text"
        }
      ]
    }
  ],
