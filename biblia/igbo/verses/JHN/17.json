              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna, achọrọ m ka ndị niile i nyere m soro m nọrọ ebe m nọ. Ka ha hụ otuto m nke i nyere m nʼihi na ị hụrụ m nʼanya tupu atọọ ntọala nke ụwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.24",
                "verseOrgIds": [
                  "JHN.17.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 17:25"
          },
          "items": [
