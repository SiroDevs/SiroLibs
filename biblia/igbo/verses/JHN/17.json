  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JHN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Jisọs kpeere Onyenwe ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs kwusiri okwu ndị a, o leliri anya nʼeluigwe sị,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JHN 17:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna, oge ahụ a kara aka eruola, nye Ọkpara gị otuto, ka Ọkpara gị nyekwa gị otuto.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.1",
                "verseOrgIds": [
                  "JHN.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "I nyela ya ikike nʼebe mmadụ niile nọ, na ike inye ndị niile i nyere ya ndụ ebighị ebi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.2",
                "verseOrgIds": [
                  "JHN.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nke a bụkwa ndụ ebighị ebi ahụ. Ka ha mata na naanị gị bụ Chineke nʼezie, matakwa Jisọs Kraịst onye ahụ i zitere nʼụwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.3",
                "verseOrgIds": [
                  "JHN.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enyere m gị otuto nʼụwa site nʼịrụzu ọrụ niile ị nyere m ka m rụọ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.4",
                "verseOrgIds": [
                  "JHN.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ugbu a, Nna, nye m otuto nʼihu gị, ụdị otuto ahụ m nwere nʼihu gị tupu e kee ụwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.5",
                "verseOrgIds": [
                  "JHN.17.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Jisọs kpeere ndị na-eso ụzọ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Emere m ka ndị ahụ i siri nʼụwa kponye m mara aha gị. Ha bụ ndị nke gị, i nyere m ha, ha debekwara okwu gị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.6",
                "verseOrgIds": [
                  "JHN.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ugbu a, ha amarala na ihe niile i nyere m si nʼaka gị bịa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.7",
                "verseOrgIds": [
                  "JHN.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ugbu a, enyela m ha okwu ahụ i nyere m, ha nabatakwara ya, marakwa nʼeziokwu na-esi m nʼebe ị nọ bịa. Ha kwenyekwara na ọ bụ gị zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.8",
                "verseOrgIds": [
                  "JHN.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ana m ekpere ha ekpere, ọ bụghị nʼihi ụwa ka m na-ekpe ekpere. Kama ana m ekpe ekpere banyere ndị ahụ i nyere m, nʼihi na ha bụkwa ndị nke gị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.9",
                "verseOrgIds": [
                  "JHN.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ihe niile m nwere bụ nke gị, ihe niile i nwere bụkwa nke m. E sitere na ha mee ka otuto m pụta ìhè.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.10",
                "verseOrgIds": [
                  "JHN.17.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ugbu a, anọghịkwa nʼime ụwa, ma ha ka nọ nʼime ụwa, ana m alaghachikwute gị. Ya mere, Nna dị nsọ, chebe ha nke ọma site nʼike nke aha gị, bụ aha nke ahụ i nyere m, ka ha bụrụ otu dịka anyị onwe anyị si bụrụ otu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.11",
                "verseOrgIds": [
                  "JHN.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe mụ na ha nọ nʼụwa, echebere m ha site nʼaha gị nke i nyere m. Echebekwara m ha, o nwekwaghị onye ọbụla nʼime ha lara nʼiyi, karịakwa onye ahụ bụ nwa nke ịla nʼiyi, ka e mezuo ihe akwụkwọ nsọ kwuru.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.12",
                "verseOrgIds": [
                  "JHN.17.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ugbu a, ana m alọghachikwute gị, ma ana m ekwu ihe ndị a nʼụwa ugbu a ka ha nwee nʼọṅụ m, nʼebe o zuruoke nʼime ha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.13",
                "verseOrgIds": [
                  "JHN.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enyela m ha okwu gị. Ma nʼihi ya, ụwa akpọọla ha asị. Nʼihi na ha abụghị ndị nke ụwa dị ka mụ onwe m na-abụghị onye nke ụwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.14",
                "verseOrgIds": [
                  "JHN.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ekpeghị m ekpere ka iwepụ ha nʼụwa, kama ka ịnapụta ha site nʼaka ajọ onye ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.15",
                "verseOrgIds": [
                  "JHN.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ha onwe ha abụghị ndị nke ụwa dị ka mụ onwe m na-abụkwaghị onye nke ụwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.16",
                "verseOrgIds": [
                  "JHN.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Were eziokwu doo ha nsọ, okwu gị bụ eziokwu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.17",
                "verseOrgIds": [
                  "JHN.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dị ka i siri zite m nʼụwa, otu a ka m na-ezipụkwa ha nʼụwa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.18",
                "verseOrgIds": [
                  "JHN.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụkwa nʼihi ha ka m jiri debe onwe m nsọ, ka ha onwe ha bụrụkwa ndị e doro nsọ nʼeziokwu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.19",
                "verseOrgIds": [
                  "JHN.17.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Jisọs maka ndị niile kwere ekwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ekpeghị m ekpere a nʼihi ndị a naanị. Kama ana m ekpekwa ekpere a nʼihi ndị niile ga-ekwere na mụ, site nʼokwu ha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.20",
                "verseOrgIds": [
                  "JHN.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.20",
            "verseOrgIds": [
              "JHN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka ha niile bụrụ otu, Nna, dị ka ị nọ nʼime m mụ a nọrọ nʼime gị. Ka ha nọrọkwa nʼime anyị ka ụwa kwere na ọ bụ gị zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.21",
                "verseOrgIds": [
                  "JHN.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enyere m ha otuto nke i nyere m, ka ha bụrụ otu dị ka anyị onwe anyị si bụrụ otu;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.22",
                "verseOrgIds": [
                  "JHN.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mụ onwe m nʼime ha, gị onwe gị nʼime m. Ka e mee ka ha bụrụ otu nʼụzọ zuruoke, ka ụwa matakwa na ọ bụ gị zitere m, na ị hụkwara ha nʼanya dị ka ị si hụ m nʼanya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.23",
                "verseOrgIds": [
                  "JHN.17.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 17:24"
