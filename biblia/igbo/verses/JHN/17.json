              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna onye ezi omume, ụwa amaghị gị. Ma amaara m gị. Ndị a matakwara na ọ bụ gị zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.25",
                "verseOrgIds": [
                  "JHN.17.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.25",
            "verseOrgIds": [
              "JHN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Emekwara m ka ha mara aha gị. Aga m agakwa nʼihu ime ka ha mara ya. Ka ịhụnanya ahụ i nwere nʼebe m nọ dịgide nʼime ha, ka mụ onwe m nọgidekwa nʼime ha.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.26",
                "verseOrgIds": [
                  "JHN.17.26"
                ]
              }
            }
          ]
        }
      ]
