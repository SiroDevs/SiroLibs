  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JHN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezi osisi vaịnị na alaka ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mụ onwe m bụ ezigbo osisi vaịnị ahụ. Nna m bụkwa onye ọrụ ubi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.1",
                "verseOrgIds": [
                  "JHN.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.1",
            "verseOrgIds": [
              "JHN.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ na-egbuda alaka ọbụla dị nʼime m nke na-adịghị amị mkpụrụ. Ma alaka ọbụla na-amị mkpụrụ ka ọ na-egbucha, ka o nwee ike mịa mkpụrụ dị ọtụtụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.2",
                "verseOrgIds": [
                  "JHN.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.2",
            "verseOrgIds": [
              "JHN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ugbu a, e meela ka unu dịrị ọcha nʼihi okwu m gwara unu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.3",
                "verseOrgIds": [
                  "JHN.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.3",
            "verseOrgIds": [
              "JHN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nọgidenụ nʼime m, ka mụ onwe m nọgidekwa nʼime unu. Dịka alaka ọbụla apụghị ịmị mkpụrụ nʼonwe ya ma ọ bụrụ na ọ nọgideghị nʼosisi vaịnị. Otu a, unu apụghịkwa ịmị mkpụrụ ma ọ bụrụ na unu anọgideghị nʼime m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.4",
                "verseOrgIds": [
                  "JHN.15.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mụ onwe m bụ osisi vaịnị ahụ; unu bụkwa alaka ya. Onye ọbụla na-anọgide nʼime m, nke mụ onwe m na-anọgidekwa nʼime ya, na-amị ọtụtụ mkpụrụ. Nʼihi na ewezuga m, unu enweghị ike ime ihe ọbụla.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.5",
                "verseOrgIds": [
                  "JHN.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.5",
            "verseOrgIds": [
              "JHN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla na-adịghị anọgide nʼime m dị ka alaka e gbuturu, tụpụ ya, ọ kpọnwụọ. A ga-achịkọta ya, chịnye ya nʼọkụ, o repịa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.6",
                "verseOrgIds": [
                  "JHN.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.6",
            "verseOrgIds": [
              "JHN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na unu anọgide nʼime m, okwu m anọgidekwa nʼime unu, rịọọnụ ihe ọbụla unu chọrọ, a ga-emere unu ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.7",
                "verseOrgIds": [
                  "JHN.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.7",
            "verseOrgIds": [
              "JHN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nke a ga-abụrụ Nna m otuto na unu mịrị ọtụtụ mkpụrụ hie nne, ọ na-egosikwa na unu bụ ndị na-eso ụzọ m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.8",
                "verseOrgIds": [
                  "JHN.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dị ka Nna sị hụ m nʼanya, otu a ka m sị hụkwa unu nʼanya. Ya mere, nọgidenụ nʼime ịhụnanya m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.9",
                "verseOrgIds": [
                  "JHN.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu ga-anọgide nʼịhụnanya m ma ọ bụrụ na unu edebe iwu m. Dị ka m debere iwu Nna m ma nọgidekwa nʼịhụnanya ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.10",
                "verseOrgIds": [
                  "JHN.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.10",
            "verseOrgIds": [
              "JHN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Agwala m unu ihe ndị a ka ọṅụ m dịrị nʼime unu ka ọṅụ unu zukwaa oke.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.11",
                "verseOrgIds": [
                  "JHN.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nke a bụkwa iwu m, ka unu hụrịta onwe unu nʼanya dị ka m siri hụ unu nʼanya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.12",
                "verseOrgIds": [
                  "JHN.15.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ dịghị onye ọbụla nwere ịhụnanya karịrị nke a na mmadụ tọgbọrọ ndụ ya nʼihi ndị enyi ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.13",
                "verseOrgIds": [
                  "JHN.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu onwe unu bụkwa ndị enyi m ma ọ bụrụ na unu edebe ihe m nyere nʼiwu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.14",
                "verseOrgIds": [
                  "JHN.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anaghị m akpọkwa unu ndị ohu ọzọ. Nʼihi na ohu adịghị amatazu ihe niile onyenwe ya na-eme. Ma ana m akpọ unu ndị enyi m nʼihi na agwala m unu ihe niile m nụrụ nʼọnụ Nna m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.15",
                "verseOrgIds": [
                  "JHN.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụkwaghị unu onwe unu họọrọ m. Ọ bụ m họọrọ unu, wepụtakwa unu iche ka unu gaa mịa ọtụtụ mkpụrụ, mkpụrụ nke ga-adịgidekwa. Ya mere, Nna m ga-enye unu ihe ọbụla unu ga-arịọ nʼaha m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.16",
                "verseOrgIds": [
                  "JHN.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ihe ndị a ka m na-enye unu nʼiwu, hụrịtanụ onwe unu nʼanya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.17",
                "verseOrgIds": [
                  "JHN.15.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụwa kpọrọ ha asị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na ụwa akpọọ unu asị, chetanụ na o buru ụzọ kpọọ m asị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.18",
                "verseOrgIds": [
                  "JHN.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A sị na unu bụ nke ụwa, ụwa ga-ahụ unu nʼanya dịka ndị nke ya. Ma otu ọ dị unu abụghị nke ụwa. Kama, esi m nʼime ụwa họrọ unu. Ọ bụkwa nʼihi ya ka ụwa ji akpọ unu asị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.19",
                "verseOrgIds": [
                  "JHN.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chetakwanụ ihe m gwara unu, 'Ohu adịghị adị ukwuu karịa Onyenwe ya.'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.20",
                "verseOrgIds": [
                  "JHN.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, ebe ha kpagburu m, ha ga-akpagbukwa unu. Ọ bụrụ na ha debere okwu m, ha ga-edebekwa nke unu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.20",
                "verseOrgIds": [
                  "JHN.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ee, ha ga-eme unu ihe niile ndị a nʼihi aha m, na nʼihi na ha amaghị onye ahụ zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.21",
                "verseOrgIds": [
                  "JHN.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
              "JHN.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na abịaghị m, gwa ha okwu, ikpe mmehie agaraghị ama ha. Ma ugbu a, ha enweghị ngọpụ ọbụla banyere mmehie ha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.22",
                "verseOrgIds": [
                  "JHN.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
            "verseOrgIds": [
              "JHN.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla kpọrọ m asị kpọkwara Nna m asị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.23",
                "verseOrgIds": [
                  "JHN.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A sị na ọrụ niile m rụrụ nʼetiti ha akarịghị ọrụ nke onye ọbụla ọzọ rụrụ, ha agaraghị abụ ndị ikpe mmehie mara. Ma ugbu a ha ahụzuola ọrụ ebube ndị a niile, ma ha nọgidekwara na-akpọ mụ na Nna m asị.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.24",
                "verseOrgIds": [
                  "JHN.15.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.24",
            "verseOrgIds": [
              "JHN.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nke a bụ imezu ihe e dere nʼakwụkwọ iwu ha. 'Ha kpọrọ m asị na-enweghị ihe m mere.'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.25",
                "verseOrgIds": [
                  "JHN.15.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
