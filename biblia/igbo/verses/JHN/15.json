        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ahụ ga-abịa, onye m ga-ezitere unu site nʼaka Nna, bụ Mmụọ eziokwu ahụ sitere na Nna pụta, ọ ga-agba ama banyere m.",
              "type": "text",
