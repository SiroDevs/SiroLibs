  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ECC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amamihe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezi aha",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        },
        {
          "text": "ka mma karịa mmanụ isi ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:1"
      },
      "items": [
        {
          "text": "Ụbọchị mmadụ nwụrụ ka ụbọchị a mụrụ ya mma.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
            "verseOrgIds": [
              "ECC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kaara gị mma ije nʼebe a na-eru ụjụ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "karịa ebe a na-eri na-aṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "Nʼihi na ọnwụ dịịrị mmadụ ọbụla;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:2"
      },
      "items": [
        {
          "text": "ndị dị ndụ kwesiri iburu nke a nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.2",
            "verseOrgIds": [
              "ECC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iru ụjụ ka ịchị ọchị mma,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:3"
      },
      "items": [
        {
          "text": "ihu gbarụrụ agbarụ na-enyere obi aka",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.3",
            "verseOrgIds": [
              "ECC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye maara ihe na-eche echiche banyere ọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:4"
      },
      "items": [
        {
          "text": "ma onye nzuzu na-eche naanị banyere ikpori ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.4",
            "verseOrgIds": [
              "ECC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ka mma ige ntị nye mba onye maara ihe",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:5"
      },
      "items": [
        {
          "text": "karịa ịṅa ntị nʼabụ ndị na-enweghị uche na-abụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.5",
            "verseOrgIds": [
              "ECC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchị onye nzuzu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:6"
      },
      "items": [
        {
          "text": "dị ka mkpọtụ nke ogwu na-ere ọkụ na-eme nʼokpuru ite.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:6"
      },
      "items": [
        {
          "text": "Ihe a bụkwa ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.6",
            "verseOrgIds": [
              "ECC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji anya ike nara mmadụ ihe na-eme ka onye mara ihe ghọọ onye nzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:7"
      },
      "items": [
        {
          "text": "iri ngarị na-emerụ obi mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.7",
            "verseOrgIds": [
              "ECC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgwụgwụ ihe ọbụla dị mma karịa mmalite ya!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:8"
      },
      "items": [
        {
          "text": "Ogologo ntachiobi dị mma karịa mpako!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.8",
            "verseOrgIds": [
              "ECC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụla onye na-ewe iwe ọsịịsọ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:9"
      },
      "items": [
        {
          "text": "nʼihi na iwe bụ oke ndị nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asịla, \"Gịnị mere ụbọchị gara aga ji dị mma karịa ụbọchị ndị a?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:10"
      },
      "items": [
        {
          "text": "Nʼihi na ọ bụghị amamihe ị jụ ajụjụ dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.10",
            "verseOrgIds": [
              "ECC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe dịka ihe nketa, bụ ihe dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:11"
      },
      "items": [
        {
          "text": "Ọ na-abara uru nye ndị na-ahụ anyanwụ anya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.11",
            "verseOrgIds": [
              "ECC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe bụ ndo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "dịka ego si bụrụkwa ndo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "ma ụzọ ihe ọmụma ji dị mma karịa bụ nke a:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:12"
      },
      "items": [
        {
          "text": "Amamihe na-echebe ndụ ndị nwere ya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.12",
            "verseOrgIds": [
              "ECC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chee echiche banyere ihe Chineke na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:13"
      },
      "items": [
        {
          "text": "Mmadụ ọ pụrụ ime ka ọ dịzie adịzie,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:13"
      },
      "items": [
        {
          "text": "bụ ihe Chineke mere ka ọ gbagọọ agbagọ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe na-agara gị nke ọma, ṅụrịa ọṅụ, nʼihi ọ dịrị gị mma,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "ma mgbe mmekpa ahụ batara, mata nke ọma",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "na Chineke onye na-enye ọnọdụ ọma",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "makwa ihe banyere ọnọdụ ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "Ya mere, o nweghị onye ọbụla nwere ike ịchọpụta",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:14"
      },
      "items": [
        {
          "text": "ọdịnihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndụ m nʼụwa a bụ ihe efu, ahụla m ihe abụọ ndị a;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:15"
      },
      "items": [
        {
          "text": "onye ezi omume na-anwụ nʼezi omume ya,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:15"
      },
      "items": [
        {
          "text": "ma onye na-emebi iwu na-ebi ogologo ndụ na mmebi iwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, abụbigala onye ezi omume oke,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:16"
      },
      "items": [
        {
          "text": "emekwala onwe gị onye mabigara ihe oke.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:16"
      },
      "items": [
        {
          "text": "Gịnị mere i ji achọ igbu onwe gị?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụbigala onye na-emefe ajọ omume oke,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:17"
      },
      "items": [
        {
          "text": "abụkwala onye nzuzu!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:17"
      },
      "items": [
        {
          "text": "Gịnị ka ị ga-eji nwụọ mgbe oge gị na-erubeghị?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị mma ijide otu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:18"
      },
      "items": [
        {
          "text": "na-esepụghị aka na nke ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:18"
      },
      "items": [
        {
          "text": "onye na-atụ egwu Chineke ga-enweta uru nʼime ha abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe na-eme ka otu onye dị ike",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:19"
      },
      "items": [
        {
          "text": "karịa mmadụ iri na-achị otu obodo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbaa ụwa niile gburugburu, ọ dịghị otu onye bụ onye ezi omume,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:20"
      },
      "items": [
        {
          "text": "ọ dịghị onye na-eme ihe ziri ezi nke na-adịghị eme mmehie mgbe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egela ntị nʼihe niile ndị mmadụ na-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.21",
            "verseOrgIds": [
              "ECC.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:21"
      },
      "items": [
        {
          "text": "ị pụrụ ịnụ nkọcha nke ohu gị na-akọcha gị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.21",
            "verseOrgIds": [
              "ECC.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onwe gị maara",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:22"
      },
      "items": [
        {
          "text": "na ọtụtụ oge, ị na-akọchakwa ndị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agbalịsiela m ike inwe nghọta. Ekwuru m sị,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:23"
      },
      "items": [
        {
          "text": "\"Aga m abụ onye amamihe,\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:23"
      },
      "items": [
        {
          "text": "ma nke a karịrị m.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe adịghị mfe inweta, ọ dị omimi nke ukwuu;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:24"
      },
      "items": [
        {
          "text": "ọ bụ onye pụrụ ịchọpụta ya?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tụgharịrị uche m ka m ghọta,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:25"
      },
      "items": [
        {
          "text": "iledo na ịchọpụta amamihe na atụmatụ otu ihe niile si dị",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:25"
      },
      "items": [
        {
          "text": "na ịghọtakwa nzuzu nke dị na ajọ omume",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:25"
      },
      "items": [
        {
          "text": "na ịyị ara nke dị na enweghị uche.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọpụtara m na ọ dị ihe dị ilu karịa ọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "ihe ahụ bụ nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "Obi ya dị ka ụgbụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "Otu a kwa, aka o ji ejikụ gị dị ka ụdọ igwe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "Onye ahụ na-eme ihe na-atọ Chineke ụtọ na-esi nʼaka ya gbapụ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "ma ndị mmehie ka ọ na-enwude nʼọnya ya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ECC 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lee, Ihe a ka m chọpụtara,\" ka onye nkuzi kwuru:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:27"
      },
      "items": [
        {
          "text": "\"Site nʼịtụkwasị otu ihe nʼelu ibe ya ka m matara isi ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ECC 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m ka na-achọ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        }
      ]
    },
