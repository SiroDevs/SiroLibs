  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ZEP 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "E kpere Juda na Jerusalem ikpe ha na mba niile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Oku akpọrọ Juda ka ọ chegharịa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chịkọtaanụ onwe unu, e, chịkọtaanụ onwe unu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:1"
      },
      "items": [
        {
          "text": "unu ndị mba ihe ihere dịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupu ụkpụrụ ahụ ewere ọnọdụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "a chịpụ ụbọchị ahụ dịka igbugbo ọka nke ikuku na-ebufu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "tupu iwe ọkụ Onyenwe anyị",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "abịakwasị gị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "tupu ụbọchị ọnụma nke",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.2.2",
                "verseOrgIds": [
                  "ZEP.2.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "abịakwasị gị.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chọọnụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.2.3",
                "verseOrgIds": [
                  "ZEP.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", unu ndị niile dị umeala nʼobi nọ nʼala ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "unu bụ ndị na-eme ihe o nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "Gbasoonụ ezi omume, gbasoonụ ịdị umeala nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "ma eleghị anya, a ga-echebe unu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "nʼụbọchị iwe",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.2.3",
                "verseOrgIds": [
                  "ZEP.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ahụhụ dịrị Filistia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o nwekwaghị ndị ga-ebi nʼobodo Gaza,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:4"
      },
      "items": [
        {
          "text": "obodo Ashkelọn ga-atọgbọrọ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:4"
      },
      "items": [
        {
          "text": "Nʼetiti ehihie ka a ga-ekpochapụ ndị niile bi nʼAshdọd;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:4"
      },
      "items": [
        {
          "text": "a ga-ehopukwa Ekrọn.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịrị unu ndị bi nʼakụkụ oke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "unu bụ ndị Keret;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "okwu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.2.5",
                "verseOrgIds": [
                  "ZEP.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "na-emegide unu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "Kenan, ala ndị Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"Aga m ala gị nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "ruo na ọ dịghị onye ga-afọdụ ndụ nʼime gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala nke dị nʼakụkụ oke osimiri ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:6"
      },
      "items": [
        {
          "text": "ga-aghọ ebe ahịhịa jupụtara nye ndị ọzụzụ atụrụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:6"
      },
      "items": [
        {
          "text": "na ọgba igwe ewu na atụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala nke dị nʼakụkụ oke osimiri",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "ga-aghọ ala nke ndị ahụ fọdụrụ na Juda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "ebe ha ga-achọtara anụ ụlọ ha ahịhịa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "Ha ga-anọkwa nʼụlọ ndị Ashkelọn nke tọgbọrọ nʼefu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "dinaa ala zuru ike nʼoge uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.2.7",
                "verseOrgIds": [
                  "ZEP.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ha ga-elekọta ha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "mekwaa ka ha nwetaghachi ihe nketa ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ahụhụ dịrị Moab na Amọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anụla m okwu ọjọọ niile, nke ndị Moab,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:8"
      },
      "items": [
        {
          "text": "na ịkwa emo niile nke ndị Amọn,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
