  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ACT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpagbu site nʼaka Herọd",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, eze Herọd jidere ụfọdụ ndị so na chọọchị buru nʼobi ịkpagbu ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jiri mma agha gbuo Jemis nwanne Jọn.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.2",
            "verseOrgIds": [
              "ACT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ chọpụtara na omume ya tọrọ ndị Juu ụtọ, ọ gara nʼihu jidekwa Pita. Nke a mere nʼoge mmemme Achịcha Ekoghị eko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.3",
            "verseOrgIds": [
              "ACT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o jidere ya, o tinyere ya nʼụlọ mkpọrọ ebe o mere ka ndị agha chee ya nche, ndị agha anọ nʼotu oge, ndị agha anọ ọzọ nʼoge nke ọzọ. Ebumnobi ya bụ ịkpọpụta ya nʼihu ọha mmadụ kpee ya ikpe mgbe Mmemme Ngabiga gasịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.4",
            "verseOrgIds": [
              "ACT.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e debere Pita nʼụlọ mkpọrọ, nzukọ esepụghị aka nʼikpe ekpere nʼihi ya nye Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmụọ ozi agbapụta Pita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼabalị na-esota ụbọchị ahụ Herọd ga-akpụpụta ya, Pita nọ nʼụra nʼetiti ndị agha abụọ, e jiri eriri igwe kee ya nʼụkwụ nʼaka, ma ndị nche ọzọ nọkwa nʼọnụ ụzọ na-eche ya nche.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.6",
            "verseOrgIds": [
              "ACT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mberede mmụọ ozi Onyenwe anyị bịara guzoro nʼebe ahụ, ìhè nwukwara nʼime ụlọ mkpọrọ ahụ. Ọ kutụrụ Pita aka nʼakụkụ sị, \"Ngwangwa, bilie ọtọ!\" Eriri igwe ahụ dapụrụ nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.7",
            "verseOrgIds": [
              "ACT.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi ahụ sịrị ya, \"Yiri uwe gị na akpụkpọụkwụ gị.\" O mere otu ahụ, Mmụọ ozi ahụ gwakwara ya, \"Yirikwa akwa mgbokwasị gị soro m.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.8",
            "verseOrgIds": [
              "ACT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita sooro ya nʼazụ, o chere na ọ na-ahụ ọhụ, ma ọ mataghị na ihe mmụọ ozi ahụ na-eme bụ ezie.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.9",
            "verseOrgIds": [
              "ACT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gafere ndị nche nke mbụ na nke abụọ rute nʼọnụ ụzọ e si abanye nʼime obodo, nke bụ ọnụ ụzọ igwe. Ọnụ ụzọ igwe ahụ meghekwara nʼonwe ya, ha esite na ya gafee. Mgbe ha gara ije ruo ebe tere anya nʼama nke ọzọ, ngwangwa mmụọ ozi ahụ hapụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.10",
            "verseOrgIds": [
              "ACT.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa ka Pita ghọtara ihe niile mere. O kwuru, \"Ugbu a, amatala m nʼezie, na Onyenwe anyị ezitela mmụọ ozi ya, ka ọ bịa zọpụta m site nʼaka eze Herọd na ihe niile ndị Juu na-atụ anya ya. Ugbu a ọ napụtakwala m site nʼọchịchọ ọjọọ niile nke ndị Juu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.11",
            "verseOrgIds": [
              "ACT.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọtara ihe merenụ, ọ gawara nʼụlọ Meri nne Jọn onye a na-akpọkwa Mak, ebe ọtụtụ mmadụ zukọtararị na-ekpe ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ kụrụ aka nʼọnụ ụzọ ama, otu odibo nwanyị aha ya bụ Roda bịara ka o zaa ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nụrụ olu Pita, ọṅụ juru ya obi nke mere na ọ gbaara ọsọ laghachi azụ nʼemegheghị ụzọ. Ọ gara tisaa, \"Ọ bụ Pita nọ nʼọnụ ụzọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị ya na ọ na-ekwu okwu dịka onye uche ya na-ezughị oke. Mgbe ọ nọgidesịrị ike na-ekwu otu ihe ahụ, ha sịrị, \"Ọ ghaghị ị bụ mmụọ ozi ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pita nọgidere na-akụ aka nʼụzọ. Mgbe ha meghere ụzọ hụ ya, ọ gbagwojuru ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O feere ha aka ka ha mechie ọnụ. Ọ kọọrọ ha otu Onyenwe anyị si dupụta ya site nʼụlọ mkpọrọ. Ọ gwara ha, \"Meenụ ka Jemis na ụmụnna anyị niile mata ihe ndị a.\" Ọ pụrụ gawa ebe ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ echi ya, oke ọgbaaghara dị nʼetiti ndị agha, ebe ha na-eche ihe mere Pita.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Herọd chọgharịchara ya ma ọ chọtaghị ya, ọ jụrụ ndị nche ahụ ajụjụ dị iche iche. Nʼikpeazụ ọ nyere iwu ka e gbuo ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 12:19"
      },
      "items": [
        {
          "text": "Ọnwụ Herọd",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 12:19"
      },
      "items": [
        {
          "text": "Emesịa ọ hapụrụ Judịa gaa Sizaria nọdụ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ Herọd na-eweso ndị Taịa na Saịdọn iwe, ha zipụrụ ndị ozi ha izute ya. Ha buru ụzọ mee ka ha na Blastọs bụrụ enyi, onye eze tụkwasịrị obi nke na-elekọtakwa ime ụlọ ndina eze anya. Ha rịọrọ ya ka udo dịrị, nʼihi na a na-esi nʼobodo eze na-enwetara ha ihe oriri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.20",
            "verseOrgIds": [
              "ACT.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nzukọ ahụ, Herọd gbokwasịrị uwe ndị eze ya nọkwasị nʼocheeze ya. O weere oke olu dị iche gwa nzukọ ahụ niile okwu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwe mmadụ ahụ nọ na-eti mkpu, \"Nke a abụghị olu mmadụ, ọ bụ olu chi!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu oge ahụ, mmụọ ozi Onyenwe anyị tiri ya ihe otiti dị egwu nʼihi na o nyeghị Chineke otuto ma otu. Ikpuru ripịara ya ahụ, nke mere ka ọ nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.23",
            "verseOrgIds": [
              "ACT.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma okwu Chineke gara nʼihu na-aba ụba na-agbasakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.24",
            "verseOrgIds": [
              "ACT.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzipụ Sọl na Banabas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha rụchara ọrụ ha, Banabas na Sọl si Jerusalem lọghachi. Ha kpọọrọ Jọn onye a na-akpọkwa Mak nʼije ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.25",
            "verseOrgIds": [
              "ACT.12.25"
            ]
          }
        }
      ]
    }
  ],
