  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ACT 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl nʼobodo Tesalonaịka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha gafechara obodo Amfipolis na Apolonia, ha bịaruru obodo Tesalonaịka, ebe ụlọ nzukọ ndị Juu dị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl bakwuuru ha, dịka ọ na-eme oge niile. Ọ nọnyere ha izu ụka atọ, ya na ha na-atụgharị uche nʼAkwụkwọ Nsọ,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-akọwara ha na-edokwa ha anya na ọ dị mkpa na Kraịst ga-ahụ ahụhụ, ma sitekwa nʼọnwụ bilie. Ọ sịrị, \"Jisọs a, nke m na-ekwusara unu bụ Kraịst ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ nʼime ndị Juu ahụ ka e mere ka ha kwere ma sonyere Pọl na Saịlas, otu aka ahụ, igwe mmadụ ndị na-atụ egwu Chineke nʼetiti ndị Griik na ụmụ nwanyị ụfọdụ a maara aha ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Juu jupụtara nʼekworo, nʼihi ya, ha kpaliri obi ụfọdụ mmadụ efu nʼetiti ha nʼọma ahịa. Ndị a malitekwara ọgbaaghara nʼụzọ dị iche nʼime obodo. Ha tikasịrị ụlọ Jesin, nʼihi na ha chọrọ ịdọpụta ha nyefee ha nʼaka ọha mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.5",
            "verseOrgIds": [
              "ACT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha na-achọtaghị ha nʼebe ahụ, ha dọpụtara Jesin na ụmụnna anyị ụfọdụ, duru ha jekwuru ndị ikpe nke obodo ahụ, na-eti mkpu, \"Ndị a kpuru ụwa ihu nʼala abịala inye obodo ukwu anyị nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jesin nabatara ha nʼụlọ ya. Ha na-emebi iwu Siza nʼihi na ha na-asịkwa na ọ dị eze ọzọ dị nke a na-akpọ Jisọs.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.7",
            "verseOrgIds": [
              "ACT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu dị otu a wetara obi ịlọ mmiri nʼetiti ndị ikpe na mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha hapụrụ Jesin na ndị ọzọ, naanị mgbe ndị akaebe bịara kwụọ ụgwọ e jiri gbapụta ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl nʼobodo Beria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼabalị ahụ, ndị kwere ekwe mere ngwangwa zipụ Pọl na Saịlas ka ha gaa obodo Beria. Ma mgbe ha ruru nʼebe ahụ, ha banyere nʼụlọ nzukọ ndị Juu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.10",
            "verseOrgIds": [
              "ACT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị bi na Beria jiri obi ghere oghe nabata okwu a karịa ndị bi na Tesalonaịka. Nʼihi na ha ji ịnụ ọkụ nʼobi nara okwu ahụ, na-enyocha Akwụkwọ Nsọ kwa ụbọchị, ka ha mara ma ihe ha na-ekwu ọ bụ eziokwu. Ha mere nke a ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.11",
            "verseOrgIds": [
              "ACT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ nʼime ha kweere, ụfọdụ ụmụ nwanyị na ụmụ nwoke ndị Griik a maara aha ha chegharịkwara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Juu bi na Tesalonaịka nụrụ na Pọl na-ekwusa oziọma Chineke na obodo Beria, ụfọdụ ha gara nʼebe ahụ na-akpali igwe ndị mmadụ nʼihi iwebata ọgbaaghara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị kwere ekwe mere ngwangwa zipụ Pọl ka ọ gaa nʼakụkụ oke osimiri dị nʼebe ahụ. Ma ha hapụrụ Saịlas na Timoti ka ha na ha nọdụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị dupuru Pọl sooro ya ruo obodo Atens. Ha lawara, hapụrụ Saịlas na Timoti ozi ka ha bịakwute ya na-atụfughị oge.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl nʼobodo Atens",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Pọl nọ na-echere ha nʼAtens, o wutere mmụọ ya nke ukwuu nʼihi arụsị niile ọ hụrụ, nke jupụtara nʼobodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ya na ndị Juu na ndị na-atụ egwu Chineke, na-anọgide nʼụlọ nzukọ na-arụrịta ụka. Kwa ụbọchị, ọ na-apụkwa nʼọma ahịa na-agwa ndị niile o zutere okwu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya na ụfọdụ ndị Epikuri",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "text": "na ndị Stoịk",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "text": "bụ ndị ọkachamara na-arụrịta ụka. Ndị ụfọdụ na-asị, \"gịnị ka onye ekwurekwu a ga-ekwu?\" Ndị ọzọ sịrị, \"ọ dịka onye na-ekwusa ụmụ mmụọ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "text": "ndị ala ọzọ.\" Ha kwuru nke a nʼihi na ọ na-ekwusa oziọma banyere Jisọs na mbilite nʼọnwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpọbatara ya nʼebe ha zukọrọ, ebe a na-akpọ Areopagọs,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        },
        {
          "text": "ebe ha nọ sị ya, \"Anyị enwere ike ịmata ihe banyere ozizi ọhụrụ gị a?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-ekwu ihe ndị na-agbagwoju anyị anya. Anyị chọrọ ịmata ihe ndị a nke ọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.20",
            "verseOrgIds": [
              "ACT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ndị Atens niile na ndị ala ọzọ bi nʼobodo ahụ, enweghị ohere ime ihe ọbụla, ọ gwụchaala ọrụ ikwu na ịnụ banyere ihe dị ọhụrụ.)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.21",
            "verseOrgIds": [
              "ACT.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Pọl guzoro na nzukọ Areopagọs sị, \"Unu ndị Atens, ahụla m na ọ na-anụ unu ọkụ nʼobi ịsọpụrụ mmụọ nke unu na-efe ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mgbe m na-ejegharị nʼobodo unu, ahụrụ m ụlọ chi dị iche iche, ahụrụ m otu ebe ịchụ aja nke e dekwasịrị nʼelu ya:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "ACT 17:23"
      },
      "items": [
        {
          "text": "Ihe e nyere chi nke amaghị ama.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ACT 17:23"
      },
      "items": [
        {
          "text": "Ya mere, ihe ahụ unu na-efe ofufe nʼamaghị ama nke a ka m na-ekwusara unu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chineke onye kere ụwa na ihe niile dị nʼime ya. Ebe ọ bụ onye nwe eluigwe na ụwa, ọ dịghị ebikwa nʼụlọnsọ e jiri aka wuo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu aka ahụ, ọ dịghị anara ije ozi site nʼaka mmadụ, dịka a ga-asị na o nwere ihe kọrọ ya. Ya onwe ya na-enye ndụ na ume na ihe niile. Ọ na-egbokwa mkpa niile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼaka otu onye, bụ mmadụ mbụ ahụ, kee agbụrụ niile nke mmadụ nʼotu nʼotu, ka ha biri nʼelu ụwa dum. O jiri aka ya kewachaa oge ọgbọ ọbụla ga-anọ na oke niile nke ebe obibi ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nzube ya banyere ihe niile bụ ka onye ọbụla chọsie Chineke ike. Eleghị anya, mmadụ nwere ike lezie ụzọ ya anya, si otu a chọta ya. Ọ nọkwaghị mmadụ ọbụla nʼebe dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Nʼihi nʼime ya ka anyị na-ebi, anyị na-ejegharịkwa nʼime ya na-adịkwa ndụ.' Dịka ụfọdụ nʼime unu ndị ode abụ na-ekwu sị, 'Anyị onwe anyị bụ ụmụ ya.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ebe anyị bụ ndị Chineke mụrụ, o kwesighị ka anyị na-eche na ihe akpọrọ Chineke yiri ọlaọcha maọbụ ọlaedo, maọbụ nkume, ihe apịrị apị site na ǹka na ihe dị nʼobi mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke lefuru enweghị nghọta nke mmadụ anya banyere ihe ndị a niile nʼoge gara aga. Ma ugbu a, ọ chọrọ ka mmadụ niile chegharịa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o debela otu ụbọchị mgbe ọ ga-ekpe ụwa niile ikpe nʼụzọ ezi omume, site nʼaka otu nwoke ọ họpụtara. O mekwara ka nke a guzosie ike, mgbe o mere ka onye ahụ sị nʼọnwụ bilie.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nụrụ ihe banyere mbilite nʼọnwụ nke ndị nwụrụ anwụ, ha chịrị ya ọchị. Ma ụfọdụ nʼime ha sịrị, \"Nʼoge ọzọ anyị ga-achọ ịnụ okwu ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Pọl hapụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ ole na ole sooro ya, bụrụkwa ndị kwere ekwe. Otu onye nʼime ha bụ Dionisiọs onye Areopagọs. Onye ọzọ bụ nwanyị a na-akpọ Damaris na ndị ọzọkwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
      ]
    }
  ],
