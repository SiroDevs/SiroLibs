  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "ACT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl agaa obodo Masidonia na Griis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọgbaaghara ndị a kwụsịrị, Pọl kpọkwara ndị na-eso ụzọ ahụ, gbaa ha ume, gwa ha ka ha nọdụ nke ọma, ọ pụrụ gawa Masidonia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.1",
            "verseOrgIds": [
              "ACT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ gagharịchara nʼakụkụ ala ahụ niile, werekwa okwu nkasiobi gbaa ndị ụmụnna ume, ọ bịaruru ala Griis.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.2",
            "verseOrgIds": [
              "ACT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nọrọ ọnwa atọ nʼebe ahụ. Mgbe ọ chọpụtara na ndị Juu agbaala ajọ izu megide ya dịka ọ na-ejikere iso ụgbọ mmiri gaa Siria, o kpebiri ka ya si ụzọ Masidonia laghachi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.3",
            "verseOrgIds": [
              "ACT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sopata onye Boria bụ ọkpara Pirọs, na Arịstakọs, na Sekundus ndị si na Tesalonaịka, na Gaiọs onye Debi na Timoti, na Taịkikọs na Trofimọs, ndị Eshịa sokwa ya na-aga ije a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.4",
            "verseOrgIds": [
              "ACT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bu ụzọ gawa, na-eche anyị na Troas.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.5",
            "verseOrgIds": [
              "ACT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mmemme Ngabiga ahụ gwụsịrị, anyị banyere ụgbọ mmiri rute Filipai bịakwute ha na Troas nʼụbọchị nke ise. Anyị nọrọ nʼebe ahụ ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpọlite Yutikọs site nʼọnwụ nʼobodo Troas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị mbụ nʼizu ụka, mgbe anyị zukọrọ ịnyawa achịcha, Pọl gwara ha okwu, ebe ọ na-akwado ịla ma chi bọọ, o kwugidere okwu ruo nʼetiti abalị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.7",
            "verseOrgIds": [
              "ACT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ oriọna dịkwa nʼime ọnụụlọ ahụ dị nʼụlọ elu ebe anyị zukọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.8",
            "verseOrgIds": [
              "ACT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nwokorobịa a na-akpọ Yutikọs nọdụrụ ala nʼoghereikuku, ọ bụ onye oke ụra bidoro ịtụ dịka Pọl na-ekwu okwu ruo oge dị anya. Mgbe ọ dara nʼoke ụra a, o sitere na nʼụlọ elu nke atọ dapụ, daa nʼala. Mgbe e buliri ya, ọ bụ onye nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.9",
            "verseOrgIds": [
              "ACT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl rituru nʼala selite ya elu jikụọ ya. Ọ sịrị ndị gbakọrọ nʼebe ahụ sị, \"Ka obi hapụ ịlọ unu mmiri ọ dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.10",
            "verseOrgIds": [
              "ACT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ laghachikwara nʼụlọ elu ahụ, mgbe ọ nyawachara achịcha ma riekwa, o kwugidere okwu tutu chi abọọ, ọ hapụrụ ha bilie ije ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.11",
            "verseOrgIds": [
              "ACT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kulitere nwokorobịa ahụ na ndụ nke mere ka ọṅụ jupụta ha nʼobi. Ọ gbakwara ha ume nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekele ikpeazụ nke Pọl nye ndị okenye Efesọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị onwe anyị gara nʼihu banye nʼụgbọ mmiri chee ihu ịga Asọs. Ebe anyị zubere iburu Pọl nʼụgbọ anyị. O soghị anyị nʼihi na o zubere iji ụkwụ ruo ebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.13",
            "verseOrgIds": [
              "ACT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o zutere anyị nʼAsọs, anyị buru ya nʼụgbọ gaa Mitilen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.14",
            "verseOrgIds": [
              "ACT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke ọzọ ya, anyị rutere Kiọs, nʼụbọchị nke so ya, anyị gafere rute Samọs. Ma mgbe otu ụbọchị ọzọ gasịrị, anyị rutere Melitọs.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.15",
            "verseOrgIds": [
              "ACT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Pọl kpebiri na ọ gaghị akwụsị nʼEfesọs ka ọ ghara itufu oge nʼEshịa, nʼihi na ọ na-eme ngwangwa irute Jerusalem nʼụbọchị mmemme Pentikọọsụ, ma ọ bụrụ ihe ọ pụrụ ime.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na Melitọs, ọ zipụrụ ozi ka a kpọọrọ ya ndị okenye chọọchị nke Efesọs ka ha bịa zute ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.17",
            "verseOrgIds": [
              "ACT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oge ha bịakwutere ya, ọ gwara ha, \"Unu maara nke ọma otu m si nọ nʼetiti unu mgbe niile mụ na unu nọrọ, site nʼụbọchị mbụ ụkwụ m zọkwasịrị nʼala Eshịa tutu ruo ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.18",
            "verseOrgIds": [
              "ACT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arụrụ m ọrụ Onyenwe anyị site nʼobi umeala na anya mmiri nʼetiti ntaramahụhụ dị ukwuu, site nʼizu ọjọọ ndị Juu gbara maka m.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.19",
            "verseOrgIds": [
              "ACT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu hụrụ na m ahapụghị ime ka unu mara ihe ọbụla ga-abara unu uru, mgbe ọbụla m na-akụziri unu ihe nʼụlọ maọbụ nʼihu ọha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.20",
            "verseOrgIds": [
              "ACT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kwusaala m nye ma ndị Juu ma ndị Griik okwu nchegharị nʼebe Chineke nọ, na okwukwe nʼebe Onyenwe anyị Jisọs nọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.21",
            "verseOrgIds": [
              "ACT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma otu ọ dị, ana m aga Jerusalem dịka iwu Mmụọ Nsọ nyere m si dị, ma amaghị m ihe ọnọdụ m ga-abụ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.22",
            "verseOrgIds": [
              "ACT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karịakwa na Mmụọ Nsọ na-agbara m ama nʼebe ọbụla na mkpọrọ na ntaramahụhụ na-eche m nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.23",
            "verseOrgIds": [
              "ACT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma akpọghị m ndụ m ihe ọbụla. Karịa naanị ka m gbazuo ọsọ m ma jezuokwa ozi ahụ m natara nʼaka Onyenwe anyị Jisọs, nke bụ ịkọwa banyere oziọma nke amara Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, amaara m na o nweghị onye ọbụla nʼime unu, bụ ndị m jegharịrị nʼetiti ha na-ezisara ihe banyere alaeze a ga-ahụ m anya ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.25",
            "verseOrgIds": [
              "ACT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ana m agwasị unu ike, taa, na abụ m onye aka ya dị ọcha nʼebe ọbara onye ọbụla nʼime unu dị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.26",
            "verseOrgIds": [
              "ACT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na-esepụghị m aka ikwupụta nzọpụta Chineke nye unu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.27",
            "verseOrgIds": [
              "ACT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, kpacharanụ anya! Leziekwanụ onwe unu na igwe atụrụ nke Mmụọ Nsọ mere unu ndị nlekọta anya ya. Ka unu bụrụ ndị ọzụzụ atụrụ nke chọọchị Chineke, bụ nke o ji ọbara ya zụtara onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.28",
            "verseOrgIds": [
              "ACT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na amaara m na mgbe m lachara, agụ jọgburu onwe ya ga-abata nʼetiti unu nke na-agaghị emere igwe atụrụ ebere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.29",
            "verseOrgIds": [
              "ACT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ nʼime unu ga-ebili tụgharịa eziokwu ahụ ịhụ ka ha si otu a dọrọ ụfọdụ ndị na-eso ụzọ ahụ nye onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.30",
            "verseOrgIds": [
              "ACT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, na-echenụ nche! Chetakwanụ na nʼime afọ atọ m nọrọ nʼetiti unu, ehihie na abalị, eji m ịkwa akwa na anya mmiri na-adụ unu ọdụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a ana m etife unu nʼaka Chineke na nlekọta ya. Ana m etifekwa unu nʼaka okwu amara ya nke pụrụ ịgba okwukwe unu ume na inyekwa unu akụnụba ọ kwadobeere ndị ahụ e doro nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.32",
            "verseOrgIds": [
              "ACT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mgbe ọbụla agụụ ịdọtara onwe m ọlaọcha maọbụ ọlaedo maọbụ uwe nke onye ọbụla ji gụọ m.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.33",
            "verseOrgIds": [
              "ACT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bakwaghị uru ịgwa unu na ọ bụ aka m rụpụtara ọrụ gbooro m mkpa niile, na nke gbokwara mkpa ndị ahụ mụ na ha so.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.34",
            "verseOrgIds": [
              "ACT.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihe niile, abụkwa m ihe ilere anya nye unu banyere inyere ndị ogbenye aka, site nʼịrụ ọrụ nʼụzọ dị otu a, na-echetara m okwu nke Onyenwe anyị Jisọs kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.35",
            "verseOrgIds": [
              "ACT.20.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Ngọzị karịrị dị nʼinye enye karịa ịnara anara.' \"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.20.35",
                "verseOrgIds": [
                  "ACT.20.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kwusiri okwu ndị a, o soro ha niile gbuo ikpere nʼala kpekwa ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bere akwa nke ukwuu, makụọ Pọl, sutukwa ya ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wutere ha karịa na o kwuru na ha agaghị ahụ ya anya ọzọ. Emesịa, ha duru ya ruo ebe ọ banyere ụgbọ mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
            "verseOrgIds": [
              "ACT.20.38"
            ]
          }
        }
      ]
    }
  ],
