  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "DAN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nrọ Nebukadneza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime afọ nke abụọ nke ọchịchị ya, eze Nebukadneza rọrọ nrọ dị iche iche. Nrọ ndị a mere ka obi ya gbasasịa, ụra pụkwara ya nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.1",
            "verseOrgIds": [
              "DAN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze kpọrọ ndị majiki, ndị ha na mmụọ ọjọọ na-ekwu okwu, ndị mgbaasị na ndị ihe banyere ngagharị nke kpakpando doro anya ka ha bịa gwa ya ihe ahụ ọ rọrọ na nrọ. Mgbe ha bịara, guzo nʼihu eze,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.2",
            "verseOrgIds": [
              "DAN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị ha, \"Arọrọ m nrọ nke na-enye m nsogbu nʼobi. Achọrọ m ịma ihe ọ pụtara.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.3",
            "verseOrgIds": [
              "DAN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ahụ na-enyocha kpakpando gwara eze ahụ okwu nʼasụsụ ndị Siria sị, \"Ka gị eze dịrị ndụ ruo mgbe ebighị ebi, Ị ga-agwa ụmụodibo gị nrọ a ị rọrọ, anyị ga-akọwara gị ihe ọ pụtara.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.4",
            "verseOrgIds": [
              "DAN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze zara ndị Kaldịa, \"Nke a bụ ihe m kpebirila: Ọ bụrụ na unu agwaghị m ihe nrọ a na nkọwa ya bụ, aga m eme ka abọkasịa unu, tikpọkwa ụlọ unu, mee ka ha ghọọ mkpọmkpọ ebe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.5",
            "verseOrgIds": [
              "DAN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na unu gwa m ihe ahụ m rọrọ na nrọ ma kọwaakwa ya, aga m enye unu onyinye dị iche iche na ụgwọ ọrụ nsọpụrụ dị ukwuu. Ya mere, gwanụ m nrọ ahụ na nkọwa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.6",
            "verseOrgIds": [
              "DAN.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, ha zaghachiri, \"Ka eze gwa ndị ohu ya ihe ọ rọrọ na nrọ, anyị ga-akọwakwa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.7",
            "verseOrgIds": [
              "DAN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze zaghachiri, \"Ama m na ọ bụ oge ka unu na-achọ inweta nʼihi na unu amatala na ihe a ka m kpebiri ime.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.8",
            "verseOrgIds": [
              "DAN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu agwaghị m nrọ ahụ naanị otu ntaramahụhụ dịịrị unu. Unu agbaala izu ịgwa m okwu ụgha na okwu nduhie na-ele anya na ọnọdụ ga-agbanwe. Ya mere, gwanụ m nrọ ahụ, m ga-amatakwa na unu pụrụ ịkọwara m ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.9",
            "verseOrgIds": [
              "DAN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Kaldịa zara eze, \"Ọ dịghị mmadụ ọbụla nʼelu ụwa a nke nwere ike ime ihe a eze na-achọ. Ọ dịghịkwa eze, nʼagbanyeghị ịdị ukwuu ya na ịdị ike ya, nke jụtụrụla ụdị ihe dị otu a eze na-ajụ nʼaka ndị mgbaasị, ndị na-agba aja ya, ndị ha na mmụọ ọjọọ na-ekwu okwu, na ndị Kaldịa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.10",
            "verseOrgIds": [
              "DAN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a ị chọrọ ka anyị mee bụ ihe na-agaghị ekwe omume. Ọ bụ naanị ndị mmụọ nwere ike ịkọrọ gị ihe ị rọrọ na nrọ. Ndị mmụọ anọkwaghị nʼetiti ndị mmadụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.11",
            "verseOrgIds": [
              "DAN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a mere ka eze jupụta nʼoke iwe na ọnụma, o nyere iwu ka e gbuchaa ndị amamihe niile nke Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.12",
            "verseOrgIds": [
              "DAN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e kwupụtara iwu onye eze ka e gbuo ndị oke amamihe niile, ndị agha chọkwara ebe Daniel na ndị otu ya nọ ka ha gbuo ha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.13",
            "verseOrgIds": [
              "DAN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ariok, onye bụ onyeisi ndị nche eze pụrụ igbu ndị ikom maara ihe na Babilọn, Daniel ji amamihe na ezi uche gwa ya okwu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.14",
            "verseOrgIds": [
              "DAN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ jụrụ onyeozi eze, bụ Ariok, \"Gịnị mere eze ji nye iwu dị ike dị otu a?\" Mgbe ahụ, Ariok kọwaara ihe niile nye Daniel.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.15",
            "verseOrgIds": [
              "DAN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Daniel banyere nʼụlọeze, ịhụ ya. Ọ rịọrọ eze ka o nyetụ ya nwa oge iji kọwaakwara ya ihe nrọ ahụ pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.16",
            "verseOrgIds": [
              "DAN.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Daniel lara nʼụlọ nke ya gaa kọọrọ Hananaya, na Mishael, na Azaraya, ndị enyi ya ihe merenụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.17",
            "verseOrgIds": [
              "DAN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha ka ha rịọọ maka ebere site nʼaka Chineke nke eluigwe banyere ihe nzuzo a, ka a hapụ igbu ya na ndị enyi ya na ndị amamihe fọdụrụ na Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.18",
            "verseOrgIds": [
              "DAN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị, e mere ka Daniel mata ihe omimi ahụ site nʼọhụ. Mgbe ahụ, Daniel toro Chineke nke eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.19",
            "verseOrgIds": [
              "DAN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniel sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:20"
      },
      "items": [
        {
          "text": "\"Otuto dịrị aha Chineke ruo mgbe ebighị ebi;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:20"
      },
      "items": [
        {
          "text": "amamihe na ike dị nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agbanwe oge na mgbe dị iche iche;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "Ọ na-ebuli ndị eze na-akwatụkwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "Ọ na-enye onye maara ihe amamihe,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "ma na-enyekwa onye nwere mmụọ nghọta ihe ọmụma.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-ekpughe ihe dị omimi na ihe zoro ezo;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:22"
      },
      "items": [
        {
          "text": "Ọ maara ihe dị nʼọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:22"
      },
      "items": [
        {
          "text": "ma ìhè binyekwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m ekele gị, na-etokwa gị, Chineke nke nna m ha,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "nʼihi na i nyela m amamihe na ike.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "I meela ka m mata ihe anyị rịọrọ gị,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "i mekwala ka anyị mata nrọ ahụ eze rọrọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daniel Akọwaa nrọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, Daniel jekwuru Ariok, onye ahụ eze nyere iwu igbu ndị ndụmọdụ niile dị na Babilọn, sị ya, \"Egbukwala onye ọbụla nʼime ndị amamihe Babilọn. Kama duru m gaa nʼihu eze nʼihi na ejikeere m ịgwa ya ihe ahụ ọ chọrọ ịmata.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.24",
            "verseOrgIds": [
              "DAN.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ariok mere ngwangwa duru Daniel gaa nʼihu eze, sị ya, \"Achọpụtala m otu onye nʼime ndị Juda a dọtara nʼagha nwere ike ịgwa eze ihe nrọ ya pụtara.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.25",
            "verseOrgIds": [
              "DAN.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ Daniel (onye a na-akpọkwa Belteshaza), \"I nwere ike ịgwa m ihe ahụ m rọrọ na nrọ, na ịkọwara m ihe ọ pụtara?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniel gwara eze, \"O nweghị onye amamihe ọbụla, onye ọbụla ya na mmụọ na-ekwu okwu, onye mgbaasị ọbụla maọbụ onye na-enyocha kpakpando ọbụla pụrụ ịgwa eze ihe omimi a ị chọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.27",
            "verseOrgIds": [
              "DAN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o nwere Chineke nọ nʼeluigwe, onye na-ekpughe ihe omimi niile. O gosila Nebukadneza ihe ga-eme nʼụbọchị ndị dị nʼihu. Nrọ gị na ọhụ niile nke gara nʼuche gị mgbe ị dinara nʼihe ndina gị bụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ị rọrọ na nrọ, gị bụ eze, bụ ihe banyere ihe na-aga imezu nʼoge dị nʼihu. Onye ahụ na-ekpughe ihe nzuzo niile egosikwala gị ihe nke ga-eme.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.29",
            "verseOrgIds": [
              "DAN.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mụ onwe m, ekpugheghị ihe omimi a nye m nʼihi na m karịrị mmadụ ọbụla dị ndụ nʼamamihe, kama ọ bụ ka gị bụ eze mata nkọwa ya ma ghọtakwa ihe gabigara nʼuche gị.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eze, ihe ị hụrụ nʼọhụ bụ nke a. Ị hụrụ mmadụ a kpụrụ akpụ. Mmadụ a a kpụrụ akpụ buru nnọọ ibu. Ọ na-egbukwa nweghenweghe, bụrụkwa ihe na-eyi onye ọbụla lekwasịrị ya anya egwu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.31",
            "verseOrgIds": [
              "DAN.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji ọlaedo a nụchara anụcha kpụọ isi mmadụ ahụ, jiri ọlaọcha kpụọ aka ya na obi ya. E jikwa bronz kpụọ afọ ya na apata ụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.32",
            "verseOrgIds": [
              "DAN.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa igwe ka e ji kpụọ ogwe ụkwụ ya abụọ. Ma akụkụ ụkwụ ya, nke a na-azọ nʼala ka e ji igwe a gwara ya na ụrọ kpụọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.33",
            "verseOrgIds": [
              "DAN.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị na-ele anya, a wapụtara nkume, ma ọ bụghị aka mmadụ ka e ji wapụta ya. Nkume a kụrụ mmadụ ahụ a kpụrụ akpụ nʼukwu nkume na ụrọ ya, kụpịasịa ha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.34",
            "verseOrgIds": [
              "DAN.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, e tijisịrị igwe ahụ na ụrọ ahụ, bronz ahụ na ọlaọcha ahụ nakwa ọlaedo ahụ niile. Ha dịka igbugbo ọka nke na-adị nʼebe a na-azọcha ọka nʼoge okpomọkụ. Ifufe fechapụsịrị ha na-ahapụghị ihe ngosi ọbụla. Ma nkume ahụ dakwasịrị ihe ahụ awuru awu mechara ghọọ ugwu dị ukwuu, nke jupụtara ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eze, nke a bụ nrọ ahụ. Ugbu a ka anyị kọwaara gị ihe nrọ ahụ pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.36",
            "verseOrgIds": [
              "DAN.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onwe gị, eze, bụ eze nke ọtụtụ ndị eze ọzọ nọ nʼokpuru ya, onye Chineke nke eluigwe nyere ike ọchịchị, nʼocheeze niile, na ike na otuto;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.37",
            "verseOrgIds": [
              "DAN.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyefeekwa nʼaka gị ụmụ mmadụ niile na ụmụ anụmanụ bi nʼime ọhịa, na ụmụ nnụnụ nke igwe, e mere ka ị bụrụ eze ihe niile ndị a, gị bụ isi ahụ e ji ọlaedo kpụọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ị chịchara alaeze ọzọ ga-ebili, ma ọ gaghị adị ukwuu dịka nke gị, mgbe nke a gasịrị, alaeze ọzọ bụ nke atọ, nke ga-adị ka bronz ga-ebilikwa, ọ ga-achị ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.39",
            "verseOrgIds": [
              "DAN.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-enwekwa alaeze nke anọ, nke ga-esi ike dịka igwe. Dịka igwe nke na-akụri ihe niile, ọ ga-egwepịa ma kụrikwaa ndị a niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.40",
            "verseOrgIds": [
              "DAN.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ebe ị hụrụ na ọbụ ụkwụ ahụ na mkpịsịụkwụ ya niile na ụfọdụ nʼime ha bụ ụrọ ọkpụ ite na ụfọdụ bụkwa igwe, alaeze nke ekewara ekewa ka ọ ga-abụ, ma ọ ga-esitụ ike dịka igwe nke dị nʼime ya, nʼihi na ị hụrụ igwe ahụ na agwakọtara ya na ụrọ apịtị.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.41",
            "verseOrgIds": [
              "DAN.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka mkpịsịụkwụ ya, nke ụfọdụ nʼime ya bụ igwe, ụfọdụ bụkwa ụrọ, na-egosi na akụkụ ụfọdụ nke alaeze ahụ ga-esi ike ma akụkụ ụfọdụ agaghị esi ike ntiwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.42",
            "verseOrgIds": [
              "DAN.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka otu ahụ ị hụrụ e siri gwakọta igwe na ụrọ ọnụ, otu a ka ọchịchị alaeze ndị a ga-achọ njikọta alaeze na ibe ya, ma nke a agaghị ekwe mee, dịka ọ gaghị ekwe omume bụ ịgwakọta igwe na ụrọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.43",
            "verseOrgIds": [
              "DAN.2.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼoge ahụ, ndị eze ndị a ga-anọ nʼọchịchị, Chineke nke eluigwe ga-eme ka alaeze ọzọ bido. Ọ bụkwa alaeze nke a na-apụghị imebi emebi. O nwekwaghị onye ọbụla pụrụ imeri alaeze ahụ. Ọ ga-ala alaeze ndị ọzọ nʼiyi, mee ka ha bụrụ ihe efu, ma ọ ga-adịrị na-aga nʼihu ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.44",
            "verseOrgIds": [
              "DAN.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka i siri hụ nkume ahụ dị ukwuu e sitere nʼugwu wapụta, nke a na-ejighị aka wapụta were kụrichaa igwe ahụ, bronz ahụ, ụrọ ahụ, ọlaọcha ahụ na ọlaedo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 2:45"
      },
      "items": [
        {
          "text": "\"Chineke dị ukwuu emeela ka eze mara ihe na-aga ime nʼoge dị nʼihu. Nrọ a bụ eziokwu, nkọwa ya kwesikwara ntụkwasị obi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DAN 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze Nebukadneza dara nʼala nʼihu Daniel nye ya nsọpụrụ. O nyekwara iwu ka eweta onyinye na ụda na-esi isi ụtọ were chụnyere ya aja.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.46",
            "verseOrgIds": [
              "DAN.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DAN 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye eze gwakwara Daniel, \"Nʼezie, Chineke gị bụ Chineke kachasị chi niile. Ọ bụ ya na-achị eze niile bi nʼụwa, bụrụkwa Onye na-ekpughepụ ihe omimi niile, nʼihi na lee, i nwere ike ịkọwa ihe omimi nke a.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.47",
            "verseOrgIds": [
              "DAN.2.47"
            ]
          }
        }
      ]
