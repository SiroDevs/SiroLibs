  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "DAN 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daniel nʼọgba ọdụm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị Daraiọs mma ịhọpụta ndịisi dị otu narị na iri abụọ, ndị ga-anọ nʼalaeze ahụ niile dịka ndị nnọchite anya eze.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.1",
            "verseOrgIds": [
              "DAN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O họpụtakwara ndịisi atọ ọzọ dịka ndịisi ha, nke otu onye nʼime ha bụ Daniel. Ndị a bụ ndị ga na-agụkọrọ ha otu ihe si aga, ka ihe ọbụla ghara ifunarị eze.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.2",
            "verseOrgIds": [
              "DAN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị anya, ọ pụtara ihe nye eze na Daniel kwesiri ntụkwasị obi karịa ndịisi na ndị nlekọta ahụ niile. Nʼihi na amamihe ya, na ike ọrụ ya dị ukwuu. Nke a mere ka eze chee echiche kpebie ime ya onyeisi nʼalaeze niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.3",
            "verseOrgIds": [
              "DAN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ndịisi ọkwa ha dị elu na ndịisi ndị ọzọ bidoro chọwa mkpesa ha ga-enye iji megide Daniel nʼihe gbasara ọchịchị. Ma ọ dịghị ihe ebubo ọbụla maọbụ omume ọjọọ ọbụla ha chọpụtara, nʼihi na ọ kwesiri ntụkwasị obi. Ọ dịghịkwa omume ọjọọ maọbụ nke aghụghọ ọbụla a chọpụtara nʼọrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.4",
            "verseOrgIds": [
              "DAN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, ndị ikom a sịrị, \"O nweghị otu anyị ga-esi chọta ihe a ga-eji boo nwoke a bụ Daniel ebubo, karịakwa nʼihe metụtara iwu ofufe Chineke ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.5",
            "verseOrgIds": [
              "DAN.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndịisi ndị a na ndị ozi ndị ahụ kpebiri jekwuru eze ahụ sị ya, \"Eze Daraiọs, dịrịkwa ndụ ruo mgbe niile!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.6",
            "verseOrgIds": [
              "DAN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi alaeze gị niile, ndị ukwu na ndị nta, ndị na-anọchi anya eze na ndị ndụmọdụ na ndị ị tinyere ka ha na-achị zukọtara kpebie na eze kwesiri inye iwu nke ga-ekwu na a chọghị ka onye ọbụla rịọọ ihe ọbụla nʼaka chi maọbụ nʼaka mmadụ ọbụla karịa gị eze, site nʼoge i nyere iwu a tutu iri ụbọchị atọ agafee. Onye ọbụla nupuru isi nʼiwu a ka a ga-atụba nʼolulu ọdụm.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.7",
            "verseOrgIds": [
              "DAN.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị chọkwara ka gị bụ eze kwagide iwu a ma jirikwa aka gị dee aha gị nʼakwụkwọ iwu ahụ. Nʼihi na anyị chọrọ ka ọ bụrụ iwu nke na-agaghị enwe mgbanwe, nke a na-apụghị ịkagbukwa akagbu, dịka iwu ndị Midia na Peshịa si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.8",
            "verseOrgIds": [
              "DAN.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Daraiọs jiri aka ya dee aha ya nʼakwụkwọ iwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.9",
            "verseOrgIds": [
              "DAN.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Daniel maara na iwu a adịla ire, ọ banyere nʼụlọ ya, nʼelu ụlọ elu nke ebe obibi ya, o meghere oghereikuku ya chere ihu na Jerusalem. Nʼebe ahụ ka ọ na-anọ ekpe ekpere na ekele Chineke ya, ugboro atọ nʼụbọchị dịka ọ na-eme na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.10",
            "verseOrgIds": [
              "DAN.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị iro ya gbakọtara hụ na Daniel na-ekpe ekpere na-arịọkwa Chineke arịrịọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.11",
            "verseOrgIds": [
              "DAN.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jekwuru eze sị ya, \"I chetakwara iwu ahụ i nyere, nke sị na onye ọbụla ekwesighị ịrịọ chi ọzọ maọbụ mmadụ arịrịọ ọbụla karịa gị, tutu iri ụbọchị atọ agafee, na onye ọbụla nupuru isi nʼiwu a ka a ga-atụba nʼolulu ọdụm?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 6:12"
      },
      "items": [
        {
          "text": "Eze sịrị, \"Ya bụ iwu ka dịkwa, dịka iwu ndị Midia na Peshịa nke e nweghị ike ịkagbu akagbu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.12",
            "verseOrgIds": [
              "DAN.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha gwara eze, \"Daniel, onye bụ otu nʼime ndị si Juda a dọtara nʼagha adịghị aṅa gị ntị, gị onye a na-asọpụrụ, maọbụ nye iwu ahụ i nyere bụ nke e dere nʼakwụkwọ. Ọ nọkwa na-ekpe ekpere ya ugbo atọ nʼụbọchị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.13",
            "verseOrgIds": [
              "DAN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi jọrọ eze njọ nke ukwuu mgbe ọ nụrụ ihe ndị a. O kpebiri nʼobi ya ime ihe niile ịhụ na Daniel ataghị ahụhụ. Ya mere, ụbọchị ahụ niile, site nʼụtụtụ ruo nʼanyasị, ọ nọ na-eche otu ọ ga-esi mee nke a.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.14",
            "verseOrgIds": [
              "DAN.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ikom ndị a bịakwutere eze sị ya, \"Chetakwa, gị eze, na dịka iwu ndị Midia na Peshịa si dị, ọ dịghị iwu ọbụla eze nyere maọbụ ụkpụrụ nke e mere ka o guzosie ike ga-agbanwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.15",
            "verseOrgIds": [
              "DAN.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, eze nyere iwu, ha kpụpụtara Daniel tụba ya nʼolulu ọdụm. Eze gwara Daniel, \"Ka Chineke gị, onye ahụ ị na-efe mgbe niile, zọpụta gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.16",
            "verseOrgIds": [
              "DAN.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wetara nkume dị ukwuu jiri mechie ọnụ olulu ọdụm ahụ. Eze jikwa mgbaaka akara ya na mgbaaka ndịisi ọzọ kaa akara e ji nyachie ọnụ olulu ahụ. E mere nke a ka ọnọdụ Daniel hapụ ịgbanwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.17",
            "verseOrgIds": [
              "DAN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze lọbatara nʼụlọeze ya, o dinara nʼihe ndina ya buo ọnụ, onweghịkwa nri ebutere ya. Nʼabalị ahụ, o nweghị ike rahụ ụra.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.18",
            "verseOrgIds": [
              "DAN.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼìhè mbụ nke ụtụtụ, mgbe chị na-abọ, eze biliri mee ngwangwa, gaa nʼolulu ọdụm ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.19",
            "verseOrgIds": [
              "DAN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ bịaruru nso olulu ahụ, ọ kpọrọ Daniel oku nʼolu obi ntiwa sị, \"Daniel, ohu Chineke dị ndụ, Chineke gị ahụ ị na-efe mgbe niile, o nwekwara ike ịzọpụta gị nʼaka ọdụm?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.20",
            "verseOrgIds": [
              "DAN.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Daniel sịrị eze, \"Eze, dịrị ndụ ruo mgbe niile!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.21",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke m zitere mmụọ ozi ka o mechie ọnụ ọdụm ndị a, ka ha si otu a hapụ inwe ike ịmetụ m aka, nʼihi na Chineke maara na aka m dị ọcha. Ọ makwaara na o nweghị ihe ọbụla m mere mejọọ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọṅụ juru eze ahụ obi! O nyere iwu ka e si nʼime olulu ahụ dọpụta Daniel. Mgbe a kpọpụtara Daniel, o nweghị ihe ọbụla a hụrụ mere ya nʼahụ, nʼihi na ọ tụkwasịrị Chineke ya obi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.23",
            "verseOrgIds": [
              "DAN.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze nyere iwu ka e jide ndị ahụ boro Daniel ebubo. O nyere iwu ka a tụnye ha nʼolulu ọdụm ahụ, ha na ndị nwunye ha na ụmụ ha. Ọdụm ndị ahụ dị nʼime olulu ahụ jidere ndị ahụ dọrie ma ọkpụkpụ ha tupu ha adaruo ala.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.24",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, eze Daraiọs depụtara ozi a nʼakwụkwọ nye iwu ka a gụọra ya mmadụ niile, mba niile na asụsụ niile dị iche iche nʼelu ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 6:25"
      },
      "items": [
        {
          "text": "\"Ka ọ dịrị unu na mma.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ana m enye iwu na mmadụ niile nọ nʼalaeze m kwesiri ịtụ egwu na ịma jijiji nʼihu Chineke nke Daniel.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "\"Nʼihi na ọ bụ Chineke dị ndụ,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "nke na-adịgide ebighị ebi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "E nweghị ike ịla alaeze ya nʼiyi,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:26"
      },
      "items": [
        {
          "text": "ọ bụkwa onye ọchịchị ya na-enweghị ọgwụgwụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agbapụta ndị ya, na-azọpụtakwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "Ọ na-eme ihe ịrịbama na-arụkwa ọrụ ebube",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "nʼeluigwe na nʼụwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "Nʼihi na ọ gbapụtara Daniel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 6:27"
      },
      "items": [
        {
          "text": "site nʼike ọdụm.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ihe gaara Daniel nke ọma nʼoge niile Daraiọs bụ eze, na nʼoge Sairọs onye Peshịa chịkwara dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.28",
            "verseOrgIds": [
              "DAN.6.29"
            ]
          }
        }
      ]
    }
  ],
