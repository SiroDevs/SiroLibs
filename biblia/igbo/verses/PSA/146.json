                "verseId": "PSA.146.6",
                "verseOrgIds": [
                  "PSA.146.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye ikwesi ntụkwasị obi ya na-adịgide ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
      ]
    },
    {
