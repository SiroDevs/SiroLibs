                "verseOrgIds": [
                  "PSA.146.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ogologo ndụ m niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.2",
            "verseOrgIds": [
              "PSA.146.2"
            ]
          }
        }
