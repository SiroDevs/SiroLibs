      "attrs": {
        "style": "q2",
        "vid": "PSA 146:6"
      },
      "items": [
        {
          "text": "na osimiri, na ihe niile dị nʼime ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.6",
            "verseOrgIds": [
              "PSA.146.6"
            ]
          }
        }
