          "text": "Ọ na-ekpe ikpe ziri ezi nye ndị a na-akpagbu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.146.7",
            "verseOrgIds": [
              "PSA.146.7"
            ]
          }
        }
