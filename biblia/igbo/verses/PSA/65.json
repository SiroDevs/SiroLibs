{
  "id": "PSA.65",
  "number": "65",
  "bookId": "PSA",
  "reference": "Abụ Ọma 65",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "65",
        "style": "c",
        "sid": "PSA 65"
      },
      "items": [
        {
          "text": "65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma dịrị onyeisi abụ. Abụ Ọma Devid. Otu Abụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdị mma na ịdị ike nke Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kwesiri otuto, O Chineke, nʼime Zayọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:1"
      },
      "items": [
        {
          "text": "ọ bụ gị ka anyị ga-emezuru nkwa anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.1",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O gị onye na-anụ ekpere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:2"
      },
      "items": [
        {
          "text": "ọ bụ gị ka mmadụ niile ga-abịakwute,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmehie na-anyịgbu anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:3"
      },
      "items": [
        {
          "text": "ị gbaghara anyị njehie anyị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngọzị na-adịrị ndị ahụ ị họpụtara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "ka ha bịaruo nso, ibi nʼebe obibi gị!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "E ji ọtụtụ ezi ihe nke ụlọ gị, nke ụlọnsọ ukwuu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "mee ka afọ ju anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, Onye nzọpụta anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "i ji ọrụ ezi omume dị oke egwu na-aza anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "ị bụ olileanya ndị niile bi na nsọtụ nke ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "na osimiri niile dị ebe dị anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye ji ike ya kpụọ ugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "ebe i yikwasịrị onwe gị ike dịka ngwa agha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye mere ka ụda olu oke osimiri niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "na ụda olu ebili mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "na ọgbaaghara mba niile deere duu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụwa niile jupụtara nʼịtụnanya nʼihi ọrụ ebube gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "nʼebe chi na-abọ, ebe anyanwụ na-ada,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "ka ị na-akpọlite abụ ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-elekọta ala na-agba ya mmiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "ị na-eme ka ọ bụrụ ala dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "Isi iyi Chineke adịghị ata ata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "nʼihi inye ndị mmadụ mkpụrụ ubi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ otu a ka ị chọrọ ka ọ dịrị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-eme ka mmiri jupụta nʼala a kọrọ akọ mee ka elu aja a kọrọ akọ dị larịị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "ị na-eji mmiri ozuzo eme ka ọ dị nro, na-agọzikwa ihe ndị akụnyere na ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-eji owuwe ihe ubi bara ụba kpukwasị afọ ọbụla dịka okpueze,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "ụgbọ na-ebu ihe owuwe ubi na-ejubiga oke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ebe ahịhịa na-epu nʼọzara na-ejupụta nʼahịhịa ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:12"
      },
      "items": [
        {
          "text": "e yikwasịrị ugwu niile obi ụtọ dịka uwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E were igwe anụ ụlọ kpuchie nʼelu ala niile ebe ahịhịa dị ndụ puru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:13"
      },
      "items": [
        {
          "text": "ọka kpuchikwara ndagwurugwu niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:13"
      },
      "items": [
        {
          "text": "ha na-eti mkpu ọṅụ na-abụkwa abụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    }
  ],
