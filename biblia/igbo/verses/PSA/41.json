  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "PSA 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere onye ọrịa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a gọziri agọzi ka ha bụ ndị nwere uche na-eleta ndị ogbenye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.1",
                "verseOrgIds": [
                  "PSA.41.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na-azọpụta ha nʼoge nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.2",
                "verseOrgIds": [
                  "PSA.41.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-echebe ha, debekwa ha ndụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "ọ ga-eme ka ihe na-agara ha nke ọma nʼala ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "ọ gaghị arara ha nye nʼọchịchọ ndị iro ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.3",
                "verseOrgIds": [
                  "PSA.41.4"
                ]
              }
            }
          ]
        },
        {
          "text": "na-elekọta ha mgbe ahụ na-esighị ha ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:3"
      },
      "items": [
        {
          "text": "meekwa ka ahụ dị ha mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwuru m sị, \"O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.4",
                "verseOrgIds": [
                  "PSA.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", meere m ebere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:4"
      },
      "items": [
        {
          "text": "gwọọ m, nʼihi na emehiela m megide gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị iro m na-esite nʼiro ha ekwu okwu megide m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:5"
      },
      "items": [
        {
          "text": "na-asị, \"Olee mgbe ọ ga-anwụ ka aha ya laa nʼiyi?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe otu nʼime ha bịara ịhụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "ọ na-ekwu okwu ụgha, ma obi ya na-achịkọta ihe nkwulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "mgbe ahụ ọ na-apụ, ga kọsaa ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile kpọrọ m asị na-agbarịta izu megide m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:7"
      },
      "items": [
        {
          "text": "ha na-echekwa echiche ọjọọ banyere m, na-asịrịta onwe ha:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọrịa ọjọọ adakwasịla ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:8"
      },
      "items": [
        {
          "text": "ọ gaghị esite na ihe ndina ya bilie ọtọ ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị ezigbo enyi m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "onye m tụkwasịrị obi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "onye mụ na ya na-eso erikọ nri m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "ebiliela imegide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.10",
                "verseOrgIds": [
                  "PSA.41.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", meere m ebere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:10"
      },
      "items": [
        {
          "text": "mee ka ahụ sie m ike ọzọ, ka m nwee ike kwụghachi ha ụgwọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaara m na ihe banyere m na-atọ gị ụtọ nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:11"
      },
      "items": [
        {
          "text": "nʼihi na i kwebeghị ka ndị iro m nwee mmeri nʼebe m nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ikwesi ntụkwasị obi m, ị na-akwagide m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:12"
      },
      "items": [
        {
          "text": "mee ka m nọrọ nʼihu gị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otuto dịrị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.13",
                "verseOrgIds": [
                  "PSA.41.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nke Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:13"
      },
      "items": [
        {
          "text": "site nʼebighị ebi ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "PSA 41:13"
      },
