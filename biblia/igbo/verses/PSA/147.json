      "items": [
        {
          "text": "147",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 147",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyenwe anyị dike, na onye amara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 147:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toonu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.1",
                "verseOrgIds": [
                  "PSA.147.1"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 147:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 147:1"
      },
      "items": [
        {
          "text": "Ọ bụ ihe dị mma ịbụku Chineke anyị abụ otuto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:1"
      },
      "items": [
        {
          "text": "Ọ bụ ihe na-eweta mmasị, bụrụkwa ihe ziri ezi ito ya!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 147:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.2",
                "verseOrgIds": [
                  "PSA.147.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ewu Jerusalem:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:2"
      },
      "items": [
        {
          "text": "ọ na-akpọghachita ụmụ Izrel ndị a dọọrọ nʼagha gaa nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 147:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agwọ ndị niile obi ha tiwara etiwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:3"
      },
      "items": [
        {
          "text": "na-ekechikọtakwa ebe niile ha merụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 147:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya na-ekpebi ọnụọgụgụ kpakpando niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:4"
      },
      "items": [
        {
          "text": "na-akpọkwa ha nʼotu na otu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 147:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyenwe anyị dị ukwuu, ike ya dịkwa ukwuu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:5"
      },
      "items": [
        {
          "text": "nghọta ya enweghị nsọtụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 147:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.6",
                "verseOrgIds": [
                  "PSA.147.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na-agba ndị dị umeala nʼobi ume",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:6"
      },
      "items": [
        {
          "text": "ma ọ na-atụda ndị ajọ omume nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 147:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jirinụ ekele bụkuo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.7",
                "verseOrgIds": [
                  "PSA.147.7"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:7"
      },
      "items": [
        {
          "text": "jirinụ ụbọ akwara kpọọrọ Chineke anyị egwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 147:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eji igwe ojii na-ekpuchi mbara eluigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:8"
      },
      "items": [
        {
          "text": "ọ na-ewetara elu ụwa mmiri ozuzo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:8"
      },
      "items": [
        {
          "text": "na-eme ka ahịhịa puo nʼelu ugwu niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 147:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-enye ehi niile nri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:9"
      },
      "items": [
        {
          "text": "na-enyekwa ụmụ ugolọma nri mgbe ha na-ebeku ya akwa nʼihi nri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 147:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmasị ya adịghị nʼike nke ịnyịnya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:10"
      },
      "items": [
        {
          "text": "maọbụ nʼike ụkwụ nke mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 147:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.11",
                "verseOrgIds": [
                  "PSA.147.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na-enwe mmasị nʼebe ndị na-atụ egwu ya nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:11"
      },
      "items": [
        {
          "text": "ndị olileanya ha dị na ịhụnanya ya nke na-adịghị agharịpụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 147:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Jerusalem, jaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.147.12",
                "verseOrgIds": [
                  "PSA.147.12"
                ]
              }
            }
          ]
        },
        {
          "text": "mma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:12"
      },
      "items": [
        {
          "text": "o Zayọn, too Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 147:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o wusiela mkpọrọ ọnụ ụzọ ama gị niile ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:13"
      },
      "items": [
        {
          "text": "na-agọzikwa ndị niile bi nʼime gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 147:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eme ka oke ala gị nwee udo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
              "PSA.147.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:14"
      },
      "items": [
        {
          "text": "jirikwa ọka wiiti kachasị mma nyejuo gị afọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
