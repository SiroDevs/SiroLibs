      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:17"
      },
      "items": [
        {
          "text": "O Chineke, ị naghị elefu anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.19"
            ]
