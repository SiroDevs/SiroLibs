      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 51:16"
      },
      "items": [
        {
          "text": "Ị naghị enwe mmasị nʼaja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.18"
            ]
