      "attrs": {
        "style": "q2",
        "vid": "PSA 51:17"
      },
      "items": [
        {
          "text": "nʼobi tiwara etiwa na nke nwere ezi nchegharị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.17",
            "verseOrgIds": [
              "PSA.51.19"
            ]
          }
        }
      ]
