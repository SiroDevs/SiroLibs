              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị naghị enwe mmasị nʼaja, ma ọ bụghị ya, agaara m eweta ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.51.16",
            "verseOrgIds": [
              "PSA.51.18"
            ]
          }
        }
      ]
    },
    {
