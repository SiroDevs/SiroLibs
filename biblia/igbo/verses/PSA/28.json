    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:6"
      },
      "items": [
        {
          "text": "nʼihi na o gere ntị nʼarịrịọ m rịọrọ ya ka o meere m ebere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.6",
            "verseOrgIds": [
              "PSA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.28.7",
                "verseOrgIds": [
                  "PSA.28.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ike m na ọta m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "ana m atụkwasị ya obi m, si otu a bụrụ onye a na-enyere aka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "Obi m na-awuli elu nʼihi ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:7"
      },
      "items": [
        {
          "text": "aga m ejikwa abụ m na-eto ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.7",
            "verseOrgIds": [
              "PSA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.28.8",
                "verseOrgIds": [
                  "PSA.28.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ike nke ndị ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:8"
      },
      "items": [
        {
          "text": "ebe mgbaba e wusiri ike nke nzọpụta dịịrị onye ya etere mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zọpụta ndị gị, gọzikwaa ihe nketa gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:9"
      },
      "items": [
        {
          "text": "buuru ha onye ọzụzụ atụrụ, na-ekukwa ha ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    }
