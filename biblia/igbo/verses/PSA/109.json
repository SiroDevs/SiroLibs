      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:20"
      },
      "items": [
        {
          "text": "bụ ndị ahụ niile na-ekwu okwu ọjọọ megide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.20",
            "verseOrgIds": [
              "PSA.109.20"
            ]
          }
        }
      ]
    },
