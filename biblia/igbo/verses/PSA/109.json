      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:19"
      },
      "items": [
        {
          "text": "dịka belịt e kegidere ya gburugburu ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.19",
            "verseOrgIds": [
              "PSA.109.19"
            ]
          }
        }
      ]
