      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:17"
      },
      "items": [
        {
          "text": "ka ọbụbụ ọnụ bịakwasị ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.17",
            "verseOrgIds": [
              "PSA.109.17"
            ]
          }
        }
