          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ dịịrị ya ka uwe mwụda nke e kere ya gburugburu dịka akwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.19",
            "verseOrgIds": [
              "PSA.109.19"
            ]
          }
        }
      ]
