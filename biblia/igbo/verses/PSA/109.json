          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aghọọla m onye e ji eme ihe ọchị nye ndị na-ebo m ebubo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.25",
            "verseOrgIds": [
              "PSA.109.25"
            ]
          }
        }
