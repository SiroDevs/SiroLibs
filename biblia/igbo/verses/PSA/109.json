        "vid": "PSA 109:18"
      },
      "items": [
        {
          "text": "bakwaa nʼime ọkpụkpụ ya dịka mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.18",
            "verseOrgIds": [
              "PSA.109.18"
            ]
          }
        }
      ]
    },
    {
