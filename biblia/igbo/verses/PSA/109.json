          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ike agwụla ikpere m, nʼihi ibu ọnụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.24",
            "verseOrgIds": [
              "PSA.109.24"
            ]
          }
        }
