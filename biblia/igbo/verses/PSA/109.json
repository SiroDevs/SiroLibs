      "attrs": {
        "style": "q2",
        "vid": "PSA 109:25"
      },
      "items": [
        {
          "text": "mgbe ha hụrụ m, ha na-efufe isi ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.25",
            "verseOrgIds": [
              "PSA.109.25"
            ]
          }
        }
