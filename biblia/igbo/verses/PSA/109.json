      "attrs": {
        "style": "q2",
        "vid": "PSA 109:18"
      },
      "items": [
        {
          "text": "ọ bara nʼime ahụ ya dịka mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.18",
            "verseOrgIds": [
              "PSA.109.18"
            ]
          }
        }
      ]
