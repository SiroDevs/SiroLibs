              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ hụrụ ịbụ ndị ọzọ ọnụ nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.17",
            "verseOrgIds": [
