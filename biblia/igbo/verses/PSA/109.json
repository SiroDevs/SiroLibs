      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:23"
      },
      "items": [
        {
          "text": "adịkwa m ka igurube nke onye m bekwasịrị nʼahụ ya na-efechapụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.23",
            "verseOrgIds": [
              "PSA.109.23"
            ]
          }
        }
      ]
    },
