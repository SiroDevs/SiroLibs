      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:21"
      },
      "items": [
        {
          "text": "nyere m aka nʼihi aha gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.21",
            "verseOrgIds": [
              "PSA.109.21"
            ]
          }
