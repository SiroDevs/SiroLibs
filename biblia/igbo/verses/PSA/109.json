      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:22"
      },
      "items": [
        {
          "text": "obi m tiwakwara etiwa nʼime m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.22",
            "verseOrgIds": [
              "PSA.109.22"
            ]
          }
        }
      ]
    },
    {
