      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:24"
      },
      "items": [
        {
          "text": "ataakwala m ahụ, bụrụ naanị ọkpụkpụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.24",
            "verseOrgIds": [
              "PSA.109.24"
            ]
          }
        }
      ]
    },
