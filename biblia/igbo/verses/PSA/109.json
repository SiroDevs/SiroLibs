                "verseId": "PSA.109.20",
                "verseOrgIds": [
                  "PSA.109.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", mee ka nke a bụrụ ụdị ụgwọ ọrụ ndị iro m ga-anata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.20",
            "verseOrgIds": [
              "PSA.109.20"
            ]
          }
        }
      ]
