              "attrs": {
                "verseId": "PSA.109.26",
                "verseOrgIds": [
                  "PSA.109.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.26",
            "verseOrgIds": [
              "PSA.109.26"
            ]
          }
        }
