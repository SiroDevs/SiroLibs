  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "109",
        "style": "c",
        "sid": "PSA 109"
      },
      "items": [
        {
          "text": "109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi Abụ. Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ntamu nʼoge nsogbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 109:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, onye m na-eto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:1"
      },
      "items": [
        {
          "text": "anọgidekwala na-agba nkịtị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 109:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ndị ajọ omume na ndị aghụghọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "emegheela ọnụ ha megide m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "ha aghaala ụgha megide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 109:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-eji okwu ịkpọ asị gbaa m gburugburu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:3"
      },
      "items": [
        {
          "text": "na-ebuso m agha nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 109:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnọdụ ịhụnanya m hụrụ ha, ha na-ebo m ebubo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:4"
      },
      "items": [
        {
          "text": "ma abụ m nwoke onye ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 109:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji ihe ọjọọ na-akwụ m ụgwọ ihe ọma m mere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:5"
      },
      "items": [
        {
          "text": "ịkpọ asị nʼọnọdụ ịhụnanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 109:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Họpụta otu onye ajọ omume ka o guzogide ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:6"
      },
      "items": [
        {
          "text": "ka onye na-ebo ebubo ụgha guzokwa nʼaka nri ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 109:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a ga-ekpe ya ikpe, ka ọ bụrụ onye ikpe mara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:7"
      },
      "items": [
        {
          "text": "ka ekpere ya maa ya ikpe ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 109:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ụbọchị ndụ ya dị ole na ole,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:8"
      },
      "items": [
        {
          "text": "ka onye ọzọ nara ya ọkwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 109:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ụmụ ya ghọọ ndị na-enweghị nna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:9"
      },
      "items": [
        {
          "text": "ka nwunye ya bụrụ nwanyị na-enweghị di.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 109:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ụmụ ya ghọọ ndị arịrịọ na-enweghị ebe obibi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:10"
      },
      "items": [
        {
          "text": "ndị e si na mkpọmkpọ ebe ha bi chụpụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 109:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ndị o ji ụgwọ kwakọrọ ihe niile o nwere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:11"
      },
      "items": [
        {
          "text": "ka ndị ọbịa baa bukọrọ ihe niile ọ rụpụtaara onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 109:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye ọbụla ghara igosi ya obiọma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:12"
      },
      "items": [
        {
          "text": "ka onye ọbụla gharakwa imere ụmụ ya ndị ọ hapụrụ ebere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 109:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ka ụmụ ụmụ ya niile nwụsịa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:13"
      },
      "items": [
        {
          "text": "ka a ehichapụkwa aha ha nʼọgbọ nke na-abịa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 109:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.14",
                "verseOrgIds": [
                  "PSA.109.14"
                ]
              }
            }
          ]
        },
        {
          "text": "chetakwa mmehie niile nke nna nna ya ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:14"
      },
      "items": [
        {
          "text": "ka Onyenwe anyị hapụkwa ịgbaghara mmehie nne ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 109:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.109.15",
                "verseOrgIds": [
                  "PSA.109.15"
                ]
              }
            }
          ]
        },
        {
          "text": "na-echeta mmehie ha oge niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:15"
      },
      "items": [
        {
          "text": "ma ka o mee ka ha bụrụ ndị a ga-echefu echefu nʼọgbọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
              "PSA.109.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 109:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ dịghị mgbe o chere echiche banyere imere onye ọzọ obi ebere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:16"
      },
      "items": [
        {
          "text": "ọ kpagburu ndị ogbenye, ndị nọ na mkpa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.16",
            "verseOrgIds": [
              "PSA.109.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
