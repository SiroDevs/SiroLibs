      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:28"
      },
      "items": [
        {
          "text": "ma ohu gị ga-aṅụrị ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.28",
            "verseOrgIds": [
              "PSA.109.28"
            ]
          }
        }
      ]
    },
