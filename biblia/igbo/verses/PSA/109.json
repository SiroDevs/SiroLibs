          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na abụ m ogbenye na onye nọ na mkpa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.22",
            "verseOrgIds": [
              "PSA.109.22"
            ]
          }
        }
