      "attrs": {
        "style": "q2",
        "vid": "PSA 109:29"
      },
      "items": [
        {
          "text": "werekwa ihere kee ha gburugburu dịka uwe mwụda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.29",
            "verseOrgIds": [
              "PSA.109.29"
            ]
          }
        }
      ]
    },
