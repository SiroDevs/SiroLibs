      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:28"
      },
      "items": [
        {
          "text": "mgbe ha ga-abịa ọgụ, a ga-eme ha ihe ihere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.28",
            "verseOrgIds": [
              "PSA.109.28"
            ]
          }
        }
      ]
    },
