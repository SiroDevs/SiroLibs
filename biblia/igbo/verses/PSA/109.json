          "text": "site nʼịdị mma nke ịhụnanya gị, napụta m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.21",
            "verseOrgIds": [
              "PSA.109.21"
            ]
          }
        }
      ]
    },
