          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E tidala anyị nʼala, nʼuzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.25",
            "verseOrgIds": [
              "PSA.44.26"
            ]
          }
        }
