          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, Onyenwe m teta! Gịnị mere i ji arahụ ụra?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.23",
            "verseOrgIds": [
              "PSA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:23"
      },
      "items": [
        {
          "text": "Kpọtee onwe gị! Ajụkwala anyị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.23",
            "verseOrgIds": [
              "PSA.44.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
