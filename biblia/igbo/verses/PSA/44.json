      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:24"
      },
      "items": [
        {
          "text": "ma chefuo mmegbu na ịta ahụhụ anyị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.24",
            "verseOrgIds": [
              "PSA.44.25"
            ]
          }
        }
      ]
    },
