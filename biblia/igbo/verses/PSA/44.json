      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:25"
      },
      "items": [
        {
          "text": "ahụ anyị rapara nʼaja",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.25",
            "verseOrgIds": [
              "PSA.44.26"
            ]
          }
        }
      ]
    },
