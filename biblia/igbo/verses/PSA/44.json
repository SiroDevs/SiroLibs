          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji ezopụ ihu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.24",
            "verseOrgIds": [
              "PSA.44.25"
            ]
          }
        }
      ]
    },
