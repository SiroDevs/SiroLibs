          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilie ma nyere anyị aka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.26",
            "verseOrgIds": [
              "PSA.44.27"
            ]
          }
        }
