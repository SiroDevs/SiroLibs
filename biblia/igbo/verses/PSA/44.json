      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:21"
      },
      "items": [
        {
          "text": "ebe ọ maara ihe nzuzo niile dị nʼobi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.21",
            "verseOrgIds": [
              "PSA.44.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼihi gị ka anyị na ọnwụ ji agba mgba, ogologo ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:22"
      },
      "items": [
        {
          "text": "A na-ele anyị anya dịka atụrụ a gaje igbu egbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
            ]
          }
        }
      ]
    },
