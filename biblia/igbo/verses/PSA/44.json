      "attrs": {
        "style": "q2",
        "vid": "PSA 44:26"
      },
      "items": [
        {
          "text": "gbapụta anyị maka ịhụnanya gị nke na-adịghị agwụ agwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.26",
            "verseOrgIds": [
              "PSA.44.27"
