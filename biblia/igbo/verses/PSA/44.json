      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:20"
      },
      "items": [
        {
          "text": "maọbụ na anyị gbasaara chi mba ọzọ aka anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
          }
        }
      ]
    },
