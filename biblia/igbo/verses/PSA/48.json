  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "PSA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Otu Abụ. Abụ Ọma nke ụmụ Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ nke Zayọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.1",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu, bụrụkwa onye kwesiri ịnata otuto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:1"
      },
      "items": [
        {
          "text": "nʼime obodo Chineke anyị, nʼugwu nsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ mara mma nʼịdị elu ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "bụkwa ọṅụ elu ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "Ugwu Zayọn, obodo eze ahụ dị ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:2"
      },
      "items": [
        {
          "text": "dịka ebe kachasị elu nke Zafọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke nọ nʼime ebe ya e wusiri ike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:3"
      },
      "items": [
        {
          "text": "o gosila onwe ya dịka ebe mgbaba ha e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị eze jikọtara ndị agha ha ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:4"
      },
      "items": [
        {
          "text": "mgbe ha bịakọtara nso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihe ha hụrụ juru ha anya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:5"
      },
      "items": [
        {
          "text": "nʼihi oke egwu, ha gbara ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụ ọma jijiji bidoro ha nʼebe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:6"
      },
      "items": [
        {
          "text": "ihe mgbu ha dịka nke nwanyị na-achọ ịmụ nwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị lara ha nʼiyi dịka oke ifufe si nʼọwụwa anyanwụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:7"
      },
      "items": [
        {
          "text": "si ala ụgbọ mmiri ukwuu nke Tashish nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka anyị nụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "otu a ka anyị hụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "nʼime obodo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.8",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "nʼime obodo Chineke anyị:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "Chineke na-eme ka o guzosie ike",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:8"
      },
      "items": [
        {
          "text": "ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.8",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, nʼime ụlọnsọ ukwuu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:9"
      },
      "items": [
        {
          "text": "ka anyị nọ na-atụgharị uche nʼịhụnanya gị nke na-enweghị ọgwụgwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, dịka aha gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:10"
      },
      "items": [
        {
          "text": "otuto gị na-eru na nsọtụ ụwa niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:10"
      },
      "items": [
        {
          "text": "aka nri gị jupụtara nʼezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugwu Zayọn na-aṅụrị ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:11"
      },
      "items": [
        {
          "text": "obodo nta niile nke Juda nwere obi ụtọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:11"
      },
      "items": [
        {
          "text": "nʼihi ikpe gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaanụ Zayọn gburugburu, Jegharịa ya gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:12"
      },
      "items": [
        {
          "text": "gụọkwanụ ụlọ elu ya niile ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezienụ mgbidi ya niile anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 48:13"
      },
      "items": [
        {
          "text": "nyochakwaanụ ebe ya niile e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 48:13"
      },
