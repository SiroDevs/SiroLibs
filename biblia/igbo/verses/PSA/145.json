    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 145",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma otuto, nke Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdị mma nke Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 145:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ebuli gị elu, Chineke m onye bụ eze;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "aga m eto aha gị, site nʼebighị ebi ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 145:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị niile ka m ga-eto gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:2"
      },
      "items": [
        {
          "text": "jaakwa aha gị mma site nʼebighị ebi ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 145:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.3",
                "verseOrgIds": [
                  "PSA.145.3"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu, bụrụkwa onye kwesiri ịnata otuto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:3"
      },
      "items": [
        {
          "text": "ịdị ukwuu ya karịrị ihe onye ọbụla pụrụ ịghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 145:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ọgbọ ga-eto ọrụ gị niile nʼihu ọgbọ ọzọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:4"
      },
      "items": [
        {
          "text": "ha ga-ekwupụta maka ọrụ ukwuu gị niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 145:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ekwupụta ihe banyere ịdị ebube nke ịma mma gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:5"
      },
      "items": [
        {
          "text": "aga m atụgharịkwa uche nʼọrụ ebube gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 145:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ekwupụta ihe banyere ike nke ọrụ ịtụnanya gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:6"
      },
      "items": [
        {
          "text": "aga m ekwusakwa ọrụ ukwuu gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 145:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-eme mmemme nʼihi ịdị mma gị dị ukwuu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:7"
      },
      "items": [
        {
          "text": "jirikwa ọṅụ bụọ abụ banyere ezi omume gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 145:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.8",
                "verseOrgIds": [
                  "PSA.145.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na-eme amara nweekwa obi ọmịiko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:8"
      },
      "items": [
        {
          "text": "ọ dịghị ewe iwe ọsịịsọ, ọ bara ụba nʼịhụnanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.8",
            "verseOrgIds": [
              "PSA.145.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 145:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.9",
                "verseOrgIds": [
                  "PSA.145.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dị mma nʼebe mmadụ niile dị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:9"
      },
      "items": [
        {
          "text": "o nwere ọmịiko nʼebe ihe niile o kere eke dị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.9",
            "verseOrgIds": [
              "PSA.145.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 145:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.10",
                "verseOrgIds": [
                  "PSA.145.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ihe niile i kere eke ga-eto gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:10"
      },
      "items": [
        {
          "text": "ndị nsọ gị na-aja gị mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.10",
            "verseOrgIds": [
              "PSA.145.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 145:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ekwupụta banyere ebube nke alaeze gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:11"
      },
      "items": [
        {
          "text": "Kwupụtakwa maka ịdị ike gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.11",
            "verseOrgIds": [
              "PSA.145.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 145:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka mmadụ niile mata ihe banyere ọrụ ukwuu gị niile dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:12"
      },
      "items": [
        {
          "text": "na ebube nke ịdị mma alaeze gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.12",
            "verseOrgIds": [
              "PSA.145.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 145:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alaeze gị bụ alaeze na-adịgide ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "ọchịchị gị na-adịgidekwa site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 145:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.13",
                "verseOrgIds": [
                  "PSA.145.13"
                ]
              }
            }
          ]
        },
        {
          "text": "na-emezu nkwa ya niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:13"
      },
      "items": [
        {
          "text": "na-ahụkwa ihe niile o kere eke nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.13",
            "verseOrgIds": [
              "PSA.145.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 145:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.145.14",
                "verseOrgIds": [
                  "PSA.145.14"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekulite ndị niile dara ada",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:14"
      },
      "items": [
        {
          "text": "na-akwagide ndị niile dara mba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.14",
            "verseOrgIds": [
              "PSA.145.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
