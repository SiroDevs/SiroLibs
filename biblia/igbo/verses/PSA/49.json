  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "PSA 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma dịrị onyeisi abụ. Abụ ụmụ Kora. Abụ Ọma.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzuzu ndị na-atụkwasị obi nʼakụnụba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nụrụnụ nke a, unu mmadụ niile!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:1"
      },
      "items": [
        {
          "text": "Geenụ ntị, unu ndị niile bi nʼụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ndị dị ala ma ndị dị elu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:2"
      },
      "items": [
        {
          "text": "ma onye ọgaranya ma onye ogbenye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ekwu okwu amamihe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:3"
      },
      "items": [
        {
          "text": "ihe sị nʼobi m ga-enye nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m aṅa ntị nye ilu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:4"
      },
      "items": [
        {
          "text": "aga m e ji ụbọ akwara kọwaa ilu m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi gịnị ka m ga-eji tụọ egwu mgbe ụbọchị ọjọọ bịara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:5"
      },
      "items": [
        {
          "text": "mgbe ndị aghụghọ ọjọọ gbara m gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị na-atụkwasị obi nʼakụnụba ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:6"
      },
      "items": [
        {
          "text": "ma na-anyakwa isi nʼihi oke ụba ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị onye pụrụ ịgbapụta ndụ onye ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "maọbụ nye Chineke ụgwọ e ji agbara onye ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na ụgwọ e ji agbara ndụ dị oke ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:8"
      },
      "items": [
        {
          "text": "o nweghị ụgwọ a ga-akwụ nke ga-ezu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke ga-eme ka mmadụ dịrị ndụ ruo ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:9"
      },
      "items": [
        {
          "text": "ma hapụ ịnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mmadụ niile na-ahụ na ndị amamihe na-anwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "ndị nzuzu na ndị na-enweghị uche na-anwụkwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "si otu a hapụrụ ndị ọzọ akụnụba ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ili ha na-aghọ ụlọ ha ruo ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "ebe obibi ha ruo ọgbọ niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "nʼagbanyeghị na ha gụrụ ọtụtụ ala aha ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmadụ, nʼagbanyeghị akụnụba ya, aghaghị ịnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:12"
      },
      "items": [
        {
          "text": "dịka anụ ọhịa, ọ ga-anwụkwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe na-adakwasị ndị na-atụkwasị obi nʼonwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "na ndị na-eso ụzọ ha, ndị na-akwado okwu ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.49.13",
                "verseOrgIds": [
                  "PSA.49.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka atụrụ, ọ bụ ala mmụọ ka a kwadooro ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "ọnwụ ga-abụ onye na-azụ ha dịka atụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "ma ndị na-eme ihe ziri ezi ga-emeri ha nʼụtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "Ozu ha ga-erekasị nʼime ili",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "nʼebe dị anya site nʼụlọeze ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke ga-agbapụta ndụ m site nʼili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:15"
      },
      "items": [
        {
          "text": "nʼezie, ọ ga-akpọrọ m nye onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
