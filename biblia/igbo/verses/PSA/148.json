          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.148.5",
                "verseOrgIds": [
                  "PSA.148.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:5"
      },
      "items": [
        {
          "text": "nʼihi na ha niile malitere ịdị site nʼokwu ọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
