            "number": "2",
            "style": "v",
            "sid": "PSA 148:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toonu ya, ndị mmụọ ozi ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:2"
      },
      "items": [
        {
          "text": "toonu ya, unu usuu ndị agha ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
