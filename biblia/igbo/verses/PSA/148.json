      "attrs": {
        "style": "q2",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "ebube ya dị ukwuu karịa eluigwe na ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
      ]
    },
