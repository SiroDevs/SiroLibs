          "text": "O meela ka mpi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        },
        {
          "text": "ndị ya dị elu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
    {
