            "number": "8",
            "style": "v",
            "sid": "PSA 148:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na amụma, na mkpụrụ mmiri, na snoo na igwe ojii niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
