      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "toonu ya nʼebe niile kachasị elu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
