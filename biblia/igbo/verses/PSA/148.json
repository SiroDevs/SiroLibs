      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:12"
      },
      "items": [
        {
          "text": "ndị okenye na ụmụntakịrị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
