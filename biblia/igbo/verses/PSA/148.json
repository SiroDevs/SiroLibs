            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.148.7",
                "verseOrgIds": [
                  "PSA.148.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", site nʼụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
