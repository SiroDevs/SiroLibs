      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:7"
      },
      "items": [
        {
          "text": "unu oke anụ mmiri niile na ogbu mmiri niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
