      "attrs": {
        "style": "q2",
        "vid": "PSA 148:13"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ naanị aha ya ka e buliri elu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.13",
            "verseOrgIds": [
              "PSA.148.13"
            ]
          }
        }
