      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:11"
      },
      "items": [
        {
          "text": "unu ụmụ eze na ndị niile na-achị achị nʼụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
