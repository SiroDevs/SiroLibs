          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ụmụ okorobịa na ụmụ agbọghọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
      ]
    },
