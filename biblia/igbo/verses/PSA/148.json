          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị eze niile nke ụwa na mba niile dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
