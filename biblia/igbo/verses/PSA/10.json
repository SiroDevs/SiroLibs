  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "PSA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ maka ikpe ziri ezi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.1",
                "verseOrgIds": [
                  "PSA.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", gịnị mere i ji na-eguzoro onwe gị nʼebe dị anya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:1"
      },
      "items": [
        {
          "text": "Gịnị mere ị na-ezo onwe gị nʼoge nsogbu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na mpako, onye ajọ omume na-emegbu ndị na-adịghị ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:2"
      },
      "items": [
        {
          "text": "ndị mpịa mpịa aghụghọ ya mara dịka ọnya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-anya isi banyere ọchịchọ niile nke obi ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:3"
      },
      "items": [
        {
          "text": "ọ na-elelị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.3",
                "verseOrgIds": [
                  "PSA.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "anya ma na-agọzi ndị oke ọchịchọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnọdụ mpako ya, onye ajọ omume anaghị achọ Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:4"
      },
      "items": [
        {
          "text": "nʼechiche ya niile, ọ naghị eche banyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe niile ọ na-eme na-agara ya nke ọma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "ọ bụ onye na-ebuli onwe ya elu, iwu gị niile dịkwa anya site nʼebe ọ nọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:5"
      },
      "items": [
        {
          "text": "ọ na-elelị ndị iro ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime obi ya, ọ na-asị, \"Ọ dịghị ihe ga-emetụta m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:6"
      },
      "items": [
        {
          "text": "Aga m anọ nʼọnọdụ ọṅụ mgbe niile. Nsogbu ọbụla agaghị adakwasị m.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ya jupụtara nʼokwu ụgha na ịba mba ime ihe ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:7"
      },
      "items": [
        {
          "text": "nʼokpuru ire ya ka nsogbu na ajọ ihe dịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-ezo onwe ha nʼobodo nta dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "nʼebe zooro ezo ka ha na-anọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:8"
      },
      "items": [
        {
          "text": "na-eche itigbu ndị aka ha dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ọdụm, ha anaghị eme mkpọtụ ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "ọ na-eche ịdakwasị ụmụ ogbenye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:9"
      },
      "items": [
        {
          "text": "Dịka ndị bụ dinta si ejide ụmụ anụmanụ nʼọnya ha siri, otu a ka ha si ejide ụmụ ogbenye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ogbenye ndị a na-ada nʼala nʼihi ịdị ike ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:10"
      },
      "items": [
        {
          "text": "ọ na-azọpịakwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime obi ya, ọ na-asị, \"Chineke echefuola.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:11"
      },
      "items": [
        {
          "text": "O zofuola ihu ya, ọ dịghị mgbe ọ hụrụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilie O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.12",
                "verseOrgIds": [
                  "PSA.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "! O Chineke welie aka gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:12"
      },
      "items": [
        {
          "text": "echefukwala ndị na-enweghị onye inyeaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere onye ajọ omume ji na-eleda Chineke anya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "Gịnị mere o ji na-asị nʼime obi ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:13"
      },
      "items": [
        {
          "text": "\"Ọ gaghị akpọ m ka m zaa ajụjụ banyere omume m\"?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị, O Chineke, ị na-ahụ nsogbu na ihe mwute,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "ị na-atule ihe ị ga-eme banyere ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 10:14"
      },
      "items": [
        {
          "text": "Ndị a na-emegbu na-atụkwasị gị obi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
