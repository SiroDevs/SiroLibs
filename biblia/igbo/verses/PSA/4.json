  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PSA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ Ọma Devid nke a na-eji ụbọ akwara akpọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ntụgharị uche nke abalị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaa m mgbe m na-akpọku gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "Chineke m, gị onye ezi omume;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "Napụta m site nʼihe mgbu m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "meere m ebere, nụrụkwa ekpere m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ụmụ mmadụ, ruo ole mgbe ka unu ga-atụgharịa ebube m, mee ka ọ bụrụ ihe ihere?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:2"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka unu ga-ahụ ihe efu nʼanya na-achọ chi ndị ahụ na-abụghị chi nʼezie?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.2",
                "verseOrgIds": [
                  "PSA.4.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matanụ nke ọma na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.3",
                "verseOrgIds": [
                  "PSA.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọpụtala ndị ezi omume nye onwe ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:3"
      },
      "items": [
        {
          "text": "ọ ga-egekwa ntị nʼolu m mgbe ọbụla m kpọkuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maanụ jijiji, unu emehiekwala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "mgbe unu nọ nʼelu ihe ndina unu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "nọọnụ jụụ na-enyocha obi unu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.4",
                "verseOrgIds": [
                  "PSA.4.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụkwasịnụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.5",
                "verseOrgIds": [
                  "PSA.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "obi unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:5"
      },
      "items": [
        {
          "text": "chụkwaranụ ya aja ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ ndị mmadụ na-ajụ, \"Onye pụrụ imere anyị ihe ọma?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:6"
      },
      "items": [
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.6",
                "verseOrgIds": [
                  "PSA.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", biko mee ka ìhè nke ihu gị mụkwasị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were ọṅụ mejupụta obi m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:7"
      },
      "items": [
        {
          "text": "karịa mgbe mkpụrụ ubi, ya na mmanya ọhụrụ ha bara ụba nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m edina ala ma rahụ ụra nʼudo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ naanị gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.8",
                "verseOrgIds": [
                  "PSA.4.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "na-eme ka m nọrọ na-enweghị ihe egwu ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    }
  ],
