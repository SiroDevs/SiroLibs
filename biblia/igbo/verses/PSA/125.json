    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 125",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ nrigo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke onye na-echebe ndị ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 125:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile na-atụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.1",
                "verseOrgIds": [
                  "PSA.125.1"
                ]
              }
            }
          ]
        },
        {
          "text": "obi na-anọgidesi ike dị ka ugwu Zayọn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:1"
      },
      "items": [
        {
          "text": "nke a na-apụghị inugharị, nke na-adịgidekwa nʼọnọdụ ya ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.1",
            "verseOrgIds": [
              "PSA.125.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 125:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ugwu niile si gbaa obodo Jerusalem gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.2",
                "verseOrgIds": [
                  "PSA.125.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na-agba ndị ya gburugburu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:2"
      },
      "items": [
        {
          "text": "ugbu a na ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.2",
            "verseOrgIds": [
              "PSA.125.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 125:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpara ọchịchị ndị ajọ omume agaghị adịgide",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "nʼala ndị ezi omume ketara nʼife nza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "nʼihi na ndị ezi omume nwere ike",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:3"
      },
      "items": [
        {
          "text": "itinye aka ha na-ime ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.3",
            "verseOrgIds": [
              "PSA.125.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 125:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.4",
                "verseOrgIds": [
                  "PSA.125.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", meere ndị niile na-eme ezi omume ihe ọma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:4"
      },
      "items": [
        {
          "text": "ya bụ, ndị niile obi ha ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.4",
            "verseOrgIds": [
              "PSA.125.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 125:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.125.5",
                "verseOrgIds": [
                  "PSA.125.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-achụpụ ndị niile na-agbaso ụzọ aghụghọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "na ndị niile na-eme ajọ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 125:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 125:5"
      },
      "items": [
        {
          "text": "Ka udo dịrị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.125.5",
            "verseOrgIds": [
              "PSA.125.5"
            ]
          }
        }
      ]
