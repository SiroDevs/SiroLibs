          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-emezuru m ihe niile o kwadoro m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
