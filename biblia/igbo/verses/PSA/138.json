          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.1",
                "verseOrgIds": [
                  "PSA.138.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", aga m eji obi m niile too gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:1"
      },
      "items": [
        {
          "text": "nʼihu chi niile dị iche iche ka m ga-abụku gị abụ otuto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 138:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m akpọ isiala nʼebe ụlọnsọ ukwu gị dị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "aga m etokwa aha gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "nʼihi ịhụnanya gị na ikwesi ntụkwasị obi gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "nʼihi na i meela ka aha gị na okwu gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:2"
      },
      "items": [
        {
          "text": "dị elu karịa ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 138:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m kpọkuru gị, ị zara m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:3"
      },
      "items": [
        {
          "text": "i mere m ka m nwee nkwuwa okwu ma guzosiekwa ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
