      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:4"
      },
      "items": [
        {
          "text": "mgbe ha nụrụ ihe niile i nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
