                "verseId": "PSA.138.4",
                "verseOrgIds": [
                  "PSA.138.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ka ndị eze niile nọ nʼụwa too gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
      ]
    },
