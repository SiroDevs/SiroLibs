          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ha bụọ abụ banyere ụzọ niile nke",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
