          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:5"
      },
      "items": [
        {
          "text": "nʼihi na ebube",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.5",
                "verseOrgIds": [
                  "PSA.138.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        }
      ]
    },
