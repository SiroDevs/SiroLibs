    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:8"
      },
      "items": [
        {
          "text": "ịhụnanya gị, o",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-adịgide ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    },
