  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "62",
        "style": "c",
        "sid": "PSA 62"
      },
      "items": [
        {
          "text": "62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 62",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Maka Jedutun. Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịnọgide nʼokwukwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ naanị nʼime Chineke ka mkpụrụobi m na-achọta izuike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:1"
      },
      "items": [
        {
          "text": "Nzọpụta m na-esite na ya na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.1",
            "verseOrgIds": [
              "PSA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị ya bụ oke nkume m na nzọpụta m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:2"
      },
      "items": [
        {
          "text": "ọ bụ ebe mgbaba m e wusiri ike, agaghị m ama jijiji nʼọnọdụ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.2",
            "verseOrgIds": [
              "PSA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 62:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruo ole mgbe ka unu ga-anọgide na-ebuso agha megide nwoke a?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "Unu niile, unu chọrọ ịkwatu ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:3"
      },
      "items": [
        {
          "text": "ebe ọ bụ naanị mgbidi na-ada ada, mgbidi na-esighị ike e ji osisi wuo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.3",
            "verseOrgIds": [
              "PSA.62.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 62:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ekpebiela",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "isite nʼọnọdụ ya dị elu kwatuo ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "okwu ụgha na-atọ ha ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "Ha na-eji ọnụ ha na-agọzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:4"
      },
      "items": [
        {
          "text": "ma nʼime obi ha, ha na-abụ ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.4",
            "verseOrgIds": [
              "PSA.62.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.4",
                "verseOrgIds": [
                  "PSA.62.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 62:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mkpụrụobi m, chọta ezumike naanị nʼime Chineke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:5"
      },
      "items": [
        {
          "text": "olileanya m na-esite na ya na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.5",
            "verseOrgIds": [
              "PSA.62.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 62:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị ya bụ oke nkume m, na onye nzọpụta m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:6"
      },
      "items": [
        {
          "text": "Naanị ya kwa bụ ebe mgbaba m e wusiri ike, agaghị m ama jijiji nʼọnọdụ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.6",
            "verseOrgIds": [
              "PSA.62.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 62:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzọpụta m na nsọpụrụ m dabeere na Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:7"
      },
      "items": [
        {
          "text": "Ọ bụ oke nkume m, ebe mgbaba m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.7",
            "verseOrgIds": [
              "PSA.62.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 62:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụkwasịnụ ya obi mgbe niile, unu ndị mmadụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "kwupụtaranụ ya obi unu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:8"
      },
      "items": [
        {
          "text": "nʼihi na Chineke bụ ebe mgbaba anyị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.8",
            "verseOrgIds": [
              "PSA.62.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.62.8",
                "verseOrgIds": [
                  "PSA.62.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nta nʼetiti ụmụ mmadụ bụ naanị otu nkuume,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "ndị ukwu bụ naanị ụgha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "ọ bụrụ na a tụọ ha nʼihe ọtụtụ, ha bụ ihe efu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:9"
      },
      "items": [
        {
          "text": "ha niile bụ naanị otu nkuume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.9",
            "verseOrgIds": [
              "PSA.62.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu atụkwasịla obi unu nʼiji aka ike kpata ego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "maọbụ tụkwasị olileanya unu nʼihe e zuru ezu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "akụ unu nwere ike mụbaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:10"
      },
      "items": [
        {
          "text": "unu atụkwasịla ha obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.10",
            "verseOrgIds": [
              "PSA.62.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke ekwuola otu ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "ihe abụọ ka m nụrụ:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:11"
      },
      "items": [
        {
          "text": "\"Na gị, O Chineke, dị ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.11",
            "verseOrgIds": [
              "PSA.62.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gị, Onyenwe anyị, jupụtara nʼịhụnanya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "Nʼezie, ị ga-akwụghachi onye ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 62:12"
      },
      "items": [
        {
          "text": "dịka ọrụ ya si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.62.12",
            "verseOrgIds": [
              "PSA.62.13"
            ]
          }
        }
      ]
    }
  ],
