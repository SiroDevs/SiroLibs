      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 31:15"
      },
      "items": [
        {
          "text": "na nʼaka ndị ahụ na-adịghị ezu ike ịchụ m ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.15",
            "verseOrgIds": [
              "PSA.31.16"
