              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ka amara gị mụkwasị ohu gị dịka anyanwụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.16",
            "verseOrgIds": [
