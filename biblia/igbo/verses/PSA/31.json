      "attrs": {
        "style": "q2",
        "vid": "PSA 31:16"
      },
      "items": [
        {
          "text": "zọpụta m nʼihi ịhụnanya gị na-enweghị ọgwụgwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.31.16",
            "verseOrgIds": [
              "PSA.31.17"
            ]
          }
        }
      ]
    },
