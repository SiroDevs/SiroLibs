  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "DEU 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achụrụla",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.1",
                "verseOrgIds": [
                  "DEU.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị ehi maọbụ atụrụ nwere nkwarụ ọbụla maọbụ ntụpọ. Onyinye dị otu a bụ ihe arụ nʼebe ọ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị nụ na onye ọbụla nʼime obodo ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.2",
                "verseOrgIds": [
                  "DEU.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere gị, nwoke maọbụ nwanyị na-eme ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.2",
                "verseOrgIds": [
                  "DEU.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ime ihe megidere ọgbụgba ndụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na onye ahụ efee chi ndị ọzọ, maọbụ kpọọ isiala nye ha, maọbụ fee anwụ, maọbụ ọnwa, maọbụ kpakpando nke mbara eluigwe bụ ihe m na-enyeghị nʼiwu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na e mere ka ị maara nʼihe dị otu a dị maọbụ ị nụ ya, ị ghaghị ịjụ ase, nyochaa ya nke ọma. Ọ bụrụ na ihe ị nụrụ bụ eziokwu, ọ bụrụ nʼezie na e mere ihe arụ dị otu a nʼala Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kpọrọ nwoke maọbụ nwanyị ahụ mere ihe ọjọọ dị otu a, kpọpụta ya nʼọnụ ụzọ ama obodo, tụọ ya nkume, tugbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu o si dị, a gaghị eme ka onye ahụ nwụọ site naanị nʼama otu mmadụ, kama ọ ga-anwụ site nʼama mmadụ abụọ maọbụ atọ gbara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ gbara akaebe nʼisi ya ga-eburu ụzọ tụọ ya nkume, tupu mmadụ niile esoro tugbuo ya. Site nʼụzọ dị otu a, unu ga-ekpochapụ ihe ọjọọ site nʼetiti gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụlọ ikpe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu enwee okwu siri ike na mkpebi, dịka igbu ọchụ, maọbụ okwu na ụka metụtara mmadụ, maọbụ ịlụ ọgụ nke mmerụ ahụ dapụtara nʼime ya, ihe unu ga-eme bụ iweta ikpe ahụ nʼebe obibi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.8",
                "verseOrgIds": [
                  "DEU.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị họpụtara,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihu ndị nchụaja, bụ ndị Livayị na onye nọ nʼoche ikpe nʼoge ahụ ka ha gbubie ikpe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-emekwa dịka mkpebi ha nyere gị nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.10",
                "verseOrgIds": [
                  "DEU.17.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ahọpụta. Lezie anya hụ na i mezuru ihe niile dịka ha si tụziere gị aka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee dịka iwu ha ziri gị si dị, na dịka mkpebi ha nyere gị si dị. Ewezugala onwe gị site nʼokwu ha nyere gị nʼụzọ ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye ahụ ledara onye nchụaja na onye ikpe ahụ a họpụtara ije ozi nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.12",
                "verseOrgIds": [
                  "DEU.17.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-anwụ. Unu ga-esi nʼala Izrel wezuga ihe ọjọọ dị otu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, mmadụ niile ga-anụ ihe mere onye ahụ nupuru isi, ha ga-atụ egwu ghara ịbụ ndị mpako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inwe eze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị banyere nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.14",
                "verseOrgIds": [
                  "DEU.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị, merie ndị bi nʼime ya, biri nʼime ya, i nwere ike malite iche nʼobi gị sị, \"Anyị kwesiri inwe eze dịka mba ndị ọzọ niile dị anyị gburugburu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O si otu a dịrị, lezie anya hụ na onye ị ga-eme eze bụ onye ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.15",
                "verseOrgIds": [
                  "DEU.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-ahọpụta. Onye ahụ aghaghị ịbụ onye Izrel nʼihi na i kwesighị ime onye mba ọzọ eze ka ọ chịa gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hụ na eze ahụ ị họpụtara enweghị ọtụtụ ịnyịnya. Eze ahụ ekwesịkwaghị izipụ ndị ga-aga Ijipt ịzụpụtara ya ọtụtụ ịnyịnya ọzọ, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.16",
                "verseOrgIds": [
                  "DEU.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "agwala gị sị, \"Ị gaghị alaghachi Ijipt ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze ahụ agaghị enwe ọtụtụ nwunye, nʼihi na nke a ga-eme ka obi ya si nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.17",
                "verseOrgIds": [
                  "DEU.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ pụọ. Ọ gakwaghị ababiga ụba ọlaọcha na ọlaedo oke.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nọkwasịrị nʼocheeze dịka eze, ọ ga-esite nʼakwụkwọ iwu a ndị nchụaja bụ ndị Livayị na-edebe, depụtara onwe ya iwu a metụtara obibi ndụ ndị eze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ahụ o depụtara ka ọ ga-agụ mgbe niile na ndụ ya. Nke a ga-eme ka ọ mụta ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.17.19",
                "verseOrgIds": [
                  "DEU.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya, na ịgbaso ihe niile dị nʼiwu na ụkpụrụ ndị a.",
