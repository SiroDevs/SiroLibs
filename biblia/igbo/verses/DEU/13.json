  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "DEU 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpere chi ndị ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye amụma, maọbụ onye na-akọwa nrọ apụta nʼetiti gị kwee nkwa na ihe ịrịbama maọbụ ihe dị ebube na-aga ime,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
            "verseOrgIds": [
              "DEU.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụkwa na ihe ịrịbama ahụ maọbụ ihe ebube ahụ e kwuru maka ya emezuo, emesịa onye amụma ahụ na-asị, \"Ka anyị gbaso chi ndị ọzọ dị iche, ka anyị feekwa ha,\" bụ chi ndị ị na-amaghị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.2",
            "verseOrgIds": [
              "DEU.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "egela okwu onye amụma maọbụ ọrọ nrọ ahụ ntị. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.3",
                "verseOrgIds": [
                  "DEU.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu na-ele unu ule ịmata ma unu jikwa obi unu, na uche unu hụ ya nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.4",
                "verseOrgIds": [
                  "DEU.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ka unu ga-eso, naanị ya ka unu ga-atụ egwu. Debenụ iwu ya niile na-erubekwara ya isi, na-ejere ya ozi, jidesiekwa ya ike.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-egbu onye amụma ahụ maọbụ onye ọrọ nrọ ahụ nke chọrọ iduhie unu, nʼihi na ọ chọrọ iweta nnupu isi megide",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.5",
                "verseOrgIds": [
                  "DEU.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, onye kpọpụtara unu site nʼala Ijipt, onye gbapụtara unu site nʼọnọdụ ịbụ ndị ohu. Ihe ọ chọrọ ime bụ iduhie gị, ka ị ghara ibi ụdị ndụ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.5",
                "verseOrgIds": [
                  "DEU.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị chọrọ ka i bie. Ọnwụ ya ga-eme ka i wezuga ihe ọjọọ site nʼetiti gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ezi enyi gị maọbụ nwanne gị nwoke maọbụ nwa gị nwoke maọbụ nwunye gị ị hụrụ nʼanya ejiri aghụghọ gwa gị okwu sị gị, \"Bịa ka anyị gaa fee chi ndị ọzọ ofufe\" (bụ chi ndị ị na-amaghị maọbụ nke nna gị ha na-amaghị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "chi nke ndị ala ahụ gbara unu gburugburu, ma ha bụ ndị bi gị nso ma ha bụ ndị bi nʼebe dị anya, site nʼotu nsọtụ nke ala ahụ ruo nsọtụ nke ọzọ),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekwenyekwala maọbụ ṅaa ntị nʼihe ọ na-ekwu. Enwekwala obi ebere nʼebe ọ nọ, ekpuchikwala atụmatụ ọjọọ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.8",
            "verseOrgIds": [
              "DEU.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ghaghị igbu ha. Buru ụzọ setịpụ aka gị tụọ ya nkume, ka ndị ọzọ soro gị tugbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.9",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri nkume tugbuo ya, nʼihi na ọ chọrọ ime ka i site nʼiso",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.10",
                "verseOrgIds": [
                  "DEU.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke, wezuga onwe gị, ka ị pụọ, ma chigharịa site nʼiso ya, bụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.10",
                "verseOrgIds": [
                  "DEU.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye mere ka i site nʼala Ijipt pụta, ala ebe ị nọ nʼime ya dịka ohu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izrel niile ga-anụkwa banyere ihe ọjọọ o mere, ha ga-atụkwa ihe ọjọọ dị otu a egwu, ọ dịkwaghị onye ọbụla nʼetiti gị ga-achọkwa ime ihe ọjọọ dị otu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe i bi nʼobodo ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.12",
                "verseOrgIds": [
                  "DEU.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị, ọ bụrụ na akụkọ esite nʼotu obodo ndị a ruo gị ntị sị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ụfọdụ ndị mmadụ jọgburu onwe ha eduhiela ndị obodo ha, na-asị, \"Ka anyị gaa fee chi ndị ọzọ ofufe\" (bụ chi ndị ị na-amaghị na mbụ),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tupu i mee ihe ọbụla, ị ga-eburu ụzọ jụọ ase, jụpụta nke ọma, ma nyochapụta ma okwu ahụ ọ bụ eziokwu. Ọ bụrụ na ọ bụ eziokwu na-achọpụtakwara nʼihe arụ dị otu a mere nʼetiti unu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ị ghaghị ibuso obodo ahụ agha jiri mma agha gbuo ndị mmadụ niile bi nʼime obodo ahụ. Ị ghaghị ibibi ya kpamkpam, ma ndị mmadụ ma anụ ụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nkwata niile i si nʼobodo ahụ kwata ka ị ga-ekpokọta nʼotu ebe, nʼama dị nʼetiti obodo ahụ. A ga-akpọkwa ha niile ọkụ, gbaakwa obodo ahụ niile ọkụ, dịka aja nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.16",
                "verseOrgIds": [
                  "DEU.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu. Ruo mgbe ebighị ebi, obodo ahụ ga-abụ mkpọmkpọ ebe, a gaghị ewugharịkwa ya ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị ihe ndị ahụ e debere nye mbibi nke e kwesiri ịhụ nʼaka gị. Nke a ga-emekwa ka iwe ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.17",
                "verseOrgIds": [
                  "DEU.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "dajụọ, ka o gosikwa gị obi ebere. Ọ ga-enwekwa ọmịiko nʼahụ gị, meekwa ka ị baa ụba nʼọnụọgụgụ, dịka o ji ịṅụ iyi kwee nna nna gị ha na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.18",
                "verseOrgIds": [
                  "DEU.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-eme ihe ndị a ma ọ bụrụ na ị na-erubere ya isi, na-edebezukwa iwu ya niile, nke m na-enye gị taa, ma na-eme ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.18",
                "verseOrgIds": [
                  "DEU.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        }
      ]
    }
  ],
