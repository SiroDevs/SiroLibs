  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "DEU 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joshua anọchie anya Mosis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis gwachara ụmụ Izrel okwu ndị a niile,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.1",
            "verseOrgIds": [
              "DEU.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ gwakwara ha okwu ọzọ sị, \"Ugbu a, agbaala m otu narị afọ na iri afọ abụọ! Enwekwaghị m ike idu unu, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.2",
                "verseOrgIds": [
                  "DEU.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": "agwala m sị, Ị gaghị agafe osimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.3",
                "verseOrgIds": [
                  "DEU.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nʼonwe ya ga-ebu gị ụzọ gabiga osimiri a. Ọ ga-ebibi mba niile ndị a nʼihu gị. Ị ga-enwetakwa ala ha. Joshua ga-edu gị gabiga osimiri a, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.3",
                "verseOrgIds": [
                  "DEU.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.4",
                "verseOrgIds": [
                  "DEU.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-emekwa ha ihe o mere Saịhọn na Ọg, bụ eze ndị Amọrait, ndị o kpochapụrụ ha na ala ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.4",
            "verseOrgIds": [
              "DEU.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.5",
                "verseOrgIds": [
                  "DEU.31.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-enyefe ndị bi nʼebe ahụ nʼaka unu, unu ga-ekpochapụkwa ha dịka m nyere unu nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.5",
            "verseOrgIds": [
              "DEU.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịnụ ike! Nweenụ obi ike! Unu atụla ha egwu! Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.6",
                "verseOrgIds": [
                  "DEU.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ga-anọnyere unu. Ọ gaghị agbakụta unu azụ, ọ gakwaghị ahapụ unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis kpọrọ Joshua, gwa ya okwu nʼihu ụmụ Izrel, sị ya, \"Dị ike! Nwee obi ike! Nʼihi na ọ bụ gị ga-edu ndị a baa nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.7",
                "verseOrgIds": [
                  "DEU.31.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅụrụ iyi inye nna nna ha, ị ga-emekwa ka ha keta ala a dịka ihe nketa ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.8",
                "verseOrgIds": [
                  "DEU.31.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼonwe ya ga-eburu gị ụzọ, ọ ga-anọnyekwara gị, ọ gaghị ahapụ gị maọbụ gbakụta gị azụ. Atụla egwu, adala mba.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngụpụta akwụkwọ iwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis depụtara iwu ndị ahụ niile nʼakwụkwọ, were ya nye ndị nchụaja, ụmụ Livayị, ndị na-ebu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.9",
                "verseOrgIds": [
                  "DEU.31.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ. Mosis nyekwara ndị okenye Izrel akwụkwọ a e dere iwu niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis nyere ha iwu sị, \"Na ngwụcha afọ asaa ọbụla, nʼafọ ahụ a na-akagbu ụgwọ niile, nʼoge a na-eme Mmemme ụlọ Ikwu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.10",
            "verseOrgIds": [
              "DEU.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe Izrel niile ga-abịa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.11",
                "verseOrgIds": [
                  "DEU.31.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, nʼebe ahụ ọ ga-ahọpụta, ị ga-agụpụta ihe a site nʼakwụkwọ iwu a nʼihu mmadụ niile ka ha nụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpọkọta mmadụ niile nʼotu ebe, ndị ikom, na ndị inyom na ụmụntakịrị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "text": "na ndị ọbịa bi nʼetiti obodo unu, ka ha nụrụ, ma mụta ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.12",
                "verseOrgIds": [
                  "DEU.31.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu na ilezi anya ịgbaso okwu niile dị nʼiwu a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụntakịrị ha, ndị na-amabeghị iwu ndị a, aghaghị ịnụ na ịmụta ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.13",
                "verseOrgIds": [
                  "DEU.31.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, ụbọchị ndụ unu niile nʼala ahụ unu na-agafe Jọdan inweta.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu ikpeazụ Onyenwe anyị gwara Mosis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.14",
                "verseOrgIds": [
                  "DEU.31.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị, \"Lee, ụbọchị ọnwụ gị na-abịaru nso. Kpọrọ Joshua ka gị na ya soro bịa nʼụlọ nzute ebe m ga-anọ nye ya ọrụ ọ ga-arụ.\" Mosis na Joshua sooro bịa guzo onwe ha nʼọnụ ụzọ ụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.15",
                "verseOrgIds": [
                  "DEU.31.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gosiri ha onwe ya nʼime ogidi igwe ojii nke guzochiri ọnụ ụzọ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.16",
                "verseOrgIds": [
                  "DEU.31.16"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị, \"Ị ga-anwụ, jekwuru nna nna gị ha. Mgbe ị nwụrụ, ndị a ga-amalite ife chi ọzọ ofufe ndị dị nʼala ahụ ha na-abanye. Ha ga-agbakụta m azụ, mebie ọgbụgba ndụ mụ na ha gbara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.16",
            "verseOrgIds": [
              "DEU.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, iwe m ga-adị ọkụ megide ha, aga m agbakụta ha azụ, zoo ihu m nʼebe ha nọ. A ga-alakwa ha nʼiyi. Ọdachi na ahụhụ dị iche iche ga-abịakwasị ha, nke ga-eme ka ha sị, 'Chineke anyị anọkwaghị nʼetiti anyị, ọ bụ ya mere ọdachi ndị a ji bịakwasị anyị.'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.17",
            "verseOrgIds": [
              "DEU.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m echepụ ihu m site nʼebe ha nọ nʼụbọchị ahụ, nʼihi ajọ omume ha nke ife chi ọzọ ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, depụtaranụ onwe unu abụ a nʼakwụkwọ, kuziekwara ya ụmụ Izrel, ka ọ bụrụ ihe akaebe m megide ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m mere ka ha bata nʼala ahụ m kwere nna nna ha na nkwa, ala ahụ mmiri ara ehi na mmanụ aṅụ na-erugharị nʼime ya, mgbe ha rijukwara afọ, baakwa ụba, ha ga-ebido ife chi ọzọ ofufe, jụ m, ma mebikwaa ọgbụgba ndụ m.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọtụtụ ihe ọdachi na ahụhụ ga-abịakwasị ha, abụ a ga-eme ka ha cheta ihe mere nsogbu ha niile ji bịakwasị ha, nʼihi na abụ a ga-adịgide site nʼọgbọ ruo nʼọgbọ. Amaara m nke ọma ugbu a, ọ bụladị tupu ha abanye nʼala ahụ m kwere nkwa inye ha site nʼịṅụ iyi, ụdị mmadụ ha bụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nʼụbọchị ahụ, Mosis dere abụ ahụ, kuziekwara ya ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.23",
                "verseOrgIds": [
                  "DEU.31.23"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Joshua nwa Nun iwu sị ya, \"Dị ike, nwee obi ike, ị ghaghị ịkpọbata ụmụ Izrel nʼala ahụ m sitere nʼịṅụ iyi kwee ha na nkwa. Mụ onwe m ga-anọnyere gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis dechara okwu niile nke iwu ndị a nʼakwụkwọ, site na mbido ruo nʼọgwụgwụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "o nyere ndị Livayị na-ebu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.25",
                "verseOrgIds": [
                  "DEU.31.25"
                ]
              }
            }
          ]
        },
        {
          "text": "iwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Werenụ Akwụkwọ Iwu a tinye ya nʼakụkụ igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.26",
                "verseOrgIds": [
                  "DEU.31.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, ka ọ bụrụ ihe ịgba ama megide unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na amaara m na unu bụ ndị nnupu isi, na ndị isiike. Lee, ọ bụladị taa m nọ ndụ nʼetiti unu, unu na-enupu isi nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.27",
                "verseOrgIds": [
                  "DEU.31.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ, unu ga-esi aṅaa ghara inupu isi mgbe m nwụrụ?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpọkọtaanụ ndị okenye unu niile, na ndị ọchịchị agbụrụ unu niile, ka m kwupụta okwu ndị a mgbe ha na-anụ ya. Ka m kpọkuokwa eluigwe na ụwa ka ha gbaa ama megide ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na amaara m na mgbe m nwụrụ, unu ga-aghọ ndị rụrụ arụ nke ukwuu, unu ga-ewezuga onwe unu site nʼebe iwu ndị ahụ m nyere unu dị. Amakwaara m na nʼụbọchị ndị ahụ na-abịa, ihe ọjọọ ga-adakwasị unu, nʼihi ihe ọjọọ niile unu mere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.31.29",
                "verseOrgIds": [
                  "DEU.31.29"
                ]
              }
            }
          ]
        },
        {
          "text": "nke unu ji kpasuo ya iwe site nʼihe ndị ahụ unu ji aka unu kpụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ Mosis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Mosis gụpụtara okwu niile dị nʼabụ a site na mbido ruo ọgwụgwụ na ntị nzukọ ndị Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.30",
            "verseOrgIds": [
              "DEU.31.30"
            ]
          }
        }
      ]
    }
  ],
