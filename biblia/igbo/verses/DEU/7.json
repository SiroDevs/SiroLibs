  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "DEU 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu banyere ikpochapụ ndị Kenan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.1",
                "verseOrgIds": [
                  "DEU.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ga-akpọbata unu nʼala ahụ unu na-abanye inweta, mgbe o si nʼihu unu chụpụ ọtụtụ mba ndị a nʼihu unu, bụ ndị Het, ndị Gigash, ndị Amọrait, ndị Kenan, ndị Periz, ndị Hiv na ndị Jebus, bụ mba asaa ndị dị ike nke ukwuu, baakwa ụba karịa unu;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.2",
                "verseOrgIds": [
                  "DEU.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu nyefere ha nʼaka unu, unu meriekwa ha, lezienụ anya hụ na unu bibiri ha kpamkpam. Ka unu na ha ghara ịgba ndụ, unu emekwarala ha ebere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na ha alụrịtakwala di na nwunye, unu enyekwala ụmụ ha ndị ikom ụmụ unu ndị inyom ka ha lụọ, maọbụ lụtara ụmụ unu ndị ikom ụmụ ha ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
              "DEU.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nke a ga-eme ka ụmụ unu site nʼiso m tụgharịa, malite ife chi ndị ọzọ. Mgbe ahụ iwe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.4",
                "verseOrgIds": [
                  "DEU.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-adị ọkụ megide unu, laakwa unu nʼiyi ngwangwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama otu a ka unu ga-eme: tikpọọnụ ebe ịchụ aja ha niile. Kụrienụ ogidi arụsị ha niile. Gbutukwaanụ osisi Ashera ha, ma suo arụsị ha niile ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na unu bụ ndị dị nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.6",
                "verseOrgIds": [
                  "DEU.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.6",
                "verseOrgIds": [
                  "DEU.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ahọpụtala unu site nʼagbụrụ niile dị nʼụwa a, ka unu bụrụ ndị nke ya, ihe onwunwe ya dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị nʼihi na unu dị ukwuu nʼọnụọgụgụ karịa ndị mba ọzọ, ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.7",
                "verseOrgIds": [
                  "DEU.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ji họpụta unu, hụ unu nʼanya otu a, nʼezie unu dịkarịsịrị nta nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, ọ bụ nʼihi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.8",
                "verseOrgIds": [
                  "DEU.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "hụrụ unu nʼanya, mezuokwa iyi ọ ṅụrụ nye nna nna unu ha, ka o ji site nʼaka ya dị ike gbapụta unu site nʼala ebe unu bụ ndị ohu, site nʼike nke Fero, bụ eze Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matanụ nke ọma na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.9",
                "verseOrgIds": [
                  "DEU.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu bụ Chineke. Ọ bụ Chineke kwesiri ntụkwasị obi, onye na-edebe ọgbụgba ndụ ịhụnanya ya ruo puku ọgbọ, nye ndị niile hụrụ ya nʼanya, ndị na-edebe ihe niile o nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DEU 7:10"
      },
      "items": [
        {
          "text": "onye kpọrọ ya asị, ọ na-eji mbibi kwụghachi ya ụgwọ nʼihu ya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DEU 7:10"
      },
      "items": [
        {
          "text": "ọ gaghị egbu oge ịkwụghachi onye kpọrọ ya asị ụgwọ nʼihu ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, hụ na unu debezuru iwu na ụkpụrụ ndị a m na-enye unu taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu elezie anya, ṅaa ntị nʼiwu ndị a, debe ha, ma mezuokwa ha,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.12",
                "verseOrgIds": [
                  "DEU.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ga-emezuru unu ọgbụgba ndụ ịhụnanya ahụ dịka ọ ṅụrụ nʼiyi nye nna nna unu ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ahụ unu nʼanya, gọzie unu, meekwa ka unu baa ụba nʼọnụọgụgụ. Ọ ga-agọzi unu nʼọmụmụ, gọzie ihe ọkụkụ nke ala unu, ọka unu, na mmanya ọhụrụ unu, na mmanụ unu, na ụmụ ehi unu mụrụ, na ụmụ igwe atụrụ unu mụrụ, nʼala ahụ ọ ṅụụrụ nna nna unu ha iyi inye unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-agọzi unu karịa mba ndị ọzọ niile dị nʼụwa. Ọ dịghị onye ọbụla nʼime unu, maọbụ nwoke maọbụ nwanyị ga-anọ na-amụtaghị nwa, ọ dịkwaghị anụ ụlọ unu ga-agba aka nwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.15",
                "verseOrgIds": [
                  "DEU.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ewepụrụ unu ọrịa niile. Ọ gaghị ekwe ka ọrịa ndị Ijipt ọbụla, nke unu na-echeta nke ọma dakwasị unu, ọrịa ndị a niile ka ọ ga-eme ka ọ bịakwasị ndị iro unu!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.16",
                "verseOrgIds": [
                  "DEU.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu nyefere unu nʼaka ka unu ga-ala nʼiyi. Unu emerela ha ebere, unu efekwala chi niile ha, nʼihi na nke a ga-abụrụ unu ihe ịma nʼọnya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eleghị anya, unu ga na-eche nʼime onwe unu sị, \"Mba ndị a dị ike karịa anyị, olee otu anyị ga-esi chụpụ ha?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
              "DEU.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu atụla egwu! Naanị chetanụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.18",
                "verseOrgIds": [
                  "DEU.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu mere Fero na ndị Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ji anya unu hụ ọnwụnwa ukwuu niile, ihe ịrịbama niile na ihe ebube niile, nʼaka ahụ dị ike na ogwe aka esetipụrụ esetipụ, nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.19",
                "verseOrgIds": [
                  "DEU.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ji kpọpụta unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.19",
                "verseOrgIds": [
                  "DEU.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ga-emekwa otu ihe ahụ nʼebe ndị niile a unu na-atụ egwu ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karịsịa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.20",
                "verseOrgIds": [
                  "DEU.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ga-ezipụ ebu nʼetiti ha tutu ruo mgbe ọ bụladị ndị fọdụrụ ndụ, ndị ahụ ga-ezo onwe ha site nʼebe unu nọ, ghọrọ ndị e bibiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu amala jijiji nʼihu ha, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.21",
                "verseOrgIds": [
                  "DEU.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, onye nọ nʼetiti unu bụ Chineke dị ukwuu, dịkwa egwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.22",
                "verseOrgIds": [
                  "DEU.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu, ga-achụpụ mba ndị a ntakịrị ntakịrị. Ọ gaghị ekwe ka unu chụpụ ha otu ugboro, ma ọ bụghị ya, ụmụ anụ ọhịa ọjọọ ga-amụba megide unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.22",
            "verseOrgIds": [
              "DEU.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.23",
                "verseOrgIds": [
                  "DEU.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ga-enyefe ha nʼaka unu, ọ ga-etinye ha oke ọgbaaghara nʼobi, tutu ruo mgbe ha lara nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze ha niile ka ọ ga-enyefe nʼaka unu, unu ga-ehichapụkwa aha ha nʼelu ụwa. Ọ dịkwaghị onye pụrụ iguzo nʼihu unu, nʼihi na unu ga-ebibi ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.24",
            "verseOrgIds": [
              "DEU.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpọọnụ arụsị niile nke apịrị apị nke chi niile ha ọkụ. Unu enwela anya ukwu nʼebe ọlaọcha maọbụ ọlaedo dị ha nʼahụ dị. Unu ewerela ya ka ọ bụrụ nke unu, ka unu ghara ịbụ ndị ọ matara nʼọnya, nʼihi na ọ bụ ihe arụ nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.7.25",
                "verseOrgIds": [
                  "DEU.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ewebatala ihe arụ ọbụla nʼụlọ unu, ka unu ghara ịbụ ihe e debere iche nye mbibi dịka ya. Kpọọnụ ihe arụ ahụ asị, ledakwanụ ya anya, nʼihi na ihe e debere iche nye mbibi ka ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.26",
            "verseOrgIds": [
              "DEU.7.26"
            ]
          }
        }
      ]
    }
