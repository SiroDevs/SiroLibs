        },
        {
          "text": "Ana m akpọku eluigwe na ụwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
        {
          "text": "taa ka ha bụrụ ndị akaebe m, na edebela m nʼihu gị ọnwụ na ndụ, debekwa nʼihu gị ngọzị na ọbụbụ ọnụ. Ugbu a, họrọ ndụ, ka gị na ụmụ gị dị ndụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
