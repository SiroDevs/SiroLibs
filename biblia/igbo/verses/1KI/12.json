  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "1KI 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọchịchị Rehoboam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboam gara Shekem, nʼihi na Izrel niile zukọrọ ebe ahụ ime ya eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.1",
            "verseOrgIds": [
              "1KI.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jeroboam nwa Nebat nụrụ nke a (ọ ka nọ nʼIjipt ebe ọ gbagara ọsọ ndụ site nʼaka eze Solomọn), o sitere Ijipt lọta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.2",
            "verseOrgIds": [
              "1KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha ziri ozi kpọọ Jeroboam, ya na ọgbakọ Izrel niile jekwuru Rehoboam sị ya:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.3",
            "verseOrgIds": [
              "1KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nna gị boro anyị ibu arọ, ma ugbu a mee ka ibu arọ na ịyagba arọ a nke o bokwasịrị anyị, dị mfe, anyị ga-ejere gị ozi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.4",
            "verseOrgIds": [
              "1KI.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboam zara ha sị, \"Laanụ, ụbọchị atọ gasịa unu bịaghachikwutenụ m.\" Nʼihi ya ndị ahụ lara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.5",
            "verseOrgIds": [
              "1KI.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze Rehoboam gara ịnata ndụmọdụ nʼaka ndị okenye, bụ ndị jeere nna ya Solomọn ozi nʼoge ọ dị ndụ, sị ha, \"Olee ndụmọdụ unu ga-enye m maka mụ inye ndị a ọsịsa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.6",
            "verseOrgIds": [
              "1KI.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara ya, \"Ọ bụrụ na ị ga-abụ odibo nye ndị a taa, jeere ha ozi, nyekwa ha ọsịsa dị mma,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.7",
            "verseOrgIds": [
              "1KI.12.7"
            ]
          }
        },
        {
          "text": "ha ga-anọgide bụrụ ndị ohu gị mgbe niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.7",
            "verseOrgIds": [
              "1KI.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ nabataghị ndụmọdụ ndị okenye nyere ya, ọ gakwuru ụmụ okorobịa ndị ya na ha tokọrọ, bụkwa ndị na-ejere ya ozi, ka ha nye ya ndụmọdụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.8",
            "verseOrgIds": [
              "1KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboam jụrụ ha sị, \"Gịnị bụ ndụmọdụ unu? Gịnị bụ ọsịsa anyị ga-enye ndị a na-asị, 'Mee ka ibu arọ nna gị bokwasịrị anyị dị mfe'? \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.9",
            "verseOrgIds": [
              "1KI.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ okorobịa ahụ, bụ ndị ya na ha tokọrọ, zaghachiri sị, \"Gwa ndị ahụ sịrị gị, 'Nna gị bokwasịrị anyị ibu arọ, ma mee ka ibu anyị dị mfe,' ị ga-agwa ha, sị, 'Mkpịsịaka nta dị nʼaka m gbara okpotokpo karịa ukwu nna m.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.10",
            "verseOrgIds": [
              "1KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nna m boro unu ibu arọ; aga m atụkwasị ihe nʼibu ahụ mee ka ọ dị arọ karịa. Nna m ji apịpịa dọọ unu aka na ntị, maọbụ akpị ka m ga-eji mekpaa unu ahụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.11",
            "verseOrgIds": [
              "1KI.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị atọ gasịrị, Jeroboam na ndị Izrel",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.12",
            "verseOrgIds": [
              "1KI.12.12"
            ]
          }
        },
        {
          "text": "niile bịaghachiri ịnụrụ ọsịsa Rehoboam, dịka eze kwuru, sị, \"Laghachitenụ nʼụbọchị nke atọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.12",
            "verseOrgIds": [
              "1KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze sara ndị a okwu nʼolu dị ike. Ọ jụrụ ndụmọdụ nke ndị okenye nyere ya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.13",
            "verseOrgIds": [
              "1KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gbasoro ndụmọdụ nke ụmụ okorobịa nyere. Ọ sịrị, \"Nna m mere ka ibu unu dị arọ, aga m eme ka ibu unu dị arọ karịa. Nna m ji apịpịa dọọ unu aka na ntị, aga m eji akpị mekpaa unu ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.14",
            "verseOrgIds": [
              "1KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze aṅaghị ndị ahụ ntị, nʼihi mgbanwe nke ọnọdụ niile a sitere nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.15",
            "verseOrgIds": [
              "1KI.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.15",
                "verseOrgIds": [
                  "1KI.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ, ka e mezuo okwu ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.15",
            "verseOrgIds": [
              "1KI.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.15",
                "verseOrgIds": [
                  "1KI.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Jeroboam nwa Nebat site nʼọnụ Ahija onye Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.15",
            "verseOrgIds": [
              "1KI.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Izrel niile hụrụ na eze jụrụ ige ha ntị, ha zaghachiri ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1KI 12:16"
      },
      "items": [
        {
          "text": "\"Olee oke anyị nwere nʼime Devid?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1KI 12:16"
      },
      "items": [
        {
          "text": "Olee ihe nketa anyị nwere nʼime nwa Jesi?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1KI 12:16"
      },
      "items": [
        {
          "text": "Ndị Izrel, laanụ nʼụlọ ikwu unu!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1KI 12:16"
      },
      "items": [
        {
          "text": "Gị Devid lekọtakwa ụlọ nke gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1KI 12:16"
      },
      "items": [
        {
          "text": "Ya mere, ndị Izrel lara nʼụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.16",
            "verseOrgIds": [
              "1KI.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ndị Izrel bi nʼobodo niile nke Juda, Rehoboam gara nʼihu bụrụ eze ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.17",
            "verseOrgIds": [
              "1KI.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Rehoboam zipụrụ Adoniram, onyeisi na-elekọta ndị ọrụ mmanye, ma ndị Izrel niile ji nkume tugbuo ya. Ma eze Rehoboam jisiri ike gbaba nʼime ụgbọ agha ya, gbalaga laa Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.18",
            "verseOrgIds": [
              "1KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Izrel nọ na nnupu isi megide ụlọ Devid ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.19",
            "verseOrgIds": [
              "1KI.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Izrel nụrụ na Jeroboam alaghachitala, ha ziri ya ozi sị ya pụta nʼihu ọha mmadụ. Nʼebe ahụ ka ha nọ mee ya eze Izrel. Ọ dịghị ebo ọbụla kwenyere iso ụlọ Devid, karịakwa ebo Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.20",
            "verseOrgIds": [
              "1KI.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Rehoboam bịarutere Jerusalem, ọ kpọkọtara ndị ụlọ Juda niile na ndị ebo Benjamin, ha dị narị puku na iri asatọ nʼọnụọgụgụ, ụmụ okorobịa ndị tozuru ịga agha, ka ha gaa buso ụlọ Izrel agha ma weghachitekwa alaeze nʼokpuru ọchịchị Rehoboam, nwa Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.21",
            "verseOrgIds": [
              "1KI.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma okwu Chineke rutere Shemaya onye nke Chineke ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.22",
            "verseOrgIds": [
              "1KI.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa Rehoboam, nwa Solomọn eze Juda, na ndị Juda niile, na Benjamin na ndị ọzọ niile, sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.23",
            "verseOrgIds": [
              "1KI.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.24",
                "verseOrgIds": [
                  "1KI.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Unu agakwala gaa buso ụmụnna unu, bụ ndị Izrel agha. Laghachinụ, nwoke ọbụla nʼụlọ ya, nʼihi na ọ bụ m na-eme nke a.' \" Ya mere, ha rubere isi nʼokwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.24",
                "verseOrgIds": [
                  "1KI.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye ọbụla nʼime ha laghachikwara nʼụlọ ya dịka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.24",
                "verseOrgIds": [
                  "1KI.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oyiyi ehi ọlaedo dị na Betel na Dan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jeroboam wusiri Shekem dị nʼala ugwu Ifrem ike, biri nʼebe ahụ. Nʼebe ahụ ka o si pụọ, gaa wuo obodo Peniel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jeroboam chere nʼobi ya, sị \"Ugbu a, ka alaeze nwere ike laghachikwa nʼaka ụlọ Devid.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụrụ na ndị mmadụ gaa ịchụ aja nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.12.27",
                "verseOrgIds": [
                  "1KI.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nke dị na Jerusalem, obi ha nwere ike laghachikwuru onyenwe ha, bụ Rehoboam eze Juda. Ha ga-egbu m, laghachikwuru eze Rehoboam.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ natachara ndụmọdụ, eze kpụrụ ụmụ ehi ọlaedo abụọ. Ọ sịrị ndị mmadụ, \"Ọ bụ oke ọrụ nye unu ịgbago Jerusalem. Leenụ chi unu, ndị Izrel, ndị sitere nʼIjipt kpọpụta unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime ha ka o guzobere na Betel, tinyekwa nke ọzọ na Dan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a ghọrọ mmehie dịrị ha, nʼihi na ndị mmadụ na-abịa kpọọ isiala nye nke dị na Betel ma gaakwa ebe dị anya, dịka Dan, nʼihi ife ehi ọlaedo nke dị nʼebe ahụ ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam wuru ebe ịchụ aja nʼebe dị elu dị iche iche. Ọ họpụtara ndị nchụaja site nʼetiti ndị Izrel niile,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "text": "nʼagbanyeghị na ha abụghị ndị Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "O hiwere mmemme a na-eme nʼụbọchị nke iri na ise nʼọnwa nke asatọ, dịka mmemme a na-eme na Juda. Ọ chụkwara aja nʼebe ịchụ aja. O mere nke a na Betel, chụọrọ ụmụ ehi ọlaedo ahụ ọ kpụrụ aja. O tinyere ndị nchụaja nʼọrụ nʼebe niile dị elu nke o mere ka ha dịrị na Betel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke iri na ise, nʼọnwa asatọ, bụ ọnwa nke ya onwe ya chepụtara, ọ chụrụ aja dị iche iche nʼelu ebe ịchụ aja o wuru na Betel. Ya mere, o hiwere mmemme a ka ọ dịịrị ndị Izrel niile; ya onwe ya kwa gara chụọ aja onyinye dị iche iche nʼelu ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
    }
  ],
