  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1KI 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "emee ka Solomọn hụ ya anya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Solomọn rụchara ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.1",
                "verseOrgIds": [
                  "1KI.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", na ụlọeze, rụzukwaa ihe niile bụ nke o bu nʼobi ime,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.2",
                "verseOrgIds": [
                  "1KI.9.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka ọ hụ ya anya nke ugboro abụọ dịka o mere ka ọ hụ ya anya na Gibiọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.2",
            "verseOrgIds": [
              "1KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.3",
                "verseOrgIds": [
                  "1KI.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 9:3"
      },
      "items": [
        {
          "text": "\"Anụla m ekpere gị, na arịrịọ gị, nke ị rịọrọ nʼihu m. Edoola m ụlọnsọ a nke i wuru nsọ, site nʼitinye Aha m nʼebe ahụ ruo mgbe ebighị ebi. Anya m na obi m abụọ ga-adịkwa nʼebe ahụ ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, ọ bụrụ na ị jiri obi zuruoke na omume ziri ezi, bie ndụ nʼikwesị ntụkwasị obi nʼihu m dịka Devid nna gị mere, na-eme ihe niile m nyere nʼiwu, debe ụkpụrụ m na iwu m niile,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, aga m eme ka ocheeze ọchịchị gị nʼIzrel guzosie ike ruo mgbe ebighị ebi, dịka m kwere nna gị Devid nkwa, mgbe m sịrị, 'Ị ghaghị inwe onye nnọchite anya nʼocheeze Izrel.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na unu, maọbụ ụmụ ụmụ unu alaghachi azụ, site nʼebe m nọ, jụ idebe iwu na ụkpụrụ niile bụ nke m nyere unu, pụọ gbasoro chi ndị ọzọ ife ha ofufe na ịkpọ isiala nye ha,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.6",
            "verseOrgIds": [
              "1KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, aga m esite nʼala ahụ nke m nyere ha wezuga Izrel. Aga m ajụkwa ụlọnsọ a m doro nsọ nye Aha m. Izrel ga-aghọ ihe eji atụ ilu na ihe ịkpa ọchị nʼetiti ndị niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ụlọnsọ ukwu a kachasị elu ugbu a, ma ọnọdụ ya ga-eju ndị niile ga-esi nʼakụkụ ya gafee anya. Ha ga-emi ọnụ, sị, 'Gịnị mere",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.8",
                "verseOrgIds": [
                  "1KI.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ji mee ala a na ụlọnsọ a, ihe dị otu a?'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ ga-aza, 'Nʼihi na ha gbakụtara",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.9",
                "verseOrgIds": [
                  "1KI.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ha azụ, onye kpọpụtara ha site nʼala Ijipt azụ, makụọ chi ndị ọzọ, na-akpọ isiala na-efekwa ha ofufe. Ọ bụ nʼihi nke a ka O ji mee ka ihe ọjọọ niile ndị a bịakwasị ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ ndị ọzọ Solomọn rụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọgwụgwụ iri afọ abụọ, mgbe Solomọn ji wuo ụlọ abụọ ndị a, ya bụ ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.10",
                "verseOrgIds": [
                  "1KI.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "na ụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn nyere Hiram, eze Taịa, iri obodo abụọ dị na Galili, nʼihi osisi sida, na osisi junipa, na ọlaedo niile Hiram butere ya dịka o si chọọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Hiram si Taịa gaa ịhụ obodo ndị a nke Solomọn nyere ya, ha amasịghị obi ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.12",
            "verseOrgIds": [
              "1KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ jụrụ sị, \"Nwanne m nwoke, ụdị obodo dị aṅaa bụ ihe a i nyere m?\" Nʼihi ya, ọ kpọrọ ha Kabul,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "text": "aha ọ na-aza ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiram zigaara eze ọlaedo dị puku kilogram anọ na iri asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
            "verseOrgIds": [
              "1KI.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere ndị ọrụ mmanye niile eze bụ Solomọn chịkọtara maka ịrụ ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.15",
            "verseOrgIds": [
              "1KI.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.15",
                "verseOrgIds": [
                  "1KI.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", na ụlọeze nke ya, na ebe e wusiri ike nke Milo, na mgbidi Jerusalem, Hazọ, Megido nakwa Gaza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.15",
            "verseOrgIds": [
              "1KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero eze Ijipt buru agha na mbụ merie Gaza, kpọọ ya ọkụ, gbukwaa ọtụtụ ndị Kenan bi nʼobodo ahụ, were ya nye nwa ya nwanyị, bụ nwunye Solomọn, ka ọ bụrụ ihe o ji duo ya ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.16",
            "verseOrgIds": [
              "1KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn wugharịrị obodo Gaza, wuokwa ndịda Bet-Horon,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.17",
            "verseOrgIds": [
              "1KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baalat na Tadmọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.18",
            "verseOrgIds": [
              "1KI.9.18"
            ]
          }
        },
        {
          "text": "nke dị nʼọzara nʼime ala ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.18",
            "verseOrgIds": [
              "1KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wukwara ọtụtụ obodo ebe nchịkọba ihe, obodo ebe idebe ụgbọ agha na ịnyịnya ya niile. O wuru ihe ọbụla gụrụ obi ya agụụ iwu na Jerusalem, Lebanọn na nʼoke ala ahụ niile ọ na-achị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.19",
            "verseOrgIds": [
              "1KI.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile fọdụrụ ndụ nʼetiti ndị Amọrait, ndị Het, ndị Periz, ndị Hiv na Jebus (ndị ahụ abụghị ndị Izrel),",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.20",
            "verseOrgIds": [
              "1KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị ụmụ ụmụ ha niile fọdụrụ nʼala ahụ, ndị ahụ ndị Izrel na-enweghị ike egbuchapụ, ndị a ka Solomọn mere ndị ọrụ mmanye na ndị ohu, nke a bụkwa ọnọdụ ha ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.21",
            "verseOrgIds": [
              "1KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Solomọn emeghị ka onye Izrel ọbụla bụrụ ohu. Kama ha bụ ndị ikom agha, ndịisi ọrụ nʼọchịchị, ndịisi ndị ọchịagha, ndịisi ụgbọ agha na ndị na-agba ịnyịnya agha ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụkwa ndịisi na-ahụ ihe banyere ọrụ niile nke Solomọn ji nʼaka. Ndị Izrel dị narị ise na iri ise (550), ka e mere ndịisi na-elekọta ndị ọrụ Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.23",
            "verseOrgIds": [
              "1KI.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ada Fero sitere nʼobodo Devid pụta gbagoo nʼụlọeze nke Solomọn wuuru ya. Solomọn wukwara ebe mpụta nke ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.24",
            "verseOrgIds": [
              "1KI.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugboro atọ nʼafọ,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "text": "ka Solomọn na-achụ aja nsure ọkụ, na aja udo nʼelu ebe ịchụ aja o wuru nye",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.25",
                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", tinyere aja nsure ọkụ ihe na-esi isi ụtọ ọ na-achụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.25",
                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ". O si otu a wuchaa ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.25",
                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn wukwara ọtụtụ ụgbọ mmiri nʼEziọn Geba,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "text": "bụ nke dị nʼakụkụ Elat, nʼọnụ mmiri Oke osimiri Uhie nʼala Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiram zigaara ndị ikom ya na-anya ụgbọ, ndị maara ihe banyere ime njem osimiri nke ọma, ka ha soro ndị ikom Solomọn jee ozi nʼime ụgbọ ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nyaara ụgbọ gaa Ọfịa,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.28",
            "verseOrgIds": [
              "1KI.9.28"
            ]
          }
        },
        {
          "text": "site nʼebe ahụ bulatara eze Solomọn ọlaedo nke ịdị arọ ya ruru puku kilogram iri na anọ na narị abụọ na asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.28",
            "verseOrgIds": [
              "1KI.9.28"
            ]
          }
        }
      ]
    }
