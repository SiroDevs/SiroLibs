                "verseOrgIds": [
                  "1KI.7.51"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.51",
            "verseOrgIds": [
              "1KI.7.51"
            ]
          }
        }
