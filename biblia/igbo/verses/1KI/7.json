  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1KI 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomọn ewuo ụlọeze ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn ji afọ iri na atọ wuo ụlọ nke ya, bịa ruchakwaa ụlọ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.1",
            "verseOrgIds": [
              "1KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ụlọeze ukwu aha ya bụ Oke Ọhịa Lebanọn,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "text": "nke ogologo ya dị iri mita ise, obosara ya dị iri mita abụọ na ise. Otu a kwa, ịdị elu ya dị mita iri na ise. Osisi sida ukwu e ji rụọ elu ya ka e mere ka ha nọkwasị nʼelu ogidi e doro nʼahịrị nʼahịrị. Ahịrị ogidi ndị a dịkwa anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa osisi sida ka e ji machie elu ụlọ ahụ. A kụkwasịrị osisi ndị a nʼelu osisi sida ukwu ndị a a wara awa, ndị e mere ka ha nọkwasị nʼogidi ndị ahụ. Ọnụọgụgụ osisi ndị ahụ bụ iri anọ na ise. Ọ bụkwa iri na ise ka e nwere nʼahịrị ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.3",
            "verseOrgIds": [
              "1KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghereikuku ya dịkwa nʼụzọ ahịrị atọ, otu nʼelu ibe ya. E mere ka oghereikuku ndị dị nʼelu nʼotu akụkụ chee oghereikuku ndị dị nʼakụkụ nke ọzọ ihu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.4",
            "verseOrgIds": [
              "1KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụzọ niile nwere mbudo ọnụ ụzọ anọ. Ha dị atọ atọ cherịtara ibe ha ihu nʼebe mpụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.5",
            "verseOrgIds": [
              "1KI.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ọnụ ụzọ mbata nke ogidi, nke ruru iri mita na anọ nʼobosara, rukwaa iri mita anọ na ise nʼịdị ogologo. Nʼihu ya, e nwere mpụta ọnụ ụlọ, nʼihu ya, e nwekwara ogidi na elu ebe kpuchiri ekpuchi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwekwara ọnụ ụlọ ọzọ a na-akpọ, Ụlọ Ocheeze, maọbụ Ụlọ Ikpe ziri ezi ebe Solomọn na-anọ ekpe ikpe. E ji osisi sida machie ahụ ya niile, site nʼala ruo nʼelu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.7",
            "verseOrgIds": [
              "1KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ obibi Solomọn dịkwa nʼogige dị nʼazụ ụlọ ikpe a. E wukwara ya dịka e si wuo ụlọ ndị ọzọ. Solomọn wukwaara nwunye ya ụlọ yiri nke ya. Nwanyị a bụ nwa Fero, eze ndị Ijipt, nke Solomọn na-alụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.8",
            "verseOrgIds": [
              "1KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji nkume dị mma ma dịkwa oke ọnụahịa nke a wara awa na nke a kwadoro nke ọma nʼime na nʼezi dịka ọtụtụ si dị, wuo ụlọ ndị a. Site na ezi ruo nʼogige ukwu ahụ ma sitekwa na ntọala ruo nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.9",
            "verseOrgIds": [
              "1KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkume e ji tọọ ntọala ụlọ ndị a bụ nkume buru ibu, ndị dị ezi mma. Ụfọdụ nʼime nkume ndị a ruru mita anọ na ọkara nʼogologo, ndị ọzọ dị mita atọ na ụma isii.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu nkume ndị a ka e doro nkume ndị ọzọ, ndị dị ezi mma, a waziri awazi dịka ọtụtụ si dị. Emesịa, e dokwara osisi sida nʼelu ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.11",
            "verseOrgIds": [
              "1KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogige ukwu ahụ bụ nke eji ahịrị nkume atọ a wara awa dịkwasịrị nʼelu ibe ya gbaa gburugburu, otu ahịrị bụ nke sida a wara awa dịka ọ dị nʼime ime ogige ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.12",
                "verseOrgIds": [
                  "1KI.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, ya na mpụta ọnụ ụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe ndị e ji chọọ ụlọnsọ ukwu mma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn zigara ozi na Taịa, ka a kpọta Huram.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.13",
            "verseOrgIds": [
              "1KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nne Huram bụ nwanyị si nʼebo Naftalị nke di ya nwụrụ anwụ, ma nna ya bụ onye Taịa, onye maara ǹka dị nʼịkpụ bronz. Huram jupụtara nʼamamihe na nghọta nʼihe ọmụma ịrụ ọrụ ọbụla metụtara bronz. Ọ bịakwutere eze bụ Solomọn, rụọkwa ọrụ niile enyere ya ịrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.14",
            "verseOrgIds": [
              "1KI.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogidi bronz abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụrụ ogidi bronz abụọ, nke ọtụtụ ya ruru mita asatọ na otu ụma nʼogologo, na mita ise na ụma anọ gburugburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụkwara ihe ọkpụkpụ bronz, nke isi ya yiri ọnụ ite mmiri. A dọkwasịrị ha nʼelu ogidi ọla abụọ ahụ. Otu nʼime ihe ọkpụkpụ bronz abụọ ndị a dị ihe ruru mita abụọ na ụma atọ nʼogologo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwekwara ihe e ji chọọ ha mma. Ọ bụ ọla akpara akpa, nke yiri ụdọ a tụrụ atụ ka e ji chọọ ha mma. Asaa dị nʼotu ihe ọkpụkpụ ọla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.17",
            "verseOrgIds": [
              "1KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụrụ ihe yiri mkpụrụ pomegranet, nke dị nʼahịrị abụọ, nke o ji gbaa ihe ịchọ mma ndị ahụ gburugburu, maka iji ha chọọ ihe ọkpụkpụ ọla ndị ahụ dị nʼelu ogidi ndị ahụ mma. O mere otu ihe a maka ihe ọkpụkpụ ọla ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.18",
            "verseOrgIds": [
              "1KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọkpụkpụ ọla ndị dị nʼelu ogidi dị na mgbe ụlọ ka o mere ka ha yie okoko osisi lili. Ịdị elu ha ruru otu mita na ụma asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu ihe ọkpụkpụ ọla dị nʼogidi abụọ ahụ, nʼelu elu ha, ebe ahụ yiri ọnụ ite mmiri nke dị nʼakụkụ ihe ọkpụkpụ ọla ahụ, e nwere ihe yiri narị mkpụrụ pomegranet abụọ e doro nʼahịrị nʼahịrị gburugburu ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.20",
            "verseOrgIds": [
              "1KI.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O guzobere ogidi abụọ ndị ahụ na mgbe ọnụ ụzọ ụlọnsọ ukwu ahụ. Ogidi nke dị na ndịda ka ọ kpọrọ Jakin, ma nke dị nʼugwu ka ọ kpọrọ Boaz.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọkpụkpụ ọla dị nʼelu ogidi ndị a bụ nke yiri okoko osisi lili. Ọ bụ nʼụzọ dị otu a ka e si rụzuo ọrụ niile metụtara ogidi ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.22",
            "verseOrgIds": [
              "1KI.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke osimiri eji ọla kpụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mekwara Oke osimiri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "text": "nke ọla awụrụ awụ, nke dị gburugburu nʼụdịdị. Ọtụtụ ya bụ mita abụọ na ụma atọ nʼogologo, dịkwa mita ise na ụma atọ, site nʼotu ọnụ ruo nʼọnụ nke ọzọ. Ọ bụ eriri e ji atụ ihe ruru ihe dịka mita iri na anọ ka e ji tụọ ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼokpuru ọnụ ya, oyiyi ọba gbara ya gburugburu, iri dị na mita anọ na ọkara ọbụla. Ọba ndị a dị nʼahịrị abụọ, awụkọtara ha na Oke osimiri ahụ otu mgbe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.24",
            "verseOrgIds": [
              "1KI.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mekwara ka Oke osimiri ahụ guzo nʼelu ehi iri na abụọ. Atọ na-eche ihu nʼakụkụ ọwụwa anyanwụ; atọ na-eche ihu nʼọdịda anyanwụ; atọ na-eche ihu nʼakụkụ ndịda, atọ na-eche ihu nʼakụkụ ugwu. Oke osimiri ahụ dịkwasịrị ha nʼelu, ebe azụ ha niile dị nʼime nʼetiti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.25",
            "verseOrgIds": [
              "1KI.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ ya ha ka otu ọtụtụ ntu-aka dimkpa. E mere ọnụ ya ka ọ dị ka ọnụ iko mmiri, dịkwa ka okoko lili na-awapụta awapụta. Ọ na-erite puku galọọnụ iri na abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe ndọkwasị bronz",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mekwara ihe ndọkwasị bronz iri, nke e nwere ike ịkpụgharị akpụgharị. Mita abụọ ka ogologo nke otu ihe ndọkwasị ọbụla dị, mita abụọ ka obosara ya dịkwa; ịdị elu ya dị otu mita na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndọkwasị ahụ nwere ihe e ji jikọta ya dị nʼetiti ya. Otu a ka e si mee ihe ndọkwasị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.28",
            "verseOrgIds": [
              "1KI.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu ihe njikọta ahụ ka a wụrụ oyiyi dị iche iche, dịka ọdụm, na oke ehi, na ndị mmụọ ozi cherubim nwere nku. Nʼelu, na nʼokpuru ọdụm, na oke ehi ndị ahụ, a wụkwara ahịhịa na okoko osisi dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.29",
            "verseOrgIds": [
              "1KI.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ihe ndọkwasị ọbụla nwere ụkwụ bronz anọ dị gburugburu, nweekwa okporo bronz ebe ụkwụ ndị a na-agbagharị. Nʼakụkụ anọ nke ihe ndọkwasị ndị a, a rụnyere ebe a na-adọkwasị efere. E ji oyiyi okoko osisi na ahịhịa chọọ ihe ndị a mma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.30",
            "verseOrgIds": [
              "1KI.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ihe ndọkwasị ahụ, e nwere oghere nke nwere ọnụ dị gburugburu nke ịdị omimi ya bụ sentimita iri anọ na ise. Oghere a dị gburugburu, nwee ebe ndọkwasị nʼokpuru ya nke dị sentimita iri isii na asatọ nʼọtụtụ. Oyiyi ihe apịrị apị dịkwa gburugburu ọnụ ya. Ihe njikọta ha niile nwere akụkụ anọ nke ha nʼotu, ha adịghị gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-adọkpụgharị ihe ndọkwasị a nʼụkwụ anọ o nwere. A dụnyekọtakwara ụkwụ anọ ndị a nʼime okporo ọla e mekọtara ya na ihe ndọkwasị ahụ. Ịdị elu nke ụkwụ ọbụla bụ iri sentimita isii na asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.32",
            "verseOrgIds": [
              "1KI.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mekwara ụkwụ ndị a dịka ụkwụ ụgbọala nke ịnyịnya na-adọkpụ. Ọ bụkwa ọla ka e ji kpụọ akụkụ ihe ndọkwasị ahụ niile, ma okporo igwe ukwu, ma okporo igwe nta, na ihe niile jikọtara ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.33",
            "verseOrgIds": [
              "1KI.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụkwụ ọla nta anọ dịkwa nʼokpuru ihe ndọkwasị ahụ, nʼakụkụ ọbụla. A wụkọtakwara ha na ihe ndọkwasị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.34",
            "verseOrgIds": [
              "1KI.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere ihe a magidere gburugburu nʼelu ihe ndọkwasị ọbụla, nke omimi ya dị iri sentimita abụọ na ụma atọ. Ọla a, na ụkwụ ya, ka a wụkọtara na ihe ndọkwasị ahụ otu mgbe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.35",
            "verseOrgIds": [
              "1KI.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọbụla ohere dị, o gbunyere oyiyi cherubim nwere nku, na oyiyi ọdụm, na oyiyi osisi nkwụ, nʼahụ ibo ọla ahụ e mere ka ọ dịrị gburugburu elu ihe ndọkwasị ọla ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.36",
            "verseOrgIds": [
              "1KI.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndọkwasị ọla iri ndị ahụ ha otu. Ha yikwara ibe ha, nʼihi na e mere ka ha nwee otu ụdị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.37",
            "verseOrgIds": [
              "1KI.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huram jikwa bronz kpụọ efere ịsa ihe iri. Ogbu efere ọbụla dị mita abụọ na otu ụma, otu efere maka ihe ndọkwasị ọbụla. Mmiri na-eju otu nʼime ha bụ narị galọọnụ mmiri abụọ na iri anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dọnyere ihe ndọkwasị ọla ise nʼakụkụ ndịda ụlọnsọ ukwu ahụ, dọnyekwa ihe ndọkwasị ọla ise nke ọzọ nʼakụkụ ugwu. Ọ dọbara ihe ichenye mmiri ukwu ahụ nʼakụkụ ndịda, nʼihu ọwụwa anyanwụ nke ụlọnsọ ahụ, nʼebe chere ihu na ndịda.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụkwara ite dị iche iche, shọvel niile, na efere ịkwọsa mmiri niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:40"
      },
      "items": [
        {
          "text": "Nʼikpeazụ, ọ rụchara ọrụ niile dị nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.40",
                "verseOrgIds": [
                  "1KI.7.40"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke eze Solomọn tinyere ya nʼaka ịrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogidi abụọ ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "ihe ọkpụkpụ abụọ dịka efere dị nʼelu ogidi abụọ ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "ihe ọkpụkpụ yiri ụdọ a tụrụ atụ nke e ji chọọ ihe ọkpụkpụ abụọ ahụ dịka efere mma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narị anọ nke mkpụrụ pomegranet a kpụrụ akpụ maka ahịrị ihe abụọ ahụ a kpụrụ akpụ, ya bụ, ahịrị pomegranet abụọ nʼihi otu ihe ọkpụkpụ, iji chọọ ihe ọkpụkpụ ahụ yiri efere dị nʼisi elu ogidi ahụ mma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.42",
            "verseOrgIds": [
              "1KI.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndọkwasị iri na efere ịsa mmiri iri nke dọkwasịrị nʼelu ha;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.43",
            "verseOrgIds": [
              "1KI.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Oke osimiri ahụ na oke ehi iri na abụọ ahụ dị ya nʼokpuru;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ite niile, shọvel niile na efere ịkwọsa mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 7:45"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:45"
      },
      "items": [
        {
          "text": "Ihe ndị a niile nke Huram meere eze Solomọn nʼihi ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.45",
                "verseOrgIds": [
                  "1KI.7.45"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ bronz na-egbu maramara ka eji mee ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼala ụrọ, nʼobosara ala Jọdan, nʼetiti Sukọt na Zaretan ka eze mere ka a nọrọ kpụọ ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
            "verseOrgIds": [
              "1KI.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Solomọn atụghị ihe ndị a niile a kpụrụ nʼihe ọtụtụ, nʼihi na ha dị ọtụtụ nʼọnụọgụgụ, achọpụtaghịkwa ịdị arọ nke bronz ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
            "verseOrgIds": [
              "1KI.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn mekwara ngwongwo niile dị nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.48",
                "verseOrgIds": [
                  "1KI.7.48"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya bụ:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 7:48"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:48"
      },
      "items": [
        {
          "text": "ebe ịchụ aja e ji ọlaedo kpụọ,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:48"
      },
      "items": [
        {
          "text": "tebul ọlaedo nke a dọkwasịrị achịcha nke iche nʼIhu Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "E jikwa ọlaedo a nụchara anụcha kpụọ ihe ịdọkwasị oriọna, ise nʼakụkụ aka nri, ise nʼakụkụ aka ekpe,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        },
        {
          "text": "nʼihu ime ime ebe nsọ;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:49"
      },
      "items": [
        {
          "text": "tinyere ihe ịchọ mma oyiyi okoko osisi, na oriọna niile, na ihe ịgụta ihe niile;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "na efere ọlaedo a nụchara anụcha dị iche iche, na ihe ịkpakepụ ọkụ niile, na efere ịkwọsa mmiri, na ngaji na ihe ịgụ ọkụ;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
            "verseOrgIds": [
              "1KI.7.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:50"
      },
      "items": [
        {
          "text": "na ihe ikonye ibo nʼihi ibo ọnụụlọ ndị dị nʼime ime, bụ Ebe Kachasị Nsọ, nakwa ibo ndị dị nʼọnụ ụzọ ụlọ ezumezu nke ụlọnsọ ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.50",
            "verseOrgIds": [
              "1KI.7.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a rụzuru ọrụ niile nke eze Solomọn nwere ịrụ maka ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.51",
            "verseOrgIds": [
              "1KI.7.51"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.51",
                "verseOrgIds": [
                  "1KI.7.51"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, o webatara ihe niile Devid bụ nna ya doro nsọ nʼime ya, ya bụ ọlaọcha, ọlaedo na ngwongwo ndị ọzọ niile. O tinyere ha nʼụlọakụ dị nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.51",
            "verseOrgIds": [
              "1KI.7.51"
            ]
          }
        },
        {
          "name": "char",
