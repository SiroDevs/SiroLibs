  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1KI 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịlaịja agbaga nʼugwu Horeb",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehab kọọrọ Jezebel ihe niile Ịlaịja mere, na otu o si jiri mma agha gbuo ndị amụma Baal niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.1",
            "verseOrgIds": [
              "1KI.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Jezebel zigara onyeozi ka ọ ga zie Ịlaịja sị, \"Ka chi ndị a mesoo m mmeso, nʼagbanyeghị otu mmeso ahụ si dị njọ, ma ọ bụrụ na oge dịka oge a echi, egbughị gị dịka i si gbuo ndị amụma Baal.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja tụrụ egwu, gbapụ ọsọ, nʼihi ichebe ndụ ya. Mgbe ọ bịaruru Bịasheba, dị na Juda, ọ hapụrụ nwokorobịa na-ejere ya ozi nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ya onwe ya pụkwara jee ije otu ụbọchị nʼọzara naanị ya. Nʼikpeazụ, ọ kwụsịrị nọdụ ala nʼokpuru otu osisi brum, kpee ekpere rịọọ ka a napụ ya ndụ ya. Ekpere o kpere nʼoge a bụ, \"O zuorela m",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.4",
                "verseOrgIds": [
                  "1KI.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", biko napụ ndụ m. O nweghị ụzọ m si dị mma karịa nna nna m ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O dinara nʼokpuru osisi brum rahụ ụra.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:5"
      },
      "items": [
        {
          "text": "Ma lee, otu oge ahụ, mmụọ ozi metụrụ ya aka, sị ya, \"Bilie, rie nri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja biliri legharịa anya, hụ ogbe achịcha na ite mmiri nta nke dị nʼakụkụ ebe ọ tụkwasịrị isi ya. O riri ogbe achịcha ahụ a hụrụ nʼicheku ọkụ, ṅụọkwa mmiri ahụ. Emesịa, o dinakwara ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi nke",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.7",
                "verseOrgIds": [
                  "1KI.19.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bịaghachikwara nke ugboro abụọ, sị ya, \"Bilie rie ihe, nʼihi na ije dị gị nʼihu dị ukwuu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja biliri rie ihe, ṅụọkwa mmiri. Nri ahụ nyere ya ike ije ije iri ụbọchị anọ ọzọ, ehihie na abalị, tutu ruo mgbe ọ bịaruru nʼugwu Horeb",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        },
        {
          "text": "nke bụ ugwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, ọ banyere nʼotu ọgba nkume rahụ ụra abalị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1KI 19:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "apụta ìhè nye Ịlaịja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:9"
      },
      "items": [
        {
          "text": "Ma okwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.9",
                "verseOrgIds": [
                  "1KI.19.9"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere ya sị, \"Ịlaịja, gịnị ka ị na-eme nʼebe a?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zaghachiri sị, \"Eji m ịnụ ọkụ nʼobi na-ejere",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.10",
            "verseOrgIds": [
              "1KI.19.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.10",
                "verseOrgIds": [
                  "1KI.19.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile ozi. Ndị Izrel ajụla ọgbụgba ndụ gị, tidasịakwa ebe ịchụ aja gị, were mma agha gbukwaa ndị amụma gị niile, ugbu a, ọ bụ naanị mụ onwe m bụ onye fọdụrụ, ma ha na-achọkwa iwepụ ndụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.10",
            "verseOrgIds": [
              "1KI.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.11",
                "verseOrgIds": [
                  "1KI.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị ya, \"Pụọ gaa guzo nʼelu ugwu, nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.11",
                "verseOrgIds": [
                  "1KI.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.11",
                "verseOrgIds": [
                  "1KI.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na-aga isite nʼebe ahụ gafee.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:11"
      },
      "items": [
        {
          "text": "Mgbe ahụ, oke ifufe dị ike gbawara ugwu ahụ, tipịasịa nkume ndị ahụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.11",
                "verseOrgIds": [
                  "1KI.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.11",
                "verseOrgIds": [
                  "1KI.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "anọghị nʼime ifufe ahụ. Mgbe ifufe ahụ gasịrị, e nwere oke ala ọma jijiji nʼugwu ahụ, ma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.11",
                "verseOrgIds": [
                  "1KI.19.11"
                ]
              }
            }
          ]
        },
        {
          "text": "anọkwaghị nʼala ọma jijiji ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.11",
            "verseOrgIds": [
              "1KI.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ala ọma jijiji ahụ gasịrị, ọkụ nwuuru, ma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.12",
                "verseOrgIds": [
                  "1KI.19.12"
                ]
              }
            }
          ]
        },
        {
          "text": "anọghị nʼime ọkụ ahụ. Ma mgbe ọkụ ahụ gasịrị, nwa olu nta dị nwayọọ dara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.12",
            "verseOrgIds": [
              "1KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ịlaịja nụrụ ya, o ji uwe mwụda ya kpuchie ihu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        },
        {
          "text": "ya, pụọ gaa guzo nʼọnụ ụzọ ọgba nkume ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:13"
      },
      "items": [
        {
          "text": "Mgbe ahụ, ọ nụrụ olu jụrụ ya sị, \"Ịlaịja, gịnị ka ị na-eme nʼebe a?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.13",
            "verseOrgIds": [
              "1KI.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zaghachiri sị, \"Eji m ịnụ ọkụ nʼobi na-ejere",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.14",
                "verseOrgIds": [
                  "1KI.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile ozi. Ndị Izrel ajụla ọgbụgba ndụ gị, tidasịakwa ebe ịchụ aja gị, were mma agha gbukwaa ndị amụma gị niile, ugbu a ọ bụ naanị mụ onwe m bụ onye fọdụrụ, ma ha na-achọkwa iwepụ ndụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.14",
            "verseOrgIds": [
              "1KI.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.19.15",
                "verseOrgIds": [
                  "1KI.19.15"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị ya, \"Sikwa ụzọ i si bịa laghachi, gaa nʼọzara Damaskọs. Mgbe i ruru ebe ahụ, tee Hazael mmanụ ịbụ eze Aram.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teekwa Jehu, nwa Nimshi mmanụ ịbụ eze Izrel. Ị ga-etekwa Ịlaisha nwa Shafat, onye Ebel-Mehola mmanụ ịbụ onye amụma nʼọnọdụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla gbanarịrị Hazael ga-anwụ nʼaka Jehu. Otu a kwa, ndị niile gbanarịrị mma agha Jehu ka Ịlaisha ga-egbu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ghọta na ọ dị puku mmadụ asaa nọ nʼIzrel, ndị na-egbubeghị ikpere ha nʼala nye Baal, maọbụ sutu ya ọnụ, ife ya ofufe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ Ịlaisha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja sitere nʼebe ahụ pụọ gaa chọta Ịlaisha nwa Shafat ebe ọ nọ na-akọ ala ubi. Iri ehi abụọ na anọ e jikọtara abụọ abụọ dị ya nʼihu, ma ya onwe ya ji ehi abụọ e jikọtara ọnụ, nke iri na abụọ ya na-akọ ala ubi. Ịlaịja jekwuru Ịlaisha wụkwasị ya uwe mwụda ya nʼubu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.19",
            "verseOrgIds": [
              "1KI.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ịlaisha hapụrụ ehi ndị ahụ ebe ha guzoro nʼubi ahụ gbara ọsọ gbakwuru Ịlaịja sị ya, \"Biko, kwere ka m gaa sutu nna m na nne m ọnụ, sị ha nọdụ nke ọma. Emesịa, aga m esokwa gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 19:20"
      },
      "items": [
        {
          "text": "Ịlaịja zara sị ya, \"Laghachi azụ, ọ bụ gịnị ka m mere gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha laghachiri azụ, gbuo ehi abụọ ahụ e jikọtara nʼotu, kpọọ ihe ahụ e ji arụ ọrụ nʼubi ọkụ, were ha sie anụ ahụ nye ndị mmadụ, ha rie. Mgbe ahụ, o biliri ije pụọ ga soro Ịlaịja, bụrụ nwaodibo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.21",
            "verseOrgIds": [
              "1KI.19.21"
            ]
          }
        }
      ]
    }
  ],
