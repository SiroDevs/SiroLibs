  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubi Nebọt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwa oge nta gasịrị, Nebọt, onye Jezril, nwere ubi vaịnị dị na Jezril, nʼakụkụ ụlọeze Ehab bụ eze Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.1",
            "verseOrgIds": [
              "1KI.21.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.1",
            "verseOrgIds": [
              "1KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehab sịrị Nebọt, \"Nye m ubi vaịnị gị ka ọ bụrụ ubi a gbara ogige, ebe m ga-akụ akwụkwọ nri, ebe ọ dị nso nʼụlọeze m. Aga m enye gị ubi vaịnị ọzọ dị mma karịa ya, ma ọ bụrụkwa na ị chọrọ, aga m akwụ gị ego ọbụla o ruru nʼọnụ ahịa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.2",
            "verseOrgIds": [
              "1KI.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Nebọt zara sị Ehab, \"Ala a bụ ihe nketa ruuru m site nʼaka nna nna m ha. M ga-esi aṅaa nye gị ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.3",
                "verseOrgIds": [
                  "1KI.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwela na m ga-ewere ihe nketa nke nna nna m ha nye gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehab jiri obi ụfụ na ihu mgbarụ laa nʼụlọ ya nʼihi okwu a Nebọt, onye Jezril gwara ya, sị, \"Agaghị m enye gị ihe nketa nna nna m ha.\" O dinara nʼihe ndina ya, chee ihu ya nʼaja ụlọ, jụ iri ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.4",
            "verseOrgIds": [
              "1KI.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwunye ya bụ Jezebel, bịakwutere ya jụọ ya sị, \"Gịnị mere i ji jụ iri ihe? Gịnị mere i ji nọgide nʼobi ọjọọ na iwe?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.5",
            "verseOrgIds": [
              "1KI.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehab zara sị ya, \"Agwara m Nebọt, nwoke onye Jezril okwu sị ya, 'Resi m ubi vaịnị gị, ma ọ bụrụ na ị chọrọ, aga m enye gị ala ubi ọzọ mara mma nʼọnọdụ ya.' Ma ọ jụrụ jụwaa isi inye m ubi ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.6",
            "verseOrgIds": [
              "1KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nwunye ya Jezebel jụrụ ya ajụjụ sị ya, \"Ọ bụghị gị bụ eze na-achị Izrel? Bilie, rie nri, enyela obi gị nsogbu, nʼihi na aga m enyefe gị ubi vaịnị Nebọt onye Jezril nʼaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.7",
            "verseOrgIds": [
              "1KI.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Jezebel dere akwụkwọ nʼaha Ehab, were mgbaaka akara eze kaa nʼakwụkwọ ndị ahụ, zigara ha ndị okenye obodo na ndị a na-asọpụrụ bi nʼobodo ebe Nebọt bi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.8",
            "verseOrgIds": [
              "1KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime akwụkwọ ozi ndị a, o dere sị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 21:9"
      },
      "items": [
        {
          "text": "\"Nyenụ iwu ka mmadụ niile buo ọnụ. Kpọkọtaanụ ndị Jezril niile, ka ha zukọta. Mgbe unu zukọrọ, nyenụ Nebọt ọnọdụ nʼoche dị mkpa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Họpụtanụ ndị ikom abụọ, ndị na-abaghị uru ka ha pụta nʼihu nzukọ unu guzo gbaa ama ụgha megide Nebọt sị na ha nụrụ mgbe ọ kọchara Chineke na eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        },
        {
          "text": "Maanụ ya ikpe ọnwụ, kpụpụ ya nʼazụ obodo, jiri nkume tugbuo ya, ka ọ nwụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị okenye na ndị a na-asọpụrụ ndị bi nʼobodo ahụ mere dịka Jezebel nyere nʼiwu nʼakwụkwọ ahụ o degaara ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.11",
            "verseOrgIds": [
              "1KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nyere iwu maka ibu ọnụ, kpọọkwa nzukọ ndị obodo ahụ niile, meekwa ka Nebọt nọdụ nʼoche dị mkpa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.12",
            "verseOrgIds": [
              "1KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ikom abụọ na-abaghị uru pụtakwara, nọdụ na ncherita ihu ya, ha gbara ama ụgha megide Nebọt, nʼihu ndị mmadụ, sị, \"Nebọt kọchara Chineke na eze.\" Nʼihi nke a, ha dọkpụụrụ ya gaa nʼazụ obodo jiri nkume tugbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.13",
            "verseOrgIds": [
              "1KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ndị okenye na ndị a maara aha ha nke obodo Jezril, ziri ozi zigara Jezebel gwa ya na Nebọt anwụọla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa Jezebel natara ozi na a tụgbola Nebọt, ọ sịrị Ehab, \"Bilie, gaa nwetara onwe gị ubi vaịnị Nebọt, nwoke onye Jezril. Ubi ahụ ọ jụrụ inye gị nʼego abụrụla nke gị ugbu a nʼihi na Nebọt anwụọla. Ọ dịkwaghị ndụ ọzọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ehab nụrụ na Nebọt anwụọla, o biliri pụọ, gaa ịbanye nʼubi ahụ, inwetara onwe ya ubi vaịnị Nebọt, onye Jezril.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma okwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.17",
                "verseOrgIds": [
                  "1KI.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere Ịlaịja, onye Tishbe, sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bilie, gaa zute Ehab, eze Izrel onye bi na Sameria. Ọ nọ ugbu a nʼime ubi vaịnị Nebọt inwetara ya onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
            "verseOrgIds": [
              "1KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ya sị ya, 'Ihe a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.19",
                "verseOrgIds": [
                  "1KI.21.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: I gbuola ọchụ mmadụ si otu a nwetara onwe gị ihe nketa? Ebe ahụ nkịta nọ rachaa ọbara Nebọt ka ha ga-anọ rachaakwa ọbara gị. E, ọbara gị onwe gị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ehab jụrụ Ịlaịja ajụjụ sị ya, \"Onye iro m, ị chọrọkwala m bịa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 21:20"
      },
      "items": [
        {
          "text": "Ịlaịja zara sị ya, \"E, achọrọla m gị bịa nʼihi nnyefe i nyefere onwe gị ime ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.20",
                "verseOrgIds": [
                  "1KI.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, 'Aga m eme ka ihe ọjọọ dakwasị gị. Aga m ekpochapụ ndị agbụrụ gị, site nʼezinaụlọ Ehab bipụ nwoke ọbụla, maọbụ ohu maọbụ onyenwe onwe ya nʼIzrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.21",
            "verseOrgIds": [
              "1KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ụlọ gị dịrị ka nke Jeroboam nwa Nebat, na dịka nke Baasha nwa Ahija, nʼihi na ị kpasuola m iwe, meekwa ka Izrel mehie.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.22",
            "verseOrgIds": [
              "1KI.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma banyere Jezebel,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.23",
                "verseOrgIds": [
                  "1KI.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, 'Ụmụ nkịta ga-eri anụ ahụ Jezebel nʼakụkụ mgbidi aja ụlọ dị nʼobodo Jezril.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nkịta ga-eri anụ onye ọbụla si nʼezinaụlọ Ehab nke nwụrụ nʼime obodo, ma anụ ufe nke eluigwe ga-eri anụ ndị ọbụla nwụrụ nʼọhịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nʼezie, o nweghị onye ọbụla ọzọ dị ka Ehab, onye rere onwe ya nye ime ihe ọjọọ dị ukwuu nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.25",
                "verseOrgIds": [
                  "1KI.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye Jezebel nwunye ya kwagidere ime ihe ọjọọ dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehab bụ onye mere mmehie dị oke njọ nke ịgbaso na ife arụsị dị iche iche ofufe dịka ndị Amọrait",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "text": "mere, bụ ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.26",
                "verseOrgIds": [
                  "1KI.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼala a chụpụ ime ka ndị Izrel nweta ala ha.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ehab nụrụ okwu amụma ndị a, ọ dọwara uwe ya, yikwasị onwe ya akwa mkpe, buo ọnụ, dinaa nʼakwa mkpe ahụ, jegharịakwa nʼịdị umeala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma okwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.28",
                "verseOrgIds": [
                  "1KI.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere Ịlaịja, onye Tishbe ọzọ, sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị hụrụ otu Ehab si weda onwe ya ala nʼihu m? Nʼihi ihe a o mere, iweda onwe ya ala nʼihu m, agaghị m eme ka ihe ọjọọ ndị a m kwuru okwu banyere ha rute ya nʼoge ọ dị ndụ. Kama aga m eme ka ihe ndị a dakwasị ezinaụlọ ya mgbe nwa ya ga-achị dịka eze.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
    }
  ],
