  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1KI 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọtụtụ ndị inyom Solomọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze Solomọn hụrụ ọtụtụ ndị inyom mba ọzọ nʼanya, tinyere nwa nwanyị Fero, ha bụ ndị inyom ndị Moab, ndị Amọn, ndị Edọm, ndị Saịdọn na ndị Het.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ ndị sitere na mba ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.2",
                "verseOrgIds": [
                  "1KI.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Izrel sị, \"Unu na ha agaghị alụrịtakwa di na nwunye, nʼihi na ha aghaghị ime ka obi unu gbasoo chi niile ha.\" Ma, nʼagbanyeghị nke a, Solomọn rapara ha nʼahụ nʼihi ịhụnanya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ndị inyom Solomọn lụrụ dị narị asaa, bụ ndị amụrụ nʼobi ndị eze. O nwekwara ndị iko nwanyị, ọnụọgụgụ ha dị narị atọ. Ndị inyom ya duhiere obi ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Solomọn ghọrọ agadi, ndị inyom ndị a duhiere obi ya mee ka ọ gbasoo chi ndị ọzọ, nke mere na o jikwaghị obi ya niile gbasoo",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.4",
                "verseOrgIds": [
                  "1KI.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya, dịka Devid bụ nna ya mere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbasoro Ashtọret, bụ chi ndị Saịdọn na Molek,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "text": "bụ chi rụrụ arụ nke ndị Amọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, Solomọn mere ihe ọjọọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.6",
                "verseOrgIds": [
                  "1KI.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". O soghị ụzọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.6",
                "verseOrgIds": [
                  "1KI.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka nna ya Devid si mee nʼụbọchị niile nke ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu ugwu dị nʼọwụwa anyanwụ Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "text": "Solomọn wuru ebe dị elu nye Kemosh, chi rụrụ arụ nke ndị Moab, wuokwara Molek chi rụrụ arụ nke ndị Amọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mekwara otu ihe ahụ nye ndị nwunye ya niile si mba ọzọ, bụ ndị na-achụ aja nsure ọkụ ihe na-esi isi ụtọ, na-achụkwa aja nsure ọkụ dị iche iche nye chi niile ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.9",
                "verseOrgIds": [
                  "1KI.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "were iwe dị ukwuu megide Solomọn, nʼihi na obi ya esitela nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.9",
                "verseOrgIds": [
                  "1KI.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Izrel nọ pụọ, bụ onye mere ka ọ hụ ya anya ugboro abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na o nyere Solomọn iwu ka ọ ghara ịgbaso chi ndị ọzọ, ma Solomọn erubeghị isi nʼiwu a",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.10",
                "verseOrgIds": [
                  "1KI.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.11",
                "verseOrgIds": [
                  "1KI.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Solomọn okwu sị, \"Ebe ọ bụ na i mere ihe dị otu a, jụ idebe ọgbụgba ndụ m na ụkpụrụ m, nke m nyere gị idebe, aghaghị m isite nʼaka gị dọkapụ alaeze a, were ya nye otu nʼime ndị na-ejere gị ozi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼihi nna gị Devid agaghị m eme ihe ndị a mgbe ị dị ndụ. Aga m anapụ nwa gị nwoke alaeze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma agaghị m anapụcha ya alaeze Izrel niile, kama aga m eme ka ọ bụrụ eze otu ebo Izrel, nʼihi Devid, na nʼihi Jerusalem, obodo m họpụtara nye onwe m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị iro Solomọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.14",
                "verseOrgIds": [
                  "1KI.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka onye iro bilie megide Solomọn. Onye a bụ Hadad onye Edọm, onye sikwa nʼezinaụlọ ndị eze Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge gara aga, mgbe Devid na-ebuso ndị Edọm agha, Joab, onyeisi ndị agha, onye gara ili ndị agha e gburu egbu, tigburu ndị ikom niile nọ nʼEdọm.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15",
            "verseOrgIds": [
              "1KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab na ndị agha Izrel niile nọgidere nʼebe ahụ ọnwa isii, tutu ruo mgbe ha gbuchapụrụ ndị ikom niile nọ nʼEdọm.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.16",
            "verseOrgIds": [
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Hadad, onye bụ nwantakịrị nʼoge ahụ, gbapụrụ ọsọ gbaga Ijipt, ya na ụfọdụ ndịisi ọchịchị Edọm, ndị jeere nna ya ozi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sitere nʼala Midia gaa Paran. Site na Paran, ha duuru ụfọdụ ndị mmadụ, ndị sooro ha gaa Ijipt, jekwuru Fero eze Ijipt, onye nyere Hadad ụlọ obibi na ala, nyekwa ya ihe oriri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadad hụtara amara nʼihu Fero, nke mere na ọ kpọnyere ya nwanne nwanyị Tapenes bụ nwunye eze ka ọ bụrụ nwunye ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanne Tapenes mụtara ya nwa nwoke aha ya bụ Genubat, onye Tapenes zụlitere nʼụlọeze. Genubat biri nʼetiti ụmụ Fero.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hadad nọ nʼIjipt, ọ nụrụ na Devid sooro ndị nna nna ya ha dina nʼọnwụ na Joab ọchịagha ndị agha anwụọkwala, ọ rịọrọ Fero arịrịọ ka o kwenye ka ọ laghachi nʼEdọm.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero jụrụ ya ajụjụ sị ya, \"Gịnị mere i ji chọọ ịla? O nwere ihe ị chọrọ nke ị na-adịghị enweta nʼebe a?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 11:22"
      },
      "items": [
        {
          "text": "Hadad zara sị ya, \"O nweghị ihe kọrọ m, kama kwere ka m laghachi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ọzọ Chineke mere ka ọ bụrụ onye iro Solomọn bụ Rezon nwa Eliada, onye gbapụrụ site nʼaka nna ya ukwu bụ Hadadeza, eze Zoba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid lara ndị agha Zoba nʼiyi, Rezon chịkọtara ndị ikom gbara ya gburugburu, ghọọ onyendu ha, ndị nnupu isi a gara Damaskọs biri nʼebe ahụ, na-achịkwa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo ụbọchị niile nke ndụ Solomọn, Rezon bụ onye iro Izrel, tinyekwara nsogbu nke Hadad wetaara Izrel. Rezon bụ eze ndị Aram, bụrụkwa onye na-emegide Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nnupu isi Jeroboam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam nwa Nebat, onye Ifrem nke Zereda, otu nʼime ndị ozi Solomọn, biliri megide eze. Nne ya bụ Zerua, nwanyị di ya nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere otu o siri bilie imegide eze: Solomọn wugharịrị Milo, wuziekwa ntipu dị na mgbidi obodo Devid bụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a Jeroboam, nʼonwe ya, bụ dimkpa. Mgbe Solomọn hụrụ otu nwokorobịa a si arụzi ọrụ ya nke ọma, o mere ya onye nlekọta ndị ọrụ niile si nʼezinaụlọ Josef.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ụbọchị, mgbe Jeroboam si Jerusalem na-apụ, o zutere Ahija onye amụma, onye Shilo, nʼụzọ, ebe o yi uwe ọhụrụ. Ọ bụkwa naanị ha abụọ nọ nʼọhịa mgbe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ahija yipụrụ uwe ọhụrụ nke o yi nʼahụ dọwasịa ya ụzọ iri na abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ gwara Jeroboam sị, \"Chịrị iberibe iri nye onwe gị, nʼihi na otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.11.31",
                "verseOrgIds": [
                  "1KI.11.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel sịrị, 'Lee, aga m anapụ Solomọn alaeze a, ma aga m enyekwa gị ebo iri nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m ahapụrụ ya otu ebo, nʼihi ohu m Devid na nʼihi Jerusalem obodo m họpụtara site nʼebo niile nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha ahapụla m malite ịkpọ isiala nye Ashtọret, chi nwanyị ndị Saịdọn; na nyekwa Kemosh, chi ndị Moab; na nye Molek, chi ụmụ Amọn. Ha agbasoghị ụzọ m, ha emekwaghị ihe ndị ahụ m gụrụ dịka ezi ihe. Ha edebeghị iwu m na ụkpụrụ m niile dịka Devid nna Solomọn mere.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma agaghị m anapụ alaeze ya ugbu a, nʼihi ohu m Devid, onye m họpụtara, na onye mere ihe tọrọ m ụtọ. Aga m ahapụ Solomọn ka ọ nọgide dịka eze ụbọchị ndụ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m anapụ alaeze ya site nʼaka nwa ya, nye gị ebo iri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa ya ka m ga-enye otu ebo, nʼihi na achọrọ m ka Devid ohu m nọgide ịbụ eze Jerusalem, obodo m họpụtara nye onwe m, ebe m mere ka Aha m dịrị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, gị ka m ga-ewere. Ị ga-abụkwa onye ga-achị ebe ahụ niile obi gị chọrọ; i ga-abụ eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i gee ntị mee ihe niile m ga-enye gị nʼiwu, jekwa ije nʼirubere m isi, mee ihe ziri ezi nʼanya m, site nʼidebe ụkpụrụ niile na iwu niile, dịka ohu m Devid mere, aga m anọnyere gị. Aga m ewuru gị ụlọ ga-adịgide dịka m siri wuoro Devid. Aga m enyekwa gị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eweda agbụrụ Devid nʼihi ihe a, ma ha agaghị abụ ndị e wedara nʼala ruo ebighị ebi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn gbalịrị igbu Jeroboam, ma Jeroboam gbaara ọsọ gbakwuru eze Shishak nke Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "text": "Ọ nọkwara nʼIjipt ruo mgbe Solomọn nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Solomọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ mere nʼoge ọchịchị Solomọn, nke bụ, ihe niile o mere na amamihe o gosipụtara, ọ bụ na-edeghị ha nʼakwụkwọ akụkọ nke Solomọn?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn chịrị Izrel niile iri afọ anọ na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sooro nna nna ya ha dina nʼọnwụ, e lie ya nʼobodo Devid bụ nna ya. Rehoboam nwa ya, ghọkwara eze nʼọnọdụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1KI.12",
