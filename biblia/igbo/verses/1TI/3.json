  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1TI 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ndu chọọchị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ okwu kwesiri ntụkwasị obi ma bụrụkwa eziokwu, bụ nke na-asị, ọ bụrụ na onye ọbụla na-achọ ọnọdụ ịbụ ụkọchukwu, ọ na-achọ ezi ọrụ kacha mma.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere onye ụkọchukwu",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "text": "kwesiri ịbụ onye a na-adịghị ata ụta, onye lụrụ otu nwunye, onye obi umeala, onye na-achịkọta onwe ya nke ọma, onye nwere nsọpụrụ, onye na-anabata ndị ọbịa nʼụlọ ya, nakwa onye nwere ike ikuzi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaghị abụ onye na-aṅụbiga mmanya oke, ọ gaghị abụ onye na-alụkarị ọgụ, kama ọ ga-abụ onye dị nwayọọ, onye na-ahụghị okwu na ụka nʼanya, na onye na-adịghị ahụ ego nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ onye na-achịzi ezinaụlọ ya nke ọma, bụrụkwa onye na-achịkwa ụmụ ya inwe nsọpụrụ nʼụzọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nʼihi na ọ bụrụ na mmadụ enweghị ike chịkọtazie ezinaụlọ ya, ọ ga-esi aṅaa chịzie chọọchị Chineke?)",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaghị abụ onye chegharịrị ọhụrụ, ma ọ bụghị ya, ọ ga-afụlị onwe ya elu nʼịnya isi, ma si otu a daba nʼọmụma ikpe dị ka ekwensu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụkwa onye nwere ezi ama nʼebe ndị nọ nʼezi nọ, ka ọ ghara ịdaba nʼọnọdụ ihere nakwa nʼọnya ekwensu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị na-eje ozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ahụ kwa, ndị a họpụtara ijere chọọchị ozi aghaghị ịbụ ndị kwesiri nsọpụrụ, ndị na-enweghị ire abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "text": "ndị kwesiri ntụkwasị obi. Ha agaghị abụ ndị na-aṅụbiga mmanya oke na ndị akpịrị ego na-agbaso uru nʼezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-abụ ndị ji akọnuche dị ọcha na-ejidesi eziokwu nke okwukwe anyị ike.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupu a họpụta ha ịrụ ọrụ a, a ga-ebu ụzọ nwalee ha. Ọ bụrụ na ha enweghị ebubo ọbụla megide ha, mgbe ahụ, a ga-eme ha ndị na-eje ozi na chọọchị.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu aka ahụ kwa, ndị nwanyị kwesikwara ịbụ ndị nwere nsọpụrụ nʼụzọ ọbụla, ndị na-adịghị ebu iro nʼobi, ndị na-adịghị agba asịrị, kama ndị nwere obi umeala, na ndị kwesiri ntụkwasị obi nʼihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile a ga-ahọpụta ije ozi na chọọchị aghaghị ịbụ ndị nwere naanị otu nwunye, ndị na-achịzi ụmụ ha na ezinaụlọ nke aka ha nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị ahụ rụrụ ọrụ ije ozi ha nke ọma nwere ụgwọ ọrụ. Ụgwọ ọrụ ha bụkwa nsọpụrụ ahụ ndị ọzọ ga-asọpụrụ ha, na nkwuwa okwu ha nwere banyere okwukwe a nʼime Kraịst Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe omimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enwere m olileanya na m ga-abịa ileta gị na mgbe na-adịghị anya, ma ana m edere gị ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asị na m enweghị ike bịa ọsịịsọ, ị ga-amata otu ndị mmadụ kwesiri isi bie obi nʼezinaụlọ Chineke, nke bụ nzukọ nke Chineke dị ndụ, ogidi na ntọala nke eziokwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karịchasịa nke a, ọ bụ ihe omimi dị ukwuu, bụ ntọala ebe ezi ịdị nsọ si walite:",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "Ọ pụtara ihe nʼụdịdị mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "Mmụọ Nsọ gosiri na ọ bụ onye ezi omume,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "ndị mmụọ ozi hụrụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "e kwusara ihe banyere ya nye mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "ụwa niile kwenyeere na ya,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1TI 3:16"
      },
      "items": [
        {
          "text": "a nabatakwara ya nʼebube nke eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.16",
            "verseOrgIds": [
              "1TI.3.16"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1TI.4",
    "number": "4",
    "bookId": "1TI"
  },
