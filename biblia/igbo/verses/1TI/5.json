  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1TI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị nwanyị di ha nwụrụ, ndị okenye na ndị ohu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarala okenye mba nʼolu dị ike, kama jiri arịrịọ na nsọpụrụ gwa ya okwu dị ka ọ bụ nna gị. Na-agwa ụmụ okorobịa okwu dị ka ị ga-esi gwa ụmụnne gị ị hụrụ nʼanya okwu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.1",
            "verseOrgIds": [
              "1TI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na-emeso ndị inyom ndị bụ okenye omume dị ka ndị nne, ma na-emesokwa ụmụ agbọghọ omume dị ka ị ga-esi mesoo ụmụnne gị nwanyị omume. Na-echekwa uche nʼịdị ọcha nʼebe o zuruoke.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.2",
            "verseOrgIds": [
              "1TI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọpụrụnụ ụmụ nwanyị di ha nwụrụ, ndị na-ebi ndụ dị ka ndị di ha nwụrụ anwụ nʼeziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.3",
            "verseOrgIds": [
              "1TI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ọ bụrụ na nwanyị ọbụla di ya nwụrụ nwere ụmụ, maọbụ ụmụ ụmụ, ndị a bụ ndị kwesiri ibu mkpa ha. Nʼihi na anyị kwesiri isite nʼụlọ anyị gosi obiọma anyị inyere ndị mụrụ anyị aka. Nʼihi na omume dị otu a na-atọ Chineke ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.4",
            "verseOrgIds": [
              "1TI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị di ya nwụrụ nʼezie, nke na-enweghị onye na-elekọta ya anya, atụkwasịla obi ya na olileanya na Chineke. Ọ na-anọgidekwa nʼekpere na arịrịọ ehihie na abalị.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.5",
            "verseOrgIds": [
              "1TI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwanyị di ya nwụrụ nke weere onwe ya nyefee nʼaka ịgbaso ihe na-eme ya obi ụtọ bụrịị onye nwụrụ anwụ, ọ bụ ezie na ọ ka dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.6",
            "verseOrgIds": [
              "1TI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ha ihe ndị a dịka iwu, ka ha ghara ị bụ ndị a na-ata ụta.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.7",
            "verseOrgIds": [
              "1TI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-adịghị egboro ndị ikwu ya, karịchasịa ndị ezinaụlọ nke aka ya ihe na-akpa ha mkpa, ajụla okwukwe ahụ ma jọkarịakwa onye na-ekweghị ekwe na njọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.8",
            "verseOrgIds": [
              "1TI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị ọbụla di ya nwụrụ ga-aba nʼotu ndị di ha nwụrụ ga-abụ onye gbara iri afọ isii maọbụ karịa. Ọ ga-abụkwa onye lụrụ naanị otu di.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.9",
            "verseOrgIds": [
              "1TI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ onye mmadụ niile na-agbara ezi ama, nʼihi ezi ọrụ ọ rụrụ. Ọ ga-abụ onye zụlitere ụmụ ya nʼụzọ ziri ezi, onye na-elezi ndị ọbịa anya, onye na-enyere ndị ọrịa na ndị merụrụ ahụ aka, onye na-asa ụkwụ ndị nsọ na onye jikeere mgbe niile ime ihe ọma.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.10",
            "verseOrgIds": [
              "1TI.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o kwesighị ka e debanye aha ụmụ agbọghọ di ha nwụrụ nʼotu ụmụ nwanyị di ha nwụrụ anwụ. Nʼihi na mgbe ọchịchọ anụ ahụ jidesiri ha ike, ha ga-enupuru Kraịst isi, chọwa ịlụ di ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.11",
            "verseOrgIds": [
              "1TI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụdị omume a ga-ewetara ha ikpe ọmụma, nʼihi na ha emezughị nkwa ha kwere na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.12",
            "verseOrgIds": [
              "1TI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wezugakwarị nke a, na ha amụta omume ịdị umengwụ, nʼaga nʼụlọ dị iche iche. Ọ bụghị naanị na ha bụ ndị na-adịghị arụ ọrụ, kama ha na-etinye anya nʼihe na-agbasaghị ha, na-akpa asịrị, na-ekwu okwu nzuzu, na-ekwu ihe ha ekwesighị ikwu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.13",
            "verseOrgIds": [
              "1TI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ana m adụ ndị ụmụ agbọghọ ndị a di ha nwụrụ ọdụ ka ha lụrụ di ọzọ, mụọkwa ụmụ, ma na-elekọtazikwa ezinaụlọ ha anya nke ọma. Ọ bụrụ na ha mee nke a, ọ dịghị onye iro ọbụla ga-ekwu okwu ọjọọ megide anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.14",
            "verseOrgIds": [
              "1TI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ ndị mmadụ adahielarị ụzọ, soro ekwensu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.15",
            "verseOrgIds": [
              "1TI.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nwanyị ọbụla kwere ekwe, nke nwere nʼezinaụlọ ya ndị inyom di ha nwụrụ anwụ, ya jisie ike gboro ha mkpa. Ọ dịghị mma ibogbu chọọchị nʼibu, ka o nwee ike iletazu ndị nọ nʼọnọdụ ụmụ nwanyị di ha nwụrụ nʼezie.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.16",
            "verseOrgIds": [
              "1TI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ndị okenye, ndị na-achị nke ọma nsọpụrụ kwesiri ekwesi na ụgwọ ọrụ okpukpu abụọ, ọkachasị ndị na-adọgbu onwe ha nʼọrụ izi oziọma na nʼikuzi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na akwụkwọ nsọ kwuru, \"Ekechila ọnụ ehi mgbe ọ na-azọcha mkpụrụ ọka,\"",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "text": "hapụ ya ka ọ na-eri nri mgbe ọ na-arụ ọrụ, ọzọkwa, \"Onye na-arụ ọrụ kwesiri ịnata ụgwọ ọrụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egela ntị nʼebubo ọjọọ ọbụla a na-ebo onye okenye karịakwa maọbụ na ndị akaebe abụọ maọbụ atọ gbara ama megide ya.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị okenye ahụ nọgidere na-eme mmehie, kpọpụta ha baara ha mba nʼihu mmadụ niile, ka ndị ọzọ tụọ egwu gharakwa iso omume ha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m adọ unu aka na ntị nʼihu Chineke na nʼihu Onyenwe anyị Jisọs Kraịst na nʼihu ndị mmụọ ozi a họpụtara, ka unu debe ụkpụrụ ndị a niile, nye onye ọbụla ntaramahụhụ nke ruru ya, elekwala onye ọbụla anya nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.21",
            "verseOrgIds": [
              "1TI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TI 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikwasịkwala onye ọbụla aka nʼisi ọsịịsọ ime ya okenye maọbụ onye na-eje ozi. Ekwela ka i keta oke na mmehie ndị ọzọ. Debe onwe gị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.22",
            "verseOrgIds": [
              "1TI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TI 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aṅụkwala naanị mmiri ọzọ, na-aṅụ ntakịrị mmanya maka afọ gị na nrịa nrịa nke na-arịa gị ọtụtụ mgbe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.23",
            "verseOrgIds": [
              "1TI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TI 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmehie ụfọdụ mmadụ na-apụta ihe ma na-ebukwa ha ụzọ rụọ oche ikpe, ma ndị ọzọ ka a na-ahụta mmehie ha nʼoge ikpeazụ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.24",
            "verseOrgIds": [
              "1TI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TI 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, ọrụ ọma na-apụta ihe, ma ọ bụladị ndị na-apụtaghị ihe, apụghị izo ha ezo.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.25",
            "verseOrgIds": [
              "1TI.5.25"
            ]
          }
        }
      ]
    }
  ],
