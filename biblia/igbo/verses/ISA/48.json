      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụ gị gaara amụba dịka aja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:19"
      },
      "items": [
        {
          "text": "ụmụ unu gaara a dị ka mkpụrụ ọkụkụ a na-enweghị ike ịgụta ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:19"
      },
      "items": [
        {
          "text": "a gaghị ehichapụkwa aha ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:19"
      },
      "items": [
        {
          "text": "maọbụ bibie nʼihu ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
            ]
          }
        }
      ]
    },
