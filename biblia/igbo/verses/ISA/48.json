      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "Onye mgbapụta unu, bụ Onye nsọ Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "\"Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.17",
                "verseOrgIds": [
                  "ISA.48.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
