      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:18"
      },
      "items": [
        {
          "text": "udo unu gaara na-eru dịka osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:18"
      },
      "items": [
        {
          "text": "ọdịmma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        },
        {
          "text": "unu adịkwa ka mmali nke ebili oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        }
      ]
    },
    {
