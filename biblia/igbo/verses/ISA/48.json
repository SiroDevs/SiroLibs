          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.17",
                "verseOrgIds": [
                  "ISA.48.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
