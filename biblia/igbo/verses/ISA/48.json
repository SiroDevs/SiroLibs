      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "onye na-ezi unu ihe nʼihi ọdịmma unu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:17"
      },
      "items": [
        {
          "text": "na-eduzikwa unu nʼụzọ unu kwesiri iso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.17",
            "verseOrgIds": [
              "ISA.48.17"
            ]
          }
        }
      ]
    },
    {
