          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bịakwutenụ m nso, geenụ ntị na nke a:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "\"Site na mkpọsa mbụ ọ bụghị na nzuzo ka m kwuru okwu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "mgbe o mere anọ m nʼebe ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "Ma ugbu a, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.48.16",
                "verseOrgIds": [
                  "ISA.48.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ezitela m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:16"
      },
      "items": [
        {
          "text": "o mejupụtala m na Mmụọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.16",
            "verseOrgIds": [
              "ISA.48.16"
            ]
          }
        }
      ]
    },
