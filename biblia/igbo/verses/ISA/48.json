            "sid": "ISA 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m, ọ bụladị mụ onwe m ekwuola ya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "e, akpọọla m ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "Aga m eme ka ọbịa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:15"
      },
      "items": [
        {
          "text": "nʼije ya, ọ ga-agakwa nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.15",
            "verseOrgIds": [
              "ISA.48.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
