          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na unu ṅara ntị nʼiwu m niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        }
      ]
    },
