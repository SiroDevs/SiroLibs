      "attrs": {
        "style": "q2",
        "vid": "ISA 24:19"
      },
      "items": [
        {
          "text": "ụwa agbawasịala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.19",
            "verseOrgIds": [
              "ISA.24.19"
            ]
          }
        }
