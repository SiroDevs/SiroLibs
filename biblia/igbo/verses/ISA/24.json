      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:21"
      },
      "items": [
        {
          "text": "Ọ ga-atakwa ndị eze niile nʼụwa ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.21",
            "verseOrgIds": [
              "ISA.24.21"
            ]
          }
        }
      ]
    },
