          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụwa ga-adagbugharị dịka onye mmanya na-egbu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.20",
            "verseOrgIds": [
              "ISA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:20"
      },
      "items": [
        {
          "text": "Ọ ga-aṅagharịkwa dịka osisi nke oke ifufe na-efegharị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.20",
            "verseOrgIds": [
              "ISA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:20"
      },
      "items": [
        {
          "text": "Ọ daala, ọ pụghịkwa ibili ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.20",
            "verseOrgIds": [
              "ISA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:20"
      },
      "items": [
        {
          "text": "nʼihi na njehie ya dị arọ na-anyịdakwa ya.",
