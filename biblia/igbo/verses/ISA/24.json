      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:12"
      },
      "items": [
        {
          "text": "e tikpọọla ọnụ ụzọ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        }
      ]
    },
    {
