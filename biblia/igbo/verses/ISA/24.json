              "attrs": {
                "verseId": "ISA.24.14",
                "verseOrgIds": [
                  "ISA.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        }
      ]
