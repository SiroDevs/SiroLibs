          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nọ nʼọwụwa anyanwụ ga-enye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.24.15",
                "verseOrgIds": [
                  "ISA.24.15"
                ]
              }
            }
          ]
        },
        {
          "text": "otuto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:15"
      },
      "items": [
        {
          "text": "Ndị bi nʼala nta niile osimiri gbara gburugburu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:15"
      },
      "items": [
        {
          "text": "ga-ebuli aha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.24.15",
                "verseOrgIds": [
                  "ISA.24.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel elu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị ga-anụ abụ ọma dị iche iche site na nsọtụ ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:16"
      },
      "items": [
        {
          "text": "Ha ga-abụ abụ na-asị, \"Otuto dịrị Onye ezi omume ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 24:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:16"
      },
      "items": [
        {
          "text": "Ma nʼezie, o nweghị olileanya dịịrị m. \"Lee ka anụ ahụ m si na-akpọnwụ!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:16"
      },
      "items": [
        {
          "text": "Ahụhụ dịrị m!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:16"
      },
      "items": [
        {
          "text": "Nʼihi na ndị ahụ na-ekwesighị ntụkwasị obi ereela anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:16"
      },
      "items": [
        {
          "text": "Akpịrị ego ha ka ha ji refuo anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
