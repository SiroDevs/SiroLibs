      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.24.21",
                "verseOrgIds": [
                  "ISA.24.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ata ike usuu niile dị nʼeluigwe ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.21",
            "verseOrgIds": [
              "ISA.24.21"
            ]
          }
        }
      ]
    },
