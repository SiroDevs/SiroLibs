          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe egwu, na olulu, na igbudu nke onye na-esi ọnya dị na-eche unu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
            "verseOrgIds": [
              "ISA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:17"
      },
      "items": [
        {
          "text": "unu ndị niile bi nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
            "verseOrgIds": [
              "ISA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
