      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:14"
      },
      "items": [
        {
          "text": "ndị nọ nʼọdịda anyanwụ ga-eto ịdị ebube nke",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
