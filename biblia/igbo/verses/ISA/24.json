              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ahụ aghọọla mkpọmkpọ ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        }
      ]
