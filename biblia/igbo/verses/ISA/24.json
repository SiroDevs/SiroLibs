      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:18"
      },
      "items": [
        {
          "text": "ga-adaba nʼolulu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        }
      ]
    },
