      "attrs": {
        "style": "q2",
        "vid": "ISA 24:13"
      },
      "items": [
        {
          "text": "nakwa nʼetiti mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:13"
      },
      "items": [
        {
          "text": "dịka mgbe a na-etitusi mkpụrụ dị nʼelu osisi oliv,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        }
      ]
    },
    {
