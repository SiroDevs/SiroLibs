      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:13"
      },
      "items": [
        {
          "text": "maọbụ mgbe ahapụrụ ụfọdụ mkpụrụ grepu nʼelu osisi mgbe a ghọchasịrị ihe ubi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        }
      ]
    },
