      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 24:18"
      },
      "items": [
        {
          "text": "Nʼihi na mmiri nke ịla nʼiyi esitela na mbara eluigwe na-ezokwasị unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:18"
      },
      "items": [
        {
          "text": "Ntọala ụwa na-amakwa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        }
      ]
    },
