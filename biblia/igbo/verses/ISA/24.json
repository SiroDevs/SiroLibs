          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị niile fọdụrụ ga-eti mkpu ọṅụ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        }
      ]
