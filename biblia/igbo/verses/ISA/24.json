      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 24:18"
      },
      "items": [
        {
          "text": "ga-azọnye ụkwụ ya nʼọnya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 24:18"
      },
      "items": []
