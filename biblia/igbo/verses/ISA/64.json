  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "ISA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaara adị mma ma asị na ị ga-adọwa eluigwe rịdata nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:1"
      },
      "items": [
        {
          "text": "ma asị nʼugwu ukwu niile ga-ama jijiji nʼihu gị!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka mgbe ọkụ na-agba ụmụ osisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "na-eme ka mmiri e sikwasịrị nʼọkụ gbọọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "Si nʼelu rịdata bịa mee ka ndị iro",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        },
        {
          "text": "gị niile maara aha gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "meekwa ka mba niile dị iche iche maa jijiji nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ mgbe i mere ọtụtụ ihe egwu dị iche iche nke anyị na-atụghị anya ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:3"
      },
      "items": [
        {
          "text": "ka ị rịdatara mee ka ugwu ukwu niile maa jijiji nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na site na mgbe ochie, ọ dịbeghị onye nụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "ọ dịbeghị ntị ghọtara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "o nwebeghị anya hụrụ Chineke ọzọ karịa gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "onye na-emejupụtara ndị na-echere ya ihe na-akpa ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-enyere ndị na-eme ezi ihe aka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "bụ ndị ji ọṅụ na-echeta ụzọ gị nʼechiche uche ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Ma mgbe anyị nọgidere na-emehie megide ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "iwe were gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "A ga-esikwanụ aṅaa zọpụta anyị?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị niile dịka onye rụrụ arụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "ezi omume anyị niile kwa dịka nkịrịnka akwa ruru unyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "Anyị akpọnwụọla dịka akwụkwọ osisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "mmehie anyị na-ebufukwa anyị dịka ifufe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye nʼime anyị na-arịọ gị arịrịọ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "ọ dịkwaghị onye na-akpọku aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "Nʼihi ya, i zoola ihu gị site nʼebe anyị nọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "meekwa ka anyị bụrụ ndị gbazere agbaze nʼihi mmehie anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọbụla o si dị, gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.8",
                "verseOrgIds": [
                  "ISA.64.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Nna anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "Anyị bụ ụrọ, ma ị bụ ọkpụ ite.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "Ọ bụ aka gị kpụrụ anyị niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.64.9",
                "verseOrgIds": [
                  "ISA.64.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", anọgidela na-eweso anyị iwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "echetakwala mmehie anyị ọzọ ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "Biko, lekwasị anyị anya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "nʼihi na ndị gị ka anyị bụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo nsọ gị niile aghọọla ọzara;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:10"
      },
      "items": [
        {
          "text": "ọ bụladị Zayọn aghọọla ọzara, Jerusalem, ebe tọgbọrọ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọnsọ ukwu anyị ahụ mara mma, nke dịkwa nsọ, ebe nna anyị ha nọ too gị, ma feekwa gị ofufe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "abụrụla ihe a gbara ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "Ihe niile mara mma nʼime ya alaala nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
