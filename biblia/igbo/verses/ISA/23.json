  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "ISA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amụma e buru banyere Taịa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ amụma megide Taịa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Tienụ mkpu akwa, unu ụgbọ mmiri nke Tashish",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "nʼihi na e bibiela Taịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "ahapụla ya na-enweghị ụlọ ọbụla maọbụ ọnụ mmiri mbata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Ozi erutela ha aka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "site nʼobodo Saiprọs.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Derenụ duu, unu ndị bi nʼala ahụ osimiri gbara gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "Unu ndị na-azụ ahịa na Saịdọn,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "ndị na-ezipụ ụgbọ mmiri na-aga nʼosimiri, kwaanụ akwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu ọtụtụ mmiri dị ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "ka mkpụrụ ọkụkụ Shihoa si bịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "owuwe ihe ubi nke Naịl bụ ihe uru ahịa Taịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "ọ ghọrọ ọma ahịa nke mba dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ihere mee gị, Saịdọn, na gị bụ ebe e wusiri ike nke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "nʼihi na oke osimiri ekwuola okwu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "\"Ime emetụbeghị m, nke m ji amụpụta nwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "o nwebeghị mgbe m ji zụpụta ụmụ ndị ikom maọbụ ụmụ ndị inyom tozuru oke.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ozi ga-abịara ndị Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:5"
      },
      "items": [
        {
          "text": "ha ga-anọ na mwute nʼihi ozi si Taịa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiganụ ruo Tashish",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:6"
      },
      "items": [
        {
          "text": "tisienụ mkpu akwa ike, unu ndị bi nʼala mmiri gbara gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ọ bụ obodo ahụ ọṅụ na-ejupụta nʼime ya oge niile?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "Obodo ahụ dịrịla kemgbe oge gara aga?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "Nke a ọ bụ ihe fọdụrụ nʼobodo ahụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "ndị ya na-esi nʼime ya pụọ gaa nʼebe dị anya iwu obodo ọzọ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye zubere ihe dị otu a megide Taịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "bụ mba na-ekpube ndị ọzọ okpueze,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "mba nke ndị ahịa ya bụ ụmụ eze,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "nke ndị ọzụ ahịa ya bụ ndị a na-asọpụrụ nʼụwa?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.9",
                "verseOrgIds": [
                  "ISA.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile zubere ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "nʼihi iweda nʼala mpako na ịma mma ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "na iwetara ndị niile a na-asọpụrụ nʼụwa nlelị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaanụ kọọ ala ubi unu dịka ha na-eme nʼakụkụ Naịl,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "unu ụmụada Tashish,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "nʼihi na unu enwekwaghị ọnụ mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.11",
                "verseOrgIds": [
                  "ISA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "esetipụla aka ya nʼelu osimiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "mee ka alaeze ha niile maa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "O nyela iwu banyere Fonisia",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "ka e bibie ebe ya niile nke wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Ị gaghị aṅụrị ọṅụ ịṅụ mmanya nʼoke oriri ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "gị ada Saịdọn na-amaghị nwoke, nke a na-emegbu emegbu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 23:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "\"Bilie, gafee garuo Saiprọs,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "ọ bụladị nʼebe ahụ, ị gaghị enweta ezumike.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee anya nʼala ndị Kaldịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "ndị a gụpụrụla ugbu a na mmadụ!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "Ndị Asịrịa mere ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "ka ọ bụrụ ebe obibi nye anụ ọhịa na-ebi nʼọzara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "Ha wuliri ụlọ nche ha niile dị elu gburugburu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "tikpọọ ebe ya niile e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "mee ha ka ha tọgbọrọ nʼefu ghọọ mkpọmkpọ ebe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tienụ mkpu akwa, unu ụgbọ mmiri Tashish niile dị nʼoke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.14",
            "verseOrgIds": [
              "ISA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:14"
      },
      "items": [
        {
          "text": "nʼihi na e mebiela ebe unu niile e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.14",
            "verseOrgIds": [
              "ISA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị echeta Taịa ọzọ, tutu iri afọ asaa agafee, nke bụ ogologo ụbọchị ndụ onye eze. Mgbe oge ahụ zuru, Taịa ga-adịkwa ka nwanyị akwụna e jiri rọọ abụ dị otu a:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Welite ụbọ akwara, jegharịa nʼime obodo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:16"
      },
      "items": [
        {
          "text": "gị nwanyị akwụna e chefuru echefu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:16"
      },
      "items": [
        {
          "text": "kpọzie ụbọ gị nke ọma, bụọ ọtụtụ abụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:16"
      },
      "items": [
        {
          "text": "ka e si otu a mee ka ị bụrụ onye e chetara echeta.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, mgbe iri afọ asaa gasịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.17",
                "verseOrgIds": [
                  "ISA.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eleta Taịa. Ọ ga-alaghachi nʼọrụ ya dịka nwanyị akwụna, ya na alaeze niile dị nʼihu elu ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma uru ahịa ya niile, na ego niile ọ kpatara site nʼịzụ ahịa ka ọ ga-edo nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.18",
                "verseOrgIds": [
                  "ISA.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha agaghị edokọkwa ha nʼotu ebe izo ha, kama uru ahịa ha niile ga-adịrị ndị niile na-ebi ezi ndụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.18",
                "verseOrgIds": [
                  "ISA.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha ga-ejikwa ego ahụ zụọ ihe oriri na uwe dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
    }
