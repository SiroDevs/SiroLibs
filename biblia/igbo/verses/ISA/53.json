      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 53:12"
      },
      "items": [
        {
          "text": "rịọọkwara ndị na-emebi iwu arịrịọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.12",
            "verseOrgIds": [
              "ISA.53.12"
            ]
          }
