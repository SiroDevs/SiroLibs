          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ Otuto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, a ga-abụ abụ a nʼala Juda niile:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Anyị nwere obodo e wusiri ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "Chineke na-eme ka mgbidi ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:1"
      },
      "items": [
        {
          "text": "na ebe ya niile e wusiri ike bụrụ nzọpụta nye anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meghee ụzọ ama niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "ka mba ndị ahụ na-eme ezi omume bata,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:2"
      },
      "items": [
        {
          "text": "e, bụ mba ahụ kwesiri ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.2",
            "verseOrgIds": [
              "ISA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-eme ka ndị niile echiche uche ha guzosiri ike",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "nwee udo zuruoke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:3"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ na gị ka ha na-atụkwasị obi ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.4",
                "verseOrgIds": [
                  "ISA.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke obi mgbe niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:4"
      },
      "items": [
        {
          "text": "nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.4",
                "verseOrgIds": [
                  "ISA.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke bụ oke nkume nke mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.4",
            "verseOrgIds": [
              "ISA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-akpa nganga ka ọ na-ewedata ala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "na-emekwa ka obodo na-anya isi kpọọ ọnụ nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "Mgbidi ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:5"
      },
      "items": [
        {
          "text": "ka ọ na-eme ka ọ daruo ala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.5",
            "verseOrgIds": [
              "ISA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-enyefe obodo ahụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "nʼaka ndị a na-emegbu emegbu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:6"
      },
      "items": [
        {
          "text": "na nʼaka ndị ogbenye ka ha zọtọọ ya ụkwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.6",
            "verseOrgIds": [
              "ISA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzọ nke onye ezi omume ha nʼotu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:7"
      },
      "items": [
        {
          "text": "gị, Onye ziri ezi, na-eme ka okporoụzọ ndị ezi omume dị larịị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.7",
            "verseOrgIds": [
              "ISA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.8",
                "verseOrgIds": [
                  "ISA.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", anyị na-aga nʼụzọ nke ikpe gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "na-ele anya gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "Aha gị na ihe niile e ji mara gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:8"
      },
      "items": [
        {
          "text": "bụ ihe na-agụsị obi anyị agụ ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.8",
            "verseOrgIds": [
              "ISA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalị niile ka obi m na-achọsi gị ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "nʼụtụtụ eji m mmụọ m niile na-achọsi gị ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ naanị mgbe ị bịara kpee ụwa ikpe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:9"
      },
      "items": [
        {
          "text": "ka mmadụ ga-esi nʼajọ omume tụgharịa ime ezi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.9",
            "verseOrgIds": [
              "ISA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi ebere gị nʼebe ndị na-emebi iwu nọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "adịghị eme ka ha gbanwee.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "Ọ bụladị nʼala a, ebe ndị ezi omume bi, ha na-anọgide na-eme ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:10"
      },
      "items": [
        {
          "text": "Ha adịghị echeta ịdị ukwuu gị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.10",
                "verseOrgIds": [
                  "ISA.26.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.10",
            "verseOrgIds": [
              "ISA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.11",
                "verseOrgIds": [
                  "ISA.26.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ebuliela aka ya elu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 26:11"
      },
      "items": [
        {
          "text": "ha adịghị ahụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.11",
            "verseOrgIds": [
              "ISA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 26:11"
      },
      "items": [
        {
