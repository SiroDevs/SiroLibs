      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "ha adịghị enwe afọ ojuju.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "Ha bụ ndị ọzụzụ atụrụ na-enweghị nghọta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:11"
      },
      "items": [
        {
          "text": "ha niile echela ihu nʼụzọ nke aka ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
