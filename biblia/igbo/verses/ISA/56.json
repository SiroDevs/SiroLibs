              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-asị, \"Bịa ka m weta mmanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
