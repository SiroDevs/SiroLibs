          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ nkịta na-eribiga nri oke;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.11",
            "verseOrgIds": [
              "ISA.56.11"
            ]
          }
        }
      ]
