    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzọpụta dịrị ndị ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.1",
                "verseOrgIds": [
                  "ISA.56.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "\"Debenụ ikpe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "meekwanụ ihe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "Nʼihi na nzọpụta m dị nso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "ezi omume m ga-apụta ihe mgbe na-adịghị anya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngọzị na-adịrị onye na-eme nke a,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:2"
      },
      "items": [
        {
          "text": "bụ onye ahụ nke na-ejidesi ya aka ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:2"
      },
      "items": [
        {
          "text": "onye ahụ nke na-edebe ụbọchị izuike m na-emerụghị ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:2"
      },
      "items": [
        {
          "text": "nke na-edebekwa aka ya ka ọ ghara ime ihe ọjọọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye ala ọzọ bụ onye jikọrọ onwe ya na",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.3",
                "verseOrgIds": [
                  "ISA.56.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:3"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.3",
                "verseOrgIds": [
                  "ISA.56.3"
                ]
              }
            }
          ]
        },
        {
          "text": "aghaghị i site na ndị ya kewapụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:3"
      },
      "items": [
        {
          "text": "Ka onye onozi ọbụla gharakwa ị sị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:3"
      },
      "items": [
        {
          "text": "\"Mụ onwe m bụ naanị osisi kpọnwụrụ akpọnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.4",
                "verseOrgIds": [
                  "ISA.56.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:4"
      },
      "items": [
        {
          "text": "\"Nye ndị onozi ahụ na-edebe ụbọchị izuike m niile,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:4"
      },
      "items": [
        {
          "text": "ndị na-ahọrọ ihe na-atọ m ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:4"
      },
      "items": [
        {
          "text": "na ndị na-ejidesikwa ọgbụgba ndụ m ike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m enye ha nʼime ụlọ m na nʼetiti mgbidi ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:5"
      },
      "items": [
        {
          "text": "ihe ncheta na aha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:5"
      },
      "items": [
        {
          "text": "dị mma karịa ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:5"
      },
      "items": [
        {
          "text": "Aga m enye ha aha ga-adị ruo ebighị ebi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:5"
      },
      "items": [
        {
          "text": "nke a na-agaghị echezọ ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị mba ọzọ ndị gbakwuuru",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.6",
                "verseOrgIds": [
                  "ISA.56.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "ijere ya ozi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "na ịhụ aha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.6",
                "verseOrgIds": [
                  "ISA.56.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "nakwa ị bụ ndị ohu ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "ndị niile na-edebe ụbọchị izuike nsọ na-emerụghị ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "na ndị jidesiri ọgbụgba ndụ m ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị a ka m ga-akpọta nʼugwu nsọ m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "meekwa ka ha ṅụrịa ọṅụ nʼime ụlọ ekpere m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "Aga m anabata aja nsure ọkụ ha na onyinye niile ha nyere",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "nʼebe ịchụ aja m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "Nʼihi na a ga-akpọ ụlọ m",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "Ụlọ Ekpere nye mba niile dị iche iche.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.56.8",
                "verseOrgIds": [
                  "ISA.56.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "bụ onye ahụ na-eme ka Izrel si nʼebe ha gbapụrụ ọsọ lọta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "\"Aga m achịkọtakwa ndị ọzọ tinyere ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "tinyekọtara na ndị ya achịkọtarala.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebubo Chineke megide ndị ajọọ omume",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bịanụ, unu anụmanụ niile nke oke ọhịa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:9"
      },
      "items": [
        {
          "text": "Bịanụ dọgbuo, unu ụmụ anụmanụ nke oke ọhịa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị na-eche ndị m nche kpuru ìsì.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "Ha niile bụ ndị amamihe kọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "Ha dị ka nkịta dara ogbi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "nke na-adịghị agbọ ụja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "Ha hụrụ ịrahụ ụra na ịrọ nrọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "na idina ndina nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
