      "attrs": {
        "style": "q2",
        "vid": "ISA 56:12"
      },
      "items": [
        {
          "text": "ma ọ bụkwanụ dị mma karịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
