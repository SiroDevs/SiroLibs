      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:12"
      },
      "items": [
        {
          "text": "ka anyị ṅụjuokwa mmanya nʼaba nʼanya afọ anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:12"
      },
      "items": [
        {
          "text": "Echi ga-adịkwa ka taa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.12",
            "verseOrgIds": [
              "ISA.56.12"
            ]
          }
        }
      ]
