      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ Otuto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, ị ga-ekwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "\"Aga m eto gị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.1",
                "verseOrgIds": [
                  "ISA.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "Ọ bụ ezie na ị wesara m iwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "ma ugbu a, iwe gị adajụọla;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "ị kasịkwara m obi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, Chineke bụ onye nzọpụta m;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "aga m atụkwasị ya obi, ụjọ agaghị atụkwa m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.2",
                "verseOrgIds": [
                  "ISA.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onyenwe anyị ya onwe ya, bụ ike m bụrụkwa abụ m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "ọ ghọrọla m onye nzọpụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eji ọṅụ dọrọ mmiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:3"
      },
      "items": [
        {
          "text": "site nʼolulu mmiri nke nzọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, ị ga-ekwukwa sị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "\"Nyenụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.4",
                "verseOrgIds": [
                  "ISA.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "otuto, Kwupụtakwa aha ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "meenụ ka amata nʼetiti mba niile ihe niile ọ rụrụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "kwusaanụ na aha ya bu ihe e buliri elu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bụkuonụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.5",
                "verseOrgIds": [
                  "ISA.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ, nʼihi na o meela oke ihe dị ebube.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:5"
      },
      "items": [
        {
          "text": "Meekwanụ ka ụwa niile mara ihe ọ rụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ndị niile bi na Zayọn tie mkpu ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        },
        {
          "text": "bụkwaa abụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:6"
      },
      "items": [
        {
          "text": "Nʼihi na Onye nsọ nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        },
        {
          "text": "dị ukwuu, e, ọ dị ike nke ukwuu, bụ Onye ahụ na-ebi nʼetiti unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    }
  ],
