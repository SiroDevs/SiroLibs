      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:13"
      },
      "items": [
        {
          "text": "ndị na-anọ ọnọdụ abalị nʼoke ọhịa nke Arebịa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
            ]
          }
        }
      ]
    },
