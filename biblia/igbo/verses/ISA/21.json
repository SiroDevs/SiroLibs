              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuterenụ ndị ahụ bịakwutere unu akpịrị na-akpọ nkụ mmiri ọṅụṅụ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.14",
            "verseOrgIds": [
              "ISA.21.14"
            ]
          }
