    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:11"
      },
      "items": [
        {
          "text": "Otu onye si na Sia na-akpọ m oku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:11"
      },
      "items": [
        {
          "text": "\"Onye nche, gịnị ka ọ fọdụrụ tupu chi abọọ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:11"
      },
      "items": [
        {
          "text": "Onye nche, gịnị ka ọ fọdụrụ tupu chi abọọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
