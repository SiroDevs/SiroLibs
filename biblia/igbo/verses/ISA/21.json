      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:15"
      },
      "items": [
        {
          "text": "ka ha si na-agbapụ ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
            ]
