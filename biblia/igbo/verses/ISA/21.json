          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amụma megide Arebịa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
            ]
          }
        }
      ]
