      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:15"
      },
      "items": [
        {
          "text": "na agha e ji akụ agbatu mmadụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
            ]
          }
        }
      ]
    },
