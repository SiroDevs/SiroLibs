      "attrs": {
        "style": "q2",
        "vid": "ISA 21:15"
      },
      "items": [
        {
          "text": "nke e ji mma agha egbu ndị mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
            ]
          }
