          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ site nʼagha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
