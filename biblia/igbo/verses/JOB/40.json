            "number": "21",
            "style": "v",
            "sid": "JOB 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-edina nʼokpuru ahịhịa na-eto nʼakụkụ mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.21",
            "verseOrgIds": [
              "JOB.40.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:21"
      },
      "items": [
        {
          "text": "zookwa onwe ya nʼetiti ahịhịa riidi nʼapịtị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.21",
            "verseOrgIds": [
              "JOB.40.21"
            ]
