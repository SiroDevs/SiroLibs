          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye pụrụ ijide ya mgbe ọ na-ele anya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.24",
            "verseOrgIds": [
              "JOB.40.24"
            ]
