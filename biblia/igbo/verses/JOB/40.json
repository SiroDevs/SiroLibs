          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugwu na-enye ya ihe ọ na-eri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.20",
            "verseOrgIds": [
              "JOB.40.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:20"
      },
      "items": [
        {
          "text": "Nʼebe ahụ kwa ka ụmụ anụ ọhịa ndị ọzọ na-anọ egwuri egwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.20",
            "verseOrgIds": [
              "JOB.40.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
