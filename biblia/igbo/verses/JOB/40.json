      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:23"
      },
      "items": [
        {
          "text": "ọ na-anọ nwayọọ, nʼagbanyeghị na mmiri Jọdan na-asọpụta na-asọju ya nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.23",
            "verseOrgIds": [
              "JOB.40.23"
            ]
          }
