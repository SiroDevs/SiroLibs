      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 40:22"
      },
      "items": [
        {
          "text": "osisi pọpla nke dị nʼakụkụ mmiri gbara ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.22",
            "verseOrgIds": [
              "JOB.40.22"
            ]
          }
        }
