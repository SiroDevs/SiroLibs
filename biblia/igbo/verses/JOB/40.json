          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahịhịa lotus na-eji ndo ya kpuchie ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.22",
            "verseOrgIds": [
              "JOB.40.22"
            ]
          }
        }
      ]
    },
