          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị mgbe ebili mmiri na-ama, ọ dịghị atụ egwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.40.23",
            "verseOrgIds": [
              "JOB.40.23"
            ]
          }
        }
      ]
    },
