  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JOB 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Job zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.1",
            "verseOrgIds": [
              "JOB.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anụla m ọtụtụ ihe dịka ndị a;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:2"
      },
      "items": [
        {
          "text": "ndị nkasiobi na-eweta ọnọdụ ọjọọ ka unu niile bụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.2",
            "verseOrgIds": [
              "JOB.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo okwu efu ndị a niile unu na-ekwu, ọ naghị akwụsị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:3"
      },
      "items": [
        {
          "text": "Gịnị bụ nsogbu unu nke mere unu ji aga nʼihu na-arụ ụka niile ndị a?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.3",
            "verseOrgIds": [
              "JOB.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m nwekwara ike ikwu okwu dịka unu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "ma ọ bụrụ na unu nọ nʼọnọdụ m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "enwere m ike kwuo okwu dị ụtọ na ntị megide unu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:4"
      },
      "items": [
        {
          "text": "ma fufekwaa isi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        },
        {
          "text": "m megide unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.4",
            "verseOrgIds": [
              "JOB.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọnụ m ga-agba unu ume;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:5"
      },
      "items": [
        {
          "text": "nkasiobi si nʼegbugbere ọnụ m ga-emekwa ka ihe mgbu unu dajụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.5",
            "verseOrgIds": [
              "JOB.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na m ekwuo, adịghị egbochi ihe mgbu m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:6"
      },
      "items": [
        {
          "text": "ọ bụrụ na m ahapụ ikwu okwu, ọdịghị esi nʼahụ m pụọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.6",
            "verseOrgIds": [
              "JOB.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie o Chineke, i meela ka ike gwụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:7"
      },
      "items": [
        {
          "text": "i tidakwala ezinaụlọ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.7",
            "verseOrgIds": [
              "JOB.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "I keela m agbụ; agbụ m abụrụla ihe akaebe megide m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:8"
      },
      "items": [
        {
          "text": "ịta ahụ m ebiliela ịgba akaebe megide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.8",
            "verseOrgIds": [
              "JOB.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke na-eweso m iwe, jiri iwe ya na-adọwasị m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "ọ na-atakwa ikikere eze ya megide m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:9"
      },
      "items": [
        {
          "text": "onye iro m na-achịchapụrụ m anya ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.9",
            "verseOrgIds": [
              "JOB.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ mmadụ na-asaghe ọnụ ka ha chịa m ọchị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "ha ji iti m aka nʼọnụ na-akwa m emo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:10"
      },
      "items": [
        {
          "text": "jikọtakwa onwe ha megide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.10",
            "verseOrgIds": [
              "JOB.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke ewerela m nyefee nʼaka ndị ajọ omume,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:11"
      },
      "items": [
        {
          "text": "tụbakwa m nʼaka ndị na-emebi iwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.11",
            "verseOrgIds": [
              "JOB.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe na-agara m nke ọma, ma Chineke tipịara m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "O jidere m nʼolu ma tiwasịa m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:12"
      },
      "items": [
        {
          "text": "O meela m ihe ịgba ụta ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.12",
            "verseOrgIds": [
              "JOB.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị ọgba ụta ya agbaala m gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "Ọ na-agbawa akụrụ m na-enweghị ọmịiko",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:13"
      },
      "items": [
        {
          "text": "mee ka oluilu m wụsịa nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.13",
            "verseOrgIds": [
              "JOB.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe niile, ọ na-emegide m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:14"
      },
      "items": [
        {
          "text": "ọ na-achụso m dịka dike nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.14",
            "verseOrgIds": [
              "JOB.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Adụkọtala m akwa mkpe were ya kpuchie anụ ahụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 16:15"
      },
      "items": [
        {
          "text": "liekwa ikuanya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        },
        {
          "text": "m nʼime ntụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.15",
            "verseOrgIds": [
              "JOB.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihu m na-acha ọbara ọbara site nʼakwa nke m na-akwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.16.16",
            "verseOrgIds": [
              "JOB.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
