      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:22"
      },
      "items": [
        {
          "text": "Onye kere m ga-ewepụ m nʼoge na-adịghị anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.22",
            "verseOrgIds": [
