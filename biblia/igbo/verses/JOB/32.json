  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "JOB 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Elihu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ikom atọ ndị a kwusịrị ịsa Job okwu ọbụla ọzọ nʼihi na ọ hụrụ onwe ya dịka onye ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma oke iwe were Elihu nwa Barakel onye obodo Buz, si nʼikwu Ram megide Job nʼihi na ọ gụrụ onwe ya dịka onye ezi omume karịa Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wekwara ya nʼebe mmadụ atọ ndị enyi Job nọ, nʼihi na ọ dịghị ebe ha hụtara Job dịka onye ụzọ ya na-ezighị ezi, ma ha gara nʼihu ịma ya ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ruo ugbu a, Elihu agwaghị Job okwu ọbụla nʼihi na ndị ọzọ bụ okenye nʼebe ọ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ hụrụ na ndị ikom atọ ndị a enweghị okwu ọzọ ha ga-ekwu, nke a kpasuru ya iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Elihu nwa Barakel onye obodo Buz zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "\"Abụ m nwantakịrị nʼọnụọgụgụ afọ m gbara,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "ma unu bụ ndị okenye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "ọ bụ nke a mere m ji gbaa nkịtị nʼụjọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "hapụ ịgwa unu ihe m maara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echere m nʼobi m sị, 'Ọnụọgụgụ afọ ga-ekwu okwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:7"
      },
      "items": [
        {
          "text": "ọtụtụ afọ ka ọ dịkwara ikuzi amamihe.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ mmụọ dị nʼime mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:8"
      },
      "items": [
        {
          "text": "nkuume nke Onye pụrụ ime ihe niile na-enye nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị naanị ndị okenye bụ ndị mara ihe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:9"
      },
      "items": [
        {
          "text": "ọ bụkwaghị naanị ndị gbara ọtụtụ afọ bụ ndị na-aghọta ihe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere m na-asị, Geenụ m ntị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:10"
      },
      "items": [
        {
          "text": "mụ onwe m ga-agwa unu ihe m ma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echeere m oge niile unu na-ekwu okwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:11"
      },
      "items": [
        {
          "text": "egere m ntị na ntụgharị uche unu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:11"
      },
      "items": [
        {
          "text": "oge niile unu na-achọpụta okwu unu ga-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egere m nnọọ unu ntị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:12"
      },
      "items": [
        {
          "text": "ma ọ dịghị onye nʼime unu nwerela ike gosi Job ụzọ o si jehie;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:12"
      },
      "items": [
        {
          "text": "ọ dịghị onye nʼime unu zaghachiri ịrụ ụka ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ekwula sị, 'Anyị achọtala amamihe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:13"
      },
      "items": [
        {
          "text": "ka Chineke na-abụghị mmadụ gosi ya mmehie ya.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Job edozighị okwu ya nʼusoro megide m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:14"
      },
      "items": [
        {
          "text": "ya mere agaghị m eji ịrụ ụka unu zaghachi ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ha adaala mba na-enweghị ihe ọzọ ha ga-ekwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:15"
      },
      "items": [
        {
          "text": "ike okwu agwụla ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "M ga-echere, ugbu a ha deere duu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:16"
      },
      "items": [
        {
          "text": "ugbu a ha guzo ebe ahụ na-enweghị ọsịsa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ga-ekwu uche m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:17"
      },
      "items": [
        {
          "text": "ihe m maara ka mụ onwe m ga-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na okwu juru m ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
              "JOB.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:18"
      },
      "items": [
        {
          "text": "ọ bụkwa mmụọ dị nʼime m na-akwagide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
              "JOB.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime m, adị m ka mmanya na-agbọ ụfụfụ a kwuchiri na karama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.19",
            "verseOrgIds": [
              "JOB.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:19"
      },
      "items": [
        {
          "text": "dịka karama akpụkpọ ọhụrụ dị njikere ịgbawa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.19",
            "verseOrgIds": [
              "JOB.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ekwurịrị okwu ka m sị nʼụzọ dị otu a chọta izuike;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.20",
            "verseOrgIds": [
              "JOB.32.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:20"
      },
      "items": [
        {
          "text": "aga m emeghe egbugbere ọnụ m ma zaghachi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.20",
            "verseOrgIds": [
              "JOB.32.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
