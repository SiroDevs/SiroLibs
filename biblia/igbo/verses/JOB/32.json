          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụrụ na m bụ ọka nwere ire ụtọ nʼịja ihe na-ezighị ezi mma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.22",
            "verseOrgIds": [
              "JOB.32.22"
            ]
          }
        }
      ]
    },
    {
