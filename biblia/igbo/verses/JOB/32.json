            "number": "21",
            "style": "v",
            "sid": "JOB 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaghị m ekpe mmadụ ọbụla ikpe mmegide",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.21",
            "verseOrgIds": [
              "JOB.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:21"
      },
      "items": [
        {
          "text": "maọbụ jaa mmadụ ọbụla mma nʼụzọ na-ezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.21",
            "verseOrgIds": [
              "JOB.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
