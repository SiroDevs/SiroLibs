          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbibi na ọnwụ na-asị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
