      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:24"
      },
      "items": [
        {
          "text": "na-ahụkwa ihe niile dị nʼokpuru eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        }
      ]
