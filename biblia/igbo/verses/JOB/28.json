  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "JOB 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwa mgbe nta: Ebe a na-achọta amamihe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olulu e si egwupụta ọlaọcha dị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:1"
      },
      "items": [
        {
          "text": "ebe a na-anụcha ọlaedo dịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.1",
            "verseOrgIds": [
              "JOB.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "E si nʼime ala ewepụta igwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:2"
      },
      "items": [
        {
          "text": "ọlanchara na-agbazepụta site nkume na-aghọ ọla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.2",
            "verseOrgIds": [
              "JOB.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ na-eme ka ọchịchịrị nwee ọgwụgwụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:3"
      },
      "items": [
        {
          "text": "ọ na-enyochapụta ihe dị ebe dị anya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:3"
      },
      "items": [
        {
          "text": "na-achọ igwe nʼime oke ọchịchịrị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.3",
            "verseOrgIds": [
              "JOB.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-egwu olulu nʼebe dị anya site nʼebe mmadụ bi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:4"
      },
      "items": [
        {
          "text": "nʼebe ụkwụ mmadụ na-adịghị eru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:4"
      },
      "items": [
        {
          "text": "nʼebe ahụ dị anya site nʼebe mmadụ bi ka ha na-akwụfegharị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.4",
            "verseOrgIds": [
              "JOB.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ahụ e si na ya enweta nri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:5"
      },
      "items": [
        {
          "text": "abụrụla ihe e ji ọkụ gbanwee nʼokpuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.5",
            "verseOrgIds": [
              "JOB.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Safaia bụ nkume dị oke ọnụahịa dị na nkume ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:6"
      },
      "items": [
        {
          "text": "aja ya nwekwara mkpụrụ ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.6",
            "verseOrgIds": [
              "JOB.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị anụ ufe nke na-eri anụ maara ụzọ ahụ zoro ezo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:7"
      },
      "items": [
        {
          "text": "anya agụ nkwọ ọbụla ahụtụbeghị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.7",
            "verseOrgIds": [
              "JOB.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụ ọhịa dị nganga anaghị azọnye ụkwụ nʼelu ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:8"
      },
      "items": [
        {
          "text": "ọdụm ọbụla adịghị awagharị nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.8",
            "verseOrgIds": [
              "JOB.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ na-eji aka na-etiwasị nkume ahụ na-enwu ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:9"
      },
      "items": [
        {
          "text": "mee ka mgbọrọgwụ ugwu ahụ pụta ìhè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.9",
            "verseOrgIds": [
              "JOB.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-awapụta ọwa ụzọ nʼetiti nkume ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:10"
      },
      "items": [
        {
          "text": "anya ha na-ahụkwa akụnụba ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.10",
            "verseOrgIds": [
              "JOB.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-achọpụta isi mmiri niile",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:11"
      },
      "items": [
        {
          "text": "ma meekwa ka ihe nzuzo pụta ìhè.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.11",
            "verseOrgIds": [
              "JOB.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma olee ebe ka a ga-achọta amamihe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:12"
      },
      "items": [
        {
          "text": "Olee kwa ebe nghọta bi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.12",
            "verseOrgIds": [
              "JOB.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ apụghị ịghọta ọnụahịa ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:13"
      },
      "items": [
        {
          "text": "agaghị achọtakwa ya nʼala ndị dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.13",
            "verseOrgIds": [
              "JOB.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogbu mmiri na-asị, \"Ọ dịghị nʼime m,\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:14"
      },
      "items": [
        {
          "text": "osimiri na-asị, \"Ọ dịghị nʼaka m.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.14",
            "verseOrgIds": [
              "JOB.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị eji ọlaedo a nụchara nke ọma zụta ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:15"
      },
      "items": [
        {
          "text": "apụghị ịtụ ihe bụ ọnụahịa ya nʼọlaọcha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.15",
            "verseOrgIds": [
              "JOB.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị eji ọlaedo nke Ọfịa zụta ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:16"
      },
      "items": [
        {
          "text": "a gaghị ejikwa nkume dara oke ọnụahịa nke ọniks maọbụ safaia zụta ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.16",
            "verseOrgIds": [
              "JOB.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị eji ọlaedo maọbụ kristal tụnyere ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:17"
      },
      "items": [
        {
          "text": "maọbụ iji ejiji ọlaedo nweta ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.17",
            "verseOrgIds": [
              "JOB.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koral na jaspa erughị ihe a na-akpọtụ aha nʼebe ọ dị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:18"
      },
      "items": [
        {
          "text": "ọnụahịa nke amamihe karịrị ọtụtụ rubi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.18",
            "verseOrgIds": [
              "JOB.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị eji ọla topaazi nke Kush tụnyere ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:19"
      },
      "items": [
        {
          "text": "a pụghị iji ọlaedo a nụchara anụcha zụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.19",
            "verseOrgIds": [
              "JOB.28.19"
            ]
          }
        }
      ]
    },
