      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:22"
      },
      "items": [
        {
          "text": "\"Naanị akụkọ ya ruru anyị ntị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.22",
            "verseOrgIds": [
              "JOB.28.22"
            ]
          }
        }
      ]
    },
    {
