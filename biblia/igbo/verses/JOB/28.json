      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:23"
      },
      "items": [
        {
          "text": "naanị ya makwara ebe obibi ya dị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.23",
            "verseOrgIds": [
              "JOB.28.23"
            ]
          }
        }
      ]
    },
    {
