      "attrs": {
        "style": "q2",
        "vid": "JOB 28:25"
      },
      "items": [
        {
          "text": "tụọkwa mmiri nʼihe ọtụtụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.25",
            "verseOrgIds": [
              "JOB.28.25"
            ]
          }
        }
