          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ na-ahụ nsọtụ nke ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.24",
            "verseOrgIds": [
              "JOB.28.24"
            ]
          }
        }
      ]
