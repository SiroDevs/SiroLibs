        "style": "q2",
        "vid": "JOB 28:27"
      },
      "items": [
        {
          "text": "meekwa ka o guzosie ike, ma nwapụtakwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.27",
            "verseOrgIds": [
              "JOB.28.27"
            ]
