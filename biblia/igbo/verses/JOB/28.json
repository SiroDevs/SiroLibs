      "attrs": {
        "style": "q2",
        "vid": "JOB 28:28"
      },
      "items": [
        {
          "text": "\"Ịtụ egwu Onyenwe anyị, nke ahụ bụ amamihe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.28",
            "verseOrgIds": [
              "JOB.28.28"
            ]
