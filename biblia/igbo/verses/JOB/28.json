          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee ebe amamihe si abịa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:20"
      },
      "items": [
        {
          "text": "Olee ebe nghọta bi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.20",
            "verseOrgIds": [
              "JOB.28.20"
            ]
          }
        }
      ]
    },
    {
