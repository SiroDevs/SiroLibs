          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E zoro ya ezo site nʼanya ihe niile dị ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
    },
