        "vid": "JOB 28:26"
      },
      "items": [
        {
          "text": "meekwa ụzọ nye egbe eluigwe na oke ikuku,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.26",
            "verseOrgIds": [
              "JOB.28.26"
            ]
