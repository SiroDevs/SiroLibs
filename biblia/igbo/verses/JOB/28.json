      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 28:21"
      },
      "items": [
        {
          "text": "e kpuchikwara ya nye ọ bụladị anụ ufe nke eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.28.21",
            "verseOrgIds": [
              "JOB.28.21"
            ]
          }
        }
      ]
    },
