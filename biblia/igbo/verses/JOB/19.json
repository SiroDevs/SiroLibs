          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na unu asị, 'Anyị ga-emegide ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
