      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:23"
      },
      "items": [
        {
          "text": "ma a sị na e dekọrọ okwu m nʼakwụkwọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
