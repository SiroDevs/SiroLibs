          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na e ji mkpisi igwe dee ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
