      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:26"
      },
      "items": [
        {
          "text": "ma nʼanụ ahụ m aga m ahụ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
