          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amara m na onye mgbapụta m na-adị ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
