  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOB 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Job zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.1",
            "verseOrgIds": [
              "JOB.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ruo ole mgbe ka unu ga-anọgide na-ata m ahụhụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:2"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka unu ga-ewere okwu ọnụ unu zọpịa m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.2",
            "verseOrgIds": [
              "JOB.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugboro iri ndị a ka unu kọcharala m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:3"
      },
      "items": [
        {
          "text": "ihere adịghị eme unu na unu na-ebuso m agha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.3",
            "verseOrgIds": [
              "JOB.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na m bụ onye mmehie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:4"
      },
      "items": [
        {
          "text": "ọ bụ naanị mụ onwe m ka ọ gbasara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.4",
            "verseOrgIds": [
              "JOB.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu na-ebuli onwe unu elu karịa m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:5"
      },
      "items": [
        {
          "text": "ma were ọnọdụ ịdị ala m megide m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.5",
            "verseOrgIds": [
              "JOB.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, maranụ na Chineke emejọọla m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:6"
      },
      "items": [
        {
          "text": "were ụgbụ ya tụọ m gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.6",
            "verseOrgIds": [
              "JOB.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ ezie na m na-eti mkpu akwa sị: 'A na-emejọ m.' Ma ọ dịghị ọsịsa m na-anata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:7"
      },
      "items": [
        {
          "text": "ọ bụ ezie na m na-eti mkpu ka e nyere m aka ma ikpe ziri ezi adịghị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.7",
            "verseOrgIds": [
              "JOB.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nọchiela ụzọ m ka m ghara ịgafe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:8"
      },
      "items": [
        {
          "text": "o jirila ọchịchịrị kpuchie ụzọ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.8",
            "verseOrgIds": [
              "JOB.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O yipụla m ugwu m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:9"
      },
      "items": [
        {
          "text": "wepụkwa okpueze m kpu nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.9",
            "verseOrgIds": [
              "JOB.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eti m ihe otiti nʼakụkụ niile, ruo mgbe m gabigara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:10"
      },
      "items": [
        {
          "text": "ọ na-ehopu olileanya m dịka osisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.10",
            "verseOrgIds": [
              "JOB.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ya dị ọkụ megide m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:11"
      },
      "items": [
        {
          "text": "ọ na-agụnyekwa m dịka onye iro ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.11",
            "verseOrgIds": [
              "JOB.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha ya ji ike na-abịa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "ha ewuola mgbidi were nnọchibido m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:12"
      },
      "items": [
        {
          "text": "ha agbaala ụlọ ikwu m gburugburu imegide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.12",
            "verseOrgIds": [
              "JOB.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"O meela ka ụmụnne m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:13"
      },
      "items": [
        {
          "text": "na ndị enyi m si nʼebe m nọ pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.13",
            "verseOrgIds": [
              "JOB.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikwu m anaghị etinyekwa uche nʼihe banyere m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:14"
      },
      "items": [
        {
          "text": "ndị ezi enyi m niile echefuola m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.14",
            "verseOrgIds": [
              "JOB.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọbịa nọ nʼụlọ m na ndị odibo m nwanyị na-agụ m dịka onye ala ọzọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:15"
      },
      "items": [
        {
          "text": "adị m ka onye mba ọzọ nʼebe ha nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.15",
            "verseOrgIds": [
              "JOB.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m akpọ odibo m oku ma ọ dịghị aza m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:16"
      },
      "items": [
        {
          "text": "ọ bụladị mgbe m jiri ọnụ m rịọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.16",
            "verseOrgIds": [
              "JOB.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku ume m abụrụla ihe nwunye m apụghị ịnagide;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:17"
      },
      "items": [
        {
          "text": "abụrụla m ihe arụ nye ụmụnne m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.17",
            "verseOrgIds": [
              "JOB.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị ụmụntakịrị nwoke na-akwa m emo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:18"
      },
      "items": [
        {
          "text": "ha na-ejikwa m eme ihe ọchị mgbe ọbụla m pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.18",
            "verseOrgIds": [
              "JOB.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
