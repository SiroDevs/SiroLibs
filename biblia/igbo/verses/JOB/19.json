      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:22"
      },
      "items": [
        {
          "text": "Ọ ga-abụ na ahụhụ m ejubeghị unu afọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.22",
            "verseOrgIds": [
              "JOB.19.22"
            ]
          }
        }
      ]
    },
