      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:28"
      },
      "items": [
        {
          "text": "nʼihi na nsogbu a si nʼaka ya,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.28",
            "verseOrgIds": [
              "JOB.19.28"
            ]
          }
        }
      ]
    },
    {
