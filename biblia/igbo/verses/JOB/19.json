          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ga-eji anya m abụọ hụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:27"
      },
      "items": [
        {
          "text": "mụ onwe m, ọ bụghị onye ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:27"
      },
      "items": [
        {
          "text": "Lee ka obi m si anụ ọkụ nʼime m maka nke a!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.27",
            "verseOrgIds": [
              "JOB.19.27"
            ]
          }
        }
      ]
    },
