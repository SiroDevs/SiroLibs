      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 19:25"
      },
      "items": [
        {
          "text": "amakwaara m na ọ ga-eguzo nʼelu ụwa nʼoge ikpeazụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.25",
            "verseOrgIds": [
              "JOB.19.25"
            ]
          }
        }
      ]
    },
    {
