      "attrs": {
        "style": "q2",
        "vid": "JOB 19:24"
      },
      "items": [
        {
          "text": "maọbụ kakwasị ha nʼelu mbadamba nkume ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.24",
            "verseOrgIds": [
              "JOB.19.24"
            ]
          }
        }
      ]
    },
    {
