          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e mebisikwara akpụkpọ ahụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.26",
            "verseOrgIds": [
              "JOB.19.26"
            ]
          }
        }
      ]
    },
