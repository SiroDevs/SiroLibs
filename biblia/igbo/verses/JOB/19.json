            "number": "23",
            "style": "v",
            "sid": "JOB 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ gaara atọ m ụtọ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.23",
            "verseOrgIds": [
              "JOB.19.23"
            ]
          }
        }
      ]
    },
