      "attrs": {
        "style": "q2",
        "vid": "JOB 19:29"
      },
      "items": [
        {
          "text": "nʼihi na iwe ga-ebute ịta ahụhụ nke mma agha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
      ]
