          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "unu onwe unu kwesiri ịtụ egwu mma agha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.19.29",
            "verseOrgIds": [
              "JOB.19.29"
            ]
          }
        }
