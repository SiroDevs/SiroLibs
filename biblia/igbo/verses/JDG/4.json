          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, Chineke meriri Jabin, eze ndị Kenan nʼihu ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
            "verseOrgIds": [
              "JDG.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka ụmụ Izrel bụ nke dị ike na-adịkwa ike nke ukwu megide Jabin bụ eze Kenan ruo mgbe ha lara ya nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.24",
            "verseOrgIds": [
              "JDG.4.24"
