      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Barak bịara ịchọ Sisera, Jael jekwuru ya sị, \"Bịa ka m gosi gị nwoke ahụ ị na-achọ.\" Barak sooro ya jee, ma lee, Sisera anwụọlarị site na ǹtu ahụ a kpọrọ ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.22",
            "verseOrgIds": [
              "JDG.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
