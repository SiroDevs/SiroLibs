  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JDG 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samsin na Delaịla",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, Samsin gara nʼotu obodo ndị Filistia a na-akpọ Gaza, soro otu nwanyị akwụna bi nʼebe ahụ hie ụra abalị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.1",
            "verseOrgIds": [
              "JDG.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gwara ndị Gaza sị, \"Samsin nọ nʼobodo a.\" Nʼihi ya, ha gbara ebe ahụ gburugburu ma nọdụ na-eche nʼọnụ ụzọ ama obodo ahụ abalị niile. Ọ dịghị ihe ha mere nʼabalị ahụ nʼihi na ha zubere sị, \"Mgbe chi bọrọ, anyị ga-egbu ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Samsin dinara nʼụlọ nwanyị akwụna ahụ ruo nʼetiti abalị ahụ. Mgbe ọ pụtara, ọ gara ruo nʼọnụ ụzọ obodo ahụ, foro ibo ọnụ ụzọ obodo ahụ, ya na ibo ya abụọ, bukwasị ya nʼubu ya, buru ha gaa nʼelu ugwu chere obodo Hebrọn ihu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị anya, Samsin hụrụ otu nwaagbọghọ, onye ọ hụrụ nʼanya. Aha nwaagbọghọ a bụ Delaịla, onye si nʼobodo dị na Ndagwurugwu Sorek.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị eze ndị Filistia,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        },
        {
          "text": "bịakwutere Delaịla rịọọ ya sị, \"Gbalịa lee ma ị ga-enwe ike chọpụta ebe ike Samsin si abịa, ka anyị nwee ike ịmata ụzọ anyị ga-esi jide ya, kee ya agbụ. Ọ bụrụ na i meere anyị nke a, anyị na-ekwe nkwa na onye ọbụla nʼime anyị ga-enye gị puku shekel na narị shekel ọlaọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Delaịla gwara Samsin okwu sị ya, \"Gwa m ebe ike gị si abịa. Gwakwa m otu mmadụ pụrụ isi kee gị agbụ, merie gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.6",
            "verseOrgIds": [
              "JDG.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Samsin zara sị ya, \"Ọ bụrụ na mmadụ e jiri akwara eriri asaa dị ọhụrụ, ndị a na-amịkpọghị amịkpọ kee m, m ga-abụkwa onye na-adịghị ike dịka mmadụ ọbụla ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.7",
            "verseOrgIds": [
              "JDG.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, ndịisi ndị Filistia wetara ya eriri asaa dị ọhụrụ ndị a na-amịbeghị nʼanwụ, o weere ha kee Samsin.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.8",
            "verseOrgIds": [
              "JDG.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o mere ka ụfọdụ ndị ikom Filistia zoo onwe ha nʼotu akụkụ ụlọ ya. O tiri mkpu sị, \"Samsin, lee, ndị Filistia abịala ijide gị!\" Otu mgbe ahụ kwa, Samsin biliri dọbisie eriri ahụ dịka ọ bụ eriri e ji ogho mee nke bịara ọkụ nso. Ya mere, a chọpụtaghị ebe ike Samsin si abịa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Delaịla gwara Samsin sị ya, \"Lee, ị kwaala m emo, ghaara m ụgha. Biko, gwa m ụzọ a ga-esi kee gị agbụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.10",
            "verseOrgIds": [
              "JDG.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsin zara sị ya, \"Lee, ọ bụrụ na e jiri ụdọ ọhụrụ nke a na-ejibeghị kee ihe mgbe ọbụla, kee m, aga m adịkwa dịka ndị ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.11",
            "verseOrgIds": [
              "JDG.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Delaịla chịkọtara ụdọ ọhụrụ jiri ya kee ya nke ọma. Ma ụfọdụ ndị ikom Filistia zokwara onwe ha nʼime ime ụlọ ahụ. Ọzọkwa, Delaịla tiri mkpu sị, \"Samsin, lee, ndị Filistia abịala ijide gị.\" Ma Samsin biliri dọbisie eriri ahụ e ji kee ya ka a ga-asị na ọ bụ ogho ka e ji mee ha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Delaịla gwara ya sị, \"Lee, ị na-eme ka abụ m onye nzuzu, ghaara m ụgha. Gwa m eziokwu, otu a ga-esi kee gị agbụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.13",
            "verseOrgIds": [
              "JDG.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 16:13"
      },
      "items": [
        {
          "text": "Samsin zara sị ya, \"Lee, e kewara agịrị isi dị m nʼisi ụzọ asaa, i were ụzọ nkekọta asaa e kekọtara agịrị isi m, kpanyekọtaa ha nʼihe i ji ekwe akwa, were ntu osisi i ji akpachi akwa kpachie ya, mgbe ahụ, aga m adịkwa ka ndị ọzọ.\" Mgbe Samsin rahụrụ ụra, Delaịla weere agịrị isi Samsin kpanyekọtaa ya nʼihe o ji ekwe akwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.13",
            "verseOrgIds": [
              "JDG.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jikwa ǹtu osisi o ji akpachi akwa, kpachikọtasie agịrị isi Samsin ike.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 16:14"
      },
      "items": [
        {
          "text": "Ọzọ, Delaịla sịrị ya, \"Samsin, ndị Filistia abịala ijide gị.\" Ma Samsin bilitere nʼike fokọrọ ǹtu osisi ahụ, na ihe eji akpa akwa, na akwa akpara akpa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Delaịla gwara ya okwu sị, \"Olee ka i si kwuo na ị hụrụ m nʼanya, ebe ọ bụ na i nweghị ike ịgwa m ihe dị gị nʼobi? Lee, ugbo atọ ndị a, i mere m ka m dịka onye nzuzu, ma ị gwabeghị m ebe ike gị dị ruo ugbu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.15",
            "verseOrgIds": [
              "JDG.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delaịla sikwara otu a nyegide Samsin nsogbu tutu ruo mgbe Samsin na-enweghịkwa ike ịnagide nsogbu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.16",
            "verseOrgIds": [
              "JDG.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ gwara ya ihe niile, \"Ọ dịbeghị mgbe agụba ọbụla gara nʼelu isi m, nʼihi na abụ m onye Nazirait, onye e doro nsọ nye Chineke ka m bụ, site nʼafọ nne m. Ọ bụrụkwa na a kpụchapụ agịrị isi m, mgbe ahụ, ike niile dị m nʼahụ ga-apụ. Mgbe ahụ, aga m adịkwa ka ndị ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Delaịla matara na ọ gwala ya ihe niile, o ziri ozi kpọọ ndịisi ndị Filistia ahụ, sị, \"Bịaghachinụ otu ugbu a, nʼihi na ọ gwara m ihe niile.\" Ya mere, ndịisi ndị Filistia lọghachiri jiri ego ọlaedo ahụ nʼaka ha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.18",
            "verseOrgIds": [
              "JDG.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Delaịla mere ka o dinaa nʼapata ụkwụ ya rahụ ụra. Mgbe ahụ, ọ kpọbatara nwoke na-akpụcha isi, ka ọ kpụchapụ agịrị isi niile dị Samsin nʼisi, si otu a mee ka ike ghara ịdịkwa ya. Ike ya hapụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.19",
            "verseOrgIds": [
              "JDG.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tiri mkpu sị, \"Samsin, lee, ndị Filistia abịala ijide gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.20",
            "verseOrgIds": [
              "JDG.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 16:20"
      },
      "items": [
        {
          "text": "Ma mgbe Samsin bilitere site nʼụra, o chere nʼobi ya, \"Aga m apụ ka m si mee na mbụ megharịa arụ ma nwere onwe m.\" Ma ọ maghị na",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.20",
            "verseOrgIds": [
              "JDG.16.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.16.20",
                "verseOrgIds": [
                  "JDG.16.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ahapụla ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.20",
            "verseOrgIds": [
              "JDG.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Filistia jidere ya, ghụpụ ya anya ya abụọ, duru ya gbadata Gaza. Nʼebe ahụ, ha jiri ụdọ bronz kee ya agbụ, nye ya ọrụ ịnyagharị igwe na-akwọ ọka nʼụlọ mkpọrọ ha tinyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
              "JDG.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe na-adịghị anya, agịrị isi ya malitekwara ito ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Samsin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ndịisi ndị Filistia niile zukọtara ịchụrụ chi ha bụ Dagọn,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "text": "aja dị ukwuu, na ịṅụrị ọṅụ, na-asị, \"Chi anyị enyela Samsin bụ onye iro anyị nʼaka anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị mmadụ hụrụ ya, ha toro chi ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 16:24"
      },
      "items": [
        {
          "text": "\"Chi anyị enyela onye iro anyị",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 16:24"
      },
      "items": [
        {
          "text": "nʼaka anyị,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 16:24"
      },
      "items": [
        {
          "text": "onye mere ka ala anyị tọgbọrọ nʼefu",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 16:24"
      },
      "items": [
        {
          "text": "gbukwaa ọtụtụ ndị anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha ka nọ nʼobi ụtọ, ha tiri mkpu sị, \"Dupụtara anyị Samsin, ka o kpaa anyị ọchị.\" Ya mere, e dupụtara Samsin site nʼụlọ mkpọrọ ka o meere ha ihe egwuregwu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 16:25"
      },
      "items": [
        {
          "text": "Ha mere ka o guzo nʼetiti ebe ogidi e ji wuo ụlọ ahụ dị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Samsin sịrị onye na-eji ya nʼaka sị, \"Debe m nʼebe m ga-emetụ ogidi ndị ụlọ a na-eguzo na ha aka, ka m nwe ike dabere na ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, mmadụ ejupụtala nʼime ụlọ ahụ, nwoke na nwanyị; ndịisi ọchịchị ndị Filistia nọkwa nʼebe ahụ. Ndị ọzọ ọnụọgụgụ ha ruru puku atọ, nwoke na nwanyị, nọ nʼelu ụlọ ahụ na-ele Samsin, ebe ọ na-emere ha ihe ọchị.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Samsin kpere ekpere rịọọ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.16.28",
                "verseOrgIds": [
                  "JDG.16.28"
                ]
              }
            }
          ]
        },
        {
          "text": "arịrịọ sị, \"O! Onyenwe m",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JDG.16.28",
                "verseOrgIds": [
                  "JDG.16.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", biko cheta m naanị otu ugbu a. Biko, Chineke, nye m ike nʼotu ohere a m nwere, ka m nwee ike ịbọrọ ọbọ nʼahụ ndị Filistia nʼihi, ọ bụladị, mkpụrụ anya m abụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Samsin jidesiri ogidi abụọ dị nʼetiti ụlọ ahụ aka ike, aka nri ya nʼotu, aka ekpe ya na nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.29",
            "verseOrgIds": [
              "JDG.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samsin kpere ekpere sị, \"Ka m soro ndị Filistia nwụọ!\" O ji ike ya niile nuo ogidi ahụ aka. Otu mgbe ahụ kwa, ụlọ arụsị ahụ dara, dakwasị ndịisi ọchịchị Filistia ndị ahụ, na ndị niile nọ nʼime ụlọ ahụ. Ya mere, ndị niile so Samsin nwụọ nʼoge ahụ dị ọtụtụ karịa ndị Samsin gburu mgbe ọ dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, ụmụnna ndị ikom Samsin, na ndị ezinaụlọ nna ya bịara nʼebe ahụ, buru ozu ya. Ha liri ya nʼagbata Zora na Eshtaol, ebe e liri nna ya Manoa. Samsin kpere ụmụ Izrel ikpe iri afọ abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    }
  ],
