        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomọn ewuo ụlọnsọ ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn malitere iwu ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.1",
                "verseOrgIds": [
                  "2CH.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ bụ nʼugwu Mọrịa, nke dị na Jerusalem, ka e wukwasịrị ya, nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.3.1",
                "verseOrgIds": [
                  "2CH.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka Devid bụ nna ya hụ ya anya. Ọ bụ nʼala ebe ịzọcha ọka Arauna, onye Jebus, ebe ahụ Devid họpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O bidoro iwu ụlọ ahụ nʼabalị nke abụọ, nke ọnwa abụọ, nʼafọ nke anọ, nke ọchịchị eze ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntọala Solomọn tọrọ maka iwu ụlọnsọ Chineke dị iri mita abụọ na asaa nʼogologo, mita itoolu nʼobosara. (Nke a bụ ma ejiri ihe ọtụtụ ochie).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị ogologo mpụta ọnụ ụlọ nke ụlọnsọ ukwu ahụ dị mita itoolu, dịka ịdị ogologo obosara ụlọ nso ahụ nʼonwe ya. Ịdị elu ya dịkwa mita itoolu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 3:4"
      },
      "items": [
        {
          "text": "O jikwa ọlaedo a nụchara anụcha machie ime ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji osisi junipa machie ahụ ime ụlọ ezumezu ahụ, jirikwa ọlaedo a nụchara anụcha techie osisi ndị ahụ niile. Emesịa, e sere oyiyi nkwụ dị iche iche, na oyiyi ụdọ igwe nʼahụ ụlọ ahụ iji chọọ ya mma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji nkume dị oke ọnụahịa dị iche iche chọọ ime ụlọnsọ ahụ mma, ya na ọlaedo nke e si na Pavaim bute.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogidi osisi silin niile, na ibo ọnụ ụzọ niile, na aja ụlọ niile, na ọnụ ụzọ niile dị nʼụlọnsọ ukwu ahụ ka o ji ọlaedo techie. Ọ gbukwara egbugbu oyiyi cherubim na mgbidi ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru Ebe ahụ Kachasị Nsọ; nke ogologo ọnụ ụlọ ya dị mita iri, otu a kwa, obosara ya dị mita iri. O ji ọlaedo dị ezi mma nke ọnụahịa ya ruru narị talenti isii techie ahụ ime ụlọ ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ ọlaedo e ji kpụọ ǹtu e ji wuo ya dị iri shekel ise. E jikwa ọlaedo techie akụkụ elu elu nke ime ọnụ ụlọ a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn tinyere oyiyi mmụọ ozi cherubim abụọ ọ kpụrụ nʼime Ebe ahụ Kachasị Nsọ, werekwa ọlaedo machie ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị ogologo nku cherubim ndị a ruru mita iri. Ịdị ogologo otu nku cherub nke mbụ ruru mita abụọ na ọkara. Ọnụ nku a na-emetụ ahụ ime ụlọ nke ụlọnsọ ukwu, ma ọnụ ọnụ nku nke ọzọ, nke ịdị ogologo ya ruru mita abụọ nʼọkara, na-emetụ ọnụ otu nku cherub nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu aka ahụ, otu nku cherub nke abụọ ruru mita abụọ na ọkara nʼogologo. Ọnụ nku ya na-emetụ akụkụ nke ọzọ nke ahụ ime ụlọnsọ ukwu, ma nku ya nke ọzọ, nke rukwara mita abụọ na ọkara nʼogologo, na-emetụ ọnụ ọnụ otu nku cherub nke mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nku cherubim ndị a gbasapụrụ ruo mita iri nʼogologo. Ha guzo ọtọ nʼụkwụ ha, na-eche ihu nʼọnụ ụlọ ezumezu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji akwa na-acha anụnụ anụnụ, na uhie uhie, na odo odo, na ezi akwa ọcha, mee akwa mgbochi, nke a kpanyekwara oyiyi cherubim nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ogidi abụọ dị nʼihu ụlọnsọ ahụ, nke ịdị elu ya ruru mita iri na asaa. Ọ kpụkwara ihe a dokwasịrị nʼelu ogidi ndị a, nke ịdị elu ha dị mita abụọ na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụkwara ihe yiri ụdọ igwe a tụrụ atụ, nke e kokwasịrị nʼelu ogidi abụọ ndị ahụ. Kpụọkwa narị mkpụrụ pomegranet, nke a ganyekọtara ya na ụdọ igwe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O guzobere ogidi abụọ ndị ahụ nʼihu ụlọnsọ ukwu ahụ, otu nʼakụkụ ugwu nke ọzọ nʼakụkụ ndịda. Ogidi nke dị na ndịda ka ọ kpọrọ Jakin, ma nke dị nʼugwu ka ọ kpọrọ Boaz.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
    }
  ],
