                "verseOrgIds": [
                  "2CH.36.21"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru site nʼọnụ Jeremaya onye amụma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
