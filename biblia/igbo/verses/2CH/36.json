  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "2CH 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "nb"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ala ahụ kpọọrọ Jehoahaz, nwa nwoke Josaya mee ya eze na Jerusalem, nʼọnọdụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahaz eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahaz gbara iri afọ abụọ na atọ mgbe o bidoro ịchị, ma ọ chịrị na Jerusalem ọnwa atọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Ijipt chụdara ya site nʼọchịchị na Jerusalem, kwagide ndị Juda ka ha tụọra ya ụtụ narị talenti ọlaọcha na otu talenti ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Ijipt mere Eliakịm, otu nwanne Jehoahaz, eze ndị Juda na Jerusalem. Ọ gụgharịrị aha Eliakịm ka ọ bụrụ Jehoiakim. Ma Neko duuru Jehoahaz nwanne nwoke Eliakịm gaa Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakim eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakim gbara iri afọ abụọ na ise mgbe ọ malitere ịbụ eze. Ọ chịrị afọ iri na otu na Jerusalem. O mere ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.5",
                "verseOrgIds": [
                  "2CH.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadneza eze Babilọn busoro ya agha, jiri ụdọ bronz kee ya agbụ, nʼihi i duru ya gaa Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadneza bukọkwaara efere na iko ọlaedo dị nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.7",
                "verseOrgIds": [
                  "2CH.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", buru ha gaa buba ha nʼụlọeze ya dị na Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ ọzọ niile gbasara ọchịchị Jehoiakim, na banyere ihe arụ niile o mere, na ihe niile a chọpụtara megide ya, ka e dere nʼakwụkwọ akụkọ ndị eze Izrel na Juda. Jehoiakin nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoiakin eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakin gbara afọ iri na asatọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "text": "mgbe ọ malitere ịbụ eze, ọ chịrị naanị ọnwa atọ na abalị iri na Jerusalem. O mere ihe jọrọ njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.9",
                "verseOrgIds": [
                  "2CH.36.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, nʼafọ nke ọzọ ya, Nebukadneza ziri ozi mee ka akpọrọ ya, na ọtụtụ ihe ndị dị oke ọnụahịa sitere nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.10",
                "verseOrgIds": [
                  "2CH.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", bulaa ha Babilọn nʼoge a. O mere nwanne nna Jehoiakin bụ Zedekaya, eze Juda na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zedekaya eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekaya gbara iri afọ abụọ na otu mgbe e mere ya eze. Ọ chịrị afọ iri na otu na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe jọrọ njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya, o wedaghị onwe ya ala nara ndụmọdụ Jeremaya bụ onye amụma, onye na-ekwu okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.12",
                "verseOrgIds": [
                  "2CH.36.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, o nupuru isi megide eze Nebukadneza, onye mere ka ọ ṅụọ iyi nʼaha Chineke. Ọ ghọrọ onye isiike, onye mechiri obi ya, jụ ichigharịkwute",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.13",
                "verseOrgIds": [
                  "2CH.36.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ka ihe dị njọ karịa, mmadụ niile, tinyere ndị ndu nʼetiti ndị nchụaja, nọgidere bụrụ ndị na-ekwesighị ntụkwasị obi, site nʼịgbaso omenaala rụrụ arụ nke mba niile gbara ha gburugburu. Ha merụrụ ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.14",
                "verseOrgIds": [
                  "2CH.36.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke o doro nsọ nʼime Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọdịda Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.15",
                "verseOrgIds": [
                  "2CH.36.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nna nna ha, sitere nʼọnụ ndị amụma ya gwa ha okwu mgbe na mgbe, ịdọ ha aka na ntị. O mere nke a nʼihi na o nwere obi ebere nʼebe ha nọ, na nʼebe ụlọnsọ ukwu ya dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha kwara ndị amụma Chineke ndị a emo, lelịa okwu Chineke ha wetara anya, chịa amụma ha buru ọchị, tutu ruo mgbe ha kpasuru ọnụma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.16",
                "verseOrgIds": [
                  "2CH.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "megide ndị ya, ruo mgbe ihe ọbụla na-adịghịkwa nke pụrụ igbochi ngosipụta oke ọnụma a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, o welitara eze Kaldịa imegide ha, bụ onye ji mma agha gbuchapụ ụmụ okorobịa ha nʼụlọ ebe nsọ ha. O nweghịkwa ọmịiko nʼebe ụmụ okorobịa, maọbụ ụmụ agbọghọ dị, ndị okenye maọbụ ndị nrịa nrịa. Chineke weere ha niile nyefee ha nʼaka Nebukadneza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼụlọnsọ ukwu Chineke kpokọrọ ihe niile dị nʼime ya, ma ihe ukwu ma ihe nta, tinyere akụ niile dị nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.36.18",
                "verseOrgIds": [
                  "2CH.36.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nʼụlọeze, na nʼụlọ ndịisi ozi eze buru ha gaa Babilọn.",
          "type": "text",
          "attrs": {
