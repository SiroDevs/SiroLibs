  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "2CH 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụzaya eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị Juda mere Ụzaya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "text": "eze nʼọnọdụ Amazaya nna ya, mgbe ọ dị naanị afọ iri na isii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ Ụzaya wugharịrị obodo Elat, nwetaghachi ya nye Juda mgbe eze bụ Amazaya sooro ndị nna nna ya dinaa nʼọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzaya dị afọ iri na isii mgbe ọ malitere ịchị dịka eze. Ọ chịrị iri afọ ise na abụọ na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O soro nzọ ụkwụ nna ya bụ Amazaya mee ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.4",
                "verseOrgIds": [
                  "2CH.26.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzaya chọsịrị Chineke ike ụbọchị niile nke Zekaraya na-adị ndụ, bụ onye mere ka ọ ghọta ịtụ egwu Chineke. Mgbe niile, dịka ọ na-achọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.5",
                "verseOrgIds": [
                  "2CH.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nyere ya ọganihu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O busoro ndị Filistia agha, ma kụdakwa mgbidi niile nke Gat, Jabna, na Ashdọd. Emesịa, o wuziri ọtụtụ obodo dị nʼakụkụ Ashdọd na nʼebe ndị ọzọ nʼobodo Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke nọnyeere ya nʼọgụ niile ọ lụsoro ndị Filistia, na ndị Arab bi na Gua Baal na ndị Meunim.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.7",
            "verseOrgIds": [
              "2CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Amọn na-atụtara ya ụtụ afọ niile, ude aha ya ruru ọ bụladị ala Ijipt nʼihi na ọ ghọrọ onye dị ike nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ọtụtụ ụlọ elu nche na Jerusalem na nkuku Ọnụ Ụzọ Ama, nʼỌnụ Ụzọ Ama Ndagwurugwu, na nkuku mgbidi, wusie ha ike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wukwara ọtụtụ ụlọ elu nche siri ike nʼọzara, gwuokwa ọtụtụ olulu mmiri nʼihi na o nwere ọtụtụ anụ ụlọ na ndagwurugwu, na nʼala dị larịị. Ọ hụrụ ịrụ ọrụ ubi nʼanya, nʼihi ya, o nwere ọtụtụ ndị na-arụ ọrụ nʼubi na ubi vaịnị ya dị nʼala ugwu ugwu, na nʼala ndị dị na ndagwurugwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzaya nwere ndị agha ọnụọgụgụ ha dị ukwuu, ndị a zụziri azụzi, na ndị nọ na njikere mgbe niile ịpụ ibu agha dịka ọnụọgụgụ e kewapụtara ha si dị. Ọ bụ Jeiel, ode akwụkwọ na Maaseia, onyeisi ozi nọ nʼokpuru Hananaya, otu nʼime ndịisi ozi eze, ka ọ dị nʼaka ịgụpụta ndị agha ga-apụ ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha a nwekwara puku ndịisi agha abụọ na narị isii, ya bụ 2,600.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ndị agha ahụ niile dị narị puku atọ na asaa, na narị ise, ya bụ, 307,500. Ha bụ ndị a zụziri nke ọma, ndị dị nnọọ ike iguzo nʼazụ eze ibu agha megide ndị iro ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzaya nyere ndị agha niile, ọta, na ùbe, na uwe agha, na okpu igwe, na uwe agha igwe, ụta na nkume na-akwọ mụrụmụrụ, nke ndị na-atụ iche ji alụ ọgụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mepụtakwara ihe nchepụta ọhụrụ na Jerusalem, nke ndị nwere amamihe chepụtara, bụ nke a ga-eguzobe nʼụlọ elu nche nakwa nʼelu nkuku mgbidi, ka ndị agha nwee ike jiri ha gbaa àkụ maọbụ tụọ nkume ukwu site nʼelu mgbidi ahụ niile. Ude aha ya gbasara ruo ebe dị anya, nʼihi na-enyeere ya aka nʼụzọ dị ukwuu ruo mgbe ọ ghọrọ onye dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Ụzaya ghọrọ onye dị ike, nganga wetaara ya ọdịda. Ọ bụ onye na-ekwesighị ntụkwasị obi nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.16",
                "verseOrgIds": [
                  "2CH.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ya, ọ banyere nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.16",
                "verseOrgIds": [
                  "2CH.26.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ọ chụọ aja ihe nsure ọkụ na-esi isi ụtọ nʼelu ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaraya onye nchụaja na ndị nchụaja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.17",
                "verseOrgIds": [
                  "2CH.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "iri asatọ ọzọ bụ dimkpa jekwuru ya nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha guzogidere eze bụ Ụzaya, sị ya, \"Ụzaya, i kwesighị ịbata nʼebe a jiri aka gị suree ihe nsure ọkụ na-esi isi ụtọ nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.18",
                "verseOrgIds": [
                  "2CH.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nke a bụ ọrụ dịrị naanị ndị nchụaja ndị bụ ụmụ Erọn, ndị a họpụtara doo iche maka ọrụ a. Site nʼebe nsọ a pụọ, nʼihi na i gosila onwe gị dịka onye na-ekwesighị ntụkwasị obi. Ọzọ ị gaghị enwekwa nsọpụrụ site nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.18",
                "verseOrgIds": [
                  "2CH.26.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzaya onye ji ihe ịgụ ọkụ nke e ji esure ihe nsure ọkụ na-esi isi ụtọ ahụ nʼaka, were iwe nke ukwu megide ndị nchụaja ahụ. Mgbe ọ nọ na-abara ndị nchụaja mba nʼihu ebe ịchụ aja nke dị nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.19",
                "verseOrgIds": [
                  "2CH.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", lee ekpenta pụtara ya nʼegedege ihu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Azaraya onyeisi nchụaja, na ndị nchụaja ọzọ niile lere ya anya, ha hụrụ na ekpenta agbaala ya nʼegedege ihu ya, ha mere ka ọ site nʼebe ahụ pụọ ngwangwa. Ya onwe ya kwa chọkwara isite nʼebe ahụ pụọ ngwangwa, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.20",
                "verseOrgIds": [
                  "2CH.26.20"
                ]
              }
            }
          ]
        },
        {
          "text": "tiri ya ihe otiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Ụzaya bụ onye ekpenta ruo ụbọchị ọnwụ ya. O biri nʼụlọ ewupụrụ iche, ebe ọ bụ onye ekpenta, na onye amapụrụ site nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.26.21",
                "verseOrgIds": [
                  "2CH.26.21"
                ]
              }
            }
          ]
        },
        {
          "text": ". Jotam nwa ya ghọrọ onye nlekọta ụlọeze, na-achịkwa ndị ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị ọzọ niile mere nʼoge ọchịchị Ụzaya, site na mmalite ruo ọgwụgwụ, onye amụma Aịzaya nwa Emọz deturu ha nʼakwụkwọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.22",
            "verseOrgIds": [
              "2CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzaya soro ndị nna nna ya dina nʼọnwụ, e lie ya nso nʼọhịa ebe a na-eli ozu nke dịịrị ndị eze, maka na ndị mmadụ sịrị, \"Ọ bụ onye ekpenta.\" Jotam nwa ya, ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
            ]
          }
        }
      ]
    }
