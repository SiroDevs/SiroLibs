  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2CH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngwongwo dị nʼụlọnsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn wukwara ebe ịchụ aja bronz. Ogologo ya ruru iri mita na ọkara. Obosara ya rukwara iri mita na ọkara; ma ịdị elu ya dị mita ise na ụma atọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.1",
            "verseOrgIds": [
              "2CH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mekwara Oke osimiri nke ọla awụrụ awụ, nke dị gburugburu nʼụdịdị. Ọtụtụ ya bụ ihe ruru mita abụọ na ụma atọ nʼogologo, dịkwa mita ise na ụma atọ, site nʼotu ọnụ ruo nʼọnụ nke ọzọ. Ọ bụ eriri e ji atụ ihe nke ruru ihe dịka mita iri na anọ ka e ji tụọ ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.2",
            "verseOrgIds": [
              "2CH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼokpuru ọnụ ya, oyiyi ụmụ oke ehi gbara ya gburugburu, iri dị na mita anọ na ọkara ọbụla. Ehi ndị ahụ dị nʼahịrị abụọ. A wụkọtara ha na Oke osimiri ahụ otu mgbe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.3",
            "verseOrgIds": [
              "2CH.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mekwara ka Oke osimiri ahụ guzo nʼelu ehi iri na abụọ. Atọ na-eche ihu nʼakụkụ ọwụwa anyanwụ; atọ na-eche ihu nʼọdịda anyanwụ; atọ na-eche ihu nʼakụkụ ndịda, atọ na-eche ihu nʼakụkụ ugwu. Oke osimiri ahụ dịkwasịrị ha nʼelu, ebe azụ ha niile dị nʼime nʼetiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.4",
            "verseOrgIds": [
              "2CH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ ya ha ka otu ọtụtụ ntu-aka dimkpa. E mere ọnụ ya ka ọ dị ka ọnụ iko mmiri, dịkwa ka okoko lili na-awapụta awapụta. Ọ na-erite puku galọọnụ iri na asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.5",
            "verseOrgIds": [
              "2CH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kpụkwara efere ukwu iri nke e ji asacha ihe e wetara maka ịchụ aja nsure ọkụ. Ise nʼime ha dị nʼakụkụ ndịda olulu mmiri ahụ, ise nʼakụkụ ugwu. Ndị nchụaja na-esite naanị na olulu mmiri ahụ ekuru mmiri ha ji asacha ihe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.6",
            "verseOrgIds": [
              "2CH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụrụ ihe ịdọba oriọna ọlaedo iri nʼusoro dịka Chineke nyere ya nʼiwu. O debere ha nʼime ụlọnsọ ukwu ahụ, ise nʼakụkụ ndịda ụlọ ahụ, ise nʼakụkụ nke ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7",
            "verseOrgIds": [
              "2CH.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mekwara tebul iri dọnye nʼụlọnsọ ukwu ahụ, ise nʼakụkụ ndịda, ise nʼakụkụ ugwu. Ọ kpụkwara otu narị efere ọlaedo maka ịkwọsa mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.8",
            "verseOrgIds": [
              "2CH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ mere ogige ndị nchụaja, mekwa otu ogige ukwuu, na ibo ọnụ ụzọ maka itinye nʼogige ahụ. O jiri bronz machie ibo ọnụ ụzọ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke osimiri ahụ ka ọ dọbara nʼakụkụ ndịda, na ncherita ihu ọwụwa anyanwụ nke ụlọnsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huram kpụkwara ite dị iche iche, shọvel niile,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        },
        {
          "text": "na efere ịkwọsa mmiri niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 4:11"
      },
      "items": [
        {
          "text": "Nʼikpeazụ, ọ rụchara ọrụ dị nʼụlọnsọ Chineke, nke eze Solomọn tinyere ya nʼaka ịrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11",
            "verseOrgIds": [
              "2CH.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogidi abụọ ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:12"
      },
      "items": [
        {
          "text": "ihe ọkpụkpụ abụọ dịka efere dị nʼelu ogidi abụọ ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:12"
      },
      "items": [
        {
          "text": "Ihe ọkpụkpụ yiri ụdọ a tụrụ atụ nke e ji chọọ ihe ọkpụkpụ abụọ ahụ dịka efere mma;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.12",
            "verseOrgIds": [
              "2CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "narị anọ nke mkpụrụ pomegranet a kpụrụ akpụ maka ahịrị ihe abụọ ahụ a kpụrụ akpụ, ya bụ, ahịrị pomegranet abụọ nʼihi otu ihe ọkpụkpụ, iji chọọ ihe ọkpụkpụ ahụ yiri efere dị nʼisi elu ogidi ahụ mma;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.13",
            "verseOrgIds": [
              "2CH.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihe ndọkwasị na efere ịsa mmiri ha,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.14",
            "verseOrgIds": [
              "2CH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Oke osimiri ahụ na ehi iri na abụọ ahụ dị ya nʼokpuru,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.15",
            "verseOrgIds": [
              "2CH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ite niile, shọvel niile, ihe ịgụrụ anụ niile na ihe ngwongwo ndị ọzọ ya na ha so.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 4:16"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 4:16"
      },
      "items": [
        {
          "text": "Ihe niile nke Huram-Abi mere eze Solomọn nʼihi ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.4.16",
                "verseOrgIds": [
                  "2CH.4.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ bronz e hichaziri nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.16",
            "verseOrgIds": [
              "2CH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼala ụrọ, nʼobosara ala Jọdan, nʼetiti Sukọt na Zaretan, ka eze mere ka a nọrọ kpụọ ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a niile nke Solomọn mere dị ukwuu nke ukwu; nke bụ na-enweghị ike ịgụkọta ihe ịdị arọ nke bronz ahụ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn mekwara ngwongwo niile dị nʼime ụlọnsọ Chineke, ya bụ,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 4:19"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:19"
      },
      "items": [
        {
          "text": "ebe ịchụ aja e ji ọlaedo kpụọ,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 4:19"
      },
      "items": [
        {
          "text": "na tebul niile nke a dọkwasịrị achịcha nke iche nʼIhu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.4.19",
                "verseOrgIds": [
                  "2CH.4.19"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihe ịdọkwasị oriọna niile nke ọlaedo a nụchara anụcha, ha na oriọna ha niile, ka ọ na-enwu nʼihu ime ime ebe nsọ, dịka e nyere nʼiwu,",
          "type": "text",
          "attrs": {
