  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2CH 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abija eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija malitere ịbụ eze Juda, nʼafọ iri na asatọ nke ọchịchị eze Jeroboam.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.1",
            "verseOrgIds": [
              "2CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịrị afọ atọ na Jerusalem. Aha nne ya bụ Maaka,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "text": "otu nʼime ụmụ nwanyị",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "text": "Uriel, onye Gibea.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 13:2"
      },
      "items": [
        {
          "text": "Agha dịgidere nʼetiti Abija na Jeroboam.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.2",
            "verseOrgIds": [
              "2CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija họpụtara ndị ya dị ike nʼagha bụ ndị ọnụọgụgụ ha dị narị puku anọ, ma Jeroboam eze Izrel họpụtara ndị agha ọnụọgụgụ ha dị narị puku asatọ doo ha nʼusoro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.3",
            "verseOrgIds": [
              "2CH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija guzoro nʼugwu Zemaraim nʼala ugwu ugwu Ifrem jiri oke olu sị \"Jeroboam na ndị Izrel niile geenụ m ntị!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.4",
            "verseOrgIds": [
              "2CH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu amataghị na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.5",
                "verseOrgIds": [
                  "2CH.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nke Izrel esitela nʼọgbụgba ndụ nnu nyefee ọchịchị ala Izrel niile nʼaka Devid na ụmụ ụmụ ya ruo ebighị ebi?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jeroboam, nwa Nebat, bụ onye ọrụ Solomọn nwa Devid, nupuru isi megide onyenwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị efu niile na-abaghị uru chịkọtara onwe ha gbaa ya gburugburu guzogide Rehoboam nwa Solomọn, mgbe ọ bụ nwantakịrị na onye na-enweghị ike inwe mkpebi, onye nʼadịghịkwa ike iguzogide ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, unu ejikerela imegide alaeze",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.8",
                "verseOrgIds": [
                  "2CH.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nke dị nʼaka ụmụ ụmụ Devid. Nʼezie, unu bu igwe ndị agha bara ụba, nʼetiti unu ka ụmụ ehi ọlaedo ahụ dịkwa, bụ nke Jeroboam mere ka ha buru chi unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu achụpụghị ndị nchụaja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.9",
                "verseOrgIds": [
                  "2CH.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ ụmụ Erọn, chụpụkwa ndị Livayị ma meere onwe unu ndị nchụaja dịka ndị mba ọzọ na-eme? Onye ọbụla ji nwa oke ehi na ebule asaa bịa ido onwe ya nsọ na-aghọrọ unu onye nchụaja nye ihe ndị ahụ na-abụghị chi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma banyere anyị,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.10",
                "verseOrgIds": [
                  "2CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke anyị, anyị ahapụbeghị ya. Ndị nchụaja na-ejere",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.10",
                "verseOrgIds": [
                  "2CH.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ozi bụ ụmụ Erọn, ndị Livayị bụkwa ndị na-enyere ha aka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-achụ aja nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.11",
                "verseOrgIds": [
                  "2CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwa ụtụtụ na anyasị niile, na-esurekwa ihe nsure ọkụ na-esi isi ụtọ; ma na-edobekwa achịcha edoro nsọ nʼelu tebul ahụ dị ọcha. Ha na-amụnyekwa ọkụ nʼiheọkụ ndị ahụ dị nʼelu ihe ịdọba oriọna ọlaedo kwa abalị niile. Nʼihi na anyị onwe anyị na-edebe iwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.11",
                "verseOrgIds": [
                  "2CH.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị; ma unu onwe unu ahapụla ya, gbakụta ya azụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke nọnyeere anyị. Ọ bụkwa onyendu anyị. Ndị nchụaja ya ga-eji ịfụ opi ike tie mkpu agha megide unu. Unu ndị Izrel, unu alụsokwala",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.12",
                "verseOrgIds": [
                  "2CH.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke nna unu ha ọgụ nʼihi na mmeri agaghị abụ nke unu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jeroboam ezipụlarị ụfọdụ ndị agha ya ka ha ga ndị agha Juda nʼazụ. Mgbe Jeroboam nọ nʼihu ndị Juda, ụfọdụ ndị agha ya nọkwa ndị Juda nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
            "verseOrgIds": [
              "2CH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị agha Juda tụgharịrị hụ na agha dị ha nʼihu dịkwa nʼazụ, ha tikuru",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.14",
                "verseOrgIds": [
                  "2CH.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mkpu nzọpụta, ndị nchụaja fụkwara opi ike ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.14",
            "verseOrgIds": [
              "2CH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Juda tiri oke mkpu agha. Mgbe ha na-eti mkpu a, Chineke mere ka Abija na ndị Juda merie Jeroboam na ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.15",
            "verseOrgIds": [
              "2CH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha Izrel gbara ọsọ nʼihu ndị Juda, Chineke nyefere ha nʼaka ndị Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.16",
            "verseOrgIds": [
              "2CH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija na ndị agha ya gburu narị puku ndị Izrel ise nʼụbọchị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.17",
            "verseOrgIds": [
              "2CH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ntụkwasị obi nke Juda nwere nʼime",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.18",
                "verseOrgIds": [
                  "2CH.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna ha mere ka ha merie Jeroboam na ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.18",
            "verseOrgIds": [
              "2CH.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija chụkwara Jeroboam na ndị agha ya ọsọ dọta obodo ndị a nʼagha: Betel, na Jeshana, na Efrọn, na obodo niile gbara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.19",
            "verseOrgIds": [
              "2CH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
