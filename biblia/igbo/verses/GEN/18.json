          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.18.33",
                "verseOrgIds": [
                  "GEN.18.33"
                ]
              }
            }
          ]
        },
        {
          "text": "gwachara Ebraham okwu, ọ hapụrụ ya gawa ebe ọ na-aga. Ebraham laghachiri azụ nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
