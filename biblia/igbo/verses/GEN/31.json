  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "GEN 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jekọb ahapụ Padan Aram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb nụrụ na ụmụ ndị ikom Leban na-asị, \"Jekọb ewerechaala ihe niile nna anyị nwere. O sitere nʼihe nna anyị nwere kpata akụnụba ya niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.1",
            "verseOrgIds": [
              "GEN.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb hụkwara na omume Leban nʼebe ọ nọ adịghịkwa otu ọ dị na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.2",
            "verseOrgIds": [
              "GEN.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.31.3",
                "verseOrgIds": [
                  "GEN.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Jekọb, \"Laghachi nʼala nna gị ha, lakwuru ụmụnna gị, aga m anọnyere gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.3",
            "verseOrgIds": [
              "GEN.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Jekọb ziri Rechel na Lịa ozi ka ha bịakwute ya nʼọhịa ebe ọ nọ na-elekọta igwe anụ ụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.4",
            "verseOrgIds": [
              "GEN.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha, \"Ahụla m na omume nna unu nʼebe m nọ adịghịkwa otu ọ dị na mbụ. Ma Chineke nna m ha nọnyeere m.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.5",
            "verseOrgIds": [
              "GEN.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu maara na eji m ike m niile rụọra nna unu ọrụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.6",
            "verseOrgIds": [
              "GEN.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nna unu ghọgburu m, gbanwee ụgwọ ọrụ m ugboro iri. Otu ọ dị, Chineke ekweghị ka nna unu merụọ m ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.7",
            "verseOrgIds": [
              "GEN.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ sị, 'Ndị tụrụ agwa agwa ga-abụ ụgwọ ọrụ gị,' mgbe ahụ, igwe anụ ụlọ niile na-amụ ụmụ na-abụ ndị tụrụ agwa. Ma ọ bụrụ na ọ sị, 'Ndị niile nwere ntụpọ ga-abụ ụgwọ ọrụ gị,' mgbe ahụ, igwe anụ ụlọ niile na-amụ ụmụ na-enwe ntụpọ ọcha nʼahụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.8",
            "verseOrgIds": [
              "GEN.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke napụrụ nna unu anụ ụlọ ya ma nye m ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.9",
            "verseOrgIds": [
              "GEN.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼoge ụmụ anụ ụlọ ji atụ ime, eweliri m anya hụ na nrọ na ụmụ mkpi niile na-agba igwe nne ewu bụ ụmụ mkpi ndị tụrụ agwa agwa, ndị nwere akara maọbụ ndị nwere ntụpọ ọcha nʼahụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.10",
            "verseOrgIds": [
              "GEN.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi Chineke sịrị m na nrọ, 'Jekọb.' Azara m sị, 'Lee m nʼebe a.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.11",
            "verseOrgIds": [
              "GEN.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, 'Lelie anya gị elu, lee ka ị hụ na mkpi niile na-agba igwe nne ewu ndị a bụ mkpi ndị ahụ tụrụ agwa agwa, ndị nwere akara maọbụ ndị nwere ntụpọ ọcha. Nʼihi na ahụla m ihe niile Leban na-eme gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.12",
            "verseOrgIds": [
              "GEN.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m bụ Chineke nke Betel, ebe ị wụkwasịrị mmanụ nʼogidi nkume ahụ, ebe ị kwekwara m nkwa. Ugbu a, kulie, hapụ obodo a, laghachi nʼala a nọ mụọ gị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.13",
            "verseOrgIds": [
              "GEN.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rechel na Lịa zara sị ya, \"Anyị ka nwere oke nʼihe nketa nʼụlọ nna anyị?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.14",
            "verseOrgIds": [
              "GEN.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị dịka ndị ọbịa ka ọ gụnyeziri anyị? Nʼihi na o reela anyị, ripịakwa ụgwọ isi anyị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.15",
            "verseOrgIds": [
              "GEN.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, akụ ndị ahụ Chineke napụrụ nna anyị bụ nke anyị na nke ụmụ anyị. Ya mere, mee ihe ọbụla Chineke sị gị mee.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.16",
            "verseOrgIds": [
              "GEN.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb biliri, kukwasị ụmụ ya na ndị nwunye ya nʼelu ịnyịnya kamel,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.17",
            "verseOrgIds": [
              "GEN.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "duru igwe anụ ụlọ ya niile, na ihe ọ kpatara na Padan Aram, lakwuru nna ya Aịzik nʼala Kenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.18",
            "verseOrgIds": [
              "GEN.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Leban gara ịkpachapụ ajị ụmụ atụrụ ya, Rechel zuuru arụsị ezinaụlọ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.19",
            "verseOrgIds": [
              "GEN.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb ghọkwara Leban onye Aram aghụghọ nʼihi na ọ gwaghị ya na ọ na-agbapụ ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.20",
            "verseOrgIds": [
              "GEN.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, o buru ihe niile o nwere gbapụ ọsọ, gbafee iyi ukwu Yufretis, chee ihu nʼala ugwu ugwu Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.21",
            "verseOrgIds": [
              "GEN.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Leban achụso Jekọb ọsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalị atọ agafeelarị tupu a gwa Leban na Jekọb agbalaala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.22",
            "verseOrgIds": [
              "GEN.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O duuru ndị ikwu ya chụọ Jekọb ọsọ abalị asaa tupu ọ chụkwute ya nʼala ugwu ugwu Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.23",
            "verseOrgIds": [
              "GEN.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke bịakwutere Leban onye Aram na nrọ nʼabalị sị ya, \"Kpachapụ anya gị, hụ na o nweghị ihe ị gwara Jekọb, maọbụ okwu dị mma, maọbụ nke dị njọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.24",
            "verseOrgIds": [
              "GEN.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb amaala ụlọ ikwu ya nʼala ugwu Gilead mgbe Leban chụkwutere ya. Leban na ndị ikwu ya makwara ụlọ ikwu nke ha nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.25",
            "verseOrgIds": [
              "GEN.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leban sịrị Jekọb, \"Gịnị bụ ihe a i mere? Ị ghọgbuola m. I burula ụmụ m ndị inyom dịka ndị a dọtara nʼagha?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.26",
            "verseOrgIds": [
              "GEN.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji ghọgbuo m, zoro ezo gbapụ? Gịnị mere ị gwaghị m ka m jiri ọṅụ na ịbụ abụ nke ya na ịkpọ ụbọ akwara na iti ịgba so, zilaga gị?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.27",
            "verseOrgIds": [
              "GEN.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i nyeghị m ohere ka m sutu ụmụ ụmụ m na ụmụ m ndị inyom ọnụ sị ha laa nke ọma? Omume a i mere bụ omume nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.28",
            "verseOrgIds": [
              "GEN.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enwere m ike merụọ gị ahụ ugbu a, ma Chineke nke nna gị mere ka m hụ ya anya na nrọ nʼabalị gara aga. Ọ dọrọ m aka na ntị sị m, 'Kpachapụ anya gị hụ na o nweghị ihe ị gwara Jekọb, maọbụ okwu dị mma, maọbụ nke dị njọ.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.29",
            "verseOrgIds": [
              "GEN.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ị na-ala nʼihi na ọ gụrụ gị agụụ ịlaghachi nʼụlọ nna gị, ma gịnị mere i ji zuru chi m?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.30",
            "verseOrgIds": [
              "GEN.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb zara sị Leban, \"Nʼihi na m tụrụ egwu, nʼihi na m chere sị na ị ga-eji ike napụ m ụmụ gị ndị inyom a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.31",
            "verseOrgIds": [
              "GEN.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị chọta onye ọbụla ji chi gị ndị a, onye ahụ ga-anwụ. Nʼihu ndị ikwu gị ndị a, chọgharịa nʼonwe gị, lee ma ị ga-achọta ihe ọbụla bụ nke gị dị m nʼaka. Ọ bụrụ na ị chọta ya, were ya.\" Ma Jekọb amaghị na Rechel zuuru chi ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.32",
            "verseOrgIds": [
              "GEN.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Leban bara nʼụlọ ikwu Jekọb, na nʼime ụlọ ikwu Lịa, na nʼime ụlọ ikwu ndị odibo nwanyị abụọ ya, ma o nweghị ihe ọ chọtara. O sitere nʼụlọ ikwu Lịa pụta baa nʼụlọ ikwu Rechel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.33",
            "verseOrgIds": [
              "GEN.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Rechel ewerela arụsị ezinaụlọ ndị ahụ tinye ha nʼime akwa e ji anọkwasị nʼelu ịnyịnya kamel nọdụ ọdụ nʼelu ya. Leban chọgharịrị ebe niile nʼime ụlọ ikwu ahụ ma ọ chọtaghị arụsị ezinaụlọ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.34",
            "verseOrgIds": [
              "GEN.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Rechel gwara nna ya Leban sị, \"Biko, ewela iwe nna m ukwu, nʼihi na enweghị m ike ibili ọtọ nʼihu gị. Anọ m nʼọnọdụ ndị inyom na-anọ kwa ọnwa.\" Leban chọgharịrị ebe niile, ma ọ hụghị arụsị ezinaụlọ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.35",
            "verseOrgIds": [
              "GEN.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe were Jekọb megide Leban. O ji iwe jụọ Leban sị, \"Gịnị bụ njehie m? Gịnị bụ mmehie m mere i ji si otu a na-achụsi m ike?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.36",
            "verseOrgIds": [
              "GEN.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ị chọgharịala nʼibu m niile, gịnị ka ị chọtara bụ nke gị? Wepụta ya nʼihu ndị ikwu gị na nʼihu ndị nke m, ka ha kpeere mụ na gị ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.37",
            "verseOrgIds": [
              "GEN.31.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iri afọ abụọ ka mụ na gị nọrọ. O nweghị mgbe ime pụrụ ụmụ ewu na atụrụ gị; o nwekwaghị mgbe m riri ebule si nʼigwe anụ ụlọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.38",
            "verseOrgIds": [
              "GEN.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị mgbe m welataara gị anụ ụlọ nke anụ ọhịa dọgburu, kama akwụrụ m ụgwọ ha. I mekwara ka m kwụghachi gị anụ ụlọ ọbụla e zuru nʼohi, maọbụ nʼehihie, maọbụ nʼabalị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.39",
            "verseOrgIds": [
              "GEN.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime oke anwụ nke ehihie ka m rụụrụ gị ọrụ. Rụọkwara gị ọrụ nʼoge oyi na-atụ, nʼabalị ụra sikwa nʼanya m pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.40",
            "verseOrgIds": [
              "GEN.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ọ dịrị m iri afọ abụọ m jeere gị ozi. Arụrụ m gị ọrụ afọ iri na anọ maka ụmụ gị ndị inyom abụọ ndị a, afọ isii ka m lekọtara igwe ewu na atụrụ gị. Ị nọkwa nʼime ihe ndị a gbanwee ụgwọ ọrụ m ugboro iri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.41",
            "verseOrgIds": [
              "GEN.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sị na Chineke m, Chineke Ebraham, onye ahụ a na-atụ egwu nke Aịzik, anọnyereghị m, ị gaara ezilaga m nʼaka efu, agaara m agbara aka laa. Ma Chineke ahụla ịrụsị ọrụ ike m, na nhụju anya m niile, ọ bụ ya mere o ji baara gị mba nʼabalị gara aga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.42",
            "verseOrgIds": [
              "GEN.31.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Leban zaghachiri sị Jekọb, \"Ndị inyom ndị a bụ ụmụ m. Ụmụaka ndị a bụ ụmụ m. Igwe anụ ụlọ ndị a bụ nke m. Ihe ndị a niile ị na-ahụ anya bụ nke m. Olee otu m ga-esi merụọ ụmụ m, na ụmụ ụmụ m ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.43",
            "verseOrgIds": [
              "GEN.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, bịa ka anyị gbaa ndụ mụ na gị, ka ọ bụrụ ihe ama nʼetiti anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.44",
            "verseOrgIds": [
              "GEN.31.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Jekọb weere otu nkume guzo ya ọtọ dịka ogidi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.45",
            "verseOrgIds": [
              "GEN.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb gwakwara ndị so ya sị ha, \"Tụtụkọta nkume.\" Ha tụtụkọtara nkume wụsa ha nʼotu ebe mee ka ọ laa elu. Emesịa, ha nọdụrụ nʼakụkụ nkume ndị ahụ rie nri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.46",
            "verseOrgIds": [
              "GEN.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "GEN 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leban kpọrọ nkume ndị ahụ Jega-Sahaduta, nʼasụsụ nke ya. Jekọb kpọrọ ya Galeed, nʼasụsụ nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.47",
            "verseOrgIds": [
              "GEN.31.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "GEN 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Leban sịrị, \"Ka nkume ndị a bụrụ ihe ama nʼetiti mụ na gị taa.\" Nke a mere e ji kpọọ ya Galeed.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.48",
            "verseOrgIds": [
              "GEN.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "GEN 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kpọkwara ya Mizpa, nʼihi na Leban sịrị, \"Ka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.31.49",
                "verseOrgIds": [
                  "GEN.31.49"
                ]
              }
            }
          ]
        },
        {
          "text": "bụrụ onye ga-eche mụ na gị nche ịhụ na onye ọbụla nʼime anyị debere ọgbụgba ndụ a, mgbe anyị na-anọghị ibe anyị nso.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.49",
            "verseOrgIds": [
              "GEN.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "GEN 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i mee ụmụ m ndị inyom ihe ọjọọ, maọbụ lụọ ndị inyom ndị ọzọ tinyere ha, o nweghị onye nʼime anyị ga-amata, ma cheta na Chineke ga-abụ onyeama nʼetiti mụ na gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.50",
            "verseOrgIds": [
              "GEN.31.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "GEN 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leban gwakwara Jekọb sị, \"Lee nkume ndị a a wụsara nʼebe a na ogidi m mere ka o guzo nʼetiti mụ na gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.51",
            "verseOrgIds": [
              "GEN.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "GEN 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkume ndị a a wụsara bụ akaebe, ogidi a bụkwa ihe ama. Agaghị m agabiga nkume ndị a a wụsara gafeeta nʼakụkụ nke gị ime gị ihe ọjọọ. Gị onwe gị agaghị agabiga nkume ndị a a wụsara na ogidi a gafeeta nʼakụkụ nke m ime m ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "GEN 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Chineke Ebraham na Chineke Nahọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "text": "Chineke nna ha, bụrụ onye ikpe nʼetiti mụ na gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 31:53"
      },
      "items": [
        {
          "text": "Ya mere Jekọb ji onye ahụ a na-atụ egwu nke nna ya Aịzik ṅụọ iyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
            "verseOrgIds": [
              "GEN.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "GEN 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chụrụ aja nʼala ugwu ugwu ahụ, kpọọ ndị ikwu ya niile oriri. Mgbe ha richara nri, ha rahụrụ ụra nʼebe ahụ.",
          "type": "text",
          "attrs": {
