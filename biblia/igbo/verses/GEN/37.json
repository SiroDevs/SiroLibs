  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "GEN 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nrọ Josef",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb bigidere nʼala Kenan, ala ahụ nna ya buru ụzọ biri nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.1",
            "verseOrgIds": [
              "GEN.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ usoro akụkọ banyere ezinaụlọ Jekọb.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 37:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:2"
      },
      "items": [
        {
          "text": "Josef, onye gbarala afọ iri na asaa, na-esonyere ụmụnne ya ndị ikom na-azụ igwe anụ ụlọ, ya onwe ya bụ naanị nwantakịrị na-enyere ụmụ Bilha na ụmụ Zilpa ndị nwunye nna ya aka. Ma Josef na-ewetara nna ha akụkọ maka ihe ọjọọ ha na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.2",
            "verseOrgIds": [
              "GEN.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Izrel hụrụ Josef nʼanya karịa ụmụ ya ndị ikom ndị ọzọ niile nʼihi na Josef bụ nwa a mụụrụ ya nʼoge agadi ya. Ọ kwaara ya uwe mwụda nwere ọtụtụ agwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.3",
            "verseOrgIds": [
              "GEN.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụmụnne ya chọpụtara na nna ha hụrụ ya nʼanya karịa onye ọbụla nʼime ha, ha kpọrọ ya asị, ha adịghị agwakwa ya okwu ọma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.4",
            "verseOrgIds": [
              "GEN.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu oge, Josef rọrọ nrọ, mgbe ọ kọọrọ ụmụnne ya nrọ a ọ rọrọ, ha kpọrọ ya asị karịa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.5",
            "verseOrgIds": [
              "GEN.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha, \"Geenụ ntị na nrọ a m rọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.6",
            "verseOrgIds": [
              "GEN.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị niile nọ nʼubi na-achịkọta ọka, ngwangwa ukwu ọka nke m biliri guzoro ọtọ, ebe ukwu ọka nke unu niile gbara ukwu ọka nke m gburugburu, na-akpọ isiala nye ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.7",
            "verseOrgIds": [
              "GEN.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnne ya jụrụ ya, \"Ị na-akọwa na ọ bụ gị ga-abụ eze anyị? Na ọ bụ gị nʼezie ga-achị anyị?\" Ha kpọrọ ya asị karịa nʼihi nrọ ya na okwu ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.8",
            "verseOrgIds": [
              "GEN.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef rọkwara nrọ ọzọ, kọkwara ụmụnne ya. Ọ sịrị, \"Geenụ ntị, arọrọ m nrọ ọzọ. Ma na nrọ nke ugbu a, anyanwụ na ọnwa na kpakpando iri na otu na-akpọ isiala nye m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.9",
            "verseOrgIds": [
              "GEN.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọ kọọrọ nna ya na ụmụnne ya nrọ a. Nna ya baara ya mba, sị, \"Nrọ nke a ị rọrọ bụ nrọ gịnị? Ọ bụ ezie na anyị niile, mụ onwe m na nne gị na ụmụnne gị, ga-abịa na-akpọrọ gị isiala?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.10",
            "verseOrgIds": [
              "GEN.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnne ya kwosiri ya ekworo nʼihi ya, ma nna ya debere ihe ndị a niile nʼobi ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.11",
            "verseOrgIds": [
              "GEN.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orire e rere Josef",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ dị, ụmụnne ya gara ilekọta igwe anụ ụlọ nna ha na Shekem.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.12",
            "verseOrgIds": [
              "GEN.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izrel sịrị Josef, \"Dịka ị maara, ụmụnne gị nọ na-eche anụ ụlọ na Shekem. Bịa, aga m eziga gị nʼebe ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:13"
      },
      "items": [
        {
          "text": "Josef zara sị, \"Ọ dị mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.13",
            "verseOrgIds": [
              "GEN.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ gwara ya, \"Gaa ka ị chọpụta ma ihe ọ na-agazikwara ụmụnne gị na igwe anụ ụlọ ndị ahụ nke ọma, ma weghachiri m ozi.\" O sitere na Ndagwurugwu Hebrọn zipụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:14"
      },
      "items": [
        {
          "text": "Ọ bịaruru Shekem,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.14",
            "verseOrgIds": [
              "GEN.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma otu nwoke hụrụ ya ka ọ na-awagharị gburugburu nʼọhịa dị nʼebe ahụ, ọ jụrụ ya, \"Gịnị ka ị na-achọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.15",
            "verseOrgIds": [
              "GEN.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Ana m achọ ụmụnne m. Biko, ị nwere ike ịgwa m ebe ha nọ na-azụ igwe anụ ụlọ ha?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.16",
            "verseOrgIds": [
              "GEN.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ zara sị, \"Ha esitela nʼebe a pụọ. Anụrụ m ka ha na-asị, 'Ka anyị gaa Dọtan.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 37:17"
      },
      "items": [
        {
          "text": "Ya mere, Josef gawara Dọtan ịchọ ụmụnne ya. Ọ hụkwara ha nʼebe dị nso na Dọtan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.17",
            "verseOrgIds": [
              "GEN.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha lepụrụ anya hụ ya ka ọ na-abịa, gbaa izu otu ha ga-esi gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.18",
            "verseOrgIds": [
              "GEN.37.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrịtara onwe ha, \"Lee eze nrọ ahụ ka ọ na-abịa!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.19",
            "verseOrgIds": [
              "GEN.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, bịanụ, ka anyị gbuo ya, tụba ya nʼime otu olulu ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.20",
            "verseOrgIds": [
              "GEN.37.20"
            ]
          }
        },
        {
          "text": "Anyị ga-asịkwa na anụ ọhịa eriela ya. Mgbe ahụ, anyị ga-ahụkwa ihe nrọ ya niile ga-abụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.20",
            "verseOrgIds": [
              "GEN.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben nụrụ ihe a, ma napụtakwa ya site nʼaka ha. Ọ sịrị, \"Ka anyị hapụ igbu ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.21",
            "verseOrgIds": [
              "GEN.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben sịrị ha, \"Ka unu hapụ ịkwafu ọbara. Kama tụnyenụ ya nʼime olulu a dị nʼọzara. Ma unu akpatụkwala ya aka.\" Ma nzube ya bụ ịnapụta ya site nʼaka ha, dulaara ya nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.22",
            "verseOrgIds": [
              "GEN.37.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, mgbe Josef bịakwutere ụmụnne ya, ha yipụrụ ya uwe mwụda ya, uwe mwụda nwere ọtụtụ agwa o yi nʼahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.23",
            "verseOrgIds": [
              "GEN.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha duru ya tụnye ya nʼime olulu. Ọ bụ olulu tọgbọrọ nʼefu, nke mmiri na-adịghị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.24",
            "verseOrgIds": [
              "GEN.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nọdụrụ ala bido iri nri, ha leliri anya ha hụ igwe ndị ahịa Ishmel si Gilead. Ịnyịnya kamel ha bu ụda na mgbaa na máá. Ọ bụkwa Ijipt ka ha bu ihe ndị a na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.25",
            "verseOrgIds": [
              "GEN.37.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Juda jụrụ ụmụnne ya, \"Uru gịnị ka ọ ga-abara anyị igbu nwanne anyị, ma kpuchie ọbara ya?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.26",
            "verseOrgIds": [
              "GEN.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bịanụ, ka anyị resi ya ndị Ishmel ndị a, ka aka anyị ghara nʼimetụ ya, nʼihi na nwanne anyị na otu anụ ahụ anyị ka ọ bụ.\" Ụmụnne ya gere ya ntị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.27",
            "verseOrgIds": [
              "GEN.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ahịa Midia ahụ rutere, ha sitere nʼolulu dọpụta Josef resi ya ndị Ishmel ahụ, ndị kwụrụ ụmụnne Josef iri mkpụrụ shekel ọlaọcha abụọ. Ha duuru Josef gaa Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.28",
            "verseOrgIds": [
              "GEN.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben mechara lọghachi gaa nʼolulu ahụ, ma ka ọ na-ahụghị Josef nʼime olulu a, ọ dọwara uwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.29",
            "verseOrgIds": [
              "GEN.37.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 37:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jekwuru ụmụnne ya sị ha, \"Nwata ahụ anọkwaghị ebe ahụ! Mụ onwe m, olee ebe m ga-ala?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.30",
            "verseOrgIds": [
              "GEN.37.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 37:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnne ya gburu otu ewu were uwe Josef bịanye nʼime ọbara ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.31",
            "verseOrgIds": [
              "GEN.37.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 37:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha chịịrị uwe mwụda ahụ nwere ọtụtụ agwa jekwuru nna ha sị ya, \"Anyị hụrụ uwe a nʼime ọhịa. Leruo ya anya ka ị mara maọbụ uwe mwụda nwa gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.32",
            "verseOrgIds": [
              "GEN.37.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ matara na ọ bụ ya, sị, \"E, nke a bụ uwe nwa m nwoke. Ajọ anụ eriela ya. Anụ ọhịa adọkasịala Josef nʼezie.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.33",
            "verseOrgIds": [
              "GEN.37.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jekọb dọwara uwe ya, yiri akwa mkpe, ruo ụjụ ọtụtụ ụbọchị nʼihi nwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.34",
            "verseOrgIds": [
              "GEN.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ya ndị ikom na ụmụ ya ndị inyom niile bịara ịkasị ya obi, ma ọ jụrụ ịnabata nkasiobi ọbụla. Ọ sịrị, \"Aga m alakwuru nwa m nʼala mmụọ site nʼiru ụjụ.\" Nna ya kwagidere akwa nʼihi ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ndị Midia ahụ rere",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        },
        {
          "text": "Josef nʼIjipt, resi ya Pọtifa, otu nʼime ndịisi na-ejere Fero ozi, onye bụ onyeisi ndị nche Fero, bụ eze Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
      ]
    }
  ],
