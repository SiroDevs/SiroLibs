  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "GEN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbụgba Ndụ Chineke na Ebram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị, okwu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.1",
                "verseOrgIds": [
                  "GEN.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Ebram site nʼọhụ, sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 15:1"
      },
      "items": [
        {
          "text": "\"Atụla egwu, Ebram",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 15:1"
      },
      "items": [
        {
          "text": "Abụ m ọta gị,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 15:1"
      },
      "items": [
        {
          "text": "ụgwọ ọrụ dị ukwu nke i nwere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.1",
            "verseOrgIds": [
              "GEN.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ebram zara sị ya, \"Gị, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.2",
            "verseOrgIds": [
              "GEN.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.2",
                "verseOrgIds": [
                  "GEN.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gịnị bụ ihe ị ga-enye m ebe ọ bụ na m amụtaghị nwa? Lee, ọ bụ Elieza, onye Damaskọs, ga-eketa akụ m niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.2",
            "verseOrgIds": [
              "GEN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebram gara nʼihu kwuo sị, \"Ebe ọ bụ na m amụtaghị ụmụ, ọ bụ ohu nọ nʼụlọ m ga-eketa akụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.3",
            "verseOrgIds": [
              "GEN.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma okwu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.4",
                "verseOrgIds": [
                  "GEN.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere ya, \"Nwoke a agaghị eketa ihe i nwere, kama nwa nwoke nke ga-esi nʼahụ gị pụta ga-eketa ihe i nwere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.5",
            "verseOrgIds": [
              "GEN.15.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.5",
                "verseOrgIds": [
                  "GEN.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọpụtara Ebram nʼezi sị ya, \"Lelie anya gị elu na mbara eluigwe, gụọ kpakpando niile ị hụrụ ọnụ, ma ị ga-enwe ike ịgụta ha.\" Ọ gwara ya sị, \"Otu a ka mkpụrụ gị ga-adị. A gaghị agụta ha ọnụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.5",
            "verseOrgIds": [
              "GEN.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebram kweere nʼihe",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.6",
                "verseOrgIds": [
                  "GEN.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru. Nʼihi nke a, a gụnyere ya okwukwe a dịka ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.7",
                "verseOrgIds": [
                  "GEN.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gwakwara ya sị, \"Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.7",
                "verseOrgIds": [
                  "GEN.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye si nʼala Ụọ nke ndị Kaldịa kpọpụta gị, inye gị ala a ka ọ bụrụ ihe nweta gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.7",
            "verseOrgIds": [
              "GEN.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ebram zara sị, \"Biko, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.8",
                "verseOrgIds": [
                  "GEN.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "olee otu m ga-esi mara na m ga-enweta ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.9",
                "verseOrgIds": [
                  "GEN.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "zara sị ya, \"Wetara m nwa nne ehi gbara afọ atọ, na nne ewu gbara afọ atọ, na ebule gbara afọ atọ, na nduru, na nwa kpalakwukwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebram wetaara ya ihe ndị a niile bọwaa ha ụzọ abụọ, doo ha nʼusoro ka otu akụkụ chee akụkụ nke ọzọ ihu. Ma ọ bọwaghị ụmụ nnụnụ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anụ ufe fekwasịrị ozu anụ ndị ahụ, Ebram chụpụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
              "GEN.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anwụ bidoro ịda, Ebram dara nʼoke ụra, oke ụjọ na oke ọchịchịrị dakwasịrị ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.13",
                "verseOrgIds": [
                  "GEN.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ya sị, \"Mata nke ọma na ụmụ ụmụ gị ga-anọ dịka ndị ọbịa nʼala na-abụghị nke ha. A ga-edo ha ọnọdụ dịka ndị ohu, mejọọ ha narị afọ anọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m ata mba ahụ ha na-efe dịka ohu ahụhụ. Nʼikpeazụ, ha ga-eji ọtụtụ akụ si nʼebe ahụ pụta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ị ga-anwụ nʼudo. A ga-eli gị mgbe ị kara ezi nka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọgbọ anọ gasịrị, ụmụ ụmụ gị ga-alọtakwa nʼala a. Nʼihi na mmehie ndị Amọrait erubeghị nʼuju ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anwụ dara, mgbe ọchịchịrị gbachiri ebe niile, ite ọkụ na-akwụ anwụrụ ọkụ nke nwere ọwa na-enwu ọkụ si nʼetiti ibe anụ ndị ahụ gafee.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ ka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.15.18",
                "verseOrgIds": [
                  "GEN.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "na Ebram gbara ndụ. Ọ sị, \"Ndị agbụrụ gị ka m ga-enye ala ndị a, malite nʼiyi ndị Ijipt ruo nʼiyi ukwu Yufretis.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
