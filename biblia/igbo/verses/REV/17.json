  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "REV 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwanyị akwụna na anụ ọjọọ ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime ndị mmụọ ozi asaa ndị ahụ ji efere bịara sị m, \"Bịa, aga m egosi gị ahụhụ ga-abịakwasị onye ahụ ụwa niile maara dịka akwụna, onye ahụ na-anọkwasị nʼelu ọtụtụ mmiri nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị eze ụwa esorola ya kwaa iko nʼotu ihe ndina, emeekwara ka ndị niile bi nʼụwa bụrụ ndị mmanya ịkwa iko ya na-egbu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O duuru m nʼime mmụọ baa nʼọzara. Nʼebe ahụ ka m nọ hụ otu nwanyị nọkwasịrị nʼelu otu anụ ọhịa na-acha ọbara ọbara. Anụ ọhịa ahụ nwere isi asaa na mpi iri. Aha ndị e dere anụ ọhịa ahụ nʼahụ bụ naanị okwu ikwulu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị ahụ yi akwa na-acha odo odo na nke na-achakwa ọbara ọbara, gbarakwa ihe ịchọ mma e ji ọlaedo, nkume dị oke ọnụahịa na pieal kpụọ. O jikwa iko ọlaedo nʼaka ya nke jupụtara nʼihe arụ na ihe ure niile o ji na-akwa iko ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha e dekwasịrị ya nʼegedege ihu bụ ihe omimi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "REV 17:5"
      },
      "items": [
        {
          "text": "Obodo ukwu ahụ bụ Babilọn,",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "REV 17:5"
      },
      "items": [
        {
          "text": "nne ndị na-akwa iko",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "REV 17:5"
      },
      "items": [
        {
          "text": "na nke ihe arụ niile nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejikwa m anya m hụ na nwanyị ahụ aṅụjuola ọbara ndị nsọ afọ, ya na ọbara ndị ama Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 17:6"
      },
      "items": [
        {
          "text": "Mgbe m hụrụ ya, ọ gbagwojuru m anya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmụọ ozi ahụ sịrị m, \"Gịnị mere ihe ị hụrụ ji ju gị anya? Aga m akọwara gị ihe omimi banyere nwanyị a na anụ ọhịa ahụ nke na-ebugharị ya, bụ nke nwere isi asaa na mpi iri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụ ọhịa ahụ ị hụrụ, nwere mgbe ọ dịịrị, ma ugbu a, ọ dịkwaghị. Ma ọ ga-esi nʼolulu Abis ahụ pụta banye na mbibi. Ma nlọghachi ya ga-eju ndị ahụ a na-edeghị aha ha nʼime akwụkwọ ndụ ahụ site nʼoge e kere ụwa anya. Nʼihi na e nwere mgbe ọ dịịrị, ma ugbu a, ọ dịkwaghị, ma ọ ga-emesi bịa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a chọrọ uche nke nwere amamihe. Isi asaa ahụ nọchiri anya ugwu asaa ahụ nke nwanyị ahụ na-anọdụ nʼelu ha. Ha na-anọchikwa anya ndị eze asaa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ise nʼime ha adaala, otu ka nọ, nke ọzọ abịabeghị. Mgbe ọ bịara, ọ ga-anọ nwantakịrị oge.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụ ọhịa ahụ nke dịrịị ma ọ dịkwaghị, bụ onye nke asatọ, ọ bụ onye otu ndị eze asaa ahụ ma a lakwara ya nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mpi iri ahụ ị hụrụ nọchiri anya ndị eze iri na-anatabeghị alaeze. Ha na anụ ọhịa ahụ ga-anata ike ọchịchị dịka eze sọọsọ otu awa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji otu obi na-enye anụ ọhịa ahụ ike ha na ịchị isi ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.13",
            "verseOrgIds": [
              "REV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ebu agha megide Nwa Atụrụ ahụ, ma Nwa Atụrụ ahụ ga-emeri ha nʼihi na ọ bụ Onyenwe kachasị ndị nwenụ niile nakwa Eze kachasị ndị eze niile. Ndị so ya bụkwa ndị a kpọrọ, na ndị a họpụtara, ndị ya kwesikwara ntụkwasị obi.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ọ sịrị m, \"Mmiri ndị ahụ ị hụrụ, ebe nwanyị akwụna ahụ nọ, bụ ndị mmadụ dị iche iche, igwe mmadụ, na mba dị iche iche na nʼasụsụ dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.15",
            "verseOrgIds": [
              "REV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụ ọhịa ahụ na mpi iri ahụ ị hụrụ ga-akpọ nwanyị akwụna ahụ asị. Ha ga-agba ya ọtọ, laakwa ya nʼiyi, ha ga-eri anụ ya, werekwa ọkụ rechapụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.16",
            "verseOrgIds": [
              "REV.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke etinyela ya nʼobi ha imejupụta nzube ya site nʼinwe otu obi nakwa inyefe anụ ọhịa ahụ ikike ọchịchị alaeze ha, tutu ruo mgbe a ga-emezu okwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.17",
            "verseOrgIds": [
              "REV.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwanyị a ị hụrụ bụ obodo ukwu ahụ na-achị ndị eze niile nke ụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.18",
            "verseOrgIds": [
              "REV.17.18"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "REV.18",
    "number": "18",
