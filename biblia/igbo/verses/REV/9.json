  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "REV 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Opi ike nke ise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ ozi nke ise ahụ fụrụ opi ike ya, ahụrụ m otu kpakpando si nʼeluigwe daa nʼala. E nyere ya ihe ọtụghe igodo nke e ji atụghe olulu nke Abis",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "text": "ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o meghere olulu Abis ahụ, anwụrụ ọkụ dị ukwu sitere nʼime ya pụta dịka anwụrụ ọkụ si nʼọkụ icheku ọkụ ya dị ukwuu, mee ka oke ọchịchịrị kpuchie ihu anyanwụ na mbara eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igurube sitere nʼanwụrụ ọkụ ahụ pụta fedakwasa ụwa. E nyekwara ha ike ịta mmadụ ọbụla dịka akpị si agba mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyere ha iwu si ha emebila ahịhịa ndụ ọbụla, maọbụ osisi na ihe ọbụla a kụrụ nʼala. Kama ọrụ ha bụ ịbịakwasị mmadụ ọbụla na-enweghị akara Chineke nʼegedege ihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.4",
            "verseOrgIds": [
              "REV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu e nyere ha abụghị ka ha gbuo ndị a, kama ọ bụ ka ha mekpaa ha ahụ ọnwa ise. Mmekpa ahụ ha dịka ahụ ụfụ na nhụju anya nke akpị mgbe ọ gbara mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.5",
            "verseOrgIds": [
              "REV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ụbọchị ndị ahụ, ọtụtụ mmadụ ga-achọ iji aka ha gbuo onwe ha ma ha agaghị enwe ike mee ya. Agụụ ịnwụ ọnwụ ga-agụ ha, ma ọnwụ ga-esi nʼebe ha nọ wezuga onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igurube ndị a nwere oyiyi dị ka ịnyịnya a kwadebere maka ibu agha. Ha nwere ihe yiri okpueze e ji ọlaedo kpụọ nʼisi ha. Ihu ha dịkwa ka ihu mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agịrị isi ha dịka agịrị isi ụmụ nwanyị. Eze ha dịkwa ka eze ọdụm.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha yikwasịrị onwe ha ihe ikpuchi obi dịka nke e ji igwe kpụọ. Nku ha na-eme mkpọtụ dị ka ụda nzọ ụkwụ ọtụtụ ịnyịnya nke ụgbọ agha na-esekpu na-abanye nʼọgbọ agha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nwere ọdụdụ dịka akpị. Ma ike niile e nyere ha bụ imerụ ndị mmadụ ahụ ọnwa ise site nʼike dị nʼọdụdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nwere mmụọ ozi nke Abis,",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        },
        {
          "text": "onye na-achịkọta ha dịka eze. Aha ya nʼasụsụ Hibru bụ Abadọn, ma nʼasụsụ Griik ọ bụ Apolion.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ nke mbụ agafeela, ebe ahụhụ abụọ ọzọ na-abịa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Opi ike nke isii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ ozi nke isii fụrụ opi ike ya, anụrụ m olu sitere na mpi anọ ahụ dị nʼebe ịchụ aja ahụ e jiri ọlaedo wuo, nke dị nʼihu ocheeze Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
            "verseOrgIds": [
              "REV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-agwa mmụọ ozi nke isii ahụ, nke ji opi ike okwu, \"Tọpụ mmụọ ozi anọ ndị ahụ e kere agbụ nʼebe osimiri Yufretis dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tọhapụrụ ndị mmụọ ozi anọ ahụ, ndị e jibu eji na njikere maka oge awa ahụ, na ụbọchị ahụ, na ọnwa ahụ, na afọ ahụ, iji gbuo otu ụzọ nʼime ụzọ atọ nke mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha ahụ, ọnụọgụgụ ha bụ narị nde abụọ. Anụrụ m mgbe e kwuru ole ha dị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ọhụ m, ahụrụ m ịnyịnya ha, hụkwa ndị nọkwasịrị ha nʼelu. Ndị nọ nʼelu ịnyịnya ndị a yi ihe ikpuchi obi nke ụfọdụ nʼime ha na-acha ọbara ọbara. Ụfọdụ na-acha dịka akpụkpọ eluigwe, ụfọdụ na-acha odo odo. Ụfọdụ na-acha dịka anwụrụ ọkụ. Isi ịnyịnya ha dịka isi ọdụm, anwụrụ ọkụ na ọkụ na nkume ọkụ sị ha nʼọnụ na-apụta.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.17",
            "verseOrgIds": [
              "REV.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E sitere nʼihe mmekpa ahụ ndị a, ire ọkụ, anwụrụ ọkụ na nkume ọkụ na-adịghị anyụ anyụ, ka ha ji gbuo otu ụzọ nʼime ụzọ atọ nke mmadụ niile bi nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.18",
            "verseOrgIds": [
              "REV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ike ịnyịnya ndị a dị nʼọnụ ha, na ọdụdụ ha. Ọdụdụ ha dị ka agwọ, nwee isi agwọ nke ha ji emerụ mmadụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.19",
            "verseOrgIds": [
              "REV.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị fọdụrụ nʼetiti mmadụ, bụ ndị a na-egbughị site nʼihe ntaramahụhụ ọrịa ndị a, echegharịghị site nʼọrụ aka ha maọbụ ịkwụsị ife mmụọ ọjọọ ofufe. Ha jụkwara ịkwụsị ife arụsị ha niile nke ha ji ọlaedo na ọlaọcha na bronz na igwe na nkume na osisi kpụọ. Chi ndị na-apụghị ịhụ ụzọ, maọbụ ịnụ ihe, maọbụ ije ije.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha echegharịghị site nʼigbu mmadụ ha, maọbụ ụzọ mgbaasị ha, maọbụ ndụ ịkwa iko ha, na izu ohi ha pụta.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.21",
            "verseOrgIds": [
              "REV.9.21"
            ]
          }
        }
      ]
    }
  ],
