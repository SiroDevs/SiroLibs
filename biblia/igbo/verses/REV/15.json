  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "REV 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị mmụọ ozi asaa ji ihe ntaramahụhụ asaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụkwara m ihe ịrịbama ọzọ nʼeluigwe. Ọ dị ebube dịkwa oke egwu. Ndị mmụọ ozi asaa ji ụzọ ahụhụ asaa. Ha bụ ahụhụ nke ikpeazụ ndị ga-eweta iwe Chineke na ngwụcha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ ndị a gbapụtara bụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m ihe dịka oke osimiri enyo a gwakọtara ya na ọkụ, na ndị ahụ nweterala mmeri nʼebe anụ ọhịa ahụ na oyiyi ya, na ọnụọgụgụ aha ya. Ha guzo nʼakụkụ oke osimiri enyo ahụ, jidekwa ụbọ akwara nke Chineke nʼaka ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-abụ abụ Mosis ohu Chineke, na abụ Nwa atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "\"Ọrụ gị niile dị ukwuu dịkwa ebube,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Onyenwe anyị Chineke, Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Ụzọ gị niile ziri ezi, bụrụkwa eziokwu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Gị, Eze nke mba niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ga-aghara ịtụ gị egwu, Onyenwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "onye ga-agharakwa ito aha gị?",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "Nʼihi na ọ bụ naanị gị dị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "Mba niile ga-abịakwa",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "ịkpọ isiala nʼihu gị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "nʼihi na emeela ka ọrụ ezi omume gị pụta ìhè.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị, elere m anya hụ, na e meghere, ụlọnsọ ukwu dị nʼeluigwe, ya bụ, ụlọ ikwu nke iwu ọgbụgba ndụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi asaa ndị ahụ ji ihe ntaramahụhụ asaa sị nʼụlọnsọ ahụ pụta. Ha yi uwe ogho ọcha, akwa ọcha na-enwu ezigbo ọcha. E kekwasịrị ihe okike ọlaedo gburugburu obi ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime anụ anọ ndị ahụ dị ndụ bunyere mmụọ ozi asaa ndị ahụ efere ọlaedo asaa a gbajuru ọnụma Chineke, bụ onye ahụ na-adị ndụ mgbe niile ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ụlọnsọ ahụ jupụtara nʼanwụrụ ọkụ si nʼebube na ike Chineke na-apụta. O nweghị onye ọbụla nwere ike ịba nʼụlọnsọ ahụ tutu ruo mgbe ntaramahụhụ asaa nke ndị mmụọ ozi asaa ahụ gwụchara.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        }
      ]
    }
  ],
