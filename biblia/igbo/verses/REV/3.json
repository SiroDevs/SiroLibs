  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "REV 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzukọ dị nʼobodo Sardis",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dee akwụkwọ nye mmụọ ozi ụlọ nzukọ dị na Sardis, sị ya:",
              "type": "text",
              "attrs": {
                "verseId": "REV.3.1",
                "verseOrgIds": [
                  "REV.3.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 3:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "REV 3:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị a bụ okwu onye ahụ nwere mmụọ asaa nke Chineke na kpakpando asaa.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 3:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "REV 3:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amaara m ọrụ gị niile, ị nwere aha dịka onye dị ndụ ma ị bụ onye nwụrụ anwụ.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ugbu a, sị nʼụra bilite. Mee ka ihe ntakịrị ahụ fọdụrụ na-achọ ịnwụ anwụ dịrị ike. Nʼihi na ọ dịghị ọrụ gị m hụrụ dị ka ihe zuruoke nʼanya Chineke m.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, cheta ihe ndị ahụ ị natara na nke ị nụrụ; rube isi nye ya, chegharịakwa. Ma ọ bụrụ na i tetaghị, aga m abịakwute gị dị ka onye ohi, ị gaghị amatakwa oge m ji bịakwute gị.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Otu ọ dị, i nwere ụfọdụ mmadụ na Sardis ndị na-emerụbeghị uwe ha. Ha ga-eyiri uwe ọcha ma soro m jee ije nʼihi na ha bụ ndị kwesiri ekwesi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla na-emeri emeri, ka a ga-eyikwasị uwe mwụda ọcha dịka ha. Agaghị m ehichapụ aha ya site nʼakwụkwọ nke ndụ ahụ, kama aga m ekwupụtakwa aha ahụ nʼihu Nna m na nʼihu ndị mmụọ ozi niile.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla nwere ntị, ya nụrụ ihe Mmụọ nsọ na-agwa nzukọ niile.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzukọ dị nʼobodo Filadelfia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dee akwụkwọ nye mmụọ ozi ụlọ nzukọ dị na Filadelfia, sị ya:",
              "type": "text",
              "attrs": {
                "verseId": "REV.3.7",
                "verseOrgIds": [
                  "REV.3.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 3:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "REV 3:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị a bụ okwu onye dị nsọ na onye eziokwu, onye ahụ ji ọtụghe igodo Devid, nke o ji emeghepụ ihe onye ọbụla na-apụghị imechi, na nke o ji emechi ihe onye ọbụla na-apụghị imeghe.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amaara m ọrụ gị niile. Lee, edebela m nʼihu gị ọnụ ụzọ nke e meghere emeghe, nke onye ọbụla na-apụghị imechi. Amaara m na i nwere ike dị ntakịrị, ma i debere okwu m, ị gọnarịkwaghị aha m.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aga m eme ka ndị ahụ so na nzukọ ekwensu, bụ ndị na-asị na ha bụ ndị Juu ma ha abụghị, kama ha bụ ndị ụgha, aga m eme ka ha bịa kpọọ isiala nye gị, si otu a ghọta na ahụrụ m gị nʼanya.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ebe i sitere na ntachiobi sọpụrụ okwu m niile, aga m ekpuchi gị site nʼoke mkpagbu ahụ, nke ga-abịakwasị ụwa mgbe a ga-anwale ndị niile bi nʼime ya.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ana m abịa ọsịịsọ. Jidesienụ ihe unu nwere aka ike, ka onye ọbụla ghara ịnapụ gị okpueze gị.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma onye ọbụla na-emeri emeri, ka m ga-eme ka ọ bụrụ ogidi nʼime ụlọnsọ Chineke m. Ọ gaghị esikwa nʼebe ahụ pụọ apụọ. Aga m edekwasịkwa aha Chineke m nʼahụ, na aha obodo nsọ Chineke, nke bụ Jerusalem ọhụrụ ahụ si nʼeluigwe, ebe Chineke nọ na-arịdata. Aha ọhụrụ m ka a ga-edekwasịkwa nʼihu ya.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla nwere ntị, ya nụrụ ihe Mmụọ Nsọ na-agwa nzukọ niile.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzukọ dị nʼobodo Laodisia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dee akwụkwọ nye mmụọ ozi ụlọ nzukọ dị na Laodisia, sị ya:",
              "type": "text",
              "attrs": {
                "verseId": "REV.3.14",
                "verseOrgIds": [
                  "REV.3.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 3:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "REV 3:14"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị a bụ okwu Amen, onye kwesiri ntụkwasị obi, na onye bụ ezi onyeama, bụrụkwa isi mmalite ihe niile Chineke kere.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amaara m ọrụ gị niile, na ị jụghị oyi, i kpoghịkwa ọkụ. Ọ gaara adị nnọọ mma ma asị na ị na-ajụ oyi ma ọ bụkwanụ na-ekpo ọkụ.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi nke a, ebe ị na-ajụghị oyi, i kpoghịkwa ọkụ, ihe ị dị bụ ṅaraṅara. Nʼihi ya, aga m esi nʼọnụ m gbụpụ gị.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ị na-asị, 'abụ m ọgaranya, nwezuo ihe niile. Mkpa ihe ọbụla akpakwaghị m.' Ma ị ghọtaghị na onye gba aka ka ị bụ. Ị bụ onye e kwesiri imere ebere. Ị bụkwa ogbenye na onye kpuru ìsì na onye gba ọtọ.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ana m adụ gị ọdụ ka ịzụta ezigbo ọlaedo nʼaka m, bụ ọlaedo a nụchara anụcha nʼime ọkụ. Mgbe ahụ, ị ga-abụkwa ọgaranya nʼezie. Ị gaara esitekwa nʼaka m zụta akwa ọcha na-enweghị ntụpọ ka ị ghara ịgba ọtọ, ka ihere gharakwa ime gị. Ka ị zụrụkwa ezigbo ọgwụ ọrịa anya tee, ka ibido ịhụ ụzọ nke ọma.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị m hụrụ nʼanya ka m na-abara mba na-enyekwa ha ahụhụ. Ya mere, nwee ịnụ ọkụ nʼobi, chegharịakwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lee, ana m eguzo nʼọnụ ụzọ na-akụ aka. Ọ bụrụ na onye ọbụla anụ olu m ma meghee ụzọ, aga m abata soro ya rikọọ ihe, ya onwe ya ga-esokwa m rie ihe.",
