{
  "id": "REV.12",
  "number": "12",
  "bookId": "REV",
  "reference": "Mkpughe 12",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "REV 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwanyị na agwọ ochie ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ihe ịrịbama pụtara ihe nʼeluigwe, otu nwanyị e yikwasịrị anyanwụ dịka uwe. Ọnwa dịkwa nʼokpuru ụkwụ ya abụọ. Okpueze nwee kpakpando iri na abụọ dịkwa ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.1",
            "verseOrgIds": [
              "REV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị ime, na-etikwa mkpu nʼihi ahụhụ na ihe ụfụ nke ọmụmụ nwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.2",
            "verseOrgIds": [
              "REV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ihe ama ọzọ pụtara ihe nʼeluigwe, agwọ ochie nke dị ukwuu na-acha uhie uhie a na-akpọ dragọn, nke nwere isi asaa na mpi iri. O kpukwasịkwara okpueze asaa nʼisi ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.3",
            "verseOrgIds": [
              "REV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwere ọdụdụ nke o ji dọkpụrụ otu ụzọ nʼime ụzọ atọ nke kpakpando niile dị nʼeluigwe, tụda ha nʼala. Ọ bịara guzo nʼihu nwanyị ahụ na-achọ ịmụpụta nwa ahụ ọ dị ime ya, nọọ na njikere iri nwantakịrị ahụ ma a mụpụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.4",
            "verseOrgIds": [
              "REV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ mụpụtara nwantakịrị nwoke, \"onye ga-ejikwa mkpara ọchịchị chịa mba niile ọchịchị.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "text": "Nʼotu oge ahụ kwa, e si nʼebe ahụ wepụ nwata ahụ were ya gaa nʼebe Chineke nọ nʼeluigwe nʼocheeze ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwanyị ahụ si nʼebe ahụ gbapụ gbalaa nʼọzara ebe Chineke kwadebere na ọ ga-anọ. Ebe ahụ ka a ga-elekọta ya anya nke ọma otu puku ụbọchị na narị ụbọchị abụọ na iri ụbọchị isii (1,260).",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agha a lụrụ nʼeluigwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, agha dapụtara nʼeluigwe. Maikel na ndị mmụọ ozi ya buru agha megide agwọ ochie ahụ (a na-akpọ dragọn). Dragọn ahụ na ndị mmụọ ozi ya bukwara agha nke ha,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma e meriri ha, ha enwekwaghị ọnọdụ ọbụla nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dragọn ukwu ahụ, bụ agwọ ochie ahụ a na-akpọ ekwensu maọbụ Setan, nke na-eduhie ndị niile bi nʼụwa. A tụdara ya nʼụwa, ya na ndị mmụọ ozi ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anụrụ m oke olu si nʼeluigwe na-ada sị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "\"O mezuola nʼikpeazụ, bụ nzọpụta Chineke na ike",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "na alaeze Chineke anyị, na ikike ịchị isi Kraịst ya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "ha abụrụla ihe dị ire.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "Nʼihi na e sitela nʼeluigwe chụtuo",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "onye ahụ na-ebo ụmụnna anyị ebubo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:10"
      },
      "items": [
        {
          "text": "Ọ na-ebo ha ebubo ehihie na abalị nʼihu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha lụgburu ya nʼagha",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "site nʼọbara Nwa atụrụ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "na site nʼama nke okwu ọnụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "nʼihi na ha ahụghị ndụ ha nʼanya karịa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:11"
      },
      "items": [
        {
          "text": "kama ha jikere inye ndụ ha ọbụladị ruo nʼọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ṅụrịanụ ọṅụ eluigwe",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "ma unu ndị niile bi nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "Ma ahụhụ dịrị unu ndị bi nʼụwa na osimiri",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "nʼihi na ekwensu abịakwutela unu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "O jirila oke ọnụma bịakwute unu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 12:12"
      },
      "items": [
        {
          "text": "Ọ makwaara na oge a o nwere ehighị nne.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe agwọ ochie ahụ chọpụtara na a chụdala ya nʼụwa, ọ chụsoro nwanyị ahụ mụrụ nwa nwoke ahụ ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e nyere nwanyị ahụ nku abụọ, nke dịka nku oke ugo, ka o jiri gbanarị agwọ ochie ahụ feba nʼime ọzara, ebe a kwadooro ya, na ebe a ga-anọ lezie ya anya afọ atọ na ọnwa isii.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma agwọ ahụ meghere ọnụ ya mee ka mmiri si nʼọnụ ya sọpụta dịka iyi nke ga-ebufu nwanyị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ala nyeere nwanyị ahụ aka. O meghere ọnụ ya loda idee mmiri a nke si nʼọnụ agwọ ahụ sọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, agwọ ochie ahụ wesara nwanyị ahụ iwe, pụọ ịga buo agha megide ụmụ ya bụ ndị niile fọdụrụ, bụ ndị niile na-edebe iwu Chineke na ndị na-ekwupụta na ha bụ ndị ama nke Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
  ],
