  "verseCount": 45,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MRK 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jọn omee baptizim edozie ụzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmalite oziọma maka Jisọs Kraịst, Ọkpara Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.1",
            "verseOrgIds": [
              "MRK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka e dere ya rịị nʼakwụkwọ Aịzaya onye amụma sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 1:2"
      },
      "items": [
        {
          "text": "\"Aga m ezipu onyeozi m nʼihu gị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 1:2"
      },
      "items": [
        {
          "text": "onye ga-edozi ụzọ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Otu onye na-eti mkpu nʼọzara, na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.3",
            "verseOrgIds": [
              "MRK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 1:3"
      },
      "items": [
        {
          "text": "'Dozienụ ụzọ maka Onyenwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.3",
            "verseOrgIds": [
              "MRK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 1:3"
      },
      "items": [
        {
          "text": "meenụ ka okporoụzọ ya guzozie.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.3",
            "verseOrgIds": [
              "MRK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jọn omee baptizim pụtara na-eme baptizim nʼọzara, ma na-ekwusa baptizim nke nchegharị maka mgbaghara mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.4",
            "verseOrgIds": [
              "MRK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ si nʼakụkụ Judịa niile na ndị niile bi na Jerusalem pụrụ jekwuru ya. Ka ha na-ekwupụta mmehie ha, o mere ha baptizim nʼosimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.5",
            "verseOrgIds": [
              "MRK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe Jọn yi nʼahụ ya bụ nke e ji ajị ịnyịnya kamel mee. O kekwara ihe okike e ji akpụkpọ anụ mee nʼukwu ya. Nri ya bụ igurube na mmanụ aṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.6",
            "verseOrgIds": [
              "MRK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kwusara sị: \"Onye dị ike karịa m na-abịa nʼazụ m. Onye m na-erughị ihudata ala tọpụ eriri akpụkpọụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.7",
            "verseOrgIds": [
              "MRK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eji m mmiri na-eme unu baptizim, ma ọ ga-eji Mmụọ Nsọ mee unu baptizim.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.8",
            "verseOrgIds": [
              "MRK.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baptizim na ọnwụnwa Jisọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, Jisọs sitere na Nazaret nke Galili bịa nʼosimiri Jọdan, ebe Jọn mere ya baptizim.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.9",
            "verseOrgIds": [
              "MRK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe o si nʼime mmiri ahụ na-apụta, ọ hụrụ ka eluigwe meghere. Hụkwa Mmụọ Nsọ dị ka nduru ka ọ rịdatara bekwasị ya nʼisi ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.10",
            "verseOrgIds": [
              "MRK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu olu si nʼeluigwe daa, \"Ị bụ Ọkpara m hụrụ nʼanya, ihe gị dị m ezi mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.11",
            "verseOrgIds": [
              "MRK.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, Mmụọ Nsọ duuru ya baa nʼime ọzara.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.12",
            "verseOrgIds": [
              "MRK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nọkwara nʼime ọzara ahụ iri ụbọchị anọ, ebe ekwensu nwara ya ọnwụnwa. Ya na ụmụ anụ ọhịa nọkwa. Ma ndị mmụọ ozi jeere ya ozi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.13",
            "verseOrgIds": [
              "MRK.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbido ọrụ nkwusa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e tinyesịrị Jọn nʼụlọ mkpọrọ, Jisọs gara na Galili, na-ekwusa oziọma Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.14",
            "verseOrgIds": [
              "MRK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.15",
            "verseOrgIds": [
              "MRK.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Oge ahụ eruola, alaeze Chineke dị nso. Chegharịanụ ma kwerekwanụ nʼoziọma.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.15",
                "verseOrgIds": [
                  "MRK.1.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ ndị na-eso ụzọ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs na-aga nʼakụkụ osimiri Galili, ọ hụrụ Saimọn na Andru nwanne ya, ka ha na-awụnye ụgbụ ha nʼime mmiri nʼihi na ha bụ ndị ọkụ azụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.16",
            "verseOrgIds": [
              "MRK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs siri ha,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.17",
            "verseOrgIds": [
              "MRK.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bịanụ soro m, m ga-emekwa unu ndị ọkụ na-akụta mmadụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.17",
                "verseOrgIds": [
                  "MRK.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.17",
            "verseOrgIds": [
              "MRK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ha hapụrụ ụgbụ azụ ha ma soro ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.18",
            "verseOrgIds": [
              "MRK.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ gatụrụ nʼihu nke nta, ọ hụrụ Jemis nwa Zebedi na nwanne ya bụ Jọn ndị nọ nʼime ụgbọ mmiri, na-ekezi ụgbụ azụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.19",
            "verseOrgIds": [
              "MRK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, ọ kpọrọ ha, ha hapụrụ nna ha Zebedi na ndị o goro ọrụ nʼime ụgbọ soro ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.20",
            "verseOrgIds": [
              "MRK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs chụpụrụ mmụọ ọjọọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gara Kapanọm, mgbe ụbọchị izuike ruru, ọ bara nʼime ụlọ ekpere ma malite izi ha ihe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.21",
            "verseOrgIds": [
              "MRK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ozizi ya juru ha anya nke ukwuu, nʼihi na o ziri ha ihe dịka onye nwere ikike, ọ bụghị dị ka nke ndị ozizi iwu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.22",
            "verseOrgIds": [
              "MRK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼotu oge ahụ, otu nwoke nọ nʼime ụlọ ekpere ahụ nke mmụọ na-adịghị ọcha bi nʼime ya, tiri mkpu nʼoke olu,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.23",
            "verseOrgIds": [
              "MRK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "sị, \"Gịnị ka anyị na gị nwekọrọ, gị Jisọs onye Nazaret? Ị bịala ịla anyị nʼiyi? Amaara m onye ị bụ, Onye Nsọ nke Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.24",
            "verseOrgIds": [
              "MRK.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jisọs baara ya mba sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.25",
            "verseOrgIds": [
              "MRK.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mechie ọnụ sikwa nʼime ya pụta!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.25",
                "verseOrgIds": [
                  "MRK.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.25",
            "verseOrgIds": [
              "MRK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ahụ na-adịghị ọcha seere ya, mee ka ahụ ya maa jijiji, o tiri mkpu nʼoke olu, ma sikwa nʼime ya pụta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.26",
            "verseOrgIds": [
              "MRK.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile bụ ndị nọ nʼọnọdụ ihe iju anya ma na-ajụrịtara onwe ha ajụjụ sị, \"Gịnị bụ nke a? Ozizi ọhụrụ ya na ikike! Ọ na-enye ọ bụladị mmụọ na-adịghị ọcha iwu. Ha na-erubekwara ya isi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.27",
            "verseOrgIds": [
              "MRK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ banyere ya gbasara ngwangwa ruo akụkụ niile nke Galili.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.28",
            "verseOrgIds": [
              "MRK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs agwọọ ọtụtụ mmadụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ha hapụrụ ụlọ ekpere ahụ, ha na Jemis na Jọn soro banye nʼụlọ Saimọn na Andru.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.29",
            "verseOrgIds": [
              "MRK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, nne nwunye Saimọn dina nʼakwa ndina. Ahụ ọkụ jikwa ya. Ha mere ka ọ mata banyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.30",
            "verseOrgIds": [
              "MRK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gakwuru ya, jide ya nʼaka selite ya elu. Ahụ ọkụ ahụ hapụrụ ya. Ọ malitekwara ile ha ọbịa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.31",
            "verseOrgIds": [
              "MRK.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge uhuruchi, mgbe anwụ dara, ha kpọtaara ya ndị niile ahụ na-esighị ike na ndị mmụọ ọjọọ bi nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.32",
            "verseOrgIds": [
              "MRK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ahụ niile gbakọrọ nʼọnụ ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.33",
            "verseOrgIds": [
              "MRK.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwọrọ ọtụtụ ndị bu ọrịa dị iche iche, ọ chụpụkwara ọtụtụ mmụọ ọjọọ ma o kweghị ka mmụọ ọjọọ ndị ahụ kwuo okwu nʼihi na ha matara onye ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.34",
            "verseOrgIds": [
              "MRK.1.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs apụọ ikpe ekpere naanị ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ, mgbe ọchịchịrị ka gbachiri, o biliri, ga ebe ọ ga-anọrọ onwe ya, naanị ya. Nʼebe ahụ kwa ka ọ nọ kpee ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.35",
            "verseOrgIds": [
              "MRK.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn na ndị ya na ha nọ pụrụ na-achọgharị ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.36",
            "verseOrgIds": [
              "MRK.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha hụrụ ya, ha sịrị ya, \"Mmadụ niile na-achọgharị gị!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.37",
            "verseOrgIds": [
              "MRK.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zaghachiri ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.38",
            "verseOrgIds": [
              "MRK.1.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka anyị gaanụ ebe ọzọ, nʼobodo ndị ọzọ dị anyị gburugburu, ka m zisakwaara ha oziọma. Ọ bụ nʼihi nke a ka m ji bịa.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.38",
                "verseOrgIds": [
                  "MRK.1.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.38",
            "verseOrgIds": [
              "MRK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ pụrụ jegharịa na Galili niile na-ekwusa oziọma nʼụlọ ekpere ha niile, na-achụpụkwa mmụọ ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.39",
            "verseOrgIds": [
              "MRK.1.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs agwọọ onye ekpenta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu onye ekpenta bịakwutere ya gbuo ikpere nʼala rịọọ ya sị, \"Ọ bụrụ na ị chọrọ, ị pụrụ ime ka m dị ọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.40",
            "verseOrgIds": [
              "MRK.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe o jupụtara nʼọmịiko, Jisọs setịpụrụ aka ya metụ ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.41",
            "verseOrgIds": [
              "MRK.1.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Achọrọ m, dị ọcha!\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.41",
                "verseOrgIds": [
                  "MRK.1.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.41",
            "verseOrgIds": [
              "MRK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ekpenta ya hapụrụ ya, e mekwara ka ọ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.42",
            "verseOrgIds": [
              "MRK.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jisọs ji ịdọ aka na ntị zilaga ya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.43",
            "verseOrgIds": [
              "MRK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ gwara ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.44",
            "verseOrgIds": [
              "MRK.1.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hụkwa na ọ dịghị onye ọbụla ị ga-agwa ihe a. Kama gaa gosi onye nchụaja onwe gị. Chụọkwa aja dị ka Mosis nyere nʼiwu, maka ime ka ị dị ọcha gị, ka ọ bụrụ ihe ama nye ha.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.1.44",
                "verseOrgIds": [
                  "MRK.1.44"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.44",
            "verseOrgIds": [
              "MRK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ pụrụ malite ịkọsa akụkọ banyere ọgwụgwọ ya ebe niile. Nʼihi ya Jisọs enwekwaghị ike ịbanye nʼobodo, kama ọ gara nọrọ nʼebe zoro ezo. Ma ndị mmadụ na-abịakwutekwa ya site nʼebe niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.45",
            "verseOrgIds": [
              "MRK.1.45"
            ]
          }
        }
      ]
    }
  ],
