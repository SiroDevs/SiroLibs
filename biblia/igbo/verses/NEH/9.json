  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "NEH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwupụta mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke iri abụọ na anọ nke otu ọnwa ahụ, ndị Izrel niile zukọkwara na obubu ọnụ, yiri uwe iru ụjụ, kpokwasịkwa onwe ha ntụ nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.1",
            "verseOrgIds": [
              "NEH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị si nʼagbụrụ Izrel wezugakwara onwe ha site nʼebe ndị mba ọzọ niile nọ. Ha guzoro nʼọnọdụ ha kwupụta mmehie ha na ajọ omume nke nna nna ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.2",
            "verseOrgIds": [
              "NEH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha guzokwara nʼebe ahụ ha nọ gụọ site nʼakwụkwọ iwu nke",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.3",
                "verseOrgIds": [
                  "NEH.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke ha ruo awa atọ. Ha jikwa awa atọ nke ọzọ kwupụta mmehie ha, na ife",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.3",
                "verseOrgIds": [
                  "NEH.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ha ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.3",
            "verseOrgIds": [
              "NEH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Jeshua, Bani, Kadmiel, Shebanaya, Buni, Sherebaya, Bani na Kenani rigoro guzo nʼelu ihe nguzo ndị Livayị. Ha jiri oke olu kpọkuo",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.4",
                "verseOrgIds": [
                  "NEH.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.4",
            "verseOrgIds": [
              "NEH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị ndị a, Jeshua, Kadmiel, Bani, Hashabneia, Sherebaya, Hodia, Shebanaya na Petahaya sịrị, \"Bilienụ ọtọ, too",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.5",
                "verseOrgIds": [
                  "NEH.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, onye na-adị site nʼebighị ebi ruo ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 9:5"
      },
      "items": [
        {
          "text": "\"Ka aha gị dị ebube bụrụ ihe a gọziri agọzi, ka ọ bụrụ ihe e buliri elu karịa ngọzị niile na otuto niile.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.5",
            "verseOrgIds": [
              "NEH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onwe gị, naanị gị bụ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.6",
                "verseOrgIds": [
                  "NEH.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": ". Gị kere eluigwe, ọ bụladị eluigwe kachasị elu, na kpakpando niile nke mbara eluigwe, ụwa na ihe niile dị nʼime ya, oke osimiri niile na ihe niile dị nʼime ha. Ọ bụ gị na-enye ihe niile ndụ, usuu niile nke eluigwe na-akpọkwa isiala nye gị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gị, onwe gị bụ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.7",
            "verseOrgIds": [
              "NEH.9.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.9.7",
                "verseOrgIds": [
                  "NEH.9.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ahụ, onye họpụtara Ebram site nʼobodo Ụọ nke ndị Kaldịa, kpọpụta ya, gụgharịa aha ya ka ọ bụrụ Ebraham.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.7",
            "verseOrgIds": [
              "NEH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị hụkwara nʼobi ya kwesiri ntụkwasị obi nye gị, gị na ya gbakwara ndụ na ị ga-enye ụmụ ya ala ndị Kenan, nke ndị Het, nke ndị Amọrait, nke ndị Periz, nke ndị Jebus na nke ndị Gigash. I mezuola nkwa gị nʼihi na ị bụ onye ezi omume.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.8",
            "verseOrgIds": [
              "NEH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị hụrụ nsogbu na iru ụjụ niile nke nna nna anyị ha nʼala Ijipt; ị nụkwara akwa ha nʼakụkụ Osimiri Uhie.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.9",
            "verseOrgIds": [
              "NEH.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I gosiri Fero na ndịisi ọchịchị ya na ndị ya niile ọtụtụ ihe ịrịbama na ọrụ ebube nʼihi na ị hụrụ otu ha siri site na nganga juru ha obi mesoo ndị gị mmeso ọjọọ. Ụwa niile maara aha gị taa nʼihi ọrụ ebube ndị a niile ị rụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.10",
            "verseOrgIds": [
              "NEH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kewara Osimiri Uhie abụọ mee ka ndị gị site nʼala akọrọ gafee. Ma i mere ka ndị iro ha na-achụ ha ọsọ nwụọ nʼime oke osimiri ahụ. Ha mikpuru dịka nkume danyere nʼime mmiri, nke oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.11",
            "verseOrgIds": [
              "NEH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ji ogidi igwe ojii duo nna nna anyị ha nʼehihie, ma were ogidi ọkụ duo ha nʼabalị, inye ha ìhè ka ha ghara ijehie ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.12",
            "verseOrgIds": [
              "NEH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I sitere nʼeluigwe gwa ha okwu, ị rịdatara nʼugwu Saịnaị, ị nyere ha iwu na ntụziaka niile ziri ezi, nyekwa ha ụkpụrụ na ihe niile dị mma nke enyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.13",
            "verseOrgIds": [
              "NEH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mere ka ha mata ụbọchị izuike gị dị nsọ, nyekwa ha iwu site nʼọnụ ohu gị Mosis, ka ha debe iwu gị na ụkpụrụ gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.14",
            "verseOrgIds": [
              "NEH.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I sitere nʼeluigwe nye ha achịcha mgbe agụụ gụrụ ha, sitekwa na nkume nye ha mmiri mgbe akpịrị kpọrọ ha nkụ. I sịkwara ha baa nʼime ala ahụ inweta ala ahụ bụ nke i weliri aka gị ṅụọ iyi inye ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.15",
            "verseOrgIds": [
              "NEH.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma nna nna anyị ha erubeghị isi nʼokwu gị, nʼihi isiike ha na nganga ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.16",
            "verseOrgIds": [
              "NEH.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha egeghị ntị ọbụla, ha echetakwaghị ihe ịrịbama niile i meere ha. Kama ha nupuru isi họpụtara onwe ha onyeisi ga-eduru ha ịlaghachi Ijipt. Ma ị bụ Chineke onye na-eme ebere, onye na-agbaghara mmehie ndị gị mgbe ọbụla. Ị bụ onye obiọma, onye iwe na-adịghị ewe ọsịịsọ. I jupụtara nʼịhụnanya na amara mgbe niile. Nʼihi ya, ị gbakụtaghị ha azụ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.17",
            "verseOrgIds": [
              "NEH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụladị mgbe ha meere onwe ha nwa ehi ha kpụrụ akpụ kwuo sị, 'Nke a bụ chi unu. Ọ bụ ya si nʼala Ijipt dupụta anyị,' maọbụ mgbe ha mehiere megide gị nʼụzọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.18",
            "verseOrgIds": [
              "NEH.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma nʼihi obi ebere gị nke dị ukwuu, ị hapụghị ha ka ha nwụọ nʼọzara. Ogidi igwe ojii ahụ duuru ha ụbọchị niile, ma ogidi ọkụ ahụ dukwara ha abalị niile.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.19",
            "verseOrgIds": [
              "NEH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I zitere ezi Mmụọ nke gị ime ka ha nwee uche. Ị gbochikwaghị mánà gị iru ha ọnụ, ị nyekwara ha mmiri nʼihi akpịrị ịkpọ nkụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.20",
            "verseOrgIds": [
              "NEH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri afọ anọ ka i debere ha ndụ nʼọzara. Ọ dịghị ihe kọrọ ha nʼoge ahụ. Uwe ha akaghị nka, ukwu ha azaghị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.21",
            "verseOrgIds": [
              "NEH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"I nyere ha alaeze na mba dị iche iche, kenye ha ọbụladị ebe ndị dịkarịsịrị anya. Ha nwetara ala Saịhọn bụ eze Heshbọn, na ala Ọg bụ eze Bashan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.22",
            "verseOrgIds": [
              "NEH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mere ka ụmụ Izrel mụbaa dịka kpakpando nke eluigwe, ị kpọbatara ha nʼala ahụ i gwara ndị bụ nna ha ka ha baa nweta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.23",
            "verseOrgIds": [
              "NEH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ha banyere nweta ala ahụ. I meriri ndị Kenan nʼihu ha, bụ ndị bi nʼala ahụ. I weere ndị Kenan ahụ nyefee nʼaka ha, ha na ndị eze ha, na ndị niile bi nʼala ahụ ka ndị gị jiri ha mee ihe ọbụla ha kpebiri nʼobi ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.24",
            "verseOrgIds": [
              "NEH.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị gị nwetara ala mara mma, na ọtụtụ obodo e wusiri ike; ha nwetakwara ọtụtụ ụlọ nke ihe ọma juru nʼime ha, na olulu mmiri e gwuru nke ọma, na ubi vaịnị mkpụrụ dị, na ubi oliv, na ọtụtụ osisi ọma ndị ọzọ na-amị mkpụrụ. Ha rijuru afọ, ahụ ha mara mma ile anya, ha ṅụrikwara ọṅụ nʼihi ngọzị ị gọziri ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.25",
            "verseOrgIds": [
              "NEH.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ha nupuru isi nʼokwu gị, jụ iwu gị, gbuo ndị amụma tụrụ ha mmehie ha nʼihu, meekwa ọtụtụ ihe ọjọọ ndị ọzọ dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.26",
            "verseOrgIds": [
              "NEH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, i nyefere ha nʼaka ndị iro ha, ndị kpagburu ha. Ma nʼime mkpagbu ha, ha kpọkuru gị, ị nọkwa nʼeluigwe nụ ekpere ha, sitekwa nʼobi ebere gị zigara ha ndị bịara zọpụta ha, na ndị napụtara ha site nʼaka ndị iro ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.27",
            "verseOrgIds": [
              "NEH.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma mgbe ihe bidoro ịgara ha nke ọma, ha mekwara ihe jọrọ njọ nʼihu gị. Ọzọkwa, i nyefere ha nʼaka ndị iro ha ka ndị iro ha merie ha. Ma mgbe ọbụla ndị gị chegharịkwutere gị, kpọkuo gị ka i nyere ha aka, ị na-anụ arịrịọ ha, sitekwa nʼobi ebere gị gbapụta ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.28",
            "verseOrgIds": [
              "NEH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị dọrọ ha aka na ntị sị ha lọghachi debe ihe i nyere nʼiwu. Ma ha sitere na nganga juru ha obi jụ idebe iwu gị. Ha mehiere megide ihe niile i nyere nʼiwu, ọ bụ ezie na ha maara na idebe ya ga-ewetara ha ndụ. Ma site nʼisiike ha, ha gbakụtara gị azụ, bụrụ ndị isiike na ndị jụrụ ige ntị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.29",
            "verseOrgIds": [
              "NEH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma i sitere na ntachiobi gị nye ha ogologo oge ichegharị; ị dọrọ ha aka na ntị site nʼọnụ ndị amụma gị, ma ha egeghị ntị. Ya mere, i kwenyekwara ka ndị iro ha merie ha ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.30",
            "verseOrgIds": [
              "NEH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼihi obi ebere gị i bibighị ha kpamkpam; ị gbakụtakwaghị ha azụ nʼihi na ị bụ Chineke onye dị ebere na onye amara.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.31",
            "verseOrgIds": [
              "NEH.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, Chineke anyị, Chineke dị ukwuu, onye dị ike dịkwa ebube, onye na-edebe ọgbụgba ndụ ịhụnanya ya, ka ọnọdụ ihe isi ike a ghara ịbụ ihe nta nʼanya gị. Ntaramahụhụ nke dakwasịrị anyị, ndị eze anyị na ndị ndu anyị, ndị nchụaja anyị, ndị amụma anyị, nna nna anyị ha na ndị gị niile, site nʼoge ndị eze Asịrịa buru ụzọ lụgbuo anyị nʼagha tutu ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.32",
            "verseOrgIds": [
              "NEH.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị onwe gị bụ onye ezi omume, nʼihe niile bịakwasịrị anyị; Ị mere ihe kwesiri, ebe anyị onwe anyị mere ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.33",
            "verseOrgIds": [
              "NEH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị eze anyị, ndị ndụ anyị na ndị nchụaja na nna nna anyị edebeghị iwu gị; ha aṅaghịkwa ntị nʼihe niile i nyere nʼiwu maọbụ ihe ama gị nke ị dọrọ ha aka na ntị idebe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.34",
            "verseOrgIds": [
              "NEH.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị mgbe ha nọ nʼalaeze nke aka ha na-ekpori ndụ, nke oke ịdị mma gị nke ị mere ka o rute ha aka, nʼala ọma ahụ sara mbara nwere ume i nyere ha, ha efeghị gị ofufe, ha esitekwaghị nʼụzọ ọjọọ ha chigharịa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.35",
            "verseOrgIds": [
              "NEH.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma lee, anyị bụ ndị ohu taa, e, anyị bụ ndị ohu nʼala ahụ i nyere nna nna anyị ha, ka ọ bụrụ ebe ha ga-esi rie mkpụrụ ọ mịpụtara na ihe ọma ọ na-amịpụta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.36",
            "verseOrgIds": [
              "NEH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi mmehie anyị, mkpụrụ ọma niile a na-esi na ya wepụta ka ndị eze ahụ niile i mere ka ha na-achị anyị na-ewere. Ha nwere ike nʼahụ anyị, na nʼebe anụ ụlọ anyị dị ka o si dị ha mma. Anyị na-ahụjukwa anya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.37",
            "verseOrgIds": [
              "NEH.9.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwekọrịta nke mmadụ niile",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ihe ndị a niile, anyị na-ekwe gị nkwa ugbu a na anyị ga-efe gị. Anyị, ndịisi anyị, ndị Livayị na ndị nchụaja, na-etinye aha anyị nʼọgbụgba ndụ a.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        }
      ]
    }
  ],
