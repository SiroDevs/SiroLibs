  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "NEH 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị wugharịrị mgbidi ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Eliashib onyeisi nchụaja na ndị nchụaja ibe ya wuru mgbidi ahụ ruo nʼụlọ elu Narị na ụlọ elu Hananel. Ha wukwara Ọnụ Ụzọ ama Atụrụ, kwụba ibo ya, doo ya nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị sitere obodo Jeriko rụkwara ọrụ nʼakụkụ ha. Ma Zakua nwa Imri, rụrụ ọrụ nke ha nʼakụkụ ndị ọrụ si Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Hasena wuru Ọnụ Ụzọ ama Azụ, dobe osisi ya, kwụba ọnụ ụzọ ya, kpụọkwa ihe mkpọchi ya niile, na ihe ntụchi ya niile nʼọnọdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meremot, nwa Ụraya, nwa Hakoz, rụziri akụkụ mgbidi nke ọzọ. Onye na-eso ya bụ Meshulam, nwa Berekaya, nwa Meshezabel, rụziri mgbidi, onye na-esota ya bụ Zadọk nwa Baana, onye rụzikwara mgbidi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkụ nke ọzọ ka ndị ikom Tekoa rụziri, ma ndị ha a na-asọpụrụ ekweghị ehudata ubu ha nye ọrụ ahụ nʼokpuru ndị nlekọta ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joiada nwa Pasea na Meshulam nwa Besodeia wuru Ọnụ Ụzọ Ama Jeshana. Ha tinyere osisi ya niile, kwụba ibo ọnụ ụzọ ya, ihe mkpọchi ya na ihe ntụchi ya niile nʼọnọdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọzọ rụrụ ọrụ nʼakụkụ ha bụ Melataya, onye Gibiọn, na Jadon onye Meronot, na ndị si Gibiọn na Mizpa. Obodo ndị a dị nʼokpuru onyeisi ọchịchị akụkụ ọdịda anyanwụ Yufretis.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziel nwa Hahaya, bụ ọkpụ ụzụ ọlaedo, doziri otu akụkụ. Onye na-eso ya bụ Hananaya, otu onye nʼime ndị na-eme mmanụ otite na-esi isi ọma, doziri nke na-esote nke ahụ. Ha doziri Jerusalem ruruo ya na Mgbidi Obosara.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eso ha bụ Refaya nwa Hua onyeisi ọchịchị otu akụkụ Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eso ya bụ Jedaya nwa Harumaf, onye rụrụ akụkụ mgbidi ahụ chere ihu nʼụlọ nke aka ya. Onye na-eso ya nʼọrụ a bụ Hatush nwa Hashabneia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọzọ bụ Malkija nwa Harim, na Hashub nwa Pahat-Moab, ndị wugharịrị ụlọ elu ọkụ, na otu akụkụ mgbidi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalum nwa Halohesh na ụmụ ya ndị inyom meziri akụkụ mgbidi nke na-esota. Ọ bụ onyeisi ọchịchị otu akụkụ Jerusalem nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanun duuru ndị obodo Zanoa wuo Ọnụ Ụzọ Ndagwurugwu. Ha wuziri ya, tinye ibo ya, ihe mkpọchi ya na ihe ntụchi ya niile nʼọnọdụ ha. Ha wuzikwara mpaghara ahụ nke ịdị ogologo ya ruru narị mita ise, ruo nʼọnụ ụzọ ama dị nʼebe a na-ekpofu ahịhịa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malkija nwa Rekab, onyeisi ọchịchị ala nke dị Bet-Hakerem gburugburu, bụ onye wuziri ọnụ ụzọ ama dị nʼebe ikpofu ahịhịa. O tinyere ibo ya, ihe mkpọchi ya na ihe ntụchi ya niile nʼọnọdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalum nwa Kol-Hoze, onyeisi ọchịchị ala dị Mizpa gburugburu, wuziri ọnụ ụzọ ama isi iyi, kpuchie elu ya, tinye ya ibo ọnụ ụzọ ya, ihe mkpọchi na ihe ntụchi ya niile nʼọnọdụ ha. O mezikwara mgbidi ahụ site nʼọdọ mmiri Siloam ruo nʼubi eze a gbara ogige, na ruokwa na nkwasa nrịda dị site nʼobodo Devid ma e site Jerusalem na-apụta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eso ya bụ Nehemaya nwa Azbuk, onyeisi ọchịchị ọkara nʼime Bet Zoa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
        {
          "text": "O wuziri mgbidi ahụ ruo ncherita ihu ebe ili Devid, ruokwa ọdọ ebe emere maka ichekọta mmiri, na nʼỤlọ ndị Dike nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ ndị Livayị rụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-eso ya bụ ndị Livayị, ndị nke Rehum nwa Bani na-achịkọta. Onye ọzọ bụ Hashabaya onyeisi ọchịchị ọkara ndị bi na Keila. Ọ rụrụ ọrụ e kenyere ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọzọ na-eso ya bụ Binui nwa Henadad onye bụ onyeisi ọchịchị ọkara akụkụ Keila nke ọzọ. O du ndị Keila ibe ya rụọ ọrụ ha ketara.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eso ya bụ Eza nwa Jeshua onyeisi ọchịchị obodo Mizpa. Ya na ndị otu ya rụziri akụkụ mgbidi ahụ dị na mgbago ebe ụlọ nchịkọta ngwa agha ruo na nkuku ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọzọ na-eso ya bụ Baruk, nwa Zabai, onye ji nnọọ ịnụ ọkụ nʼobi rụzie mgbidi ahụ site na nkuku ya ruo nʼọnụ ụzọ e si abata ụlọ Eliashib, bụ onyeisi nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eso ya bụ Meremot nwa Ụraya, nwa Hakoz. Ọ sitere nʼọnụ ụzọ ụlọ Eliashib rụziri ruo na ngwụcha ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ ndị nchụaja rụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja si nʼakụkụ Jerusalem wuziri akụkụ nke na-esote ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isonye ha, Benjamin na Hashub wuziri akụkụ ahụ dị nʼihu ụlọ ha. Azaraya nwa Maaseia, onye bụkwa nwa nwa Ananaya wuziri nke na-esote ya, nke dịkwa nʼakụkụ ụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binui nwa Henadad wuziri akụkụ nke ọzọ, nke sitere nʼihu ụlọ Azaraya ruo na nkuku mgbidi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palal nwa Uzai wuziri akụkụ nke na-eso ya site na nkuku mgbidi ahụ ruo nʼụlọ elu dị nʼakụkụ elu elu ụlọeze nʼebe dị nso nʼogige ndị nche. Nke so ya bụ Pedaia nwa Parosh,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndị na-eje ozi nʼụlọnsọ ahụ bụ ndị bi nʼelu ugwu Ofel, wuziri akụkụ nke na-esote ruo nʼebe dị nʼakụkụ ọwụwa anyanwụ nke Ọnụ Ụzọ Ama Mmiri, ruokwa nʼụlọ elu nche nke ụlọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom Tekoa wuru akụkụ nke ọzọ na-esote ya. Ha sitere nʼebe chere ụlọ elu nche nke ụlọnsọ ukwu ahụ ihu, wuzie mgbidi ahụ ruo na mgbidi dị Ofel nso.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ ndị nchụaja wuziri akụkụ na-esote, nke dị nʼugwu, site nʼỌnụ Ụzọ Ama Ịnyịnya. Onye ọbụla wuziri mgbidi nke dị nʼihu ụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zadọk nwa Imea wuziri nke na-esota, bu akụkụ mgbidi ahụ chere ihu nʼụlọ ya. Shemaya nwa Shekanaya onye na-eche Ọnụ Ụzọ Ama Ọwụwa Anyanwụ wuziri akụkụ nke na-esota.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hananaya nwa Shelemaya na Hanun nwa Zalaf nke isii, wuziri akụkụ mgbidi nke ọzọ. Meshulam nwa Berekaya wuziri akụkụ mgbidi na-esota, bụkwa nke dị nʼihu ụlọ obibi ya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malkija ọkpụ ụzụ ọlaedo wuziri akụkụ na-esota ruo nʼụlọ ahụ ndị na-eje ozi nʼụlọnsọ, na ndị na-azụ ahịa na-anọkọ. Ụlọ a dị na ncherita ihu Ọnụ Ụzọ Ama Nnyocha. Malkija sitekwara nʼebe ahụ wuzie mgbidi ahụ ruo nʼọnụụlọ ahụ dị nʼelu nkuku mgbidi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọkpụ ụzụ ọlaedo na ndị ahịa rụchara ọrụ iwuzi akụkụ mgbidi nke fọdụrụ, site nʼetiti ọnụụlọ ahụ dị nʼelu nkuku mgbidi ahụ ruo nʼỌnụ Ụzọ Ama Atụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
        }
      ]
    }
