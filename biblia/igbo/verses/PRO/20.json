  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "PRO 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmanya bụ onye na-akwa emo. Onye mkpọtụ ka ihe ọṅụṅụ na-aba nʼanya bụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:1"
      },
      "items": [
        {
          "text": "Onye ọbụla kwere ka ha duhie ya bụ onye nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.1",
            "verseOrgIds": [
              "PRO.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụma eze na-emenye oke ụjọ nʼahụ dịka mbigbọ nke ọdụm;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:2"
      },
      "items": [
        {
          "text": "ndị na-akpasu ya iwe ga-atụfu ndụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.2",
            "verseOrgIds": [
              "PRO.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ihe nsọpụrụ nye onye na-ezere okwu na ụka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:3"
      },
      "items": [
        {
          "text": "ma onye nzuzu ọbụla na-eme ngwa ise okwu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.3",
            "verseOrgIds": [
              "PRO.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye umengwụ adịghị arụ ọrụ ubi nʼoge ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:4"
      },
      "items": [
        {
          "text": "Nʼoge owuwe ihe ubi ọ pụghị ịchọta ihe oriri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.4",
            "verseOrgIds": [
              "PRO.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzube niile nke dị mmadụ nʼobi bụ mmiri dị omimi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:5"
      },
      "items": [
        {
          "text": "ma onye nwere nghọta na-adọpụta ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.5",
            "verseOrgIds": [
              "PRO.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ mmadụ na-asị na ha nwere ịhụnanya na-adịghị agharịpụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:6"
      },
      "items": [
        {
          "text": "ma onye kwesiri ntụkwasị obi, onye pụrụ ịchọta ya?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.6",
            "verseOrgIds": [
              "PRO.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ezi omume nke na-ejegharị nʼizuoke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:7"
      },
      "items": [
        {
          "text": "ndị ihe na-agara nke ọma ka ụmụ ga-anọchi ya ga-abụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.7",
            "verseOrgIds": [
              "PRO.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze na-anọkwasị nʼocheeze ya ikpe ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:8"
      },
      "items": [
        {
          "text": "ọ na-eji anya ya abụọ afụchapụ ihe ọjọọ niile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.8",
            "verseOrgIds": [
              "PRO.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye pụrụ ị sị, \"Emeela m ka obi m dị ọcha;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:9"
      },
      "items": [
        {
          "text": "Abụ m onye dị ọcha, mmehie adịghịkwa nʼime m?\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.9",
            "verseOrgIds": [
              "PRO.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọtụtụ aghụghọ na ihe ọtụtụ nghọgbu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:10"
      },
      "items": [
        {
          "text": "ha niile bụ ihe arụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.20.10",
                "verseOrgIds": [
                  "PRO.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.10",
            "verseOrgIds": [
              "PRO.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọbụladị ụmụntakịrị ka a na-amata site nʼomume ha niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:11"
      },
      "items": [
        {
          "text": "nke a ọ pụtara nʼomume ha dị ọcha nʼezie a, bụrụkwa ihe ziri ezi?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.11",
            "verseOrgIds": [
              "PRO.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntị nke na-anụ ihe na anya nke na-ahụ ụzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:12"
      },
      "items": [
        {
          "text": "ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.20.12",
                "verseOrgIds": [
                  "PRO.20.12"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ha abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.12",
            "verseOrgIds": [
              "PRO.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụla ịrahụ ụra nʼanya, ka ị ghara ịghọ onye ụkpa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:13"
      },
      "items": [
        {
          "text": "Bilie, mụrụ anya, rụsie ọrụ ike, ka i nweekwa ihe oriri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.13",
            "verseOrgIds": [
              "PRO.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lee, ihe a jọrọ njọ, ọ baghị uru,\" ka onye na-azụ ahịa na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:14"
      },
      "items": [
        {
          "text": "ma mgbe ọ pụrụ ọ na-anya isi nʼihi ihe ọ zụtara.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.14",
            "verseOrgIds": [
              "PRO.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlaedo dị, na ọtụtụ rubi nʼebe ọ bara ụba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 20:15"
      },
      "items": [
        {
          "text": "ma egbugbere ọnụ nke na-ekwupụta ihe ọmụma bụ ọla dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.20.15",
            "verseOrgIds": [
              "PRO.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 20:16"
          },
          "items": [
            {
