      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:19"
      },
      "items": [
        {
          "text": "Iwe ya na-adị ike dịka ọnụ ụzọ e jiri igodo tụchie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.19",
            "verseOrgIds": [
              "PRO.18.19"
            ]
          }
        }
      ]
