  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "PRO 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ihe mmadụ na-adịghị amasị na-agbaso naanị ọchịchọ nke ya onwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:1"
      },
      "items": [
        {
          "text": "na-alụsokwa ezi nzube niile ọzọ ọgụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nghọta adịghị atọ onye nzuzu ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:2"
      },
      "items": [
        {
          "text": "Naanị ihe ọ maara bụ ikwu uche ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye ajọ omume na-abata, ka nleda anya na-abata,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:3"
      },
      "items": [
        {
          "text": "otu a kwa nkọcha na-eweta ihere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu ọnụ niile bụ mmiri dị omimi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:4"
      },
      "items": [
        {
          "text": "ma amamihe dị ka mmiri iyi na-asọ asọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mma ime ka ikpe gara onye mere ihe ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:5"
      },
      "items": [
        {
          "text": "si otu a gbochie onye aka ya dị ọcha inweta ikpe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egbugbere ọnụ ndị nzuzu na-ebutere ha esemokwu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:6"
      },
      "items": [
        {
          "text": "ọnụ ha na-ebutere ha ihe otiti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ onye nzuzu na-etinye ya na nsogbu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:7"
      },
      "items": [
        {
          "text": "egbugbere ọnụ ya bụ ọnya nye mkpụrụobi ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu niile nke onye na-agba asịrị na-ekwu dịka iberibe nri nʼatọ ezi ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:8"
      },
      "items": [
        {
          "text": "ha na-agbadakwa nʼime ime ala afọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye dị umengwụ nʼọrụ ya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:9"
      },
      "items": [
        {
          "text": "bụ nwanne nke onye mbibi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.18.10",
                "verseOrgIds": [
                  "PRO.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ụlọ elu e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:10"
      },
      "items": [
        {
          "text": "ndị ezi omume na-agbaba nʼime ya izere ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụ ndị ọgaranya bụrụ ha obodo e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:11"
      },
      "items": [
        {
          "text": "ọ bụkwa mgbidi dị elu nke a na-apụghị ịmafe nʼechiche ha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupu mmadụ adaa obi ya na-ejupụta na nganga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:12"
      },
      "items": [
        {
          "text": "ma inwe obi umeala na-eweta nsọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inye ọsịsa okwu tupu mmadụ ege ntị",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:13"
      },
      "items": [
        {
          "text": "bụ enweghị uche na ihe ihere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ mmụọ mmadụ na-akwado ya nʼoge nrịa nrịa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:14"
      },
      "items": [
        {
          "text": "ma mmụọ e tipịara etipịa, onye pụrụ ibuli ya?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi onye nwere nghọta na-enweta ihe ọmụma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:15"
      },
      "items": [
        {
          "text": "nʼihi na ntị onye maara ihe na-achọpụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyinye mmadụ na-akwara ya ụzọ sara mbara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:16"
      },
      "items": [
        {
          "text": "ọ na-edubakwa ya nʼihu ndị dị elu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
