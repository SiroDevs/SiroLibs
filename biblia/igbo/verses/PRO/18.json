              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ife nza na-akwụsị esemokwu na ndọrọndọrọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.18",
            "verseOrgIds": [
              "PRO.18.18"
            ]
          }
        }
      ]
