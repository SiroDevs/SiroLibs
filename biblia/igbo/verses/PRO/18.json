      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:20"
      },
      "items": [
        {
          "text": "Sitekwa nʼihe owuwe ubi nke egbugbere ọnụ ha ka ha ga-eji rijuo afọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.20",
            "verseOrgIds": [
              "PRO.18.20"
            ]
