          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpe onye buru ụzọ kwuo ihe na-ese na-adị ka onye ikpe gaara,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.17",
            "verseOrgIds": [
              "PRO.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:17"
      },
      "items": [
        {
          "text": "tutu ruo mgbe mmadụ bịara bido ịjụ ya ajụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.17",
            "verseOrgIds": [
              "PRO.18.17"
            ]
          }
        }
      ]
