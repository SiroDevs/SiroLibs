      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:18"
      },
      "items": [
        {
          "text": "dị nʼetiti mmadụ abụọ ndị olu ha na-ala elu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.18",
            "verseOrgIds": [
              "PRO.18.18"
            ]
          }
        }
      ]
