  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "PRO 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amamihe na-eweta ahụ ike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa m echezọla ihe niile m ziri gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:1"
      },
      "items": [
        {
          "text": "Ma debe iwu m nʼobi gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.1",
            "verseOrgIds": [
              "PRO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha ga-eme ka ndụ gị dị ogologo ruo ọtụtụ afọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:2"
      },
      "items": [
        {
          "text": "wetakwara gị udo na ọganihu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.2",
            "verseOrgIds": [
              "PRO.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwela ka ịhụnanya na ikwesi ntụkwasị obi hapụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "kekwasị ha nʼolu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:3"
      },
      "items": [
        {
          "text": "deekwa ha nʼelu mbadamba nkume, bụ obi gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.3",
            "verseOrgIds": [
              "PRO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ị ga-enwe ihuọma na ezi aha",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:4"
      },
      "items": [
        {
          "text": "nʼanya Chineke na nʼihu mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.4",
            "verseOrgIds": [
              "PRO.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.3.5",
                "verseOrgIds": [
                  "PRO.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "obi gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:5"
      },
      "items": [
        {
          "text": "adaberekwala na nghọta gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.5",
            "verseOrgIds": [
              "PRO.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihe ọbụla ị na-eme, ka Chineke bute ụzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:6"
      },
      "items": [
        {
          "text": "ọ ga-eduzi gị, meekwa ka okporoụzọ gị niile gazie.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.6",
            "verseOrgIds": [
              "PRO.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bụla onye maara ihe nʼanya nke onwe gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:7"
      },
      "items": [
        {
          "text": "Tụọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.3.7",
                "verseOrgIds": [
                  "PRO.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "egwu, kpọọkwa ihe ọjọọ asị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.7",
            "verseOrgIds": [
              "PRO.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ga-eme ka i nwee ahụ ike",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:8"
      },
      "items": [
        {
          "text": "gbaakwa ọkpụkpụ gị ume.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.8",
            "verseOrgIds": [
              "PRO.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọpụrụ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.3.9",
                "verseOrgIds": [
                  "PRO.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼinye ya mkpụrụ mbụ nke akụnụba gị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:9"
      },
      "items": [
        {
          "text": "na mkpụrụ mbụ nke ihe ubi gị.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.9",
            "verseOrgIds": [
              "PRO.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ka ọ ga-eme ka ọba gị niile jubigakwa oke,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:10"
      },
      "items": [
        {
          "text": "ebe ịnara mmanya gị ga-ejupụta na mmanya ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.10",
            "verseOrgIds": [
              "PRO.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa m nwoke ajụla ịdọ aka na ntị nke",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.3.11",
                "verseOrgIds": [
                  "PRO.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:11"
      },
      "items": [
        {
          "text": "ike agwụla gị ịnagide ịba mba ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.11",
            "verseOrgIds": [
              "PRO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ ndị",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.3.12",
                "verseOrgIds": [
                  "PRO.3.12"
                ]
              }
            }
          ]
        },
        {
          "text": "hụrụ nʼanya ka ọ na-abara mba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:12"
      },
      "items": [
        {
          "text": "dịka nna si abara nwa ya nke ihe ya na-atọ ya ụtọ mba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.12",
            "verseOrgIds": [
              "PRO.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye a gọziri agọzi ka mmadụ ahụ bụ onye chọtara amamihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:13"
      },
      "items": [
        {
          "text": "onye nwetara nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.13",
            "verseOrgIds": [
              "PRO.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na amamihe dị mma karịa ọlaọcha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:14"
      },
      "items": [
        {
          "text": "ọ bakwara uru karịa ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.14",
            "verseOrgIds": [
              "PRO.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị oke ọnụahịa karịa ọla rubi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
            "verseOrgIds": [
              "PRO.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 3:15"
      },
      "items": [
        {
          "text": "ọ dịghị ihe na-amasị gị e ji atụnyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.3.15",
