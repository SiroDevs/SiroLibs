  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "EXO 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.1",
            "verseOrgIds": [
              "EXO.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.1",
                "verseOrgIds": [
                  "EXO.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.1",
            "verseOrgIds": [
              "EXO.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel ka ha chigharịa azụ jee maa ụlọ ikwu ha na ncherita ihu Pi Hahirot, nke dị nʼetiti Migdol na osimiri. Ọ bụ nʼakụkụ osimiri, na ncherita ihu obodo Baal-Zefọn ka ha ga-ama ụlọ ikwu ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.2",
            "verseOrgIds": [
              "EXO.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero ga-asị banyere ụmụ Izrel, 'Ha na-awagharị gburugburu ala ahụ nʼọnọdụ mgbagwoju anya ebe ọzara riri ha.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.3",
            "verseOrgIds": [
              "EXO.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka obi Fero sie ike ka ọ chụso unu ọsọ nʼazụ, ma m ga-ewetara onwe m otuto site na Fero na ndị agha ya niile. Ndị Ijipt niile ga-ama na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.4",
                "verseOrgIds": [
                  "EXO.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Ndị Izrel mekwara otu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.4",
            "verseOrgIds": [
              "EXO.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara eze Ijipt na ndị a agbaala ọsọ, obi Fero na ndị ozi ya gbanwere megide ndị Izrel. Ha sịrị, \"Gịnị bụ ihe anyị mere, site na izipụ ndị Izrel nʼọrụ ife anyị?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.5",
            "verseOrgIds": [
              "EXO.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na-atụfughị oge, Fero rigoro nʼelu ụgbọ agha ya, duru ndị agha ya ịchụso ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.6",
            "verseOrgIds": [
              "EXO.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịịrị ụgbọ agha dị narị isii e leziri anya họpụta, tinyere ụgbọ agha Ijipt niile. Ndịisi agha ndị Ijipt nọcha nʼelu ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.7",
            "verseOrgIds": [
              "EXO.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.8",
                "verseOrgIds": [
                  "EXO.14.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka obi Fero eze Ijipt sie ike. Ọ chụsoro ụmụ Izrel, ndị na-aga nʼihu nʼije ha, na-atụghị egwu maọbụ ịda mba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.8",
            "verseOrgIds": [
              "EXO.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Ijipt chụsoro ha ọsọ, ịnyịnya Fero na ụgbọ agha, na ndị na-agba ịnyịnya na ndị agha ndị ọzọ chụsoro ndị Izrel ọsọ chụkwute ha nʼebe ha na-ezu ike nʼakụkụ osimiri dị nso na Pi Hahirot na ncherita ihu Baal-Zefọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.9",
            "verseOrgIds": [
              "EXO.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị agha Fero na-abịa nso, ndị Izrel lere anya nʼazụ, hụ ndị Ijipt ka ha na-abịa nso. Ha tụrụ egwu, tie mkpu akwa, kpọkuo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.10",
            "verseOrgIds": [
              "EXO.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.10",
                "verseOrgIds": [
                  "EXO.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.10",
            "verseOrgIds": [
              "EXO.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jụrụ Mosis sị, \"Ọ bụ na o nweghị ili dị nʼala Ijipt, i ji kwagide anyị ka anyị niile bịa nwụọ nʼebe a nʼọzara? Gịnị mere i ji kwagide anyị ka anyị hapụ Ijipt?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.11",
            "verseOrgIds": [
              "EXO.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na anyị agwaghị gị nʼala Ijipt si gị, 'Hapụ anyị ka anyị nọgide na-ejere ndị Ijipt ozi?' Ọ gara akara anyị mma ị bụ ohu ndị Ijipt karịa ịnwụ nʼọzara.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.12",
            "verseOrgIds": [
              "EXO.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis zaghachiri ha sị, \"Unu atụla egwu. Guzosienụ ike. Unu ga-ahụ ụzọ dị ebube",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
              "EXO.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.13",
                "verseOrgIds": [
                  "EXO.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-esi zọpụta unu taa. Ndị Ijipt a unu na-ahụ taa, unu agaghị ahụkwa ha ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.13",
            "verseOrgIds": [
              "EXO.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nọrọnụ jii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.14",
                "verseOrgIds": [
                  "EXO.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-alụrụ unu ọgụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.15",
                "verseOrgIds": [
                  "EXO.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya, \"Gịnị mere i ji na-akpọku m. Gwa ụmụ Izrel ka ha gaa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welie mkpanaka gị elu. Setịpụ ya nʼelu osimiri ahụ ka o kewaa abụọ. Ụzọ ga-adịkwa nʼetiti osimiri ahụ. Ụmụ Izrel ga-esitekwa nʼala akọrọ gafee.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.16",
            "verseOrgIds": [
              "EXO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka obi ndị Ijipt sie ike, ka ha sorokwa unu nʼazụ banye. Aga m ewetara onwe m otuto site na Fero, na ndị agha niile, na ụgbọ agha niile nakwa ndị na-agba ịnyịnya ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.17",
            "verseOrgIds": [
              "EXO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, ndị Ijipt ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.18",
                "verseOrgIds": [
                  "EXO.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": ". M ga-enweta nsọpụrụ site na Fero, na ụgbọ agha ya niile, na ndị na-agba ịnyịnya ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi Chineke, onye na-aga nʼihu ndị agha Izrel, sitere nʼihu pụọ gaa nọdụ nʼazụ ha. Otu a kwa, ogidi igwe ojii ahụ sitere nʼihu gaa nʼazụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.19",
            "verseOrgIds": [
              "EXO.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a mere ka ogidi igwe ojii ahụ dịrị nʼetiti ụmụ Izrel na ndị Ijipt. Nʼabalị ụbọchị ahụ, Onyenwe anyị mere ka ogidi igwe ojii ahụ nye ụmụ Izrel ìhè, ma ndị Ijipt nọgidere nʼọchịchịrị. Otu a, ndị Ijipt enweghị ike bịarute nʼebe ụmụ Izrel nọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis setịpụrụ aka ya nʼelu Osimiri Uhie ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.21",
                "verseOrgIds": [
                  "EXO.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ji oke ifufe si nʼọwụwa anyanwụ, nke fere nʼabalị ahụ niile, nughachi osimiri ahụ, mee ka osimiri ahụ kebie ụzọ abụọ, ka ụzọ pụta nʼala osimiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel sitere nʼetiti osimiri ahụ gafee. Mmiri osimiri ahụ ghọọrọ mgbidi nʼaka nri ha ma nʼaka ekpe ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị agha Ijipt na-achụ ha ọsọ hụrụ ha ka ha na-agafe, ha sogidere ha baa, ọ bụladị nʼetiti osimiri ahụ. Ndị agha Ijipt niile sooro ha, ya bụ, ụgbọ agha Fero, ndị agha ya na ndị na-agba ịnyịnya ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.23",
            "verseOrgIds": [
              "EXO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ echi ya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.24",
                "verseOrgIds": [
                  "EXO.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ledatara anya site nʼogidi igwe ojii ahụ na-enye ihe. O legidere ndị agha Ijipt anya, tinyekwa ha ụjọ nʼobi nke mere na ha amakwaghị onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mebiri ụkwụ ụgbọ agha ha mee ka o siere ịnyịnya ha ike ịdọkpụ ụgbọ agha ndị ahụ. Mgbe ahụ, ndị Ijipt kwuru sị, \"Ka anyị sinụ nʼịchụ ndị Izrel gbapụ, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.25",
                "verseOrgIds": [
                  "EXO.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "na-alụrụ ha ọgụ, na-emegidekwa anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.25",
            "verseOrgIds": [
              "EXO.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụmụ Izrel gafesịrị ruo nʼakụkụ nke ọzọ nke osimiri ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.26",
                "verseOrgIds": [
                  "EXO.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị, \"Setịpụ aka gị ọzọ ka mmiri ahụ kpuchigide ndị Ijipt, na ụgbọ agha ha niile, na ndị na-agba ịnyịnya ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis setịpụrụ aka nʼelu osimiri ahụ. Nʼụtụtụ ya, mmiri osimiri ahụ sọghachiri gaa ebe ọ nọ na mbụ. Ndị Ijipt chọsịrị ụzọ ha si agbapụ ike, ma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.27",
                "verseOrgIds": [
                  "EXO.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka osimiri ahụ kpuchie ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osimiri ahụ kpuchigidere ụgbọ agha ha niile, na ndị na-agba ịnyịnya, na ndị agha Fero niile ndị chụụrụ ụmụ Izrel baa nʼime osimiri ahụ. O nweghị otu onye nʼime ha fọdụrụ ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.28",
            "verseOrgIds": [
              "EXO.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụmụ Izrel esitelarị nʼala nke mmiri kọrọ gafee osimiri ahụ. Mgbe ha na-agafekwa, akụkụ abụọ nke osimiri ahụ guzoro ọtọ dịka mgbidi, nʼaka nri ha ma nʼaka ekpe ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.29",
            "verseOrgIds": [
              "EXO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụzọ dị otu a,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.30",
                "verseOrgIds": [
                  "EXO.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "zọpụtara ụmụ Izrel site nʼaka ndị Ijipt. Ụmụ Izrel hụkwara ozu ndị Ijipt nʼikpere mmiri osimiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel tụrụ egwu Onyenwe anyị mgbe ha hụrụ ihe ịrịbama ndị a",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.31",
                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ji zọpụta ha site nʼaka ndị Ijipt. Ha kwenyere na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.14.31",
                "verseOrgIds": [
                  "EXO.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", kwenyekwa na Mosis ohu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        }
      ]
    }
