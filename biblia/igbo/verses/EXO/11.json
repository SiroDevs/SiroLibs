        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogbugbu ụmụ e buru ụzọ mụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.1",
                "verseOrgIds": [
                  "EXO.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis, \"Aga m ewetara Fero na Ijipt otu ihe otiti ọzọ. Mgbe nke a gasịrị, ọ ga-ekwe ka unu si nʼebe a pụọ. Nʼeziokwu, ọ ga-eji aka ya chụpụ unu nʼala ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.1",
            "verseOrgIds": [
              "EXO.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa nwoke na nwanyị Izrel ọbụla ka ha jikere. Ha rịọọ ndị agbataobi ha bụ ndị Ijipt, ka ha nye ha ihe ọbụla e ji ọlaọcha na ọlaedo kpụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.2",
            "verseOrgIds": [
              "EXO.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.3",
                "verseOrgIds": [
                  "EXO.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka ụmụ Izrel nweta ihuọma nʼebe ndị Ijipt, na ndị agbataobi ha nọ. Nke ka nke, Mosis ghọrọ onye a na-asọpụrụ nʼetiti ndị ozi Fero na nʼihu ndị Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Mosis sịrị, \"Ihe a ka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.4",
                "verseOrgIds": [
                  "EXO.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Nʼihe dịka nʼetiti abalị taa, aga m agafe nʼime ala Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.4",
            "verseOrgIds": [
              "EXO.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a na-eme, ndị ikom niile e bụ ụzọ mụọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "text": "nʼala Ijipt ga-anwụ, site nʼọkpara Fero, onye nọ ugbu a nʼocheeze ya, ruo nʼọkpara ohu onye nwanyị na-akwọ ihe na nkume ịkwọ nri, na ụmụ ehi niile e bụ ụzọ mụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a mere, iti mkpu akwa dị ukwuu ga-adị nʼala Ijipt, ụdị ga-ada nʼala Ijipt niile nke na-adịbeghị nʼala Ijipt, ụdị iti mkpu akwa nke na-agaghị adịkwa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼebe ụmụ Izrel nọ, nkịta agaghị agbọ nwoke maọbụ nwanyị maọbụ anụmanụ ọbụla ụja.' Site na nke a, ị ga-amata na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.7",
                "verseOrgIds": [
                  "EXO.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "na-akpa oke nʼetiti ndị Izrel na ndị Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.7",
            "verseOrgIds": [
              "EXO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọchịchị gị ndị a ga-abịa gbuo ikpere rịọọ m sị m, 'Biko kpọrọ ndị gị pụọ nʼobodo anyị.' Mgbe ha mesịrị nke a, aga m apụ.\" Iwe were Mosis mgbe o si nʼụlọ Fero na-apụta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.9",
                "verseOrgIds": [
                  "EXO.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "agwalarị Mosis sị ya, \"Fero agaghị ege gị ntị. Nke a ga-enye m ohere ime ọtụtụ ihe ebube dị iche iche nʼIjipt.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na Mosis na Erọn mere ihe ebube ndị a nʼihu Fero, ma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.11.10",
                "verseOrgIds": [
                  "EXO.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka obi Fero sie ike, ka ọ hapụ ikwe ka ụmụ Izrel si nʼala ya pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
  ],
