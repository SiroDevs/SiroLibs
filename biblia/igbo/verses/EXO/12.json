  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "EXO 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme Ngabiga na nke achịcha na-ekoghị eko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.1",
                "verseOrgIds": [
                  "EXO.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu nʼala Ijipt sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.1",
            "verseOrgIds": [
              "EXO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọnwa a ga-abụrụ unu isi ọnwa. Ọ ga-abụ ọnwa mbụ nke ọnwa niile nʼafọ unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.2",
            "verseOrgIds": [
              "EXO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ọgbakọ ụmụ Izrel niile okwu sị ha, Nʼafọ ọbụla, nʼabalị iri nke ọnwa a, nwoke ọbụla ga-eweta nwa atụrụ nʼisi ezinaụlọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.3",
            "verseOrgIds": [
              "EXO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezinaụlọ ọbụla nke dịkarịrị nta, nke na-enweghị ike iweta na iricha otu nwa atụrụ, ga-ejekwuru ezinaụlọ ọzọ dịkwa nta, ka ha jikọtaa onwe ha ọnụ weta nwa atụrụ. Ndị ga-ejikọta onwe ha ọnụ aghaghị ibu ụzọ pịa mmadụ ole ha ga-adị nwee ike richaa otu atụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.4",
            "verseOrgIds": [
              "EXO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa atụrụ a ga-eweta ga-abụ oke gbara naanị otu afọ, nke na-enweghị ntụpọ ọbụla nʼahụ ya. Unu nwere ike họrọ atụrụ maọbụ ewu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.5",
            "verseOrgIds": [
              "EXO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-elekọta ya anya ruo nʼụbọchị nke iri na anọ nke ọnwa a. Nʼabalị ụbọchị ahụ ka ọgbakọ Izrel niile ga-egbu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.6",
            "verseOrgIds": [
              "EXO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ewere ọbara ya tee nʼelu na nʼakụkụ ibo ọnụ ụzọ nke dị nʼezinaụlọ ha niile, ebe ha ga-anọ rie anụ atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.7",
            "verseOrgIds": [
              "EXO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-eri anụ atụrụ a, nke a ga-ahụ nʼọkụ nʼabalị ahụ, ya na achịcha na-ekoghị eko, na ahịhịa ndụ na-elu ilu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.8",
            "verseOrgIds": [
              "EXO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị eri nwa atụrụ ọbụla na ndụ, a gaghị esikwa ya esi, kama a ga-ahụ ya nʼọkụ. A ga-ahụ akụkụ ahụ nwa atụrụ ọbụla nʼọkụ, tinyere isi ya, ụkwụ ya na ihe dị nʼime afọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.9",
            "verseOrgIds": [
              "EXO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu agaghị erifọdụ ya ruo nʼụtụtụ echi ya. Nke ọbụla ga-afọdụ nʼabalị ahụ, a ga-akpọ ya ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.10",
            "verseOrgIds": [
              "EXO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka unu ga-esi rie ya: yirinụ uwe unu, na akpụkpọụkwụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "text": "Jirikwanụ mkpara unu. Jikerenụ dịka ndị na-aga njem dị anya. Unu ga-eri anụ atụrụ a na achịcha na-ekoghị eko ngwangwa. A ga-akpọ oriri a Mmemme Ngabiga",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.11",
                "verseOrgIds": [
                  "EXO.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m agafe nʼala Ijipt nʼabalị ahụ, igbu ndị ikom niile e bụ ụzọ mụọ nʼala Ijipt, ma mmadụ, ma anụmanụ. Aga m emekwa ka ikpe ọmụma bịakwasị chi ndị ọzọ ahụ niile Ijipt na-efe ofufe. Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.12",
                "verseOrgIds": [
                  "EXO.12.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọbara ahụ unu ga-ete nʼọnụ ibo ụlọ unu ga-abụ ihe ama igosi ebe unu bi, nʼihi na mgbe m hụrụ ọbara ahụ, aga m agafe unu. Ọ nwekwaghị ihe otiti ga-abịakwasị unu mgbe m ga-egbu ndị Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụbọchị a ga-abụrụ unu ihe ncheta nye ọgbọ niile ndị na-eso nʼazụ. Unu ga-emekwa ya ka ọ bụrụ mmemme nye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.14",
                "verseOrgIds": [
                  "EXO.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ụkpụrụ nke na-adịgide adịgide site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị asaa ka unu ga-eri achịcha na-ekoghị eko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "text": "Nʼụbọchị mbụ nke ụbọchị asaa ahụ, ka unu ga-esite nʼụlọ unu wezuga ihe iko achịcha niile, nʼihi na onye ọbụla riri nri nke ihe na-eko achịcha dị nʼime ya site nʼụbọchị mbụ ruo nʼụbọchị nke asaa, aghaghị ibipụ ya site nʼala Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-ewere ụbọchị mbụ na ụbọchị nke asaa, nke mmemme ahụ, nwee mkpọkọta dị nsọ. Onye ọbụla agaghị arụ ọrụ ọbụla nʼụbọchị abụọ ndị a, karịakwa isi nri unu ga-eri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.16",
            "verseOrgIds": [
              "EXO.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu ga-edobekwa mmemme achịcha na-ekoghị eko nʼihi na ọ bụ nʼime otu ụbọchị a ka m sitere nʼala Ijipt kpọpụta unu dịka usuu ndị agha. Unu ga-emekwa mmemme ụbọchị a ka ọ bụrụ ụkpụrụ nke na-adịgide adịgide site nʼọgbọ ruo nʼọgbọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.17",
            "verseOrgIds": [
              "EXO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnwa mbụ, nʼanyasị nke ụbọchị nke iri na anọ, ka unu ga-eri achịcha a na-ejighị ihe na-eko achịcha mee ruo nʼanyasị nke ụbọchị iri abụọ na otu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.18",
            "verseOrgIds": [
              "EXO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ụbọchị asaa ahụ, agaghị ahụ ihe na-eko achịcha nʼụlọ unu. A ga-esite nʼọgbakọ ndị Izrel bipụ onye ọbụla riri ihe ọbụla nke ihe na-eko achịcha dị nʼime ya. Iwu a dịrị ndị ọbịa niile nʼala Izrel, dịkwara ndị nwa afọ ala.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.19",
            "verseOrgIds": [
              "EXO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu agaghị eri ihe ọbụla e ji ihe na-eko achịcha mee. Nʼebe obibi unu niile, ọ bụ naanị achịcha na-ekoghị eko ka unu ga-eri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis kpọkọtara ndị okenye ụmụ Izrel niile gwa ha okwu sị, \"Gaanụ họpụta ụmụ atụrụ nʼihi agbụrụ unu niile, gbuonụ atụrụ ngabiga ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were ahịhịa hisọp, denye ya nʼọbara si nʼatụrụ ndị a nke a ga-awụnye nʼefere, tee ya nʼelu ibo na nʼakụkụ abụọ nke ọnụ ụzọ ụlọ unu. Onye ọbụla nʼime unu agaghị apụ nʼezi tutu ruo ụtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.23",
                "verseOrgIds": [
                  "EXO.12.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-agafe igbu ndị Ijipt, ọ ga-ahụ ọbara ahụ nʼawara na mbudo ibo ọnụ ụzọ ụlọ unu. Ọ ga-agafe ụlọ unu, gharakwa ikwe ka onye mbibi bata nʼụlọ unu gbuo unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu ga-edobe mmemme a dịka iwu ga-adịgide nye unu na ụmụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.24",
            "verseOrgIds": [
              "EXO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu batara nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.25",
                "verseOrgIds": [
                  "EXO.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-enye unu dịka o kwere na nkwa, unu ga-edobe ofufe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "text": "a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụmụ unu ga-ajụ unu ajụjụ sị, 'Gịnị ka ofufe a pụtara?'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.26",
            "verseOrgIds": [
              "EXO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-azaghachi ha sị, 'Ọ bụ aja ngabiga anyị na-achụrụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.27",
                "verseOrgIds": [
                  "EXO.12.27"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼihi na ọ gafere ụlọ ụmụ Izrel nʼala Ijipt, mgbe o gburu ndị Ijipt, ma o nweghị onye ọbụla nʼime anyị o gburu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel mezuru ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.28",
                "verseOrgIds": [
                  "EXO.12.28"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ha site nʼọnụ Mosis na Erọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime etiti abalị ụbọchị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.29",
                "verseOrgIds": [
                  "EXO.12.29"
                ]
              }
            }
          ]
        },
        {
          "text": "gburu ndị ikom niile e bụ ụzọ mụọ nʼala Ijipt, malite nʼọkpara Fero onye nọ nʼocheeze ya, ruo nʼọkpara nke onye Ijipt nọ nʼụlọ mkpọrọ olulu. O gbukwara ụmụ anụ ụlọ niile e bụ ụzọ mụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ahụ kwa, Fero na ndị ozi ya, na ndị Ijipt niile biliri. Oke iti mkpu akwa dakwara nʼala Ijipt, nʼihi na ọ dịghị ezinaụlọ ọnwụ na-erughị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.30",
            "verseOrgIds": [
              "EXO.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọpụpụ ụmụ Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu abalị ahụ, Fero zipụrụ ozi ka a kpọ Mosis na Erọn. Mgbe ha bịara, ọ gwara ha sị, \"Ngwa bilienụ, unu bụ ụmụ Izrel niile. Kewapụnụ onwe unu site nʼetiti anyị. Gaanụ, fee",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.31",
                "verseOrgIds": [
                  "EXO.12.31"
                ]
              }
            }
          ]
        },
        {
          "text": "unu ofufe dịka unu rịọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Durunụ igwe ehi na atụrụ unu mgbe unu na-aga. Gọziekwanụ m mgbe unu na-apụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Ijipt gbalịrị ime ka ụmụ Izrel hapụ ha ngwangwa. Ha sịrịtara onwe ha, \"Ọ bụrụ na ụmụ Izrel ahapụghị anyị ugbu a, anyị niile ga-anwụkwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.33",
            "verseOrgIds": [
              "EXO.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụ Izrel buuru ụtụ ọka e ji eme achịcha na-ekoghị eko, nke ha tinyere nʼefere e ji agwakọta ya. Ha ji akwa kechie ha, bukwasị ha nʼubu ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.34",
            "verseOrgIds": [
              "EXO.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mekwara ihe ndị ọzọ dịka Mosis gwara ha. Ha rịọrọ ndị Ijipt ka ha nye ha ihe iji ngwa nke ọlaọcha na ọlaedo, na uwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.35",
            "verseOrgIds": [
              "EXO.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.36",
                "verseOrgIds": [
                  "EXO.12.36"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ndị ya amara nʼihu ndị Ijipt, ha nyere ha ihe niile ha rịọrọ. Site nʼụzọ dị otu a, ụmụ Izrel napụtara ndị Ijipt ihe niile ha ji biri nʼụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị, ụmụ Izrel malitere ije ha site na Ramesis. Mgbe ha hapụrụ Ramesis, na-eje Sukọt, ha dị narị puku ndị ikom isii, na-agụghị ndị inyom na ụmụntakịrị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ mmadụ dị iche iche sooro ha nʼije ha. Ha dukwa igwe anụ ụlọ, igwe ewu na atụrụ ha, nke dị ukwu nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji ụtụ ọka ha si Ijipt buputa mee achịcha na-ekoghị eko. Nʼihi na a chụpụrụ ha achụpụ site nʼIjipt, ha enweghị ezi ohere kwadooro onwe ha ihe oriri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tupu ha ahapụ ala Ijipt, ụmụ Izrel ebiela nʼebe ahụ narị afọ anọ na iri afọ atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe narị afọ anọ na iri afọ atọ zuru, nʼụbọchị ahụ o zuru, usuu ndị",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.41",
                "verseOrgIds": [
                  "EXO.12.41"
                ]
              }
            }
          ]
        },
        {
          "text": "niile hapụrụ Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.42",
                "verseOrgIds": [
                  "EXO.12.42"
                ]
              }
            }
          ]
        },
        {
          "text": "chere nche nʼabalị ụbọchị ahụ maka ịkpọpụta ha site nʼala Ijipt. Nʼihi ya, abalị ụbọchị ahụ bụ mgbe pụrụ iche nye ụmụ Izrel maka iji iche nche sọpụrụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.42",
                "verseOrgIds": [
                  "EXO.12.42"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼọgbọ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu metụtara Mmemme Ngabiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.43",
                "verseOrgIds": [
                  "EXO.12.43"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ Mosis na Erọn gwa ha sị, \"Ndị a bụ usoro iwu metụtara Mmemme Ngabiga:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 12:43"
      },
      "items": [
        {
          "text": "\"Onye mba ọzọ agaghị eri anụ nwa atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohu ọbụla a kwụrụ ụgwọ nʼisi ya ga-eri ya naanị ma e biri ya ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohu e goro ọrụ, maọbụ onye ọbịa ọbụla agaghị eri ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"A ga-eri ya naanị nʼime otu ụlọ. Ọ gaghị apụ nʼezi. Unu agaghị atapịa ọkpụkpụ ọbụla nke nwa atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
            "verseOrgIds": [
              "EXO.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EXO 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzukọ niile nke ụmụ Izrel ga-eme Mmemme Ngabiga a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye mba ọzọ bi nʼetiti unu chọrọ isoro unu na Mmemme Ngabiga",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.48",
                "verseOrgIds": [
                  "EXO.12.48"
                ]
              }
            }
          ]
        },
        {
          "text": "aghaghị ibi ndị ikom niile nọ nʼezinaụlọ ya ugwu. Mgbe ahụ, ọ ga-abịaru nso isoro na mmemme, nʼihi na a ga-agụ ya dịka nwa afọ ala. Ọ dịghị onye ikom a na-ebighị ugwu ga-eri nri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu iwu a dịrị nwa afọ ala na ndị ọbịa niile bi nʼala Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel mere ihe ndị a niile, dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.50",
                "verseOrgIds": [
                  "EXO.12.50"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ha nʼiwu site nʼọnụ Mosis na Erọn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa nʼotu ụbọchị ahụ ka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.12.51",
                "verseOrgIds": [
                  "EXO.12.51"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼala Ijipt dupụta ụmụ Izrel, dịka usuu ha niile si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
      ]
    }
