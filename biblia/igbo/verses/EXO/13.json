  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "EXO 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ido nsọ nke ụmụ e bụ ụzọ mụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.1",
                "verseOrgIds": [
                  "EXO.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.1",
            "verseOrgIds": [
              "EXO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dooro m nsọ onye ọbụla bụ ọkpara, onye ọbụla e bụ ụzọ mụọ nʼetiti ụmụ Izrel, na nʼetiti mmadụ ma nʼetiti anụ ụlọ, nke m ka ọ bụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis gwara ndị Izrel sị, \"Chetanụ ụbọchị taa, ụbọchị unu si nʼala Ijipt pụta, ala ebe unu bụ ndị ohu, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.3",
                "verseOrgIds": [
                  "EXO.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼike aka ya dị ukwu kpọpụta unu site nʼebe ahụ. Unu erikwala achịcha ọbụla e ji ihe na-eko achịcha mee.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taa, nʼọnwa Abib, bụ ụbọchị unu na-ahapụ ala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.4",
            "verseOrgIds": [
              "EXO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.5",
                "verseOrgIds": [
                  "EXO.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dubatara unu nʼala ndị Kenan, ndị Het, ndị Amọrait, ndị Hiv na ndị Jebus bi nʼime ya, bụ ala ahụ ọ ṅụrụ nʼiyi nye nna nna unu ha na ọ ga-enye unu, ala mmiri ara ehi na mmanụ aṅụ na-eru na ya, unu ga-eme ofufe mmemme a nʼọnwa a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.5",
            "verseOrgIds": [
              "EXO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-eri achịcha na-ekoghị eko ụbọchị asaa ahụ. Nʼụbọchị nke ikpeazụ nʼime ụbọchị asaa ahụ, unu ga-eme mmemme oke oriri nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.6",
                "verseOrgIds": [
                  "EXO.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.6",
            "verseOrgIds": [
              "EXO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rienụ achịcha na-ekoghị eko nʼime ụbọchị asaa ndị ahụ. Achịcha e ji ihe na-eko achịcha mee agaghị adị nʼụlọ unu. Achịcha e ji ihe na-eko achịcha mee agaghị adị nʼoke ala unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.7",
            "verseOrgIds": [
              "EXO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ọbụla ị na-eme mmemme a, kọwaara nwa gị nwoke ihe kpatara i ji eme mmemme a, si ya, 'Ana m eme mmemme a maka icheta ihe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.8",
                "verseOrgIds": [
                  "EXO.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "meere m, mgbe m si nʼIjipt pụta.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.8",
            "verseOrgIds": [
              "EXO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imezu mmemme a ga-adịrị unu dịka ihe ịrịbama nʼala unu, dịrịkwa ka ihe ngosi nʼegedege ihu unu, ichetara unu na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.9",
                "verseOrgIds": [
                  "EXO.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ji aka ike ya dupụta anyị site nʼala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga na-eme mmemme a nʼoge a kara aka nʼafọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.11",
                "verseOrgIds": [
                  "EXO.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dubatara unu nʼala ndị Kenan, nyefee unu ala ahụ dịka ọ ṅụrụ nʼiyi nye nna nna unu ha,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "unu ga-enyefe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.12",
                "verseOrgIds": [
                  "EXO.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ụmụ ndị ikom unu niile e bụ ụzọ mụọ. Ọzọ, ụmụ oke anụ ụlọ niile e bụ ụzọ mụọ bụ nke",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.12",
                "verseOrgIds": [
                  "EXO.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.12",
            "verseOrgIds": [
              "EXO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri nwa atụrụ gbapụta nwa ịnyịnya ibu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
        {
          "text": "mbụ e bụ ụzọ mụọ. Ọ bụrụ na unu achọghị ịgbara nwa ịnyịnya ibu ahụ, unu aghaghị ịgbaji ya olu. Ma unu aghaghị ịgbara ụmụ ndị ikom niile e bụ ụzọ mụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼoge dị nʼihu, mgbe nwa gị nwoke ga-ajụ gị sị, 'Gịnị ka ihe ndị a pụtara?' Ị ga-azaghachi ya sị, '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.14",
                "verseOrgIds": [
                  "EXO.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jiri aka ike dị ukwu dupụta anyị site nʼIjipt, site nʼala nke ohu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.14",
            "verseOrgIds": [
              "EXO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Fero mesiri obi ya ike, jụ ka anyị si nʼala ya pụọ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.15",
                "verseOrgIds": [
                  "EXO.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gburu ụmụ ndị ikom niile e bụ ụzọ mụọ nʼala Ijipt, ma mmadụ ma anụ ụlọ. Nʼihi ya, ana m eji ụmụ oke anụ ụlọ niile e bụ ụzọ mụọ achụ aja nye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.15",
                "verseOrgIds": [
                  "EXO.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ma ụmụ m ndị ikom niile e bụ ụzọ mụọ ka m na-agbapụta.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.15",
            "verseOrgIds": [
              "EXO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmemme a ga-adị ka ihe ịrịbama nʼanya unu, dịrịkwa ka ihe ngosi nʼegedege ihu unu, ichetara unu na",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.16",
                "verseOrgIds": [
                  "EXO.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ji aka ike ya dupụta anyị site nʼala Ijipt.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
            "verseOrgIds": [
              "EXO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngafe Osimiri Uhie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Fero mesịrị kwere ka ụmụ Izrel laa, Chineke edughị ha site nʼụzọ ahụ gafere ala ndị Filistia. Ọ bụ ezie na ụzọ ahụ dị nso karịa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        },
        {
          "text": "Chineke mere nke a nʼihi na o chere nʼobi ya sị, \"Ọ bụrụ na ndị a ezute agha, ha nwere ike ịgbanwe obi ha tụgharịa ịlaghachi azụ nʼIjipt.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.17",
            "verseOrgIds": [
              "EXO.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Chineke duuru ha ga nʼụzọ Osimiri Uhie, nke gara nʼụzọ nke ọzara. Ụmụ Izrel kwadokwara akwado ibu agha mgbe ha si nʼala Ijipt pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.18",
            "verseOrgIds": [
              "EXO.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis buuru ọkpụkpụ Josef mgbe ha na-ala. Nʼihi na o mere ka ụmụ Izrel ṅụọ iyi na ha ga-eme otu a, na-asị, \"Chineke ga-eleta unu nʼezie, mgbe ahụ, unu aghaghị iburu ọkpụkpụ m si nʼebe a pụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.19",
            "verseOrgIds": [
              "EXO.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha si Sukọt bilie ije, maa ụlọ ikwu ha na Etam, na nsọtụ ọzara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.20",
            "verseOrgIds": [
              "EXO.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.21",
                "verseOrgIds": [
                  "EXO.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ji ogidi igwe ojii na-eje nʼihu ha nʼehihie, idu ha nʼụzọ ha niile. Nʼabalị, o ji ogidi ọkụ, inye ha ìhè ka ha nwee ike ịga njem nʼehihie nakwa nʼabalị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.21",
            "verseOrgIds": [
              "EXO.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ogidi igwe ojii nʼehihie na ogidi ọkụ ahụ nʼabalị, ọ dịghị nke hapụrụ ọnọdụ ya nʼihu ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.22",
