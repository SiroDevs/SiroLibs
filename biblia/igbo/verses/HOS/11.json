  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "HOS 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịhụnanya Chineke nye Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe Izrel bụ nwantakịrị, ahụrụ m ya nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:1"
      },
      "items": [
        {
          "text": "ọ bụkwa site nʼIjipt ka m kpọpụtara nwa m.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma dịka m na-akpọ ha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "otu a ka ha na-aga nʼebe dị anya site nʼebe m nọ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "Ha chụrụ Baal aja,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:2"
      },
      "items": [
        {
          "text": "surekwa aja ihe nsure ọkụ na-esi isi ụtọ nye arụsị dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.2",
            "verseOrgIds": [
              "HOS.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ mụ onwe m kuziiri Ifrem otu e si aga ije,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "ejidere m ha nʼaka m abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "ma ha amaghị",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:3"
      },
      "items": [
        {
          "text": "na ọ bụ mụ onwe m gwọrọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.3",
            "verseOrgIds": [
              "HOS.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eji m ụdọ nke mmadụ bụ ebere,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "na ịhụnanya duo ya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "Adịrị m ha dịka onye nʼebuli",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "ibu arọ site nʼolu ha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:4"
      },
      "items": [
        {
          "text": "ehulatakwara m ala, were aka m tinye ha nri nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.4",
            "verseOrgIds": [
              "HOS.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ na ha agaghị alaghachi azụ nʼIjipt,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:5"
      },
      "items": [
        {
          "text": "Asịrịa ọ gaghị abụ eze ha,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:5"
      },
      "items": [
        {
          "text": "nʼihi na ha ajụla ịlọghachikwute m?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.5",
            "verseOrgIds": [
              "HOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mma agha ga-efegharị nʼobodo ha niile,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:6"
      },
      "items": [
        {
          "text": "ọ ga-eripịa ndị nchụaja na-agba afa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:6"
      },
      "items": [
        {
          "text": "ọ ga-eripịakwa nzube ọjọọ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.6",
            "verseOrgIds": [
              "HOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị m ekpebiela nʼobi ha ịhapụ m.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:7"
      },
      "items": [
        {
          "text": "Nʼagbanyeghị na ha na-akpọ m Chineke nke kachasị ihe niile elu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:7"
      },
      "items": [
        {
          "text": "ma mụ onwe m agaghị ebuli ha elu nʼụzọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.7",
            "verseOrgIds": [
              "HOS.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"M ga-esi aṅaa rara gị nye, gị Ifrem?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "M ga-esi aṅaa rara gị nye, gị Izrel?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "M ga-esi aṅaa mee gị ka ịdị ka Adma?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "M ga-esi aṅaa meso gị dịka Zeboiim?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "Obi m na-akwasị akwa ike nʼime m;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:8"
      },
      "items": [
        {
          "text": "ọ na-agụsị m agụụ ike inyere unu aka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaghị m emezu iwe ọkụ m",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "maọbụ bibiekwa Ifrem ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Nʼihi na abụ m Chineke, abụghị m mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Abụ m Onye Nsọ na-ebi nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:9"
      },
      "items": [
        {
          "text": "Agaghị m emegidekwa obodo ha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha ga-agbaso",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.11.10",
                "verseOrgIds": [
                  "HOS.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "Ọ ga-agbọkwa ụja dịka ọdụm.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "Mgbe ọ gbọrọ ụja,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 11:10"
      },
      "items": [
        {
          "text": "ụmụ ya ga-eji ịma jijiji site nʼakụkụ ọdịda anyanwụ bịakwute ya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
