        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.1",
                "verseOrgIds": [
                  "HOS.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nke bịakwutere Hosiya nwa Beiri nʼoge Uzaya, na Jotam, na Ehaz, na Hezekaya, bụ ndị eze Juda, na nʼoge Jeroboam nwa Jehoash bụ eze nʼIzrel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwunye Hosiya na ụmụ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mmalite okwu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼọnụ Hosiya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Hosiya sị, \"Gaa lụtara onwe gị nwanyị na-akwa iko na ụmụ amụtara nʼịkwa iko, nʼihi na dịka nwanyị alụrụ alụ nʼakwa iko, ala a na-akwa iko nke ukwu site nʼịgbahapụ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.2",
                "verseOrgIds": [
                  "HOS.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ gara lụọ Goma nwa Diblaim, onye tụụrụ ime mụọra ya nwa nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.4",
                "verseOrgIds": [
                  "HOS.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ya, \"Aha ị ga-agụ nwantakịrị ahụ bụ Jezril. Nʼihi na tupu nwa oge nta agafee, aga m ata ezinaụlọ Jehu ahụhụ nʼihi ọbara ọ wụsiri na Jezril. Aga m eme ka alaeze nke ụlọ Izrel kwụsị.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, aga m agbaji ụta Izrel na Ndagwurugwu Jezril.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Goma tụụrụ ime ọzọ, mụta nwa nwanyị. Ọ gwara ya, \"Aha ị ga-agụ ya bụ Lo-Ruhama,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "text": "nʼihi na agaghị m enwekwa obi ebere ọzọ nʼahụ ụlọ Izrel, ịgbaghara ha mmehie ha.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m enwe obi ebere nʼahụ ụlọ Juda. Mụ onwe m ga-azọpụta ha site na",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.7",
                "verseOrgIds": [
                  "HOS.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ha. Agaghị m eji ngwa agha ọbụla, dịka ụta maọbụ mma agha maọbụ ike ibu agha maọbụ ịnyịnya maọbụ ndị na-agba ịnyịnya zọpụta ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ jụrụ Lo-Ruhama ara, ọ tụụrụ ime ọzọ, mụọ nwa nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.1.9",
                "verseOrgIds": [
                  "HOS.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Kpọọ aha ya Lo-ammi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "text": "nke pụtara unu abụghị ndị m, nʼihi na unu abụghị ndị nke m, mụ onwe m abụkwaghị Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọnụọgụgụ ụmụ Izrel ga-adị ka aja dị nʼọnụ oke osimiri nke a na-apụghị ịgụta ọnụ maọbụ tụọ nʼihe ọtụtụ. Nʼebe ahụ a nọ sị ha, 'Unu abụghị ndị m,' nʼebe ahụ ka a ga-anọ sịkwa ha, 'Ụmụ Chineke dị ndụ ka unu bụ.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-achịkọtakwa ndị Juda na ndị Izrel ọnụ. Ha ga-ahọpụtakwara onwe ha otu onyeisi, si nʼala ahụ rigopụta, nʼihi ihe ukwu ka ụbọchị Jezril ga-abụ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.2.2"
            ]
          }
        }
      ]
    }
  ],
