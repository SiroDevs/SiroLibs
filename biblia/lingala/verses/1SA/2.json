        "style": "c",
        "sid": "1SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Losambo ya Ana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana asambelaki na maloba oyo :",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Motema na ngai ezali kosepela mpo na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "mpo ete alendisi bomoi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Wana nazali na esengo mpo ete okangoli ngai,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "monoko na ngai ekotelemela banguna na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moko te azali bule lokola Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "moko te, bobele Yo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "Libanga moko te ezali lokola Nzambe na biso.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolobaloba maloba ebele te ya lolendo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "mpe tika ete lofundu ebima na monoko na bino te,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "pamba te Yawe azali Nzambe oyo ayebi nyonso",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "mpe asambisaka misala nyonso ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolotolo ya bilombe ebukani,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:4"
      },
      "items": [
        {
          "text": "kasi bato na bolembu bazwi makasi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bazalaki na bozwi ebele",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "bakomi koluka mosala mpo na bilei,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "kasi ba-oyo bazalaki kokelela batiki kosala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "Mwasi oyo abotaki te akobota mbala sambo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "kasi mwasi oyo abotaki bana ebele akobota lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe abomaka mpe apesaka bomoi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:6"
      },
      "items": [
        {
          "text": "akitisaka bato na mokili ya bakufi mpe asekwisaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akomisaka moto mobola,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:7"
      },
      "items": [
        {
          "text": "mpe akomisaka moto mozwi ;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:7"
      },
      "items": [
        {
          "text": "akitisaka mpe atombolaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alongolaka mobola na putulu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "mpe abimisaka na fulu moto oyo azanga ;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "mpo ete avandisa bango esika moko na bato ya lokumu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "mpe apesa bango kiti ya lokumu lokola libula.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "Pamba te miboko ya mabele ezali ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "mpe ezali na likolo na yango nde atia mokili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akobatelaka makolo ya babulami na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "kasi bato mabe bakobunga kati na molili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "Moto akotikala kolonga te na makasi na ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo batiaka tembe na Yawe bakopanzana,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "pamba te akokweyisela bango kake wuta na likolo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Yawe akosambisa mokili mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "akopesa mokonzi na yango nguya",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "mpe akobakisa makasi ya mopakolami na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Elikana azongaki na ndako na ye, na Rama ; kasi mwana atikalaki mpo na kosalela Yawe na bokambami ya Nganga-Nzambe Eli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mabe ya bana mibali ya Eli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana mibali ya Eli bazalaki kilikili, bayebaki Yawe te.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge nini Banganga-Nzambe oyo bazalaki kosala na miso ya bato : tango nyonso moto moko azalaki koya kobonza mbeka, mosali ya Nganga-Nzambe azalaki koya na ngonga ya kotumba mbeka yango, azalaki kosimba kanya ya misapi misato na loboko na ye,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "azalaki kokotisa yango na sani, na nzungu, na kikalungu to na mbeki ; mpe azalaki kokamata, mpo na Nganga-Nzambe, eteni nyonso ya nyama oyo ezalaki kokangama na kanya. Ezali ndenge wana nde bana mibali ya Eli bazalaki kosala epai ya bana nyonso ya Isalaele oyo bazalaki kokende kuna na Silo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutu, liboso ete mafuta ya mbeka etumbama, mosali ya Nganga-Nzambe azalaki koya koloba na moto oyo azalaki kobonza mbeka : « Longolaka libela eteni ya Nganga-Nzambe, pamba te akondima te kozwa na maboko na yo nyama oyo yo moko otumbi ; kasi akondima kaka nyama ya mobesu. »",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo soki moto yango azongiseli mosali ya Nganga-Nzambe : « Tika ete mafuta etumbama nanu, bongo okozwa, na sima, eteni oyo olingi, » mosali azalaki kozongisa : « Te ! Pesa ngai yango nde sik'oyo, noki te nakozwa yango na makasi. »",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisumu oyo ya bana mibali ya Eli ezalaki monene na miso ya Yawe, pamba te bazalaki kozwa na limemia te mbeka oyo ebonzami mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samuele mpe baboti na ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Samuele azalaki kosala mosala na ye liboso ya Yawe. Elenge mobali Samuele azalaki kolata efode ya lino.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mibu nyonso, mama na ye azalaki kotongela ye nzambala ya moke, mpe azalaki komemela ye yango tango nyonso azalaki kokende elongo na mobali na ye mpo na kobonza mbeka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.19",
            "verseOrgIds": [
              "1SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli azalaki kopambola Elikana mpe mwasi na ye na maloba oyo : « Tika ete Yawe apesa yo bana na nzela ya mwasi oyo, mpo na kozwa esika ya mwana oyo asengaki na mabondeli mpe abonzaki epai na Yawe ! »",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 2:20"
      },
      "items": [
        {
          "text": "Sima na yango, bazongaki epai na bango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe asalelaki Ana ngolu, mpe Ana azwaki lisusu bazemi, abotaki bana mibali misato mpe bana basi mibale. Nzokande elenge mobali Samuele azalaki kokola liboso ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eli mpe bana na ye ya mibali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli akomaki mobange makasi, mpe azalaki koyoka makambo nyonso oyo bana na ye ya mibali bazalaki kosala epai ya bana nyonso ya Isalaele ; azalaki mpe koyoka ete bazalaki kosangisa nzoto na basi oyo bazalaki kosala na ekotelo ya Ndako ya kapo ya Bokutani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki na bango : « Mpo na nini bozali kosala makambo mabe boye ? Nazali koyoka bato nyonso kolobela yango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te, bana na ngai ! Sango oyo nazali koyoka bato ya Yawe kopanza na tina na bino ezali malamu te.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te soki moto asali moninga na ye mabe, Nzambe akosambisa ye ; kasi soki moto asali lisumu epai na Yawe, nani akoloba mpo na ye ? »",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 2:25"
      },
      "items": [
        {
          "text": "Kasi bana batikalaki koyokela tata na bango te, pamba te ezalaki mokano ya Yawe mpo na koboma bango.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elenge mobali Samuele akobaki kokola na nzoto, mpe azalaki kosepelisa Yawe mpe bato.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etumbu mpo na Eli mpe libota na ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, moto moko na Nzambe ayaki epai ya Eli mpe alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "1SA 2:27"
      },
      "items": [
        {
          "text": "— Tala liloba oyo Yawe alobi : « Boni, namimonisaki te na polele epai ya libota ya tata na yo tango bazalaki na Ejipito, na se ya bokonzi ya Faraon ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naponaki tata na yo kati na bikolo nyonso ya Isalaele mpo ete asalela Ngai lokola Nganga-Nzambe, mpo ete amata na etumbelo na Ngai, atumba mbeka ya malasi mpe alata efode liboso na Ngai. Napesaki lisusu, na libota ya tata na yo, makabo nyonso ya bana ya Isalaele, makabo oyo bazikisa na moto.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo mpo na nini bozali kozwa na limemia te bambeka mpe makabo na Ngai, oyo napeselaki mitindo ete epesama kati na Ndako na Ngai ? Mpo na nini ozali kopesa bana na yo ya mibali lokumu koleka Ngai, na ndenge bozali kolia biteni oyo eleki kitoko kati na bambeka oyo bato na Ngai, Isalaele, bazali kobonzela Ngai ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola ezali bongo, tala makambo oyo Ngai Yawe, Nzambe ya Isalaele, nalobi : ‹ Nalakaki ete libota na yo mpe libota ya tata na yo bakosalela Ngai tango nyonso lokola Banganga-Nzambe. › Kasi sik'oyo, Ngai Yawe nalobi : ‹ Esili ! Mosika na Ngai elaka oyo ! Bato oyo bazali kopesa Ngai lokumu, bango kaka nde Ngai nakopesa lokumu ; kasi ba-oyo bazali kotiola Ngai, nakoyokisa bango soni.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe na mikolo oyo ezali koya, nakokomisa mikolo na yo mpe ya libota na yo mikuse, mpe mobange akotikala kozala lisusu te kati na molongo ya libota na yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atako bakosalela Isalaele bolamu, kasi yo okomona pasi kati na Ndako na Ngai ; mpe mobange akotikala kozala lisusu te kati na molongo ya libota na yo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, kati na bato na yo, ekozala na moto moko oyo nakolongola te liboso ya etumbelo na Ngai, mpo ete obanda koyokelaka ye zuwa mpe obanda kozikaka motema ; kasi bana nyonso oyo bakobotama na ndako na yo bakokufa na bolenge na bango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe makambo oyo ekokweyela bana na yo mibale ya mibali, Ofini mpe Fineasi, ekozala elembo mpo na yo : bango mibale bakokufa mokolo moko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakomiponela Nganga-Nzambe ya sembo oyo akosala kolanda motema mpe makanisi na Ngai. Nakobongisela ye libota moko oyo ekowumela, mpe akosala tango nyonso mosala ya bonganga-Nzambe liboso ya mopakolami na Ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo moto nyonso oyo akotikala kati na libota na yo akobanda koya kofukama liboso na ye mpo na kozwa mbongo moko ya palata mpe eteni ya lipa, mpe akoloba : ' Kotisa ngai ata na mosala moko kati na misala ya bonganga-Nzambe mpo ete nazwaka ata eteni ya lipa. ' › »",
          "type": "text"
        }
      ]
    }
  ],
