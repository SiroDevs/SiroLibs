              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ewutaki epai na Yawe mpe etumbaki bato nkama mibale na tuku mitano oyo bazalaki kobonza malasi ya ansa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
