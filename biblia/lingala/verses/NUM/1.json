          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na bakitani ya Gadi :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        }
