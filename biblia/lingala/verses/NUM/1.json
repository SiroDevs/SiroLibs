        },
        {
          "text": "Okopesa na bato ya libota ya Levi mokumba ya Mongombo ya Litatoli mpe ya bisalelo na yango nyonso elongo na biloko nyonso oyo ezalaka kati na Mongombo. Bango bakozwa mokumba ya komemaka yango elongo na bisalelo na yango mpe bakovanda zingazinga na yango.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.50",
            "verseOrgIds": [
              "NUM.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
