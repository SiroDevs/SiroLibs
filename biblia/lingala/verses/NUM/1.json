          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ya Isalaele bakotelemisa bandako na bango ya kapo kolanda milongo na bango ya mampinga, mpe moto na moto akozala kati na molako na ye, na se ya bendele na ye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.52",
            "verseOrgIds": [
              "NUM.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
