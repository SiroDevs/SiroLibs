    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali bango nde baponamaki kati na lisanga : bazalaki bakambi ya mabota na bango, bakambi ya mampinga ya Isalaele.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyize mpe Aron bakamataki bato oyo baponamaki na bakombo mpo ete basala na bango elongo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basangisaki lisanga mobimba na mokolo ya liboso, na sanza ya mibale ; boye bana ya Isalaele batalisaki bokoko na bango kolanda mabota na bango mpe bituka na bango. Bakomaki bakombo ya mibali nyonso oyo bazalaki na mibu tuku mibale mpe koleka, mobali moko na moko na kombo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndenge Yawe atindaki Moyize oyo atangaki motango na bango na esobe ya Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na bakitani ya Ribeni, mwana mobali ya liboso ya Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NUM 1:20"
      },
      "items": [
        {
          "text": "bakomaki bakombo ya bato nyonso oyo bazalaki na mibu tuku mibale mpe koleka, oyo bazalaki na makoki ya kosala mosala ya soda, moto na moto kolanda libota na ye mpe etuka na ye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motango na bango nyonso oyo batangamaki kati na libota ya Ribeni ezalaki nkoto tuku minei na motoba na nkama mitano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
