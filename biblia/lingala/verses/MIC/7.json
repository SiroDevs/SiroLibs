  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MIC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pasi ya Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, mawa na ngai !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "Nakomi lokola moto oyo azali koluka kobuka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "bambuma na eleko ya elanga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "na tango oyo bazongelaka kobuka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "bambuma ya vino oyo etikalaka.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "Kasi ezali ata na liboke moko te",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "ya bambuma ya vino ya kolia",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "to mbuma ata moko te ya figi ya sika oyo nasepelaka kolia.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayengebene batikali lisusu te na mokili,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "moto ya sembo azali lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "bato nyonso bakomi kaka koluka nzela ya kosopa makila,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "mpe moto na moto azali kotiela ndeko na ye motambo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maboko na bango eyebi penza kosala makambo mabe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "bakambi mpe basambisi na bango bakomi koluka kanyaka ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "bongo bato ya makasi bazali kosala makambo nyonso oyo balingi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "bayokanaka mpo na kosala bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo aleki malamu kati na bango",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "azali lokola nzube,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "moto oyo aleki sembo azali mabe koleka liboke ya basende.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Mokolo oyo bakengeli na yo basakolaki ekokisami,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "mokolo oyo Yawe ayei kopesa yo etumbu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Sik'oyo, ekomi tango na bango ya koyoka soni.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Botia motema te epai ya bazalani na bino,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "botia elikya te epai ya baninga na bino ya motema.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "Ezala liboso ya mwasi oyo alalaka na tolo na yo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "keba na maloba oyo ezali kobima na monoko na yo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te mwana mobali azali koyokisa tata na ye soni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "elenge mwasi azali kotelemela mama na ye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "mwasi ya libala azali kotelemela mama-bokilo na ye ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "bongo monguna ya moto, ezali kaka moto ya libota na ye.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi mpo na ngai, nakotia elikya na ngai epai na Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "nakotalela Nzambe, Mobikisi na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "Nzambe na ngai akoyoka ngai.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaele akotelema lisusu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh banguna na ngai, boseka ngai te !",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Ata soki nakweyi, nakotelema kaka.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Ata soki navandi kati na molili,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Yawe azali pole na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola nasalaki masumu liboso ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "nakomema mokumba ya kanda na Ye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "kino tango akozwa likambo na ngai na maboko",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "mpe akolongisa ngai.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "Akobimisa ngai na pole,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "mpe nakomona bosembo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
