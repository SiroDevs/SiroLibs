          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo apesaki mitindo mpo na kotonga Tempelo ya Yawe mpe ndako ya mokonzi mpo na ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.18",
            "verseOrgIds": [
              "2CH.1.18"
            ]
          }
        }
      ]
    }
  ],
