      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:36"
      },
      "items": [
        {
          "text": "Betseri lokola engumba ya kokimela mpo na moto oyo atangami mobomi, Yakatsi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
