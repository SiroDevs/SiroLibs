          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epai ya bituka ya Merari, bakitani ya Levi oyo batikalaki, bapesaki bingumba oyo :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 21:34"
      },
      "items": [
