    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 21:38"
      },
      "items": [
        {
          "text": "Ramoti, kati na Galadi, lokola engumba ya kokimela mpo na moto oyo atangami mobomi, Maanayimi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
