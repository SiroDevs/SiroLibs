          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedemoti mpe Mefati, elongo na mabele na yango ; ezalaki bongo bingumba minei.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.37",
            "verseOrgIds": [
              "JOS.21.37"
            ]
          }
