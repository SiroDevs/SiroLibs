          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali mpo na Nzambe nde bozali kati na Yesu-Klisto oyo akomaki, mpo na biso, bwanya kowuta na Nzambe, bosembo, libulisi mpe kokangolama,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.30",
            "verseOrgIds": [
              "1CO.1.30"
            ]
          }
        },
        {
          "name": "verse",
