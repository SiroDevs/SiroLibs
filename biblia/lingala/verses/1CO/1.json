              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe aponaki biloko ezanga tina, biloko ya kotiola, biloko oyo ezalaka te, mpo na kokomisa pamba biloko oyo mokili epesaka tina,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
