              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete, kolanda ndenge ekomama,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
