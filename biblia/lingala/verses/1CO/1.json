          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete moto ata moko te amikumisa liboso ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
            ]
          }
