          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozalaka libaku te, ezala mpo na Bayuda, mpo na Bagreki to mpo na Lingomba ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
              "1CO.10.32"
            ]
          }
