              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, ezala kolia to komela, nyonso oyo bokoki kozala kosala, bosalaka nyonso mpo na lokumu ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.31",
            "verseOrgIds": [
              "1CO.10.31"
            ]
          }
        }
