{
  "id": "ECC.5",
  "number": "5",
  "bookId": "ECC",
  "reference": "Mosakoli 5",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ECC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kokisaka ndayi na yo epai ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kowelela te kofungola monoko na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:1"
      },
      "items": [
        {
          "text": "mpe tika ete motema na yo ewelela te",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:1"
      },
      "items": [
        {
          "text": "kobimisa liloba liboso ya Nzambe !",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:1"
      },
      "items": [
        {
          "text": "Pamba te Nzambe azali na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:1"
      },
      "items": [
        {
          "text": "mpe yo ozali na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:1"
      },
      "items": [
        {
          "text": "Boye, tika ete maloba na yo ezalaka mingi te !",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge ndoto eyaka soki moto azali na misala mingi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:2"
      },
      "items": [
        {
          "text": "ndenge wana mpe maloba ebele ebimisaka bozoba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki olapi ndayi liboso ya Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:3"
      },
      "items": [
        {
          "text": "kowumela te mpo na kokokisa yango ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:3"
      },
      "items": [
        {
          "text": "pamba te Nzambe asepelaka na bazoba te ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:3"
      },
      "items": [
        {
          "text": "kokisa ndayi na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleki malamu ete olapa na yo kutu ndayi te na esika ya kolapa ndayi mpe ozanga kokokisa yango.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.4",
            "verseOrgIds": [
              "ECC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotika te ete monoko na yo ememisa yo masumu, mpe kokende koloba te liboso ya basali ya Nzambe : « Ndayi na ngai ezalaki libunga. » Mpo na nini Nzambe atomboka mpo na maloba na yo mpe abebisa misala ya maboko na yo ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
              "ECC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndoto ebele mpe maloba ebele ezali kaka pamba ; yango wana tosa nde Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bomengo ezali pamba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki omoni ete bazali konyokola mobola kati na mokili, bongo boyengebene mpe bosembo etiolami, kokamwa likambo yango te ; pamba te mokambi moko azali na se ya mokambi mosusu ; mpe na likolo na bango mibale, ezali na bakonzi mosusu oyo baleki na bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biloko oyo mabele ebotaka ezali mpo na bolamu ya bato nyonso ; ezala mokonzi, abikaka mpe na mbuma ya bilanga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo alingaka mbongo atondaka yango te, mpe moto oyo alingaka bomengo, bozwi na ye etondisaka ye te. Wana mpe ezali kaka pamba.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge bozwi ya moto ekomaka ebele,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:10"
      },
      "items": [
        {
          "text": "ndenge wana mpe bato oyo baliaka yango bakomaka ebele ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:10"
      },
      "items": [
        {
          "text": "bongo litomba nini nkolo na yango akozwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:10"
      },
      "items": [
        {
          "text": "soki kaka te komona yango na miso ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pongi ya mosali ezalaka ya kimia,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:11"
      },
      "items": [
        {
          "text": "ata soki alie moke to mingi ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:11"
      },
      "items": [
        {
          "text": "kasi bomengo ya mozwi ezangisaka ye pongi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoni mabe moko na se ya moyi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:12"
      },
      "items": [
        {
          "text": "epesaka penza mawa :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:12"
      },
      "items": [
        {
          "text": "moto abombi bomengo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:12"
      },
      "items": [
        {
          "text": "kasi ememeli ye pasi ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "likambo moko ya mabe ya mbalakata",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:13"
      },
      "items": [
        {
          "text": "ebebisi bomengo yango,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:13"
      },
      "items": [
        {
          "text": "mpe mwana na ye azangi libula ya kokitana na yango.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge abotamaki bolumbu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:14"
      },
      "items": [
        {
          "text": "wuta na libumu ya mama na ye,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:14"
      },
      "items": [
        {
          "text": "ndenge mpe akozanga bolumbu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:14"
      },
      "items": [
        {
          "text": "akomema ata mbuma moko te ya mosala na ye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo mpe ezali lisusu pasi oyo epesaka mawa :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:15"
      },
      "items": [
        {
          "text": "ndenge moto ayaki, ndenge mpe akozonga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:15"
      },
      "items": [
        {
          "text": "Bongo litomba na ye ezali nini ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:15"
      },
      "items": [
        {
          "text": "Asali kaka mpo na mopepe ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alekisi mikolo nyonso ya bomoi na ye kati na molili,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:16"
      },
      "items": [
        {
          "text": "na pasi, na komitungisa mpe na kanda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, tala likambo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:17"
      },
      "items": [
        {
          "text": "oyo ngai namoni ete ezali malamu :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:17"
      },
      "items": [
        {
          "text": "ebongi na moto kolia, komela",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:17"
      },
      "items": [
        {
          "text": "mpe kosepela na mbuma ya mosala na ye na se ya moyi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:17"
      },
      "items": [
        {
          "text": "na mikolo ya bomoi oyo Nzambe apesi ye,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:17"
      },
      "items": [
        {
          "text": "pamba te yango nde libula na ye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutu, epai na moto nyonso oyo Nzambe apesi bomengo mpe biloko ebele, bongo apesi ye lisusu makoki ya kosalela yango, ya kozwa libula na ye mpe ya kosepela na mbuma ya mosala na ye, wana ezali penza likabo ya Nzambe !",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.18",
            "verseOrgIds": [
              "ECC.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, wana Nzambe akotondisa motema na ye na esengo, moto yango akosala keba te na motango ya mikolo ya bomoi na ye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.19",
            "verseOrgIds": [
              "ECC.5.19"
            ]
          }
        }
      ]
    }
