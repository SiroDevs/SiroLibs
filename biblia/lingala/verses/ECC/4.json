  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ECC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Minyoko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natalaki lisusu mpe namonaki minyoko nyonso oyo ezali na se ya moyi :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "Namonaki mpinzoli ya banyokolami,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "mpe moto akobondisa bango azalaki te ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "nguya ezalaki na ngambo ya banyokoli,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "mpe moto akobondisa bango azalaki te.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, namonaki ete bato oyo basila kokufa kala",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "bazali na bango kutu malamu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "koleka bato oyo bazali nanu na bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe moto oyo atikala nanu kozala te",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "azali malamu koleka bango mibale,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "pamba te atikala nanu komona te misala mabe",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "oyo esalemaka na se ya moyi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mosala mpe makama na yango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoni ete pasi nyonso oyo bato bamonaka na mosala mpe lokumu oyo bazwaka na misala na bango, ewutaka kaka na bilulela ya moto liboso ya moninga na ye. Wana mpe ezali pamba, ezali lokola moto azali kolanda mopepe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo azangi mayele akangaka maboko na ye",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:5"
      },
      "items": [
        {
          "text": "mpe amibebisaka ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loboko moko oyo etondi na kimia ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "koleka maboko mibale oyo etondi na misala makasi",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "mpe na kolanda mopepe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezali mabe mpo na moto kovanda ye moko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namonaki lisusu likambo mosusu ya pamba na se ya moyi :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.7",
            "verseOrgIds": [
              "ECC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki na moto moko oyo azalaki kaka ye moko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "azalaki ata na mwana to ndeko te ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "azalaki kopema te na mosala na ye ya makasi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "kasi bomengo na ye etikalaki te kotondisa miso na ye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Mpe atikalaki komituna te :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "« Nani oyo ngai nazali komonela pasi boye ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Mpe mpo na nini nazali komipimela bomengo ? »",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Wana mpe lisusu ezali pamba :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "ezali mosala ya mpunda !",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato mibale bazali malamu koleka moto moko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:9"
      },
      "items": [
        {
          "text": "pamba te bakozwa lifuti ya malonga na mosala na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moko akweyi, moninga na ye akoki kosunga ye ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "kasi mawa na moto oyo akweyi",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "mpe azangi moto oyo akosunga ye !",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe lisusu, soki bato mibale balali esika moko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:11"
      },
      "items": [
        {
          "text": "bayokaka moto ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:11"
      },
      "items": [
        {
          "text": "kasi moto oyo azali ye moko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:11"
      },
      "items": [
        {
          "text": "ndenge nini akoki koyoka moto ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki moto azali ye moko, monguna akoki kolonga ye ;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "kasi soki bato bazali mibale, bakoki kotelemela monguna.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "Kamba ya basinga misato ekatanaka noki te.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
