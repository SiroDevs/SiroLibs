      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:28"
      },
      "items": [
        {
          "text": "kasi namoni ata mwasi moko te ya sembo kati na basi nyonso !",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
