          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosakoli alobi : « Tala makambo oyo nasosoli sima na koyekola mwasi moko na moko mpo na kozwa mayele :",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        }
      ]
    },
