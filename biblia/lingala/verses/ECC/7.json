      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "kaka mobali oyo asalaka masumu nde akokangama na motambo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
