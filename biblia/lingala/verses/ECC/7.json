      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 7:26"
      },
      "items": [
        {
          "text": "mwasi oyo motema na ye ezali",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        }
      ]
    },
