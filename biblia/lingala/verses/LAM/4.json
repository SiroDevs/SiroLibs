          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilongi na bango ekomi mwindo koleka makala,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "bazali koyeba bango lisusu te na babalabala ;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "poso na bango ya nzoto ekangami na mikuwa,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:8"
      },
      "items": [
        {
          "text": "ekawuki lokola koni.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.8",
            "verseOrgIds": [
              "LAM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LAM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bakufi na mopanga bazali malamu",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "koleka ba-oyo bakufi na nzala :",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "banzulukaka mpe bakondaka makasi mpo na nzala,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:9"
      },
      "items": [
        {
          "text": "mpo na kozanga bilei kowuta na bilanga.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.9",
            "verseOrgIds": [
              "LAM.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LAM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ya mitema malamu balambi,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.10",
            "verseOrgIds": [
              "LAM.4.10"
            ]
          }
        }
      ]
