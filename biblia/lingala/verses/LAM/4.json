          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ya bakonzi na bango bazalaki",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "kongala koleka mvula ya pembe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "pembe koleka miliki ;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "banzoto na bango ezalaki motane",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "koleka langi ya motane penza,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "mpe lolenge na bango ezalaki",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:7"
      },
      "items": [
        {
          "text": "lokola libanga na safiri.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.7",
            "verseOrgIds": [
              "LAM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
