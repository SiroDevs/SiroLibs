{
  "id": "SNG.5",
  "number": "5",
  "bookId": "SNG",
  "reference": "Loyembo ya Salomo 5",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "SNG 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mobali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh molingami na ngai, mwasi na ngai ya motema ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nayei na elanga na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nayei kobuka mbuma na ngai oyo basalelaka malasi ya mire,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nayei kobuka biloko na ngai ya mike-mike ya solo kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nayei kolia mafuta na ngai ya nzoyi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "nayei komela vino mpe miliki na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Baninga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Oh baninga, bolia mpe bomela na bino,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "bomela mpe bolangwa na bino, balingami na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Elenge mwasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalalaki, kasi makanisi na ngai ezalaki ya kolamuka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Yoka ! Mongongo ya molingami na ngai",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "ezali koyokana na ekuke !",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Elenge mobali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "« Molingami na ngai, mwasi na ngai ya motema,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "ebenga na ngai, oyo azali kitoko koleka mpo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "fungolela ngai ndako,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "pamba te moto na ngai etondi na londende,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "mpe suki na ngai epoli na matanga ya londende ya butu. »",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Elenge mwasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasili kolongola nzambala na ngai, nalata yango lisusu ?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "Nasili kosukola makolo na ngai, nabebisa yango lisusu ?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobali na ngai ya motema akotisi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:4"
      },
      "items": [
        {
          "text": "loboko na ye na lidusu ya ekuke,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:4"
      },
      "items": [
        {
          "text": "bongo motema na ngai ekomi kobeta mpo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natelemaki mpo na kokende kofungolela",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "mobali na ngai ya motema ndako,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "mpe maboko na ngai ebimisaki solo ya malasi ya mire,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "misapi na ngai etangisaki yango na bikangelo ya ndako.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafungolelaki mobali na ngai ya motema ndako,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "kasi akendeki na ye mpe alimwaki.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Nakweyaki mayanga wana azalaki koloba ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "nalukaki ye, kasi namonaki ye lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "nabengaki ye, kasi ayanolaki ngai te.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bakengeli ya mir bazalaki koleka-leka kati na engumba,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "bamonaki ngai, babetaki ngai, bazokisaki ngai",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "mpe balongolaki ngai vwale na moto.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh bilenge basi ya Yelusalemi, nabondeli bino,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "soki bomoni mobali na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "bokoloba na ye nini ?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "Boloba na ye ete nabeli maladi ya bolingo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Bilenge basi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh mwasi oyo aleki basi nyonso na kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "mobali na yo aleki mibali mosusu na nini ?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "Nini penza ya malonga oyo mobali na yo azali na yango,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
