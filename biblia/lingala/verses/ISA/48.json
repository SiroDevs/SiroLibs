  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "ISA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pamela mpe lobiko ya Isalaele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka makambo oyo, oh ndako ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "bino oyo bobengamaka na kombo ya Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "bino oyo bobimi na libota ya Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "bino oyo bolapaka ndayi na Kombo na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "mpe bobelelaka Kombo ya Nzambe ya Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:1"
      },
      "items": [
        {
          "text": "kasi na bosolo te mpe na bosembo te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.1",
            "verseOrgIds": [
              "ISA.48.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino oyo bomibengaka « Bato ya engumba mosantu »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "mpe bolukaka lisungi epai ya Nzambe ya Isalaele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:2"
      },
      "items": [
        {
          "text": "oyo Kombo na Ye ezali « Yawe, Mokonzi ya mampinga. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.2",
            "verseOrgIds": [
              "ISA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasakolaki makambo ya liboso wuta kala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "monoko na ngai nde ebimisaki yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "mpe nasalaki ete eyebana ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:3"
      },
      "items": [
        {
          "text": "nasalaki yango na pwasa mpe ekokisamaki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.3",
            "verseOrgIds": [
              "ISA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te nayebaki ndenge nini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "bozalaka bato ya mito makasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "bato oyo bazalaka na kingo lokola ebende",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:4"
      },
      "items": [
        {
          "text": "mpe oyo mbunzu na bango ezalaka lokola bronze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.4",
            "verseOrgIds": [
              "ISA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, nalobaki na yo makambo oyo wuta kala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "nayebisaki yo yango liboso ete ekokisama mpo oloba te :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "« Nzambe na ngai ya ekeko nde asali yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "elilingi na ngai ya nzete mpe ya ebende",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:5"
      },
      "items": [
        {
          "text": "nde apesaki mitindo ete esalema ! »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.5",
            "verseOrgIds": [
              "ISA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyokaki makambo oyo !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "Botala, yango nyonso ekokisami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "Boni, bokondima yango kaka te ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 48:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "Wuta sik'oyo, nakoyebisa yo makambo ya sika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "makambo oyo ebombama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:6"
      },
      "items": [
        {
          "text": "makambo oyo oyebi nanu te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.6",
            "verseOrgIds": [
              "ISA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekelami nde sik'oyo, ezali makambo ya kala te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "oyoka nanu yango te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "liboso ya mokolo ya lelo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "Boye, okoki koloba te :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:7"
      },
      "items": [
        {
          "text": "« Solo, nayoka sango na yango. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.7",
            "verseOrgIds": [
              "ISA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, oyoka yango nanu te mpe oyebi yango te ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "wuta kala, litoyi na yo ezalaka ya kokangama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "Solo, nayebi ete ozalaka mokosi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "babengaka yo motomboki",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:8"
      },
      "items": [
        {
          "text": "wuta na libumu ya mama na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.8",
            "verseOrgIds": [
              "ISA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na lokumu ya Kombo na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "nakolembisa kanda ya motema na Ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "mpo na lokumu na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "nakozongisa motema na Ngai sima mpo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 48:9"
      },
      "items": [
        {
          "text": "Yango wana, nakoboma yo te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.9",
            "verseOrgIds": [
              "ISA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, napetolaki yo,",
          "type": "text",
          "attrs": {
