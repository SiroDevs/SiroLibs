            "sid": "ISA 60:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Telema mpe ngenga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:1"
      },
      "items": [
        {
          "text": "pamba te pole na yo ezali koya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:1"
      },
      "items": [
        {
          "text": "mpe nkembo na Yawe etelemi na likolo na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.1",
            "verseOrgIds": [
              "ISA.60.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 60:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, molili ezipi mabele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "mpe molili makasi ezipi bato,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "kasi Yawe atelemi mpo na yo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:2"
      },
      "items": [
        {
          "text": "mpe nkembo na Ye emonani epai na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.2",
            "verseOrgIds": [
              "ISA.60.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 60:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikolo ekotambola na pole na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:3"
      },
      "items": [
        {
          "text": "mpe bakonzi bakotambola na kongenga ya pole na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.3",
            "verseOrgIds": [
              "ISA.60.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 60:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tombola miso zingazinga na yo mpe tala :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "Bango nyonso basangani mpe bazali koya epai na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "bana na yo ya mibali bawuti mosika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:4"
      },
      "items": [
        {
          "text": "mpe oyo ya basi, bamemi bango na maboko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.4",
            "verseOrgIds": [
              "ISA.60.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 60:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, okomona mpe okongenga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "motema na yo ekobeta mpe ekosepela ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "bomengo ya ebale ekoya epai na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:5"
      },
      "items": [
        {
          "text": "mpe bozwi ya bikolo ekoya epai na yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.5",
            "verseOrgIds": [
              "ISA.60.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 60:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashamo ebele ekotondisa mokili na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "bana ya shamo ya mokili ya Madiani mpe ya Efa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "Yango nyonso ekowuta na Saba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "ekomema wolo mpe malasi ya ansa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:6"
      },
      "items": [
        {
          "text": "mpe ekotatola masanzoli na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.6",
            "verseOrgIds": [
              "ISA.60.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 60:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibwele nyonso ya Kedari ekosangana epai na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "bameme ya mibali ya Nebayoti ekosalela yo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "ekondimama lokola mbeka na likolo ya etumbelo na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "mpe nakongengisa Tempelo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:7"
      },
      "items": [
        {
          "text": "na nzela ya nkembo na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.7",
            "verseOrgIds": [
              "ISA.60.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
