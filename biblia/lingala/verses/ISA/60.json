          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapaya bakotonga lisusu bamir na yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
