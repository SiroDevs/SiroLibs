      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:8"
      },
      "items": [
        {
          "text": "lokola bibenga epai ya babokoli na yango ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.8",
            "verseOrgIds": [
              "ISA.60.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 60:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, bisanga ekotalela Ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.9",
            "verseOrgIds": [
              "ISA.60.9"
            ]
          }
        }
      ]
