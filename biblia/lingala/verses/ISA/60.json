      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "mpe bakonzi na bango bakosalela yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "Ezala nabetaki yo na kanda na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:10"
      },
      "items": [
        {
          "text": "kasi nakoyokela yo mawa na ngolu na Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.10",
            "verseOrgIds": [
              "ISA.60.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 60:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikuke na yo ekozala tango nyonso efungwama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "ekotikala kokangama te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 60:11"
      },
      "items": [
        {
          "text": "ezala na moyi to na butu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.60.11",
            "verseOrgIds": [
              "ISA.60.11"
            ]
          }
