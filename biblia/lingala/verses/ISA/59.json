    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisumu, koyambola mpe kosikolama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, loboko na Yawe ezali mokuse te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:1"
      },
      "items": [
        {
          "text": "mpo na kobikisa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:1"
      },
      "items": [
        {
          "text": "litoyi na Ye ekangama te mpo na koyoka !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.1",
            "verseOrgIds": [
              "ISA.59.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ezali bambeba na bino nde ekaboli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "bino na Nzambe na bino,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "ezali masumu na bino nde esali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "ete abombela bino elongi na Ye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:2"
      },
      "items": [
        {
          "text": "mpo ete ayoka bino te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.2",
            "verseOrgIds": [
              "ISA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te maboko na bino ebebi na makila,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "mpe misapi na bino ebebi na makambo mabe ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "bibebu na bino ezali koloba makambo ya lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:3"
      },
      "items": [
        {
          "text": "mpe minoko na bino ezali kobimisa makambo mabe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.3",
            "verseOrgIds": [
              "ISA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moko te azali kofunda makambo na bosolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "moko te azali kosamba na bosembo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "bazali kotia mitema na makambo ezanga tina",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "mpe bazali koloba lokuta ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "na mitema na bango, basalaka mabongisi ya kosala mabe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:4"
      },
      "items": [
        {
          "text": "mpe bakokisaka yango na misala na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.4",
            "verseOrgIds": [
              "ISA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali kopasola maki ya etupa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "mpe bazali kotonga ndako ya lifofe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "Moto nyonso oyo akolia maki na yango akokufa ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "mpe, soki apasoli liki moko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:5"
      },
      "items": [
        {
          "text": "ekobimisa etupa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.5",
            "verseOrgIds": [
              "ISA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basinga ya lifofe ekokoma bilamba te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "misala na bango ekobomba bango te ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "misala na bango ezali misala mabe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:6"
      },
      "items": [
        {
          "text": "mpe misala ya mobulu nde ezalaka na maboko na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.6",
            "verseOrgIds": [
              "ISA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matambe na bango epotaka mbangu mpo na kosala mabe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "mpe bazalaka mbangu mpo na kosopa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "makila ya moto oyo asali mabe te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "Makanisi na bango ezalaka kaka ya mabe ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:7"
      },
      "items": [
        {
          "text": "kobuka-buka mpe kobebisa nde ezalaka na nzela na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.7",
            "verseOrgIds": [
              "ISA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayebi nzela ya kimia te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "mpe bosembo ezali na nzela na bango te ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "bakomisaka nzela na bango nyoka-nyoka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "moko te oyo akotambola na nzela yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:8"
      },
      "items": [
        {
          "text": "akotikala koyeba kimia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.8",
            "verseOrgIds": [
              "ISA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana bosembo ezali mosika na biso,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "mpe solo ezali kokomela biso te ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "tozali kozela pole,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "kasi nyonso ezali kaka molili ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "toluki moyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 59:9"
      },
      "items": [
        {
          "text": "kasi tozali kaka kotambola na molili.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.9",
            "verseOrgIds": [
              "ISA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
