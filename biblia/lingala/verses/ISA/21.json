      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya kosambisa mokili ya Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba na Yawe na tina na esobe ya ebale monene :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "Ndenge mopepe makasi elekaka na somo na Negevi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "monguna moko azali koya wuta na esobe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:1"
      },
      "items": [
        {
          "text": "wuta na mokili moko ya somo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.1",
            "verseOrgIds": [
              "ISA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namonaki emoniseli moko ya somo :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Moteki baninga azali koteka baninga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "mobebisi azali kobebisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Elami, bundisa bango !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Medi, zingela bango !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:2"
      },
      "items": [
        {
          "text": "Nakosukisa kolela nyonso oyo ayeisaki na bato.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.2",
            "verseOrgIds": [
              "ISA.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, loketo na ngai ekomi na pasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "pasi moko ya makasi penza ekangi ngai",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "lokola mwasi oyo azali na pasi ya kobota.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "Makambo oyo nazali koyoka ezali kopesa ngai somo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:3"
      },
      "items": [
        {
          "text": "mpe oyo nazali komona ezali kosilisa ngai mayele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.3",
            "verseOrgIds": [
              "ISA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema na ngai ezali kobeta noki-noki,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "nakomi kolenga na somo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "mwa malili ya pokwa oyo nazelaka na esengo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:4"
      },
      "items": [
        {
          "text": "ekomeli ngai somo makasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.4",
            "verseOrgIds": [
              "ISA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesa ebongisami,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "batandi bilamba ya mesa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "bazali kolia mpe komela !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:5"
      },
      "items": [
        {
          "text": "Bino bakonzi ya basoda, bopakola banguba na bino mafuta !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.5",
            "verseOrgIds": [
              "ISA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Nkolo alobi na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "« Kende, tia mokengeli ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:6"
      },
      "items": [
        {
          "text": "mpe tika ete aloba makambo oyo akomona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.6",
            "verseOrgIds": [
              "ISA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki amoni shar oyo bampunda mibale ezali kobenda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "basoda oyo batambolaka likolo ya bampunda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "bamoko bamati likolo ya ba-ane,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "bamosusu bamati likolo ya bashamo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:7"
      },
      "items": [
        {
          "text": "tika ete asala keba, asala keba penza ! »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.7",
            "verseOrgIds": [
              "ISA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, mokengeli agangaki lokola nkosi :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "« Nkolo, mokolo mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "natelemaka na likolo ya ndako molayi ya kokengela ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:8"
      },
      "items": [
        {
          "text": "mpe butu nyonso, natikalaka kaka se wana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.8",
            "verseOrgIds": [
              "ISA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, moto moko azali koya awa na shar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "oyo bampunda mibale ezali kobenda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Azongisaki eyano :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "‹ Babiloni esili kokweya, ekweyi solo !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "Banzambe na yango nyonso ya bikeko elali-lali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:9"
      },
      "items": [
        {
          "text": "mpe epanzani na mabele ! › »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh bato na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 21:10"
      },
      "items": [
        {
