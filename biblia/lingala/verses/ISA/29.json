  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "ISA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawa mpe lobiko ya Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na yo, Arieli, Arieli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "engumba oyo Davidi azalaki kovanda !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "Bobakisa mibu na mibu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "mpe botika ete bafeti na bino ekoba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "kolandana ndenge ezalaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi nakonyokola Arieli ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "ekokoma na mawa mpe na kolela ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "ekokoma na miso na Ngai lokola etumbelo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakozingela yo mpo na kobundisa yo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "nakozingela yo na mir ya molayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "mpe nakotiela yo mampinga ya nguya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "mpo na kotelemela yo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okokitisama solo na se,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "okoloba wuta na mabele,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "mpe maloba na yo ekobanda kobima",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "na mongongo ya se wuta na putulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "Mongongo na yo ekokoma kobima wuta na se ya mabele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "lokola mongongo ya moto oyo asololaka na milimo ya bakufi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "mpe wuta na putulu, maloba na yo ekobima",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "na mongongo ya se.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo ebele ya banguna na yo bakokoma lokola putulu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "mpe ebele ya banyokoli na yo bakokoma lokola matiti ekawuka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "oyo ezali kopumbwa na mopepe ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "ekosalema bongo na pwasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Mokonzi ya mampinga, akoya epai na yo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "na nzela ya bakake, ya koningana ya mabele",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "mpe ya lokito monene, ya mopepe makasi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "mpe ya mvula ya moto oyo etumbaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekozala lokola ndoto to emoniseli ya butu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "mpo na ebele ya bikolo oyo bakobundisa Arieli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "oyo bakotelemela ye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "elongo na bandako na ye ya makasi mpe bakozingela ye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekozala lokola moto oyo azali na nzala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "bongo azali kolota ndoto ete azali kolia,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "kasi tango alamuki, libumu na ye ezali kaka pamba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "lokola moto oyo azali na posa ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "bongo azali kolota ndoto ete azali komela mayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "kasi tango alamuki na nzoto ya kolemba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "posa na ye ya mayi esili kaka te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "Ekozala nde bongo mpo na mampinga ya bikolo nyonso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "oyo bakobundisa ngomba Siona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bato ya mayele oyo bakufa miso mpe balangwaka masanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozanga maloba mpe bokamwa !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "Bomiboma miso mpe botikala bakufi miso !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "Bolangwa masanga, kasi na vino te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "Botenga-tenga, kasi na masanga ya makasi te !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe asopeli bino molimo ya pongi makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "akangi bino miso, bino basakoli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "azipi bino mito, bino bato oyo bomonaka makambo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na bino, emoniseli nyonso oyo ekomi lokola maloba ya buku oyo bakanga mpe bapesi epai ya moto oyo ayebi kotanga, bongo balobi na ye : « Nabondeli yo, tanga nanu buku oyo, » kasi azongisi : « Nakokoka te, pamba te buku ekangama. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To bapesi yango epai ya moto oyo ayebi kotanga te, mpe balobi na ye : « Nabondeli yo, tanga nanu buku oyo, » kasi azongisi : « Nayebi kotanga te. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo alobi :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "« Bato oyo bapusanaka pene na Ngai kaka na monoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "bapesaka Ngai lokumu kaka na bibebu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "kasi mitema na bango ezalaka mosika na Ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "mpe botosi oyo bazalaka na yango epai na Ngai",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "ezali kaka mobeko ya bomoto, oyo bateyaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, nakokoba kokamwisa bato oyo ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "ekozala nde bikamwa likolo ya bikamwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "kino bwanya ya bato ya bwanya ekobunga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "mpe mayele ya bato ya mayele ekosuka. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bozoba ya bato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na bato oyo basalaka makambo na nkuku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:15"
      },
      "items": [
        {
          "text": "mpo na kobombela Yawe mabongisi na bango ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:15"
      },
      "items": [
        {
          "text": "bato oyo basalaka misala na bango na molili",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:15"
      },
      "items": [
        {
          "text": "mpe balobaka : « Nani akoki komona biso ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:15"
      },
      "items": [
        {
          "text": "Nani akoyeba ? »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozali nde kobongola makambo !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "Ezali lokola bozali kozwa mosali mbeki",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "ndenge moko na mabele oyo basalelaka mbeki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "Boni, eloko ekoki solo koloba na mosali na yango :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "« Asalaki ngai te ? »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "Mbeki ekoki solo koloba na mosali mbeki :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:16"
      },
      "items": [
        {
          "text": "« Ozali mayele te ? »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyonso ekobongwana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etikali kaka tango moke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:17"
      },
      "items": [
        {
          "text": "Libani ekobongwana elanga ya kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:17"
      },
      "items": [
        {
          "text": "mpe elanga ya kitoko ekomonana lokola zamba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo wana, bakufi matoyi bakoyoka maloba ya buku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
              "ISA.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:18"
      },
      "items": [
        {
          "text": "mpe bakufi miso bakomona",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
              "ISA.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:18"
      },
      "items": [
        {
          "text": "tango bakobima na butu mpe na molili.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
              "ISA.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bakelela bakosepela makasi kati na Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.19",
            "verseOrgIds": [
              "ISA.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:19"
      },
      "items": [
        {
          "text": "babola bakozala na esengo kati na Mosantu ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.19",
            "verseOrgIds": [
              "ISA.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyokoli bakotikala lisusu te, batioli bakozala lisusu te",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:20"
      },
      "items": [
        {
          "text": "mpe bato oyo balukaka pasi ya baninga bakokufa :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na bato oyo bakweyisaka bato",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "kati na kosamba mpo na liloba moko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "elongo na bato oyo batielaka basambisi mitambo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "mpe bapesaka matatoli ya lokuta, na kosambisama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "mpo na kokweyisa moto ya sembo.",
          "type": "text",
          "attrs": {
