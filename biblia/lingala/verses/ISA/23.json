  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "ISA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya kosambisa Tiri mpe Sidoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloba na Yawe na tina na engumba ya Tiri :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Oh bamasuwa ya Tarsisi, bosala matanga !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Pamba te engumba ya Tiri esili kobebisama nyonso :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "ezala ndako to libongo, eloko moko te etikali !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Bazwaki sango oyo wuta na esanga ya Shipele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bavandi ya esanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "bino bato ya mombongo ya Sidoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "oyo nzela ya ebale ekomisa bazwi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "bovanda nye !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lifuti na ye ezalaki :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "ble ya Shiyori, oyo ezalaki koya na nzela ya ebale monene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "mpe milona oyo ezalaki kowuta pembeni ya Nili.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "Engumba ya Tiri ekomaki nde zando ya bikolo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoka soni, Sidoni, ndako batonga makasi ya ebale monene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "pamba te ebale monene elobi :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "« Natikala koyoka pasi ya kobota te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "natikala na ngai mpe kobota te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "natikala na ngai kobokola bana mibali",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "to kokolisa bana basi te. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango maloba yango ekokoma na Ejipito,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:5"
      },
      "items": [
        {
          "text": "bakolenga na somo wana bakoyoka sango ya Tiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokatisa na ngambo ya Tarsisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:6"
      },
      "items": [
        {
          "text": "bolela makasi, bino bavandi ya esanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, oyo nde engumba na bino ya bisengo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "engumba oyo ebanda kala penza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "mpe oyo makolo na yango ememaka yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "kowumela na mikili ya mosika ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani azwaki mokano oyo mpo na kobebisa Tiri ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "Tiri oyo azalaki kokabola mitole,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "oyo bato na ye ya mombongo bazalaki komimona lokola bakonzi ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "mpe oyo bato na ye ya nkita bazalaki komimona lokola bato",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "oyo baleki bato nyonso ya mokili na lokumu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Mokonzi ya mampinga, nde azwaki mokano yango",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "mpo na kosambwisa lolendo ya nkembo nyonso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "mpe kokitisa kino na se bato nyonso ya lokumu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "oyo bazali na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Tarsisi, mboka kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "koma kosala bilanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "ndenge basalaka pembeni ya ebale Nili,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "pamba te libongo ezali lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe asembolaki loboko na Ye na ebale monene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "mpe alengisaki bikolo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "apesaki mitindo na tina na mokili ya Fenisi",
          "type": "text",
          "attrs": {
