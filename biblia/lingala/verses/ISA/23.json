              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "alobaki : « Okosepela lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
