          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala mokili ya bato ya Chalide,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
