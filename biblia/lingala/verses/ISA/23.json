    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "yo Sidoni, mboka kitoko, yo oyo lokumu na yo esili kobebisama lelo !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "Telema, katisa na ngambo ya Shipele !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:12"
      },
      "items": [
        {
          "text": "Ezala kuna, okozwa bopemi te. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
