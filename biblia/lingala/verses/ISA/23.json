      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:13"
      },
      "items": [
        {
          "text": "mpe bakomisaki yango putulu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
