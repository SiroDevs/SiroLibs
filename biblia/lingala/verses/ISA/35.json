  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "ISA 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobima ya sika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete esobe mpe mabele ya kokawuka esepela !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "Tika ete esobe eyoka esengo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:1"
      },
      "items": [
        {
          "text": "mpe ebimisa fololo ya motane lokola roze !",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekobota fololo mingi penza mpe ekosepela,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "ekosepela mpe ekoganga na esengo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "Nkembo ya Libani, lokumu ya Karimeli",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "mpe ya Saroni ekopesamela yango ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "boye bakomona nkembo ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:2"
      },
      "items": [
        {
          "text": "lokumu ya Nzambe na biso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pesa makasi na maboko oyo elembi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:3"
      },
      "items": [
        {
          "text": "lendisa mabolongo oyo ezali kolenga ;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bato oyo bazali kobanga :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "« Bozala makasi, bobanga te,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "Nzambe na bino akoya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "akoya kozongisa mabe na mabe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "akoya na lifuti ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:4"
      },
      "items": [
        {
          "text": "Ye moko akoya kobikisa bino. »",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bakufi miso bakomona",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:5"
      },
      "items": [
        {
          "text": "mpe bakufi matoyi bakoyoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya tengu-tengu akopumbwa lokola mboloko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "mpe lolemo ya baba ekoyemba na esengo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "Mayi ekobima na esobe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:6"
      },
      "items": [
        {
          "text": "mpe bibale, na bisika ya kokawuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zelo ya esobe ekobongwana liziba ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "mpe mabele ya kokawuka ekokoma bitima ya mayi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "Matiti, nzete oyo ebotaka na mayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "mpe papirisi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        },
        {
          "text": "ekobota na bisika oyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:7"
      },
      "items": [
        {
          "text": "mbwa ya zamba elalaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzela moko ya monene ekoleka wana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "bakobenga yango Balabala ya Bosantu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "Moto moko te ya mbindo akoleka wana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "pamba te ebongisamaki kaka mpo na bato ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:8"
      },
      "items": [
        {
          "text": "Boye ata zoba akoki te kobunga na nzela yango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkosi ekozala te na nzela yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "ata nyama moko te ya mabe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "ekoleka na nzela yango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "ekotikala komonana kuna te.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "Kasi basikolami kaka nde",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:9"
      },
      "items": [
        {
          "text": "bakotambola na nzela yango.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bakangolami na Yawe bakozonga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "bakokota na Siona na nzembo ya elonga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "mpe esengo ya suka te ekozala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "na likolo ya mito na bango lokola mitole.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 35:10"
      },
      "items": [
        {
          "text": "Esengo mpe kosepela ekopesamela bango,",
