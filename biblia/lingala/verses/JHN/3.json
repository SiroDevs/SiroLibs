{
  "id": "JHN.3",
  "number": "3",
  "bookId": "JHN",
  "reference": "Yoane 3",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JHN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu mpe Nikodemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki na moto moko kati na Bafarizeo, oyo kombo na ye ezalaki « Nikodemi. » Azalaki moko kati na bakonzi ya Bayuda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.1",
            "verseOrgIds": [
              "JHN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayaki na butu epai ya Yesu mpe alobaki na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.2",
            "verseOrgIds": [
              "JHN.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:2"
      },
      "items": [
        {
          "text": "— Rabi, toyebi ete ozali Moteyi oyo awuti epai ya Nzambe, pamba te moto moko te akoki kosala bikamwa oyo Yo ozali kosala soki Nzambe azali elongo na ye te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.3",
            "verseOrgIds": [
              "JHN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nazali koloba na yo penza ya solo : moto moko te akoki komona Bokonzi ya Nzambe soki abotami te mbotama ya sika.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikodemi atunaki Ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.4",
            "verseOrgIds": [
              "JHN.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:4"
      },
      "items": [
        {
          "text": "— Ndenge nini moto oyo akomi mobange akoki kobotama lisusu ? Akoki solo kozonga na libumu ya mama na ye mpo ete abotama lisusu ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.5",
            "verseOrgIds": [
              "JHN.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nazali koloba na yo penza ya solo : moto moko te akoki kokota na Bokonzi ya Nzambe soki abotami te na mayi mpe na Molimo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oyo abotami na mosuni azali mosuni, mpe oyo abotami na Molimo azali molimo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kokamwa te ndenge nalobi na yo : « Osengeli kobotama mbotama ya sika ! »",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mopepe epepaka esika nyonso oyo elingi kopepa ; atako oyoki makelele na yango, kasi okokaka te koloba soki ewuti wapi to ezali kokende wapi. Ezali mpe bongo mpo na moto nyonso oyo abotami na Molimo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikodemi atunaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.9",
            "verseOrgIds": [
              "JHN.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:9"
      },
      "items": [
        {
          "text": "— Ekosalema ndenge nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.10",
            "verseOrgIds": [
              "JHN.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Ndenge nini yo, molakisi mobimba oyo okenda sango kati na Isalaele, ozali kososola te makambo oyo ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na yo penza ya solo : tolobaka makambo oyo toyebi mpe topesaka litatoli na tina na makambo oyo tomoni ; kasi bino, boboyi kondima litatoli na biso.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Soki tango nazali koloba na bino makambo ndenge esalemaka na mokili, bozali kondima te, bongo bokondima ndenge nini soki nalobi na bino makambo ya Likolo ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ezali na moto moko te oyo asila komata na Likolo, longola kaka Ye oyo akita wuta na Likolo : Mwana na Moto.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndenge kaka Moyize atelemisaki na nzete, ekeko ya nyoka kati na esobe, ndenge wana mpe Mwana na Moto asengeli kotombolama",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpo ete moto nyonso oyo akondima Ye azwa, kati na Ye, bomoi ya seko.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Nzambe alingaki mokili mingi penza, yango wana apesaki Mwana na Ye se moko, mpo ete moto nyonso oyo akondima Ye akufa te kasi azwa bomoi ya seko.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe atindaki Mwana na Ye kati na mokili mpo ete akatela yango etumbu te, kasi mpo ete abikisa yango.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo andimi Ye akozwa etumbu te ; kasi ye oyo aboyi kondima Ye asili kozwa etumbu, pamba te aboyi kondima Mwana se moko ya Nzambe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala ndenge nini etumbu yango ezali : pole eyaki kati na mokili, kasi bato balingaki molili, pamba te misala na bango ezali mabe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo asalaka mabe ayinaka pole mpe apusanaka te epai pole ezali, noki te misala na ye ekomonana polele.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, moto nyonso oyo atambolaka na solo ayaka epai pole ezali mpo ete misala oyo asalaka, na boyokani elongo na Nzambe, emonana polele.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yoane atatoli mpo na Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Yesu akendeki na Yuda, elongo na bayekoli na Ye ; avandaki kuna mwa tango elongo na bango mpe azalaki kobatisa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.22",
            "verseOrgIds": [
              "JHN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoane mpe azalaki kobatisa na Enoni, pembeni ya Salimi, mpo ete mayi ezalaki mingi kuna ; bato bazalaki kokende kuna epai na ye mpe bazalaki kozwa libatisi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.23",
            "verseOrgIds": [
              "JHN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango wana, batiaki nanu Yoane na boloko te.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.24",
            "verseOrgIds": [
              "JHN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, bayekoli ya Yoane bazalaki kobendana na Moyuda moko na tina na kopetolama.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.25",
            "verseOrgIds": [
              "JHN.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakendeki epai ya Yoane mpe balobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.26",
            "verseOrgIds": [
              "JHN.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:26"
      },
      "items": [
        {
          "text": "— Moteyi, ozali koyeba lisusu moto oyo azalaki elongo na yo, na ngambo mosusu ya Yordani, oyo na tina ye opesaki litatoli ? Ye mpe azali kobatisa bato, mpe bato nyonso bazali kokende epai na ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoane azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.27",
            "verseOrgIds": [
              "JHN.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JHN 3:27"
      },
      "items": [
        {
          "text": "— Moto akoki kozwa eloko moko te soki Likolo epesi ye yango te.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino moko bokoki kotatola ete nalobaki : « Ngai, nazali Klisto te, kasi natindamaki liboso na Ye. »",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi ya libala azali ya mobali oyo abali ye ; mpe moninga ya mobali oyo asili kobala, ezali moto oyo atelemi pembeni na ye mpe azali na esengo makasi tango azali koyoka mongongo na ye. Ezali mpe bongo mpo na ngai : esengo na ngai ezali sik'oyo ya kokoka.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengeli ete Ye amata, mpe ngai nakita.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye oyo awuti na Likolo azali likolo na nyonso ; kasi moto oyo awuti na mokili akotikala kaka ya mokili mpe alobaka kaka lokola moto ya mokili. Ye oyo awuti na Likolo azali likolo na nyonso,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "azali kotatola na tina na makambo oyo amonaki mpe ayokaki, kasi moto moko te azali kondima litatoli na Ye.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo andimi litatoli na Ye akolobaka na solo ete Nzambe azali solo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motindami ya Nzambe alobaka kaka maloba kowuta na Nzambe, pamba te Nzambe atondisa ye na Molimo na Ye nyonso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata alingaka Mwana, mpe Mwana azalaka na bokonzi kowuta na Tata mpo na kokonza nyonso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto nyonso oyo andimi Mwana azali na bomoi ya seko ; nzokande moto oyo aboyi kondima Mwana akozwa bomoi yango te, kasi azalaka kaka na se ya etumbu ya Nzambe.",
          "type": "text"
        }
      ]
    }
  ],
