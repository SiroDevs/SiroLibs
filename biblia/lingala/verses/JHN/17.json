  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JHN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libondeli ya Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na Yesu koloba bongo, atombolaki miso na Ye na Likolo mpe abondelaki :",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JHN 17:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tata, tango ekoki ; monisa nkembo ya Mwana na Yo mpo ete Mwana mpe amonisa nkembo na Yo ;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.1",
                "verseOrgIds": [
                  "JHN.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pamba te opesaki Ye bokonzi likolo ya bato nyonso, mpo ete apesa bomoi ya seko epai ya bato nyonso oyo opesaki Ye.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.2",
                "verseOrgIds": [
                  "JHN.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzokande, bomoi ya seko ezali : koyeba Yo oyo ozali Nzambe moko kaka ya solo, mpe koyeba Yesu-Klisto oyo otindaki.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.3",
                "verseOrgIds": [
                  "JHN.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namonisi nkembo na Yo awa na mokili mpe nasilisi mosala oyo opesaki Ngai.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.4",
                "verseOrgIds": [
                  "JHN.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sik'oyo Tata, pesa Ngai lisusu nkembo oyo nazalaki na yango kuna epai Yo ozali liboso ete okela mokili.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.5",
                "verseOrgIds": [
                  "JHN.17.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu asambeli mpo na bayekoli na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namonisi nkembo na Yo epai ya bato oyo opesaki Ngai sima na Yo kolongola bango na misala ya mokili. Bazalaki bato na Yo, kasi opesaki Ngai bango ; mpe batosi Liloba na Yo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.6",
                "verseOrgIds": [
                  "JHN.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bayebi malamu sik'oyo ete nyonso oyo opesaki Ngai ewutaki solo epai na Yo ;",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.7",
                "verseOrgIds": [
                  "JHN.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pamba te nateyaki bango maloba oyo opesaki Ngai, mpe bayambaki yango na esengo ; bayebi ete nawutaki solo epai na Yo, mpe bandimi ete Yo nde otindaki Ngai.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.8",
                "verseOrgIds": [
                  "JHN.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali kobondela nde mpo na bango ; nazali kobondela te mpo na bato ya mokili, kasi mpo na bato oyo opesaki Ngai, mpo ete bazali bato na Yo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.9",
                "verseOrgIds": [
                  "JHN.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bato na Yo nyonso bazali bato na Ngai, mpe bato na Ngai nyonso bazali bato na Yo ; mpe nkembo na Ngai ezali komonisama kati na bango.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.10",
                "verseOrgIds": [
                  "JHN.17.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kala mingi te, nakozala lisusu te kati na mokili, pamba te nazali koya epai na Yo ; kasi bango, bakokoba kozala kati na mokili. Tata na Ngai, Yo oyo ozali Mosantu, batela bango na nguya ya Kombo na Yo, Kombo oyo opesaki Ngai, mpo ete bazala moko ndenge Yo na Ngai tozali moko.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.11",
                "verseOrgIds": [
                  "JHN.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wana nazalaki elongo na bango, nabatelaki bango na nguya ya Kombo na Yo, Kombo oyo opesaki Ngai ; nabatelaki bango malamu, mpe moko te kati na bango abungaki, longola kaka ye oyo asengeli na libebi mpo ete Makomi ekokisama.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.12",
                "verseOrgIds": [
                  "JHN.17.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sik'oyo, nazali koya epai na Yo ; kasi nazali koloba makambo oyo tango nazali nanu kati na mokili mpo ete esengo na Ngai, oyo ezali ya kokoka, ezala kati na bango.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.13",
                "verseOrgIds": [
                  "JHN.17.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nateyaki bango maloba oyo oyebisaki Ngai, mpe mokili eyinaki bango mpo ete bazali bato ya mokili te, ndenge Ngai mpe nazali ya mokili te.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.14",
                "verseOrgIds": [
                  "JHN.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali kosenga na Yo te ete olongola bango kati na mokili, kasi nde obatela bango liboso ya Satana.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.15",
                "verseOrgIds": [
                  "JHN.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bazali bato ya mokili te, ndenge Ngai mpe nazali ya mokili te.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.16",
                "verseOrgIds": [
                  "JHN.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bulisa bango na nzela ya bosolo na Yo, Liloba na Yo ya solo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.17",
                "verseOrgIds": [
                  "JHN.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndenge otindaki Ngai kati na mokili, ndenge wana mpe Ngai nazali kotinda bango.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.18",
                "verseOrgIds": [
                  "JHN.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namibonzaki mobimba epai na Yo mpo na bango, mpo ete bango mpe babulisama na nzela ya bosolo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.19",
                "verseOrgIds": [
                  "JHN.17.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu abondeli mpo bandimi na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali kobondela mpo na bango kaka te, kasi mpe mpo na bato oyo bakondima Ngai na nzela ya mateya na bango,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.20",
                "verseOrgIds": [
                  "JHN.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.20",
            "verseOrgIds": [
              "JHN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpo ete bango nyonso bazala moko ndenge Yo Tata ozali kati na Ngai, mpe Ngai kati na Yo ; ete bango mpe bazala moko kati na biso, mpe ete mokili endima ete ezali Yo nde otindaki Ngai.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.17.21",
