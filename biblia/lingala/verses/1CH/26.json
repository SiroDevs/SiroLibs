          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:4"
      },
      "items": [
        {
          "text": "mwana ya mibale, Yozabadi ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 26:4"
      },
      "items": [
        {
