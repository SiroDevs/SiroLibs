      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshelemia azalaki na bana mibali oyo :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        }
      ]
    },
    {
