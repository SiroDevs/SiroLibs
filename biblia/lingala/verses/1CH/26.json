      "attrs": {
        "style": "li4",
        "vid": "1CH 26:1"
      },
      "items": [
        {
          "text": "Mpo na bato ya Kore :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 26:1"
      },
      "items": [
        {
          "text": "Meshelemia, mwana mobali ya Kore, moko kati na bana mibali ya Azafi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        }
      ]
    },
    {
