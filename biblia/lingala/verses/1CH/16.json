  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1CH 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esengo mpe masanzoli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamemaki Sanduku ya Yawe mpe batiaki yango kati na ndako ya kapo oyo Davidi atelemisaki mpo na yango, mpe babonzaki liboso ya Nzambe bambeka ya kotumba mpe bambeka ya boyokani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.1",
            "verseOrgIds": [
              "1CH.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Davidi asilisaki kobonza bambeka ya kotumba mpe bambeka ya boyokani, apambolaki bato na Kombo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.2",
            "verseOrgIds": [
              "1CH.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo apesaki na moto nyonso ya Isalaele : lipa, gato oyo basala na bambuma ya dati mpe gato oyo basala na bambuma ya vino ya kokawuka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.3",
            "verseOrgIds": [
              "1CH.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atiaki ndambo ya Balevi mpo na kosala mosala liboso ya Sanduku ya Yawe, mpo na kokanisa, mpo na kosanzola mpe mpo na kokumisa Yawe, Nzambe ya Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.4",
            "verseOrgIds": [
              "1CH.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azafi azalaki mokambi ; Zakari azalaki molandi na ye ; mpe Yeyeli, Shemiramoti, Yeyeli, Matitia, Eliabi, Benaya, Obedi-Edomi mpe Yeyeli bazalaki kobeta nzenze mpe lindanda ; mpe Azafi azalaki kobeta manzanza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.5",
            "verseOrgIds": [
              "1CH.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banganga-Nzambe Benaya mpe Yaazieli bazalaki kobeta tango nyonso bakelelo liboso ya Sanduku ya Boyokani ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.6",
            "verseOrgIds": [
              "1CH.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzembo ya matondi ya Davidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki mokolo wana nde Davidi aponaki na mbala ya liboso Azafi mpe bandeko na ye, mpo ete bakumisa Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
              "1CH.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokumisa Yawe, bobelela Kombo na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:8"
      },
      "items": [
        {
          "text": "bopanza sango ya misala minene na Ye kati na bikolo !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.8",
            "verseOrgIds": [
              "1CH.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyemba mpo na lokumu na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:9"
      },
      "items": [
        {
          "text": "bosanzola Ye na mindule !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CH 16:9"
      },
      "items": [
        {
          "text": "Botatolaka tango nyonso misala minene na Ye nyonso !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.9",
            "verseOrgIds": [
              "1CH.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosepela na Kombo na Ye ya bule !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:10"
      },
      "items": [
        {
          "text": "Tika ete mitema ya bato oyo balukaka Yawe",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:10"
      },
      "items": [
        {
          "text": "etonda na esengo !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.10",
            "verseOrgIds": [
              "1CH.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bomipesa na Yawe mpe bosenga makasi na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.11",
            "verseOrgIds": [
              "1CH.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:11"
      },
      "items": [
        {
          "text": "Bolukaka tango nyonso elongi na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.11",
            "verseOrgIds": [
              "1CH.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokanisa bikamwa, makambo minene oyo asalaki,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.12",
            "verseOrgIds": [
              "1CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:12"
      },
      "items": [
        {
          "text": "bitumbu oyo apesaki,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.12",
            "verseOrgIds": [
              "1CH.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bino bakitani ya Isalaele, mosali na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.13",
            "verseOrgIds": [
              "1CH.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:13"
      },
      "items": [
        {
          "text": "bino bana mibali ya Jakobi, baponami na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.13",
            "verseOrgIds": [
              "1CH.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali Nzambe na biso, mikano na Ye ekambaka mokili mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.14",
            "verseOrgIds": [
              "1CH.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanisaka tango nyonso Boyokani na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.15",
            "verseOrgIds": [
              "1CH.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:15"
      },
      "items": [
        {
          "text": "bilaka na Ye mpo na bikeke nkoto moko,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.15",
            "verseOrgIds": [
              "1CH.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "boyokani oyo asalaki elongo na Abrayami,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.16",
            "verseOrgIds": [
              "1CH.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:16"
      },
      "items": [
        {
          "text": "mpe ndayi oyo alapaki epai ya Izaki.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.16",
            "verseOrgIds": [
              "1CH.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akokisaki bosolo na yango epai ya Jakobi lokola mobeko,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.17",
            "verseOrgIds": [
              "1CH.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:17"
      },
      "items": [
        {
          "text": "epai ya Isalaele lokola boyokani ya libela na libela",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.17",
            "verseOrgIds": [
              "1CH.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "tango alobaki : « Nakopesa yo mokili ya Kanana",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.18",
            "verseOrgIds": [
              "1CH.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:18"
      },
      "items": [
        {
          "text": "lokola libula oyo epesameli yo. »",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.18",
            "verseOrgIds": [
              "1CH.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bozalaki kaka motango moke ya bato",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.19",
            "verseOrgIds": [
              "1CH.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:19"
      },
      "items": [
        {
          "text": "mpe bapaya kati na yango ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.19",
            "verseOrgIds": [
              "1CH.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "bozalaki koyengayenga",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:20"
      },
      "items": [
        {
          "text": "longwa na ekolo moko kino na ekolo mosusu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CH 16:20"
      },
      "items": [
        {
          "text": "longwa na mokili moko kino na mokili mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.20",
            "verseOrgIds": [
              "1CH.16.20"
            ]
          }
        }
      ]
