            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyeli, tata ya Gabaoni, azalaki kovanda na Gabaoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
