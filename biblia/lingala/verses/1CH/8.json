              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atseli abotaki bana mibali motoba :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.38",
            "verseOrgIds": [
              "1CH.8.38"
            ]
