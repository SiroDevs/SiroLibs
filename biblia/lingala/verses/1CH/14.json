          },
          "items": [
            {
              "text": "2Sa 5.11-16",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.3.5-1CH.3.8"
          },
          "items": [
            {
              "text": "1Ma 3.5-8",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irami, mokonzi ya Tiri, atindaki bantoma epai ya Davidi mpo ete bamemela ye mabaya ya sedele, bato oyo bapasolaka mabanga mpe basharipantie ; mpe batongelaki ye ndako.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi asosolaki ete Yawe nde akomisaki ye mokonzi ya Isalaele mpe ete azalaki kotombola bokonzi na ye makasi mpo na Isalaele, bato na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi abalaki lisusu basi ebele kati na Yelusalemi mpe abotaki lisusu bana ebele ya mibali mpe ya basi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bakombo ya bana na ye ya mibali oyo babotamaki na Yelusalemi : Shamuwa, Shobabi, Natan, Salomo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yibari, Elishuwa, Elipeleti,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noga, Nefegi, Yafia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama, Beliada mpe Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davidi alongi bato ya Filisitia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.5.17-2SA.5.25"
          },
          "items": [
            {
              "text": "2Sa 5.17-25",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bato ya Filisitia bayokaki sango ete bapakoli Davidi mafuta mpo ete akoma mokonzi ya Isalaele mobimba, bango nyonso bakendeki koluka ye. Kasi tango Davidi ayokaki sango ya mabongisi na bango, abimaki mpo na kokutana na bango.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Filisitia bakomaki mpe bapanzanaki na lubwaku ya bakitani ya Rafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi atunaki Nzambe :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "1CH 14:10"
      },
      "items": [
        {
          "text": "— Nakoki solo kokende kobundisa bato ya Filisitia ? Okokaba bango solo na maboko na ngai ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 14:10"
      },
      "items": [
        {
          "text": "Yawe azongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "1CH 14:10"
      },
      "items": [
        {
          "text": "— Kende, pamba te nakokaba bango na maboko na yo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Filisitia bamataki na Bali-Peratsimi, mpe Davidi alongaki bango kuna. Bongo Davidi alobaki : « Na nzela ya loboko na ngai, Nzambe afungoleli ngai nzela kati na banguna na ngai, ndenge mayi epasolaka nzela. »",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 14:11"
      },
      "items": [
        {
          "text": "Yango wana babengaki esika yango Bala-Peratsimi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Filisitia basundolaki kuna banzambe na bango, mpe Davidi apesaki mitindo ete batumba yango na moto.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mwa tango, bato ya Filisitia bayaki mpe bapanzanaki lisusu kati na lubwaku.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Davidi atunaki lisusu Nzambe, mpe Nzambe azongiselaki ye : « Tango okobundisa bango, kolanda bango na sima te ; kasi tambola mopanzi, mosika na bango. Bongo tango okokoma epai bango bazali, bimela bango na liboso, liboso ya zamba ya banzete ya mirie",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango okoyoka lokito ya makolo ya bato na likolo ya banzete ya mirie, na tango wana nde okobima mbala moko mpo na kobunda ; pamba te ekolakisa ete Nzambe abimi liboso na yo mpo na kobeta mampinga ya bato ya Filisitia. »",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi asalaki ndenge Nzambe atindaki ye mpe abomaki bato ya Filisitia, longwa na Gabaoni kino na Gezeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kombo ya Davidi ekendeki sango na mokili mobimba mpe Yawe asalaki ete bikolo nyonso ebanga Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
  ],
