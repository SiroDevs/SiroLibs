          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeke ya liboso, oyo ezalaki mpo na libota ya Azafi, ekweyaki epai ya Jozefi, bana na ye ya mibali mpe bandeko na ye ya mibali :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
