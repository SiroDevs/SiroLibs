    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 25:9"
      },
      "items": [
        {
          "text": "Zeke ya mibale ekweyaki epai ya Gedalia, bandeko na ye ya mibali mpe bana na ye ya mibali :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
