  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "JOB 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyano ya Yobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobo azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.1",
            "verseOrgIds": [
              "JOB.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Lelo lisusu, kolela na ngai ezali bololo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:2"
      },
      "items": [
        {
          "text": "loboko oyo ezali likolo na ngai eleki",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:2"
      },
      "items": [
        {
          "text": "kolela ya motema na ngai na kilo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki nayebaki esika nini nakoki komona Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:3"
      },
      "items": [
        {
          "text": "nalingaki kokoma liboso ya kiti ya bokonzi na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalingaki kotalisa, na bosembo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:4"
      },
      "items": [
        {
          "text": "likambo na ngai liboso na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:4"
      },
      "items": [
        {
          "text": "mpe kotondisa monoko na ngai na matatoli ya solo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalingaki koyeba biyano oyo alingaki kopesa ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:5"
      },
      "items": [
        {
          "text": "mpe kososola makambo oyo alingaki koloba na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, alingaki kosalela nguya na Ye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:6"
      },
      "items": [
        {
          "text": "mpo na kosamba na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:6"
      },
      "items": [
        {
          "text": "Te, alingaki kutu koyokela ngai mawa !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna, liboso na Ye, moto ya sembo akososolisa Ye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:7"
      },
      "items": [
        {
          "text": "likambo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 23:7"
      },
      "items": [
        {
          "text": "mpe nakokangolama libela",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:7"
      },
      "items": [
        {
          "text": "wuta na maboko ya mosambisi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki nakeyi na ngambo ya este, azali kuna te ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:8"
      },
      "items": [
        {
          "text": "soki nakeyi na ngambo ya weste, nazali komona Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango azali na mosala na ngambo ya nor,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:9"
      },
      "items": [
        {
          "text": "nazali komona Ye te,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 23:9"
      },
      "items": [
        {
          "text": "tango azali kobaluka na ngambo ya sude,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:9"
      },
      "items": [
        {
          "text": "nazali komona Ye ata moke te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Ye ayebi nzela oyo ngai nazali kolanda ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:10"
      },
      "items": [
        {
          "text": "soki ameki ngai, nakokoma lokola wolo ya peto.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makolo na ngai elandaki matambe na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:11"
      },
      "items": [
        {
          "text": "natambolaki na nzela na Ye",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:11"
      },
      "items": [
        {
          "text": "mpe natikalaki kopengwa na yango te.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napengwaki te mosika ya mateya ya bibebu na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:12"
      },
      "items": [
        {
          "text": "nabatelaki yango lokola bomengo ya kitoko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:12"
      },
      "items": [
        {
          "text": "koleka lipa na ngai ya mokolo na mokolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Ye, azwaka Ye moko mokano na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:13"
      },
      "items": [
        {
          "text": "nani akoki kotelemela Ye ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:13"
      },
      "items": [
        {
          "text": "Asalaka nyonso oyo esepelisaka Ye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akokokisa ekateli oyo azwaki na tina na ngai",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:14"
      },
      "items": [
        {
          "text": "mpe ebele ya mabongisi mosusu oyo akobongisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, liboso na Ye, nazali koyoka somo makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:15"
      },
      "items": [
        {
          "text": "mpe wana nazali kokanisa makambo oyo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:15"
      },
      "items": [
        {
          "text": "nazali kobanga Ye.",
