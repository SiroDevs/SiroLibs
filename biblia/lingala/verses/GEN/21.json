          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrayami avandaki lisusu tango molayi na mokili ya Filisitia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.34",
            "verseOrgIds": [
              "GEN.21.34"
            ]
          }
