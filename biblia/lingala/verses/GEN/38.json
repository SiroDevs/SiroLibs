  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "GEN 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda mpe Tamari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande na tango wana, Yuda atikaki bandeko na ye mpe akendeki kovanda epai ya Ira, moto ya Adulami",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.1",
            "verseOrgIds": [
              "GEN.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda akutanaki kuna na mwana mwasi ya Shuwa, moto ya Kanana. Abalaki ye mpe asangisaki na ye nzoto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.2",
            "verseOrgIds": [
              "GEN.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi yango akomaki na zemi mpe abotelaki Yuda mwana mobali. Mpe Yuda apesaki ye kombo « Eri. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.3",
            "verseOrgIds": [
              "GEN.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi yango azwaki lisusu zemi mpe abotaki mwana mobali ; apesaki ye kombo « Onani. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.4",
            "verseOrgIds": [
              "GEN.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abotaki mwana mobali mosusu mpe apesaki ye kombo « Shela. » Yuda azalaki na Kezibi tango mwasi na ye abotaki mwana ya misato.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.5",
            "verseOrgIds": [
              "GEN.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda abalelaki Eri, mwana na ye ya liboso, mwasi : Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.6",
            "verseOrgIds": [
              "GEN.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Eri, mwana liboso ya Yuda, azalaki moto mabe na miso ya Yawe ; yango wana Yawe abomaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.7",
            "verseOrgIds": [
              "GEN.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yuda alobaki na Onani : « Sangisa nzoto na semeki na yo mpo ete obota bana mpo na ndeko na yo ya mobali oyo akufa. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.8",
            "verseOrgIds": [
              "GEN.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi lokola Onani ayebaki ete bana oyo bakobotama bakozala ya ye te, azalaki kobwaka mayi na ye ya mibali na mabele tango nyonso azalaki kosangisa nzoto na semeki na ye, mpo ete abotela ndeko na ye ya mobali bana te.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.9",
            "verseOrgIds": [
              "GEN.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likambo oyo Onani azalaki kosala ezalaki kosepelisa Yawe te. Boye ye mpe lisusu, Yawe abomaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.10",
            "verseOrgIds": [
              "GEN.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda alobaki na Tamari, bokilo na ye ya mwasi : « Lokola okufisi mibali, kende kovanda na ndako ya tata na yo kino Shela, mwana na ngai ya mobali, akokoma mokolo. » Pamba te azalaki komilobela : « Tango mosusu ye mpe akoki kokufa lokola bandeko na ye ya mibali. » Boye Tamari akendeki kovanda na ndako ya tata na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.11",
            "verseOrgIds": [
              "GEN.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na tango molayi, mwana mwasi ya Shuwa, mwasi ya Yuda, akufaki. Lokola tango na ye ya matanga esilaki, Yuda akendeki na Timina epai ya bato oyo bazalaki kolongola bapwale ya bameme na ye. Boye, moninga na ye Ira, moto ya Adulami, akendeki elongo na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.12",
            "verseOrgIds": [
              "GEN.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bayebisaki Tamari : « Bokilo na yo ya mobali azali kokende na Timina mpo na kolongolisa bapwale ya bameme na ye, »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.13",
            "verseOrgIds": [
              "GEN.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "alongolaki bilamba na ye ya mwasi akufisa mobali mpe amizipaki elongi na vwale mpo ete bayeba ye lisusu te. Avandaki na ekuke ya Enayimi oyo ezalaki na nzela ya Timina, pamba te amonaki ete Shela akolaki, kasi bapesaki ye te na libala epai ya Shela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.14",
            "verseOrgIds": [
              "GEN.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yuda amonaki ye, akanisaki ete azali mwasi ya ndumba, pamba te azipaki elongi na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.15",
            "verseOrgIds": [
              "GEN.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola Yuda ayebaki te ete ezali bokilo na ye ya mwasi, apusanaki na esika oyo azalaki, pembeni ya nzela, mpe alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:16"
      },
      "items": [
        {
          "text": "— Yaka, ndima ete tosangisa na yo nzoto.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:16"
      },
      "items": [
        {
          "text": "Tamari atunaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.16",
            "verseOrgIds": [
              "GEN.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:16"
      },
      "items": [
        {
          "text": "— Okopesa ngai nini soki osangisi na ngai nzoto ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:17"
      },
      "items": [
        {
          "text": "— Nakotindela yo mwana ntaba oyo nakozwa na etonga na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:17"
      },
      "items": [
        {
          "text": "Tamari atunaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.17",
            "verseOrgIds": [
              "GEN.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:17"
      },
      "items": [
        {
          "text": "— Ndanga nini okosimbisa ngai kino tango okotindela ngai yango ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:18"
      },
      "items": [
        {
          "text": "— Ndanga nini olingi ete nasimbisa yo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:18"
      },
      "items": [
        {
          "text": "Tamari azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:18"
      },
      "items": [
        {
          "text": "— Lopete na yo, singa na yo mpe lingenda na yo, oyo osimbi na loboko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:18"
      },
      "items": [
        {
          "text": "Boye Yuda apesaki ye yango, asangisaki na ye nzoto mpe Tamari akomaki na zemi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.18",
            "verseOrgIds": [
              "GEN.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari atelemaki mpe akendeki ; alongolaki vwale na ye mpe azongisaki lisusu na nzoto bilamba na ye ya mwasi akufisa mobali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.19",
            "verseOrgIds": [
              "GEN.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye Yuda atindaki moninga na ye Ira, moto ya Adulami, mpo ete amemela mwasi yango mwana ntaba mpe azwa ndanga oyo asimbisaki ye. Kasi Ira amonaki ye te.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.20",
            "verseOrgIds": [
              "GEN.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye atunaki epai ya bavandi ya esika wana, na Enayimi :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:21"
      },
      "items": [
        {
          "text": "— Wapi mwasi ya ndumba oyo azalaki na nzela, na Enayimi ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:21"
      },
      "items": [
        {
          "text": "Bazongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.21",
            "verseOrgIds": [
              "GEN.38.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:21"
      },
      "items": [
        {
          "text": "— Esika oyo etikala kozala na mwasi ya ndumba te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira azongaki epai ya Yuda mpe ayebisaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.22",
            "verseOrgIds": [
              "GEN.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:22"
      },
      "items": [
        {
          "text": "— Namoni ye te ; kutu bavandi ya Enayimi bayebisi ngai ete mwasi ya ndumba atikala kozala na esika wana te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.23",
            "verseOrgIds": [
              "GEN.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:23"
      },
      "items": [
        {
          "text": "— Atikala na biloko oyo azwaki, noki te tokobima babolole. Ngai nazali na likambo te ; natindeli ye mwana ntaba, mpe yo omoni ye te.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na sanza misato, bayebisaki Yuda :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:24"
      },
      "items": [
        {
          "text": "— Tamari, bokilo na yo ya mwasi, asalaki kindumba, mpe tala kutu akomi na zemi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:24"
      },
      "items": [
        {
          "text": "Yuda alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:24"
      },
      "items": [
        {
          "text": "— Babimisa ye mpe batumba ye na moto !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana bazalaki kobimisa ye libanda, Tamari atindaki sango oyo epai ya Yuda, bokilo na ye :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:25"
      },
      "items": [
        {
          "text": "— Nazali na zemi ya nkolo biloko oyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:25"
      },
      "items": [
        {
          "text": "Mpe abakisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:25"
      },
      "items": [
        {
          "text": "— Tala soki okoki koyeba nani azali nkolo ya lopete oyo, ya singa oyo mpe ya lingenda oyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda asosolaki ete ezali biloko na ye mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 38:26"
      },
      "items": [
        {
          "text": "— Azali sembo koleka ngai, pamba te nabalisaki ye te epai ya Shela, mwana na ngai ya mobali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 38:26"
      },
      "items": [
        {
          "text": "Boye Yuda atikalaki lisusu te kosangisa na ye nzoto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana tango na ye ya kobota ekokaki, emonanaki ete ezalaki na mapasa mibale ya mibali kati na libumu na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.27",
            "verseOrgIds": [
              "GEN.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango ya kobota, moko kati na bango abimisaki loboko ; mpe mwasi oyo abotisaka asimbaki loboko yango, akangaki yango singa ya motane mpe alobaki : « Mwana oyo nde abimi liboso. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.28",
            "verseOrgIds": [
              "GEN.38.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi azongisaki loboko na ye, mpe ndeko na ye ya mobali abimaki. Bongo mwasi oyo abotisaka alobaki : « Ofungoli nzela nini mpo na kobima ? » Mpe bapesaki ye kombo « Peretsi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "text": ". »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.29",
            "verseOrgIds": [
              "GEN.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima, ndeko na ye oyo azalaki na singa ya motane na loboko mpe abotamaki ; bapesaki ye kombo « Zera",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        },
        {
          "text": ". »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.30",
            "verseOrgIds": [
              "GEN.38.30"
            ]
          }
        }
      ]
    }
  ],
