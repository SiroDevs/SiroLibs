      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 18:27"
      },
      "items": [
        {
          "text": "— Solo, nazali na ngai moto pamba mpe putulu, kasi limbisa ete nameka kosolola na Nkolo na ngai.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo soki motango na bato ya sembo ezali tuku minei na mitano ? Boni, okobebisa engumba mobimba mpo na bato mitano oyo bazangi ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:28"
      },
      "items": [
        {
          "text": "Yawe azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
