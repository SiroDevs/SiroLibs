      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 18:26"
      },
      "items": [
        {
          "text": "— Soki nakuti na Sodome bato ya sembo tuku mitano, nakolimbisa engumba mobimba mpo na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
