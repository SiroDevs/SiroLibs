          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrayami alobaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        }
