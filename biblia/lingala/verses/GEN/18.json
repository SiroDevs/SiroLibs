      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "GEN 18:28"
      },
      "items": [
        {
          "text": "— Soki nakuti bato ya sembo tuku minei na mitano, nakobebisa yango te.",
          "type": "text"
        }
      ]
    },
    {
