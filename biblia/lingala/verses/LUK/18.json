{
  "id": "LUK.18",
  "number": "18",
  "bookId": "LUK",
  "reference": "Luka 18",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "LUK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Molende na kosambela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bayekoli na Ye lisese moko mpo na kolakisa bango ete basengeli kosambelaka tango nyonso, na kolemba te.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.1",
            "verseOrgIds": [
              "LUK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.2",
            "verseOrgIds": [
              "LUK.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Kati na engumba moko, ezalaki na mosambisi moko oyo azalaki kotosa Nzambe te, mpe azalaki komemia bato te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kati na engumba yango, ezalaki mpe na mwasi moko akufisa mobali ; azalaki koya mbala na mbala epai ya mosambisi yango mpo na koloba na ye : « Longisa ngai liboso ya monguna na ngai. »",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wuta tango molayi, mosambisi yango aboyaki. Kasi suka na suka, amilobelaki : « Atako natosaka Nzambe te mpe namemiaka bato te,",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi lokola motungisi ya mwasi oyo akufisa mobali eleki ndelo, nakolongisa ye kaka, mpo ete akoba te koyaka tango nyonso kino kozangisa ngai kimia. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo abakisaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Boyoka maloba ya mosambisi mabe oyo !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boni, Nzambe akolongisa te baponami na Ye, tango bagangaka epai na Ye butu mpe moyi ? Boni, akozelisa bango ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino : akolongisa bango noki. Nzokande, ekozala ndenge nini tango Mwana na Moto akoya ! Boni, akokuta kondima kati na mokili ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisese ya Mofarizeo mpe mofutisi mpako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epai ya bato oyo bamimonaki bato ya sembo mpe batiolaki bato mosusu, Yesu alobaki lisusu lisese oyo :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.9",
            "verseOrgIds": [
              "LUK.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bato mibale bakendeki na Tempelo mpo na kosambela : moko azalaki Mofarizeo ; mpe mosusu, mofutisi mpako.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mofarizeo abendanaki ye moko na pembeni mpe asambelaki : « Oh Nzambe, nazali kotonda Yo, mpo ete nazali te lokola bato mosusu oyo bazali miyibi, bato mabe, bato na bikobo to mpe lokola mofutisi mpako oyo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nakilaka bilei mbala mibale na poso mpe napesaka eteni ya zomi ya nyonso oyo nazwaka. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi mofutisi mpako atelemaki mwa mosika ; amekaki ata te kotombola miso na ye na likolo, kasi atiaki loboko na ye na tolo mpe alobaki : « Oh Nzambe, yokela ngai mawa, pamba te nazali moto ya masumu ! »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino : mofutisi mpako azongaki na ndako na ye sima na Nzambe kokomisa ye moto ya sembo, kasi Mofarizeo te. Pamba te moto nyonso oyo amitombolaka, bakokitisa ye ; mpe oyo amikitisaka, bakotombola ye.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ayambi bana mike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.19.13-MAT.19.15"
          },
          "items": [
            {
              "text": "Mat 19.13-15",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.13-MRK.10.16"
          },
          "items": [
            {
              "text": "Mlk 10.13-16",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bazalaki mpe komema bana mike epai ya Yesu mpo ete atia bango maboko. Tango bayekoli bamonaki bongo, bapamelaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yesu abengaki bana mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:16"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Botika bana mike baya epai na Ngai ; bopekisa bango te koya epai na Ngai, pamba te Bokonzi ya Nzambe ezali mpo na bato oyo bazali lokola bana mike.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino penza ya solo : moto nyonso oyo azali koyamba te Bokonzi ya Nzambe lokola mwana moke akotikala kokota te kati na Bokonzi yango.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bazwi mpe Bokonzi ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.19.16-MAT.19.30"
          },
          "items": [
            {
              "text": "Mat 19.16-30",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.17-MRK.10.31"
          },
          "items": [
            {
              "text": "Mlk 10.17-31",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokambi moko ya Bayuda atunaki na Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.18",
            "verseOrgIds": [
              "LUK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:18"
      },
      "items": [
        {
          "text": "— Moteyi malamu, nasengeli kosala nini mpo ete nazwa bomoi ya seko ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:19"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mpo na nini ozali kobenga Ngai « Moteyi malamu ? » Moko te azali malamu, longola kaka Ye moko Nzambe.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oyebi mibeko oyo : « Okosalaka ekobo te, okobomaka te, okoyibaka te, okolobaka te matatoli ya lokuta mpo na kokosela moninga na yo makambo, okopesaka tata na yo mpe mama na yo lokumu. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokambi yango azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.21",
            "verseOrgIds": [
              "LUK.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Natosaka nyonso wana wuta bolenge na ngai.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na Yesu koyoka bongo, alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.22",
            "verseOrgIds": [
              "LUK.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:22"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Ozangi eloko moko. Teka biloko na yo nyonso, kabola mbongo oyo okozwa epai ya babola, mpe okozwa bomengo kati na Likolo. Sima na yango, yaka mpe landa Ngai.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango mokambi ya Bayuda ayokaki bongo, akomaki mawa-mawa, pamba te azalaki na bozwi mingi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atalaki ye mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Ezali pasi mpo na mozwi kokota kati na Bokonzi ya Nzambe !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzokande, eleki pete mpo na shamo kolekela na lidusu ya tonga ; kasi ezali penza pasi mpo na mozwi kokota kati na Bokonzi ya Nzambe.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bayokaki Ye koloba bongo batunaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:26"
      },
      "items": [
        {
          "text": "— Bongo nani penza akoki kobikisama ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:27"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Oyo ekoki kosalema te elongo na bato, ekoki kosalema elongo na Nzambe.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo alobaki na Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:28"
      },
      "items": [
        {
          "text": "— Nkolo, totiki nyonso oyo tozalaki na yango mpo na kolanda Yo !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:29"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nazali koloba na bino penza ya solo : moto nyonso oyo atiki ndako na ye, mwasi na ye, bandeko na ye, baboti na ye to bana na ye, mpo na kozwa Bokonzi ya Nzambe lokola litomba,",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "akozwa, na tango oyo, biloko mingi koleka ; mpe na tango oyo ezali koya, bomoi ya seko.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu asakoli lisusu kufa mpe lisekwa na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.20.17-MAT.20.19"
          },
          "items": [
            {
              "text": "Mat 20.17-19",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.32-MRK.10.34"
          },
          "items": [
            {
              "text": "Mlk 10.32-34",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abendaki na pembeni bayekoli na Ye zomi na mibale mpe alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:31"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Tozali kokende na Yelusalemi ; makambo nyonso oyo basakoli bakoma na tina na Mwana na Moto ekokokisama.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bakokaba Ye na maboko ya bapagano, bakoseka Ye, bakofinga Ye, bakobwakela Ye soyi,",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "bakobeta Ye fimbu mpe bakoboma Ye ; mpe, na mokolo ya misato, akosekwa.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayekoli basosolaki ata eloko moko te kati na makambo yango ; ndimbola na yango ezalaki ya kobombama mpo na bango, mpe bayebaki te makambo oyo Yesu azalaki kolobela.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.34",
            "verseOrgIds": [
              "LUK.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu abikisi mokufi miso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.20.29-MAT.20.34"
          },
          "items": [
            {
              "text": "Mat 20.29-34",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.46-MRK.10.52"
          },
          "items": [
            {
              "text": "Mlk 10.46-52",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Yesu akomaki pene ya Jeriko, ezalaki na mokufi miso pembeni ya nzela, azalaki ya kovanda mpe azalaki kosenga-senga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.35",
            "verseOrgIds": [
              "LUK.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango ayokaki makelele ya ebele ya bato oyo bazali koleka, atunaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.36",
            "verseOrgIds": [
              "LUK.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:36"
      },
      "items": [
        {
          "text": "— Likambo nini oyo ezali kosalema ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.37",
            "verseOrgIds": [
              "LUK.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:37"
      },
      "items": [
        {
          "text": "— Yesu ya Nazareti azali koleka !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agangaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.38",
            "verseOrgIds": [
              "LUK.18.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:38"
      },
      "items": [
        {
          "text": "— Yesu, Mwana ya Davidi, yokela ngai mawa !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bazalaki liboso bapamelaki ye mpe balobaki na ye ete akanga monoko ; kasi, ye, agangaki lisusu makasi koleka :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.39",
            "verseOrgIds": [
              "LUK.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:39"
      },
      "items": [
        {
          "text": "— Mwana ya Davidi, yokela ngai mawa !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atelemaki mpe atindaki ete bamemela Ye mokufi miso yango. Tango akomaki pene na Ye, Yesu atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.40",
            "verseOrgIds": [
              "LUK.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Olingi nasala nini mpo na yo ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 18:41"
      },
      "items": [
        {
          "text": "Mokufi miso azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.41",
            "verseOrgIds": [
              "LUK.18.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:41"
      },
      "items": [
        {
          "text": "— Nkolo, nalingi komona.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.42",
            "verseOrgIds": [
              "LUK.18.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "LUK 18:42"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mona ! Kondima na yo ebikisi yo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
