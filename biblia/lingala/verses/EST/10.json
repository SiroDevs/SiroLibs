        {
          "text": "Lokumu ya Maridoshe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi Kizerisesi akataki mpako mpo na bato ya mokili na ye ya bokonzi kino na bituka oyo ezalaki pene ya ebale.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo misala nyonso ya bokonzi mpe ya nguya na ye, elongo na makambo nyonso ya lokumu ya Maridoshe oyo mokonzi atombolaki, ekomamaki kati na buku ya masolo ya bakonzi ya Medi mpe ya Persi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyuda Maridoshe azalaki moto ya mibale kati na bokonzi sima na mokonzi Kizerisesi. Maridoshe azalaki moto monene mpe ya lokumu na miso ya Bayuda, bandeko na ye ; pamba te azalaki koluka bolamu ya bato na ye mpe kobundela bolamu ya Bayuda nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
  ],
