            "number": "1",
            "style": "v",
            "sid": "PRO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masese ya Salomo :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 10:1"
      },
      "items": [
        {
          "text": "Mwana ya bwanya asepelisaka tata na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:1"
      },
      "items": [
        {
          "text": "kasi mwana ya zoba ayokisaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:1"
      },
      "items": [
        {
          "text": "mama na ye pasi na motema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bomengo oyo ezwami na nzela ya mabe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:2"
      },
      "items": [
        {
          "text": "epesaka litomba te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:2"
      },
      "items": [
        {
          "text": "kasi bosembo ekangolaka na kufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atikaka te ete moto ya sembo akufa nzala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:3"
      },
      "items": [
        {
          "text": "kasi apimelaka bato mabe biloko oyo bazali na yango posa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maboko ya goyigoyi ekomisaka moto mobola,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:4"
      },
      "items": [
        {
          "text": "kasi maboko oyo esalaka ekomisaka moto mozwi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo abombaka biloko na eleko ya mvula azali mwana mayele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:5"
      },
      "items": [
        {
          "text": "kasi moto oyo alalaka pongi na eleko ya kobuka mbuma",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:5"
      },
      "items": [
        {
          "text": "azali mwana ya soni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapamboli ezali na likolo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:6"
      },
      "items": [
        {
          "text": "ya moto ya moto ya sembo lokola motole,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:6"
      },
      "items": [
        {
          "text": "kasi monoko ya moto mabe ebombaka bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makanisi ya moto ya sembo ezali na lipamboli,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:7"
      },
      "items": [
        {
          "text": "kasi bakobosana kombo ya moto mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema ya bwanya endimaka mibeko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:8"
      },
      "items": [
        {
          "text": "kasi moto oyo alobaka makambo ya bozoba",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:8"
      },
      "items": [
        {
          "text": "amilukelaka libebi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya sembo atambolaka na kimia,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:9"
      },
      "items": [
        {
          "text": "kasi moto oyo atambolaka na banzela etengama-tengama",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:9"
      },
      "items": [
        {
          "text": "akobima na pwasa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo afinaka liso na mayele mabe alukaka mobulu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:10"
      },
      "items": [
        {
          "text": "kasi moto oyo apamelaka na bosolo alukaka kimia.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monoko ya moto ya sembo ezali etima ya bomoi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:11"
      },
      "items": [
        {
          "text": "kasi monoko ya moto mabe ebombaka makambo mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koyina ebendaka koswana,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:12"
      },
      "items": [
        {
          "text": "kasi bolingo ezipaka mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibebu ya moto ya mayele ezalaka na bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:13"
      },
      "items": [
        {
          "text": "kasi fimbu ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:13"
      },
      "items": [
        {
          "text": "mpo na mokongo ya moto oyo azangi mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya bwanya abombaka boyebi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:14"
      },
      "items": [
        {
          "text": "kasi monoko ya zoba ebendaka pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
