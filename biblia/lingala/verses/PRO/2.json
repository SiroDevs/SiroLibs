          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bato oyo nzela na bango etengama-tengama",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.15",
            "verseOrgIds": [
              "PRO.2.15"
            ]
          }
        }
      ]
