      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:12"
      },
      "items": [
        {
          "text": "na moto oyo alobaka makambo ezanga tina,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.12",
            "verseOrgIds": [
              "PRO.2.12"
            ]
          }
        }
      ]
    },
