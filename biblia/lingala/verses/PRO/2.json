    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bwanya : bomengo oyo ebombama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai, soki ondimi maloba na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:1"
      },
      "items": [
        {
          "text": "mpe obateli kati na motema na yo mibeko na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.1",
            "verseOrgIds": [
              "PRO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki opesi litoyi na yo na maloba ya bwanya",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:2"
      },
      "items": [
        {
          "text": "mpe okabi motema na yo na makambo ya mayele ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.2",
            "verseOrgIds": [
              "PRO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki obeleli mayele",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:3"
      },
      "items": [
        {
          "text": "mpe ogangi epai ya bososoli ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.3",
            "verseOrgIds": [
              "PRO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki oluki yango penza ndenge balukaka palata",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:4"
      },
      "items": [
        {
          "text": "to bomengo oyo ebombama,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.4",
            "verseOrgIds": [
              "PRO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okososola solo soki kotosa Yawe elakisi nini",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:5"
      },
      "items": [
        {
          "text": "mpe okozwa boyebi ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.5",
            "verseOrgIds": [
              "PRO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe nde apesaka bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:6"
      },
      "items": [
        {
          "text": "mpe maloba ya monoko na Ye epesaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 2:6"
      },
      "items": [
        {
          "text": "mayele mpe bososoli.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.2.6",
            "verseOrgIds": [
              "PRO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
