{
  "id": "PRO.7",
  "number": "7",
  "bookId": "PRO",
  "reference": "Masese 7",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PRO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Makebisi mpo na mwasi ya ndumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana na ngai, batela mibeko na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:1"
      },
      "items": [
        {
          "text": "mpe bomba yango malamu kati na motema na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batela mateya na ngai malamu, mpe okozala na bomoi ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:2"
      },
      "items": [
        {
          "text": "batela mibeko na ngai lokola mbuma ya liso na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lata yango na loboko na yo lokola lopete,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:3"
      },
      "items": [
        {
          "text": "koma yango na etando ya motema na yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na Bwanya : « Ozali ndeko na ngai ya mwasi, »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:4"
      },
      "items": [
        {
          "text": "mpe bengaka Mayele « Moninga na ngai ; »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete ekoka kobatela yo liboso ya mwasi ya ndumba",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:5"
      },
      "items": [
        {
          "text": "mpe ekoka kokebisa yo liboso ya mwasi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:5"
      },
      "items": [
        {
          "text": "oyo alobaka maloba ya elengi, nzokande ezali ya lokuta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, nazalaki kotala wuta na madusu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:6"
      },
      "items": [
        {
          "text": "ya lininisa ya ndako na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "namonaki kati na molongo ya bato oyo bazangi mayele,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "kati na bilenge mibali,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "elenge mobali moko oyo azangi penza mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azalaki koleka na balabala,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:8"
      },
      "items": [
        {
          "text": "pene ya esika oyo mwasi wana ya ndumba avandaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 7:8"
      },
      "items": [
        {
          "text": "mpe akotaki na nzela oyo ekenda",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:8"
      },
      "items": [
        {
          "text": "kino na ndako ya mwasi ya ndumba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki na pokwa, tango moyi elimwaki,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:9"
      },
      "items": [
        {
          "text": "mpe molili ya butu ekomaki koya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe tala, mwasi yango ya ndumba ayaki",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:10"
      },
      "items": [
        {
          "text": "kokutana na elenge mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 7:10"
      },
      "items": [
        {
          "text": "alataki penza lokola mwasi ya ndumba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:10"
      },
      "items": [
        {
          "text": "mpe motema na ye etonda na mayele mabe ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "azalaki mwasi ya makelele makasi mpe ya mobulu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:11"
      },
      "items": [
        {
          "text": "makolo na ye evandaka na ndako te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "atalaka-talaka na bisika nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:12"
      },
      "items": [
        {
          "text": "tango mosusu na libanda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:12"
      },
      "items": [
        {
          "text": "tango mosusu na bisika oyo bato ebele bakutanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasi yango ya ndumba asimbaki elenge mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:13"
      },
      "items": [
        {
          "text": "ayambaki ye, alaliselaki ye miso mpe alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Nazalaki na niongo ya mbeka ya kozongisa",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:14"
      },
      "items": [
        {
          "text": "matondi epai na Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:14"
      },
      "items": [
        {
          "text": "mpe lelo, nasili kokokisa ndayi na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, nabimaki mpo na kokutana na yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:15"
      },
      "items": [
        {
          "text": "nazalaki koluka yo, mpe, tala, namoni yo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natandi mbeto na ngai na babulangeti",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:16"
      },
      "items": [
        {
          "text": "ya langi ya ndenge na ndenge, basala na basinga ya lino",
