    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokende sango ya malamu ezali malamu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:1"
      },
      "items": [
        {
          "text": "koleka kozala na bomengo mingi ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:1"
      },
      "items": [
        {
          "text": "lokumu ezali malamu koleka palata mpe wolo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozwi mpe mobola bazali na likambo moko ya lisanga :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:2"
      },
      "items": [
        {
          "text": "ezali Yawe nde azali Mokeli na bango mibale.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya mayele amonaka likama na mosika mpe amibombaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:3"
      },
      "items": [
        {
          "text": "kasi moto oyo azangi mayele akoleka wana mpe akokutana na pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komikitisa mpe kotosa Yawe ememaka",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:4"
      },
      "items": [
        {
          "text": "bozwi, lokumu mpe bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzela ya bato mabe ezalaka na banzube mpe mitambo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:5"
      },
      "items": [
        {
          "text": "kasi moto oyo abatelaka molimo na ye azalaka mosika na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakisa mwana nzela oyo asengeli kotambola wuta na bomwana na ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:6"
      },
      "items": [
        {
          "text": "ezala tango akokoma mokolo, akobunga yango te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozwi azalaka mokonzi ya mobola,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:7"
      },
      "items": [
        {
          "text": "mpe modefi azalaka mowumbu ya modefisi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo alonaka masumu abukaka pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:8"
      },
      "items": [
        {
          "text": "mpe makasi ya kanda na ye nyonso ekosuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo akabaka na esengo akopambolama,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:9"
      },
      "items": [
        {
          "text": "pamba te akabolaka bilei na ye na mobola.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bengana motioli,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:10"
      },
      "items": [
        {
          "text": "bongo kowelana, koswana mpe kofingana ekosila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo alingaka kozala peto na motema,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:11"
      },
      "items": [
        {
          "text": "oyo ngolu ezalaka na bibebu na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:11"
      },
      "items": [
        {
          "text": "mokonzi azalaka molingami na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miso na Yawe ebatelaka boyebi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:12"
      },
      "items": [
        {
          "text": "kasi akweyisaka maloba ya moto oyo azangi mayele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ya goyigoyi alobaka : « Nkosi ezali kuna na libanda,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:13"
      },
      "items": [
        {
          "text": "ekoboma ngai na kati-kati ya balabala. »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monoko ya mwasi ya ndumba ezalaka lokola libulu ya mozindo ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:14"
      },
      "items": [
        {
          "text": "moto oyo Yawe asilikeli akweyaka kuna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motema ya mwana moke ezalaka na bozoba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:15"
      },
      "items": [
        {
          "text": "bongo fimbu ya pamela elongolaka yango kati na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo anyokolaka mobola",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:16"
      },
      "items": [
        {
          "text": "mpo ete akoma na bomengo mingi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 22:16"
      },
      "items": [
        {
          "text": "mpe oyo apesaka mozwi bakado bakokweya na bobola.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya bato ya bwanya",
          "type": "text"
        }
      ]
    },
    {
