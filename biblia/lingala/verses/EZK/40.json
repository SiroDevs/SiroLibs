          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto yango alobaki na ngai : « Shambre oyo etala na ngambo ya sude ezali mpo na Banganga-Nzambe oyo basalaka mosala na Tempelo ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
            "verseOrgIds": [
              "EZK.40.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 40:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe shambre oyo etala na ngambo ya nor ezali mpo na Banganga-Nzambe oyo basalaka mosala ya etumbelo. Kati na bakitani ya Levi, bana mibali ya Tsadoki kaka nde bakoki kokota na Tempelo mpo na kosala mosala liboso ya Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.46",
            "verseOrgIds": [
              "EZK.40.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
