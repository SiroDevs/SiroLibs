            }
          ]
        },
        {
          "text": "Botika mabe na bino nyonso oyo bozalaki kosala ; bozwa mitema ya sika mpe molimo ya sika. Mpo na nini bokolinga kokufa, oh libota ya Isalaele ?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.31",
