    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kokweyisama ya Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2CH.36.17-2CH.36.20"
          },
          "items": [
            {
              "text": "2Ma 36.17-20",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Sedesiasi akokisaki mibu libwa na bokonzi, na mokolo ya zomi ya sanza mpe ya zomi, Nabukodonozori, mokonzi ya Babiloni, elongo na mampinga na ye nyonso, ayaki kobundisa Yelusalemi. Batongaki molako na bango libanda ya engumba, mpe atongaki mabulu mpo na kobombama, na zingazinga na yango nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engumba yango ezingelamaki kino na mobu ya zomi na moko ya bokonzi ya Sedesiasi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya libwa ya sanza ya minei, wana nzala makasi ekotaki kati na engumba mpe bato bazalaki lisusu na eloko ya kolia te,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bongo lokola lidusu moko efungwamaki kati na mir ya engumba, basoda nyonso ya Yuda bakimaki butu-butu mpe babimelaki na ekuke oyo ezalaki na kati-kati ya bamir mibale, pene ya elanga ya mokonzi, atako bato ya Babiloni bazingelaki engumba. Bakimaki na nzela ya lubwaku ya Yordani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi basoda ya Babiloni balandaki mokonzi mpe bakangaki ye kati na etando ya Jeriko epai wapi basoda na ye nyonso bakimaki ye mpe bapanzanaki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basoda ya Babiloni bakangaki mokonzi ya Yuda mpe bamemaki ye epai ya mokonzi ya Babiloni, na Ribila epai wapi bakatelaki ye etumbu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakataki mito ya bana mibali ya Sedesiasi na miso na ye ; mpe Nabukodonozori, mokonzi ya Babiloni, atobolaki miso ya Sedesiasi, apesaki mitindo ete bakanga ye minyololo ya bronze mpe bamema ye na Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bamemi bato ya Yuda na bowumbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Nabukodonozori, mokonzi ya Babiloni, akokisaki mibu zomi na libwa na bokonzi, Nebuzaradani, mokonzi ya bakengeli mpe mosali ya mokonzi ya Babiloni, ayaki na Yelusalemi na mokolo ya sambo ya sanza ya mitano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumbaki Tempelo ya Yawe, ndako ya mokonzi mpe bandako nyonso ya Yelusalemi ; atumbaki bandako nyonso ya bato minene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mampinga nyonso ya Babiloni, oyo ezalaki na se ya bokonzi ya mokonzi ya bakengeli ya mokonzi babukaki bamir oyo ezingelaki Yelusalemi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani, mokonzi ya bakengeli ya mokonzi, amemaki na bowumbu bato oyo batikalaki kati na engumba, bato oyo bamipesaki epai ya mokonzi ya Babiloni mpe bato mosusu oyo batikalaki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi mokonzi ya bakengeli ya mokonzi atikaki kati na mokili ndambo ya babola mpo na kolona vino mpe bilanga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya Babiloni babukaki makonzi ya bronze oyo ezalaki liboso ya Tempelo ya Yawe, bashario ya bronze mpe nzungu ya monene ya bronze oyo ezalaki kati na Tempelo ya Yawe, mpe bamemaki bronze na yango na Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamataki lisusu biloko nyonso ya bronze oyo bazalaki kosala na yango losambo kati na Tempelo, basani ya putulu, bapawu, bambeli, bakopo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi ya bakengeli ya mokonzi akamataki lisusu biloko nyonso ya wolo mpe ya palata : bambabola mpe basani ya kobwakela mayi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakokaki te komeka kilo ya bronze ya biloko nyonso oyo Salomo asalaki mpo na Tempelo ya Yawe : makonzi nyonso mibale, nzungu ya monene mpe bashario.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likonzi moko na moko ezalaki na bametele pene libwa na bosanda. Moto ya likonzi, oyo ezalaki na songe, ezalaki ya bronze mpe na metele pene moko na ndambo na molayi ; mpe bazingelaki yango na bililingi ya basinga oyo basala lokola monyama mpe bambuma ya grenade. Makonzi nyonso mibale mpe bililingi ya basinga oyo basala lokola monyama ezalaki ndenge moko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi ya bakengeli ya mokonzi atiaki na boloko Seraya, mokonzi ya Banganga-Nzambe ; Sofoni, molandi ya mokonzi ya Banganga-Nzambe ; mpe Banganga-Nzambe misato oyo bazalaki na mokumba ya kokengela ekotelo ya Tempelo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na bato oyo batikalaki kati na engumba, akangaki lisusu moko kati na bakalaka ya lokumu, oyo azalaki na mokumba ya kotala makambo ya basoda ya bitumba, bapesi toli mitano, mokomi mikanda ya mokonzi ya mampinga, oyo azalaki na mokumba ya kokoma bakombo ya bato ya mboka mpo na kokota na mosala ya mampinga ; mpe mibali tuku motoba ya Yuda, oyo bakutaki kati na engumba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradani, mokonzi ya bakengeli ya mokonzi, akamataki bango nyonso mpe amemaki bango epai ya mokonzi ya Babiloni, na Ribila.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokonzi ya Babiloni abomaki bango kuna na Ribila, kati na mokili ya Amati. Boye, bato ya Yuda bakendeki na bowumbu mosika ya mokili na bango.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukodonozori, mokonzi ya Babiloni, atiaki Gedalia, mwana mobali ya Ayikami mpe koko ya Shafani, lokola moyangeli ya bato oyo atikaki kati na mokili ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babomi moyangeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bakonzi nyonso ya mampinga elongo na basoda na bango bayokaki ete mokonzi ya Babiloni akomisi Gedalia moyangeli, bakendeki na Mitsipa epai ya Gedalia. Tala bakombo ya bato yango : Isimaeli, mwana mobali ya Netania ; Yoanani, mwana mobali ya Karea ; Seraya, mwana mobali ya Tanumeti, moto ya Netofa ; mpe Yazania, mwana mobali ya moto moko ya Maakati. Bakendeki kuna elongo na basoda na bango.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedalia alapaki ndayi liboso na bango mpe basoda na bango na maloba oyo : « Bobanga te kosalela bato ya Babiloni, bovanda kati na mokili, bosalela mokonzi ya Babiloni mpe bokozala na bino malamu. »",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi na sanza ya misato, Isimaeli, mwana mobali ya Netania mpe koko ya Elishama, oyo azalaki na molongo ya libota ya bokonzi, ayaki elongo na basoda zomi ; babomaki Gedalia elongo na bato ya Yuda mpe bato ya Babiloni oyo bazalaki elongo na ye, na Mitsipa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye bato nyonso, kobanda na bato ya se kino bato ya lokumu, elongo na bakonzi ya basoda, bakimaki na Ejipito, pamba te bazalaki kobanga bato ya Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeoyakini azwi ngolu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yeoyakini, mokonzi ya Yuda, akokisaki mibu tuku misato na sambo na bowumbu, Evili-Merodaki, mokonzi ya Babiloni, ayokelaki Yeoyakini, mokonzi ya Yuda, mawa mpe abimisaki ye na boloko, na mokolo ya tuku mibale na sambo ya sanza ya zomi na mibale, kaka na mobu oyo akomaki mokonzi.",
          "type": "text",
          "attrs": {
