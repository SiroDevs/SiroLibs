      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotami azalaki na mibu tuku mibale na mitano ya mbotama tango akomaki mokonzi, mpe akonzaki mibu zomi na motoba na Yelusalemi. Kombo ya mama na ye ezalaki « Yerusha. » Yerusha azalaki mwana ya Tsadoki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotami asalaki makambo ya sembo na miso ya Yawe ndenge kaka Oziasi, tata na ye, asalaki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, balongolaki te bisambelo ya likolo ya bangomba ; bato bakobaki kaka kobonza kuna bambeka mpe kotumba ansa. Ezali Yotami nde atongaki ekuke ya likolo ya Tempelo ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo mosusu oyo etali bokonzi ya Yotami mpe misala na ye, ekomama kati na buku ya masolo ya bakonzi ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo wana, Yawe abandaki kotinda Retsini, mokonzi ya Siri, mpe Peka, mwana mobali ya Remalia, mpo na kobundisa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotami akendeki kokutana na bakoko na ye, mpe bakundaki ye esika moko na bakoko na ye kati na engumba ya Davidi, koko na ye. Akazi, mwana na ye ya mobali, akitanaki na ye na bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
      ]
    }
