      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya suka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala maloba ya suka ya Davidi :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "Maloba ya Davidi, mwana mobali ya Izayi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "moto oyo atombolama na bokonzi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "mopakolami ya Nzambe ya Jakobi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:1"
      },
      "items": [
        {
          "text": "moyembi malamu ya banzembo ya Isalaele :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Molimo na Yawe alobi na nzela na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:2"
      },
      "items": [
        {
          "text": "atie maloba na Ye na monoko na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe oyo azali Libanga ya Isalaele ayebisi ngai :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "‹ Mokonzi oyo akambaka bato kati na bosembo mpe botosi epai ya Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "azali lokola pole ya tongo, tango moyi ebimaka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "mpe engalaka makasi lokola nde mapata ezali te,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "lokola kongenga ya sima na mvula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:4"
      },
      "items": [
        {
          "text": "oyo ebimisaka matiti na mokili. ›",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali bongo te mpo na libota na ngai liboso ya Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "pamba te asalaki boyokani ya libela elongo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "boyokani oyo esalema malamu na makambo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "mpe oyo Ye moko abatelaka ?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "Tango nyonso mpe na makambo nyonso, apesaki ngai elonga",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:5"
      },
      "items": [
        {
          "text": "mpe akokisaki posa ya motema na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi bato nyonso ya kilikili bazali lokola nzete ya nzube",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:6"
      },
      "items": [
        {
          "text": "oyo babwakaka mosika ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:6"
      },
      "items": [
        {
          "text": "basimbaka yango te na maboko pamba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto oyo alingi kosimba yango",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:7"
      },
      "items": [
        {
          "text": "asengeli kosalela ebende to libaya ya likonga ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 23:7"
      },
      "items": [
        {
          "text": "batumbaka yango kaka na esika oyo ezali. »",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Basoda ya mpiko ya Davidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "1CH.11.10-1CH.11.41"
          },
          "items": [
            {
              "text": "1Ma 11.10-41",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala bakombo ya basoda ya mpiko ya Davidi : Yoshebi-Bashebeti, moto ya Takimoni : azalaki mokonzi ya limpinga ya basoda misato ya mpiko, abomaki na likonga bato nkama mwambe na etumba moko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molandi na ye ezalaki Eleazari, mwana mobali ya Dodo, moto ya Aoyi : azalaki moko kati na limpinga ya basoda misato ya mpiko oyo, elongo na Davidi, babundisaki bato ya Filisitia oyo basanganaki mpo na bitumba, wana bana ya Isalaele bazalaki kokima na likolo ya bangomba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ye ayikaki mpiko kati na bitumba mpe abomaki bato ya Filisitia kino alembaki, mpe loboko na ye etikaki mopanga te. Yawe apesaki bango elonga monene na mokolo wana. Mampinga bazongaki epai ya Eleazari kaka mpo na kokamata biloko ya bato oyo bakufaki.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na ye, Shama, mwana mobali ya Age, moto ya Arari. Tango bato ya Filisitia basanganaki na Leyi epai wapi ezalaki na elanga moko etonda na misili, basoda ya Isalaele bakimaki liboso na bango.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Shama atelemaki na kati-kati ya elanga, abundelaki yango mpe abomaki bato ya Filisitia. Yawe apesaki bango elonga monene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, na ebandeli ya eleko ya kobuka bambuma, wana basoda ya bato ya Filisitia batongaki molako na bango kati na lubwaku ya Refayimi, basoda misato kati na basoda tuku misato ya mpiko bayaki epai ya Davidi, na ebombamelo ya mabanga ya Adulami.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango yango, Davidi azalaki kati na ebombamelo moko batonga makasi, mpe basoda ya Filisitia bazalaki na Beteleemi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbala moko, Davidi ayokaki posa ya mayi mpe alobaki : « Nani akomemela ngai mayi ya libulu oyo ezali pene ya ekuke ya Beteleemi mpo ete namela ? »",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basoda nyonso misato ya mpiko bakotaki na mayele kati na molako ya bato ya Filisitia, batokaki mayi na libulu oyo ezali pene ya ekuke ya Beteleemi mpe bamemaki yango epai ya Davidi. Kasi Davidi aboyaki komela mayi yango ; asopaki yango na mabele lokola likabo ya masanga mpo na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki : « Tika ete Yawe apesa ngai etumbu soki nameli mayi oyo, pamba te ezali lokola makila ya bato oyo bandimaki kokende kokufa mpo na ngai. »",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 23:17"
      },
      "items": [
        {
          "text": "Boye, Davidi aboyaki komela mayi yango. Yango nde misala ya kokamwa oyo basoda misato ya mpiko basalaki.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishayi, ndeko mobali ya Joabi mpe mwana mobali ya Tseruya, azalaki mokonzi ya basoda misato ya mpiko. Abundisaki bato nkama misato na likonga na ye mpe abomaki bango. Boye, kati na bango misato, ye nde akendeki sango koleka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na basoda misato ya mpiko, ye nde azwaki lokumu koleka mpe akomaki mokonzi na bango, kasi akokanaki te na basoda misato ya limpinga ya liboso.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya, moto ya mboka Kabitseli mpe mwana mobali ya Yeoyada, azalaki soda ya mpiko mpe asalaki makambo ebele ya kokamwa : abomaki bilombe mibale ya Moabi ; mpe na mokolo ya mvula ya pembe, akitaki na libulu moko ya mayi mpe abomaki kuna nkosi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye mpe moto abomaki mbinga mobali moko ya Ejipito, oyo asimbaki likonga na loboko na ye. Abundisaki moto yango ya Ejipito na lingenda, abotolaki ye likonga oyo azalaki na yango na loboko mpe abomaki ye na likonga na ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.21",
            "verseOrgIds": [
              "2SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango nde misala ya kokamwa oyo Benaya, mwana mobali ya Yeoyada, asalaki. Ye mpe akendeki sango kati na basoda misato ya mpiko ya lisanga ya mibale.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
            "verseOrgIds": [
              "2SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kati na basoda tuku misato ya mpiko, ye nde azalaki na lokumu monene koleka, kasi akokanaki te na basoda misato ya mpiko ya limpinga ya liboso. Mpe Davidi akomisaki ye mokonzi ya bakengeli na ye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
