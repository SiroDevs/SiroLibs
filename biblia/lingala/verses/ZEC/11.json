{
  "id": "ZEC.11",
  "number": "11",
  "bookId": "ZEC",
  "reference": "Zakari 11",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ZEC 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yawe abebisi bikolo ya nguya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili ya Libani, fungola bikuke na yo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:1"
      },
      "items": [
        {
          "text": "mpo ete moto ezikisa banzete na yo ya sedele !",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzete ya sipele, lela,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "pamba te nzete ya sedele esili kokweya !",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "Banzete milayi esili kokatama.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "Banzete ya sheni ya Bashani, bolela ;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "pamba te basili kokata zamba monene !",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyoka ndenge babateli bibwele bazali kolela,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "pamba te bitando epai wapi baleisaka bibwele ebebisami.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "Boyoka ndenge bankosi ezali koganga,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "pamba te zamba ya Yordani, oyo etonda na banzete,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "esili kobebisama.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babateli mibale ya bameme",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala liloba oyo Yawe, Nzambe na ngai, alobi :",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ZEC 11:4"
      },
      "items": [
        {
          "text": "— Batela malamu bameme oyo babongisi mpo na koboma !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo basombaka bibwele yango babomaka yango, bazalaka na somo ya etumbu ata moko te. Bato oyo batekaka yango balobaka : « Tika ete Yawe apambolama, pamba te nakomi mozwi ! » Mpe bango moko babateli na yango bayokelaka yango mawa ata moke te.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana Ngai mpe nakoyokela lisusu bato ya mokili mawa te, nakokaba moto na moto na maboko ya moninga na ye mpe ya mokonzi na ye. Bakonzi bakobebisa mokili, kasi nakokangola ata moto moko te wuta na maboko ya bakonzi yango, elobi Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, nabatelaki malamu bameme oyo babongisaki mpo na koboma ; mpe mingi penza bameme oyo ezalaki na pasi makasi. Nakamataki mangenda mibale : nabengaki moko Ngolu, mpe mosusu, Bomoko. Bongo, nakomaki kobatela bameme.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na sanza moko kaka, nabomaki babateli bibwele misato ; nakokaki lisusu kokanga motema te, mpe etonga eyinaki ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaki na etonga ya bibwele :",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ZEC 11:9"
      },
      "items": [
        {
          "text": "— Nakozala lisusu mobateli na bino te. Tika ete oyo ekokufa ekufa na yango, oyo ekobunga ebunga na yango ; mpe tika ete oyo ekotikala ebomana yango na yango !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakamataki lingenda oyo nabengaki Ngolu, nabukaki yango mpo na kotalisa ete boyokani oyo nasalaki elongo na bikolo nyonso esili.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyokani esilaki nde na mokolo wana ; bongo, etonga oyo ezalaki na pasi makasi mpe ezalaki kotala ngai esosolaki ete ezalaki solo Liloba na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ZEC 11:12"
      },
      "items": [
        {
          "text": "— Soki bomoni ete ezali malamu, bopesa ngai lifuti na ngai ; soki te, botika na bino.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 11:12"
      },
      "items": [
        {
          "text": "Bafutaki ngai mbongo ya bibende ya palata tuku misato lokola lifuti na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ZEC 11:13"
      },
      "items": [
        {
          "text": "— Bwaka yango epai ya mosali mbeki ; yango nde motuya ya malonga oyo bamoni ete ekoki na Ngai !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 11:13"
      },
      "items": [
        {
          "text": "Nakamataki mbongo yango ya bibende tuku misato mpe nabwakaki yango kati na Tempelo ya Yawe, epai ya mosali mbeki.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo nabukaki lisusu lingenda ya mibale oyo nabengaki Bomoko, mpo na kotalisa ete bondeko kati na libota ya Yuda mpe ya Isalaele ekufi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ZEC 11:15"
      },
      "items": [
        {
          "text": "— Kamata lisusu bisalelo ya mobateli bibwele ya zoba !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te nakobimisa kati na mokili mobateli bibwele ya sika oyo akobanda koluka te bibwele oyo ebungi, akolandela te bana bibwele, akosalisa te bapota ya bibwele oyo ezoki, akoleisa te oyo ezali na nzoto kolongono, kasi akobanda koliaka misuni ya bibwele ya mafuta mpe kobuka yango makolo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawa na mobateli bibwele ya zoba oyo asundolaka etonga na ye ! Tika ete mopanga ekata ye loboko mpe etobola ye liso oyo ezali na ngambo ya loboko ya mobali ! Tika ete loboko na ye ekawuka, solo, ekawuka penza ! Tika ete liso na ye, oyo ezali na ngambo ya loboko ya mobali ekufa, ekufa solo !",
          "type": "text"
        }
      ]
    }
  ],
  "next": {
    "id": "ZEC.12",
    "number": "12",
    "bookId": "ZEC"
  },
