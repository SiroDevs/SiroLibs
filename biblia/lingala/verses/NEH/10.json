    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 10:10"
      },
      "items": [
        {
          "text": "Jozue, mwana mobali ya Azania ; Binuwi, moko ya bakitani ya Enadadi ; Kadimieli",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "elongo na bandeko na bango :",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.11",
            "verseOrgIds": [
              "NEH.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 10:11"
      },
      "items": [
        {
