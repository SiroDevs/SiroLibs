            "sid": "NEH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maazia, Biligayi mpe Shemaya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 10:9"
      },
      "items": [
        {
          "text": "Ezali bango nde bazalaki Banganga-Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
