          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salu, Amoki, Ilikia, Yedaeya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
