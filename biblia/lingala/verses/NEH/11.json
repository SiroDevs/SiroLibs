          ]
        },
        {
          "text": "kati na Adidi, Tseboyimi mpe Nebalati,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.34",
            "verseOrgIds": [
              "NEH.11.34"
            ]
