          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kati na Eini-Rimoni, kati na Tsorea, kati na Yarimuti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kati na Zanoa, Adulami mpe bamboka na yango ya mike-mike, kati na Lakishi mpe bilanga na yango ya zingazinga, mpe kati na Azeka mpe bamboka na yango ya mike-mike. Boye bavandaki na etuka mobimba longwa na Beri-Sheba kino na Lubwaku ya Inomi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        }
      ]
    },
    {
