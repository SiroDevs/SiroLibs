          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petaya, mwana mobali ya Meshezabeyeli, moko kati na bakitani ya Zera, mwana mobali ya Yuda, azalaki kalaka ya mokonzi mpo na kotala makambo nyonso ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bayuda oyo bazalaki libanda ya Yelusalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato mosusu ya ekolo ya Yuda bavandaki kati na Kiriati-Ariba mpe na bamboka na yango ya mike-mike, kati na Diboni mpe bamboka na yango ya mike-mike, kati na Yekabisheli mpe bamboka na yango ya mike-mike,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kati na Yeshua, kati na Molada, kati na Beti-Paleti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kati na Atsari-Shuwali, kati na Beri-Sheba mpe bamboka na yango ya mike-mike,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kati na Tsikilagi, kati na Mekona mpe bamboka na yango ya mike-mike,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
            ]
          }
        },
        {
          "name": "verse",
