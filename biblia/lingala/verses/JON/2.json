    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libondeli ya Yona",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe atindaki mbisi moko ya monene komela Yona. Boye Yona asalaki kati na libumu ya mbisi yango mikolo misato mpe babutu misato.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.1",
            "verseOrgIds": [
              "JON.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na libumu ya mbisi, Yona asambelaki Yawe, Nzambe na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "« Kati na mawa na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "nabelelaka Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "mpe ayanolaka ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "Wuta kati na mboka ya bakufi,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "nasengaka lisungi,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "mpe ayokaka ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
