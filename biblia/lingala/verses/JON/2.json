            "sid": "JON 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ngai, na koyembaka nzembo ya matondi,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:10"
      },
      "items": [
        {
          "text": "nalingi kobanda kobonzelaka Yo bambeka",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:10"
      },
      "items": [
        {
          "text": "mpe kokokisaka bilaka oyo nazali kopesa,",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:10"
      },
      "items": [
        {
          "text": "pamba te lobiko ezali ya Yawe. »",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
