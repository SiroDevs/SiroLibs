            "sid": "JON 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe Yawe apesaki mitindo na mbisi, mpe mbala moko, mbisi esanzaki Yona na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.11",
            "verseOrgIds": [
              "JON.2.11"
            ]
          }
        }
      ]
