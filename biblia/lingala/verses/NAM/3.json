    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "bazali kotambola-tambola,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 3:3"
      },
      "items": [
        {
          "text": "mipanga ezali kongenga,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        }
      ]
    },
