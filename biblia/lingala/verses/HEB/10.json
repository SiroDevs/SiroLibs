{
  "id": "HEB.10",
  "number": "10",
  "bookId": "HEB",
  "reference": "Ba-Ebre 10",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HEB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Motuya ya mbeka ya Klisto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mobeko ya Moyize ezali kaka elilingi ya biloko oyo ekoya, ezali penza bosolo na yango te ; yango wana, ezali na makoki te ya kokomisa ya kokoka, bato oyo bapusanaka pene ya Nzambe na nzela ya bambeka ya ndenge moko kaka oyo bapesaka tango nyonso mpe mobu na mobu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki ezalaki na makoki yango, mbele bato oyo bapesaka bambeka yango balingaki wuta kala kotika kopesa yango, pamba te balingaki kopetolama mbala moko mpo na libela, mpe balingaki lisusu komitungisa te mpo na masumu na bango.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, mobu na mobu, bambeka wana ezalaki kozongisa masumu na makanisi na bango,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te makila ya bangombe ya mibali mpe ya bantaba ezali na makoki te ya kolongola masumu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tango Klisto ayaki na mokili, alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "« Ozalaki na posa te ya bambeka to ya makabo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "kasi osalaki ngai nzoto.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osepelaki te na bambeka ya kotumba",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:6"
      },
      "items": [
        {
          "text": "mpe na bambeka mpo na masumu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo nalobaki : ‹ Tala ngai oyo, nayei,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:7"
      },
      "items": [
        {
          "text": "nayei, oh Nzambe, mpo na kosala mokano na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:7"
      },
      "items": [
        {
          "text": "kolanda ndenge ekomami na tina na ngai kati na buku. › »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki liboso :",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:8"
      },
      "items": [
        {
          "text": "« Ozalaki na posa te mpe osepelaki te na bambeka, na makabo,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:8"
      },
      "items": [
        {
          "text": "na bambeka ya kotumba mpe na bambeka mpo na masumu. »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "HEB 10:8"
      },
      "items": [
        {
          "text": "Nzokande ezalaki kopesama kolanda Mibeko.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki lisusu : « Tala ngai oyo, nayei mpo na kosala mokano na Yo. » Boye, alongolaki losambo ya liboso mpo na kotia losambo ya mibale.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.9",
            "verseOrgIds": [
              "HEB.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe ezali mpo na mokano yango ya Nzambe nde topetolamaka na masumu, na nzela ya mbeka ya nzoto na Ye moko Yesu-Klisto, oyo akabaki mbala moko mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.10",
            "verseOrgIds": [
              "HEB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na kosala mosala na ye ya bonganga, Nganga-Nzambe nyonso azalaki kokende na esika na ye ya mosala mokolo na mokolo, mpe azalaki kopesa mbala na mbala bambeka ya ndenge moko oyo ezalaki kutu na makoki te ya kolongola masumu ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi sima na Klisto kobonza mbeka moko kaka mpo na masumu, avandi mpo na libela na ngambo ya loboko ya mobali ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.12",
            "verseOrgIds": [
              "HEB.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta tango wana, azali kozela ete Nzambe akomisa banguna na Ye enyatelo makolo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.13",
            "verseOrgIds": [
              "HEB.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, na nzela ya likabo moko kaka, akomisaki bato ya kokoka mpo na libela, ba-oyo apetolaki na masumu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimo Mosantu mpe azali kotatola epai na biso na tina na Ye, pamba te alobaki liboso :",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Tala boyokani oyo nakosala elongo na bango",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "sima na mikolo wana, elobi Nkolo :",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "Nakotia mibeko na Ngai kati na makanisi na bango,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "mpe nakokoma yango kati na mitema na bango. »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo na sima, abakisaki :",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "« Nakokanisa lisusu te,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "ezala masumu na bango to mabe na bango. »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, soki Nzambe alimbisi moto masumu, ezalaka lisusu te na likabo ya kopesa mpo na masumu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Koyika mpiko kati na Kondima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobatela elikya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, bandeko na ngai, tozali solo na elikya ete tokokota na Esika-Oyo-Eleki-Bule mpo ete Yesu asopaki makila na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afungolelaki biso nzela ya sika mpe ya bomoi na nzela ya rido ya Tempelo, oyo ezali nzoto na Ye moko.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, tozali na Mokonzi Monene ya Banganga-Nzambe, oyo azali Mokonzi ya Ndako ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bongo, topusana pene ya Nzambe na motema mobimba, na kondima nyonso, na motema oyo epetolami na makanisi nyonso ya mabe, mpe na nzoto oyo esukolami na mayi ya peto.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobatela makasi elikya oyo tozali kondima ete ezali ya solo, pamba te Ye oyo apesaki biso bilaka akosaka te.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosenzelana biso na biso mpo na kotindikana na bolingo mpe na misala ya malamu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokima Bandako ya Nzambe na biso te, ndenge bato mosusu bamesana kosala ; kasi tolendisana biso na biso, wana bozali komona ete mokolo ya Nkolo ekomi pene.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, soki tokobi kosala masumu na nko sima na koyeba bosolo, mbeka mosusu mpo na bolimbisi ya masumu ekozala lisusu te ;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekotikala kaka kozela na somo penza kosambisama mpe moto makasi oyo ekozikisa banguna ya Nzambe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki babomaka na mawa te moto oyo abuki Mobeko ya Moyize, na litatoli ya bato mibale to misato,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekozala boni mpo na moto oyo atioli Mwana na Nzambe, amoni pamba makila ya boyokani, oyo epetolaki ye, mpe afingi Molimo ya ngolu ?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyebi malamu Ye oyo alobaki : « Ngai nde nazongisaka mabe na mabe, Ngai nde nakofuta moto na moto ; » mpe : « Nkolo akosambisa bato na Ye. »",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali somo makasi kokweya na maboko ya Nzambe na bomoi !",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokanisa lisusu mikolo ya liboso, na tango Nzambe afungolaki bino miso mpo ete bokoma komona pole, boyikaki mpiko kati na bapasi ya makasi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezalaki na batango oyo bazalaki kofinga bino, konyokola bino na miso ya bato ; ezalaki mpe na batango oyo bozalaki kokabola pasi elongo na bato oyo bazalaki konyokwama.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokabolaki pasi elongo na bakangami ya boloko, mpe bondimaki na esengo nyonso ete babotola ata biloko na bino, pamba te boyebaki ete bozali na bomengo ya kitoko koleka, bomengo oyo ekowumela libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bobungisa elikya na bino te, pamba te lifuti monene ekangani na yango.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bongo, boyika mpiko mpo ete, sima na bino kokokisa mokano ya Nzambe, bozwa biloko oyo alakaki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etikali moke, moke penza,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "ete Ye oyo asengeli koya aya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "mpe akoya kala te.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto na ngai ya sembo akobika na nzela ya kondima ;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "kasi soki azongi sima, nakosepela na ye te.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biso tozali te na molongo ya bato oyo bazongaka sima mpo na kobungisa bomoi na bango, kasi tozali na molongo ya bato oyo bazali na kondima mpo ete tobikisama.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
            "verseOrgIds": [
              "HEB.10.39"
            ]
          }
        }
      ]
    }
  ],
