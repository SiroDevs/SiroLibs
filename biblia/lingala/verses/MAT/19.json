{
  "id": "MAT.19",
  "number": "19",
  "bookId": "MAT",
  "reference": "Matayo 19",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "MAT 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mateya na tina na koboma libala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.1-MRK.10.12"
          },
          "items": [
            {
              "text": "Mlk 10.1-12",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu asilisaki koloba makambo wana, alongwaki na Galile mpe akendeki na etuka ya Yuda, na ngambo mosusu ya Yordani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebele penza ya bato balandaki Ye, mpe abikisaki bango kuna.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.2",
            "verseOrgIds": [
              "MAT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafarizeo bapusanaki pene na Ye mpo na komeka Ye ; bapesaki Ye motuna :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.3",
            "verseOrgIds": [
              "MAT.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:3"
      },
      "items": [
        {
          "text": "— Boni, mibeko na biso epesi nzela na mobali ya kobengana mwasi na ye na libala mpo na likambo songolo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.4",
            "verseOrgIds": [
              "MAT.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Boni, botangi te ete, na ebandeli, Mokeli « akelaki bango mobali mpe mwasi, »",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpe ete alobaki : « Yango wana mobali akotika tata na ye mpe mama na ye, akosangana na mwasi na ye, bongo bango mibale bakokoma nzoto moko ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye, bazali lisusu bato mibale te, kasi bakomi moto moko. Tika ete moto akabola te oyo Nzambe asangisi ! »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Bafarizeo balobaki na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.7",
            "verseOrgIds": [
              "MAT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:7"
      },
      "items": [
        {
          "text": "— Bongo mpo na nini Moyize atindaki ete mobali apesa mwasi na ye mokanda ya koboma libala soki bakabwani na libala ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.8",
            "verseOrgIds": [
              "MAT.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Moyize apesaki bino nzela ya kobengana basi na bino na mabala, pamba te mitema na bino ezali mabanga ; na ebandeli, ezalaki bongo te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino : Soki mobali alongoli mwasi na ye na libala, longola kaka soki akweyaki na ekobo, mpe abali mwasi mosusu asali ekobo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayekoli balobaki na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.10",
            "verseOrgIds": [
              "MAT.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:10"
      },
      "items": [
        {
          "text": "— Soki mobali asengeli kozala bongo liboso ya mwasi na ye, wana eleki malamu mpo na mobali ete abala te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.11",
            "verseOrgIds": [
              "MAT.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mibali nyonso bakoki kondima mateya oyo te, kaka ba-oyo bapesameli makoki mpo na yango.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ezali na tina misato oyo esalaka ete mibali mosusu babala te : ezali na mibali oyo, wuta na mabumu ya bamama na bango, bakoki kobala te ; ezali na mibali oyo baboma bango mokongo ; ezali mpe lisusu na mibali oyo bango moko baboya kobala mpo na Bokonzi ya Likolo. Tika ete moto oyo azali na makoki ya kondima mateya oyo andima yango !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ayambi bana mike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.13-MRK.10.16"
          },
          "items": [
            {
              "text": "Mlk 10.13-16",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.18.15-LUK.18.17"
          },
          "items": [
            {
              "text": "Lk 18.15-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bamemaki bana mike epai ya Yesu mpo ete atia bango maboko mpe asambela mpo na bango. Kasi bayekoli bapamelaki bato oyo bamemaki bana yango.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.13",
            "verseOrgIds": [
              "MAT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.14",
            "verseOrgIds": [
              "MAT.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:14"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Botika bana mike baya epai na Ngai, bopekisa bango te koya epai na Ngai ; pamba te Bokonzi ya Likolo ezali mpo na bato oyo bazali lokola bango.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atielaki bango maboko, mpe alongwaki wana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.15",
            "verseOrgIds": [
              "MAT.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bazwi mpe Bokonzi ya Nzambe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.17-MRK.10.31"
          },
          "items": [
            {
              "text": "Mlk 10.17-31",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.18.18-LUK.18.30"
          },
          "items": [
            {
              "text": "Lk 18.18-30",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elenge mobali moko apusanaki pene na Yesu mpe atunaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.16",
            "verseOrgIds": [
              "MAT.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:16"
      },
      "items": [
        {
          "text": "— Moteyi, likambo nini ya malamu nasengeli kosala mpo ete nazwa bomoi ya seko ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mpo na nini ozali kotuna Ngai na tina na oyo ezali malamu ? Moko kaka azali malamu. Soki olingi kokota kati na bomoi, tosa mibeko.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elenge mobali yango atunaki lisusu :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:18"
      },
      "items": [
        {
          "text": "— Mibeko nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 19:18"
      },
      "items": [
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
              "MAT.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:18"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Okobomaka te, okosalaka ekobo te, okoyibaka te, okolobaka litatoli ya lokuta te,",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "okotosaka tata mpe mama na yo mpe okolingaka moninga na yo ndenge yo moko omilingaka.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elenge mobali alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:20"
      },
      "items": [
        {
          "text": "— Natosaka mibeko wana nyonso ; nasala lisusu nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Soki olingi kozala moto ya kokoka, kende, teka biloko na yo mpe pesa epai ya babola mbongo oyo okozwa ; bongo okozwa bomengo kati na Likolo. Sima na yango, yaka mpe landa Ngai.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango elenge mobali ayokaki bongo, akendeki na mawa, pamba te azalaki na bozwi mingi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bayekoli na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:23"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nazali koloba na bino penza ya solo : ezali pasi mpo na mozwi kokota kati na Bokonzi ya Likolo !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino lisusu : ezali pete mpo na shamo kolekela na lidusu ya tonga, kasi ezali penza pasi mpo na mozwi kokota kati na Bokonzi ya Nzambe.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bayekoli bayokaki Yesu koloba bongo, bakamwaki mingi mpe bakomaki kotunana :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:25"
      },
      "items": [
        {
          "text": "— Bongo nani penza akoki kobikisama ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Yesu atalaki bango, alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:26"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Na bato, ekoki kosalema te ; kasi na Nzambe, nyonso ekoki kosalema !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petelo azwaki maloba mpe alobaki na Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:27"
      },
      "items": [
        {
          "text": "— Biso, totiki nyonso mpo na kolanda Yo ! Ekozala boni mpo na biso ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 19:28"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Nazali koloba na bino penza ya solo : tango makambo nyonso ekokoma ya sika, tango Mwana na Moto akovanda na Kiti ya Bokonzi na Ye ya nkembo, bino bato oyo bozali kolanda Ngai, bino mpe bokovanda na bakiti zomi na mibale ya bokonzi, mpo na koyangela mabota zomi na mibale ya Isalaele.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe moto nyonso oyo atiki bandako, bandeko ya mibali, bandeko ya basi, tata, mama, bana to bilanga mpo na Kombo na Ngai akozwa yango koleka mbala nkama elongo na bomoi ya seko.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kati na bato oyo bazali sik'oyo bato ya liboso, ebele bakokoma bato ya suka ; mpe kati na ba-oyo bazali sik'oyo bato ya suka, ebele bakokoma bato ya liboso.",
              "type": "text"
            }
          ]
        }
      ]
    }
  ],
