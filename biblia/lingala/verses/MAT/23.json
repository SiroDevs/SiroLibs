          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe moto oyo alapi ndayi na kombo ya Likolo alapi yango na kombo ya Kiti ya Bokonzi ya Nzambe mpe na Kombo ya Ye oyo avandelaka yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.22",
                "verseOrgIds": [
                  "MAT.23.22"
                ]
              }
            }
          ]
        }
