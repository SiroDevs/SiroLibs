        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yelusalemi, Yelusalemi, yo oyo obomaka basakoli mpe obambaka bato oyo Nzambe atindelaka yo mabanga, mbala boni nalingaki kosangisa bana na yo, ndenge soso ya mwasi esangisaka bana na yango na se ya mapapu na yango, kasi boboyaki !",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.37",
                "verseOrgIds": [
                  "MAT.23.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
