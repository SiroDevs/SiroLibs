        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sik'oyo, ndako na bino ezali kosundolama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.38",
                "verseOrgIds": [
                  "MAT.23.38"
                ]
