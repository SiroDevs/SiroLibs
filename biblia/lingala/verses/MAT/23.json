            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokoba malamu na mosala oyo batata na bino babandaki, mosala ya koboma basakoli !",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.32",
                "verseOrgIds": [
                  "MAT.23.32"
                ]
              }
            }
