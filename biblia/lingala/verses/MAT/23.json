              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bolobaka : ‹ Soki tozalaki na bomoi na tango ya bakoko na biso, tolingaki kosangana te elongo na bango mpo na kotangisa makila ya basakoli. ›",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.30",
                "verseOrgIds": [
                  "MAT.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye, na maloba na bino moko, bondimaka ete bozali penza bakitani ya bato oyo babomaki basakoli.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.31",
                "verseOrgIds": [
                  "MAT.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
