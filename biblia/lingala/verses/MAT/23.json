        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino penza ya solo : etumbu oyo esengeli mpo na mabe wana nyonso ekokweyela bato ya ekeke oyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.36",
