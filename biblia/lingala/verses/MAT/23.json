              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpo ete makila ya bato nyonso ya sembo, oyo basopa na mabele, etangama na mito na bino, kobanda na makila ya Abele, moto ya sembo, kino na makila ya Zakari, mwana mobali ya Barashi, oyo bobomaki kati ya Tempelo mpe etumbelo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.35",
                "verseOrgIds": [
                  "MAT.23.35"
                ]
