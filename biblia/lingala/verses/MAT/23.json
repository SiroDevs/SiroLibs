        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bino, banyoka, libota ya bitupa ! Ndenge nini bokoki kokanisa ete bokokima etumbu ya lifelo ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.33",
                "verseOrgIds": [
