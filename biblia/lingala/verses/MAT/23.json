        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na ebele ya bato mpe na bayekoli na Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Balakisi ya Mobeko mpe Bafarizeo bazali na mokumba ya koteya bato mibeko ya Moyize.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.2",
                "verseOrgIds": [
                  "MAT.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye, bosengeli kosala keba na mateya nyonso oyo bateyaka bino, mpe bobongisa etamboli na bino kolanda mateya na bango ; kasi bomekola te misala na bango, pamba te batiaka mateya na bango na misala te.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.3",
                "verseOrgIds": [
                  "MAT.23.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Babongisaka mikumba ya kilo makasi mpe batiaka yango na mapeka ya bato mosusu, kasi bango moko balingaka ata moke te kotombola mosapi oyo ya moke mpo na kosunga bato yango na komema mikumba yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.4",
                "verseOrgIds": [
                  "MAT.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.4",
            "verseOrgIds": [
              "MAT.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Misala nyonso oyo basalaka, basalaka yango kaka mpo ete bato bamona bango. Boye, bayeisaka minene mikanda na bango, oyo bakoma biteni ya Makomi, mpe milayi, basonge ya banzambala na bango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.5",
                "verseOrgIds": [
                  "MAT.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Balingaka kovanda na bisika ya lokumu kati na bafeti, mpe na bisika ya liboso kati na bandako ya mayangani ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.6",
                "verseOrgIds": [
                  "MAT.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "balingaka ete bato bapesa bango mbote, na bisika oyo bato ebele bakutanaka, mpe babenga bango ‹ Moteyi. ›",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.7",
                "verseOrgIds": [
                  "MAT.23.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi bino, bolinga te ete bato babenga bino ‹ Moteyi, › pamba te bozali na Moteyi kaka moko, mpe bino nyonso bozali bandeko.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.8",
                "verseOrgIds": [
                  "MAT.23.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bobenga moto moko te awa na mokili ‹ Tata, › pamba te bozali kaka na Tata moko, mpe azali kati na Likolo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.9",
                "verseOrgIds": [
                  "MAT.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bolinga te ete bato babenga bino ‹ bakonzi, › pamba te bozali kaka na Mokonzi moko, Klisto.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.10",
                "verseOrgIds": [
                  "MAT.23.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto oyo aleki monene kati na bino akozala mosali na bino.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.11",
                "verseOrgIds": [
                  "MAT.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te moto oyo amitombolaka, bakokitisa ye ; mpe oyo amikitisaka, bakotombola ye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.12",
                "verseOrgIds": [
                  "MAT.23.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mawa na bino, balakisi ya Mobeko mpe Bafarizeo, bato ya bilongi mibale ! Bokangaka nzela mpo ete bato mosusu bakota te kati na Bokonzi ya Likolo ; bino moko, bozali kokota kuna te, kasi bozali lisusu kokanga nzela mpo ete bato oyo bazali na posa ya kokota bakota te.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.13",
                "verseOrgIds": [
                  "MAT.23.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 23:13"
      },
      "items": [
        {
          "text": "[",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.13",
            "verseOrgIds": [
              "MAT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mawa na bino, balakisi ya Mobeko mpe Bafarizeo, bato ya bilongi mibale ! Boyibaka biloko ya basi oyo bakufisa mibali, mpe bosalaka mabondeli ya milayi-milayi mpo na kokosa bato. Mpo na yango, bokozwa etumbu oyo eleki makasi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.14",
                "verseOrgIds": [
                  "MAT.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": "]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mawa na bino, balakisi ya Mobeko mpe Bafarizeo : bato ya bilongi mibale ! Bosalaka mibembo na ebale mpe na mokili mpo na koluka kozwa kaka mopagano moko oyo akondima kosambela na lingomba na bino ; mpe soki kaka andimi, bokomisaka ye moto ya lifelo mbala mibale koleka bino moko.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.15",
                "verseOrgIds": [
                  "MAT.23.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mawa na bino, batambolisi bakufa miso ! Bolobaka : ‹ Soki moto alapi ndayi na kombo ya Tempelo, wana ezali likambo te ; kasi soki alapi ndayi na kombo ya wolo ya Tempelo, wana asengeli kokokisa ndayi na ye. ›",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.16",
                "verseOrgIds": [
                  "MAT.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bino, bakufi miso, bozali penza bazoba ! Eloko nini eleki motuya : wolo to Tempelo oyo ekomisaka wolo bule ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.17",
                "verseOrgIds": [
                  "MAT.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bolobaka lisusu : ‹ Soki moto alapi ndayi na kombo ya etumbelo, wana ezali likambo te ; kasi soki alapi ndayi na kombo ya likabo oyo ezali na likolo ya etumbelo, asengeli kokokisa ndayi na ye. ›",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.18",
                "verseOrgIds": [
                  "MAT.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bakufi miso ! Eloko nini eleki motuya : likabo to etumbelo oyo ekomisi likabo bule ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.19",
                "verseOrgIds": [
                  "MAT.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te moto oyo alapi ndayi na kombo ya etumbelo alapi yango na kombo ya etumbelo yango mpe na kombo ya biloko nyonso oyo ezali na likolo na yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.20",
                "verseOrgIds": [
                  "MAT.23.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Moto oyo mpe alapi ndayi na kombo ya Tempelo alapi yango na kombo ya Tempelo yango mpe na Kombo ya Ye oyo avandaka kati na yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.21",
                "verseOrgIds": [
                  "MAT.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
