        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mawa na bino, balakisi ya Mobeko mpe Bafarizeo, bato ya bilongi mibale ! Botongaka bakunda mpo na basakoli, mpe bokomisaka kitoko malita ya bato ya sembo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.29",
                "verseOrgIds": [
                  "MAT.23.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
              "MAT.23.29"
            ]
          }
        },
        {
          "name": "verse",
