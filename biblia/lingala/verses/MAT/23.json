              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mawa na bino, balakisi ya Mobeko mpe Bafarizeo, bato ya bilongi mibale ! Bozali lokola bakunda oyo bapakola langi ya pembe : emonanaka kitoko na libanda, kasi etonda na mikuwa ya bakufi mpe na lolenge nyonso ya mbindo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
                  "MAT.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndenge moko mpe mpo na bino : na libanda, bomonanaka lokola bato ya sembo na miso ya bato ; kasi na kati, botondi na lokuta mpe na mabe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.28",
                "verseOrgIds": [
                  "MAT.23.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
