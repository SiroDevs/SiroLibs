        "sid": "MAT 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Kosambisa te na esika ya Nkolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.37-LUK.6.42"
          },
          "items": [
            {
              "text": "Lk 6.37-42",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bosambisaka te mpo ete, bino mpe, basambisa bino te.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.1",
                "verseOrgIds": [
                  "MAT.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.1",
            "verseOrgIds": [
              "MAT.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te bakosambisa bino ndenge kaka bino bosambisaka baninga, mpe bakomeka bino na emekelo kaka oyo bino bosalelaka mpo na komeka bato mosusu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.2",
                "verseOrgIds": [
                  "MAT.7.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpo na nini ozali kotala mwa lititi oyo ezali kati na liso ya ndeko na yo, wana ozali komona te nzete oyo ezali kati na liso na yo moko ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.3",
                "verseOrgIds": [
                  "MAT.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.3",
            "verseOrgIds": [
              "MAT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndenge nini okoki koloba na ndeko na yo : ‹ Ndeko na ngai, tika ete nalongola yo mwa lititi oyo ezali kati na liso, › wana ozali na nzete kati na liso na yo ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.4",
                "verseOrgIds": [
                  "MAT.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.4",
            "verseOrgIds": [
              "MAT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bolole ! Banda nanu kolongola nzete oyo ezali kati na liso na yo, bongo miso na yo ekomona malamu mpo ete okoka kolongola mwa lititi oyo ezali kati na liso ya ndeko na yo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.5",
                "verseOrgIds": [
                  "MAT.7.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bopesa te biloko ya bule epai ya bambwa, noki te ekozongela bino mpo na koswa bino ; bobwaka te bapawuni na bino ya talo epai ya bangulu, noki te ekonyata-nyata yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.6",
                "verseOrgIds": [
                  "MAT.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Molende na mabondeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.11.9-LUK.11.13"
          },
          "items": [
            {
              "text": "Lk 11.9-13",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bosenga, mpe bakopesa bino ; boluka, mpe bokomona ; bobeta ekuke, mpe bakofungolela bino ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.7",
                "verseOrgIds": [
                  "MAT.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "pamba te moto nyonso oyo asengaka azwaka, moto oyo alukaka amonaka ; mpe moto oyo abetaka ekuke, bafungolelaka ye yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.8",
                "verseOrgIds": [
                  "MAT.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.8",
            "verseOrgIds": [
              "MAT.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nani kati na bino apesaka na mwana na ye libanga, soki asengi ye lipa ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.9",
                "verseOrgIds": [
                  "MAT.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To nani apesaka na mwana na ye nyoka soki asengi mbisi ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.10",
                "verseOrgIds": [
                  "MAT.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Soki bino bato oyo bozali kutu mabe boyebi kopesa na bana na bino biloko ya malamu, ndenge nini Tata na bino oyo azali na Likolo apesa te biloko ya kitoko epai ya bato oyo basengaka Ye yango ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.11",
                "verseOrgIds": [
                  "MAT.7.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.31"
          },
          "items": [
            {
              "text": "Lk 6.31",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nyonso oyo bolingaka ete bato mosusu basalela bino, bino mpe bosalaka yango mpo na bango ; pamba te yango nde mateya nyonso ya Mobeko mpe ya basakoli.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.12",
                "verseOrgIds": [
                  "MAT.7.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Banzela mibale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.13.23-LUK.13.24"
          },
          "items": [
            {
              "text": "Lk 13.23-24",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokotela na ekuke ya moke ; pamba te ekuke mpe nzela oyo ememaka na libebi ezali monene, mpe bato ebele bakotelaka wana.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.13",
                "verseOrgIds": [
                  "MAT.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi ekuke to nzela oyo ememaka na bomoi ezali moke, mpe bato moke kaka nde bamonaka yango.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.14",
                "verseOrgIds": [
                  "MAT.7.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Basakoli ya lokuta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.6.43-LUK.6.44"
          },
          "items": [
            {
              "text": "Lk 6.43-44",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bosala keba na basakoli ya lokuta ! Tango bayaka epai na bino, bazwaka lolenge ya bameme, kasi bazali penza bambwa ya zamba oyo etonda na kanda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.15",
                "verseOrgIds": [
                  "MAT.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokoyeba bango na nzela ya misala na bango. Boni, bokoki kolongola bambuma ya vino na nzete ya basende to kobuka bambuma ya figi na nzete ya banzube ?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.16",
                "verseOrgIds": [
                  "MAT.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzete nyonso ya malamu ebotaka mpe bambuma ya malamu, kasi nzete ya mabe ebotaka mpe bambuma ya mabe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.17",
                "verseOrgIds": [
                  "MAT.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzete ya malamu ebotaka te bambuma ya mabe, mpe nzete ya mabe ebotaka te bambuma ya malamu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.18",
                "verseOrgIds": [
                  "MAT.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
              "MAT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nzete nyonso oyo ebotaka te bambuma ya malamu, bapikolaka yango mpe babwakaka yango na moto.",
