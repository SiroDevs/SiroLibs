  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "MAT 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu asilisaki kopesa mitindo epai ya bayekoli na Ye zomi na mibale, alongwaki wana, akendeki koteya mpe kopanza Sango Malamu kati na bingumba na bango.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu mpe Yoane Mobatisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.7.18-LUK.7.35"
          },
          "items": [
            {
              "text": "Lk 7.18-35",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Yoane Mobatisi azalaki kati na boloko, ayokaki sango ya makambo nyonso oyo Klisto azalaki kosala ; atindaki bayekoli na ye",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotuna epai ya Yesu :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 11:3"
      },
      "items": [
        {
          "text": "— Boni, ozali penza Ye oyo asengelaki koya to tosengeli kozela mosusu ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 11:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bokende koyebisa Yoane makambo oyo bozali komona mpe koyoka :",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "bakufi miso bazali komona, ba-ebosono bazali kotambola, bato na maba bazali kopetolama, bakufi matoyi bazali koyoka, bakufi bazali kosekwa mpe Sango Malamu ezali kosakolama epai ya babola.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Esengo na moto oyo akokweyisa kondima na ye te likolo na Ngai !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana bayekoli ya Yoane bazalaki kozonga, Yesu akomaki koloba na ebele ya bato na tina na Yoane ; atunaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 11:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Eloko nini bokendeki kotala kati na esobe ? Mwa nzete oyo mopepe ezalaki koningisa epai na epai ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Soki mwa nzete yango te, bokendeki penza kotala nini ? Moto moko alati bilamba ya kitoko ? Te ! Bato oyo balataka bilamba ya kitoko bavandaka na bandako ya bakonzi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi bino, bokendeki penza kotala nini kati na esobe ? Mosakoli ? Solo, nazali koloba na bino penza ya solo : aleki kutu ata mosakoli.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te, azali moto oyo bakoma na tina na ye :",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Nakotinda ntoma na Ngai liboso na Yo",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpo na kobongisela Yo nzela. »",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nazali koloba na bino penza ya solo : kati na bato oyo babotama na mwasi, moko te aleki Yoane Mobatisi na monene ; nzokande, ye oyo aleki moke kati na Bokonzi ya Likolo aleki Yoane Mobatisi na monene.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.11",
                "verseOrgIds": [
                  "MAT.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wuta na tango oyo Yoane Mobatisi azalaki koteya kino sik'oyo, kokota na Bokonzi ya Likolo ezali likambo ya koyika mpiko, mpe ezali kaka bato oyo bazali kobunda na kondima nde bazali kokota kuna.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.12",
                "verseOrgIds": [
                  "MAT.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.12",
            "verseOrgIds": [
              "MAT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te basakoli nyonso mpe Mobeko basakolaki yango bango nyonso kino na tango ya Yoane.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.13",
                "verseOrgIds": [
                  "MAT.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.13",
            "verseOrgIds": [
              "MAT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe, soki bokoki kondima, boyeba ete ye nde azali Eliya oyo asengeli koya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.14",
                "verseOrgIds": [
                  "MAT.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.14",
            "verseOrgIds": [
              "MAT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tika ete moto oyo azali na matoyi mpo na koyoka ayoka !",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.15",
                "verseOrgIds": [
                  "MAT.11.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na nani penza nakokokanisa bato ya ekeke oyo ? Bakokani penza na bana mike oyo bavandi na esika oyo bato ebele bakutanaka mpe bazali koganga epai ya bamosusu :",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Tobetaki baflite,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi bobinaki te ;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "toyembelaki bino banzembo ya matanga,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kasi bolelaki-lelaki te. »",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te, tango Yoane ayaki, azalaki kolia te mpe azalaki komela vino te ; mpe balobaki : « Azali na molimo mabe kati na ye ! »",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.18",
                "verseOrgIds": [
                  "MAT.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe awa Mwana na Moto mpe ayei, azali kolia mpe azali komela ; kasi bazali koloba : « Azali na lokoso ya kolia mpe azali molangwi masanga, moninga ya bafutisi mpako mpe ya bato ya masumu. » Nzokande, misala ya bwanya etalisaka solo ete ezali sembo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.19",
                "verseOrgIds": [
                  "MAT.11.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu apameli bingumba oyo eboyaki kondima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.10.15"
          },
          "items": [
            {
              "text": "Mat 10.15",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.10.12-LUK.10.15"
          },
          "items": [
            {
              "text": "Lk 10.12-15",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Yesu apamelaki bingumba epai wapi asalaki mingi kati na bikamwa na Ye, pamba te bavandi na yango babongolaki mitema te.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 11:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Mawa na yo, Korazini ! Mawa na yo, Betisaida ! Pamba te soki bikamwa oyo esalemaki kati na bino esalemaki na bingumba Tiri mpe Sidoni, mbele bavandi na yango babongolaki mitema wuta kala, mpe mbele batalisaki yango na kolata basaki mpe na komipakola putulu !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yango wana, nazali koloba na bino : na mokolo ya kosambisama, etumbu na bino ekozala makasi koleka etumbu ya Tiri mpe Sidoni.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mpe yo, Kapernawumi, okanisi ete okotombolama kino na Likolo ? Te ! Okokitisama kino na mboka ya bakufi ! Pamba te, soki bikamwa oyo esalemaki kati na yo esalemaki kati na Sodome, mbele Sodome ezali kowumela kino na mokolo ya lelo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yango wana, nazali koloba na bino : na mokolo ya kosambisama, etumbu na yo ekozala makasi koleka etumbu mokili ya Sodome.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu abengi bato na mikumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.10.21-LUK.10.22"
          },
          "items": [
            {
              "text": "Lk 10.21-22",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka na tango yango, Yesu alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 11:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Oh Tata, Nkolo ya Likolo mpe ya mabele, nakumisi Yo ! Pamba te, obombaki makambo oyo mpo ete bato ya bwanya mpe bato ya mayele bayeba yango te, kasi olakisi yango na bana mike !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iyo, Tata, pamba te, kati na boboto na Yo, olingaki ete esalema bongo !",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tata na Ngai apesa Ngai biloko nyonso. Moko te ayebi Mwana longola kaka Tata, mpe moko te ayebi Tata longola kaka Mwana mpe ye oyo epai ya nani Mwana asepeli kotalisa Tata.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boya epai na Ngai, bino nyonso oyo bolembi na mikumba ; Ngai, nakopesa bino bopemi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bozwa ekangiseli na Ngai, bomema yango mpe boyekola epai na Ngai, pamba te nazali na motema ya boboto mpe ya komikitisa, bongo milimo na bino ekozwa bopemi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Solo, ekangiseli na Ngai ezali pasi te, mpe mokumba na Ngai ezali pepele.",
              "type": "text"
            }
          ]
        }
      ]
    }
  ],
