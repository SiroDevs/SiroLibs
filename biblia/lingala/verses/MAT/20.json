{
  "id": "MAT.20",
  "number": "20",
  "bookId": "MAT",
  "reference": "Matayo 20",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisese ya nkolo elanga mpe basali na ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te, tala ndenge nini Bokonzi ya Likolo ezali : Bokonzi ya Likolo ezali lokola nkolo elanga ya vino oyo abimaki na tongo makasi mpo na koluka bato oyo bakosala na elanga na ye.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ayokanaki na bango ete moko na moko akobanda kozwa lifuti ya mbongo moko ya ebende mpo na mokolo mobimba ; bongo atindaki bango na elanga na ye ya vino.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na ngonga ya libwa ya tongo, abimaki lisusu mpe amonaki, na esika oyo bato bakutanaka, bato mosusu oyo bazalaki kosala eloko moko te.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Alobaki na bango : « Bino mpe bokende kosala na elanga na ngai ya vino. Nakopesa bino lifuti ya sembo, oyo ekoki. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye, bakendeki kuna. Nkolo elanga abimaki lisusu na ngonga ya midi mpe na ngonga ya misato sima na midi ; mpe na mbala nyonso mibale, asalaki kaka ndenge moko.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abimaki lisusu na ngonga ya mitano ya pokwa mpe amonaki lisusu bato batelemi na esika wana oyo bato bakutanaka. Atunaki bango : « Mpo na nini botelemi kaka boye mokolo mobimba na kosala eloko moko te ? »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bazongisaki : « Soki totelemi boye, ezali mpo ete moto moko te azwi biso na mosala. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bongo alobaki na bango : « Bino mpe bokende kosala na elanga na ngai ya vino. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tango pokwa ekokaki, nkolo elanga ya vino alobaki na motambolisi ya misala ya elanga : « Benga basali nyonso mpe futa bango ; banda na bato oyo nazwaki sima mpe sukisa na ba-oyo nazwaki liboso. »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bato oyo babandaki mosala na ngonga ya mitano ya pokwa bayaki, mpe moko na moko azwaki lokola lifuti, mbongo moko ya ebende.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bongo ekomaki ngonga ya kofuta bato oyo nkolo elanga azwaki liboso na mosala ; bakanisaki ete bakozwa mbongo mingi koleka, kasi moko na moko kati na bango azwaki lokola lifuti, mbongo moko kaka ya ebende.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tango bazwaki yango, basilikelaki nkolo elanga.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Balobaki : « Bato oyo ozwaki sima mpe basali kaka ngonga moko, ofuti bango ndenge moko na biso oyo tosali mosala makasi mokolo mobimba mpe na se ya moyi makasi ! »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kasi nkolo elanga azongiselaki moko kati na bango : « Moninga na ngai, nasali yo mabe te ! Boni, toyokanaki te ete osala mpo na lifuti ya mbongo moko ya ebende ?",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kamata lifuti na yo mpe kende. Ngai moko nde nalingi kopesa na moto oyo abandaki sima, lifuti ya ndenge moko na oyo napesi yo.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boni, nazali na ndingisa te ya kosala na mbongo na ngai nyonso oyo nalingi ? Osilikeli ngai mpo ete nazali moto malamu ? »",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Boye, kati na bato oyo bazali sik'oyo bato ya suka, ebele bakokoma bato ya liboso ; mpe kati na ba-oyo bazali sik'oyo bato ya liboso, ebele bakokoma bato ya suka.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu asakoli lisusu kufa mpe lisekwa na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.32-MRK.10.34"
          },
          "items": [
            {
              "text": "Mlk 10.32-34",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.18.31-LUK.18.34"
          },
          "items": [
            {
              "text": "Lk 18.31-34",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Yesu azalaki kokende na Yelusalemi, abendaki na pembeni bayekoli na Ye zomi na mibale mpe alobaki na bango wana bazali kotambola :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "« Boyoka ! Tozali solo kokende na Yelusalemi ; Mwana na Moto akokabama na maboko ya bakonzi ya Banganga-Nzambe mpe ya balakisi ya Mobeko ; bakokatela Ye etumbu ya kufa",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.18",
                "verseOrgIds": [
                  "MAT.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpe bakokaba Ye na maboko ya bapagano mpo ete baseka Ye, babeta Ye fimbu mpe babaka Ye na ekulusu. Mpe na mokolo ya misato, akosekwa. »",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.19",
                "verseOrgIds": [
                  "MAT.20.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu mpe mama ya bana ya Zebede",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.35-MRK.10.45"
          },
          "items": [
            {
              "text": "Mlk 10.35-45",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.22.25-LUK.22.27"
          },
          "items": [
            {
              "text": "Lk 22.25-27",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo mama ya bana mibali ya Zebede ayaki epai ya Yesu, elongo na bana na ye ya mibali, mpe agumbamaki liboso na Ye mpo na kosenga Ye eloko moko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atunaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:21"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Olingi nini ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:21"
      },
      "items": [
        {
          "text": "Azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:21"
      },
      "items": [
        {
          "text": "— Laka ngai ete bana na ngai mibale oyo ya mibali bakovanda kati na Bokonzi na Yo : moko na ngambo ya loboko na Yo ya mobali, mpe mosusu, na ngambo ya loboko na Yo ya mwasi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu azongiselaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:22"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bozali kososola te makambo oyo bozali kosenga ! Boni, bokoki komela kopo oyo Ngai nakomela ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:22"
      },
      "items": [
        {
          "text": "Bazongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:22"
      },
      "items": [
        {
          "text": "— Iyo, tokoki.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:23"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Solo, bokomela na bino kopo oyo Ngai nakomela ; kasi likambo ya kovanda na ngambo ya loboko na Ngai ya mobali to na ngambo ya loboko na Ngai ya mwasi, Ngai nakoki te kopesela yango ndingisa ; bisika wana ezali ya bato oyo Tata na Ngai abongisela bango yango.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bayekoli mosusu zomi bayokaki makambo wana, basilikelaki bandeko mibale wana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yesu abengaki bango nyonso mpe alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Boyebi malamu ete bakonzi ya bikolo bakonzaka bato ya bikolo oyo ezali na se ya bokonzi na bango, mpe bakalaka ya lokumu bakonzaka bato oyo bazali na se ya bokonzi na bango.",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Esengeli te kozala bongo kati na bino. Nzokande, tika ete moto nyonso oyo alingi kozala moto monene kati na bino azala mosali na bino ;",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "mpe tika ete moto nyonso oyo alingi kozala moto ya liboso kati na bino azala mowumbu na bino !",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pamba te Mwana na Moto ayaki te mpo ete basalela Ye ; kasi ayaki nde kosala mpo na bato, mpe kopesa bomoi na Ye lokola motuya ya kofuta mpo na kosikola bato ebele.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu abikisi bakufi miso mibale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.10.46-MRK.10.52"
          },
          "items": [
            {
              "text": "Mlk 10.46-52",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.18.35-LUK.18.43"
          },
          "items": [
            {
              "text": "Lk 18.35-43",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango Yesu elongo na bayekoli na Ye balongwaki na Jeriko, bato ebele balandaki Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakufi miso mibale bazalaki ya kovanda pembeni ya nzela ; tango bayokaki ete Yesu azali koleka, bagangaki :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:30"
      },
      "items": [
        {
          "text": "— Nkolo, Mwana ya Davidi, yokela biso mawa !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato bazalaki kopamela bango mpo ete bakanga minoko na bango, kasi bango bagangaki lisusu makasi :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:31"
      },
      "items": [
        {
          "text": "— Nkolo, mwana ya Davidi, yokela biso mawa !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atelemaki, abengaki bango mpe atunaki bango :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:32"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "— Bolingi nasala nini mpo na bino ?",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongiselaki Ye :",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "MAT 20:33"
      },
      "items": [
        {
          "text": "— Nkolo, sala ete tomona.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ayokelaki bango mawa mpe asimbaki miso na bango ; mpe, mbala moko, bakomaki komona mpe balandaki Ye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
  ],
