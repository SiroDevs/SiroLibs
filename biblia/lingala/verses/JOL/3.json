          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:4"
      },
      "items": [
        {
