        "style": "s1"
      },
      "items": [
        {
          "text": "Tango Yawe akosopa Molimo na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
