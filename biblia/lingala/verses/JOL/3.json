          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakolakisa bino bilembo ya kokamwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "na likolo mpe na mokili :",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "makila, moto mpe makonzi ya milinga.",
