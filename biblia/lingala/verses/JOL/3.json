      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:5"
      },
      "items": [
        {
          "text": "pamba te na ngomba Siona mpe na Yelusalemi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        }
      ]
    },
    {
