          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moyi ekobongwana molili,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.3.4"
            ]
          }
        }
