            "sid": "JOL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na makambo oyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "nakosopa Molimo na Ngai kati na bato nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "Bana na bino ya mibali mpe ya basi bakosakola,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "mibange na bino bakolota bandoto,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "bilenge na bino bakozwa bimoniseli.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ata mpe kati na basali na Ngai ya mibali mpe ya basi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "nakosopa Molimo na Ngai, na mikolo wana.",
