          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
