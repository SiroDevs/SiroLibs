  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JDG 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libala ya Samison",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokolo moko, Samison akendeki na Timina mpe amonaki kuna elenge mwasi moko ya Filisitia.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.1",
            "verseOrgIds": [
              "JDG.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango azongaki, alobaki na tata mpe mama na ye :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.2",
            "verseOrgIds": [
              "JDG.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:2"
      },
      "items": [
        {
          "text": "— Namoni mwasi moko kati na basi ya bato ya Filisitia, na Timina ; bokende kobalela ngai ye.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata mpe mama na ye bazongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:3"
      },
      "items": [
        {
          "text": "— Boni, kati na bandeko na yo to kati na bato na biso nyonso, ezali te na bana basi ya kitoko mpo ete okende kozwa mwasi kati na bato ya Filisitia oyo bakatama ngenga te ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:3"
      },
      "items": [
        {
          "text": "Kasi Samison alobaki na tata na ye :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.3",
            "verseOrgIds": [
              "JDG.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:3"
      },
      "items": [
        {
          "text": "— Balela ngai ye, pamba te ye nde abongi mpo na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baboti na ye bayebaki te ete likambo wana ewutaki epai na Yawe, pamba te Yawe azalaki koluka nzela mpo na kokotisa mobulu kati na bana ya Isalaele mpe bato ya Filisitia. Pamba te na tango wana, bato ya Filisitia bazalaki kokonza bana ya Isalaele.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.4",
            "verseOrgIds": [
              "JDG.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samison akendeki na Timina elongo na tata mpe mama na ye. Tango bakomaki pembeni ya bilanga ya vino ya Timina, mbala moko, mwana nkosi moko eyaki konguluma liboso ya Samison.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.5",
            "verseOrgIds": [
              "JDG.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimo na Yawe akitelaki Samison na nguya. Boye, Samison apasolaki nkosi na kati-kati, na maboko pamba, ndenge bapasolaka mwana ntaba. Kasi kati na makambo oyo asalaki, ayebisaki eloko moko te epai ya tata to mama na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.6",
            "verseOrgIds": [
              "JDG.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na yango, Samison akendeki na Timina, asololaki na mwana mwasi mpe alingaki ye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.7",
            "verseOrgIds": [
              "JDG.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mwa mikolo, tango azongaki na Timina mpo na kobala mwasi na ye, alekaki pembeni mpo na kotala nzoto ya nkosi oyo ekufaki. Kati na nzoto yango, amonaki liboke ya banzoyi mpe mafuta na yango.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.8",
            "verseOrgIds": [
              "JDG.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamataki yango na maboko na ye mpe aliaki yango nzela-nzela. Tango akutanaki na baboti na ye, apesaki bango ndambo ya mafuta ya nzoyi. Bongo bango mpe baliaki yango ; kasi atikalaki koyebisa bango te ete azwaki mafuta yango ya nzoyi kati na nzoto ya nkosi oyo ekufa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.9",
            "verseOrgIds": [
              "JDG.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisese ya Samison",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata na ye akendeki kotala elenge mwasi yango, mpe Samison asalisaki kuna feti moko ya monene, kolanda ndenge ezalaki momesano mpo na libala.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.10",
            "verseOrgIds": [
              "JDG.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango abimaki, bapesaki bato tuku misato mpo ete bavanda na ye elongo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.11",
            "verseOrgIds": [
              "JDG.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samison alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.12",
            "verseOrgIds": [
              "JDG.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:12"
      },
      "items": [
        {
          "text": "— Nalingi koyebisa bino lisese moko. Soki bopesi ngai eyano, na mikolo sambo ya feti, nakopesa bino bilamba tuku misato ya lino mpe bilamba tuku misato ya feti.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki bokoki te kopesa ngai eyano, bokopesa ngai bilamba tuku misato ya lino mpe bilamba tuku misato ya feti.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:13"
      },
      "items": [
        {
          "text": "Balobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.13",
            "verseOrgIds": [
              "JDG.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:13"
      },
      "items": [
        {
          "text": "— Yebisa biso lisese na yo, tolingi koyoka yango !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samison alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "— Kati na oyo eliaka, ebimi oyo baliaka ;",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "kati na oyo ezali makasi, ebimi oyo ezali elengi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JDG 14:14"
      },
      "items": [
        {
          "text": "Mikolo misato mobimba, bakokaki te kopesa ye eyano.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.14",
            "verseOrgIds": [
              "JDG.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo na mokolo ya minei, balobaki na mwasi ya Samison :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.15",
            "verseOrgIds": [
              "JDG.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:15"
      },
      "items": [
        {
          "text": "— Bondela mobali na yo mpo ete apesa biso ndimbola ya lisese ; sima na yango, yaka koyebisa biso ndimbola yango. Soki te, tokotumba yo elongo na ndako ya tata na yo. Obengisi biso awa mpo na koyiba biso ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo mwasi ya Samison akomaki kolela liboso ya mobali mpe alobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:16"
      },
      "items": [
        {
          "text": "— Oyina ngai ! Solo, olingaka ngai te ! Oyebisaki bato na ngai lisese, kasi oyebisaki ngai ndimbola na yango te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:16"
      },
      "items": [
        {
          "text": "Samison azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.16",
            "verseOrgIds": [
              "JDG.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JDG 14:16"
      },
      "items": [
        {
          "text": "— Natikala kutu kolimbola yango epai ya tata to mama na ngai te, bongo ndenge nini nalimbola yango epai na yo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mikolo nyonso sambo ya feti, azalaki kaka kolela. Suka na suka, na mokolo ya sambo, Samison alimbolelaki ye yango, pamba te mwasi na ye atungisaki ye mingi. Bongo mwasi ya Samison, ye mpe akendeki kopesa ndimbola ya lisese yango epai ya bato na ye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.17",
            "verseOrgIds": [
              "JDG.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya sambo, liboso ete moyi elala, bato ya engumba bayaki koloba na Samison :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "— Eloko nini ezali elengi koleka mafuta ya nzoyi ?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "Mpe eloko nini eleki nkosi na makasi ?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "Samison alobaki na bango :",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "— Soki bosalaki likita te na mwasi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JDG 14:18"
      },
      "items": [
        {
          "text": "bokokaki koyeba te ndimbola ya lisese na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.18",
            "verseOrgIds": [
              "JDG.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo Molimo na Yawe akitelaki Samison na nguya. Akendeki na Ashikeloni mpe abomaki bato tuku misato, azwaki bilamba na bango mpe apesaki yango epai ya bato oyo bapesaki ye ndimbola ya lisese. Azongaki na ndako ya tata na ye na kanda makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.14.19",
