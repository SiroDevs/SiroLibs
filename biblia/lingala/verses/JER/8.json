{
  "id": "JER.8",
  "number": "8",
  "bookId": "JER",
  "reference": "Jeremi 8",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JER 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango wana, elobi Yawe, bakobimisa mikuwa ya bakonzi mpe ya bakalaka ya Yuda, mikuwa ya Banganga-Nzambe mpe ya basakoli elongo na mikuwa ya bato ya Yelusalemi, wuta na malita na bango.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakotanda yango na se ya moyi, na se ya sanza mpe na se ya mampinga nyonso ya likolo, oyo balingaki, basalelaki na esengo, balandaki, batunaki makambo mpe bafukamelaki. Bakosangisa lisusu mikuwa yango te mpo na kokunda yango, kasi ekokoma lokola matiti ya kopola, na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bisika nyonso oyo nakopanza bango, elobi Yawe, Mokonzi ya mampinga, bato nyonso oyo bakotikala na bomoi kati na ekolo oyo ya mabe bakoluka kufa na esika ya bomoi. ›",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisumu mpe etumbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loba na bango : ‹ Tala liloba oyo Yawe alobi :",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:4"
      },
      "items": [
        {
          "text": "Boni, soki moto akweyi, atelemaka te ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:4"
      },
      "items": [
        {
          "text": "Soki moto abungi nzela, azongaka lisusu na nzela te ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini bato ya Yelusalemi babungi nzela ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "Mpo na nini bazali kokangama kaka na nzela na bango ya mabe ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "Bamipesi makasi na makambo ya lokuta",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "mpe baboyi kozongela Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayokaka na bokebi makambo nyonso oyo balobaka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "kasi balobaka makambo ya solo te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "Moko te kati na bango ayokaka motema pasi",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "mpo na mabe oyo asalaka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "alobaka : ' Nasali nini ? '",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "Moto na moto akangamaka kaka na nzela na ye",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "lokola mpunda oyo ezali kokende na bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezala kutu nkongi, kati na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "eyebaka bileko ya kokende na bisika mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "ebenga, ndeke ya mayi mpe mbilambila",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "eyebaka ata tango ya kozonga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "kasi bato na Ngai bayebi mibeko ya Yawe te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge nini bokoki koloba : ' Tozali bato ya bwanya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "pamba te toyebi Mobeko ya Yawe, '",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "tango sik'oyo ekomeli ya balakisi ya Mobeko",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "ebongoli yango lokuta ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato ya bwanya bakoyokisama soni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "bakoyoka somo mpe bakokende na bowumbu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "pamba te batiolaki Liloba na Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "Bazali na bwanya ya ndenge nini ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, nakokaba basi na bango",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "epai ya mibali mosusu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "mpe bilanga na bango epai ya bato mosusu ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "pamba te bango nyonso, ezala mikolo to bana mike,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "batondi na lokoso ya mbongo ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "basakoli mpe Banganga-Nzambe nyonso bakomi",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "se kotambola na lokuta ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazali kosalisa bapota ya bato na Ngai likolo-likolo",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:11"
      },
      "items": [
        {
          "text": "mpe bazali koloba : ' Makambo nyonso ezali malamu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:11"
      },
      "items": [
        {
          "text": "nyonso ezali kotambola malamu ! '",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:11"
      },
      "items": [
        {
          "text": "Nzokande, ata likambo moko ya malamu ezali te.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.11",
            "verseOrgIds": [
              "JER.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
