    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe abulisi Mokonzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na nini bikolo ezali kosala makelele",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:1"
      },
      "items": [
        {
          "text": "mpe bato bazali kosala makita ya pamba ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakonzi ya mokili batomboki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "mpe bakambi basangani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "mpo na kotelemela Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "elongo na mopakolami na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali koganga elongo :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:3"
      },
      "items": [
        {
          "text": "« Tokata minyololo na bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:3"
      },
      "items": [
        {
          "text": "mpe tomikangola na bokonzi na bango ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Ye oyo avandi na Kiti na Ye ya Bokonzi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:4"
      },
      "items": [
        {
          "text": "kuna na likolo aseki,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:4"
      },
      "items": [
        {
          "text": "Yawe atioli bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agangeli bango na kanda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:5"
      },
      "items": [
        {
          "text": "apelisi kanda makasi na Ye mpo na bango, alobi :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Ezali Ngai nde natiaki mokonzi na Ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:6"
      },
      "items": [
        {
          "text": "na Siona, ngomba na Ngai ya bule. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakosakola mobeko ya Yawe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "Alobaki na ngai : « Ozali Mwana na Ngai ya mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "na mokolo ya lelo, nakomi Tata na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Senga Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "mpe nakokomisa bikolo libula na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "basuka ya mokili bozwi na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okoyangela yango na bokonzi ya ebende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:9"
      },
      "items": [
        {
          "text": "okopanza yango lokola mbeki ya mabele. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, bino bakonzi, bozala na mayele ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:10"
      },
      "items": [
        {
          "text": "bino bayangeli ya mokili, boyoka likebisi oyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosalela Yawe na kobanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:11"
      },
      "items": [
        {
          "text": "mpe bosepela na kolenga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bopesa Mwana na Ye beze, noki te akosilika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "mpe bokokufa na nzela na bino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "pamba te kanda na Ye epelaka noki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "Esengo na bato oyo bazwaka Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "lokola ebombamelo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    }
