  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "66",
        "style": "c",
        "sid": "PSA 66"
      },
      "items": [
        {
          "text": "66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Lokumu na Nzambe oyo akangoli biso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 66:1"
      },
      "items": [
        {
          "text": "Bino bato ya mokili mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:1"
      },
      "items": [
        {
          "text": "bobetela Nzambe maboko !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyemba banzembo ya lokumu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:2"
      },
      "items": [
        {
          "text": "mpo na nkembo ya Kombo na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:2"
      },
      "items": [
        {
          "text": "bopesa lokumu na Ye nkembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boloba na Nzambe :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "« Tala ndenge nini misala na Yo ebongi na kobanga yango !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "Mpo na nguya monene na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:3"
      },
      "items": [
        {
          "text": "banguna na Yo bakomi koluka kokoma baninga na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mokili mobimba efukamaka liboso na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "bayembaka mpo na lokumu na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:4"
      },
      "items": [
        {
          "text": "basanzolaka Kombo na Yo. »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boya kotala misala ya Nzambe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:5"
      },
      "items": [
        {
          "text": "Misala na Ye ya minene mpo na bana ya bato ebongi na kobanga yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abongolaki ebale monene mabele ya kokawuka ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "bakatisaki ebale na makolo ekawuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:6"
      },
      "items": [
        {
          "text": "Tozali kosepela kati na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nguya na Ye, akonzaka mpo na libela ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "miso na Ye ekengelaka bikolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:7"
      },
      "items": [
        {
          "text": "Tika ete batomboki batombokela Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bikolo, bopambola Nzambe na biso !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:8"
      },
      "items": [
        {
          "text": "Bosala ete lokito ya masanzoli na Ye eyokana !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaka ete totangama kati na bato ya bomoi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:9"
      },
      "items": [
        {
          "text": "Abatelaki makolo na biso mpo ete tokweya te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, Nzambe, omekaki biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:10"
      },
      "items": [
        {
          "text": "olekisaki biso kati na moto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:10"
      },
      "items": [
        {
          "text": "ndenge basalaka mpo na palata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okangaki biso kati na motambo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:11"
      },
      "items": [
        {
          "text": "otiaki mikumba ya kilo, na baloketo na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otikaki moto komatela biso na moto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "Tolekaki kati na moto mpe kati na mayi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:12"
      },
      "items": [
        {
          "text": "mpe obimisaki biso kati na yango mpo na komema biso na bofuluki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakokota kati na Ndako na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:13"
      },
      "items": [
        {
          "text": "nakomemela Yo makabo ya kotumba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:13"
      },
      "items": [
        {
          "text": "nakokokisa bandayi na ngai epai na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandayi oyo bibebu na ngai moko etatolaki",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 66:14"
      },
      "items": [
        {
          "text": "mpe monoko na ngai elobaki na tango nazalaki kati na pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola bambeka ya kotumba, nakobonzela Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
