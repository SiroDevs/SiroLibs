      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 85:13"
      },
      "items": [
        {
          "text": "mpe mabele na biso ekobota bambuma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
