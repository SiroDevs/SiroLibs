      "attrs": {
        "style": "q2",
        "vid": "PSA 85:14"
      },
      "items": [
        {
          "text": "mpe elakisaka nzela oyo ekolekela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.14",
            "verseOrgIds": [
              "PSA.85.14"
            ]
