          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye moko Yawe akopesa esengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.13",
            "verseOrgIds": [
              "PSA.85.13"
            ]
          }
        }
      ]
    },
