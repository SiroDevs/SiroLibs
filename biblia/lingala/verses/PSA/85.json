          ]
        },
        {
          "text": "Bosembo etambolaka liboso na Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.85.14",
            "verseOrgIds": [
              "PSA.85.14"
            ]
          }
        }
      ]
