          "text": "100",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 100",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe asanzolamaka kati na bato na Ye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 100:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya kozongisa matondi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 100:1"
      },
      "items": [
        {
          "text": "Bino nyonso bato ya mokili mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:1"
      },
      "items": [
        {
          "text": "boganga na esengo epai na Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
              "PSA.100.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 100:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosalela Yawe na esengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:2"
      },
      "items": [
        {
          "text": "mpe boya liboso na Ye na banzembo ya esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.2",
            "verseOrgIds": [
              "PSA.100.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 100:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boyeba ete Yawe nde azali Nzambe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "Ye nde asala biso, mpe tozali bato na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "Solo, tozali bato na Ye mpe etonga oyo aleisaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 100:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokota na bikuke na Ye na kozongisa matondi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "bokota na lopango na Ye na kokumisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "Bosanzola Ye, bopambola Kombo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 100:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe azali malamu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:5"
      },
      "items": [
        {
          "text": "bolingo na Ye ewumelaka seko na seko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:5"
      },
      "items": [
        {
          "text": "mpe boyengebene na Ye, libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        }
      ]
    }
