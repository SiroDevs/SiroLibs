            "sid": "PSA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 29:1"
      },
      "items": [
        {
          "text": "Bopesa Yawe, bino ba-anjelu ya Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:1"
      },
      "items": [
        {
          "text": "bopesa Yawe nkembo mpe makasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.1",
            "verseOrgIds": [
              "PSA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bopesa Yawe nkembo oyo ekoki na lokumu ya Kombo na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:2"
      },
      "items": [
        {
          "text": "bogumbamela Yawe kati na kongenga ya bosantu na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.2",
            "verseOrgIds": [
              "PSA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mongongo ya Yawe eyokani na likolo ya mayi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Nzambe ya nkembo azali koleka elongo na lokito,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:3"
      },
      "items": [
        {
          "text": "Yawe azali koleka elongo na lokito na likolo ya mayi minene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.3",
            "verseOrgIds": [
              "PSA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mongongo ya Yawe ezali na nguya ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:4"
      },
      "items": [
        {
          "text": "mongongo ya Yawe ezali na lokumu mingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.4",
            "verseOrgIds": [
              "PSA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mongongo ya Yawe ebukaka banzete ya sedele ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:5"
      },
      "items": [
        {
          "text": "Yawe abukaka banzete ya sedele ya Libani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.5",
            "verseOrgIds": [
              "PSA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apumbwisaka Libani lokola mwana ngombe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:6"
      },
      "items": [
        {
          "text": "apumbwisaka Sirioni lokola mwana ya mpakasa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.6",
            "verseOrgIds": [
              "PSA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mongongo ya Yawe ebimaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:7"
      },
      "items": [
        {
          "text": "elongo na bakake ya moto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.7",
            "verseOrgIds": [
              "PSA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
