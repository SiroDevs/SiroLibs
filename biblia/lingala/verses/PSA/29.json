      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "na likolo ya mpela ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "Yawe avandi na Kiti ya Bokonzi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:10"
      },
      "items": [
        {
          "text": "lokola Mokonzi mpo na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
      ]
    },
