      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:11"
      },
      "items": [
        {
          "text": "Yawe apambolaka bato na Ye na nzela ya kimia.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
