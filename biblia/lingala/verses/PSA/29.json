          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe avandaki na Kiti ya Bokonzi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.10",
            "verseOrgIds": [
              "PSA.29.10"
            ]
          }
        }
