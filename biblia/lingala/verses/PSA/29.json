            "number": "8",
            "style": "v",
            "sid": "PSA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mongongo ya Yawe elengisaka esobe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 29:8"
      },
      "items": [
        {
          "text": "Yawe alengisaka Esobe ya Kadeshi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.8",
            "verseOrgIds": [
              "PSA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
