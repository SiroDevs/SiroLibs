          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe apesaka bato na Ye makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.29.11",
            "verseOrgIds": [
              "PSA.29.11"
            ]
          }
        }
      ]
    },
