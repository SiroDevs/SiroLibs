      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "ngengisela biso elongi na Yo mpo ete tobika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
