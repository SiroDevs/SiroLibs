      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "Monisa nguya na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
