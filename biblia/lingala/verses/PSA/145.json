      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:2"
      },
      "items": [
        {
          "text": "mpe nakokumisa Kombo na Yo libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
