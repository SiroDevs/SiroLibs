          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masanzoli. Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "Nakotombola Yo, Nzambe na ngai, Mokonzi na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:1"
      },
      "items": [
        {
          "text": "nakopambola Kombo na Yo seko na seko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
