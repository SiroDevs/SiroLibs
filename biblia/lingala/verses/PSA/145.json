          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikolo nyonso, nakopambola Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
    {
