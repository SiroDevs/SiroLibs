      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:3"
      },
      "items": [
        {
          "text": "moko te akoki komeka mozindo ya monene na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
