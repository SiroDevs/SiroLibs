          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakokanisa misala minene ya bolamu na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.7",
            "verseOrgIds": [
              "PSA.145.7"
