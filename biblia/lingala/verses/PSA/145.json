      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 145:4"
      },
      "items": [
        {
          "text": "mpe ekopanza sango ya misala na Yo ya minene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.4",
            "verseOrgIds": [
              "PSA.145.4"
            ]
          }
        }
      ]
    },
