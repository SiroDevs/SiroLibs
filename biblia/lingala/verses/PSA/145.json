      "attrs": {
        "style": "q2",
        "vid": "PSA 145:5"
      },
      "items": [
        {
          "text": "mpe kongenga makasi ya nkembo na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.5",
            "verseOrgIds": [
              "PSA.145.5"
            ]
          }
        }
      ]
