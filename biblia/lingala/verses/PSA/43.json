    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Kotia elikya kati na Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe, longisa ngai mpe lobela ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "liboso ya ekolo oyo etosaka makambo na Yo te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "kangola ngai wuta na maboko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:1"
      },
      "items": [
        {
          "text": "ya bakosi mpe ya bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.1",
            "verseOrgIds": [
              "PSA.43.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe, Yo nde ozali ndako na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "oyo batonga makasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "mpo na nini osundoli ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "Mpo na nini nasengeli kotambola na pasi boye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:2"
      },
      "items": [
        {
          "text": "na se ya minyoko ya monguna ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.2",
            "verseOrgIds": [
              "PSA.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinda mwinda mpe solo na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "mpo ete ekamba mpe emema ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:3"
      },
      "items": [
        {
          "text": "na ngomba na Yo ya bule epai wapi ovandaka ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.3",
            "verseOrgIds": [
              "PSA.43.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bongo nakokende na etumbelo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "epai ya Nzambe, esengo mpe bomengo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "Oh Yawe, Nzambe na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:4"
      },
      "items": [
        {
          "text": "nakosanzola Yo na lindanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.4",
            "verseOrgIds": [
              "PSA.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh molimo na ngai, mpo na nini olembi boye ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Mpo na nini ozali komitungisa kati na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Tia elikya na yo kati na Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "pamba te nakosanzola Ye lisusu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 43:5"
      },
      "items": [
        {
          "text": "Mobikisi mpe Nzambe na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.43.5",
            "verseOrgIds": [
              "PSA.43.5"
            ]
          }
        }
      ]
    }
  ],
