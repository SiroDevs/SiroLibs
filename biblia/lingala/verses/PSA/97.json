            "sid": "PSA 97:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe azali kokonza !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:1"
      },
      "items": [
        {
          "text": "Tika ete mabele esepela ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:1"
      },
      "items": [
        {
          "text": "tika ete ebele ya bisanga ezala na esengo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.1",
            "verseOrgIds": [
              "PSA.97.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 97:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapata mpe molili makasi ezingeli Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:2"
      },
      "items": [
        {
          "text": "bosembo mpe bosolo ezali miboko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:2"
      },
      "items": [
        {
          "text": "ya Kiti na Ye ya Bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 97:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto etambolaka liboso na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:3"
      },
      "items": [
        {
          "text": "ezikisaka banguna na Ye, oyo bazingeli Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 97:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikalikali na Ye engengisaka mokili ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:4"
      },
      "items": [
        {
          "text": "mpe tango mabele emonaka bongo, elengaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 97:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangomba enyangwamaka lokola mafuta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:5"
      },
      "items": [
        {
          "text": "liboso ya Yawe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:5"
      },
      "items": [
        {
          "text": "liboso ya Nkolo ya mokili mobimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.5",
            "verseOrgIds": [
              "PSA.97.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
