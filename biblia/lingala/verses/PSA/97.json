      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:12"
      },
      "items": [
        {
          "text": "bosanzola Ye na kotatola bosantu na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
