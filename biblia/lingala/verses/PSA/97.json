      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "boyina mabe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "Yawe abatelaka bomoi ya bayengebene na Ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
    },
