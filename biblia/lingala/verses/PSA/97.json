      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:10"
      },
      "items": [
        {
          "text": "mpe akangolaka bango na maboko ya bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.10",
            "verseOrgIds": [
              "PSA.97.10"
            ]
          }
        }
      ]
