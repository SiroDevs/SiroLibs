          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bato ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:12"
      },
      "items": [
        {
          "text": "bosepela kati na Yawe ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.12",
            "verseOrgIds": [
              "PSA.97.12"
            ]
          }
        }
      ]
    },
    {
