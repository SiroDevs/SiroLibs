          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likolo epanzaka sango ya bosembo na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.6",
            "verseOrgIds": [
              "PSA.97.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:6"
      },
      "items": [
        {
          "text": "mpe bikolo nyonso bamonaka nkembo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.6",
            "verseOrgIds": [
              "PSA.97.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 97:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete soni ekanga basambeli nyonso ya bikeko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:7"
      },
      "items": [
        {
          "text": "bato oyo bamikumisaka mpo na banzambe ya lokuta !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:7"
      },
      "items": [
        {
          "text": "Bino banzambe nyonso, bogumbama liboso na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.7",
            "verseOrgIds": [
              "PSA.97.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
