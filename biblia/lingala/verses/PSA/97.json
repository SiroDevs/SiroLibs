          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 97:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Siona eyoki yango mpe esepeli ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:8"
      },
      "items": [
        {
          "text": "bingumba ya Yuda ezali na esengo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:8"
      },
      "items": [
        {
          "text": "mpo na mikano na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 97:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, na mokili mobimba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:9"
      },
      "items": [
        {
          "text": "Yo nde Yawe, ozali Ye-Oyo-Aleki-Likolo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:9"
      },
      "items": [
        {
          "text": "oleki banzambe nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.9",
            "verseOrgIds": [
              "PSA.97.9"
            ]
          }
        }
      ]
    },
