        "style": "c",
        "sid": "PSA 109"
      },
      "items": [
        {
          "text": "109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 109",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe, kovanda lisusu kimia te",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 109:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 109:1"
      },
      "items": [
        {
          "text": "Nzambe, Yo oyo ngai nakumisaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:1"
      },
      "items": [
        {
          "text": "kovanda kimia te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.1",
            "verseOrgIds": [
              "PSA.109.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 109:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato mabe bazali koloba lokuta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "mpo na kofunda ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:2"
      },
      "items": [
        {
          "text": "bazali mpe kokosela ngai makambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.2",
            "verseOrgIds": [
              "PSA.109.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 109:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazingeli ngai na maloba ya koyina",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:3"
      },
      "items": [
        {
          "text": "mpe bazali kobundisa ngai kaka pamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.3",
            "verseOrgIds": [
              "PSA.109.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 109:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo ngai nalingaka bafundi ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:4"
      },
      "items": [
        {
          "text": "kasi ngai namipesi na ngai kaka na mabondeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.4",
            "verseOrgIds": [
              "PSA.109.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 109:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali kozongisela ngai mabe na bolamu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:5"
      },
      "items": [
        {
          "text": "mpe koyina na bolingo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.5",
            "verseOrgIds": [
              "PSA.109.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 109:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaba ye na maboko ya moto mabe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:6"
      },
      "items": [
        {
          "text": "Bimisela ye monguna,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:6"
      },
      "items": [
        {
          "text": "na ngambo ya loboko na ye ya mobali !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.6",
            "verseOrgIds": [
              "PSA.109.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 109:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bazwa ye lokola moto mabe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:7"
      },
      "items": [
        {
          "text": "na tango ya kosamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:7"
      },
      "items": [
        {
          "text": "mpe libondeli na ye etangama lokola masumu !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.7",
            "verseOrgIds": [
              "PSA.109.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 109:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete mikolo ya bomoi na ye ekoma moke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:8"
      },
      "items": [
        {
          "text": "tika ete moto mosusu azwa mokumba na ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.8",
            "verseOrgIds": [
              "PSA.109.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 109:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bana na ye bakoma bana bitike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:9"
      },
      "items": [
        {
          "text": "mpe tika ete mwasi na ye akoma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:9"
      },
      "items": [
        {
          "text": "mwasi akufisa mobali !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.9",
            "verseOrgIds": [
              "PSA.109.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 109:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bana na ye batelengana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:10"
      },
      "items": [
        {
          "text": "mpe bakoma bisengasenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 109:10"
      },
      "items": [
        {
          "text": "tika ete bakende kosenga mosika",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:10"
      },
      "items": [
        {
          "text": "ya ndako na bango oyo ebukana-bukana !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.10",
            "verseOrgIds": [
              "PSA.109.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 109:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moto oyo adefisaki ye mbongo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:11"
      },
      "items": [
        {
          "text": "akanga ye biloko nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 109:11"
      },
      "items": [
        {
          "text": "mpe tika ete bapaya babotola ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:11"
      },
      "items": [
        {
          "text": "bambuma ya mosala na ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.11",
            "verseOrgIds": [
              "PSA.109.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 109:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete moko te atalisa ye bolingo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:12"
      },
      "items": [
        {
          "text": "tika ete moko te ayokela bana bitike na ye mawa !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.12",
            "verseOrgIds": [
              "PSA.109.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 109:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bakitani na ye basila na kokufa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:13"
      },
      "items": [
        {
          "text": "mpe bakombo na bango elongwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:13"
      },
      "items": [
        {
          "text": "na ekeke oyo ezali kolanda !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.13",
            "verseOrgIds": [
              "PSA.109.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 109:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe alandela",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:14"
      },
      "items": [
        {
          "text": "masumu ya batata na ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 109:14"
      },
      "items": [
        {
          "text": "mpe alimbisa te masumu ya mama na ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.14",
            "verseOrgIds": [
              "PSA.109.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 109:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe akanisaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.15",
            "verseOrgIds": [
