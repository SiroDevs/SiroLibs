          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 59",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe na ngai, kangola ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 59:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Eyembamaki ndenge moko na « Kobebisa te ! » tango Saulo atindaki bato kozingela ndako ya Davidi mpo na koboma ye. Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 59:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Nzambe na ngai, kangola ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:2"
      },
      "items": [
        {
          "text": "wuta na maboko ya banguna na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:2"
      },
      "items": [
        {
          "text": "batela ngai liboso ya banyokoli na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.2",
            "verseOrgIds": [
              "PSA.59.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 59:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kangola ngai wuta na maboko",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "ya bato ya misala mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:3"
      },
      "items": [
        {
          "text": "mpe bikisa ngai liboso ya basopi makila ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.3",
            "verseOrgIds": [
              "PSA.59.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 59:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, bazali koluka koboma ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "bato na nguya basaleli ngai likita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "nzokande nasali mabe te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:4"
      },
      "items": [
        {
          "text": "nasali na ngai mpe masumu te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.4",
            "verseOrgIds": [
              "PSA.59.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 59:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasali mabe ata moko te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "kasi bango bazali kopota mbangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "bazali komibongisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:5"
      },
      "items": [
        {
          "text": "Lamuka mpo na koya kokutana na ngai, mpe tala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.5",
            "verseOrgIds": [
              "PSA.59.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 59:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Nzambe-Na-Nguya-Nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "Nzambe ya Isalaele, telema mpo na kopesa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "bikolo nyonso etumbu ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:6"
      },
      "items": [
        {
          "text": "koyokela bato nyonso oyo basalaka mabe mawa te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.6",
            "verseOrgIds": [
              "PSA.59.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 59:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazongaka na pokwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "bagangaka lokola bambwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:7"
      },
      "items": [
        {
          "text": "mpe batambolaka zingazinga ya engumba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.7",
            "verseOrgIds": [
              "PSA.59.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 59:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nzela ya minoko na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:8"
      },
      "items": [
        {
          "text": "babimisaka na bibebu na bango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:8"
      },
      "items": [
        {
          "text": "maloba oyo ezokisaka lokola mipanga ; bamilobelaka :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:8"
      },
      "items": [
        {
          "text": "« Nani azali koyoka biso ? »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.8",
            "verseOrgIds": [
              "PSA.59.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 59:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yo, Yawe, osekaka bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:9"
      },
      "items": [
        {
          "text": "otiolaka bikolo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.9",
            "verseOrgIds": [
              "PSA.59.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 59:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe, ozali makasi na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "nakotalela Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:10"
      },
      "items": [
        {
          "text": "ozali ebombamelo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.10",
            "verseOrgIds": [
              "PSA.59.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 59:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe na ngai, oyo nalingaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 59:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "Nzambe ayaka kino liboso na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:11"
      },
      "items": [
        {
          "text": "atikaka ngai kotala banguna na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.11",
            "verseOrgIds": [
              "PSA.59.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 59:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkolo, nguba na biso, koboma bango te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "noki te bato na ngai bakobosana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "Na nguya na Yo, sala ete bayengayenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:12"
      },
      "items": [
        {
          "text": "mpe mema bango kino na se.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.12",
            "verseOrgIds": [
              "PSA.59.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 59:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na masumu ya minoko na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 59:13"
      },
      "items": [
        {
          "text": "mpo na maloba ya bibebu na bango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.59.13",
            "verseOrgIds": [
              "PSA.59.13"
            ]
          }
        }
      ]
    },
    {
