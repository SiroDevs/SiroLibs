            "sid": "PSA 82:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, bokufaka lokola bato nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:7"
      },
      "items": [
        {
          "text": "mpe bokweyaka lokola bakambi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.7",
            "verseOrgIds": [
              "PSA.82.7"
            ]
          }
        }
      ]
    },
    {
