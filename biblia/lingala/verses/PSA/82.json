    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:4"
      },
      "items": [
        {
          "text": "mpe na mobola,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:4"
      },
      "items": [
        {
          "text": "bokangola bango wuta na maboko ya bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.4",
            "verseOrgIds": [
              "PSA.82.4"
            ]
          }
        }
      ]
