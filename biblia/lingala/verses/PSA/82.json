          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazangi boyebi mpe bososoli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "bazali koyengayenga kati na molili ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 82:5"
      },
      "items": [
        {
          "text": "miboko nyonso ya mokili ezali koningana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.82.5",
            "verseOrgIds": [
              "PSA.82.5"
            ]
          }
        }
      ]
    },
    {
