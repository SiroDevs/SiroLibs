    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Kino tango nini bato mabe bakolonga ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 94:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Nzambe oyo azongisaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "mabe na mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "Nzambe oyo azongisaka mabe na mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:1"
      },
      "items": [
        {
          "text": "mimonisa kati na nkembo na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 94:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosambisi ya mokili, telema",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:2"
      },
      "items": [
        {
          "text": "mpo na kozongisela bato ya lolendo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:2"
      },
      "items": [
        {
          "text": "mabe na mabe na bango !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 94:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, kino tango nini bato mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:3"
      },
      "items": [
        {
          "text": "kino tango nini bato mabe bakosepela ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 94:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazali komilakisa, bazali kobimisa mafinga ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:4"
      },
      "items": [
        {
          "text": "bato nyonso ya misala mabe bazali komikumisa !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 94:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, bazali konyokola bato na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:5"
      },
      "items": [
        {
          "text": "mpe bazali koyokisa libula na Yo pasi ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 94:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazali koboma mwasi oyo akufisa mobali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:6"
      },
      "items": [
        {
          "text": "mopaya mpe bana bitike ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 94:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazali koloba :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:7"
      },
      "items": [
        {
          "text": "« Yawe amonaka eloko moko te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:7"
      },
      "items": [
        {
          "text": "Nzambe ya Jakobi asosolaka eloko moko te ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 94:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bato ya kilikili, bososola !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:8"
      },
      "items": [
        {
          "text": "Bazoba, bokokoma mayele tango nini ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 94:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boni, Ye oyo asala litoyi akoki koyoka te ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:9"
      },
      "items": [
        {
          "text": "Ye oyo asala liso akoki komona te ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 94:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye oyo apesaka bikolo etumbu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:10"
      },
      "items": [
        {
          "text": "akoki kopesa etumbu te ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:10"
      },
      "items": [
        {
          "text": "Ye oyo apesaka bato boyebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 94:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe ayebi makanisi ya bato ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:11"
      },
      "items": [
        {
          "text": "ayebi ete ezali na tina te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 94:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, esengo na moto oyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:12"
      },
      "items": [
        {
          "text": "ozali kozongisa na nzela,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:12"
      },
      "items": [
        {
          "text": "moto oyo ozali kolakisa mibeko na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 94:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo na kopesa ye bopemi na tango ya pasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:13"
      },
      "items": [
        {
          "text": "kino libulu etimolama mpo na moto mabe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 94:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te Yawe asundolaka bato na Ye te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:14"
      },
      "items": [
        {
          "text": "abwakaka libula na Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 94:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakosambisa lisusu kolanda bosembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:15"
      },
      "items": [
        {
          "text": "mpe bato nyonso oyo bazali na mitema alima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 94:15"
      },
      "items": [
        {
          "text": "bakotosa bosembo yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 94:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani akotelema mpo na ngai",
