    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 65",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Opesaka bofuluki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 65:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na Yo Nzambe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:2"
      },
      "items": [
        {
          "text": "bozangi makelele ezali lokumu, kati na Siona ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:2"
      },
      "items": [
        {
          "text": "mpe mpo na Yo, ndayi ekokokisama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.2",
            "verseOrgIds": [
              "PSA.65.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 65:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo oyo oyokaka mabondeli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:3"
      },
      "items": [
        {
          "text": "bato nyonso bakoya epai na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.3",
            "verseOrgIds": [
              "PSA.65.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilo ya bambeba eleki makasi mpo na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:4"
      },
      "items": [
        {
          "text": "kasi Yo, olimbisaka masumu na biso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.4",
            "verseOrgIds": [
              "PSA.65.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na moto oyo oponi mpe obulisi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "mpo ete avanda kati na lopango na Yo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "Tokotonda na bolamu ya Ndako na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:5"
      },
      "items": [
        {
          "text": "Tempelo na Yo ya bule.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.5",
            "verseOrgIds": [
              "PSA.65.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe Mobikisi na biso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "oyanolaka biso na bosembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "na nzela ya biloko ya somo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "Ozali elikya ya mokili mobimba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:6"
      },
      "items": [
        {
          "text": "mpe ya bibale minene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.6",
            "verseOrgIds": [
              "PSA.65.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alendisaka bangomba, na nguya na Ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:7"
      },
      "items": [
        {
          "text": "atondi na mpiko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.7",
            "verseOrgIds": [
              "PSA.65.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 65:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akitisaka makelele ya bibale minene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "makelele ya bambonge na yango",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:8"
      },
      "items": [
        {
          "text": "mpe makelele ya bikolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.8",
            "verseOrgIds": [
              "PSA.65.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bavandaka na basuka ya mokili",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "babangaka tango bamonaka bikamwa na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:9"
      },
      "items": [
        {
          "text": "osalaka ete este mpe weste eganga na esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.9",
            "verseOrgIds": [
              "PSA.65.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 65:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opambolaka mabele, ofulukisaka yango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "otondisaka yango na bozwi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "Otondisaka moluka ya Nzambe na mayi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "obongiselaka bato ble,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:10"
      },
      "items": [
        {
          "text": "pamba te otondisaka mayi mpo na yango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.10",
            "verseOrgIds": [
              "PSA.65.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 65:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olekisaka mayi kati na mikala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "okweyisaka mipiku ya mabele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "osopelaka mabele mayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:11"
      },
      "items": [
        {
          "text": "mpe opambolaka milona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.11",
            "verseOrgIds": [
              "PSA.65.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Opambolaka mobu na bolamu na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:12"
      },
      "items": [
        {
          "text": "mpe banzela mike oyo olekelaka ebotaka ebele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.12",
            "verseOrgIds": [
              "PSA.65.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 65:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilanga ya esobe etondaka na bilei,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:13"
      },
      "items": [
        {
          "text": "mpe bangomba mike etondaka na esengo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.13",
            "verseOrgIds": [
              "PSA.65.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 65:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilanga etondaka na bameme mpe bantaba ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.14",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:14"
      },
      "items": [
        {
          "text": "mabwaku etondaka na ble,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.65.14",
            "verseOrgIds": [
              "PSA.65.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 65:14"
      },
      "items": [
        {
