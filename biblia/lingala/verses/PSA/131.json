          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzembo ya Davidi. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "Yawe, motema na ngai ezali na lofundu te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "miso na ngai ezali na posa makasi te ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "namipesaka te na makambo oyo eleki ya minene",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "mpe eleki pasi mpo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 131:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi nabatelaki kimia kati na motema na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "mpe namitungisaki te",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "lokola mwana moke elongo na mama na ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "Nazali na kimia lokola mwana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "oyo mama alongola na mabele.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 131:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaele, tia elikya kati na Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:3"
      },
      "items": [
        {
          "text": "kobanda sik'oyo mpe libela na libela.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.3",
            "verseOrgIds": [
              "PSA.131.3"
            ]
          }
        }
      ]
