  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PSA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Yawe, longisa ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya mawa oyo Davidi ayembelaki Yawe na tina na Kushi, moto ya libota ya Benjame.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Nzambe na ngai, nabombamaka kati na Yo ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:2"
      },
      "items": [
        {
          "text": "bikisa ngai mpe kangola ngai liboso ya bato nyonso",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:2"
      },
      "items": [
        {
          "text": "oyo balukaka koboma ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.2",
            "verseOrgIds": [
              "PSA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki te, bakopasola ngai lokola nkosi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:3"
      },
      "items": [
        {
          "text": "mpe bakokata ngai na biteni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:3"
      },
      "items": [
        {
          "text": "mpe moto akozala te mpo na kosunga ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.3",
            "verseOrgIds": [
              "PSA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, Nzambe na ngai, soki nasalaki makambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:4"
      },
      "items": [
        {
          "text": "oyo bazali kopamela ngai mpo na yango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:4"
      },
      "items": [
        {
          "text": "mpe soki ezali na mabe na maboko na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.4",
            "verseOrgIds": [
              "PSA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "soki nasalaki moninga na ngai mabe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "text": "soki nabotolaki na makasi mpe kaka na pamba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:5"
      },
      "items": [
        {
          "text": "biloko ya moyini na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.5",
            "verseOrgIds": [
              "PSA.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wana tika ete monguna na ngai alanda mpe akanga ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:6"
      },
      "items": [
        {
          "text": "tika ete asakanela bomoi na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:6"
      },
      "items": [
        {
          "text": "mpe abebisa lokumu na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.6",
            "verseOrgIds": [
              "PSA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, telema na kanda na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:7"
      },
      "items": [
        {
          "text": "telemela kotomboka ya banguna na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:7"
      },
      "items": [
        {
          "text": "Nzambe na ngai, telema, kata likambo na ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.7",
            "verseOrgIds": [
              "PSA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bikolo esangana zingazinga na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:8"
      },
      "items": [
        {
          "text": "kasi Yo, konza bango wuta na Kiti na Yo ya Bokonzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.8",
            "verseOrgIds": [
              "PSA.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete Yawe asambisa bikolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "Yawe, longisa ngai kolanda bosembo na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "kolanda bozangi pamela na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:9"
      },
      "items": [
        {
          "text": "Yo-Oyo-Oleki-Likolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.9",
            "verseOrgIds": [
              "PSA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo Nzambe ya sembo oyo ososolaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:10"
      },
      "items": [
        {
          "text": "mozindo ya mayele mpe ya mitema,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 7:10"
      },
      "items": [
        {
          "text": "sukisa kanza ya bato mabe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:10"
      },
      "items": [
        {
          "text": "mpe yikisa moto ya sembo mpiko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.10",
            "verseOrgIds": [
              "PSA.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe-Oyo-Aleki-Likolo azali nguba na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:11"
      },
      "items": [
        {
          "text": "abikisaka bato ya sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.11",
            "verseOrgIds": [
              "PSA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe azali Mosambisi ya sembo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:12"
      },
      "items": [
        {
          "text": "asilikaka mikolo nyonso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.12",
            "verseOrgIds": [
              "PSA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soki alembisi kanda na Ye te,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:13"
      },
      "items": [
        {
          "text": "akopelisa minu ya mopanga na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:13"
      },
      "items": [
        {
          "text": "akobongisa mpe akobeta tolotolo na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.13",
            "verseOrgIds": [
              "PSA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abongisaka bibundeli oyo ebomaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.14",
            "verseOrgIds": [
              "PSA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 7:14"
      },
      "items": [
        {
          "text": "mpe asalaka ete makonga na Ye ekoma kozikisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.7.14",
            "verseOrgIds": [
              "PSA.7.14"
            ]
          }
        }
      ]
    },
