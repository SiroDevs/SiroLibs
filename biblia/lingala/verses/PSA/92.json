      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:8"
      },
      "items": [
        {
          "text": "mpe bato nyonso ya misala mabe bafulukaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.8",
            "verseOrgIds": [
              "PSA.92.8"
            ]
          }
        }
      ]
    },
