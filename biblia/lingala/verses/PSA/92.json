          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe, misala na Yo ezali minene,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.6",
            "verseOrgIds": [
              "PSA.92.6"
            ]
          }
        }
      ]
    },
    {
