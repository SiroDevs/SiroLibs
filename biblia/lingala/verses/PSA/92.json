      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 92:7"
      },
      "items": [
        {
          "text": "mpe zoba asosolaka eloko moko te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.92.7",
            "verseOrgIds": [
              "PSA.92.7"
            ]
          }
        }
      ]
    },
    {
