              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokumisa Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 112:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "Esengo na moto oyo atosaka Yawe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:1"
      },
      "items": [
        {
          "text": "mpe asepelaka makasi na mibeko na Ye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.1",
            "verseOrgIds": [
              "PSA.112.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 112:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana na ye bakozala bato na nguya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:2"
      },
      "items": [
        {
          "text": "kati na mokili ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:2"
      },
      "items": [
        {
          "text": "ekeke ya bato ya sembo ekopambolama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.2",
            "verseOrgIds": [
              "PSA.112.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 112:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndako na ye ezali na bokolongono",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:3"
      },
      "items": [
        {
          "text": "mpe na bomengo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:3"
      },
      "items": [
        {
          "text": "mpe bosembo na ye ewumelaka mpo na seko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.3",
            "verseOrgIds": [
              "PSA.112.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 112:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pole engengaka kati na molili",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:4"
      },
      "items": [
        {
          "text": "mpo na bato ya alima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 112:4"
      },
      "items": [
        {
          "text": "mpo na moto oyo alimbisaka baninga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:4"
      },
      "items": [
        {
          "text": "ayokelaka bato mawa mpe azali sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.4",
            "verseOrgIds": [
              "PSA.112.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
