            "sid": "PSA 112:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esengo na moto oyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:5"
      },
      "items": [
        {
          "text": "ayokelaka bato mawa mpe adefisaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:5"
      },
      "items": [
        {
          "text": "mpe asalaka misala na ye kolanda bosembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.5",
            "verseOrgIds": [
              "PSA.112.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
