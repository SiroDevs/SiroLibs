      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:8"
      },
      "items": [
        {
          "text": "abangaka te kino akomona banguna na ye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 112:8"
      },
      "items": [
        {
          "text": "kozwa etumbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.112.8",
            "verseOrgIds": [
              "PSA.112.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
