      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 134:1"
      },
      "items": [
        {
          "text": "Bopambola Yawe, bino nyonso, basali ya Nkolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.134.1",
            "verseOrgIds": [
              "PSA.134.1"
            ]
          }
        }
