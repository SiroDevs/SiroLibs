    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Nzembo 70",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s"
      },
      "items": [
        {
          "text": "Nzambe, yaka kosunga ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 70:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi mpo na kokanisa misala ya Nzambe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 70:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe, yaka noki mpo na kangola ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:2"
      },
      "items": [
        {
          "text": "Yawe, yaka noki mpo na kosunga ngai !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.2",
            "verseOrgIds": [
              "PSA.70.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 70:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bato oyo balukaka kufa na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "bakufa soni mpe basambwa !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "Tika ete bato oyo bazelaka libebi na ngai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:3"
      },
      "items": [
        {
          "text": "bazonga sima mpe bayokisama soni !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.3",
            "verseOrgIds": [
              "PSA.70.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 70:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bato oyo balobaka na ngai :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:4"
      },
      "items": [
        {
          "text": "« Ah ! Ah ! » bazonga mpo na soni !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.4",
            "verseOrgIds": [
              "PSA.70.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 70:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete bato nyonso oyo balukaka Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "batonda na esengo mpe basepela kati na Yo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "Tika ete ba-oyo balingaka lobiko na Yo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "balobaka tango nyonso :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:5"
      },
      "items": [
        {
          "text": "« Nzambe azali monene ! »",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.5",
            "verseOrgIds": [
              "PSA.70.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 70:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo ete nazali mobola mpe moto akelela,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.6",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:6"
      },
      "items": [
        {
          "text": "Nzambe, yaka noki mpo na kosunga ngai.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.6",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 70:6"
      },
      "items": [
        {
          "text": "Yawe, ozali Lisungi mpe Mokangoli na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.6",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 70:6"
      },
      "items": [
        {
          "text": "kowumela te !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.70.6",
            "verseOrgIds": [
              "PSA.70.6"
            ]
          }
        }
      ]
    }
  ],
