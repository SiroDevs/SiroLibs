          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abongisi elombe mokangoli mpo na bato na Ye !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.14",
            "verseOrgIds": [
              "PSA.148.14"
            ]
          }
        }
      ]
    },
