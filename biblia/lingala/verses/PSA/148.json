          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezala bangomba milayi to bangomba mikuse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
