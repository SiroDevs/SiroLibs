          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokumisa Yawe wuta na mokili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.7",
            "verseOrgIds": [
              "PSA.148.7"
            ]
          }
        }
      ]
    },
