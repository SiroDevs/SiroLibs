      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:10"
      },
      "items": [
        {
          "text": "ezala bikelamu oyo etambolaka na libumu to bandeke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.10",
            "verseOrgIds": [
              "PSA.148.10"
            ]
          }
        }
      ]
    },
