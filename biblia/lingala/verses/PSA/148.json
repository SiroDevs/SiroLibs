    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "Bokumisa Yawe wuta na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:1"
      },
      "items": [
        {
          "text": "bokumisa Ye na bisika oyo eleki likolo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.1",
            "verseOrgIds": [
              "PSA.148.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 148:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokumisa Ye, bino ba-anjelu na Ye nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:2"
      },
      "items": [
        {
          "text": "bokumisa Ye, bino mampinga na Ye nyonso ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.2",
            "verseOrgIds": [
              "PSA.148.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 148:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bokumisa Ye, bino moyi mpe sanza ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:3"
      },
      "items": [
        {
          "text": "bokumisa Ye, bino minzoto nyonso oyo engengaka ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.3",
            "verseOrgIds": [
              "PSA.148.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 148:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bokumisa Ye, bino oyo boleki likolo kati na likolo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:4"
      },
      "items": [
        {
          "text": "mpe bino mayi oyo bozali na likolo !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.4",
            "verseOrgIds": [
              "PSA.148.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 148:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tika ete ekumisa Kombo ya Yawe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:5"
      },
      "items": [
        {
          "text": "Pamba te apesaki mitindo, mpe ekelamaki.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.5",
            "verseOrgIds": [
              "PSA.148.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 148:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atiaki yango mpo na libela ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:6"
      },
      "items": [
        {
          "text": "apesaki mibeko oyo ekobongwana te.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.6",
            "verseOrgIds": [
              "PSA.148.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
