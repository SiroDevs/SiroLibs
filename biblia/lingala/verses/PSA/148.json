      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:8"
      },
      "items": [
        {
          "text": "ezala mvula ya pembe to londende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.8",
            "verseOrgIds": [
              "PSA.148.8"
            ]
          }
        }
      ]
    },
