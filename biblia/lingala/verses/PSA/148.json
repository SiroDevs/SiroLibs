          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ezala bakonzi ya mabele to bikolo nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
