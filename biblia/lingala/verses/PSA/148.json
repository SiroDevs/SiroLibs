      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:9"
      },
      "items": [
        {
          "text": "ezala banzete oyo ebotaka bambuma to banzete ya sedele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.9",
            "verseOrgIds": [
              "PSA.148.9"
            ]
          }
        }
      ]
    },
