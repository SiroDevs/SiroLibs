      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:12"
      },
      "items": [
        {
          "text": "ezala bampaka to bana mike !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.12",
            "verseOrgIds": [
              "PSA.148.12"
            ]
          }
        }
