      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 148:11"
      },
      "items": [
        {
          "text": "ezala bakambi to batambolisi nyonso ya mokili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.148.11",
            "verseOrgIds": [
              "PSA.148.11"
            ]
          }
        }
      ]
    },
