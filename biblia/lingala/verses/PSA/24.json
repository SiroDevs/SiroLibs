          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani azali Mokonzi yango ya nkembo ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:8"
      },
      "items": [
        {
          "text": "Ezali Yawe, Elombe ya nguya ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:8"
      },
      "items": [
        {
          "text": "Yawe, Elombe ya bitumba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.8",
            "verseOrgIds": [
              "PSA.24.8"
            ]
          }
        }
      ]
    },
