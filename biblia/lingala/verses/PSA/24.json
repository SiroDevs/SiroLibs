      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:7"
      },
      "items": [
        {
          "text": "Bino bikuke ya kala, bomitombola !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:7"
      },
      "items": [
        {
          "text": "Tika ete Mokonzi ya nkembo akota !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.7",
            "verseOrgIds": [
              "PSA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
