            "number": "5",
            "style": "v",
            "sid": "PSA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe akopambola ye ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:5"
      },
      "items": [
        {
          "text": "mpe Nzambe, Mobikisi na ye, akokomisa ye sembo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.5",
            "verseOrgIds": [
              "PSA.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge wana nde ezali,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:6"
      },
      "items": [
        {
          "text": "ekeke ya bato oyo bakangamaka na Yo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 24:6"
      },
      "items": [
        {
          "text": "ba-oyo balukaka elongi na Yo, Nzambe ya Jakobi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.6",
            "verseOrgIds": [
              "PSA.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
