        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebandeli ya mokanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo, Silasi mpe Timote ;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1TH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mi",
        "vid": "1TH 1:1"
      },
      "items": [
        {
          "text": "Epai ya bandeko ya Lingomba ya Tesalonika, ba-oyo bazali kati na Nzambe Tata mpe kati na Nkolo Yesu-Klisto :",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1TH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1TH 1:1"
      },
      "items": [
        {
          "text": "Tika ete ngolu mpe kimia epesamela bino !",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Polo mpe Baklisto ya Tesalonika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matondi mpo na kondima ya bato ya Tesalonika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tozongisaka tango nyonso matondi epai ya Nzambe mpo na bino nyonso tango totangaka bino kati na mabondeli na biso.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobosanaka te liboso ya Nzambe, Tata na biso, misala ya kondima na bino, misala ya bolingo na bino mpe molende na bino, oyo ewuti na elikya monene oyo bozali na yango kati na Nkolo na biso, Yesu-Klisto.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandeko balingami ya Nzambe, toyebi malamu ete Nzambe apona bino,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te Sango Malamu na biso ekomaki epai na bino kaka na maloba te, kasi mpe na nguya, na Molimo Mosantu mpe na kondima monene. Mpe boyebi malamu ndenge nini tozalaki kovanda kati na bino mpo na bolamu na bino.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokomaki kolanda ndakisa na biso mpe ya Nkolo, pamba te boyambaki Liloba kati na minyoko mingi mpe na esengo oyo Molimo Mosantu apesaka.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpo na yango, bokomi mpe ndakisa mpo na bandimi nyonso ya Masedwane mpe ya Akayi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta epai na bino, Liloba na Nkolo epanzani kaka te na Masedwane mpe Akayi, kasi sango ya kondima na bino kati na Nzambe eyebani mpe bipai nyonso. Yango wana tozali lisusu na tina te ya koloba ata likambo moko mpo na yango,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.8",
            "verseOrgIds": [
              "1TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te bango moko bazali kotatola ndenge nini boyambaki biso mpe ndenge nini botikaki kosambela banzambe ya bikeko mpo na komipesa na Nzambe mpe mpo na kosalela Nzambe na bomoi mpe ya solo,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.9",
            "verseOrgIds": [
              "1TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe mpo na kozela, kowuta na Likolo, Mwana na Ye oyo asekwisaki kati na bakufi Yesu oyo azali kokangola biso na kanda oyo ezali koya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.10",
            "verseOrgIds": [
              "1TH.1.10"
            ]
          }
        }
      ]
    }
  ],
