{
  "id": "ACT.17",
  "number": "17",
  "bookId": "ACT",
  "reference": "Misala ya Bantoma 17",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ACT 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Polo mpe Silasi na Tesalonika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na Polo mpe Silasi kolekela na Afipolisi mpe na Apolonia, bakendeki na Tesalonika epai wapi ndako ya mayangani ya Bayuda ezalaki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndenge momesano na ye ezalaki, Polo akotaki na ndako ya mayangani. Basaba misato, asololaki na bato oyo bazalaki kuna na tina na Makomi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azalaki kotalisa mpe kolakisa bango polele ete Klisto asengelaki komona pasi mpe kosekwa kati na bakufi. Azalaki koloba na bango :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:3"
      },
      "items": [
        {
          "text": "— Yesu oyo nazali koteya bino, Ye nde azali Klisto.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndambo ya Bayuda bandimisamaki mpe basanganaki na Polo mpe Silasi ; ndenge moko mpe na bato mingi ya Grese, oyo bazalaki kogumbamela Nzambe, mpe basi ebele ya lokumu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Bayuda mosusu basalaki zuwa ; bakendeki kozwa bato ya mobulu oyo batambolaka pamba-pamba na balabala, basangisaki bango mpe babimisaki mobulu kati na engumba. Bakendeki mbangu na ndako ya Jazoni mpo na koluka Polo mpe Silasi mpo ete bamema bango liboso ya ebele ya bato.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.5",
            "verseOrgIds": [
              "ACT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi lokola bamonaki bango te, bamemaki Jazoni mpe bandeko mosusu liboso ya bakambi ya engumba na koganga :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:6"
      },
      "items": [
        {
          "text": "— Bato oyo bazali koningisa mokili mobimba bakomi sik'oyo awa,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe Jazoni ayambi bango lokola babengami kati na ndako na ye. Bango nyonso bazali kobuka mibeko ya Sezare, pamba te bazali koloba : « Mokonzi mosusu azali, Kombo na Ye : Yesu ! »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango ebele ya bato mpe bakambi ya engumba bayokaki bongo, batombokaki makasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, bafutisaki Jazoni mpe bandeko mosusu lomande mpe, na sima, batikaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Polo mpe Silasi kati na engumba Bere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana butu ekomaki, bandeko bakimisaki Polo mpe Silasi noki-noki na Bere. Tango bakomaki kuna, bakotaki na ndako ya mayangani ya Bayuda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.10",
            "verseOrgIds": [
              "ACT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, Bayuda ya Bere bazalaki bato ya boboto koleka bato ya Tesalonika, pamba te bayambaki Liloba na motema mobimba mpe, mokolo na mokolo, bazalaki koyekola na mozindo Makomi mpo na kotala soki makambo oyo Polo azali koteya bango ezali ya solo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.11",
            "verseOrgIds": [
              "ACT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayuda ebele kati na bango bandimaki ; ndenge moko mpe, kati na bato ya Grese, basi mingi ya lokumu mpe mibali ebele bandimaki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi tango Bayuda ya Tesalonika bayokaki ete Polo azali koteya Liloba na Nzambe na Bere, mingi kati na bango bayaki mpe kuna mpo na kotia songisongi kati na bato mpo ete batomboka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, kaka na tango yango, bandeko basalaki ete Polo akende na ebale mpo na kozwa masuwa, wana Silasi mpe Timote batikalaki na Bere.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato oyo bakendeki kotika Polo bamemaki ye kino na Ateni ; mpe na mitindo ya Polo, bazongaki na Bere koyebisa Silasi mpe Timote ete balanda ye noki na Ateni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Polo kati na Ateni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana Polo azali kozela bango kati na Ateni, motema na ye etungisamaki mingi na komona ete engumba yango etonda na banzambe ya bikeko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, azalaki kosolola na Bayuda mpe Bagreki oyo bazalaki kogumbamela Nzambe kati na ndako ya mayangani, mpe na bato oyo azalaki kokuta, mokolo na mokolo, na bisika oyo bato ebele bakutanaka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndambo ya bato ya mayele oyo balandaka malakisi ya Epikire mpe ya Zenon bakomaki kotiana tembe na ye. Bamoko batunaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:18"
      },
      "items": [
        {
          "text": "— Moto oyo ya makelele alingi koloba nini ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 17:18"
      },
      "items": [
        {
          "text": "Bamosusu balobaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:18"
      },
      "items": [
        {
          "text": "— Tomoni lokola nde azali kolobela banzambe ya bapaya !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 17:18"
      },
      "items": [
        {
          "text": "Balobaki bongo mpo ete Polo azalaki koteya Sango Malamu na tina na Yesu mpe lisekwa kati na bakufi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye bakamataki ye, bamemaki ye na Areopaje",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        },
        {
          "text": "mpe balobaki na ye :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:19"
      },
      "items": [
        {
          "text": "— Boni, tokoki koyeba soki mateya ya sika oyo ozali koteya elingi koloba nini ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te ozali koloba na biso makambo ya sika. Yango wana, tolingi koyeba soki makambo yango elakisi penza nini.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Bato nyonso ya Ateni mpe bapaya oyo bazalaki kovanda kuna bazalaki kolekisa tango mingi mpo na koloba mpe koyoka basango ya sika).",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo atelemaki liboso ya bato oyo basanganaki na Areopaje mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:22"
      },
      "items": [
        {
          "text": "— Bato ya Ateni ! Nasosoli ete, na makambo nyonso, bolingaka mingi makambo ya bonzambe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te tango nazalaki kotambola kati na engumba na bino mpe kotala bikeko oyo bosambelaka, namonaki kutu etumbelo moko bakoma na likolo na yango :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "ACT 17:23"
      },
      "items": [
        {
          "text": "Mpo na Nzambe oyo ayebani te.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ACT 17:23"
      },
      "items": [
        {
          "text": "Nzokande, ngai nayei koteya bino Nzambe oyo bosambelaka ata boyebi Ye te.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe oyo asala mokili mpe biloko nyonso oyo ezali kati na yango azali Nkolo ya Likolo mpe ya mokili, avandaka te kati na batempelo oyo maboko ya bato etonga.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe azalaka na posa te ya masungi ya bato, pamba te akoka na nyonso. Nzokande, Ye nde apesaka bato nyonso bomoi, pema mpe biloko nyonso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuta na moto moko, asalaki mabota nyonso ya bato, mpo ete bakoka kovanda na mokili mobimba ; mpe akataki tango mpo na moto na moto mpe atiaki bandelo mpo na bisika na bango ya kovanda.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe asalaki bongo mpo ete bato bakoka koluka Ye, tango mosusu bakolonga komona Ye na kolukaluka lokola mokufi miso. Nzokande, na bosolo, azali mosika te ya moko na moko kati na biso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te, ezali na nzela na Ye nde tozalaka na bomoi, toninganaka mpe tozalaka oyo tozali, ndenge bakomi na bino mosusu baloba : « Tozali bana na ye ! »",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, lokola tozali bana na Nzambe, tosengeli te kokanisa ete bonzambe ekokani na elilingi ya wolo, ya palata to ya libanga, lokola nzambe ya ekeko oyo esalemi na maboko mpe mayele ya moto.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, lokola Nzambe atalaka te tango ya kozanga boyebi, kasi azali sik'oyo kosenga ete bato nyonso, na bisika nyonso oyo bazali, babongola mitema.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te akata mokolo oyo akosambisa mokili mobimba na bosembo nyonso, na nzela ya moto oyo Ye asila kopona. Atalisaki bosolo na yango epai ya bato nyonso, na nzela ya kosekwisa moto yango kati na bakufi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bayokaki Polo koloba na tina na lisekwa ya bakufi, bamoko basekaki ye, mpe bamosusu balobaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 17:32"
      },
      "items": [
        {
          "text": "— Tokoyoka yo mokolo mosusu na tina na likambo oyo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bongo, Polo atikaki bango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokande, bato mosusu balandaki Polo mpe bakomaki bandimi. Kati na bango, ezalaki : Denisi, moto ya Areopaje ; mwasi moko oyo kombo na ye ezali Damarisi, mpe bato mosusu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
      ]
    }
  ],
