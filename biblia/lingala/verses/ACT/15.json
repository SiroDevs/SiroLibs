{
  "id": "ACT.15",
  "number": "15",
  "bookId": "ACT",
  "reference": "Misala ya Bantoma 15",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ACT 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kobendana na tina na kokatisama ngenga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndambo ya bato bawutaki na Yuda mpe bakomaki na Antioshe, mpe bakomaki koteya bandeko :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
              "ACT.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 15:1"
      },
      "items": [
        {
          "text": "— Soki bokatisi ngenga te kolanda Mobeko ya Moyize, bokoki te kozwa lobiko.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo mpe Barnabasi batelemelaki bato wana ; bongo kobendana makasi ekotaki kati na bango na tina na likambo yango. Boye, bazwaki mokano ete Polo, Barnabasi mpe ndambo ya bandimi mosusu bakende na Yelusalemi elongo na bantoma mpe bakambi ya Lingomba mpo na kolobela likambo yango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.2",
            "verseOrgIds": [
              "ACT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lingomba esungaki bango mpo na mobembo. Wana bakatisaki Fenisi mpe Samari, bazalaki koloba ndenge nini bato ya bikolo ya bapaya bazalaki kobongola mitema. Sango oyo ezalaki kopesa bandeko nyonso esengo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.3",
            "verseOrgIds": [
              "ACT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango bakomaki na Yelusalemi, Lingomba, bantoma mpe bakambi bayambaki bango ; mpe Polo elongo na Barnabasi bapesaki bango sango ya makambo nyonso oyo Nzambe asalaki na nzela na bango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.4",
            "verseOrgIds": [
              "ACT.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndambo ya bandimi oyo bazalaki kala Bafarizeo batelemaki mpo na koloba :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 15:5"
      },
      "items": [
        {
          "text": "— Bato ya bikolo ya bapaya basengeli kokatama ngenga, mpe esengeli kotinda bango kotosa Mobeko ya Moyize.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantoma mpe bakambi basanganaki mpo na koyekola malamu likambo yango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.6",
            "verseOrgIds": [
              "ACT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola tembe elekaki makasi, Petelo atelemaki mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 15:7"
      },
      "items": [
        {
          "text": "— Bandeko na ngai, boyebi malamu ete Nzambe apona ngai wuta kala kati na bino mpo ete nakoka koteya Sango Malamu epai ya bato ya bikolo ya bapaya, mpo ete bango mpe bakoka koyoka yango mpe bakoma bandimi.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo, Nzambe oyo ayebi mitema ya bato alakisaki ete andimaki bango na nzela ya kopesa bango Molimo Mosantu, ndenge kaka apesaki biso.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asalaki bokeseni te kati na biso mpe bango, pamba te akomisaki mitema na bango peto na nzela ya kondima.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo mpo na nini bolingi sik'oyo komeka Nzambe, na nzela ya koluka komemisa bayekoli oyo, mokumba oyo tolongaki te komema, ezala biso to batata na biso ?",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ! Biso tondimaka ete tobiki na ngolu ya Nkolo Yesu, ndenge moko kaka na bango.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisanga mobimba evandaki kimia wana bazalaki koyoka Barnabasi mpe Polo koyebisa bango bikamwa mpe bilembo oyo Nzambe asalaki na nzela na bango, kati na bato ya bikolo ya bapaya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.12",
            "verseOrgIds": [
              "ACT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango basilisaki koloba, Jake azwaki maloba mpe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 15:13"
      },
      "items": [
        {
          "text": "— Bandeko, boyoka ngai !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simona awuti koyebisa biso ndenge nini, wuta na ebandeli, Nzambe aponaki bato kati na bikolo ya bapaya ete bazala bato na Ye.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makambo oyo ekokani na maloba ya basakoli, kolanda ndenge ekomama :",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Sima na yango, nakozonga,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "nakotonga lisusu ndako ya kapo ya Davidi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "oyo esila kokweya ;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "nakotonga yango lisusu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "mpe nakotelemisa yango,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpo ete bato oyo bakotikala baluka Nkolo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:17"
      },
      "items": [
        {
          "text": "ezala bato nyonso ya bikolo ya bapaya",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 15:17"
      },
      "items": [
        {
          "text": "oyo babengamaka na Kombo na Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:17"
      },
      "items": [
        {
          "text": "elobi Nkolo oyo asalaka makambo oyo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "makambo oyo eyebana wuta kala. »",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.18",
            "verseOrgIds": [
              "ACT.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, tala likanisi na ngai : Tosengeli te kotungisa bato ya bikolo ya bapaya oyo bandimeli Nzambe.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na esika ya kotungisa bango, tosengeli kaka kokomela bango ete balia te misuni ya banyama oyo ebonzami lokola mbeka epai ya banzambe mosusu, basala kindumba te, balia te nyama oyo babomi na kozanga kobimisa makila, mpe bamela makila te.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamba te wuta kala, kati na bingumba nyonso, ezali na bato oyo bateyaka Mobeko ya Moyize, mpe batangaka yango kati na bandako ya mayangani, mikolo nyonso ya Saba.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mokanda etindami epai ya bikolo ya bapaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantoma, bakambi elongo na Lingomba mobimba bazwaki mokano ya kopona ndambo ya bato kati na bango mpe ya kotinda bango na Antioshe elongo na Polo mpe Barnabasi. Baponaki Yuda oyo babengaka Barsabasi, mpe Silasi ; bango mibale bazalaki bakambi kati na bandeko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapesaki bango mokanda oyo ekomamaki boye :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 15:23"
      },
      "items": [
        {
          "text": "Biso bantoma mpe bakambi, bandeko na bino :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 15:23"
      },
      "items": [
        {
          "text": "Epai ya bato ya bikolo ya bapaya oyo bavandaka kati na Antioshe, na Siri mpe na Silisi ;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 15:23"
      },
      "items": [
        {
          "text": "Mbote na bino.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyokaki ete bandeko mosusu bawutaki epai na biso, ba-oyo topesaki ata nzela te, bayaki kotia mobulu kati na bino, batiaki penza mobulu kati na bino mpe batungisaki mitema na bino na nzela ya maloba na bango. Nzokande, totindaki bango te.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.24",
            "verseOrgIds": [
              "ACT.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, biso nyonso toyokanaki mpo na kopona bato mpe kotindela bino bango, elongo na bandeko balingami na biso, Barnabasi mpe Polo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.25",
            "verseOrgIds": [
              "ACT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba-oyo bakaba bomoi na bango mpo na Kombo na Yesu-Klisto, Nkolo na biso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.26",
            "verseOrgIds": [
              "ACT.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango wana, totindeli bino Yuda mpe Silasi mpo ete bakoka koyebisa bino makambo oyo tokomi kati na mokanda oyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.27",
            "verseOrgIds": [
              "ACT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Molimo Mosantu mpe biso tomoni malamu ete tomemisa bino mikumba mosusu te, longola kaka bikateli oyo :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.28",
            "verseOrgIds": [
              "ACT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bolia te misuni ya banyama oyo ebonzami lokola mbeka epai ya banzambe mosusu, bomela makila te, bolia te nyama oyo babomi na kozanga kobimisa makila, mpe bosala kindumba te. Ekozala malamu soki bokimi makambo yango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmc",
        "vid": "ACT 15:29"
      },
      "items": [
        {
          "text": "Botikala malamu !",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, batikaki bango kokende na Antioshe epai wapi basangisaki Lingomba mobimba mpe bapesaki mokanda yango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bato batangaki mokanda yango mpe basepelaki mingi na malendisi oyo ezalaki kati na yango.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokola Yuda mpe Silasi bazalaki basakoli, bazwaki penza tango molayi mpo na koloba na bandeko mpe kolendisa bango ete bayika mpiko kati na kondima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bawumelaki wana mwa tango, mpe bandeko batombelaki bango kimia mpo na bozongi epai ya bato oyo batindaki bango. [",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Silasi asepelaki kotikala wana.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo mpe Barnabasi batikalaki na Antioshe epai wapi, elongo na bato mosusu ebele, bazalaki koteya mpe kosakola Liloba na Nkolo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Polo mpe Barnabasi bakabwani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mwa mikolo, Polo alobaki na Barnabasi :",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "ACT 15:36"
      },
      "items": [
        {
          "text": "— Tozonga na bingumba nyonso epai wapi toteyaki Liloba na Nkolo, mpo ete totala bandeko mpo na koyeba soki bazali ndenge nini.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barnabasi azalaki na posa ya komema, elongo na bango, Yoane oyo babengaka mpe Malako ;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kasi Polo asepelaki te ete bamema ye elongo na bango, pamba te akabwanaki na bango na Pafili mpe akobaki lisusu te elongo na bango kati na mosala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, babendanaki makasi penza mpe basukaki na kokabwana. Barnabasi azwaki Malako mpe akotaki elongo na ye kati na masuwa mpo na kokende na Shipre.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Polo azwaki Silasi mpe akendeki elongo na ye, sima na bandeko kotika bango na se ya ngolu ya Nkolo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atambolaki kati na Siri mpe na Silisi mpo na kolendisa Mangomba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
        }
      ]
    }
  ],
