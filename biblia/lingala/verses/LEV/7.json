          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yango nde mitindo oyo Yawe apesaki epai ya bana ya Isalaele mpo ete, wuta mokolo oyo apakolaki bango mafuta, babanda kopesa bango yango lokola eteni na bango. Ezali mibeko ya seko mpo na milongo nyonso ya bana na bango.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        }
